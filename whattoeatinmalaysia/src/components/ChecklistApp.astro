---
import Layout from '~/layouts/Default.astro';
import {
  states,
  faqs,
  checklistTotal,
  nationalClassics,
  packages,
  dataVerified,
  REGION_LABELS,
  type Region,
} from '~/data/dishes';

const title = `Malaysian Food Checklist: 81 Dishes to Try and Track`;
const description =
  'Every famous Malaysian dish in one checklist. Tick dishes off as you taste them, rate each one, and note where you ate it. Free, no account needed, works on your phone.';

const siteUrl = 'https://whattoeatinmalaysia.com';

const regionsOrder: Region[] = ['north', 'central', 'south', 'east-coast', 'borneo'];
const byRegion = regionsOrder.map((r) => ({
  region: r,
  label: REGION_LABELS[r],
  states: states.filter((s) => s.region === r),
}));

const checkPath = 'M4.5 12.8c2.7 1.3 4.4 3.6 5.4 6.1 2-5.6 5.9-10.4 11.1-13.7';

// Dish images mapping - placeholder colored tiles for now
const dishImages: Record<string, string> = {
  'roti-canai': '/images/covers/penang.jpg',
  'teh-tarik': '/images/covers/kl.jpg',
  'nasi-goreng-kampung': '/images/covers/collection.jpg',
  'apam-balik': '/images/covers/vegetarian.jpg',
};
---

<Layout title={title} description={description}>
  <div class="sticky-progress" id="sticky-progress" aria-hidden="true">
    <span>Tried <b id="sp-count">0</b>/{nationalClassics.length}</span>
    <span class="sp-track"><span class="sp-fill" id="sp-fill" style="width:0%"></span></span>
    <a href="#checklist">Jump to checklist</a>
  </div>

  <header class="hero">
    <div class="container">
      <h1>What to Eat in Malaysia: The 81-Dish Checklist</h1>
      <p class="lede">
        A free checklist of 81 dishes across 16 states.
        Tick what you have tried, rate each one, write notes about where you found it.
        Buy a detailed guide when you want to go deeper.
      </p>
            <div class="hero-stats" aria-hidden="true">
              <span><b>81</b> dishes to track</span><span class="dot">&middot;</span>
              <span><b>Free</b> forever</span><span class="dot">&middot;</span>
              <span><b>No account</b> needed</span>
            </div>
            <p class="hero-trust" aria-hidden="true">
              Works offline &middot; Your data stays on your device &middot; Built by <a href="https://simplyenak.com" target="_blank" rel="noopener">Simply Enak</a>
            </p>
            <p class="hero-cta-row"><a href="#checklist" class="hero-cta">Start tracking</a></p>
            <div class="progress-panel" id="progress-panel">
        <div class="progress-top">
          <p class="progress-label">
            Starter checklist: tried <span id="tried-count">0</span> of {nationalClassics.length}
          </p>
          <div class="progress-actions">
            <button id="share-btn" type="button">Share score</button>
            <button id="reset-btn" type="button">Reset</button>
          </div>
        </div>
        <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax={nationalClassics.length} aria-valuenow="0" id="progress-track">
          <div class="progress-fill" id="progress-fill"></div>
        </div>
        <p class="progress-hint">
          Ticks saved locally, no account needed. This is just the starter. Buy a deep dive to unlock the full {checklistTotal} dish checklist across all states.
          <a href="/packages">See packages</a> or <a href="/login">Log in</a> if you already bought one.
        </p>
      </div>
      <a class="hero-login" href="/login">Log in &rarr;</a>
    </div>
  </header>

  <section id="checklist">
  <div class="container">
  <h2 class="section-title">The starter checklist</h2>
  <p class="section-hint">
    Twelve national classics eaten everywhere. Tick what you have tried and share your score.
    The remaining {checklistTotal - nationalClassics.length} state-specific dishes unlock when you buy a deep dive.
  </p>

  <div class="checklist-paper">
    <div class="checklist-header">
      <h2>Malaysian Food Checklist</h2>
      <p class="subtitle">Tick as you taste · Rate your favourites · Note where you found them</p>
      <div class="stamp-seal">Official</div>
    </div>

  <div class="cl-group open">
    <div class="cl-group-head">
      <h3>National Classics</h3>
      <span class="count-chip" data-state-count="classics">0/{nationalClassics.length} tried</span>
    </div>
    <div class="cl-grid">
      {nationalClassics.map((c) => (
        <label class="cl-item" data-dish-card={c.id} for={`check-${c.id}`}>
          <input
            type="checkbox"
            class="vh"
            id={`check-${c.id}`}
            data-dish={c.id}
            aria-label={`Tried ${c.name}`}
          />
          <div class="dish-img-wrap">
            {dishImages[c.id] ? (
              <img src={dishImages[c.id]} alt="" loading="lazy" class="dish-img" />
            ) : (
              <div class="dish-img-placeholder">{c.name.slice(0, 2).toUpperCase()}</div>
            )}
          </div>
          <span class="tick" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d={checkPath} /></svg>
          </span>
          <span class="cl-txt">
            <strong>{c.name}</strong>
            <em>{c.what}</em>
          </span>
          <div class="dish-notes" data-dish-id={c.id}>
            <div class="rating" data-dish-rating={c.id}>
              {[1,2,3,4,5].map(n => (
                <button type="button" class="star" data-star={n} aria-label={`Rate ${n} stars`}>☆</button>
              ))}
            </div>
            <textarea class="note-input" data-dish-note={c.id} placeholder="Where did you try it?" rows={2}></textarea>
            <div class="note-status" data-dish-status={c.id}></div>
          </div>
        </label>
      ))}
    </div>
  </div>
  </div><!-- /checklist-paper -->
  </div>
  </section>

  <section class="social-proof">
    <div class="container">
      <h2 class="section-title">What's inside</h2>
      <p class="section-subtitle">Built from the dishes Malaysia actually eats, state by state</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 32px;">
        <div class="proof-stat">
          <div class="num">81</div>
          <div class="label">Dishes tracked across 16 states</div>
        </div>
        <div class="proof-stat">
          <div class="num">12</div>
          <div class="label">Free classics to start with</div>
        </div>
        <div class="proof-stat">
          <div class="num">5</div>
          <div class="label">Premium guides available</div>
        </div>
      </div>
    </div>
  </section>

  <section class="commerce-section">
    <div class="container">
      <div class="commerce-header">
        <h2 class="section-title">Unlock deeper guides</h2>
        <p class="section-subtitle">
          Start with the free checklist. When you're ready, pick the guides for the places you're visiting.
          Every guide includes district maps, best-times guidance, and dietary flags. Your notes and ratings sync across devices too.
        </p>
      </div>

      <div class="product-showcase">
        <div class="product-featured">
          <div class="product-badge">Best value</div>
          <div class="product-image" style="background: linear-gradient(135deg, #C99B3F 0%, #E8A020 100%);">
            <span class="product-image-text">5 Guides</span>
          </div>
          <div class="product-info">
            <h3>Full Collection</h3>
            <p class="product-desc">All five checklists in one purchase: Penang, KL, Melaka, Halal, and Vegetarian. Everything you need to eat well across Malaysia.</p>
            <ul class="product-includes">
              <li>5 state & dietary checklists</li>
              <li>Cross-device note sync</li>
              <li>Lifetime access</li>
              <li>Instant download</li>
            </ul>
            <div class="product-price-row">
              <div class="price-block">
                <span class="price-original">US$19.95</span>
                <span class="price-current">US$12</span>
                <span class="price-save">Save 40%</span>
              </div>
              <button class="btn-primary product-btn" data-pkg="full-collection" data-checkout="https://checkout.whattoeatinmalaysia.com/street-food-masters-collection/">
                Add to cart
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              </button>
            </div>
            <div class="trust-signals">
              <span>🔒 Secure checkout</span>
              <span>⚡ Instant access</span>
              <span>↩️ 30-day refund</span>
            </div>
          </div>
        </div>

        <div class="products-grid">
          <div class="product-card" data-pkg="city-penang">
            <div class="product-image-sm" style="background: linear-gradient(135deg, #E4572E 0%, #C94423 100%);">
              <span class="product-image-sm-text">P</span>
            </div>
            <div class="product-info-sm">
              <h3>Penang Food Checklist</h3>
              <p class="product-desc-sm">George Town street food deep dive: char kway teow, assam laksa, Hokkien mee.</p>
              <div class="product-price-row-sm">
                <div class="price-block">
                  <span class="price-current">US$3.99</span>
                </div>
                <button class="btn-secondary product-btn" data-pkg="penang" data-checkout="https://checkout.whattoeatinmalaysia.com/penang-food-checklist/">Add to cart</button>
              </div>
            </div>
          </div>

          <div class="product-card" data-pkg="city-kl">
            <div class="product-image-sm" style="background: linear-gradient(135deg, #7A2E1D 0%, #5A2015 100%);">
              <span class="product-image-sm-text">K</span>
            </div>
            <div class="product-info-sm">
              <h3>KL Food Checklist</h3>
              <p class="product-desc-sm">Kuala Lumpur flavours: nasi lemak, roti canai, satay, and mamak midnight runs.</p>
              <div class="product-price-row-sm">
                <div class="price-block">
                  <span class="price-current">US$3.99</span>
                </div>
                <button class="btn-secondary product-btn" data-pkg="kl" data-checkout="https://checkout.whattoeatinmalaysia.com/kuala-lumpur-food-checklist/">Add to cart</button>
              </div>
            </div>
          </div>

          <div class="product-card" data-pkg="dietary-halal">
            <div class="product-image-sm" style="background: linear-gradient(135deg, #1E6B3A 0%, #145A2E 100%);">
              <span class="product-image-sm-text">H</span>
            </div>
            <div class="product-info-sm">
              <h3>Halal Food Checklist</h3>
              <p class="product-desc-sm">Muslim-friendly eating across Malaysia: halal-certified stalls, pork-free tips.</p>
              <div class="product-price-row-sm">
                <div class="price-block">
                  <span class="price-current">US$3.99</span>
                </div>
                <button class="btn-secondary product-btn" data-pkg="halal" data-checkout="https://checkout.whattoeatinmalaysia.com/halal-food-checklist/">Add to cart</button>
              </div>
            </div>
          </div>

          <div class="product-card" data-pkg="dietary-veg">
            <div class="product-image-sm" style="background: linear-gradient(135deg, #C99B3F 0%, #A8832E 100%);">
              <span class="product-image-sm-text">V</span>
            </div>
            <div class="product-info-sm">
              <h3>Vegetarian Food Checklist</h3>
              <p class="product-desc-sm">Plant-based Malaysian eats: tofu, tempeh, vegetable curries, and street veg dishes.</p>
              <div class="product-price-row-sm">
                <div class="price-block">
                  <span class="price-current">US$3.99</span>
                </div>
                <button class="btn-secondary product-btn" data-pkg="vegetarian" data-checkout="https://checkout.whattoeatinmalaysia.com/vegetarian-food-checklist/">Add to cart</button>
              </div>
            </div>
          </div>

          <div class="product-card" data-pkg="city-melaka">
            <div class="product-image-sm" style="background: linear-gradient(135deg, #5B4635 0%, #3D2E22 100%);">
              <span class="product-image-sm-text">M</span>
            </div>
            <div class="product-info-sm">
              <h3>Melaka Food Checklist</h3>
              <p class="product-desc-sm">UNESCO city flavours: ayam buah keluak, nyonya laksa, cendol, chicken rice balls.</p>
              <div class="product-price-row-sm">
                <div class="price-block">
                  <span class="price-current">US$3.99</span>
                </div>
                <button class="btn-secondary product-btn" data-pkg="melaka" data-checkout="https://checkout.whattoeatinmalaysia.com/melaka-food-checklist/">Add to cart</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="commerce-note">
        All guides unlock instantly after payment. Notes and ratings sync across devices when you log in.
      </p>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2 class="section-title">Frequently asked questions</h2>
      <div class="faq-grid">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="waitlist-section">
    <div class="container">
      <h2 class="section-title">Stay updated</h2>
      <p class="section-subtitle">
        We only email when there is something worth telling you. Unsubscribe anytime.
      </p>
      <form id="waitlist-form" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;">
        <input id="waitlist-email" type="email" placeholder="Your email" required style="flex:1;min-width:200px;padding:12px 14px;border:1px solid var(--color-border);border-radius:8px;font-size:0.95rem;background:#fff;">
        <button type="submit" id="waitlist-btn" style="padding:12px 24px;background:var(--color-primary);color:#fff;border:none;border-radius:8px;font-size:0.95rem;font-weight:700;cursor:pointer;">Join</button>
      </form>
      <p id="waitlist-note" class="wl-note" hidden></p>
      <p class="waitlist-note">By submitting, you agree to receive emails from What to Eat in Malaysia.</p>
    </div>
  </section>

<script>
  const STORAGE_KEY = 'wtm-checklist-data';
  const TOKEN_KEY = 'wtm-token';
  const ACCESS = 'https://wtm-access.system.simplyenak.com';
  const MAX_NOTES_CHAR = 300;

  function readState() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
    catch { return {}; }
  }

  function writeState(s) { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); }

  function getChecks() { return readState().checks || {}; }
  function getRatings() { return readState().ratings || {}; }
  function getNotes() { return readState().notes || {}; }

  function setCheck(id, checked) {
    const s = readState();
    s.checks = s.checks || {};
    s.checks[id] = checked;
    writeState(s);
  }

  function setRating(id, rating) {
    const s = readState();
    s.ratings = s.ratings || {};
    s.ratings[id] = rating;
    writeState(s);
  }

  function setNote(id, text) {
    const s = readState();
    s.notes = s.notes || {};
    s.notes[id] = text.slice(0, MAX_NOTES_CHAR);
    writeState(s);
  }

  function updateUI() {
    const checks = getChecks();
    const total = document.querySelectorAll('[data-dish-card]').length;
    const checked = Object.values(checks).filter(Boolean).length;

    document.querySelectorAll('[data-dish-card]').forEach(el => {
      const id = el.getAttribute('data-dish-card');
      const isChecked = !!checks[id];
      el.classList.toggle('checked', isChecked);
    });

    document.querySelectorAll('.star').forEach(btn => {
      const id = btn.closest('[data-dish-rating]').getAttribute('data-dish-rating');
      const rating = getRatings()[id] || 0;
      const n = parseInt(btn.getAttribute('data-star'));
      btn.textContent = n <= rating ? '★' : '☆';
      btn.classList.toggle('active', n <= rating);
    });

    document.querySelectorAll('.note-input').forEach(ta => {
      const id = ta.getAttribute('data-dish-note');
      ta.value = getNotes()[id] || '';
    });

    document.querySelectorAll('[data-state-count]').forEach(chip => {
      chip.textContent = `${checked}/${total} tried`;
    });

    // Update progress
    const classicsChecked = Object.entries(checks).filter(([k, v]) => v && document.querySelector(`[data-dish-card="${k}"]`)).length;
    const classicsTotal = document.querySelectorAll('[data-dish-card]').length;
    const pct = classicsTotal > 0 ? Math.round((classicsChecked / classicsTotal) * 100) : 0;

    const spCount = document.getElementById('sp-count');
    const spFill = document.getElementById('sp-fill');
    const triedCount = document.getElementById('tried-count');
    const progressTrack = document.getElementById('progress-track');
    const progressFill = document.getElementById('progress-fill');

    if (spCount) spCount.textContent = classicsChecked;
    if (spFill) spFill.style.width = pct + '%';
    if (triedCount) triedCount.textContent = classicsChecked;
    if (progressTrack) progressTrack.setAttribute('aria-valuenow', classicsChecked);
    if (progressFill) progressFill.style.width = pct + '%';
  }

  // Attach event listeners for checkboxes
  document.querySelectorAll('[data-dish-card]').forEach(label => {
    label.addEventListener('click', function(e) {
      if (e.target.tagName === 'TEXTAREA' || e.target.tagName === 'BUTTON') return;
      const input = this.querySelector('input[type="checkbox"]');
      if (!input) return;
      input.checked = !input.checked;
      const id = this.getAttribute('data-dish-card');
      setCheck(id, input.checked);
      this.classList.toggle('checked', input.checked);
      updateUI();
    });
  });

  // Attach event listeners for ratings and notes
  document.querySelectorAll('.star').forEach(function (star) {
    star.addEventListener('click', function () {
      var dishId = this.closest('[data-dish-rating]').getAttribute('data-dish-rating');
      var rating = parseInt(this.getAttribute('data-star'));
      ratingStates[dishId] = ratingStates[dishId] || {};
      ratingStates[dishId].rating = rating;
      var stars = this.parentElement.querySelectorAll('.star');
      stars.forEach(function (s, idx) {
        s.textContent = idx < rating ? '★' : '☆';
      });
      saveNote(dishId);
    });
  });

  document.querySelectorAll('.note-input').forEach(function (textarea) {
    var debouncedSave;
    textarea.addEventListener('input', function () {
      var dishId = this.getAttribute('data-dish-note');
      ratingStates[dishId] = ratingStates[dishId] || {};
      ratingStates[dishId].note = this.value;
      clearTimeout(debouncedSave);
      debouncedSave = setTimeout(function () { saveNote(dishId); }, 1000);
    });
  });

  // Load notes after token check
  var savedToken = localStorage.getItem(TOKEN_KEY);
  if (savedToken) loadNotes();

  // Share score
  document.getElementById('share-btn').addEventListener('click', function() {
    var checks = getChecks();
    var total = document.querySelectorAll('[data-dish-card]').length;
    var checked = Object.values(checks).filter(Boolean).length;
    var text = 'I have tried ' + checked + ' of ' + total + ' Malaysian dishes on the What to Eat in Malaysia checklist. Try it at ' + siteUrl;
    if (navigator.share) {
      navigator.share({ title: 'My Malaysian Food Checklist Score', text: text, url: siteUrl });
    } else {
      navigator.clipboard.writeText(text).then(function() {
        alert('Score copied to clipboard!');
      });
    }
  });

  // Reset
  document.getElementById('reset-btn').addEventListener('click', function() {
    if (confirm('Reset all ticks and notes? This cannot be undone.')) {
      localStorage.removeItem(STORAGE_KEY);
      ratingStates = {};
      updateUI();
    }
  });

  // Waitlist
  var wlForm = document.getElementById('waitlist-form');
  var wlBtn = document.getElementById('waitlist-btn');
  var wlNote = document.getElementById('waitlist-note');
  wlForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = document.getElementById('waitlist-email').value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      wlNote.hidden = false;
      wlNote.textContent = 'That email does not look right.';
      return;
    }
    wlBtn.disabled = true;
    wlBtn.textContent = 'Joining...';
    fetch(ACCESS + '/waitlist', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, source: 'checklist_home' }),
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
      if (j.ok) {
        wlNote.hidden = false;
        wlNote.textContent = 'Thanks! You are on the list. We will email you when there is news.';
        wlNote.style.color = '#2d7a1d';
        wlForm.reset();
      } else {
        wlNote.hidden = false;
        wlNote.textContent = j.message || 'Something went wrong. Please try again.';
        wlNote.style.color = '#c0392b';
      }
    })
    .catch(function () {
      wlNote.hidden = false;
      wlNote.textContent = 'Network error. Please try again later.';
      wlNote.style.color = '#c0392b';
    })
    .finally(function () {
      wlBtn.disabled = false;
      wlBtn.textContent = 'Join';
    });
  });
</script>

</Layout>
