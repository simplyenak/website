---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, canonical, structuredData } = Astro.props;
const siteUrl = 'https://whattoeatinmalaysia.com';
const canonicalUrl = canonical || `${siteUrl}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <style is:global>
      :root {
        --color-primary: #7A2E1D;
        --color-accent: #E4572E;
        --color-bg: #FDF9F0;
        --color-card: #FFFFFF;
        --color-text: #1F1A15;
        --color-muted: #6E6459;
        --color-border: #EAE0CE;
        --color-gold: #C99B3F;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--font-sans); background: var(--color-bg); color: var(--color-text); line-height: 1.6; }
      a { color: var(--color-primary); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 1080px; margin: 0 auto; padding: 0 20px; }

      /* Hero */
      .hero {
        background: linear-gradient(160deg, #7A2E1D 0%, #9C3B22 55%, #7A2E1D 100%);
        color: #FFF6E9;
        padding: 64px 0 56px;
        text-align: center;
      }
      .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #F3C88B;
        border: 1px solid rgba(243, 200, 139, 0.4);
        border-radius: 999px;
        padding: 4px 14px;
        margin-bottom: 18px;
      }
      .hero h1 { font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.15; max-width: 820px; margin: 0 auto 14px; }
      .hero .lede { max-width: 680px; margin: 0 auto; color: #F5E7D0; font-size: 1.05rem; }

      .picker {
        margin: 30px auto 0;
        max-width: 520px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
      }
      .picker select {
        flex: 1 1 240px;
        font-size: 1.05rem;
        padding: 13px 16px;
        border-radius: 10px;
        border: 2px solid #F3C88B;
        background: #FFF6E9;
        color: var(--color-text);
        font-family: inherit;
        cursor: pointer;
      }
      .picker button {
        flex: 0 0 auto;
        font-size: 1.05rem;
        font-weight: 600;
        padding: 13px 22px;
        border-radius: 10px;
        border: 0;
        background: var(--color-accent);
        color: #FFF6E9;
        cursor: pointer;
        font-family: inherit;
      }
      .picker button:hover { background: #C94423; }
      .quick-pills {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
      }
      .quick-pills a {
        font-size: 0.85rem;
        color: #F5E7D0;
        border: 1px solid rgba(245, 231, 208, 0.45);
        border-radius: 999px;
        padding: 4px 13px;
      }
      .quick-pills a:hover { background: rgba(245, 231, 208, 0.15); text-decoration: none; }

      .stat-row { margin-top: 26px; color: #E9D3B4; font-size: 0.92rem; }
      .stat-row strong { color: #FFF6E9; }

      /* Sections */
      section { padding: 44px 0; }
      .section-title { font-size: 1.6rem; color: var(--color-primary); margin-bottom: 8px; }
      .section-hint { color: var(--color-muted); margin-bottom: 22px; max-width: 720px; }
      .intro-section { background: var(--color-card); border-bottom: 1px solid var(--color-border); }
      .intro-section p { max-width: 760px; margin-bottom: 12px; }

      /* Region + state cards */
      .region-block { margin-bottom: 42px; }
      .region-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 30px 0 16px;
      }
      .region-heading h2 { font-size: 1.25rem; color: var(--color-primary); white-space: nowrap; }
      .region-heading .rule { flex: 1; height: 2px; background: var(--color-border); border-radius: 2px; }
      .region-heading .count { font-size: 0.8rem; color: var(--color-muted); white-space: nowrap; }

      .state-card {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        margin-bottom: 22px;
        overflow: hidden;
        scroll-margin-top: 24px;
        transition: box-shadow 0.4s ease;
      }
      .state-card.flash { box-shadow: 0 0 0 3px var(--color-accent); }
      .state-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 6px;
        padding: 18px 22px 0;
      }
      .state-head h3 { font-size: 1.35rem; color: var(--color-primary); }
      .state-head .tagline { font-size: 0.78rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.06em; }
      .state-intro { padding: 6px 22px 14px; color: var(--color-text); max-width: 820px; }

      .dish-list { border-top: 1px solid var(--color-border); }
      .dish {
        padding: 16px 22px;
        border-bottom: 1px solid var(--color-border);
      }
      .dish:last-child { border-bottom: 0; }
      .dish-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
      }
      .dish-name { font-weight: 700; font-size: 1.05rem; color: var(--color-text); }
      .dish-origin { color: var(--color-muted); font-size: 0.8rem; }
      .dish-what { color: var(--color-text); margin: 4px 0 6px; max-width: 780px; }
      .dish-where { font-size: 0.95rem; }
      .dish-where .label { font-weight: 700; color: var(--color-accent); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; display: block; }
      .dish-meta { margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; }
      .chip {
        font-size: 0.72rem;
        border-radius: 999px;
        padding: 2px 10px;
        border: 1px solid var(--color-border);
        color: var(--color-muted);
        background: var(--color-bg);
      }
      .chip.halal { color: #1E6B3A; border-color: #BFE0C8; background: #F0F8F1; }
      .chip.pork-free { color: #1E5F8A; border-color: #C2DFF0; background: #EEF6FB; }
      .chip.non-halal { color: #9C2B1F; border-color: #EFC7C1; background: #FBF1EF; }
      .chip.varies { color: #7A5E13; border-color: #EADFB4; background: #FBF7E6; }
      .chip.time { color: var(--color-primary); border-color: var(--color-border); }

      .state-cta {
        padding: 14px 22px 18px;
        background: #FBF3E4;
      }
      .state-cta a {
        display: inline-block;
        background: var(--color-primary);
        color: #FFF6E9;
        font-weight: 600;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 0.95rem;
      }
      .state-cta a:hover { background: #5E2315; text-decoration: none; }

      /* Table of contents */
      .toc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 10px;
      }
      .toc-grid a {
        display: block;
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 10px 14px;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .toc-grid a:hover { border-color: var(--color-accent); text-decoration: none; }
      .toc-grid .toc-region { display: block; font-size: 0.72rem; color: var(--color-muted); font-weight: 400; }

      /* FAQ */
      .faq details {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        margin-bottom: 10px;
        overflow: hidden;
      }
      .faq summary {
        cursor: pointer;
        font-weight: 600;
        padding: 15px 20px;
        list-style-position: outside;
      }
      .faq summary:hover { color: var(--color-accent); }
      .faq .answer { padding: 0 20px 16px; color: var(--color-text); max-width: 820px; }

      /* CTA + footer */
      .cta-band {
        background: linear-gradient(160deg, #7A2E1D, #9C3B22);
        color: #FFF6E9;
        text-align: center;
        padding: 52px 0;
      }
      .cta-band h2 { font-size: 1.6rem; margin-bottom: 10px; }
      .cta-band p { max-width: 640px; margin: 0 auto 20px; color: #F5E7D0; }
      .cta-band a {
        display: inline-block;
        background: #FFF6E9;
        color: var(--color-primary);
        font-weight: 700;
        padding: 13px 26px;
        border-radius: 10px;
        font-size: 1.05rem;
      }
      .cta-band a:hover { background: #F3E3C8; text-decoration: none; }

      footer {
        padding: 28px 0 40px;
        color: var(--color-muted);
        font-size: 0.85rem;
        text-align: center;
      }
      footer .verified {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        display: inline-block;
        padding: 10px 16px;
        margin-bottom: 14px;
        color: var(--color-text);
      }

      /* Checklist */
      .progress-panel {
        max-width: 520px;
        margin: 26px auto 0;
        background: rgba(255, 246, 233, 0.94);
        border-radius: 12px;
        padding: 14px 18px;
        color: var(--color-text);
        text-align: left;
      }
      .progress-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .progress-label { font-size: 0.85rem; font-weight: 600; }
      .progress-label span { color: var(--color-accent); }
      .progress-actions { display: flex; gap: 8px; }
      .progress-actions button {
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: #FFF6E9;
        color: var(--color-primary);
        padding: 5px 12px;
        cursor: pointer;
      }
      .progress-actions button:hover { border-color: var(--color-accent); }
      .progress-track {
        margin-top: 10px;
        height: 10px;
        border-radius: 999px;
        background: #EFE4D2;
        overflow: hidden;
      }
      .progress-fill {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        background: linear-gradient(90deg, #E4572E, #C99B3F);
        transition: width 0.35s ease;
      }
      .progress-hint { font-size: 0.72rem; color: var(--color-muted); margin-top: 6px; }

      .dish-check {
        appearance: none;
        -webkit-appearance: none;
        width: 22px;
        height: 22px;
        min-width: 22px;
        border: 2px solid #C7B9A2;
        border-radius: 7px;
        background: var(--color-card);
        cursor: pointer;
        display: inline-grid;
        place-content: center;
        margin-top: 2px;
      }
      .dish-check:hover { border-color: var(--color-accent); }
      .dish-check::after {
        content: '';
        width: 11px;
        height: 11px;
        border-radius: 3px;
        transform: scale(0);
        transition: transform 0.12s ease-in;
        background: var(--color-accent);
      }
      .dish-check:checked { border-color: var(--color-accent); }
      .dish-check:checked::after { transform: scale(1); }
      .dish-row { display: flex; gap: 12px; align-items: flex-start; }
      .dish-row .dish-body { flex: 1; min-width: 0; }
      .dish.checked { background: #FBF6EB; }
      .dish.checked .dish-name { text-decoration: line-through; text-decoration-thickness: 1px; text-decoration-color: var(--color-accent); }

      .count-chip {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-primary);
        background: #F6EBD8;
        border-radius: 999px;
        padding: 2px 10px;
      }

      .classic-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 12px;
      }
      .classic-card {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
      }
      .classic-card .c-name { font-weight: 700; font-size: 0.98rem; }
      .classic-card .c-what { font-size: 0.86rem; color: var(--color-text); }
      .classic-card.checked { background: #FBF6EB; }
      .classic-card.checked .c-name { text-decoration: line-through; text-decoration-color: var(--color-accent); }

      @media (max-width: 640px) {
        .hero { padding: 48px 0 44px; }
        .state-head h3 { font-size: 1.2rem; }
        .dish { padding: 14px 16px; }
        .state-head, .state-intro, .state-cta { padding-left: 16px; padding-right: 16px; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
