        margin: 0 0 12px;
      }
      .product-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .product-price {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--color-primary);
      }
      .btn-secondary {
        background: var(--color-accent);
        color: #fff;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
