      }
    </style>
  </head>
  <body>
    <slot />
    <div class="install-banner" id="install-banner" hidden>
      <p>Install the checklist on your phone. Works offline.</p>
      <div class="ib-btns">
        <button type="button" class="btn-install" id="ib-install">Install</button>
        <button type="button" class="btn-dismiss" id="ib-dismiss">Not now</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        if (!('serviceWorker' in navigator)) return;
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/service-worker.js').catch(function () {});
        });
        var deferred = null;
        var banner = document.getElementById('install-banner');
        var dismissed = false;
        try { dismissed = localStorage.getItem('wtm-install-dismissed') === '1'; } catch (e) {}
        window.addEventListener('beforeinstallprompt', function (e) {
          e.preventDefault();
          deferred = e;
          if (banner && !dismissed) banner.hidden = false;
        });
        window.addEventListener('appinstalled', function () {
          if (banner) banner.hidden = true;
        });
        var yes = document.getElementById('ib-install');
        var no = document.getElementById('ib-dismiss');
        if (yes) yes.addEventListener('click', function () {
          if (!deferred) return;
          deferred.prompt();
          deferred.userChoice.then(function () { deferred = null; if (banner) banner.hidden = true; });
        });
        if (no) no.addEventListener('click', function () {
          if (banner) banner.hidden = true;
          try { localStorage.setItem('wtm-install-dismissed', '1'); } catch (e) {}
        });
      })();
    </script>
