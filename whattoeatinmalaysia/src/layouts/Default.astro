      /* Packages page */
      .packages-page { padding-top: 8px; }
      .packages-header { text-align: center; max-width: 760px; margin: 0 auto 32px; }
      .comparison-table { overflow-x: auto; margin: 0 -16px 32px; padding: 0 16px; }
      .compare-table {
        width: 100%;
