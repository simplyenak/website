      /* Guides index */
      .guides-index { padding-top: 8px; }
      .guides-header { text-align: center; max-width: 760px; margin: 0 auto 28px; }
      .region-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin: 24px 0 32px;
        padding: 0 16px;
      }
      .region-tab {
        padding: 8px 16px;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-card);
        color: var(--color-text);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s, color 0.2s;
      }
      .region-tab:hover { border-color: var(--color-accent); }
      .region-tab[aria-selected="true"] {
        border-color: var(--color-accent);
        background: var(--color-accent);
        color: #fff;
      }
      .region-heading { font-size: 1.1rem; color: var(--color-primary); margin: 8px 0 16px; }
      .guides-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
      }
      .guide-card {
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 20px;
        background: var(--color-card);
        display: flex;
        flex-direction: column;
        transition: border-color 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1), transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        transform: translateY(0);
      }
