---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, canonical, structuredData } = Astro.props;
const siteUrl = 'https://whattoeatwhereinmalaysia.com';
const canonicalUrl = canonical || `${siteUrl}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#7A2E1D" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <style is:global>
      :root {
        --color-primary: #7A2E1D;
        --color-accent: #E4572E;
        --color-bg: #FDF9F0;
        --color-card: #FFFFFF;
        --color-text: #1F1A15;
        --color-muted: #6E6459;
        --color-border: #EAE0CE;
        --color-gold: #C99B3F;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--font-sans); background: var(--color-bg); color: var(--color-text); line-height: 1.6; }
      a { color: var(--color-primary); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 1080px; margin: 0 auto; padding: 0 20px; }

      /* Hero */
      .hero {
        background:
          radial-gradient(1100px 480px at 50% -140px, rgba(228, 87, 46, 0.34), rgba(228, 87, 46, 0) 62%),
          radial-gradient(700px 420px at 88% 108%, rgba(201, 155, 63, 0.22), rgba(201, 155, 63, 0) 60%),
          linear-gradient(168deg, #6E2717 0%, #8A3520 58%, #611F11 100%);
        color: #FFF6E9;
        padding: 68px 0 60px;
        text-align: center;
      }
      .hero-stats {
        display: flex;
        justify-content: center;
        gap: 0;
        margin: 22px auto 0;
        font-variant-numeric: tabular-nums;
      }
      .hero-stats span { color: #EFCB96; font-size: 0.85rem; letter-spacing: 0.02em; }
      .hero-stats b { color: #FFF6E9; font-weight: 700; }
      .hero-stats .dot { margin: 0 14px; color: rgba(239, 203, 150, 0.5); }
      .hero-trust { margin: 18px 0 12px; font-size: 0.78rem; color: rgba(243, 200, 139, 0.8); letter-spacing: 0.01em; }
      .hero-trust a { color: #F3C88B; text-decoration: underline; text-underline-offset: 2px; }
      .hero-cta-row { margin-top: 20px; }
      .hero-cta {
        display: inline-block;
        font-size: 0.95rem;
        font-weight: 700;
        color: #FFF6E9;
        padding: 12px 28px;
        border: 2px solid #FFF6E9;
        border-radius: 999px;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }
      .hero-cta:hover { background: #FFF6E9; color: #6E2717; border-color: #FFF6E9; }
      .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #F3C88B;
        border: 1px solid rgba(243, 200, 139, 0.4);
        border-radius: 999px;
        padding: 4px 14px;
        margin-bottom: 18px;
      }
      .hero h1 { font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.15; max-width: 820px; margin: 0 auto 14px; }
      .hero .lede { max-width: 680px; margin: 0 auto; color: #F5E7D0; font-size: 1.05rem; }

      .picker {
        margin: 30px auto 0;
        max-width: 520px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
      }
      .picker select {
        flex: 1 1 240px;
        font-size: 1.05rem;
        padding: 13px 16px;
        border-radius: 10px;
        border: 2px solid #F3C88B;
        background: #FFF6E9;
        color: var(--color-text);
        font-family: inherit;
        cursor: pointer;
      }
      .picker button {
        flex: 0 0 auto;
        font-size: 1.05rem;
        font-weight: 600;
        padding: 13px 22px;
        border-radius: 10px;
        border: 0;
        background: var(--color-accent);
        color: #FFF6E9;
        cursor: pointer;
        font-family: inherit;
      }
      .picker button:hover { background: #C94423; }
      .quick-pills {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
      }
      .quick-pills a {
        font-size: 0.85rem;
        color: #F5E7D0;
        border: 1px solid rgba(245, 231, 208, 0.45);
        border-radius: 999px;
        padding: 4px 13px;
      }
      .quick-pills a:hover { background: rgba(245, 231, 208, 0.15); text-decoration: none; }

      .stat-row { margin-top: 26px; color: #E9D3B4; font-size: 0.92rem; }
      .stat-row strong { color: #FFF6E9; }

      /* Sections */
      section { padding: 44px 0; }
      .section-title { font-size: 1.6rem; color: var(--color-primary); margin-bottom: 8px; }
      .section-eyebrow {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 6px;
        font-variant-numeric: tabular-nums;
      }
      .section-hint { color: var(--color-muted); margin-bottom: 22px; max-width: 720px; }
      .intro-section { background: var(--color-card); border-bottom: 1px solid var(--color-border); }
      .intro-section p { max-width: 760px; margin-bottom: 12px; }

      /* Region + state cards */
      .region-block { margin-bottom: 42px; }
      .region-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 30px 0 16px;
      }
      .region-heading h2 { font-size: 1.25rem; color: var(--color-primary); white-space: nowrap; }
      .region-heading .rule { flex: 1; height: 2px; background: var(--color-border); border-radius: 2px; }
      .region-heading .count { font-size: 0.8rem; color: var(--color-muted); white-space: nowrap; }

      .state-card {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        margin-bottom: 22px;
        overflow: hidden;
        scroll-margin-top: 24px;
        transition: box-shadow 0.4s ease;
      }
      .state-card.flash { box-shadow: 0 0 0 3px var(--color-accent); }
      .state-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 6px;
        padding: 18px 22px 0;
      }
      .state-head h3 { font-size: 1.35rem; color: var(--color-primary); }
      .state-head .tagline { font-size: 0.78rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.06em; }
      .state-intro { padding: 6px 22px 14px; color: var(--color-text); max-width: 820px; }

      .dish-list { border-top: 1px solid var(--color-border); }
      .dish {
        padding: 16px 22px;
        border-bottom: 1px solid var(--color-border);
      }
      .dish:last-child { border-bottom: 0; }
      .dish-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
      }
      .dish-name { font-weight: 700; font-size: 1.05rem; color: var(--color-text); }
      .dish-origin { color: var(--color-muted); font-size: 0.8rem; }
      .dish-what { color: var(--color-text); margin: 4px 0 6px; max-width: 780px; }
      .dish-where { font-size: 0.95rem; }
      .dish-where .label { font-weight: 700; color: var(--color-accent); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; display: block; }
      .dish-meta { margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; }
      .chip {
        font-size: 0.72rem;
        border-radius: 999px;
        padding: 2px 10px;
        border: 1px solid var(--color-border);
        color: var(--color-muted);
        background: var(--color-bg);
      }
      .chip.halal { color: #1E6B3A; border-color: #BFE0C8; background: #F0F8F1; }
      .chip.pork-free { color: #1E5F8A; border-color: #C2DFF0; background: #EEF6FB; }
      .chip.non-halal { color: #9C2B1F; border-color: #EFC7C1; background: #FBF1EF; }
      .chip.varies { color: #7A5E13; border-color: #EADFB4; background: #FBF7E6; }
      .chip.time { color: var(--color-primary); border-color: var(--color-border); }

      .state-cta {
        padding: 14px 22px 18px;
        background: #FBF3E4;
      }
      .state-cta a {
        display: inline-block;
        background: var(--color-primary);
        color: #FFF6E9;
        font-weight: 600;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 0.95rem;
      }
      .state-cta a:hover { background: #5E2315; text-decoration: none; }

      /* Table of contents */
      .toc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 10px;
      }
      .toc-grid a {
        display: block;
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 10px 14px;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .toc-grid a:hover { border-color: var(--color-accent); text-decoration: none; }
      .toc-grid .toc-region { display: block; font-size: 0.72rem; color: var(--color-muted); font-weight: 400; }

      /* FAQ */
      .faq details {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        margin-bottom: 10px;
        overflow: hidden;
      }
      .faq summary {
        cursor: pointer;
        font-weight: 600;
        padding: 15px 20px;
        list-style-position: outside;
      }
      .faq summary:hover { color: var(--color-accent); }
      .faq .answer { padding: 0 20px 16px; color: var(--color-text); max-width: 820px; }

      /* CTA + footer */
      .cta-band {
        background: linear-gradient(160deg, #7A2E1D, #9C3B22);
        color: #FFF6E9;
        text-align: center;
        padding: 52px 0;
      }
      .cta-band h2 { font-size: 1.6rem; margin-bottom: 10px; }
      .cta-band p { max-width: 640px; margin: 0 auto 20px; color: #F5E7D0; }
      .cta-band a {
        display: inline-block;
        background: #FFF6E9;
        color: var(--color-primary);
        font-weight: 700;
        padding: 13px 26px;
        border-radius: 10px;
        font-size: 1.05rem;
      }
      .cta-band a:hover { background: #F3E3C8; text-decoration: none; }

      footer {
        padding: 28px 0 40px;
        color: var(--color-muted);
        font-size: 0.85rem;
        text-align: center;
      }
      footer .verified {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        display: inline-block;
        padding: 10px 16px;
        margin-bottom: 14px;
        color: var(--color-text);
      }

      /* Checklist */
      .progress-panel {
        max-width: 520px;
        margin: 26px auto 0;
        background: rgba(255, 246, 233, 0.94);
        border-radius: 12px;
        padding: 14px 18px;
        color: var(--color-text);
        text-align: left;
      }
      .progress-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .progress-label { font-size: 0.85rem; font-weight: 600; }
      .progress-label span { color: var(--color-accent); }
      .progress-actions { display: flex; gap: 8px; }
      .progress-actions button {
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: #FFF6E9;
        color: var(--color-primary);
        padding: 5px 12px;
        cursor: pointer;
      }
      .progress-actions button:hover { border-color: var(--color-accent); }
      .progress-track {
        margin-top: 10px;
        height: 10px;
        border-radius: 999px;
        background: #EFE4D2;
        overflow: hidden;
      }
      .progress-fill {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        background: linear-gradient(90deg, #E4572E, #C99B3F);
        transition: width 0.35s ease;
      }
      .progress-hint { font-size: 0.72rem; color: var(--color-muted); margin-top: 6px; }

      .dish-check {
        appearance: none;
        -webkit-appearance: none;
        width: 22px;
        height: 22px;
        min-width: 22px;
        border: 2px solid #C7B9A2;
        border-radius: 7px;
        background: var(--color-card);
        cursor: pointer;
        display: inline-grid;
        place-content: center;
        margin-top: 2px;
      }
      .dish-check:hover { border-color: var(--color-accent); }
      .dish-check::after {
        content: '';
        width: 11px;
        height: 11px;
        border-radius: 3px;
        transform: scale(0);
        transition: transform 0.12s ease-in;
        background: var(--color-accent);
      }
      .dish-check:checked { border-color: var(--color-accent); }
      .dish-check:checked::after { transform: scale(1); }
      .dish-row { display: flex; gap: 12px; align-items: flex-start; }
      .dish-row .dish-body { flex: 1; min-width: 0; }
      .dish.checked { background: #FBF6EB; }
      .dish.checked .dish-name { text-decoration: line-through; text-decoration-thickness: 1px; text-decoration-color: var(--color-accent); }

      .count-chip {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-primary);
        background: #F6EBD8;
        border-radius: 999px;
        padding: 2px 10px;
      }

      .classic-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 12px;
      }
      .classic-card {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
      }
      .classic-card .c-name { font-weight: 700; font-size: 0.98rem; }
      .classic-card .c-what { font-size: 0.86rem; color: var(--color-text); }
      .classic-card.checked { background: #FBF6EB; }
      .classic-card.checked .c-name { text-decoration: line-through; text-decoration-color: var(--color-accent); }

      /* Checklist groups + ink tick */
      .vh { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      .cl-region { margin-top: 28px; }
      .cl-region-name {
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--color-muted);
        margin: 0 0 6px 4px;
      }
      .cl-group {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        margin: 10px 0;
        overflow: hidden;
        scroll-margin-top: 24px;
      }
      .cl-group.flash { box-shadow: 0 0 0 3px var(--color-accent); }
      details.cl-group summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 13px 18px;
        font-weight: 700;
        color: var(--color-primary);
      }
      details.cl-group summary::-webkit-details-marker { display: none; }
      details.cl-group summary .cl-group-title { font-size: 1rem; }
      details.cl-group summary::after {
        content: '+';
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--color-muted);
        margin-left: auto;
      }
      details.cl-group[open] summary::after { content: '–'; }
      .cl-group .cl-group-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 13px 18px 0;
      }
      .cl-group .cl-group-head h3 { font-size: 1rem; color: var(--color-primary); }

      .cl-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 4px 14px;
        padding: 8px 12px 14px;
      }
      .cl-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 9px 10px;
        border-radius: 12px;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .cl-item:hover { background: #FBF3E4; }
      .tick {
        width: 26px;
        height: 26px;
        min-width: 26px;
        margin-top: 1px;
        display: grid;
        place-items: center;
        background: #fff;
        border: 2px solid #C7B9A2;
        border-radius: 52% 46% 50% 48% / 47% 53% 45% 55%;
        transform: rotate(-3deg);
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .tick svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: var(--color-accent);
        stroke-width: 3.4;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 36;
        stroke-dashoffset: 36;
      }
      .cl-item input:checked + .tick {
        border-color: var(--color-accent);
        background: #FBE9DE;
        transform: rotate(1deg);
      }
      .cl-item input:checked + .tick svg {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 0.4s cubic-bezier(0.65, 0, 0.45, 1) 0.02s;
      }
      .cl-txt strong { display: block; font-size: 0.94rem; line-height: 1.35; }
      .cl-txt em {
        display: block;
        font-style: normal;
        font-size: 0.79rem;
        color: var(--color-muted);
        line-height: 1.45;
      }
      .cl-item.checked { background: #FBF6EB; }
      .cl-item.checked .cl-txt strong {
        text-decoration: line-through;
        text-decoration-thickness: 1.5px;
        text-decoration-color: var(--color-accent);
      }
      .cl-item.checked .cl-txt em { opacity: 0.6; }

      /* Guide previews */
      .state-card.preview .preview-row { padding: 12px 22px; }
      .dish.preview-row .dish-what { color: var(--color-muted); font-size: 0.92rem; }

      /* Packages + waitlist */
      .pkg-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 26px;
      }
      .pkg-card {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
      }
      .pkg-card.free { border-color: #C99B3F; }
      .pkg-card.coming { border-style: dashed; }
      .pkg-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
      .pkg-head h3 { font-size: 1.1rem; color: var(--color-primary); }
      .pkg-chip {
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 999px;
        padding: 3px 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .pkg-chip.free { color: #1E6B3A; background: #F0F8F1; border: 1px solid #BFE0C8; }
      .pkg-chip.coming { color: #7A5E13; background: #FBF7E6; border: 1px solid #EADFB4; }
      .pkg-blurb { color: var(--color-muted); font-size: 0.92rem; margin: 8px 0 12px; }
      .pkg-list { list-style: none; flex: 1; }
      .pkg-list li {
        font-size: 0.88rem;
        padding: 4px 0 4px 20px;
        position: relative;
        border-bottom: 1px dashed var(--color-border);
      }
      .pkg-list li:last-child { border-bottom: 0; }
      .pkg-list li::before {
        content: '';
        position: absolute;
        left: 2px;
        top: 11px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: var(--color-accent);
      }
      .pkg-price { margin-top: 14px; font-size: 0.8rem; color: var(--color-muted); font-weight: 600; }

      .waitlist-box {
        background: linear-gradient(140deg, #FBF3E4, #F6EBD8);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        padding: 22px 24px;
        text-align: center;
      }
      .waitlist-title { font-weight: 700; color: var(--color-primary); margin-bottom: 12px; }
      .waitlist-form { display: flex; gap: 10px; max-width: 460px; margin: 0 auto; flex-wrap: wrap; }
      .waitlist-form input {
        flex: 1 1 240px;
        font: inherit;
        font-size: 0.95rem;
        padding: 10px 14px;
        border-radius: 9px;
        border: 1px solid var(--color-border);
        background: #fff;
      }
      .waitlist-form input:focus { outline: 2px solid var(--color-accent); border-color: transparent; }
      .waitlist-form button {
        flex: 0 0 auto;
        font: inherit;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 10px 20px;
        border-radius: 9px;
        border: 0;
        background: var(--color-primary);
        color: #FFF6E9;
        cursor: pointer;
      }
      .waitlist-form button:hover { background: #5E2315; }
      .waitlist-form button:disabled { opacity: 0.6; cursor: default; }
      .waitlist-note { margin-top: 10px; font-size: 0.85rem; color: var(--color-primary); }

      .buy-band {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 16px;
        margin-bottom: 26px;
      }
      .buy-main, .unlock-box {
        background: var(--color-card);
        border: 1px solid #C99B3F;
        border-radius: 14px;
