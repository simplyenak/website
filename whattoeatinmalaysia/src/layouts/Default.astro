      .pkg-cta.primary { background: var(--color-primary); color: #fff; border: none; }
      .pkg-cta.primary:hover { opacity: 0.9; }
      .pkg-cta.secondary { background: transparent; color: var(--color-accent); border: 2px solid var(--color-accent); }
      .pkg-cta.secondary:hover { background: var(--color-accent); color: #fff; }
      .packages-faq { border-top: 1px solid var(--color-border); padding-top: 32px; }
