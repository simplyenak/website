---
import Layout from '~/layouts/Default.astro';
import {
  states,
  faqs,
  checklistTotal,
  nationalClassics,
  packages,
  dataVerified,
  REGION_LABELS,
  type Region,
} from '~/data/dishes';

const title = `Malaysian Food Tasting Checklist: What to Eat Where in Malaysia (${checklistTotal} Dishes)`;
const description =
  'The Malaysian food tasting checklist: tick off every dish worth trying, and find each one where it comes from so the version you get is the best version. Not a restaurant app.';

const siteUrl = 'https://whattoeatwhereinmalaysia.com';

const regionsOrder: Region[] = ['north', 'central', 'south', 'east-coast', 'borneo'];
const byRegion = regionsOrder.map((r) => ({
  region: r,
  label: REGION_LABELS[r],
  states: states.filter((s) => s.region === r),
}));



const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'What to Eat in Malaysia Checklist',
      applicationCategory: 'TravelApplication',
      operatingSystem: 'Any',
      url: siteUrl,
      description:
        'The Malaysian food tasting checklist: tick off dishes worth trying and find each one where it comes from, so the version you get is the best version. Score saved in your browser and shareable; paid state-by-state deep dives available.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@type': 'Organization', name: 'Simply Enak' },
    },
    {
      '@type': 'ItemList',
      name: 'The Malaysia food checklist',
      itemListElement: states.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${s.name}: ${s.dishes.map((d) => d.name).join(', ')}`,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const pickerData = states.map((s) => ({
  id: s.id,
  name: s.name,
  dishes: s.dishes.map((d) => ({ id: d.id, name: d.name, state: s.name })),
}));

const checkPath = 'M4.5 12.8c2.7 1.3 4.4 3.6 5.4 6.1 2-5.6 5.9-10.4 11.1-13.7';
---

<Layout title={title} description={description} structuredData={structuredData}>
  <div class="sticky-progress" id="sticky-progress" aria-hidden="true">
    <span>Tried <b id="sp-count">0</b>/{checklistTotal}</span>
    <span class="sp-track"><span class="sp-fill" id="sp-fill" style="width:0%"></span></span>
    <a href="#checklist">Jump to checklist</a>
  </div>
  <header class="hero">
    <div class="container">
      <p class="eyebrow">The Dish-Origin Checklist</p>
            <h1>What to Eat in Malaysia</h1>
            <p class="lede">
              Not another maps-and-reviews app. This is a checklist of dishes worth travelling for,
              each tied to the town or state it comes from, so you can try every one at its source.
            </p>
            <div class="hero-stats" aria-hidden="true">
              <span><b>{checklistTotal}</b> dishes</span><span class="dot">&middot;</span>
              <span><b>16</b> states & territories</span><span class="dot">&middot;</span>
              <span><b>12</b> national classics</span>
            </div>
            <p class="hero-trust" aria-hidden="true">
              Works offline · No tracking · Built by <a href="https://simplyenak.com" target="_blank" rel="noopener">Simply Enak</a>
            </p>
            <p class="hero-cta-row"><a href="#checklist" class="hero-cta">Start checking off</a></p>
            <div class="progress-panel" id="progress-panel">
        <div class="progress-top">
          <p class="progress-label">
            Starter checklist: tried <span id="tried-count">0</span> of {nationalClassics.length}
          </p>
          <div class="progress-actions">
            <button id="share-btn" type="button">Share score</button>
            <button id="reset-btn" type="button">Reset</button>
          </div>
        </div>
        <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax={nationalClassics.length} aria-valuenow="0" id="progress-track">
          <div class="progress-fill" id="progress-fill"></div>
        </div>
        <p class="progress-hint">
          Ticks are saved in this browser, no account needed. This is the free starter &mdash;
          sixteen state checklists sit below the fold. Bought a deep dive?
          <a href="/login">Log in</a> to open them on any device.
        </p>
      </div>
      <a class="hero-login" href="/login">Log in &rarr;</a>
    </div>
  </header>

  <section id="checklist">
    <div class="container">
      <p class="section-eyebrow">01 &middot; Free</p>
      <h2 class="section-title">The checklist</h2>
      <p class="section-hint">
        Open a state and tick what you have tried. Every dish is listed where it comes from:
        asam laksa in Air Itam, satay in Kajang, kolok mee in Kuching. The classics at the top
        are eaten everywhere; the rest are worth going to the source for.
      </p>

      <div class="cl-group open">
        <div class="cl-group-head">
          <h3>National classics</h3>
          <span class="count-chip" data-state-count="classics">0/{nationalClassics.length} tried</span>
        </div>
        <div class="cl-grid">
          {nationalClassics.map((c) => (
            <label class="cl-item" data-dish-card={c.id} for={`check-${c.id}`}>
              <input
                type="checkbox"
                class="vh"
                id={`check-${c.id}`}
                data-dish={c.id}
                aria-label={`Tried ${c.name}`}
              />
              <span class="tick" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={checkPath} /></svg>
              </span>
              <span class="cl-txt">
                <strong>{c.name}</strong>
                <em>{c.what}</em>
              </span>
            </label>
          ))}
        </div>
      </div>

      {byRegion.map((r) => (
        <div class="cl-region">
          <p class="cl-region-name">{r.label}</p>
          {r.states.map((s) => (
            <details class="cl-group" id={`state-${s.id}`} data-state={s.id}>
              <summary>
                <span class="cl-group-title">{s.name}</span>
                <span class="count-chip" data-state-count={s.id}>0/{s.dishes.length} tried</span>
              </summary>
              <div class="cl-grid">
                {s.dishes.map((d) => (
                  <label class="cl-item" data-dish-card={d.id} for={`check-${d.id}`}>
                    <input
                      type="checkbox"
                      class="vh"
                      id={`check-${d.id}`}
                      data-dish={d.id}
                      aria-label={`Tried ${d.name}`}
                    />
                    <span class="tick" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d={checkPath} /></svg>
                    </span>
                    <span class="cl-txt">
                      <strong>{d.name}</strong>
                      <em>{d.what}</em>
                    </span>
                  </label>
                ))}
              </div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section id="guide">
    <div class="container">
      <p class="section-eyebrow">02 &middot; Preview</p>
      <h2 class="section-title">The state guides</h2>
      <p class="section-hint">
        A taste of each state's kitchen. The full guides, exact streets, famous stalls, halal
        notes and ingredient detail, are part of the paid deep dives below.
      </p>

      {byRegion.map((r) => (
        <div class="region-block">
          <div class="region-heading">
            <h2>{r.label}</h2>
            <div class="rule" aria-hidden="true"></div>
          </div>
          {r.states.map((s) => (
            <div class="state-card preview">
              <div class="state-head">
                <h3>{s.name}</h3>
                <span class="tagline">{s.dishes.length} signature dishes</span>
              </div>
              <p class="state-intro">{s.intro}</p>
              <div class="dish-list">
                {s.dishes.map((d) => (
                  <div class="dish preview-row" data-detail-id={d.id}>
                    <div class="dish-top">
                      <span class="dish-name">{d.name}</span>
                      {d.origin && <span class="dish-origin">{d.origin}</span>}
                    </div>
                    <p class="dish-what">{d.what}</p>
                  </div>
                ))}
              </div>
              {s.cta && (
                <div class="state-cta">
                  <a href={s.cta.url} target="_blank" rel="noopener">{s.cta.label} &rarr;</a>
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section id="packages">
    <div class="container">
      <p class="section-eyebrow">03 &middot; Deep dives</p>
      <h2 class="section-title">Go deeper</h2>
      <p class="section-hint">
        The checklist is free and stays free. The deep dives below open the full guides.
      </p>
      <div class="pkg-grid">
        {packages.map((p) => (
          <div class={`pkg-card ${p.status}`}>
            <div class="pkg-head">
              <h3>{p.name}</h3>
              <span class={`pkg-chip ${p.status}`}>{p.status === 'free' ? 'Free' : 'Collection'}</span>
            </div>
            <p class="pkg-blurb">{p.blurb}</p>
            <ul class="pkg-list">
              {p.includes.map((i) => <li>{i}</li>)}
            </ul>
            <p class="pkg-price">{p.price}</p>
            <a class="pkg-cta" href={p.status === 'free' ? '#checklist' : '#waitlist'}>
              {p.status === 'free' ? 'Start ticking' : 'Join the waitlist'} &rarr;
            </a>
          </div>
        ))}
      </div>

      <div class="buy-band">
        <div class="buy-main">
          <p class="buy-title">Street Food Masters Collection</p>
          <p class="buy-sub">
            Every deep dive in one purchase: the Nyonya kitchen and all sixteen state guides, with exact
            streets, famous stalls, halal notes and ingredient detail. One-time payment.
          </p>
          <a class="buy-btn" href="https://uiy.thrivecart.com/street-food-masters-collection/" id="buy-btn" target="_blank" rel="noopener">Get the collection &rarr;</a>
          <p class="buy-note">Secure checkout by ThriveCart. Test mode while we finalise pricing.</p>
        </div>
        <div class="unlock-box">
          <p class="buy-title-sm">Already bought it?</p>
          <form id="unlock-form" class="waitlist-form">
            <label for="unlock-email" style="position:absolute;left:-9999px;">Your purchase email</label>
            <input id="unlock-email" type="email" required placeholder="Purchase email" autocomplete="email" />
            <button type="submit" id="unlock-btn">Unlock</button>
          </form>
          <p class="waitlist-note" id="unlock-note" hidden></p>
        </div>
      </div>
      <div class="unlocked-banner" id="unlocked-banner" hidden>
        Collection unlocked. The state guides below now show exactly where to eat every dish.
      </div>

      <div class="waitlist-box" id="waitlist">
        <p class="waitlist-title">Hear first when the deep dives open</p>
        <form id="waitlist-form" class="waitlist-form">
          <label for="waitlist-email" style="position:absolute;left:-9999px;">Your email</label>
          <input
            id="waitlist-email"
            name="email"
            type="email"
            required
            placeholder="you@trip.com"
            autocomplete="email"
          />
          <button type="submit" id="waitlist-btn">Join the list</button>
        </form>
        <p class="waitlist-note" id="waitlist-note" hidden></p>
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <h2 class="section-title">Questions travelers ask</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p class="answer">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <div class="cta-band">
    <div class="container">
      <h2>Eat Malaysia with people who eat Malaysia</h2>
      <p>
        Simply Enak runs guided food walks in Kuala Lumpur and George Town that cover many of these dishes
        in a single evening, led by guides from the food industry.
      </p>
      <a href="https://simplyenak.com/tours" target="_blank" rel="noopener">See the food tours</a>
    </div>
  </div>

  <footer>
    <div class="container">
      <div class="verified">
        Dish notes last checked <strong>{dataVerified.lastChecked}</strong> by{' '}
        {dataVerified.verifiedBy}, based on {dataVerified.basis}. Stall names change; the neighbourhoods
        do not.
      </div>
      <p>
        Built by <a href="https://simplyenak.com">Simply Enak</a> &middot; Malaysian food tours led by
        guides who eat their way through every state on this list.
      </p>
    </div>
  </footer>

  <script type="application/json" id="dish-data" set:html={JSON.stringify(pickerData)} />
  <script
    type="application/json"
    id="full-data"
    set:html={JSON.stringify({
      collectionProduct: '9',
      halalLabels: {
        halal: 'Halal',
        'pork-free': 'Pork-free',
        'non-halal': 'Contains pork',
        varies: 'Halal varies by stall',
      },
      dishes: Object.fromEntries(
        states.flatMap((s) =>
          s.dishes.map((d) => [
            d.id,
            {
              where: d.where,
              famousAt: d.famousAt || [],
              halal: d.halal,
              bestTime: d.bestTime || '',
            },
          ]),
        ),
      ),
    })}
  />
  <script>
    (function () {
      // Own backend captures the waitlist now (Formspree ID was dead, 2026-08-26).
      var ACCESS = 'https://wtm-access.system.simplyenak.com';
      var KEY = 'wtm-tried-v1';
      var TOTAL = document.querySelectorAll('[data-dish]').length;

      function load() {
        try {
          return JSON.parse(localStorage.getItem(KEY) || '[]');
        } catch (e) {
          return [];
        }
      }
      function save(ids) {
        localStorage.setItem(KEY, JSON.stringify(ids));
      }

      var tried = load();
      var boxes = Array.prototype.slice.call(document.querySelectorAll('[data-dish]'));

      function refresh() {
        var ids = boxes
          .filter(function (b) {
            return b.checked;
          })
          .map(function (b) {
            return b.getAttribute('data-dish');
          });
        tried = ids;
        save(ids);

        var n = ids.length;
        document.getElementById('tried-count').textContent = n;
        document.getElementById('progress-fill').style.width = (TOTAL ? (100 * n) / TOTAL : 0) + '%';
        document.getElementById('progress-track').setAttribute('aria-valuenow', n);

        var sp = document.getElementById('sticky-progress');
        if (sp) {
          document.getElementById('sp-count').textContent = n;
          document.getElementById('sp-fill').style.width = (TOTAL ? (100 * n) / TOTAL : 0) + '%';
          var heroBottom = document.querySelector('.hero');
          var past = heroBottom ? heroBottom.getBoundingClientRect().bottom < 0 : true;
          sp.classList.toggle('show', past && n > 0);
        }

        ids.forEach(function (id) {
          var card = document.querySelector('[data-dish-card="' + id + '"]');
          if (card) card.classList.add('checked');
        });

        document.querySelectorAll('[data-state-count]').forEach(function (chip) {
          var scope = chip.getAttribute('data-state-count');
          var parent =
            scope === 'classics'
              ? document.getElementById('checklist')
              : document.getElementById('state-' + scope);
          if (!parent) return;
          var group = parent.querySelectorAll('[data-dish]');
          var done = Array.prototype.filter.call(group, function (b) {
            return b.checked;
          }).length;
          chip.textContent = done + '/' + group.length + ' tried';
        });
      }

      boxes.forEach(function (b) {
        b.checked = tried.indexOf(b.getAttribute('data-dish')) !== -1;
        b.addEventListener('change', function () {
          var card = b.closest('[data-dish-card]');
          if (card && !b.checked) card.classList.remove('checked');
          refresh();
        });
      });
      refresh();

      // Share score
      function nameOf(b) {
        return b.getAttribute('aria-label').replace(/^Tried /, '');
      }
      document.getElementById('share-btn').addEventListener('click', function () {
        var n = tried.length;
        var picks = boxes
          .filter(function (b) {
            return b.checked;
          })
          .slice(0, 3)
          .map(nameOf);
        var text =
          'Malaysia food checklist: ' + n + '/' + TOTAL + ' dishes tried' +
          (picks.length ? ' (' + picks.join(', ') + (n > 3 ? ', ...' : '') + ')' : '') +
          '. How many have you had?';
        var url = 'https://whattoeatwhereinmalaysia.com';
        if (navigator.share) {
          navigator.share({ title: 'What to Eat in Malaysia', text: text, url: url }).catch(function () {});
        } else {
          (navigator.clipboard ? navigator.clipboard.writeText(text + ' ' + url) : Promise.reject())
            .then(function () {
              var btn = document.getElementById('share-btn');
              btn.textContent = 'Copied';
              setTimeout(function () {
                btn.textContent = 'Share score';
              }, 1600);
            })
            .catch(function () {
              window.prompt('Copy your score:', text + ' ' + url);
            });
        }
      });

      // Reset
      document.getElementById('reset-btn').addEventListener('click', function () {
        if (!window.confirm('Clear all ' + tried.length + ' ticks?')) return;
        boxes.forEach(function (b) {
          b.checked = false;
        });
        document.querySelectorAll('.checked').forEach(function (c) {
          c.classList.remove('checked');
        });
        refresh();
      });

      // State navigation: picker + surprise open the right group
      var data = JSON.parse(document.getElementById('dish-data').textContent);
      var allDishes = [];
      data.forEach(function (s) {
        s.dishes.forEach(function (d) {
          d.stateId = s.id;
          allDishes.push(d);
        });
      });
      function goTo(anchorId) {
        var el = document.getElementById(anchorId);
        if (!el) return;
        if (el.tagName === 'DETAILS') el.open = true;
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        document.querySelectorAll('.cl-group.flash').forEach(function (c) {
          c.classList.remove('flash');
        });
        el.classList.add('flash');
        setTimeout(function () {
          el.classList.remove('flash');
        }, 2400);
      }
      var picker = document.getElementById('state-picker');
      if (picker) {
        picker.addEventListener('change', function () {
          if (picker.value) goTo('state-' + picker.value);
        });
      }
      var btn = document.getElementById('random-dish');
      if (btn) {
        btn.addEventListener('click', function () {
          var d = allDishes[Math.floor(Math.random() * allDishes.length)];
          var opt = picker && picker.querySelector('option[value="' + d.stateId + '"]');
          if (opt && picker) picker.value = d.stateId;
          goTo('state-' + d.stateId);
        });
      }

      // Paid unlock
      var ACCESS = 'https://wtm-access.system.simplyenak.com';
      var TOKEN_KEY = 'wtm-token';
      var fullData = JSON.parse(document.getElementById('full-data').textContent);

      function enrichGuides() {
        document.querySelectorAll('[data-detail-id]').forEach(function (row) {
          var d = fullData.dishes[row.getAttribute('data-detail-id')];
          if (!d || row.getAttribute('data-enriched')) return;
          var where = document.createElement('p');
          where.className = 'dish-where';
          where.innerHTML =
            '<span class="label">Where to eat it</span>' + d.where +
            (d.famousAt.length ? ' <em>Famous at: ' + d.famousAt.join(' &middot; ') + '.</em>' : '');
          var meta = document.createElement('div');
          meta.className = 'dish-meta';
          meta.innerHTML =
            '<span class="chip ' + d.halal + '">' + fullData.halalLabels[d.halal] + '</span>' +
            (d.bestTime ? '<span class="chip time">' + d.bestTime + '</span>' : '');
          row.appendChild(where);
          row.appendChild(meta);
          row.setAttribute('data-enriched', '1');
        });
        var banner = document.getElementById('unlocked-banner');
        if (banner) banner.hidden = false;
        var buy = document.getElementById('buy-btn');
        if (buy) buy.textContent = 'Bought. Open the guides \u2193';
      }

      function tryToken(tok) {
        fetch(ACCESS + '/verify?t=' + encodeURIComponent(tok))
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (j) {
            if (j && j.ok && j.products.indexOf(fullData.collectionProduct) !== -1) enrichGuides();
          })
          .catch(function () {});
      }
      var savedToken = localStorage.getItem(TOKEN_KEY);
      if (savedToken) tryToken(savedToken);

      document.getElementById('unlock-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var email = document.getElementById('unlock-email').value.trim();
        var note = document.getElementById('unlock-note');
        var btn = document.getElementById('unlock-btn');
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
          note.hidden = false;
          note.textContent = 'That email does not look right.';
          return;
        }
        btn.disabled = true;
        btn.textContent = 'Checking...';
        fetch(ACCESS + '/redeem', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email }),
        })
          .then(function (r) {
            return r.json().then(function (j) {
              return { ok: r.ok, j: j };
            });
          })
          .then(function (res) {
            note.hidden = false;
            if (res.ok && res.j.ok) {
              localStorage.setItem(TOKEN_KEY, res.j.token);
              enrichGuides();
              note.textContent = 'Unlocked. The state guides below now show full detail.';
            } else {
              note.textContent = 'No purchase found for that email yet. Just bought? Give it a minute, then retry.';
            }
          })
          .catch(function () {
            note.hidden = false;
            note.textContent = 'Network hiccup. Try again.';
          })
          .finally(function () {
            btn.disabled = false;
            btn.textContent = 'Unlock';
          });
      });

      // Waitlist
      var wlForm = document.getElementById('waitlist-form');
      var wlBtn = document.getElementById('waitlist-btn');
      var wlNote = document.getElementById('waitlist-note');
      wlForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = document.getElementById('waitlist-email').value.trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
          wlNote.hidden = false;
          wlNote.textContent = 'That email does not look right.';
          return;
        }
        wlBtn.disabled = true;
        wlBtn.textContent = 'Joining...';
        fetch(ACCESS + '/waitlist', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email: email,
            source: 'wtm-checklist',
          }),
        })
          .then(function (r) {
            return r.json().then(function (j) {
              return { ok: r.ok, j: j };
            });
          })
          .then(function (res) {
            wlNote.hidden = false;
            if (res.ok && res.j.ok) {
              wlNote.textContent =
                'You are on the list. We will email you when the deep dives open.';
              wlForm.reset();
            } else {
              wlNote.textContent = 'Something went wrong. Try again in a minute.';
            }
          })
          .catch(function () {
            wlNote.hidden = false;
            wlNote.textContent = 'Network hiccup. Try again.';
          })
          .finally(function () {
            wlBtn.disabled = false;
            wlBtn.textContent = 'Join the list';
          });
      });
    })();
  </script>
</Layout>
