---
// Homepage is mode-aware: PUBLIC_WTM_MODE=full serves the checklist app
// (launch state); the default 'gate' serves the email-capture page only.
// Fail-closed: anything other than 'full' builds the gate.
import { SITE_MODE } from '~/config';
import GateHome from '~/components/GateHome.astro';
import ChecklistApp from '~/components/ChecklistApp.astro';
---

{SITE_MODE === 'full' ? <ChecklistApp /> : <GateHome />}
