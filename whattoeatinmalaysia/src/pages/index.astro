---
import Layout from '~/layouts/Default.astro';
import {
  states,
  faqs,
  checklistTotal,
  nationalClassics,
  packages,
  dataVerified,
  REGION_LABELS,
  type Region,
} from '~/data/dishes';

const title = `What to Eat in Malaysia: The Food Checklist (${checklistTotal} Dishes)`;
const description =
  'The Malaysia food checklist: 81 dishes to tick off as you travel, from asam laksa to Sarawak laksa. Track your score, share it, and go deeper with state-by-state packages.';

const siteUrl = 'https://whattoeatinmalaysia.com';

const regionsOrder: Region[] = ['north', 'central', 'south', 'east-coast', 'borneo'];
const byRegion = regionsOrder.map((r) => ({
  region: r,
  label: REGION_LABELS[r],
  states: states.filter((s) => s.region === r),
}));



const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'What to Eat in Malaysia Checklist',
      applicationCategory: 'TravelApplication',
      operatingSystem: 'Any',
      url: siteUrl,
      description:
        'The Malaysia food checklist: 81 dishes to tick off as you travel, with your score saved in your browser and shareable, plus paid state-by-state deep dives.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@type': 'Organization', name: 'Simply Enak' },
    },
    {
      '@type': 'ItemList',
      name: 'The Malaysia food checklist',
      itemListElement: states.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${s.name}: ${s.dishes.map((d) => d.name).join(', ')}`,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const pickerData = states.map((s) => ({
  id: s.id,
  name: s.name,
  dishes: s.dishes.map((d) => ({ id: d.id, name: d.name, state: s.name })),
}));

const checkPath = 'M4.5 12.8c2.7 1.3 4.4 3.6 5.4 6.1 2-5.6 5.9-10.4 11.1-13.7';
---

<Layout title={title} description={description} structuredData={structuredData}>
  <header class="hero">
    <div class="container">
      <p class="eyebrow">The Malaysia Food Checklist</p>
      <h1>What to Eat in Malaysia</h1>
      <p class="lede">
        Eighty-one dishes worth the flight. Tick them off as you eat your way through Malaysia,
        and share your score when you get home.
      </p>
      <div class="progress-panel" id="progress-panel">
        <div class="progress-top">
          <p class="progress-label">
            Tried <span id="tried-count">0</span> of {checklistTotal}
          </p>
          <div class="progress-actions">
            <button id="share-btn" type="button">Share score</button>
            <button id="reset-btn" type="button">Reset</button>
          </div>
        </div>
        <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax={checklistTotal} aria-valuenow="0" id="progress-track">
          <div class="progress-fill" id="progress-fill"></div>
        </div>
        <p class="progress-hint">
          Guest mode: saved in this browser, no account. A free account that syncs your ticks
          everywhere is coming.
        </p>
      </div>
    </div>
  </header>

  <section id="checklist">
    <div class="container">
      <h2 class="section-title">The checklist</h2>
      <p class="section-hint">
        Open a state, tick what you have tried. The classics at the top need no state at all.
      </p>

      <div class="cl-group open">
        <div class="cl-group-head">
          <h3>National classics</h3>
          <span class="count-chip" data-state-count="classics">0/{nationalClassics.length} tried</span>
        </div>
        <div class="cl-grid">
          {nationalClassics.map((c) => (
            <label class="cl-item" data-dish-card={c.id} for={`check-${c.id}`}>
              <input
                type="checkbox"
                class="vh"
                id={`check-${c.id}`}
                data-dish={c.id}
                aria-label={`Tried ${c.name}`}
              />
              <span class="tick" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={checkPath} /></svg>
              </span>
              <span class="cl-txt">
                <strong>{c.name}</strong>
                <em>{c.what}</em>
              </span>
            </label>
          ))}
        </div>
      </div>

      {byRegion.map((r) => (
        <div class="cl-region">
          <p class="cl-region-name">{r.label}</p>
          {r.states.map((s) => (
            <details class="cl-group" id={`state-${s.id}`} data-state={s.id}>
              <summary>
                <span class="cl-group-title">{s.name}</span>
                <span class="count-chip" data-state-count={s.id}>0/{s.dishes.length} tried</span>
              </summary>
              <div class="cl-grid">
                {s.dishes.map((d) => (
                  <label class="cl-item" data-dish-card={d.id} for={`check-${d.id}`}>
                    <input
                      type="checkbox"
                      class="vh"
                      id={`check-${d.id}`}
                      data-dish={d.id}
                      aria-label={`Tried ${d.name}`}
                    />
                    <span class="tick" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d={checkPath} /></svg>
                    </span>
                    <span class="cl-txt">
                      <strong>{d.name}</strong>
                      <em>{d.what}</em>
                    </span>
                  </label>
                ))}
              </div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section id="guide">
    <div class="container">
      <h2 class="section-title">The state guides</h2>
      <p class="section-hint">
        A taste of each state's kitchen. The full guides, exact streets, famous stalls, halal
        notes and ingredient detail, are part of the paid deep dives below.
      </p>

      {byRegion.map((r) => (
        <div class="region-block">
          <div class="region-heading">
            <h2>{r.label}</h2>
            <div class="rule" aria-hidden="true"></div>
          </div>
          {r.states.map((s) => (
            <div class="state-card preview">
              <div class="state-head">
                <h3>{s.name}</h3>
                <span class="tagline">{s.dishes.length} signature dishes</span>
              </div>
              <p class="state-intro">{s.intro}</p>
              <div class="dish-list">
                {s.dishes.map((d) => (
                  <div class="dish preview-row">
                    <div class="dish-top">
                      <span class="dish-name">{d.name}</span>
                      {d.origin && <span class="dish-origin">{d.origin}</span>}
                    </div>
                    <p class="dish-what">{d.what}</p>
                  </div>
                ))}
              </div>
              {s.cta && (
                <div class="state-cta">
                  <a href={s.cta.url} target="_blank" rel="noopener">{s.cta.label} &rarr;</a>
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section id="packages">
    <div class="container">
      <h2 class="section-title">Go deeper</h2>
      <p class="section-hint">
        The checklist is free and stays free. The deep dives below open the full guides.
      </p>
      <div class="pkg-grid">
        {packages.map((p) => (
          <div class={`pkg-card ${p.status}`}>
            <div class="pkg-head">
              <h3>{p.name}</h3>
              <span class={`pkg-chip ${p.status}`}>{p.status === 'free' ? 'Free' : 'Coming'}</span>
            </div>
            <p class="pkg-blurb">{p.blurb}</p>
            <ul class="pkg-list">
              {p.includes.map((i) => <li>{i}</li>)}
            </ul>
            <p class="pkg-price">{p.price}</p>
          </div>
        ))}
      </div>
      <div class="waitlist-box" id="waitlist">
        <p class="waitlist-title">Hear first when the deep dives open</p>
        <form id="waitlist-form" class="waitlist-form">
          <label for="waitlist-email" style="position:absolute;left:-9999px;">Your email</label>
          <input
            id="waitlist-email"
            name="email"
            type="email"
            required
            placeholder="you@trip.com"
            autocomplete="email"
          />
          <button type="submit" id="waitlist-btn">Join the list</button>
        </form>
        <p class="waitlist-note" id="waitlist-note" hidden></p>
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <h2 class="section-title">Questions travelers ask</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p class="answer">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <div class="cta-band">
    <div class="container">
      <h2>Eat Malaysia with people who eat Malaysia</h2>
      <p>
        Simply Enak runs guided food walks in Kuala Lumpur and George Town that cover many of these dishes
        in a single evening, led by guides from the food industry.
      </p>
      <a href="https://simplyenak.com/tours" target="_blank" rel="noopener">See the food tours</a>
    </div>
  </div>

  <footer>
    <div class="container">
      <div class="verified">
        Dish notes last checked <strong>{dataVerified.lastChecked}</strong> by{' '}
        {dataVerified.verifiedBy}, based on {dataVerified.basis}. Stall names change; the neighbourhoods
        do not.
      </div>
      <p>
        Built by <a href="https://simplyenak.com">Simply Enak</a> &middot; Malaysian food tours led by
        guides who eat their way through every state on this list.
      </p>
    </div>
  </footer>

  <script type="application/json" id="dish-data" set:html={JSON.stringify(pickerData)} />
  <script>
    (function () {
      // Formspree endpoint. Current ID is DEAD (404, found 2026-08-26) pending
      // replacement; swap here when the new form exists.
      var WAITLIST_FORM_URL = 'https://formspree.io/f/xjkyqvpz';
      var KEY = 'wtm-tried-v1';
      var TOTAL = document.querySelectorAll('[data-dish]').length;

      function load() {
        try {
          return JSON.parse(localStorage.getItem(KEY) || '[]');
        } catch (e) {
          return [];
        }
      }
      function save(ids) {
        localStorage.setItem(KEY, JSON.stringify(ids));
      }

      var tried = load();
      var boxes = Array.prototype.slice.call(document.querySelectorAll('[data-dish]'));

      function refresh() {
        var ids = boxes
          .filter(function (b) {
            return b.checked;
          })
          .map(function (b) {
            return b.getAttribute('data-dish');
          });
        tried = ids;
        save(ids);

        var n = ids.length;
        document.getElementById('tried-count').textContent = n;
        document.getElementById('progress-fill').style.width = (TOTAL ? (100 * n) / TOTAL : 0) + '%';
        document.getElementById('progress-track').setAttribute('aria-valuenow', n);

        ids.forEach(function (id) {
          var card = document.querySelector('[data-dish-card="' + id + '"]');
          if (card) card.classList.add('checked');
        });

        document.querySelectorAll('[data-state-count]').forEach(function (chip) {
          var scope = chip.getAttribute('data-state-count');
          var parent =
            scope === 'classics'
              ? document.getElementById('checklist')
              : document.getElementById('state-' + scope);
          if (!parent) return;
          var group = parent.querySelectorAll('[data-dish]');
          var done = Array.prototype.filter.call(group, function (b) {
            return b.checked;
          }).length;
          chip.textContent = done + '/' + group.length + ' tried';
        });
      }

      boxes.forEach(function (b) {
        b.checked = tried.indexOf(b.getAttribute('data-dish')) !== -1;
        b.addEventListener('change', function () {
          var card = b.closest('[data-dish-card]');
          if (card && !b.checked) card.classList.remove('checked');
          refresh();
        });
      });
      refresh();

      // Share score
      function nameOf(b) {
        return b.getAttribute('aria-label').replace(/^Tried /, '');
      }
      document.getElementById('share-btn').addEventListener('click', function () {
        var n = tried.length;
        var picks = boxes
          .filter(function (b) {
            return b.checked;
          })
          .slice(0, 3)
          .map(nameOf);
        var text =
          'Malaysia food checklist: ' + n + '/' + TOTAL + ' dishes tried' +
          (picks.length ? ' (' + picks.join(', ') + (n > 3 ? ', ...' : '') + ')' : '') +
          '. How many have you had?';
        var url = 'https://whattoeatinmalaysia.com';
        if (navigator.share) {
          navigator.share({ title: 'What to Eat in Malaysia', text: text, url: url }).catch(function () {});
        } else {
          (navigator.clipboard ? navigator.clipboard.writeText(text + ' ' + url) : Promise.reject())
            .then(function () {
              var btn = document.getElementById('share-btn');
              btn.textContent = 'Copied';
              setTimeout(function () {
                btn.textContent = 'Share score';
              }, 1600);
            })
            .catch(function () {
              window.prompt('Copy your score:', text + ' ' + url);
            });
        }
      });

      // Reset
      document.getElementById('reset-btn').addEventListener('click', function () {
        if (!window.confirm('Clear all ' + tried.length + ' ticks?')) return;
        boxes.forEach(function (b) {
          b.checked = false;
        });
        document.querySelectorAll('.checked').forEach(function (c) {
          c.classList.remove('checked');
        });
        refresh();
      });

      // State navigation: picker + surprise open the right group
      var data = JSON.parse(document.getElementById('dish-data').textContent);
      var allDishes = [];
      data.forEach(function (s) {
        s.dishes.forEach(function (d) {
          d.stateId = s.id;
          allDishes.push(d);
        });
      });
      function goTo(anchorId) {
        var el = document.getElementById(anchorId);
        if (!el) return;
        if (el.tagName === 'DETAILS') el.open = true;
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        document.querySelectorAll('.cl-group.flash').forEach(function (c) {
          c.classList.remove('flash');
        });
        el.classList.add('flash');
        setTimeout(function () {
          el.classList.remove('flash');
        }, 2400);
      }
      var picker = document.getElementById('state-picker');
      if (picker) {
        picker.addEventListener('change', function () {
          if (picker.value) goTo('state-' + picker.value);
        });
      }
      var btn = document.getElementById('random-dish');
      if (btn) {
        btn.addEventListener('click', function () {
          var d = allDishes[Math.floor(Math.random() * allDishes.length)];
          var opt = picker && picker.querySelector('option[value="' + d.stateId + '"]');
          if (opt && picker) picker.value = d.stateId;
          goTo('state-' + d.stateId);
        });
      }

      // Waitlist
      var wlForm = document.getElementById('waitlist-form');
      var wlBtn = document.getElementById('waitlist-btn');
      var wlNote = document.getElementById('waitlist-note');
      wlForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = document.getElementById('waitlist-email').value.trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
          wlNote.hidden = false;
          wlNote.textContent = 'That email does not look right.';
          return;
        }
        wlBtn.disabled = true;
        wlBtn.textContent = 'Joining...';
        fetch(WAITLIST_FORM_URL, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            email: email,
            source: 'wtm-checklist',
            _subject: '[WTM Waitlist] ' + email,
          }),
        })
          .then(function (r) {
            return r.json().then(function (j) {
              return { ok: r.ok, j: j };
            });
          })
          .then(function (res) {
            wlNote.hidden = false;
            if (res.ok && res.j.ok) {
              wlNote.textContent = res.j.dup
                ? 'You are already on the list.'
                : 'You are on the list. We will email you when the deep dives open.';
              wlForm.reset();
            } else {
              wlNote.textContent = 'Something went wrong. Try again in a minute.';
            }
          })
          .catch(function () {
            wlNote.hidden = false;
            wlNote.textContent = 'Network hiccup. Try again.';
          })
          .finally(function () {
            wlBtn.disabled = false;
            wlBtn.textContent = 'Join the list';
          });
      });
    })();
  </script>
</Layout>
