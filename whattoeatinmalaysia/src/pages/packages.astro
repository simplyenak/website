---
import Default from '~/layouts/Default.astro';
import { packages, type PackageCard, faqs } from '~/data/dishes';

const title = 'Food Guides — What to Eat in Malaysia';
const description = 'Choose your Malaysia food guide: city guides, dietary guides, or the full collection. One-time purchases, no subscriptions.';

// Filter out FAQs that are about checklist mechanics (keep only general ones)
const faqItems = faqs.filter(f => !f.q.includes('How does this') && !f.q.includes('Is the checklist free'));
---

<Default title={title} description={description}>
  <main class="packages-page">
    <div class="container">
      <header class="packages-header">
        <p class="section-eyebrow">Choose your guide</p>
        <h1>Food Guides for Malaysia</h1>
        <p class="section-hint">
          Start with the free essentials, then add the guide that matches how you travel.
          Every package unlocks progressively deeper detail.
        </p>
      </header>

      <section class="comparison-table" aria-labelledby="compare-heading">
        <h2 id="compare-heading" class="section-title">What's Included</h2>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col">Feature</th>
                {packages.map((p: PackageCard) => (
                  <th scope="col" class="pkg-col">
                    <span class={`pkg-badge ${p.status}`}>{p.price}</span>
                    {p.name}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Dish count</td>
                <td class="pkg-price-cell">12 national</td>
                <td class="pkg-price-cell">Penang districts</td>
                <td class="pkg-price-cell">KL districts</td>
                <td class="pkg-price-cell">Melaka heritage</td>
                <td class="pkg-price-cell">JAKIM areas</td>
                <td class="pkg-price-cell">Indian/Buddhist</td>
                <td class="pkg-price-cell">All included</td>
              </tr>
              <tr>
                <td>Halal notes</td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span> + JAKIM</td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
              </tr>
              <tr>
                <td>Neighborhood context</td>
                <td><span class="dash">—</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
              </tr>
              <tr>
                <td>Dietary flags</td>
                <td><span class="dash">—</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
              </tr>
              <tr>
                <td>District maps</td>
                <td><span class="dash">—</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
              </tr>
              <tr>
                <td>Transit tips</td>
                <td><span class="dash">—</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="dash">—</span></td>
                <td><span class="dash">—</span></td>
                <td><span class="check">✓</span></td>
              </tr>
              <tr>
                <td>Offline access</td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
                <td><span class="check">✓</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="package-cards" aria-labelledby="cards-heading">
        <h2 id="cards-heading" class="section-title">Pick your guide</h2>
        <div class="pkg-cards-grid">
          {packages.map((p: PackageCard, i: number) => (
            <article class="pkg-card-detail" data-pkg={p.id} style={`animation-delay: ${i * 80}ms`}>
              <header class="pkg-card-head">
                <span class={`pkg-badge ${p.status}`}>{p.price}</span>
                <h3>{p.name}</h3>
                <p class="pkg-blurb">{p.blurb}</p>
              </header>
              <ul class="pkg-includes">
                {p.includes.map((i: string) => <li>{i}</li>)}
              </ul>
              <footer class="pkg-card-foot">
                <p class="pkg-price-display">{p.price}</p>
                {p.status === 'free'
                  ? <a class="pkg-cta primary" href="/#checklist">Start using</a>
                  : <a class="pkg-cta secondary" href="/login" data-pkg={p.id}>Join waitlist</a>
                }
              </footer>
            </article>
          ))}
        </div>
      </section>

      <section class="packages-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="section-title">Questions</h2>
        <dl class="faq-list">
          {faqItems.map((f, i) => (
            <div class="faq-item">
              <dt><button class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`}>{f.q}</button></dt>
              <dd id={`faq-a-${i}`} class="faq-a" hidden>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>

      <footer class="packages-footer">
        <p>All purchases are one-time — no subscriptions, no recurring charges. Access is tied to your email; log in on any device to open your guides.</p>
        <p><a href="/login">Already bought? Log in →</a></p>
      </footer>
    </div>
  </main>

  <style>
    .pkg-card-detail {
      opacity: 0;
      transform: translateY(20px);
      animation: fade-in-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fade-in-up {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script type="module">
    // Staggered entrance animation for package cards
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.pkg-card-detail').forEach(card => {
      card.style.animationPlayState = 'paused';
      observer.observe(card);
    });

    document.querySelectorAll('.faq-q').forEach(e => {
      e.addEventListener('click', () => {
        const expanded = e.getAttribute('aria-expanded') === 'true';
        e.setAttribute('aria-expanded', String(!expanded));
        const a = document.getElementById(e.getAttribute('aria-controls'));
        if (a) a.hidden = expanded;
      });
    });

    document.querySelectorAll('.pkg-cta.secondary').forEach(e => {
      e.addEventListener('click', t => {
        const a = e.dataset.pkg;
        sessionStorage.setItem('wtm-waitlist-pkg', a);
      });
    });
  </script>
</Default>
