---
import Default from '~/layouts/Default.astro';
import { packages, type PackageCard, faqs } from '~/data/dishes';

const title = 'Deep-Dive Packages — What to Eat in Malaysia';
const description = 'Compare our deep-dive packages: Nyonya Kitchen, State Deep Dives, and the free Malaysia Basics checklist. One-time purchases, no subscriptions.';

// Filter out FAQs that are about the checklist mechanics (keep only general ones)
const faqItems = faqs.filter(f => !f.q.includes('How does this') && !f.q.includes('Is the checklist free'));
---

<Default title={title} description={description}>
  <main class="packages-page">
    <div class="container">
      <header class="packages-header">
        <p class="section-eyebrow">Deep Dives</p>
        <h1>Choose Your Package</h1>
        <p class="section-hint">
          The free checklist is just the start. Buy a deep dive to unlock full state guides, 
          exact stall locations, ingredient details, and offline access.
        </p>
      </header>

      <section class="comparison-table" aria-labelledby="compare-heading">
        <h2 id="compare-heading" class="section-title">What's Included</h2>
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col" class="pkg-col">
                <span class="pkg-badge" data-status="free">Free</span> Malaysia Basics
              </th>
              <th scope="col" class="pkg-col">
                <span class="pkg-badge" data-status="coming">Coming</span> Nyonya Kitchen
              </th>
              <th scope="col" class="pkg-col">
                <span class="pkg-badge" data-status="coming">Coming</span> State Deep Dives
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Price</td>
              <td class="pkg-price-cell">Free</td>
              <td class="pkg-price-cell">One-time, per package</td>
              <td class="pkg-price-cell">One-time, per state</td>
            </tr>
            <tr>
              <td>National checklist (12 classics)</td>
              <td><span class="check">✓</span></td>
              <td><span class="dash">—</span></td>
              <td><span class="dash">—</span></td>
            </tr>
            <tr>
              <td>State-specific dishes (69 total)</td>
              <td><span class="dash">—</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Town/neighbourhood per dish</td>
              <td><span class="check-muted">Basic</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Halal status per dish</td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Best time of day</td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Famous stall names</td>
              <td><span class="dash">—</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Diet safety flags (veg, gluten, nuts)</td>
              <td><span class="dash">—</span></td>
              <td><span class="dash">—</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Ingredient breakdowns</td>
              <td><span class="dash">—</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Offline access</td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="package-cards" aria-labelledby="cards-heading">
        <h2 id="cards-heading" class="section-title">Package Details</h2>
        <div class="pkg-cards-grid">
          <article class="pkg-card-detail" data-pkg="basic-malaysia">
            <header class="pkg-card-head">
              <span class="pkg-badge" data-status="free">Free</span>
              <h3>Malaysia Basics</h3>
              <p class="pkg-blurb">The 12-dish national classics checklist you are on right now.</p>
            </header>
            <ul class="pkg-includes">
              <li>12 national classics with origins</li>
              <li>The exact town or street for each dish</li>
              <li>Halal notes and best time of day</li>
              <li>Tick, track and share your score</li>
            </ul>
            <footer class="pkg-card-foot">
              <p class="pkg-price-display">Free</p>
              <a class="pkg-cta primary" href="/#checklist">Start using the checklist</a>
            </footer>
          </article>
          
          {packages.filter(p => p.id !== 'malaysia-basics').map((p: PackageCard) => (
            <article class="pkg-card-detail" data-pkg={p.id}>
              <header class="pkg-card-head">
                <span class={`pkg-badge ${p.status}`}>{p.status === 'free' ? 'Free' : 'Coming'}</span>
                <h3>{p.name}</h3>
                <p class="pkg-blurb">{p.description}</p>
              </header>
              <ul class="pkg-includes">
                {p.includes.map((i: string) => <li>{i}</li>)}
              </ul>
              <footer class="pkg-card-foot">
                <p class="pkg-price-display">{p.price || 'One-time, per package'}</p>
                <a class="pkg-cta secondary" href="/login" data-pkg={p.id}>Join the waitlist</a>
              </footer>
            </article>
          ))}
        </div>
      </section>

      <section class="packages-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="section-title">Questions</h2>
        <dl class="faq-list">
          {faqItems.map((f, i) => (
            <div class="faq-item">
              <dt><button class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`}>{f.q}</button></dt>
              <dd id={`faq-a-${i}`} class="faq-a" hidden>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>

      <footer class="packages-footer">
        <p>All purchases are one-time — no subscriptions, no recurring charges. Access is tied to your email; log in on any device to open your guides.</p>
        <p><a href="/login">Already bought? Log in →</a></p>
      </footer>
    </div>
  </main>

  <script type="module">
    document.querySelectorAll('.faq-q').forEach(e => {
      e.addEventListener('click', () => {
        const expanded = e.getAttribute('aria-expanded') === 'true';
        e.setAttribute('aria-expanded', String(!expanded));
        const a = document.getElementById(e.getAttribute('aria-controls'));
        if (a) a.hidden = expanded;
      });
    });
    
    document.querySelectorAll('.pkg-cta.secondary').forEach(e => {
      e.addEventListener('click', t => {
        const a = e.dataset.pkg;
        sessionStorage.setItem('wtm-waitlist-pkg', a);
      });
    });
  </script>
</Default>