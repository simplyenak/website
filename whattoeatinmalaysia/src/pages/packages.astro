---
import Default from '~/layouts/Default.astro';
import { packages, type PackageCard, faqs } from '~/data/dishes';

const title = 'Food Guides — What to Eat in Malaysia';
const description = 'City guides and dietary guides for Malaysia. One-time purchases, no subscriptions. Start with the free essentials or pick the guide for where you are going.';

// Filter out FAQs that are about checklist mechanics (keep only general ones)
const faqItems = faqs.filter(f => !f.q.includes('How does this') && !f.q.includes('Is the checklist free'));

// Guide data for cards
const guideCards = [
  {
    id: 'city-penang',
    name: 'Penang Food Guide',
    price: 'RM8',
    status: 'coming',
    image: 'https://cdn.simplyenak.com/wtm/penang-street-food.jpg',
    blurb: 'George Town, Air Itam, Bayan Lepas. Which district to walk through and when.',
    features: ['District maps', 'Best times to go', 'Transit tips']
  },
  {
    id: 'city-kl',
    name: 'Kuala Lumpur Food Guide',
    price: 'RM8',
    status: 'coming',
    image: 'https://cdn.simplyenak.com/wtm/kl-food.jpg',
    blurb: 'Chinatown, Kampung Baru, Bangsar. How to move between them by LRT or walking.',
    features: ['Neighborhood guides', 'Hawker center maps', 'Transit tips']
  },
  {
    id: 'city-melaka',
    name: 'Melaka Food Guide',
    price: 'RM8',
    status: 'coming',
    image: 'https://cdn.simplyenak.com/wtm/melaka-food.jpg',
    blurb: 'Jonker Walk, heritage quarter. Nyonya origins and night market hours.',
    features: ['Jonker Walk routes', 'Nyonya origins', 'Night market hours']
  },
  {
    id: 'dietary-halal',
    name: 'Halal Food Guide',
    price: 'RM12',
    status: 'coming',
    image: 'https://cdn.simplyenak.com/wtm/halal-guide.jpg',
    blurb: 'JAKIM-verified areas, prayer room locations, and what to ask at Chinese hawker stalls.',
    features: ['Prayer room maps', 'Ingredient watch-list', 'Where to ask']
  },
  {
    id: 'dietary-veg',
    name: 'Vegetarian Food Guide',
    price: 'RM12',
    status: 'coming',
    image: 'https://cdn.simplyenak.com/wtm/vegetarian.jpg',
    blurb: 'Indian restaurants, Buddhist cha fan outlets, and mamak ordering tricks.',
    features: ['Restaurant lists', 'Mamak ordering guide', 'Buddhist options']
  },
  {
    id: 'full-collection',
    name: 'Full Collection',
    price: 'RM25',
    status: 'coming',
    image: 'https://cdn.simplyenak.com/wtm/collection.jpg',
    blurb: 'All five guides in one purchase. Access on any device, forever.',
    features: ['Everything included', 'Cross-device sync', 'Lifetime access']
  }
];
---

<Default title={title} description={description}>
  <main class="packages-page">
    <div class="container">
      <header class="packages-header">
        <p class="section-eyebrow">Choose your guide</p>
        <h1>Food Guides for Malaysia</h1>
        <p class="section-hint">
          Twelve national classics are free forever. The deeper state-by-state guides are one-time purchases.
          Pick the one that matches where you are going.
        </p>
      </header>

      <section class="guide-cards" aria-labelledby="cards-heading">
        <h2 id="cards-heading" class="section-title">Pick your guide</h2>
        <div class="guide-cards-grid">
          {guideCards.map((card, i) => (
            <article class="guide-card-buy" data-card={card.id} style={`animation-delay: ${i * 80}ms`}>
              <div class="guide-card-image-wrap">
                <img src={card.image} alt={`${card.name} cover`} loading="lazy" />
                <span class={`guide-card-status ${card.status}`}>{card.status === 'free' ? 'Free' : 'Coming soon'}</span>
              </div>
              <div class="guide-card-body">
                <h3>{card.name}</h3>
                <p class="guide-card-blurb">{card.blurb}</p>
                <ul class="guide-card-features">
                  {card.features.map(f => <li>{f}</li>)}
                </ul>
                <div class="guide-card-foot">
                  <span class="guide-card-price">{card.price}</span>
                  <a class="guide-card-cta" href="/login" data-pkg={card.id}>Join waitlist</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="packages-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="section-title">Questions</h2>
        <dl class="faq-list">
          {faqItems.map((f, i) => (
            <div class="faq-item">
              <dt><button class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`}>{f.q}</button></dt>
              <dd id={`faq-a-${i}`} class="faq-a">{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>

      <footer class="packages-footer">
        <p>All purchases are one-time. Pay once, access forever. Your unlock is tied to your email.</p>
        <p><a href="/login">Already bought? Log in →</a></p>
      </footer>
    </div>
  </main>

  <style>
    .guide-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
      margin-bottom: 48px;
    }
    .guide-card-buy {
      border: 1px solid var(--color-border);
      border-radius: 16px;
      overflow: hidden;
      background: var(--color-card);
      display: flex;
      flex-direction: column;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .guide-card-buy:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(122, 46, 29, 0.12);
    }
    .guide-card-buy:active {
      transform: scale(0.98);
    }
    .guide-card-image-wrap {
      position: relative;
      height: 180px;
      overflow: hidden;
    }
    .guide-card-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .guide-card-status {
      position: absolute;
      top: 12px;
      right: 12px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .guide-card-status.free {
      background: #1A7A2E;
      color: #fff;
    }
    .guide-card-status.coming {
      background: #FFF3D6;
      color: #9A6B00;
    }
    .guide-card-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .guide-card-body h3 {
      font-size: 1.15rem;
      color: var(--color-primary);
      margin: 0 0 8px;
    }
    .guide-card-blurb {
      font-size: 0.9rem;
      color: var(--color-text);
      line-height: 1.55;
      margin: 0 0 16px;
      flex: 1;
    }
    .guide-card-features {
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .guide-card-features li {
      font-size: 0.78rem;
      padding: 4px 10px;
      background: var(--color-bg);
      border-radius: 999px;
      color: var(--color-muted);
      font-weight: 600;
    }
    .guide-card-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-top: 16px;
      border-top: 1px solid var(--color-border);
    }
    .guide-card-price {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-primary);
    }
    .guide-card-cta {
      display: inline-block;
      padding: 10px 20px;
      background: var(--color-accent);
      color: #fff;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .guide-card-cta:hover {
      background: #C94423;
      transform: translateY(-1px);
    }
    .guide-card-cta:active {
      transform: scale(0.96);
    }

    @media (max-width: 640px) {
      .guide-cards-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script type="module">
    // Staggered entrance animation for guide cards with fallback
    const cards = document.querySelectorAll('.guide-card-buy');
    cards.forEach(card => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.transition = 'opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    cards.forEach(card => observer.observe(card));

    // Fallback: animate if observer doesn't fire within 500ms
    setTimeout(() => {
      cards.forEach((card, i) => {
        const delay = card.style.animationDelay || `${i * 80}ms`;
        setTimeout(() => {
          card.style.transition = 'opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, parseInt(delay) || 0);
      });
    }, 500);

    document.querySelectorAll('.faq-q').forEach(e => {
      e.addEventListener('click', () => {
        const expanded = e.getAttribute('aria-expanded') === 'true';
        e.setAttribute('aria-expanded', String(!expanded));
        const a = document.getElementById(e.getAttribute('aria-controls'));
        if (a) a.hidden = expanded;
      });
    });

    document.querySelectorAll('.guide-card-cta').forEach(e => {
      e.addEventListener('click', t => {
        const a = e.dataset.pkg;
        sessionStorage.setItem('wtm-waitlist-pkg', a);
      });
    });
  </script>
</Default>
