---
import Default from '~/layouts/Default.astro';
import { states, REGION_LABELS, Region, type StateEntry, packages as pkgList } from '~/data/dishes';
import { stateImages } from '~/data/images';

const regionOrder: Region[] = ['north', 'central', 'south', 'east-coast', 'borneo'];
const grouped = regionOrder.map(r => ({ region: r, states: states.filter(s => s.region === r) }));
---

<Default title="State Guides — What to Eat in Malaysia" description="Deep-dive guides for all 16 states of Malaysia: signature dishes, famous stalls, halal status. Every must-try dish, tickable on the free checklist as you eat it.">
  <main class="guides-page">
    <div class="container">
      <h1>Malaysia State Food Guides</h1>
        <p class="lead">
          Every signature dish in each state, with where to eat, famous stalls, halal status, and best time to visit.
        </p>
      </header>

      <div class="region-tabs">
        <button class="region-tab active" data-region="all">All states</button>
        {regionOrder.map(r => (
          <button class="region-tab" data-region={r}>{REGION_LABELS[r]}</button>
        ))}
      </div>

      {grouped.map(({ region, states: regionStates }) => (
        <section class="region-section" id={region} data-region={region}>
          <h2 class="region-heading">
            {REGION_LABELS[region]}
            <span class="region-count">{regionStates.length}</span>
          </h2>
          <div class="guides-grid">
            {regionStates.map((state: StateEntry) => (
              <article class="guide-card" data-state={state.id}>
                <a class="guide-card-link" href={`/guides/${state.id}`}>
                  <div class="guide-card-image">
                    {stateImages[state.id] ? (
                      <img src={stateImages[state.id].src} alt={stateImages[state.id].alt} loading="lazy" />
                    ) : (
                      <div class="guide-card-placeholder">{state.name.slice(0, 2).toUpperCase()}</div>
                    )}
                  </div>
                  <div class="guide-card-content">
                    <header class="guide-card-head">
                      <h3>{state.name}</h3>
                      <span class="dish-count">{state.dishes.length} dishes</span>
                    </header>
                    <p class="guide-card-intro">{state.intro}</p>
                  </div>
                  <footer class="guide-card-foot">
                    <a class="guide-link" href={`/guides/${state.id}`}>Open guide →</a>
                    {state.cta && <a class="guide-cta" href={state.cta.url} target="_blank" rel="noopener">{state.cta.label}</a>}
                  </footer>
                </a>
              </article>
            ))}
          </div>
        </section>
      ))}

      <section class="guides-cta">
        <p>Want the full experience? The <a href="/packages">deep-dive packages</a> unlock exact stall addresses, halal certifications, dietary filters, and offline access for every state.</p>
      </section>
    </div>
  </main>

  <script>
    const tabs = document.querySelectorAll('.region-tab');
    const sections = document.querySelectorAll('.region-section');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const r = tab.dataset.region;
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        sections.forEach(s => {
          s.style.display = (r === 'all' || s.dataset.region === r) ? '' : 'none';
        });
      });
    });
  </script>
</Default>
