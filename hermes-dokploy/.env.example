# =============================================================================
# Hermes Agent — Secrets Template
# Copy to .env and fill in values. These are injected by Dokploy at runtime.
# =============================================================================

# Z.AI API Key (GLM-5.1 model)
GLM_API_KEY=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Home Channel (where messages are delivered, e.g. telegram:123456789)
TELEGRAM_HOME_CHANNEL=

# Telegram User ID allowlist (comma-separated — ONLY your ID)
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=

# Telegram home channel for cron delivery (your DM chat ID)
TELEGRAM_HOME_CHANNEL=

# Webhook secret (generate a random string: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# RocketChat URL
ROCKETCHAT_URL=

# RocketChat username
ROCKETCHAT_USERNAME=

# RocketChat password
ROCKETCHAT_PASSWORD=

# RocketChat allowed users (comma-separated)
ROCKETCHAT_ALLOWED_USERS=

# Telegram webhook URL
TELEGRAM_WEBHOOK_URL=

# Gateway allow all users (true/false)
GATEWAY_ALLOW_ALL_USERS=false

# Webhook enabled (true/false)
WEBHOOK_ENABLED=true

# Webhook port
WEBHOOK_PORT=8644

# Webhook secret
WEBHOOK_SECRET=

# Timezone
TZ=Asia/Kuala_Lumpur

# Mempalace URL
MEMPALACE_URL=http://mempalace-proxy:3456/mcp

# Mempalace timeout
MEMPALACE_TIMEOUT=60

# Brilliant MCP URL
BRILLIANT_MCP_URL=http://brilliant-mcp:8002/mcp

# Brilliant URL
BRILLIANT_URL=http://cortex-api:8000

# Brilliant API key
BRILLIANT_API_KEY=

# SearXNG URL
SEARXNG_URL=http://searxng:8080

# N8N webhook URL
N8N_WEBHOOK_URL=http://production-n8n-6aryb3_n8n:5678/webhook

# API server enabled
API_SERVER_ENABLED=true

# API server host
API_SERVER_HOST=0.0.0.0

# Hermes workspace password (SET A STRONG PASSWORD HERE)
HERMES_WORKSPACE_PASSWORD=

# API server key
API_SERVER_KEY=
