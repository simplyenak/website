# =============================================================================
# Hermes Agent - Hardened Docker Image
# Runs as unprivileged user, minimal attack surface
# =============================================================================

# Stage 1: Build (discarded, not in final image)
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch v2026.5.16 --depth 1 https://github.com/NousResearch/hermes-agent.git .
RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: Runtime (minimal)
FROM python:3.11-slim

LABEL maintainer="Simply Enak"
LABEL description="Hermes Agent - secured for Dokploy deployment"

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    gnupg \
    openssh-client \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @qwen-code/qwen-code wrangler \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 hermes && \
    useradd -u 1000 -g hermes -m -s /bin/bash hermes

COPY --from=builder /install /usr/local

RUN pip install --no-cache-dir "python-telegram-bot[webhooks]"

RUN pip install --no-cache-dir "hermes-agent[web,cron,voice]" "pyyaml" "mcp[cli]>=1.0"

RUN mkdir -p /home/hermes/.hermes/sessions \
    /home/hermes/.hermes/logs \
    /home/hermes/.hermes/memories \
    /home/hermes/.hermes/skills \
    /home/hermes/.hermes/cron \
    /home/hermes/.local/state/hermes \
    /home/hermes/workspace/website \
    && chown -R hermes:hermes /home/hermes

COPY --chown=hermes:hermes config/ /home/hermes/.hermes/

COPY --chown=hermes:hermes healthcheck.py /home/hermes/healthcheck.py
COPY --chown=hermes:hermes health_server.py /home/hermes/health_server.py

USER hermes
WORKDIR /home/hermes

ENV PYTHONUNBUFFERED=1
ENV PATH="/home/hermes/.local/bin:${PATH}"

EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python /home/hermes/healthcheck.py

COPY --chown=hermes:hermes entrypoint.sh /home/hermes/entrypoint.sh
RUN chmod +x /home/hermes/entrypoint.sh

CMD ["/home/hermes/entrypoint.sh"]