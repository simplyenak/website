---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex } = Astro.props;
const siteUrl = 'https://whatcanieatinmy.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og.jpg`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:image" content={ogImage} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- GA4 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SQTJJ9Y18R"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', 'G-SQTJJ9Y18R');
  </script>
  <style is:global>
    :root {
      --color-primary: #B52D38;
      --color-accent: #FFA333;
      --color-bg: #FAF7F2;
      --color-card: #FFFFFF;
      --color-text: #1A1A1A;
      --color-muted: #6B6B6B;
      --color-border: #E8E4DE;
      --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font-sans); background: var(--color-bg); color: var(--color-text); line-height: 1.6; }
    a { color: var(--color-primary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 900px; margin: 0 auto; padding: 0 1rem; }
  </style>
</head>
<body>
  <slot />
</body>
</html>
