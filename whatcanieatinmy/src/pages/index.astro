---
import Default from '~/layouts/Default.astro';
import { dishes, dietaryRestrictions } from '~/data/dishes';

const title = 'What Can I Eat in Malaysia? Dietary Safety Checker';
const description = 'Select your dietary restrictions and instantly see which Malaysian dishes are safe, which to avoid, and what hidden ingredients to ask about. Free tool for travelers visiting Malaysia.';

const dishData = dishes.map(d => ({
  id: d.id,
  name: d.name,
  category: d.category,
  origin: d.origin,
  description: d.description,
  tags: {
    vegetarian: d.vegetarian,
    vegan: d.vegan,
    halal: d.halal,
    glutenFree: d.glutenFree,
    nutFree: d.nutFree,
    shellfishFree: d.shellfishFree,
    dairyFree: d.dairyFree,
    eggFree: d.eggFree,
  },
  hiddenIngredients: d.hiddenIngredients,
}));

const cuisines = [...new Set(dishes.map(d => d.origin))];
---

<Default title={title} description={description}>
  <!-- Hero -->
  <header class="hero">
    <div class="container">
      <p class="hero-eyebrow">Free Tool for Travelers</p>
      <h1 class="hero-title">What Can I Eat in Malaysia?</h1>
      <p class="hero-subtitle">
        Select your dietary restrictions. See instantly which Malaysian dishes are safe, which to avoid, and what hidden ingredients to ask about.
      </p>
      <p class="hero-meta">
        {dishes.length} dishes · {cuisines.join(', ')} cuisines · No signup
      </p>
      <a href="#checker" class="hero-cta">Start checking ↓</a>
    </div>
  </header>

  <!-- Tool -->
  <section class="tool-section" id="checker">
    <div class="container">
      <!-- Step 1: Select -->
      <div class="selector-card">
        <h2 class="selector-title">Select Your Dietary Restrictions</h2>
        <p class="selector-hint">Toggle all that apply. Results update instantly.</p>

        <div class="toggles-grid" id="restriction-toggles">
          {dietaryRestrictions.map(r => (
            <button type="button" data-restriction={r.id} class="restriction-btn">
              <span class="restriction-icon">{r.icon}</span>
              <span class="restriction-label">{r.label}</span>
              <span class="restriction-desc">{r.description}</span>
            </button>
          ))}
        </div>

        <div class="selector-actions">
          <button id="clear-btn" class="clear-btn">Clear all</button>
          <span id="result-count" class="result-count"></span>
        </div>
      </div>

      <!-- Dish Search -->
      <div class="search-card">
        <h2 class="search-title">Check a Specific Dish</h2>
        <p class="search-hint">Type a Malaysian dish name to see if it's safe for your selected restrictions.</p>
        <div class="search-input-wrap">
          <input type="text" id="dish-search" class="search-input" placeholder="e.g. nasi lemak, char kway teow, roti canai..." autocomplete="off" />
          <span class="search-icon">🔍</span>
        </div>
        <div id="search-results" class="search-results"></div>
      </div>

      <!-- Results -->
      <div id="results-container" class="results-container">
        <div id="no-restrictions-msg" class="empty-state">
          <div class="empty-icon">🍽️</div>
          <p class="empty-text">Select at least one dietary restriction above to see safe dishes.</p>
          <p class="empty-hint">Or try a popular combination:</p>
          <div class="empty-presets">
            <button class="preset-btn" data-preset="vegetarian,halal">Vegetarian + Halal</button>
            <button class="preset-btn" data-preset="vegan,glutenFree">Vegan + Gluten-Free</button>
            <button class="preset-btn" data-preset="shellfishFree,nutFree">Shellfish + Nut Allergy</button>
          </div>
        </div>

        <div id="no-safe-msg" class="empty-state hidden">
          <div class="empty-icon">😕</div>
          <p class="empty-text">No dishes are fully safe for your combination of restrictions.</p>
          <p class="empty-hint">Check the "Caution" section below — some dishes may be OK if you ask the vendor about specific ingredients.</p>
        </div>

        <div id="safe-section" class="result-section hidden">
          <div class="result-header result-header-safe">
            <span class="result-icon">✅</span>
            <h3 class="result-title">Safe to Eat</h3>
            <span id="safe-count" class="result-count-badge"></span>
          </div>
          <div id="safe-dishes" class="dishes-grid"></div>
        </div>

        <div id="caution-section" class="result-section hidden">
          <div class="result-header result-header-caution">
            <span class="result-icon">⚠️</span>
            <h3 class="result-title">Eat with Caution — Ask First</h3>
            <span id="caution-count" class="result-count-badge"></span>
          </div>
          <p class="result-desc">These dishes may be OK depending on preparation. Check the hidden ingredients note and ask the vendor.</p>
          <div id="caution-dishes" class="dishes-grid"></div>
        </div>

        <div id="avoid-section" class="result-section hidden">
          <div class="result-header result-header-avoid">
            <span class="result-icon">🚫</span>
            <h3 class="result-title">Avoid</h3>
            <span id="avoid-count" class="result-count-badge"></span>
          </div>
          <div id="avoid-dishes" class="dishes-grid"></div>
        </div>
      </div>

      <!-- Share -->
      <div class="share-section">
        <p class="share-label">Found this useful? Share it:</p>
        <div class="share-buttons">
          <a href="https://twitter.com/intent/tweet?text=What%20can%20I%20eat%20in%20Malaysia%20with%20my%20diet%3F&url=https://whatcanieatinmy.com" target="_blank" rel="noopener" class="share-btn share-twitter">Share on X</a>
          <a href="https://www.facebook.com/sharer/sharer.php?u=https://whatcanieatinmy.com" target="_blank" rel="noopener" class="share-btn share-facebook">Share on Facebook</a>
          <a href="https://wa.me/?text=Check%20what%20you%20can%20eat%20in%20Malaysia%20with%20your%20diet%3A%20https://whatcanieatinmy.com" target="_blank" rel="noopener" class="share-btn share-whatsapp">Share on WhatsApp</a>
          <button id="copy-url-btn" class="share-btn share-copy">Copy link</button>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="seo-section">
    <div class="container seo-container">
      <h2 class="seo-title">Why Malaysian Food Trips Need a Dietary Safety Checker</h2>
      <p class="seo-text">Malaysian food is one of the world's great cuisines, but it can be tricky for travelers with dietary restrictions. Shrimp paste (belacan) hides in unexpected places. Pork lard flavors Chinese stir-fries. Ghee shows up in Indian breads. Even dishes that sound vegetarian may contain dried shrimp or fish sauce.</p>
      <p class="seo-text">This tool covers {dishes.length} common Malaysian dishes across {cuisines.join(', ')} cooking traditions. For each dish, you'll see whether it's safe, needs caution, or should be avoided for your specific dietary needs, plus the hidden ingredients to ask about.</p>

      <div class="seo-grid">
        <div class="seo-card">
          <h3 class="seo-card-title">Common Hidden Ingredients</h3>
          <ul class="seo-list">
            <li><strong>Belacan (shrimp paste):</strong> Found in sambal, curries, laksa, rojak. Even dishes that seem vegetarian may contain it.</li>
            <li><strong>Pork lard:</strong> Used in Chinese stir-fries for flavor. Char kway teow and Hokkien mee traditionally use it.</li>
            <li><strong>Ghee:</strong> Common in Indian-Muslim breads like roti canai and in some curries.</li>
            <li><strong>Soy sauce:</strong> Contains wheat unless tamari is used. Found in many Chinese dishes and sambal.</li>
            <li><strong>Coconut milk:</strong> Not dairy, but common in curries, laksa, and desserts. Safe for dairy-free, but check if you avoid coconut.</li>
            <li><strong>Peanuts:</strong> In satay sauce, apam balik, and as garnish for rojak and other dishes.</li>
          </ul>
        </div>
        <div class="seo-card">
          <h3 class="seo-card-title">Tips for Eating Safely in Malaysia</h3>
          <ul class="seo-list">
            <li><strong>Ask specifically:</strong> "Vegetarian" in Malaysia may still include fish. Say "no shrimp paste, no fish sauce, no dried shrimp" to be clear.</li>
            <li><strong>Buddhist vegetarian (zhai):</strong> Chinese Buddhist restaurants are the safest option for strict vegetarians and vegans. They avoid onion, garlic, and leek too.</li>
            <li><strong>Halal certification:</strong> Look for the JAKIM halal logo. Malay stalls are generally halal, Chinese stalls are generally not.</li>
            <li><strong>Cross-contamination:</strong> At hawker stalls, utensils may touch multiple dishes. If you have severe allergies, private tours with pre-arranged stops are safest.</li>
            <li><strong>Learn a few phrases:</strong> "Tanpa udang kering" (no dried shrimp), "tanpa babi" (no pork), "tanpa kacang" (no peanuts) go a long way.</li>
          </ul>
        </div>
      </div>

      <!-- FAQ -->
      <div class="faq-section">
        <h2 class="seo-title">Frequently Asked Questions</h2>
        <details class="faq-item">
          <summary>Is Malaysian food halal?</summary>
          <p>Malay food is generally halal (Muslim-prepared, no pork or alcohol). Chinese food is generally not halal (may contain pork, lard, or alcohol). Indian Muslim food (Mamak) is halal. Look for the JAKIM halal certification logo for certainty.</p>
        </details>
        <details class="faq-item">
          <summary>Can vegetarians eat Malaysian food?</summary>
          <p>Yes, but you need to be specific. "Vegetarian" in Malaysia may still include fish sauce, dried shrimp, or shrimp paste (belacan). The safest options are Chinese Buddhist vegetarian (zhai) restaurants, which avoid all animal products plus onion, garlic, and leek. Indian restaurants also have many vegetarian options.</p>
        </details>
        <details class="faq-item">
          <summary>What is belacan and why is it a problem?</summary>
          <p>Belacan is fermented shrimp paste, a cornerstone of Malay and Nyonya cooking. It's in sambal, curries, laksa, and rojak. It's often not visible in the dish, making it a hidden ingredient that catches vegetarians and people with shellfish allergies off guard. Always ask "ada belacan?" (is there shrimp paste?).</p>
        </details>
        <details class="faq-item">
          <summary>Is nasi lemak vegetarian?</summary>
          <p>No. Traditional nasi leak contains dried anchovies (ikan bilis) in the sambal and as garnish, and is often served with fried chicken or egg. The coconut rice itself is vegan, but the accompaniments are not. Some modern cafes offer vegetarian nasi lemak, but at hawker stalls, assume it contains anchovies.</p>
        </details>
        <details class="faq-item">
          <summary>What should I say to ask about allergens in Malay?</summary>
          <p>Useful phrases: "Tanpa udang kering" (no dried shrimp), "tanpa belacan" (no shrimp paste), "tanpa babi" (no pork), "tanpa kacang" (no peanuts), "tanpa susu" (no dairy), "tanpa telur" (no egg). Most vendors are helpful if you explain clearly.</p>
        </details>
        <details class="faq-item">
          <summary>How accurate is this tool?</summary>
          <p>This tool covers common preparations of each dish, but recipes vary between vendors and regions. Always confirm with the vendor if you have serious allergies or strict dietary requirements. This tool is a starting point, not a guarantee.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <p class="footer-text">
        Built by <a href="https://simplyenak.com" class="footer-link">Simply Enak</a> — Malaysian food tours led by guides who know what's in every dish.
      </p>
    </div>
  </footer>

  <!-- Data -->
  <script type="application/json" id="dish-data" set:html={JSON.stringify(dishData)} />
  <script type="application/json" id="restrictions-data" set:html={JSON.stringify(dietaryRestrictions)} />

  <style is:global>
    /* === Base === */
    :root {
      --c-primary: #B52D38;
      --c-accent: #FFA333;
      --c-bg: #FAF7F2;
      --c-card: #FFFFFF;
      --c-text: #1A1A1A;
      --c-muted: #6B6B6B;
      --c-border: #E8E4DE;
      --c-safe: #16a34a;
      --c-safe-bg: #dcfce7;
      --c-caution: #ca8a04;
      --c-caution-bg: #fef3c7;
      --c-avoid: #dc2626;
      --c-avoid-bg: #fee2e2;
      --c-cuisine-malay: #B52D38;
      --c-cuisine-chinese: #B8860B;
      --c-cuisine-indian: #FF6F00;
      --c-cuisine-nyonya: #8B4789;
      --c-cuisine-sarawak: #2E7D32;
      --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      --radius: 12px;
      --radius-sm: 8px;
      --shadow: 0 1px 3px rgba(0,0,0,0.06);
      --shadow-lg: 0 4px 12px rgba(0,0,0,0.08);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --c-bg: #141210;
        --c-card: #1E1B18;
        --c-text: #F0EDE8;
        --c-muted: #9E978F;
        --c-border: #2E2A25;
        --c-safe: #4ade80;
        --c-safe-bg: rgba(34,197,94,0.12);
        --c-caution: #facc15;
        --c-caution-bg: rgba(234,179,8,0.12);
        --c-avoid: #f87171;
        --c-avoid-bg: rgba(239,68,68,0.12);
        --shadow: 0 1px 3px rgba(0,0,0,0.3);
        --shadow-lg: 0 4px 12px rgba(0,0,0,0.4);
      }
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--c-bg);
      color: var(--c-text);
      line-height: 1.6;
      transition: background 0.2s, color 0.2s;
    }
    a { color: var(--c-primary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 900px; margin: 0 auto; padding: 0 1rem; }
    .hidden { display: none !important; }

    /* === Hero === */
    .hero {
      background: linear-gradient(135deg, #2a0e0e 0%, #3d1a05 40%, #1a1a1a 100%);
      color: white;
      padding: 3.5rem 1rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 30% 50%, rgba(255,163,51,0.12), transparent 60%);
    }
    .hero .container { position: relative; }
    .hero-eyebrow {
      color: var(--c-accent);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .hero-title {
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      font-weight: 800;
      margin-bottom: 0.5rem;
      line-height: 1.1;
    }
    .hero-subtitle {
      font-size: 1.05rem;
      color: rgba(255,255,255,0.7);
      max-width: 550px;
      margin: 0 auto 0.75rem;
    }
    .hero-meta {
      font-size: 0.82rem;
      color: rgba(255,255,255,0.35);
      margin-bottom: 1.25rem;
    }
    .hero-cta {
      display: inline-block;
      background: var(--c-accent);
      color: #1a1a1a;
      font-weight: 700;
      padding: 0.6rem 1.5rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: 0.9rem;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .hero-cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(255,163,51,0.3);
      text-decoration: none;
    }

    /* === Tool Section === */
    .tool-section { padding: 2rem 0; }

    .selector-card {
      background: var(--c-card);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow);
    }
    .selector-title {
      font-size: 1.25rem;
      margin-bottom: 0.2rem;
    }
    .selector-hint {
      color: var(--c-muted);
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }

    .toggles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 0.6rem;
    }
    .restriction-btn {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
      padding: 0.75rem;
      border-radius: var(--radius-sm);
      border: 2px solid var(--c-border);
      background: var(--c-card);
      cursor: pointer;
      text-align: left;
      transition: all 0.15s ease;
      font-family: inherit;
      color: var(--c-text);
    }
    .restriction-btn:hover {
      border-color: var(--c-accent);
      transform: translateY(-1px);
    }
    .restriction-btn.active {
      border-color: var(--c-accent);
      background: rgba(255,163,51,0.12);
      box-shadow: 0 0 0 1px var(--c-accent);
    }
    .restriction-btn.active .restriction-label {
      color: var(--c-primary);
    }
    .restriction-icon { font-size: 1.3rem; }
    .restriction-label { font-weight: 700; font-size: 0.85rem; }
    .restriction-desc { font-size: 0.72rem; color: var(--c-muted); line-height: 1.3; }

    .selector-actions {
      margin-top: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    /* === Dish Search === */
    .search-card {
      background: var(--c-card);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow);
    }
    .search-title {
      font-size: 1.25rem;
      margin-bottom: 0.2rem;
    }
    .search-hint {
      color: var(--c-muted);
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
    .search-input-wrap {
      position: relative;
      margin-bottom: 0.75rem;
    }
    .search-input {
      width: 100%;
      padding: 0.7rem 2.5rem 0.7rem 0.9rem;
      border: 2px solid var(--c-border);
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-family: inherit;
      background: var(--c-card);
      color: var(--c-text);
      transition: border-color 0.15s;
    }
    .search-input:focus {
      outline: none;
      border-color: var(--c-accent);
    }
    .search-input::placeholder { color: var(--c-muted); }
    .search-icon {
      position: absolute;
      right: 0.8rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1rem;
      pointer-events: none;
      opacity: 0.4;
    }
    .search-results { min-height: 1rem; }

    .search-result-card {
      background: var(--c-card);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      padding: 1rem 1.25rem;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .search-verdict {
      flex-shrink: 0;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }
    .search-verdict-safe { background: var(--c-safe-bg); }
    .search-verdict-caution { background: var(--c-caution-bg); }
    .search-verdict-avoid { background: var(--c-avoid-bg); }
    .search-verdict-unknown { background: rgba(0,0,0,0.05); }
    @media (prefers-color-scheme: dark) {
      .search-verdict-unknown { background: rgba(255,255,255,0.05); }
    }
    .search-result-body { flex: 1; min-width: 0; }
    .search-result-name { font-weight: 700; font-size: 1rem; margin-bottom: 0.1rem; }
    .search-result-meta { font-size: 0.75rem; color: var(--c-muted); margin-bottom: 0.3rem; }
    .search-result-desc { font-size: 0.85rem; color: var(--c-muted); margin-bottom: 0.4rem; }
    .search-result-badges { display: flex; flex-wrap: wrap; gap: 4px; }
    .search-no-restrictions {
      font-size: 0.85rem;
      color: var(--c-muted);
      padding: 0.5rem 0;
    }
    .search-no-results {
      font-size: 0.85rem;
      color: var(--c-muted);
      padding: 0.5rem 0;
    }
    .search-suggestions {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
      margin-top: 0.4rem;
    }
    .search-suggestion-chip {
      font-size: 0.78rem;
      padding: 0.25rem 0.6rem;
      border: 1px solid var(--c-border);
      border-radius: 999px;
      background: var(--c-card);
      cursor: pointer;
      font-family: inherit;
      color: var(--c-text);
      transition: all 0.15s;
    }
    .search-suggestion-chip:hover {
      border-color: var(--c-accent);
      background: rgba(255,163,51,0.08);
    }
    .clear-btn {
      font-size: 0.85rem;
      color: var(--c-muted);
      background: none;
      border: none;
      cursor: pointer;
      font-weight: 600;
      font-family: inherit;
    }
    .clear-btn:hover { color: var(--c-primary); }
    .result-count {
      font-size: 0.85rem;
      color: var(--c-muted);
      margin-left: auto;
    }

    /* === Empty State === */
    .empty-state {
      text-align: center;
      padding: 2.5rem 1rem;
    }
    .empty-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
    .empty-text { color: var(--c-muted); font-size: 1.05rem; margin-bottom: 0.75rem; }
    .empty-hint { font-size: 0.85rem; color: var(--c-muted); margin-bottom: 0.5rem; }
    .empty-presets {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .preset-btn {
      padding: 0.4rem 0.85rem;
      border: 1px solid var(--c-border);
      border-radius: 999px;
      background: var(--c-card);
      cursor: pointer;
      font-size: 0.8rem;
      font-family: inherit;
      color: var(--c-text);
      transition: all 0.15s;
    }
    .preset-btn:hover {
      border-color: var(--c-accent);
      background: rgba(255,163,51,0.08);
    }

    /* === Result Sections === */
    .result-section { margin-bottom: 1.5rem; }
    .result-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid;
    }
    .result-header-safe { border-color: var(--c-safe); }
    .result-header-caution { border-color: var(--c-caution); }
    .result-header-avoid { border-color: var(--c-avoid); }
    .result-icon { font-size: 1.3rem; }
    .result-title { font-size: 1.1rem; }
    .result-header-safe .result-title { color: var(--c-safe); }
    .result-header-caution .result-title { color: var(--c-caution); }
    .result-header-avoid .result-title { color: var(--c-avoid); }
    .result-count-badge {
      font-size: 0.8rem;
      color: var(--c-muted);
      font-weight: 600;
    }
    .result-desc {
      font-size: 0.83rem;
      color: var(--c-muted);
      margin-bottom: 0.75rem;
    }

    /* === Dish Cards === */
    .dishes-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
    @media (min-width: 640px) {
      .dishes-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .dish-card {
      background: var(--c-card);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      padding: 1rem;
      box-shadow: var(--shadow);
      border-left: 3px solid var(--c-border);
      transition: box-shadow 0.15s;
    }
    .dish-card:hover { box-shadow: var(--shadow-lg); }
    .dish-card[data-cuisine="Malay"] { border-left-color: var(--c-cuisine-malay); }
    .dish-card[data-cuisine="Chinese"] { border-left-color: var(--c-cuisine-chinese); }
    .dish-card[data-cuisine="Indian"] { border-left-color: var(--c-cuisine-indian); }
    .dish-card[data-cuisine="Nyonya"] { border-left-color: var(--c-cuisine-nyonya); }
    .dish-card[data-cuisine="Sarawak"] { border-left-color: var(--c-cuisine-sarawak); }

    .dish-name { font-weight: 700; font-size: 1.02rem; }
    .dish-meta {
      font-size: 0.72rem;
      color: var(--c-muted);
      margin-bottom: 0.35rem;
    }
    .dish-desc {
      font-size: 0.85rem;
      color: var(--c-muted);
      margin-bottom: 0.5rem;
    }
    .dish-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 0.25rem;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 0.72rem;
      padding: 2px 8px;
      border-radius: 999px;
      font-weight: 500;
    }
    .badge-safe { background: var(--c-safe-bg); color: var(--c-safe); }
    .badge-caution { background: var(--c-caution-bg); color: var(--c-caution); }
    .badge-avoid { background: var(--c-avoid-bg); color: var(--c-avoid); }
    .dish-hidden {
      font-size: 0.8rem;
      background: rgba(0,0,0,0.03);
      border-radius: 6px;
      padding: 0.5rem 0.65rem;
      margin-top: 0.5rem;
      color: var(--c-text);
      line-height: 1.5;
    }
    @media (prefers-color-scheme: dark) {
      .dish-hidden { background: rgba(255,255,255,0.04); }
    }

    /* === Share === */
    .share-section {
      margin-top: 2rem;
      padding: 1.25rem;
      text-align: center;
      border-top: 1px solid var(--c-border);
    }
    .share-label {
      font-size: 0.85rem;
      color: var(--c-muted);
      margin-bottom: 0.6rem;
    }
    .share-buttons {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .share-btn {
      padding: 0.4rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid var(--c-border);
      background: var(--c-card);
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s;
      color: var(--c-text);
    }
    .share-btn:hover {
      border-color: var(--c-accent);
      text-decoration: none;
      transform: translateY(-1px);
    }
    .share-twitter:hover { color: #1DA1F2; border-color: #1DA1F2; }
    .share-facebook:hover { color: #1877F2; border-color: #1877F2; }
    .share-whatsapp:hover { color: #25D366; border-color: #25D366; }

    /* === SEO Section === */
    .seo-section {
      padding: 2rem 0 2.5rem;
      border-top: 1px solid var(--c-border);
    }
    .seo-container { max-width: 760px; }
    .seo-title {
      font-size: 1.25rem;
      margin-bottom: 0.6rem;
    }
    .seo-text {
      color: var(--c-muted);
      margin-bottom: 0.75rem;
      font-size: 0.9rem;
      line-height: 1.7;
    }
    .seo-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin: 1.25rem 0;
    }
    @media (min-width: 640px) {
      .seo-grid { grid-template-columns: 1fr 1fr; }
    }
    .seo-card {
      background: var(--c-card);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      padding: 1.25rem;
      box-shadow: var(--shadow);
    }
    .seo-card-title {
      font-size: 1rem;
      margin-bottom: 0.6rem;
    }
    .seo-list {
      color: var(--c-muted);
      font-size: 0.88rem;
      padding-left: 1.2rem;
      line-height: 1.7;
    }
    .seo-list li { margin-bottom: 0.35rem; }

    /* === FAQ === */
    .faq-section { margin-top: 2rem; }
    .faq-item {
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      margin-bottom: 0.5rem;
      overflow: hidden;
    }
    .faq-item summary {
      padding: 0.85rem 1rem;
      font-weight: 600;
      font-size: 0.92rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .faq-item summary::after {
      content: '+';
      font-size: 1.2rem;
      color: var(--c-muted);
      transition: transform 0.2s;
    }
    .faq-item[open] summary::after {
      transform: rotate(45deg);
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item[open] summary {
      border-bottom: 1px solid var(--c-border);
    }
    .faq-item p {
      padding: 0.85rem 1rem;
      font-size: 0.88rem;
      color: var(--c-muted);
      line-height: 1.7;
    }

    /* === Footer === */
    .site-footer {
      padding: 1.5rem 0;
      border-top: 1px solid var(--c-border);
      text-align: center;
    }
    .footer-text {
      font-size: 0.82rem;
      color: var(--c-muted);
    }
    .footer-link {
      font-weight: 600;
    }
  </style>

  <!-- Interactive logic -->
  <script is:inline>
    (function() {
      var DISHES = JSON.parse(document.getElementById('dish-data').textContent);
      var RESTRICTIONS = JSON.parse(document.getElementById('restrictions-data').textContent);
      var activeRestrictions = new Set();

      var safeSection = document.getElementById('safe-section');
      var cautionSection = document.getElementById('caution-section');
      var avoidSection = document.getElementById('avoid-section');
      var noRestrictionsMsg = document.getElementById('no-restrictions-msg');
      var noSafeMsg = document.getElementById('no-safe-msg');
      var resultCount = document.getElementById('result-count');

      function classifyDish(dish) {
        if (activeRestrictions.size === 0) return null;
        var hasAvoid = false, hasCaution = false;
        activeRestrictions.forEach(function(rid) {
          var status = dish.tags[rid];
          if (status === 'avoid') hasAvoid = true;
          else if (status === 'caution') hasCaution = true;
        });
        if (hasAvoid) return 'avoid';
        if (hasCaution) return 'caution';
        return 'safe';
      }

      function esc(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      function dishCard(dish) {
        var badges = '';
        activeRestrictions.forEach(function(rid) {
          var status = dish.tags[rid];
          var restInfo = RESTRICTIONS.find(function(r) { return r.id === rid; });
          if (!restInfo) return;
          var cls = status === 'safe' ? 'badge-safe' : status === 'caution' ? 'badge-caution' : 'badge-avoid';
          var icon = status === 'safe' ? '✅' : status === 'caution' ? '⚠️' : '🚫';
          badges += '<span class="badge ' + cls + '">' + icon + ' ' + esc(restInfo.label) + '</span>';
        });

        var hidden = '';
        if (dish.hiddenIngredients) {
          hidden = '<div class="dish-hidden"><strong>Hidden ingredients:</strong> ' + esc(dish.hiddenIngredients) + '</div>';
        }

        return '<div class="dish-card" data-cuisine="' + esc(dish.origin) + '">' +
          '<div class="dish-name">' + esc(dish.name) + '</div>' +
          '<div class="dish-meta">' + esc(dish.category) + ' · ' + esc(dish.origin) + '</div>' +
          '<div class="dish-desc">' + esc(dish.description) + '</div>' +
          '<div class="dish-badges">' + badges + '</div>' +
          hidden +
        '</div>';
      }

      function renderResults(scroll) {
        if (activeRestrictions.size === 0) {
          noRestrictionsMsg.classList.remove('hidden');
          noSafeMsg.classList.add('hidden');
          safeSection.classList.add('hidden');
          cautionSection.classList.add('hidden');
          avoidSection.classList.add('hidden');
          resultCount.textContent = '';
          return;
        }

        noRestrictionsMsg.classList.add('hidden');

        var safe = [], caution = [], avoid = [];
        DISHES.forEach(function(dish) {
          var cat = classifyDish(dish);
          if (cat === 'safe') safe.push(dish);
          else if (cat === 'caution') caution.push(dish);
          else if (cat === 'avoid') avoid.push(dish);
        });

        // No safe dishes
        if (safe.length === 0) {
          noSafeMsg.classList.remove('hidden');
        } else {
          noSafeMsg.classList.add('hidden');
        }

        if (safe.length > 0) {
          safeSection.classList.remove('hidden');
          document.getElementById('safe-count').textContent = '(' + safe.length + ')';
          document.getElementById('safe-dishes').innerHTML = safe.map(dishCard).join('');
        } else { safeSection.classList.add('hidden'); }

        if (caution.length > 0) {
          cautionSection.classList.remove('hidden');
          document.getElementById('caution-count').textContent = '(' + caution.length + ')';
          document.getElementById('caution-dishes').innerHTML = caution.map(dishCard).join('');
        } else { cautionSection.classList.add('hidden'); }

        if (avoid.length > 0) {
          avoidSection.classList.remove('hidden');
          document.getElementById('avoid-count').textContent = '(' + avoid.length + ')';
          document.getElementById('avoid-dishes').innerHTML = avoid.map(dishCard).join('');
        } else { avoidSection.classList.add('hidden'); }

        resultCount.textContent = safe.length + ' safe · ' + caution.length + ' caution · ' + avoid.length + ' avoid';
        updateURL();

        if (scroll) {
          var results = document.getElementById('results-container');
          if (results) {
            setTimeout(function() {
              results.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        }
      }

      // === Dish Search ===
      var searchInput = document.getElementById('dish-search');
      var searchResults = document.getElementById('search-results');

      // Build search index with normalized names + aliases
      var searchIndex = DISHES.map(function(d) {
        var aliases = [];
        // Add common alternate spellings
        var aliasMap = {
          'nasi-lemak': ['nasi lemak'],
          'char-kway-teow': ['char kway teow', 'char kuay teow', 'ckt', 'kuay teow'],
          'hokkien-mee': ['hokkien mee', 'hokkien noodles'],
          'penang-asam-laksa': ['asam laksa', 'penang laksa', 'assam laksa'],
          'sarawak-laksa': ['kuching laksa'],
          'roti-canai': ['roti canai', 'roti prata'],
          'wanton-noodles': ['wanton noodles', 'wonton noodles', 'wantan mee'],
          'beef-rendang': ['rendang', 'rendang daging'],
          'sup-kambing': ['kambing soup', 'lamb soup'],
          'teh-tarik': ['teh tarik', 'pulled tea'],
          'kopi-o': ['kopi o', 'black coffee'],
          'kaya-toast': ['kaya toast', 'kaya bread'],
          'pisang-goreng': ['pisang goreng', 'fried banana', 'goreng pisang'],
          'apam-balik': ['apam balik', 'peanut pancake'],
          'tau-fu-fah': ['tau fu fah', 'taufu fah', 'tofu pudding', 'douhua'],
          'cendol': ['cendol', 'chendol', 'cheng dol'],
          'ais-kacang': ['ais kacang', 'abc', 'shaved ice', 'ice kacang'],
          'dosai-thosai': ['dosai', 'thosai', 'dosa', 'dosai thosai'],
          'banana-leaf-rice': ['banana leaf', 'banana leaf rice', 'banana leaf meal'],
          'yong-tau-foo': ['yong tau foo', 'yong tau fu', 'ytf'],
          'char-siew-rice': ['char siew', 'char siu', 'charsiew rice'],
          'hainanese-chicken-rice': ['chicken rice', 'hainan chicken rice'],
          'curry-laksa': ['curry laksa', 'curry mee'],
          'popiah': ['popiah', 'spring roll'],
          'rojak': ['rojak', 'buah rojak'],
          'satay': ['satay', 'sate', 'satai'],
          'karipap': ['karipap', 'curry puff', 'epok epok'],
          'pau-bao': ['pau', 'bao', 'steamed bun', 'pau bao'],
          'zhai-buddhist-vegetarian': ['zhai', 'buddhist vegetarian', 'loh hon chai', 'arhat vegetables'],
          'idli': ['idli', 'idly'],
          'masala-thosai': ['masala dosa', 'masala thosai', 'masala dosai'],
          'kuih-nyonya-snacks': ['kuih', 'kueh', 'nyonya snacks', 'kuih muih'],
          'penang-road-cendol': ['penang road cendol', 'penang cendol'],
          'durian': ['durian', 'king of fruits'],
          'nasi-kandar': ['nasi kandar'],
        };
        if (aliasMap[d.id]) aliases = aliasMap[d.id];
        return {
          dish: d,
          searchText: (d.name + ' ' + aliases.join(' ')).toLowerCase(),
        };
      });

      function searchDishes(query) {
        query = query.trim().toLowerCase();
        if (!query) return [];

        var matches = searchIndex.filter(function(item) {
          return item.searchText.indexOf(query) !== -1 ||
                 item.dish.name.toLowerCase().indexOf(query) !== -1;
        });

        // Sort: exact name match first, then starts-with, then contains
        matches.sort(function(a, b) {
          var aName = a.dish.name.toLowerCase();
          var bName = b.dish.name.toLowerCase();
          if (aName === query && bName !== query) return -1;
          if (bName === query && aName !== query) return 1;
          if (aName.startsWith(query) && !bName.startsWith(query)) return -1;
          if (bName.startsWith(query) && !aName.startsWith(query)) return 1;
          return 0;
        });

        return matches.map(function(m) { return m.dish; }).slice(0, 5);
      }

      function renderSearchResults(query) {
        if (!query.trim()) {
          searchResults.innerHTML = '';
          return;
        }

        var results = searchDishes(query);

        if (results.length === 0) {
          searchResults.innerHTML = '<p class="search-no-results">No dishes found for "' + esc(query) + '". Try searching for laksa, nasi, roti, or satay.</p>' +
            '<div class="search-suggestions">' +
              ['Nasi Lemak', 'Roti Canai', 'Char Kway Teow', 'Laksa', 'Satay'].map(function(name) {
                return '<button class="search-suggestion-chip" data-suggestion="' + esc(name.toLowerCase()) + '">' + esc(name) + '</button>';
              }).join('') +
            '</div>';
          attachSuggestionListeners();
          return;
        }

        var html = '';
        results.forEach(function(dish) {
          var verdict, verdictClass, verdictIcon;

          if (activeRestrictions.size === 0) {
            verdict = 'Select restrictions above to check';
            verdictClass = 'search-verdict-unknown';
            verdictIcon = '?';
          } else {
            var cat = classifyDish(dish);
            if (cat === 'safe') {
              verdict = 'Safe for your diet';
              verdictClass = 'search-verdict-safe';
              verdictIcon = '✅';
            } else if (cat === 'caution') {
              verdict = 'Caution — ask vendor first';
              verdictClass = 'search-verdict-caution';
              verdictIcon = '⚠️';
            } else {
              verdict = 'Not safe for your diet';
              verdictClass = 'search-verdict-avoid';
              verdictIcon = '🚫';
            }
          }

          var badges = '';
          if (activeRestrictions.size > 0) {
            activeRestrictions.forEach(function(rid) {
              var status = dish.tags[rid];
              var restInfo = RESTRICTIONS.find(function(r) { return r.id === rid; });
              if (!restInfo) return;
              var cls = status === 'safe' ? 'badge-safe' : status === 'caution' ? 'badge-caution' : 'badge-avoid';
              var icon = status === 'safe' ? '✅' : status === 'caution' ? '⚠️' : '🚫';
              badges += '<span class="badge ' + cls + '">' + icon + ' ' + esc(restInfo.label) + '</span>';
            });
          }

          var hidden = '';
          if (dish.hiddenIngredients) {
            hidden = '<div class="dish-hidden"><strong>Hidden ingredients:</strong> ' + esc(dish.hiddenIngredients) + '</div>';
          }

          html += '<div class="search-result-card">' +
            '<div class="search-verdict ' + verdictClass + '">' + verdictIcon + '</div>' +
            '<div class="search-result-body">' +
              '<div class="search-result-name">' + esc(dish.name) + '</div>' +
              '<div class="search-result-meta">' + esc(dish.category) + ' · ' + esc(dish.origin) + ' · ' + esc(verdict) + '</div>' +
              '<div class="search-result-desc">' + esc(dish.description) + '</div>' +
              (badges ? '<div class="search-result-badges">' + badges + '</div>' : '') +
              hidden +
            '</div>' +
          '</div>';
        });

        searchResults.innerHTML = html;
      }

      function attachSuggestionListeners() {
        document.querySelectorAll('.search-suggestion-chip').forEach(function(chip) {
          chip.addEventListener('click', function() {
            var val = chip.getAttribute('data-suggestion');
            searchInput.value = val;
            renderSearchResults(val);
          });
        });
      }

      var searchTimer = null;
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimer);
        var val = searchInput.value;
        searchTimer = setTimeout(function() {
          renderSearchResults(val);
        }, 150);
      });

      // Re-render search results when restrictions change
      var origRenderResults = renderResults;
      renderResults = function(scroll) {
        origRenderResults(scroll);
        if (searchInput.value.trim()) {
          renderSearchResults(searchInput.value);
        }
      };

      // Toggle buttons
      document.querySelectorAll('.restriction-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var rid = btn.getAttribute('data-restriction');
          if (activeRestrictions.has(rid)) {
            activeRestrictions.delete(rid);
            btn.classList.remove('active');
          } else {
            activeRestrictions.add(rid);
            btn.classList.add('active');
          }
          renderResults(true);
        });
      });

      // Preset buttons
      document.querySelectorAll('.preset-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var preset = btn.getAttribute('data-preset');
          activeRestrictions.clear();
          document.querySelectorAll('.restriction-btn').forEach(function(b) {
            b.classList.remove('active');
          });
          preset.split(',').forEach(function(rid) {
            activeRestrictions.add(rid);
            var b = document.querySelector('[data-restriction="' + rid + '"]');
            if (b) b.classList.add('active');
          });
          renderResults(true);
        });
      });

      // Clear
      document.getElementById('clear-btn').addEventListener('click', function() {
        activeRestrictions.clear();
        document.querySelectorAll('.restriction-btn').forEach(function(btn) {
          btn.classList.remove('active');
        });
        renderResults(false);
      });

      // Copy URL
      document.getElementById('copy-url-btn').addEventListener('click', function() {
        navigator.clipboard.writeText(window.location.href).then(function() {
          var btn = document.getElementById('copy-url-btn');
          var orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(function() { btn.textContent = orig; }, 2000);
        });
      });

      // URL state
      function syncFromURL() {
        var params = new URLSearchParams(window.location.search);
        var rids = params.get('r');
        if (rids) {
          rids.split(',').forEach(function(rid) {
            activeRestrictions.add(rid);
            var btn = document.querySelector('[data-restriction="' + rid + '"]');
            if (btn) btn.classList.add('active');
          });
        }
      }

      function updateURL() {
        var rids = Array.from(activeRestrictions).join(',');
        var url = new URL(window.location.href);
        if (rids) url.searchParams.set('r', rids);
        else url.searchParams.delete('r');
        window.history.replaceState({}, '', url.toString());
      }

      syncFromURL();
      renderResults(false);
    })();
  </script>
</Default>
