#!/usr/bin/env sh
# Pre-Commit Check
# Runs frontend tests and validates translations before allowing a commit

STAGED_FILES=$(git diff --cached --name-only)

# Check if frontend source or content files changed
FRONTEND_CHANGES=$(echo "$STAGED_FILES" | grep -E "frontend/src/.*\.(astro|vue|tsx|ts|js|mjs)$|frontend/src/data/" | wc -l)

if [ "$FRONTEND_CHANGES" -gt 0 ]; then
  echo ""
  echo "Frontend changes detected — running tests..."
  echo ""

  if cd frontend && npm run test:run; then
    echo ""
    echo "✅ Tests passed!"
  else
    echo ""
    echo "❌ Tests failed! Fix issues before committing."
    echo "Use 'git commit --no-verify' to bypass (not recommended)"
    echo ""
    exit 1
  fi
fi

exit 0
