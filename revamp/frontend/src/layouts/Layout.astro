---
import "@/styles/global.css";
import Header from "@/components/Header/header.astro";
import Footer from "@/components/Footer/footer.astro";
import SEO from "@/components/SEO.astro";
import CookieBanner from "@/components/CookieBanner.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { getLangFromUrl, useTranslations, localizePath } from "@/i18n/utils";
import siteSettingsData from "@/data/content/site-settings.json";
import { siteConfig } from "@/lib/site-config";

// Self-hosted fonts — latin subset only (saves ~70% vs all subsets)
// Merriweather: 400 (body), 400-italic, 600 (semibold headings), 700 (bold headings)
import "@fontsource/merriweather/latin-400.css";
import "@fontsource/merriweather/latin-400-italic.css";
import "@fontsource/merriweather/latin-600.css";
import "@fontsource/merriweather/latin-700.css";
// PT Sans: 400 (body text), 400-italic (italic body text)
import "@fontsource/pt-sans/latin-400.css";
import "@fontsource/pt-sans/latin-400-italic.css";
// Caveat: 500 (vendor captions)
import "@fontsource/caveat/latin-500.css";

const gaId: string = (siteSettingsData as any).google_analytics_id || 'G-5CY08S07Z8';
const gtmId: string = (siteSettingsData as any).google_tag_manager_id || '';
const facebookPixelId: string = (siteSettingsData as any).facebook_pixel_id || '';
const headScripts: string = (siteSettingsData as any).head_scripts || '';

// Get current language from URL
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "product";
  noindex?: boolean;
  nofollow?: boolean;
  canonicalURL?: string;
  structuredData?: object | object[];
  hreflangPath?: string;
  hreflangEnOnly?: boolean;
  // Navigation translations
  navItems?: Array<{ name: string; href: string }>;
  bookNowText?: string;
}

const {
  title = "Simply Enak | Malaysian Food Tours in KL & Penang",
  description,
  image,
  imageAlt,
  type,
  noindex,
  nofollow,
  canonicalURL,
  structuredData,
  hreflangPath,
  hreflangEnOnly,
  navItems,
  bookNowText,
} = Astro.props;
---

<!doctype html>
<html lang={lang} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      nofollow={nofollow}
      canonicalURL={canonicalURL}
      structuredData={structuredData}
      hreflangPath={hreflangPath}
      hreflangEnOnly={hreflangEnOnly}
      lang={lang}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Third-party scripts from Payload site_settings.head_scripts -->
    {headScripts && <Fragment set:html={headScripts} />}

    <!-- IndexNow verification key -->
    <meta name="indexnow-key" content="8d67ae8f-2154-434e-aca7-68b3a7fa2ee0" />

    <!-- Performance: Preconnect to critical origins (only those used on every page) -->
    <link rel="preconnect" href="https://se-website-images.s3.nl-ams.scw.cloud" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />

    <!-- Turnstile — form spam protection -->
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=YOUR_TURNSTILE_SITE_KEY"
      async
      defer
    ></script>

    <!-- Performance: Preload critical fonts (Merriweather 700 hero heading, PT Sans body text) -->
    <link rel="preload" href="/fonts/merriweather-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pt-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pt-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

<script define:vars={{ gaId }}>
      // GA4 — consent-gated. Does NOT fire until visitor accepts cookies.
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }

      function initGA4(id) {
        if (window._ga4Initialized) return;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', id, {
          send_page_view: true,
          custom_map: { tour_type: 'custom_parameter_1', booking_source: 'custom_parameter_2' },
        });
        window._ga4Initialized = true;
      }

      // Return visitor who already accepted
      if (localStorage.getItem('se_cookie_consent') === 'accepted') {
        initGA4(gaId);
      }

      // First-time visitor who accepts during this session
      document.addEventListener('cookieConsent:accepted', function () {
        initGA4(gaId);
      });

      // Tracking helpers — silent no-ops if consent not given
      function trackTourBooking(tourName, tourPrice, bookingId) {
        if (!window._ga4Initialized) return;
        gtag('event', 'purchase', {
          transaction_id: bookingId, value: tourPrice, currency: 'MYR',
          items: [{ item_id: tourName.toLowerCase().replace(/\s+/g, '_'), item_name: tourName, category: 'Food Tours', quantity: 1, price: tourPrice }],
        });
      }
      function trackTourInterest(tourName) {
        if (!window._ga4Initialized) return;
        gtag('event', 'view_item', {
          currency: 'MYR', value: 0,
          items: [{ item_id: tourName.toLowerCase().replace(/\s+/g, '_'), item_name: tourName, category: 'Food Tours' }],
        });
      }
      function trackCalendarView() {
        if (!window._ga4Initialized) return;
        gtag('event', 'view_item_list', { item_list_name: 'Tour Calendar', currency: 'MYR' });
      }
      function trackContactForm() {
        if (!window._ga4Initialized) return;
        gtag('event', 'generate_lead', { currency: 'MYR', value: 0, method: 'contact_form' });
      }

      function trackWhatsApp(source) {
        if (!window._ga4Initialized) return;
        gtag('event', 'contact', { method: 'whatsapp', event_label: source || 'unknown' });
      }

      window.trackTourBooking = trackTourBooking;
      window.trackTourInterest = trackTourInterest;
      window.trackCalendarView = trackCalendarView;
      window.trackContactForm = trackContactForm;
      window.trackWhatsApp = trackWhatsApp;

      // Global WhatsApp click tracker — catches all wa.me links across the site
      document.addEventListener('click', function (e) {
        var a = e.target.closest('a[href*="wa.me"]');
        if (!a) return;
        var source = a.dataset.trackSource || document.title || 'site';
        trackWhatsApp(source);
      });
    </script>

    <!-- Meta Pixel — consent-gated, same pattern as GA4 -->
    {facebookPixelId && (
    <script define:vars={{ facebookPixelId }}>
      function initMetaPixel(pixelId) {
        if (window._metaPixelInitialized) return;
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
        window._metaPixelInitialized = true;
      }

      if (localStorage.getItem('se_cookie_consent') === 'accepted') {
        initMetaPixel(facebookPixelId);
      }
      document.addEventListener('cookieConsent:accepted', function () {
        initMetaPixel(facebookPixelId);
      });
    </script>
    )}
  </head>
  <body class="min-h-screen">
    <!-- Skip to main content link for keyboard/screen-reader users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-primary focus:font-bold focus:rounded focus:shadow-lg focus:outline focus:outline-2 focus:outline-primary"
    >
      Skip to main content
    </a>
    <Header navItems={navItems} bookNowText={bookNowText} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner lang={lang} />

    <!-- Sticky Mobile CTA - Book Now button in thumb zone -->
    <div class="sticky-mobile-cta">
      <a href={localizePath("/tours/", lang as any)} class="cta-primary">
        {lang === 'en' ? 'Find Your Tour' : t('cta.bookExperience') || 'Find Your Tour'}
      </a>
    </div>

    <!-- Floating WhatsApp button -->
    <!-- Performance: Load chat widget after page is interactive -->
    <script is:inline>
      (function () {
        // Defer chat widget load until browser is idle
        function loadChatWidget() {
          var e = document.createElement("div");
          e.id = "myAliceWebChat";
          var t = document.createElement("script");
          t.type = "text/javascript";
          t.async = true;
          t.src = "https://livechat.myalice.ai/index.js";
          var a = document.body.getElementsByTagName("script");
          a = a[a.length - 1];
          a.parentNode.insertBefore(t, a);
          a.parentNode.insertBefore(e, a);
          t.addEventListener("load", function () {
            MyAliceWebChat.init({
              selector: "#myAliceWebChat",
              platformId: "12818",
              primaryId: "7b296d7e658e11edac5dc275f55bff6f",
              token: "4c6981083aeed7ce81f8c47d029d061227cf5f3939f449b4",
            });
          });
        }

        // Load after page is fully interactive — longer delay on mobile
        var delay = window.innerWidth < 768 ? 15000 : 3000;
        if ("requestIdleCallback" in window) {
          requestIdleCallback(loadChatWidget, { timeout: delay });
        } else {
          setTimeout(loadChatWidget, delay);
        }
      })();
    </script>
  <script>
    // Global scroll animation observer — watches all .scroll-animate elements on every page
    if (typeof window !== 'undefined') {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

      const observe = () => {
        document.querySelectorAll('.scroll-animate').forEach((el) => {
          observer.observe(el);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observe);
      } else {
        observe();
      }
    }
  </script>
  <script>
    import { WebHaptics } from 'web-haptics';
    if (WebHaptics.isSupported) {
      const haptics = new WebHaptics();
      document.addEventListener('click', (e) => {
        const target = (e.target as Element).closest('a, button');
        if (!target) return;
        if (target.matches('.primary-btn, .cta-primary, [data-haptic="success"]')) {
          haptics.trigger('success');
        } else if (target.matches('.secondary-btn, [data-haptic="nudge"]')) {
          haptics.trigger('nudge');
        }
      }, { passive: true });
    }
  </script>
  </body>
</html>