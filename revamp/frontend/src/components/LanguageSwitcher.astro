---
interface Props {
  currentLang: string;
  pathname: string;
}

import { languages } from '@/i18n/ui';
import { getLangUrl } from '@/i18n/utils';

const { currentLang, pathname } = Astro.props;

// Show all configured languages on every page
const languagesToShow = languages;

function getLanguageName(code: string): string {
  return languages[code as keyof typeof languages] || code;
}

// Get flag emoji for language
function getFlagEmoji(code: string): string {
  const flags: Record<string, string> = {
    en: '🇬🇧',
    ms: '🇲🇾',
    zh: '🇨🇳',
    de: '🇩🇪',
    es: '🇪🇸',
    fr: '🇫🇷',
    nl: '🇳🇱',
    ru: '🇷🇺',
    ja: '🇯🇵',
    pt: '🇵🇹',
  };
  return flags[code] || '🌐';
}

---

<div class="language-switcher relative inline-block">
  <details class="language-dropdown group">
    <summary class="language-trigger flex items-center gap-2 cursor-pointer hover:text-orange transition-colors list-none" aria-label="Select language">
      <span class="text-xl" aria-hidden="true">{getFlagEmoji(currentLang)}</span>
      <span class="text-sm font-medium">{getLanguageName(currentLang)}</span>
      <svg class="w-4 h-4 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <ul class="language-options absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50">
      {Object.entries(languagesToShow).map(([code, name]) => (
        <li>
          <a
            href={getLangUrl(code, pathname)}
            class={`language-link language-option flex items-center gap-3 px-4 py-2 text-sm hover:bg-orange hover:text-white transition-colors ${
              code === currentLang ? 'bg-orange/10 text-orange font-semibold' : 'text-gray-700'
            }`}
            data-lang={code}
          >
            <span class="text-xl" aria-hidden="true">{getFlagEmoji(code)}</span>
            <span>{name}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>
</div>

<script>
  // Save language preference when clicking a language link
  document.querySelectorAll('.language-link').forEach(link => {
    link.addEventListener('click', () => {
      const lang = link.getAttribute('data-lang');
      if (lang && typeof localStorage !== 'undefined') {
        localStorage.setItem('preferred_lang', lang);
      }
    });
  });
  
</script>

<style>
  .language-switcher {
    display: inline-block;
  }

  .language-dropdown {
    list-style: none;
  }

  .language-dropdown summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .language-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .language-dropdown summary::-moz-list-bullet {
    list-style-type: none;
  }

  .language-options {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
  }

  .language-dropdown[open] .language-options {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>
