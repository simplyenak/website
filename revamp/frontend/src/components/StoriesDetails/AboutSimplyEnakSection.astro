---
import { getSiteSettings } from "@/lib/content";
import Icon from "../Icon.astro";

const settings = await getSiteSettings();

const title = settings?.site_name ?? "Simply Enak";
const description =
  settings?.site_description ??
  "Simply Enak runs small-group food tours in Malaysia, taking you to the stalls, cooks, and family recipes that locals actually eat. Fourteen years walking the same markets.";

const socialItems = [
  { href: settings?.facebook_url ?? "#", icon: "facebook", bg: "bg-blue-500" },
  { href: settings?.instagram_url ?? "#", icon: "instagram", bg: "bg-black" },
  { href: settings?.youtube_url ?? "#", icon: "youtube", bg: "bg-red-500" },
].filter((s) => s.href !== "#");
---

<div class="space-y-4 p-4 border border-black/10 rounded-sm text-sm">
  <h4 class="text-h4 capitalize">{title}</h4>
  <p class="text-body">{description}</p>
  {
    socialItems.length > 0 && (
      <div class="flex items-center gap-1.5 pt-4">
        {socialItems.map((item) => (
          <a
            class={`size-10 min-w-10 ${item.bg} text-white grid place-items-center rounded-lg`}
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon class="size-5" name={item.icon} />
          </a>
        ))}
      </div>
    )
  }
</div>
