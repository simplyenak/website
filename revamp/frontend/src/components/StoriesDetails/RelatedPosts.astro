---
import { getAllStories } from "@/lib/content";
import { getImageUrl } from "@/lib/content";

const stories = await getAllStories();
const recentPosts = stories.slice(0, 3);
---

<div class="p-4 rounded-sm border border-black/10">
  <h4 class="text-h4 capitalize">Recent Posts</h4>
  <div class="space-y-4 my-5">
    {
      recentPosts.map((story) => (
        <a
          href={`/stories/${story.slug}/`}
          class="flex items-start gap-4 hover:text-primary transition-colors"
        >
          {story.hero_image && (
            <img
              src={getImageUrl(story.hero_image)}
              alt={story.title}
              class="size-16 object-cover rounded-sm flex-shrink-0"
              loading="lazy"
              width={64}
              height={64}
            />
          )}
          <div>
            <h5 class="text-body line-clamp-2 uppercase">{story.title}</h5>
          </div>
        </a>
      ))
    }
  </div>
</div>
