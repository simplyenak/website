---
import Button from "@/components/Button.astro";
import { getLangFromUrl, localizePath } from "@/i18n/utils";

interface Props {
  title: string;
  tours?: any[];
  content?: string;
}

const { title, tours, content = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const shareUrl = Astro.url.href;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(shareUrl);

const matchedTours = Array.isArray(tours) ? tours.slice(0, 2) : [];

// Extract headings for desktop table of contents
function extractHeadings(html: string) {
  const headingRegex = /<h([23])(?:[^>]*?\s+id=["']([^"']+)["'][^>]*?)?>([^<]+)<\/h\1>/g;
  const headings: Array<{ level: number; id: string; text: string }> = [];
  let match;
  
  while ((match = headingRegex.exec(html)) !== null) {
    const level = parseInt(match[1]);
    const id = match[2] || match[3].toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    const text = match[3].replace(/<[^>]+>/g, '').trim();
    
    if (text) {
      headings.push({ level, id, text });
    }
  }
  
  return headings;
}

const headings = extractHeadings(content).slice(0, 8);
const showTableOfContents = headings.length > 0;
---

<div class="space-y-8 sticky top-24">
  
  {/* Table of Contents - Desktop only */}
  {showTableOfContents && (
    <div class="hidden lg:block bg-white rounded-lg border border-gray-200 p-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-4">
        On this page
      </h3>
      <nav aria-label="Table of contents">
        <ul class="space-y-2">
          {headings.map((heading) => (
            <li class={heading.level === 3 ? 'ml-3' : ''}>
              <a 
                href={`#${heading.id}`}
                class="block text-sm text-gray-600 hover:text-primary hover:underline transition-colors py-1"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}
  <!-- Book a Tour CTA -->
  {matchedTours.length > 0 ? (
    <div class="bg-primary/5 rounded-lg p-6 border border-primary/10">
      <h3 class="text-h4 mb-1">Come Taste It</h3>
      <p class="text-sm text-gray-600 mb-5">
        These tours will take you to the stalls and cooks behind the stories.
      </p>
      <div class="space-y-3">
        {matchedTours.map((tour: any) => (
          <a
            href={localizePath(`/tours/${tour.slug}/`, lang)}
            class="group flex flex-col gap-1 p-4 bg-white border border-gray-100 hover:border-orange/30 hover:shadow-sm transition-all duration-200"
          >
            <span class="font-merriweather font-bold text-primary text-sm group-hover:text-orange transition-colors duration-200 leading-snug">{tour.name}</span>
            <div class="flex items-center gap-3 text-xs text-gray-400 mt-0.5">
              {tour.location && <span>{tour.location}</span>}
              {tour.price && <span class="text-primary font-semibold">RM {tour.price}</span>}
              {tour.duration && <span>{tour.duration}</span>}
            </div>
            <span class="text-xs font-semibold text-primary group-hover:text-orange transition-colors duration-200 mt-1">&rarr; See this tour</span>
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="bg-primary/5 rounded-lg p-6 border border-primary/10">
      <h3 class="text-h4 mb-2">Hungry for Adventure?</h3>
      <p class="text-sm text-gray-600 mb-4">
        Don't just read about the food — taste it with us. Join our guides and walk through the same stalls, meet the same cooks.
      </p>
      <Button
        href={localizePath('/tours/', lang)}
        title="Find Your Tour"
        buttonType="cta-primary"
        class="w-full justify-center"
      />
    </div>
  )}

  <!-- Share This -->
  <div>
    <h4 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-4">
      Share this story
    </h4>
    <div class="flex gap-2">
      <a
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 bg-gray-100 rounded-full hover:bg-[#1877F2] hover:text-white transition-colors"
        aria-label="Share on Facebook"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
          ></path></svg
        >
      </a>
      <a
        href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 bg-gray-100 rounded-full hover:bg-[#1DA1F2] hover:text-white transition-colors"
        aria-label="Share on Twitter"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
          ></path></svg
        >
      </a>
      <a
        href={`mailto:?subject=${encodedTitle}&body=Check out this story: ${encodedUrl}`}
        class="p-2 bg-gray-100 rounded-full hover:bg-gray-600 hover:text-white transition-colors"
        aria-label="Share via Email"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
          ></path><polyline points="22,6 12,13 2,6"></polyline></svg
        >
      </a>
    </div>
  </div>
</div>
