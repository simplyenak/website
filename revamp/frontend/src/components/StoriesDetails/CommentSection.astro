<div>
  <h4 class="text-h4 text-primary">Leave a Reply</h4>
  <p>Your email address will not be published. Required fields are marked *</p>
  <form class="space-y-4 mt-6">
    <fieldset>
      <legend class="font-medium text-base pb-1">Comment *</legend>
      <textarea
        class="border border-black p-3 w-full h-56 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
        required
      >
      </textarea>
    </fieldset>
    <fieldset>
      <legend class="font-medium text-base pb-1">Name *</legend>
      <input
        type="text"
        name="name"
        class="border border-black p-3 w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
        required
      />
    </fieldset>
    <fieldset>
      <legend class="font-medium text-base pb-1">Email *</legend>
      <input
        type="email"
        name="email"
        class="border border-black p-3 w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
        required
      />
    </fieldset>
    <fieldset>
      <legend class="font-medium text-base pb-1">Website</legend>
      <input
        type="text"
        name="website"
        class="border border-black p-3 w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
      />
    </fieldset>
    <button type="submit" class="primary-btn-small cursor-pointer">
      Post Comment
    </button>
  </form>
</div>
