---
import siteSettingsData from "@/data/content/site-settings.json";
import socialProofData from "@/data/content/social-proof.json";

interface Props {
  variant?: 'compact' | 'full' | 'inline';
  class?: string;
  // Payload data props (optional - reads from JSON by default)
  totalReviews?: number;
  averageRating?: number;
  platforms?: Array<{
    name: string;
    rating: number;
    reviews: number;
    badge: string;
  }>;
  trustBadges?: Array<{
    name: string;
    icon: string;
  }>;
}

// Read from site-settings.json and social-proof.json
const defaultRating = parseFloat(siteSettingsData?.rating || '4.9');
const defaultReviewCount = parseInt(String(siteSettingsData?.review_count ?? '5000+').replace(/[^0-9]/g, '')) || 5000;
const defaultGuests = String(siteSettingsData?.guests_hosted ?? '5,000+');

const jsonPlatforms = socialProofData?.platforms || [];
const jsonTrustBadges = socialProofData?.trust_badges || [];

const {
  variant = 'compact',
  class: className,
  totalReviews = defaultReviewCount,
  averageRating = defaultRating,
  platforms = jsonPlatforms.length > 0 ? jsonPlatforms : [],
  trustBadges = jsonTrustBadges.length > 0 ? jsonTrustBadges : [
    { name: `Tourism Malaysia Certified`, icon: '🏆' },
    { name: `${siteSettingsData?.years_operating || '14+'} Years Operating`, icon: '📅' },
    { name: `Small Groups (Max ${siteSettingsData?.max_people_per_tour || 8})`, icon: '👥' },
    { name: 'Free Cancellation', icon: '✓' }
  ]
} = Astro.props;

const variantClasses = {
  compact: 'py-6 border-y border-gray-200',
  full: 'py-12',
  inline: 'py-4'
};

// Format rating stars
function renderStars(rating: number) {
  return Array(5).fill(0).map((_, i) => {
    const starClass = i < Math.floor(rating) ? "text-yellow-500" : "text-gray-300";
    return `<span class="${starClass}" aria-hidden="true">★</span>`;
  }).join('');
}
---

<section class:list={[variantClasses[variant], 'bg-gray-50', className]}>
  <div class="main-container">
    <!-- Trust Bar - Compact Version -->
    {variant === 'compact' && (
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-8">
        <!-- Rating Summary -->
        <div class="flex items-center gap-3">
          <div class="flex items-center" aria-label={`${averageRating} out of 5 stars`} set:html={renderStars(averageRating)}></div>
          <div class="text-sm">
            <span class="font-bold text-gray-900">{averageRating}</span>
            <span class="text-gray-600"> from {totalReviews}+ reviews</span>
          </div>
        </div>
        
        <!-- Platform Badges -->
        {platforms.map((platform) => (
          <div class="flex items-center gap-2 text-sm text-gray-600">
            <span class="font-semibold text-gray-900">{platform.name}</span>
            <span class="hidden md:inline">•</span>
            <span class="hidden md:inline">{platform.badge}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Full Social Proof Section -->
    {variant === 'full' && (
      <div class="space-y-8">
        <!-- Main Rating -->
        <div class="text-center">
          <h2 class="text-h3 text-primary mb-4">Trusted by Food Lovers Worldwide</h2>
          <div class="flex items-center justify-center gap-4 mb-4">
            <div class="flex items-center" aria-label={`${averageRating} out of 5 stars`} set:html={renderStars(averageRating)}></div>
            <div class="text-left">
              <div class="text-2xl font-bold text-gray-900">{averageRating} out of 5</div>
              <div class="text-gray-600">Based on {totalReviews}+ verified reviews</div>
            </div>
          </div>
        </div>

        <!-- Platform Reviews Grid -->
        <div class="grid md:grid-cols-3 gap-6">
          {platforms.map((platform, index) => (
            <div class="bg-white rounded-lg p-6 shadow-md text-center scroll-animate" style={`animation-delay: ${index * 0.1}s`}>
              <div class="text-2xl mb-2" aria-hidden="true">
                {platform.name === 'TripAdvisor' ? '🏆' : platform.name === 'Viator' ? '⭐' : '🌟'}
              </div>
              <h3 class="text-h4 text-primary mb-2">{platform.name}</h3>
              <div class="flex items-center justify-center gap-1 mb-2" aria-label={`${platform.rating} out of 5 stars`} set:html={renderStars(platform.rating)}></div>
              <div class="text-sm text-gray-600">{platform.reviews} reviews</div>
              <div class="text-xs text-primary font-semibold mt-2">{platform.badge}</div>
            </div>
          ))}
        </div>

        <!-- Trust Badges -->
        <div class="flex flex-wrap justify-center gap-6 pt-6 border-t border-gray-200">
          {trustBadges.map((badge) => (
            <div class="flex items-center gap-2 text-sm text-gray-700">
              <span aria-hidden="true">{badge.icon}</span>
              <span>{badge.name}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Inline Version (for forms and CTAs) -->
    {variant === 'inline' && (
      <div class="flex flex-wrap items-center justify-center gap-4">
        <div class="flex items-center gap-2">
          <div class="flex items-center" aria-label={`${averageRating} out of 5 stars`} set:html={renderStars(averageRating)}></div>
          <span class="text-sm text-gray-600">{totalReviews}+ happy guests</span>
        </div>
        <span class="text-gray-300" aria-hidden="true">|</span>
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <span aria-hidden="true">✓</span>
          <span>Free cancellation</span>
        </div>
        <span class="text-gray-300" aria-hidden="true">|</span>
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <span aria-hidden="true">✓</span>
          <span>Small groups</span>
        </div>
      </div>
    )}
  </div>
</section>
