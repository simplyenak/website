---
import ContactForm from "./ContactForm.vue";
import { siteConfig } from "@/lib/site-config";
let { title, contents, webhookUrl } = Astro.props;
---

<section class="py-5 main-container">
  <div
    class:list={[
      "max-w-[960px] mx-auto rounded-sm bg-[#c4c1c11f] px-4 md:px-8 xl:px-12",
      title ? "py-8 md:py-12" : "py-4",
    ]}
  >
    {title && <h2 class="text-h2 text-primary text-center">{title}</h2>}
    <div
      class:list={[
        "text-body prose-p:mt-4 prose-ul:pl-4 prose-ul:space-y-1 prose-ul:pt-2 prose-li:relative prose-li:pl-6 [&_li]:before:content-[''] [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:top-[0.45em] [&_li]:before:w-4 [&_li]:before:h-4 [&_li]:before:bg-[url('/icon-check.svg')] [&_li]:before:bg-contain [&_li]:before:bg-no-repeat [&_li]:before:bg-center",
        title ? "mt-10" : "mt-4",
      ]}
    >
      <Fragment set:html={contents} />
    </div>
    <div class="w-full my-10 md:my-16">
      <ContactForm webhookUrl={webhookUrl} client:only="vue" />
      <p class="text-center text-sm text-gray-500 mt-4">
        Prefer to chat? <a
          href={`https://wa.me/${siteConfig.whatsappDigits}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#25D366] font-semibold hover:underline"
        >WhatsApp us instead →</a>
      </p>
    </div>
  </div>
</section>
