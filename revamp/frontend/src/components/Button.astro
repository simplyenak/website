---
import Icon from '@/components/Icon.astro'
let { icon, title, href, buttonType, class: className, ariaLabel, external = false } = Astro.props

// Use provided ariaLabel, or fall back to title
const accessibleLabel = ariaLabel || title;
---

<a
  href={href}
  class:list={[buttonType, className, "min-h-[44px] inline-flex items-center justify-center"]}
  aria-label={accessibleLabel}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span>{title}</span>
  {icon && <Icon name={icon} class="size-5" aria-hidden="true" />}
</a>
