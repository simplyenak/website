---
import { getFullMediaUrl } from "@/utils/getFullMediaUrl";
import Breadcrumb from "@/components/Breadcrumb.astro";
import siteSettingsData from "@/data/content/site-settings.json";

interface Props {
  title: string;
  /** Word or phrase within title to highlight with the amber badge (same style as homepage) */
  highlight?: string;
  subtitle?: string;
  description?: string;
  image?: string | any;
  /** Pass false to hide the footer bar. Pass a string[] to customise badges. */
  badges?: string[] | false;
  /** Deprecated – kept for compat, no longer used */
  isOverlay?: boolean;
  objectPosition?: string;
  /** Primary CTA configuration */
  ctaPrimary?: { text: string; href: string };
  /** Secondary CTA configuration */
  ctaSecondary?: { text: string; href: string };
}

const { title, highlight, subtitle, description, image, badges, ctaPrimary, ctaSecondary } = Astro.props;

// Split title around the highlighted phrase (if provided)
const highlightIdx = highlight ? title.indexOf(highlight) : -1;
const titleBefore = highlightIdx >= 0 ? title.slice(0, highlightIdx) : title;
const titleAfter  = highlightIdx >= 0 ? title.slice(highlightIdx + highlight!.length) : null;

const siteBadges = [];
if (siteSettingsData?.show_vendors !== false && siteSettingsData?.heritage_vendors_count) siteBadges.push(`${siteSettingsData.heritage_vendors_count} Heritage Vendors`);
if (siteSettingsData?.max_people_per_tour) siteBadges.push(`Small Groups · Max ${siteSettingsData.max_people_per_tour}`);
if (siteSettingsData?.company_established) siteBadges.push(`Since ${siteSettingsData.company_established}`);
const defaultBadges = siteBadges.length > 0 ? siteBadges : (siteSettingsData?.show_vendors !== false ? ["Heritage Vendors", "Small Groups · Max 9", "Since 2011"] : ["Small Groups · Max 9", "Since 2011"]);
const showBadges = Array.isArray(badges);
const badgeList = Array.isArray(badges) ? badges : defaultBadges;

const imageUrl = image
  ? (typeof image === "string" ? image : getFullMediaUrl(image))
  : null;
---

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .animate-delay-1 {
    animation-delay: 0.2s;
    opacity: 0;
  }

  .animate-delay-2 {
    animation-delay: 0.4s;
    opacity: 0;
  }
</style>

<section class="bg-dark text-white pt-16 md:pt-20 pb-6 md:pb-8 relative overflow-hidden">
  <div class="main-container text-center relative z-10">

    <!-- Title -->
    <h1 class="text-h1 mb-3 text-white animate-fade-in-up max-w-5xl mx-auto">
      {titleBefore}{titleAfter !== null && (
        <span class="bg-orange text-black px-4 py-1 inline-block shadow-lg transform -rotate-1 rounded border-2 border-black/10 whitespace-nowrap">
          {highlight}
        </span>
      )}{titleAfter}
    </h1>

    <!-- Subtitle (italic Merriweather — same style as homepage) -->
    {subtitle && (
      <p class="text-lg md:text-xl font-merriweather italic mb-3 text-gray-200 max-w-4xl mx-auto animate-fade-in-up animate-delay-1">
        {subtitle}
      </p>
    )}

    <!-- Description -->
    {description && (
      <p class="text-base text-gray-300 mb-6 max-w-3xl mx-auto animate-fade-in-up animate-delay-1">
        {description}
      </p>
    )}

    <!-- CTA Buttons -->
    {(ctaPrimary || ctaSecondary) && (
      <div class="flex flex-wrap justify-center gap-3 mb-6 animate-fade-in-up animate-delay-1">
        {ctaPrimary && (
          <a href={ctaPrimary.href} class="cta-primary min-h-[48px]">
            {ctaPrimary.text}
          </a>
        )}
        {ctaSecondary && (
          <a href={ctaSecondary.href} class="secondary-btn min-h-[48px]">
            {ctaSecondary.text}
          </a>
        )}
      </div>
    )}

    <!-- Slot (e.g. TourQuiz, additional content) -->
    <div class="mb-4 [&:empty]:mb-0">
      <slot />
    </div>

    <!-- Hero Image — shown below text, same rounded treatment as homepage -->
    {imageUrl && (
      <div class="relative w-full max-w-4xl mx-auto animate-fade-in-up animate-delay-2">
        <div class="relative rounded-lg overflow-hidden shadow-2xl">
          <img
            src={imageUrl}
            alt={title}
            class="w-full h-[220px] md:h-[300px] object-cover"
            width="1200"
            height="300"
            loading="eager"
            fetchpriority="high"
          />

          <!-- Footer bar — same style as homepage image footer -->
          {showBadges && (
            <div class="absolute bottom-0 left-0 right-0 bg-black/80 backdrop-blur-sm py-3 md:py-4">
              <div class="flex flex-wrap justify-center gap-4 md:gap-8 text-[10px] md:text-xs uppercase tracking-widest font-semibold text-gray-200">
                {badgeList.map((badge) => (
                  <span class="flex items-center gap-1.5">
                    <span class="text-orange">✓</span> {badge}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Extra bottom space when there's no image -->
    {!imageUrl && <div class="pb-8" />}
  </div>
</section>
<Breadcrumb />
