---
import { renderInlineMarkdown } from '@/lib/render-inline-markdown';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
  title?: string;
  variant?: 'accordion' | 'static';
}

const {
  faqs,
  title = "Frequently Asked Questions",
  variant = 'static'
} = Astro.props;
---

<section class="py-16 md:py-20 bg-cream">
  <div class="main-container">
    <h2 class="text-h2 text-primary text-center mb-12">{title}</h2>

    <div class="max-w-3xl mx-auto space-y-6">
      {faqs.map((faq, index) => (
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="font-semibold text-lg text-gray-900 mb-3">
            {faq.question}
          </h3>
          <p class="text-body leading-relaxed" set:html={renderInlineMarkdown(faq.answer)} />
        </div>
      ))}
    </div>
  </div>
</section>
