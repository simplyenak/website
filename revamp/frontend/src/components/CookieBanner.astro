---
// Simple GDPR cookie consent banner — stored in localStorage
// Reads config from site-settings.json (synced from Payload CMS)
import siteSettingsData from "@/data/content/site-settings.json";
import { getLangFromUrl } from "@/i18n/utils";
import { useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

const cookieEnabled = siteSettingsData?.cookie_banner_enabled !== false;
const cookieMessage = lang !== 'en' ? t('cookie.message') : siteSettingsData?.cookie_banner_message;
const cookiePrivacyLink = siteSettingsData?.cookie_banner_privacy_link;
const cookieDeclineText = lang !== 'en' ? t('cookie.decline') : siteSettingsData?.cookie_banner_decline_text;
const cookieAcceptText = lang !== 'en' ? t('cookie.accept') : siteSettingsData?.cookie_banner_accept_text;
---

{cookieEnabled && (
<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[2000] bg-[#1a1a1a] border-t border-white/10 shadow-[0_-4px_24px_rgba(0,0,0,0.15)] px-4 py-4 hidden"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <div class="flex items-start gap-3 flex-1">
      <span class="text-orange text-xl leading-none mt-0.5" aria-hidden="true">🍪</span>
      <p class="text-sm text-white/80 leading-relaxed">
        {cookieMessage || t('cookie.message')}
        <a href={cookiePrivacyLink || "/privacy-policy/"} class="text-orange underline hover:text-orange/80 transition-colors">{t('cookie.privacyPolicy')}</a>.
      </p>
    </div>
    <div class="flex gap-3 flex-shrink-0 self-end sm:self-center">
      <button
        id="cookie-decline"
        class="text-sm text-white/50 hover:text-white/80 border border-white/20 px-4 py-2 rounded-lg hover:border-white/40 transition-all"
      >
        {cookieDeclineText || t('cookie.decline')}
      </button>
      <button
        id="cookie-accept"
        class="text-sm font-semibold bg-orange text-dark px-5 py-2 rounded-lg hover:bg-orange/90 transition-colors"
      >
        {cookieAcceptText || t('cookie.accept')}
      </button>
    </div>
  </div>
</div>
)}

<script>
  const CONSENT_KEY = "se_cookie_consent";

  function initBanner() {
    const consent = localStorage.getItem(CONSENT_KEY);
    if (consent) return; // already decided

    const banner = document.getElementById("cookie-banner");
    const acceptBtn = document.getElementById("cookie-accept");
    const declineBtn = document.getElementById("cookie-decline");
    if (!banner) return;

    // Show after a brief delay so it doesn't flash on first paint
    setTimeout(() => {
      banner.classList.remove("hidden");
      document.body.classList.add("cookie-banner-visible");
    }, 800);

    function hideBanner() {
      banner.classList.add("hidden");
      document.body.classList.remove("cookie-banner-visible");
    }

    acceptBtn?.addEventListener("click", () => {
      localStorage.setItem(CONSENT_KEY, "accepted");
      hideBanner();
      document.dispatchEvent(new Event("cookieConsent:accepted"));
    });

    declineBtn?.addEventListener("click", () => {
      localStorage.setItem(CONSENT_KEY, "declined");
      hideBanner();
      // Delete any GA4 cookies already set (covers _ga, _gid, _ga_XXXXXXXX)
      document.cookie.split(";").forEach((c) => {
        const name = c.trim().split("=")[0];
        if (name.startsWith("_ga") || name === "_gid") {
          const expired = name + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=" + location.hostname;
          document.cookie = expired;
          document.cookie = expired.replace("domain=" + location.hostname, "domain=." + location.hostname);
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initBanner);
</script>
