---
// Why Choose Us section - location-specific differentiators

interface Benefit {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  benefits: Benefit[];
  location: string;
}

const { benefits, location } = Astro.props;

// Map icon names to SVG paths
const iconMap: Record<string, string> = {
  "local-expert":
    "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222",
  "small-groups":
    "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a4.902 4.902 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  authentic:
    "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  "beyond-food":
    "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
};

const getIconPath = (iconName: string): string => {
  return (
    iconMap[iconName] ||
    "M13 10V3L4 14h7v7l9-11h-7z" // Default icon
  );
};
---

<section class="why-choose-us-section py-16 md:py-24 bg-gradient-to-b from-gray-50 to-white">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        Why Choose Simply Enak in {location}
      </h2>
      <p class="text-lg text-gray-600 leading-relaxed">
        We're not just another food tour company. Here's what makes us different, and
        why guests keep recommending us.
      </p>
    </div>

    <!-- Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-6xl mx-auto">
      {
        benefits.map((benefit, index) => (
          <div
            class="benefit-card group"
            style={`animation-delay: ${index * 100}ms;`}
          >
            {/* Icon */}
            <div class="benefit-icon-wrapper mb-6">
              <div class="benefit-icon-bg bg-yellow-100 group-hover:bg-yellow-200 transition-colors duration-300 rounded-full w-16 h-16 flex items-center justify-center">
                <svg
                  class="w-8 h-8 text-yellow-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={getIconPath(benefit.icon)}
                  />
                </svg>
              </div>
            </div>

            {/* Content */}
            <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3">
              {benefit.title}
            </h3>
            <p class="text-gray-600 leading-relaxed">{benefit.description}</p>
          </div>
        ))
      }
    </div>

    <!-- Bottom Quote/Testimonial -->
    <div class="mt-16 text-center max-w-3xl mx-auto">
      <blockquote class="relative">
        <svg
          class="absolute top-0 left-0 transform -translate-x-6 -translate-y-8 h-16 w-16 text-yellow-200"
          fill="currentColor"
          viewBox="0 0 32 32"
        >
          <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 4.988 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-4.988-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 4.988 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"
          ></path>
        </svg>
        <p class="text-xl md:text-2xl text-gray-700 italic font-light relative z-10">
          "This isn't a food tour. The food tells you more about Malaysia than any guidebook could."
        </p>
        <footer class="mt-4 text-gray-500">
          — What guests tell us after their first tour
        </footer>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .benefit-card {
    opacity: 0;
    animation: fade-in-up 0.8s ease-out forwards;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Stagger animation on scroll */
  @media (prefers-reduced-motion: no-preference) {
    .benefit-card {
      animation-play-state: paused;
    }

    .benefit-card.in-view {
      animation-play-state: running;
    }
  }
</style>

<script>
  // Trigger animation on scroll
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
          }
        });
      },
      {
        threshold: 0.1,
      }
    );

    document.querySelectorAll(".benefit-card").forEach((card) => {
      observer.observe(card);
    });
  } else {
    // Fallback: just show all cards
    document.querySelectorAll(".benefit-card").forEach((card) => {
      card.classList.add("in-view");
    });
  }
</script>
