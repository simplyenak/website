---
// Hero section for location landing pages
// Above-the-fold content optimized for conversion and engagement
import { siteConfig } from "@/lib/site-config";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  ctaText: string;
  ctaUrl: string;
  backgroundImage?: string;
  trustSignals: {
    reviewCount: number;
    rating: number;
    tripadvisorRanking: number;
    certificateOfExcellence: boolean;
  };
}

const {
  title,
  subtitle,
  description,
  ctaText,
  ctaUrl,
  backgroundImage,
  trustSignals,
} = Astro.props;

// Generate stars for rating display
const stars = Array(5).fill(0);
---

<section class="hero-section relative overflow-hidden">
  <!-- Background with overlay -->
  {
    backgroundImage && (
      <div class="hero-background absolute inset-0 z-0">
        <img
          src={backgroundImage}
          alt={`${title} - Food tour background`}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/30" />
      </div>
    )
  }

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-4 py-20 md:py-28 lg:py-32">
    <div class="max-w-3xl">
      <!-- Subtitle/Eyebrow -->
      <p class="text-yellow-400 font-semibold text-sm md:text-base uppercase tracking-wide mb-4 animate-fade-in">
        {subtitle}
      </p>

      <!-- Main Headline -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6 animate-fade-in-up"
      >
        {title}
      </h1>

      <!-- Description -->
      <p
        class="text-lg md:text-xl text-gray-200 leading-relaxed mb-8 animate-fade-in-up animation-delay-200"
      >
        {description}
      </p>

      <!-- Trust Signals -->
      <div
        class="flex flex-wrap items-center gap-6 mb-8 animate-fade-in-up animation-delay-300"
      >
        <!-- Rating Stars -->
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
          <div class="flex gap-1">
            {
              stars.map(() => (
                <svg
                  class="w-5 h-5 text-yellow-400 fill-current"
                  viewBox="0 0 20 20"
                >
                  <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                </svg>
              ))
            }
          </div>
          <span class="text-white font-semibold text-sm">
            {trustSignals.rating.toFixed(1)} ({trustSignals.reviewCount}+ reviews)
          </span>
        </div>

        <!-- TripAdvisor Ranking -->
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
          <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            ></path>
          </svg>
          <span class="text-white font-semibold text-sm">
            #{trustSignals.tripadvisorRanking} on TripAdvisor
          </span>
        </div>

        <!-- Certificate of Excellence -->
        {
          trustSignals.certificateOfExcellence && (
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="text-white font-semibold text-sm">
                Certificate of Excellence
              </span>
            </div>
          )
        }
      </div>

      <!-- CTA Button -->
      <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animation-delay-400">
        <a
          href={ctaUrl}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-yellow-500 hover:bg-yellow-600 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105"
        >
          {ctaText}
          <svg
            class="w-5 h-5 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>

        <!-- Secondary CTA - WhatsApp -->
        <a
          href={`https://wa.me/${siteConfig.whatsappDigits}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-green-600 hover:bg-green-700 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 border-2 border-white/20"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 4.977 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-4.931-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          Chat on WhatsApp
        </a>
      </div>

      <!-- Trust note -->
      <p class="text-sm text-gray-300 mt-6 animate-fade-in-up animation-delay-500">
        <svg
          class="w-4 h-4 inline mr-1 text-green-400"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
         Free cancellation up to 48 hours • Small groups (max {siteConfig.maxPeoplePerTour} people) • Local expert
        guides
      </p>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10 animate-bounce"
  >
    <svg
      class="w-6 h-6 text-white opacity-75"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<style>
  .hero-section {
    min-height: 85vh;
    display: flex;
    align-items: center;
  }

  .hero-background img {
    object-position: center 40%;
  }

  /* Animations */
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-300 {
    animation-delay: 0.3s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-500 {
    animation-delay: 0.5s;
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .hero-section {
      min-height: 80vh;
    }

    .hero-background img {
      object-position: center;
    }
  }

  /* Ensure text is always readable over background */
  @media (prefers-color-scheme: light) {
    .hero-background::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.8),
        rgba(0, 0, 0, 0.6),
        rgba(0, 0, 0, 0.4)
      );
    }
  }
</style>
