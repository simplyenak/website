---
// Guides section showcasing local food experts
interface Props {
  guides: Array<{
    name: string;
    photo: string;
    bio: string;
    specialties: string[];
    credentials?: string[];
  }>;
}

const { guides } = Astro.props;
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Meet Your Local Food Experts
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Our guides aren't trained presenters reading scripts—they're locals sharing their culture,
        their neighborhoods, and often their family's food traditions.
      </p>
    </div>

    <!-- Guide Cards -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        guides.map((guide, index) => (
          <div class="text-center group">
            {/* Photo */}
            <div class="relative mb-6 mx-auto w-32 h-32">
              <div class="absolute inset-0 bg-yellow-400 rounded-full opacity-20 group-hover:opacity-30 transition-opacity duration-300 transform scale-110" />
              <img
                src={guide.photo}
                alt={`${guide.name} - Kuala Lumpur food guide`}
                class="relative w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
                loading="lazy"
              />
            </div>

            {/* Name */}
            <h3 class="text-xl font-bold text-gray-900 mb-3">{guide.name}</h3>

            {/* Bio */}
            <p class="text-gray-600 text-sm leading-relaxed mb-4 px-2">
              {guide.bio}
            </p>

            {/* Specialties */}
            <div class="flex flex-wrap justify-center gap-2 mb-3">
              {guide.specialties.map((specialty) => (
                <span class="px-3 py-1 bg-yellow-50 text-yellow-700 text-xs font-medium rounded-full">
                  {specialty}
                </span>
              ))}
            </div>

            {/* Credentials */}
            {guide.credentials && guide.credentials.length > 0 && (
              <div class="border-t pt-3">
                <p class="text-xs font-semibold text-gray-700 mb-2 text-center">Expertise & Credentials:</p>
                <ul class="space-y-1">
                  {guide.credentials.map((credential) => (
                    <li class="text-xs text-gray-600 flex items-center justify-center">
                      <svg class="w-3 h-3 text-green-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      {credential}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <!-- Trust Message -->
    <div class="mt-12 text-center">
      <div class="bg-yellow-50 rounded-lg p-6 max-w-2xl mx-auto">
        <div class="flex items-center justify-center mb-3">
          <svg
            class="w-8 h-8 text-yellow-600 mr-2"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <h3 class="text-lg font-semibold text-gray-900">
            Born & Raised in Kuala Lumpur
          </h3>
        </div>
        <p class="text-gray-600 text-sm">
          Each guide brings their personal story and deep connection to KL's food culture.
          They're not showing you tourist spots—they're sharing their home.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fade in animation for guide cards */
  .grid > div {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .grid > div:nth-child(1) { animation-delay: 0.1s; }
  .grid > div:nth-child(2) { animation-delay: 0.2s; }
  .grid > div:nth-child(3) { animation-delay: 0.3s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Group hover effect */
  .group:hover .relative img {
    transform: scale(1.05);
    transition: transform 0.3s ease;
  }
</style>