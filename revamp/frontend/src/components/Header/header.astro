---
interface Props {
  navItems?: Array<{ name: string; href: string }>;
  bookNowText?: string;
}

import MobileMenu from "@/components/Header/mobile-menu.astro";
import LanguageSelector from "@/components/Header/LanguageSelector.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { Image } from "astro:assets";
import { getSiteSettings, getHeaderNavItems } from "@/lib/content";
import { siteConfig } from "@/lib/site-config";
import { getLangFromUrl, localizePath } from "@/i18n/utils";
import { useTranslations } from "@/i18n/utils";

// Get language and translations
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

// Fetch navigation from Payload or use provided props
const PayloadNavItems = await getHeaderNavItems();

// Map Payload href patterns to t() keys for non-English pages
function translateNavName(item: { name: string; href: string }, fallback: string): string {
  if (lang === 'en') return item.name || fallback;
  const href = (item.href || '').toLowerCase();
  if (href.includes('private')) return t('nav.privateTours') || item.name;
  if (href.includes('/tours') && !href.includes('private')) return t('nav.tours') || item.name;
  if (href.includes('/stories')) return t('nav.stories') || item.name;
  if (href.includes('/about')) return t('nav.about') || item.name;
  if (href.includes('/contact')) return t('nav.contact') || item.name;
  if (href.includes('vendors')) return t('nav.vendors') || item.name;
  if (href === '/' || href.includes('home')) return t('nav.home') || item.name;
  return item.name || fallback;
}

const translatedNavItems = PayloadNavItems.map(item => ({
  ...item,
  name: translateNavName(item, item.name),
}));

const {
  navItems = translatedNavItems.length > 0 ? translatedNavItems : [
    { name: t('nav.privateTours') || 'Private Tours', href: localizePath("/tours/private-tours/", lang) },
    { name: t('nav.tours'), href: localizePath("/tours/", lang) },
    { name: t('nav.stories'), href: localizePath("/stories/", lang) },
    { name: t('nav.about'), href: localizePath("/about/", lang) },
    { name: t('nav.contact'), href: localizePath("/contact/", lang) },
  ],
  bookNowText = t('nav.bookNow')
} = Astro.props;

import logoImage from "@/assets/images/simply_enak_logo.webp";

const settings = await getSiteSettings();

const header = {
  logo: logoImage,
  phone: settings?.contact_phone ?? siteConfig.phone,
  email: settings?.contact_email ?? siteConfig.email,
  navItems,
};

const activeUrl = Astro.url.pathname;
---

<header
  id="header"
  class="bg-white shadow-md inset-x-0 top-0 duration-300 z-50 sticky"
>
  <nav
    class="main-container flex items-center justify-between gap-3 py-4 md:py-5 overflow-hidden"
    aria-label="Main navigation"
  >
    <a href="/" class="flex-shrink-0">
      <Image
        src={header.logo}
        alt="Simply Enak Logo"
        class="h-10 md:h-12 w-auto"
        height={72}
        width={270}
        priority
      />
    </a>

    <div class="hidden lg:flex items-center gap-5 xl:gap-8">
      <ul class="flex gap-5 xl:gap-7 items-center">
        {
          header.navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "text-gray-800 hover:text-[var(--color-orange)] text-sm xl:text-base duration-300 font-semibold font-merriweather transition-colors whitespace-nowrap",
                  activeUrl === item.href ? "text-[var(--color-orange)]" : "",
                ]}
                aria-current={activeUrl === item.href ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Contact Details -->
      <div
        class="flex flex-col items-end gap-1 text-xs text-gray-700 border-l border-gray-300 pl-6"
      >
        <a
          href={`tel:${header.phone.replace(/[\s-]/g, "")}`}
          class="flex items-center gap-2 hover:text-[var(--color-orange)] transition-colors"
          aria-label={`Call us at ${header.phone}`}
        >
          <svg
            class="w-3 h-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span aria-hidden="true">{header.phone}</span>
        </a>
        <a
          href={`mailto:${header.email}`}
          class="flex items-center gap-2 hover:text-[var(--color-orange)] transition-colors"
          aria-label={`Email us at ${header.email}`}
        >
          <svg
            class="w-3 h-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span aria-hidden="true">{header.email}</span>
        </a>
      </div>

      <!-- Language Switcher -->
      <LanguageSwitcher currentLang={lang} pathname={Astro.url.pathname} />

      <a
        href={localizePath("/tours/", lang)}
        class="cta-primary whitespace-nowrap"
      >
        {bookNowText}
      </a>
    </div>

    <MobileMenu navItems={header.navItems} phone={header.phone} email={header.email} />
  </nav>
</header>
