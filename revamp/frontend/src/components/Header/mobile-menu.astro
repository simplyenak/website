---
import IconMenu from '@/assets/icons/icon-menu.svg'
import IconClose from '@/assets/icons/icon-close.svg'
import LanguageSelector from './LanguageSelector.astro'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { getLangFromUrl, localizePath } from '@/i18n/utils'
import { siteConfig } from '@/lib/site-config'

type Props = {
  navItems: Array<{
    name: string
    href: string
  }>
  phone?: string
  email?: string
}
const { navItems, phone = siteConfig.phone, email = siteConfig.email } = Astro.props

const activeUrl = Astro.url.pathname
const lang = getLangFromUrl(Astro.url)
---

<div class="lg:hidden">
  <button
    class="cursor-pointer"
    data-mobile-menu-open
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
  >
    <IconMenu class="size-8 text-primary" aria-hidden="true" focusable="false" />
  </button>
  <div
    class="fixed inset-0 z-30 bg-black/20 hidden"
    data-mobile-menu-overlay
    aria-hidden="true"
  ></div>
  <div
    id="mobile-menu-panel"
    class="max-w-[400px] z-40 w-full bg-white fixed right-0 inset-y-0 shadow-custom translate-x-full transition-transform duration-300"
    data-mobile-menu
    transition:persist
    role="dialog"
    aria-modal="true"
    aria-label="Navigation menu"
    hidden
  >
    <button
      class="absolute top-4 right-4 cursor-pointer size-8 min-w-8 grid place-content-center text-primary hover:text-black duration-300 border border-text/10 rounded-full"
      data-mobile-menu-close
      aria-label="Close navigation menu"
    >
      <IconClose class="size-5" aria-hidden="true" focusable="false" />
    </button>
    <ul class="flex flex-col justify-start h-full py-16" role="list">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'px-10 py-2.5 text-body w-full block text-primary hover:bg-text/5 duration-300 font-semibold font-merriweather',
                activeUrl === item.href ? 'bg-text/5' : '',
              ]}
              aria-current={activeUrl === item.href ? 'page' : undefined}
            >
              {item.name}
            </a>
          </li>
        ))
      }

      <!-- Book Now Button -->
      <li class="px-10 pt-4">
        <a
          href={localizePath("/tours/", lang)}
          class="cta-primary w-full"
        >
          Book Now
        </a>
      </li>

      <!-- Contact Details for Mobile -->
      <li class="px-10 pt-6 space-y-4">
        <a
          href={`tel:${phone.replace(/[\s-]/g, "")}`}
          class="flex items-center gap-2 text-gray-700 hover:text-[var(--color-orange)] transition-colors"
          aria-label={`Call us at ${phone}`}
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span class="text-sm font-medium" aria-hidden="true">{phone}</span>
        </a>

        <a
          href={`mailto:${email}`}
          class="flex items-center gap-2 text-gray-700 hover:text-[var(--color-orange)] transition-colors"
          aria-label={`Email us at ${email}`}
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="text-sm font-medium" aria-hidden="true">{email}</span>
        </a>
      </li>

      <!-- Social Media Links -->
      <li class="px-10 pt-6">
        <div class="flex items-center gap-4">
          <a
            href={siteConfig.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#1877f2] transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#E4405F] transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.84.97 3.252.148 4.771 1.691 4.919 4.919.058 1.264.969 1.644.969 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.84.97-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <a
            href={siteConfig.social.tripadvisor}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#00AF87] transition-colors"
            aria-label="TripAdvisor"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2.182c5.42 0 9.818 4.398 9.818 9.818S17.42 21.818 12 21.818 2.182 17.42 2.182 12 6.58 2.182 12 2.182zM8.182 12a1.909 1.909 0 11-3.818 0 1.909 1.909 0 013.818 0zm11.454 0a1.909 1.909 0 11-3.818 0 1.909 1.909 0 013.818 0z"/>
            </svg>
          </a>
        </div>
      </li>

      <!-- Language Switcher -->
      <li class="px-10 pt-6 border-t border-gray-200 mt-4">
        <div class="flex items-center gap-2 text-sm font-semibold text-gray-700 mb-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span>Language</span>
        </div>
        <LanguageSwitcher currentLang={lang} pathname={activeUrl} />
      </li>
    </ul>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuOpen = document.querySelector('[data-mobile-menu-open]') as HTMLButtonElement | null
    const mobileMenuClose = document.querySelector('[data-mobile-menu-close]') as HTMLButtonElement | null
    const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement | null
    const mobileMenuOverlay = document.querySelector('[data-mobile-menu-overlay]') as HTMLElement | null

    const FOCUSABLE = 'a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex="-1"])'

    function getFocusableElements(): HTMLElement[] {
      if (!mobileMenu) return []
      return Array.from(mobileMenu.querySelectorAll<HTMLElement>(FOCUSABLE))
    }

    function openMenu() {
      if (!mobileMenu) return
      mobileMenu.removeAttribute('hidden')
      mobileMenu.classList.remove('translate-x-full')
      mobileMenu.classList.add('translate-x-0')
      mobileMenuOverlay?.classList.remove('hidden')
      mobileMenuOverlay?.removeAttribute('aria-hidden')
      mobileMenuOpen?.setAttribute('aria-expanded', 'true')
      // Move focus to close button
      setTimeout(() => mobileMenuClose?.focus(), 50)
    }

    function closeMenu() {
      if (!mobileMenu) return
      mobileMenu.classList.remove('translate-x-0')
      mobileMenu.classList.add('translate-x-full')
      mobileMenuOverlay?.classList.add('hidden')
      mobileMenuOverlay?.setAttribute('aria-hidden', 'true')
      mobileMenuOpen?.setAttribute('aria-expanded', 'false')
      // Return focus to open button after transition
      setTimeout(() => {
        mobileMenu.setAttribute('hidden', '')
        mobileMenuOpen?.focus()
      }, 300)
    }

    // Trap focus within the menu when open
    function handleKeydown(e: KeyboardEvent) {
      if (!mobileMenu || mobileMenu.hasAttribute('hidden')) return

      if (e.key === 'Escape') {
        closeMenu()
        return
      }

      if (e.key === 'Tab') {
        const focusable = getFocusableElements()
        if (focusable.length === 0) return
        const first = focusable[0]
        const last = focusable[focusable.length - 1]

        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault()
            last.focus()
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault()
            first.focus()
          }
        }
      }
    }

    mobileMenuOpen?.addEventListener('click', openMenu)
    mobileMenuClose?.addEventListener('click', closeMenu)
    mobileMenuOverlay?.addEventListener('click', closeMenu)
    document.addEventListener('keydown', handleKeydown)
  })
</script>
