---
import { getLangFromUrl, getLangUrl } from "@/i18n/utils";
import { languages as languageMap } from "@/i18n/ui";

const flags: Record<string, string> = {
  en: "🇬🇧", ms: "🇲🇾", zh: "🇨🇳", de: "🇩🇪", es: "🇪🇸",
  fr: "🇫🇷", nl: "🇳🇱", ru: "🇷🇺", ja: "🇯🇵", pt: "🇵🇹",
};

const languages = Object.entries(languageMap).map(([code, label]) => ({
  code, label, flag: flags[code] || "🌐",
}));

const currentLang = getLangFromUrl(Astro.url);
const selectedLanguage = languages.find((l) => l.code === currentLang) || languages[0];

const currentPath = Astro.url.pathname;

const { variant = "light" } = Astro.props;
const isDark = variant === "dark";
---

<div class="relative" data-lang-selector>
  <button
    type="button"
    class:list={[
      "flex items-center gap-2 transition-colors py-2 font-medium text-sm",
      isDark ? "text-white hover:text-orange" : "text-gray-700 hover:text-orange",
    ]}
    aria-label={`Language: ${selectedLanguage.label}. Change language`}
    aria-haspopup="listbox"
    aria-expanded="false"
    data-lang-toggle
  >
    <span class="text-base" aria-hidden="true">{selectedLanguage.flag}</span>
    <span class="uppercase">{selectedLanguage.code}</span>
    <svg
      class="w-3 h-3 transition-transform duration-200"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      data-lang-chevron
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown listbox -->
  <ul
    role="listbox"
    aria-label="Select language"
    class="absolute right-0 top-full mt-1 w-40 bg-white rounded-lg shadow-xl border border-gray-100 z-50 hidden"
    data-lang-dropdown
    tabindex="-1"
  >
    {
      languages.map((lang) => (
        <li role="option" aria-selected={lang.code === currentLang}>
          <a
            href={getLangUrl(lang.code, currentPath)}
            hreflang={lang.code}
            class:list={[
              "flex items-center gap-3 px-4 py-2.5 text-sm transition-colors",
              lang.code === currentLang
                ? "text-primary font-semibold bg-orange-50"
                : "text-gray-700 hover:bg-orange-50 hover:text-orange",
            ]}
            data-lang-option
          >
            <span class="text-lg" aria-hidden="true">{lang.flag}</span>
            <span>{lang.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll("[data-lang-selector]").forEach((selector) => {
    const toggle = selector.querySelector<HTMLButtonElement>("[data-lang-toggle]");
    const dropdown = selector.querySelector<HTMLElement>("[data-lang-dropdown]");
    const chevron = selector.querySelector<SVGElement>("[data-lang-chevron]");
    const options = Array.from(selector.querySelectorAll<HTMLElement>("[data-lang-option]"));

    if (!toggle || !dropdown) return;

    function openDropdown() {
      dropdown!.classList.remove("hidden");
      toggle!.setAttribute("aria-expanded", "true");
      chevron?.classList.add("rotate-180");
      // Focus the first/current option
      const selected = options.find(
        (o) => o.closest("[role='option']")?.getAttribute("aria-selected") === "true"
      ) || options[0];
      selected?.focus();
    }

    function closeDropdown() {
      dropdown!.classList.add("hidden");
      toggle!.setAttribute("aria-expanded", "false");
      chevron?.classList.remove("rotate-180");
    }

    toggle.addEventListener("click", () => {
      const isOpen = !dropdown.classList.contains("hidden");
      isOpen ? closeDropdown() : openDropdown();
    });

    // Keyboard navigation within dropdown
    dropdown.addEventListener("keydown", (e: KeyboardEvent) => {
      const currentIndex = options.indexOf(document.activeElement as HTMLElement);

      if (e.key === "ArrowDown") {
        e.preventDefault();
        const next = options[(currentIndex + 1) % options.length];
        next?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        const prev = options[(currentIndex - 1 + options.length) % options.length];
        prev?.focus();
      } else if (e.key === "Escape" || e.key === "Tab") {
        closeDropdown();
        toggle.focus();
      } else if (e.key === "Enter" || e.key === " ") {
        (document.activeElement as HTMLElement)?.click();
      }
    });

    // Close when focus leaves the selector entirely
    selector.addEventListener("focusout", (e: FocusEvent) => {
      if (!selector.contains(e.relatedTarget as Node)) {
        closeDropdown();
      }
    });

    // Close on outside click
    document.addEventListener("click", (e: MouseEvent) => {
      if (!selector.contains(e.target as Node)) {
        closeDropdown();
      }
    });
  });
</script>
