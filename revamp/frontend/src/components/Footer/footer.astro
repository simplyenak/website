---
import { Image } from "astro:assets";
import { getSiteSettings, getFooterLinks } from "@/lib/content";
import { siteConfig } from "@/lib/site-config";
import simplyEnakLogo from "@/assets/images/simply_enak_logo.webp";
import tripadvisorLogo from "@/assets/images/tripadvisor-logo.png";
import { getLangFromUrl, localizePath } from "@/i18n/utils";
import { useTranslations } from "@/i18n/utils";

const settings = await getSiteSettings();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

// Fetch footer links from Payload and localize them
const rawFooterLinks = await getFooterLinks();

// Map Payload link names to t() keys for non-English pages
function translateFooterName(link: { name: string; href: string }): string {
  if (lang === 'en') return link.name || '';
  const href = (link.href || '').toLowerCase();
  const name = (link.name || '').toLowerCase();
  if (name.includes('private') || href.includes('/private-tours')) return t('footer.privateTours') || link.name;
  if (name.includes('all food') || (href.includes('/tours') && !href.includes('/private'))) return t('footer.allFoodExperiences') || link.name;
  if (name.includes('media')) return t('footer.mediaEnquiries') || link.name;
  if (name.includes('privacy')) return t('footer.privacyPolicy') || link.name;
  if (name.includes('terms') || name.includes('condition')) return t('footer.termsConditions') || link.name;
  if (name.includes('contact')) return t('footer.contactUs') || link.name;
  return link.name || '';
}

const footerLinks = rawFooterLinks.map(link => ({
  ...link,
  name: translateFooterName(link),
  href: localizePath(link.href, lang)
}));

const site = {
  tagline: settings?.tagline ?? "Simply Enak has been sharing Malaysia's food heritage since 2011. Walk with locals, taste real stories.",
  contact: {
    phone: settings?.contact_phone ?? siteConfig.phone,
    email: settings?.contact_email ?? siteConfig.email,
    hours: settings?.contact_hours ?? siteConfig.businessHours,
  },
  social: {
    instagram: settings?.social_instagram ?? siteConfig.social.instagram,
    facebook: settings?.social_facebook ?? siteConfig.social.facebook,
    youtube: settings?.social_youtube ?? siteConfig.social.youtube,
  },
  copyright: settings?.footer_copyright_text ?? "Simply Enak. All rights reserved.",
  registration: settings?.registration_no ?? null,
  tripadvisor: (settings as any)?.tripadvisor_url ?? siteConfig.social.tripadvisor,
};

const socialLinks = [
  { name: "Instagram", url: site.social.instagram, icon: "instagram" },
  { name: "Facebook", url: site.social.facebook, icon: "facebook" },
  { name: "YouTube", url: site.social.youtube, icon: "youtube" },
];
---

<footer class="pt-20 pb-8 bg-primary text-white">
  <div class="main-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12">

    <!-- Company Info Column -->
    <div class="space-y-5 lg:col-span-1">
      <a href="/" aria-label="Simply Enak – home page" class="px-4 py-2 bg-white block max-w-[200px] rounded-lg">
        <Image
          src={simplyEnakLogo}
          alt="Simply Enak Logo"
          width={250}
          height={150}
          class="w-full object-contain"
          loading="lazy"
        />
      </a>
      <p class="text-sm leading-relaxed">{site.tagline}</p>

      <!-- Social Media Links -->
      <nav aria-label="Social media links">
        <ul class="flex items-center gap-3 pt-2">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 rounded-full bg-white/10 hover:bg-[var(--color-orange)] flex items-center justify-center transition-all duration-300 hover:scale-110"
                  aria-label={`Follow Simply Enak on ${social.name}`}
                >
                  {social.icon === "instagram" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 2.163c3.204 0 3.584.012 4.84.97 3.252.148 4.771 1.691 4.919 4.919.058 1.264.969 1.644.969 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.84.97-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                  )}
                  {social.icon === "facebook" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                  )}
                  {social.icon === "youtube" && (
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Contact Info Column -->
    <div class="space-y-5">
      <h3 class="text-lg uppercase font-bold font-merriweather">{t('footer.contactUs')}</h3>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-2">
          <svg class="w-5 h-5 text-[var(--color-orange)] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <a href={`tel:${site.contact.phone.replace(/[\s-]/g, "")}`} class="hover:text-[var(--color-orange)] transition-colors" aria-label={`Call us at ${site.contact.phone}`}>
            {site.contact.phone}
          </a>
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-5 h-5 text-[var(--color-orange)] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <a href={`mailto:${site.contact.email}`} class="hover:text-[var(--color-orange)] transition-colors" aria-label={`Email us at ${site.contact.email}`}>
            {site.contact.email}
          </a>
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-5 h-5 text-[var(--color-orange)] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>{site.contact.hours}</span>
        </li>
      </ul>
    </div>

    <!-- Quick Links Column -->
    <div class="space-y-5">
      <h3 class="text-lg uppercase font-bold font-merriweather">{t('footer.quickLinks')}</h3>
      <nav aria-label="Footer quick links">
        <ul class="space-y-2 text-sm">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[var(--color-orange)] duration-300">{link.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Partners & Payment Column -->
    <div class="space-y-6">
      <div class="space-y-4">
        <h3 class="text-lg uppercase font-bold font-merriweather">{t('footer.partners')}</h3>
        <div class="flex items-center gap-5 flex-wrap">
          <a href={site.tripadvisor} target="_blank" rel="noopener noreferrer" aria-label="Simply Enak on TripAdvisor">
            <Image
              src={tripadvisorLogo}
              alt="TripAdvisor"
              class="h-10 w-auto object-contain brightness-0 invert opacity-80 hover:opacity-100 transition-opacity"
              height={60}
              width={100}
              loading="lazy"
            />
          </a>
          <a
            href="https://www.tourismmalaysia.gov.my/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Tourism Malaysia"
            class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity"
          >
            <span class="inline-block w-8 h-8 rounded-full bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
            </span>
            <span class="text-white/80 font-bold text-xs tracking-[0.15em] uppercase">Tourism Malaysia</span>
          </a>
        </div>
      </div>
      <div class="space-y-4">
        <h3 class="text-lg uppercase font-bold font-merriweather">{t('footer.weAccept')}</h3>
        <div class="flex items-center justify-center gap-3 flex-wrap">
          <!-- Visa -->
          <div class="p-2 rounded-sm bg-white grid place-items-center w-14 h-10">
            <svg viewBox="0 0 48 16" xmlns="http://www.w3.org/2000/svg" aria-label="Visa" role="img" class="w-full h-full">
              <text x="0" y="13" font-family="Arial, sans-serif" font-size="14" font-weight="900" fill="#1A1F71" letter-spacing="1">VISA</text>
            </svg>
          </div>
          <!-- Mastercard -->
          <div class="p-2 rounded-sm bg-white grid place-items-center w-14 h-10">
            <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" aria-label="Mastercard" role="img" class="w-full h-full">
              <circle cx="14" cy="12" r="10" fill="#EB001B"/>
              <circle cx="24" cy="12" r="10" fill="#F79E1B"/>
              <path d="M19 5.3a10 10 0 0 1 0 13.4A10 10 0 0 1 19 5.3z" fill="#FF5F00"/>
            </svg>
          </div>
          <!-- PayPal -->
          <div class="p-2 rounded-sm bg-white grid place-items-center w-14 h-10">
            <svg viewBox="0 0 60 20" xmlns="http://www.w3.org/2000/svg" aria-label="PayPal" role="img" class="w-full h-full">
              <text x="30" y="14" font-family="Arial, sans-serif" font-size="11" font-weight="700" fill="#003087" text-anchor="middle">Pay</text>
              <text x="30" y="14" font-family="Arial, sans-serif" font-size="11" font-weight="700" fill="#009CDE" text-anchor="middle" dx="18">Pal</text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="main-container border-t border-white/20 pt-6">
    <p class="text-center text-sm">
      {
        site.copyright.includes('©')
          ? site.copyright
          : `© ${new Date().getFullYear()} ${site.copyright}`
      }
    </p>
    {site.registration && (
      <p class="text-center text-xs text-white/60 mt-1">
        Registration No: {site.registration}
      </p>
    )}
  </div>
</footer>
