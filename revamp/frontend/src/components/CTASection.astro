---
import IconWhatsapp from '@/assets/icons/icon-whatsapp.svg'
import { siteConfig } from "@/lib/site-config";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

interface Props {
  title?: string;
  subtitle?: string;
  whatsappNumber?: string;
  // CTA section translations
  eyebrow?: string;
  freeCancellationText?: string;
  replyTimeText?: string;
  maxPeopleText?: string;
  bookExperienceText?: string;
  chatWhatsAppText?: string;
}

const title = Astro.props.title ?? (lang !== 'en' ? t('cta.title') : "Your Table Is Waiting");
const subtitle = Astro.props.subtitle ?? (lang !== 'en' ? t('cta.subtitle') : "Small groups, real neighbourhoods, stories worth telling. Pick a date that works for you.");
const whatsapp = (Astro.props.whatsappNumber ?? siteConfig.whatsappNumber).replace(/\D/g, '');
const eyebrow = Astro.props.eyebrow ?? (lang !== 'en' ? t('cta.title') : "Ready when you are");
const freeCancellationText = Astro.props.freeCancellationText ?? (lang !== 'en' ? t('cta.freeCancellation') : "Free cancellation up to 24 hours");
const replyTimeText = Astro.props.replyTimeText ?? (lang !== 'en' ? t('cta.responseTime') : "We reply within 3 hours");
const maxPeopleText = Astro.props.maxPeopleText ?? (lang !== 'en' ? t('cta.maxPeople') : `Max ${siteConfig.maxPeoplePerTour} people per tour`);
const bookExperienceText = Astro.props.bookExperienceText || (lang !== 'en' ? t('cta.bookExperience') : "Find Your Tour");
const chatWhatsAppText = Astro.props.chatWhatsAppText || (lang !== 'en' ? t('cta.chatKenny') : "Chat on WhatsApp");
---

<style>
  /* Geometric diamond pattern — nods to Malaysian batik motifs */
  .cta-pattern::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        45deg,
        rgba(255, 163, 51, 0.04) 0px,
        rgba(255, 163, 51, 0.04) 1px,
        transparent 1px,
        transparent 32px
      ),
      repeating-linear-gradient(
        -45deg,
        rgba(255, 163, 51, 0.04) 0px,
        rgba(255, 163, 51, 0.04) 1px,
        transparent 1px,
        transparent 32px
      );
    pointer-events: none;
    z-index: 0;
  }

  /* Radial glow from center */
  .cta-pattern::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(181, 45, 56, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
</style>

<section class="cta-pattern relative bg-dark py-24 lg:py-36 overflow-hidden">
  <div class="main-container relative z-10 text-center">

    <!-- Eyebrow -->
    <p class="text-eyebrow text-orange mb-5">
      {eyebrow}
    </p>

    <h2 class="text-h2 text-white mb-5">
      {title}
    </h2>

    <p class="text-lg text-gray-400 mb-10 max-w-xl mx-auto leading-relaxed">
      {subtitle}
    </p>

    <!-- Booking guarantees -->
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 mb-10 text-sm text-gray-500">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        {freeCancellationText}
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        {replyTimeText}
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a4.902 4.902 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        {maxPeopleText}
      </span>
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href={localizePath('/tours/', lang)}
        class="cta-primary"
      >
        {bookExperienceText}
      </a>
      <a
        href={`https://wa.me/${whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-whatsapp"
      >
        <IconWhatsapp class="w-5 h-5 mr-2" aria-hidden="true" />
        {chatWhatsAppText}
      </a>
    </div>

  </div>
</section>
