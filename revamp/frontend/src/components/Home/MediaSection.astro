---
import trackRecord from '@/data/content/track-record-page.json';

let { eyebrow, title, videoEmbedUrl } = Astro.props
---

<section class="py-20 md:py-24 bg-dark">
  <div class="main-container">
    <div class="text-center mb-12">
      {eyebrow && <span class="text-eyebrow text-orange block mb-3">{eyebrow}</span>}
      <h2 class="text-h2 text-white mb-4">
        {title}
      </h2>
    </div>

    <!-- Press quotes from track-record-page.json — always shown -->
    {trackRecord.press && trackRecord.press.length > 0 && (
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        {trackRecord.press.map((item: any) => (
          <blockquote class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-orange/30 transition-colors">
            <p class="text-sm text-gray-300 italic mb-4 leading-relaxed">"{item.description}"</p>
            <footer class="flex items-center justify-between">
              <cite class="text-orange font-bold text-sm not-italic">{item.outlet}</cite>
              <span class="text-gray-500 text-xs">{item.year}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    )}

    <!-- Video embed — shown only if a real URL is set -->
    {videoEmbedUrl && (
      <div class="aspect-video w-full rounded-xl overflow-hidden shadow-2xl border border-white/10">
        <iframe
          src={videoEmbedUrl}
          title={title ? `Video: ${title}` : "Simply Enak food tour experience video"}
          class="size-full object-cover"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        >
        </iframe>
      </div>
    )}
  </div>
</section>
