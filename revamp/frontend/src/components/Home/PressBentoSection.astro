---
// PressBentoSection.astro
// Bento-grid press mosaic: "As Featured In" with publication cards.
// Data sourced from home-page.json → press_features array.

interface PressFeature {
  publication: string;
  category: string;
  year: string;
  excerpt: string;
  accent: string;
  size: 'large' | 'medium' | 'small';
  logo_url?: string;
  photo_url?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  features?: PressFeature[];
}

const { eyebrow, heading, intro, features = [] } = Astro.props;

if (!features.length) return;

const large  = features.filter(f => f.size === 'large');
const medium = features.filter(f => f.size === 'medium');
const small  = features.filter(f => f.size === 'small');
---

<style>
  .press-card {
    position: relative;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    overflow: hidden;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .press-card:hover {
    background: rgba(255,255,255,0.055);
    border-color: rgba(255,255,255,0.13);
  }
  .press-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent, rgba(255,163,51,0.6));
    opacity: 0.7;
  }
  .press-card-large::after {
    content: '"';
    position: absolute;
    bottom: -0.15em;
    right: 0.15em;
    font-size: 9rem;
    line-height: 1;
    font-family: Georgia, serif;
    color: rgba(255,255,255,0.04);
    pointer-events: none;
  }

  /* Dot-grid texture */
  .press-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 0;
  }
</style>

<section class="press-section relative bg-dark py-16 md:py-20 overflow-hidden">
  <div class="relative z-10 main-container">

    <!-- Header -->
    <div class="mb-10 md:mb-14 text-center">
      {eyebrow && (
        <p class="text-eyebrow text-orange/70 mb-3">{eyebrow}</p>
      )}
      {heading && (
        <h2 class="font-merriweather font-bold text-white text-2xl md:text-3xl mb-3">{heading}</h2>
      )}
      {intro && (
        <p class="text-white/50 text-sm max-w-xl mx-auto leading-relaxed">{intro}</p>
      )}
    </div>

    <!-- Bento grid -->
    <div class="grid gap-3 grid-cols-1 md:grid-cols-4">

      <!-- Large card (2×2) — first large feature -->
      {large.map((f) => (
        <div
          class="press-card press-card-large md:col-span-2 md:row-span-2 p-6 md:p-8 flex flex-col justify-between min-h-[200px] md:min-h-[280px]"
          style={`--accent: ${f.accent};`}
        >
          {f.photo_url && (
            <div class="absolute inset-0 z-0 rounded-xl overflow-hidden">
              <img src={f.photo_url} alt="" class="w-full h-full object-cover" loading="lazy" aria-hidden="true" />
              <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(26,26,26,0.88) 0%, rgba(26,26,26,0.72) 100%);"></div>
            </div>
          )}
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-5">
              <span
                class="inline-block w-2.5 h-2.5 rounded-full flex-shrink-0"
                style={`background: ${f.accent};`}
                aria-hidden="true"
              ></span>
              <span class="text-[10px] text-white/40 uppercase tracking-[0.15em] font-bold">
                {f.category} · {f.year}
              </span>
            </div>
            <p class="font-merriweather italic text-white/70 text-base md:text-lg leading-relaxed mb-6">
              "{f.excerpt}"
            </p>
          </div>
          {f.logo_url ? (
            <img
              src={f.logo_url}
              alt={f.publication}
              class="relative z-10 max-h-10 max-w-[180px] object-contain object-left"
              loading="lazy"
            />
          ) : (
            <p
              class="relative z-10 font-merriweather font-bold text-2xl md:text-3xl"
              style={`color: ${f.accent}; opacity: 0.9;`}
            >
              {f.publication}
            </p>
          )}
        </div>
      ))}

      <!-- Medium cards (1×1 each, but taller) -->
      {medium.map((f) => (
        <div
          class="press-card p-5 md:p-6 flex flex-col justify-between min-h-[150px] md:min-h-[130px]"
          style={`--accent: ${f.accent};`}
        >
          {f.photo_url && (
            <div class="absolute inset-0 z-0 rounded-xl overflow-hidden">
              <img src={f.photo_url} alt="" class="w-full h-full object-cover" loading="lazy" aria-hidden="true" />
              <div class="absolute inset-0" style="background: rgba(26,26,26,0.80);"></div>
            </div>
          )}
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-3">
              <span
                class="inline-block w-2 h-2 rounded-full flex-shrink-0"
                style={`background: ${f.accent};`}
                aria-hidden="true"
              ></span>
              <span class="text-[9px] text-white/35 uppercase tracking-[0.15em] font-bold">
                {f.category} · {f.year}
              </span>
            </div>
            <p class="text-white/55 text-xs leading-relaxed mb-3">{f.excerpt}</p>
          </div>
          {f.logo_url ? (
            <img
              src={f.logo_url}
              alt={f.publication}
              class="relative z-10 max-h-8 max-w-[140px] object-contain object-left"
              loading="lazy"
            />
          ) : (
            <p
              class="relative z-10 font-merriweather font-bold text-lg"
              style={`color: ${f.accent}; opacity: 0.85;`}
            >
              {f.publication}
            </p>
          )}
        </div>
      ))}

      <!-- Small cards (1×1, compact) -->
      {small.map((f) => (
        <div
          class="press-card p-4 md:p-5 flex flex-col justify-between min-h-[110px]"
          style={`--accent: ${f.accent};`}
        >
          {f.photo_url && (
            <div class="absolute inset-0 z-0 rounded-xl overflow-hidden">
              <img src={f.photo_url} alt="" class="w-full h-full object-cover" loading="lazy" aria-hidden="true" />
              <div class="absolute inset-0" style="background: rgba(26,26,26,0.82);"></div>
            </div>
          )}
          <p class="relative z-10 text-white/45 text-xs leading-relaxed mb-3 line-clamp-3">{f.excerpt}</p>
          <div class="relative z-10 flex items-center justify-between gap-2">
            {f.logo_url ? (
              <img
                src={f.logo_url}
                alt={f.publication}
                class="max-h-6 max-w-[110px] object-contain object-left"
                loading="lazy"
              />
            ) : (
              <p
                class="font-merriweather font-bold text-sm"
                style={`color: ${f.accent}; opacity: 0.85;`}
              >
                {f.publication}
              </p>
            )}
            <span class="text-[9px] text-white/25 uppercase tracking-wide flex-shrink-0">{f.year}</span>
          </div>
        </div>
      ))}

    </div>

    <!-- Footer link -->
    <div class="mt-8 text-center">
      <a
        href="/media/"
        class="text-white/40 text-xs uppercase tracking-[0.15em] hover:text-orange/70 transition-colors duration-200"
      >
        Full press kit & media enquiries →
      </a>
    </div>

  </div>
</section>
