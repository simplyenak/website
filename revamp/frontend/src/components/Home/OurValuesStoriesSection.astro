---
import ScrollAnimate from "@/components/ScrollAnimate.astro";

interface Belief {
  number?: string;
  title?: string;
  excerpt?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  beliefs?: Belief[];
}

const { eyebrow, title, subtitle, beliefs } = Astro.props;
const validBeliefs = (beliefs || []).filter((b) => b.title);
---

{validBeliefs.length > 0 && (
  <section class="bg-dark py-20 md:py-28">
    <div class="main-container">

      <ScrollAnimate direction="up">
        <div class="mb-16">
          {eyebrow && <p class="text-eyebrow text-orange mb-4">{eyebrow}</p>}
          {title && (
            <h2 class="font-merriweather font-bold text-white leading-tight mb-4"
                style="font-size: clamp(1.75rem, 4vw, 3rem);">
              {title}
            </h2>
          )}
          {subtitle && (
            <p class="text-white/45 leading-relaxed max-w-lg" style="font-size: 0.9375rem;">
              {subtitle}
            </p>
          )}
        </div>
      </ScrollAnimate>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/[0.06]">
        {validBeliefs.map((belief, index) => (
          <ScrollAnimate direction="up" delay={index * 60}>
            <div class:list={[
              "bg-dark p-8 md:p-10 relative overflow-hidden",
              index === 4 ? "md:col-span-2" : ""
            ]}>
              <span
                class="absolute right-6 bottom-4 font-merriweather font-bold text-white/[0.04] select-none leading-none pointer-events-none"
                style="font-size: 7rem;"
                aria-hidden="true"
              >{belief.number}</span>

              <p class="text-orange/60 font-bold text-xs tracking-[0.2em] uppercase mb-4">{belief.number}</p>
              <h3 class="font-merriweather font-bold text-white mb-4 leading-snug"
                  style="font-size: clamp(1.1rem, 1.8vw, 1.4rem);">
                {belief.title}
              </h3>
              <p class="text-white/50 leading-relaxed text-sm max-w-sm">
                {belief.excerpt}
              </p>
            </div>
          </ScrollAnimate>
        ))}
      </div>

    </div>
  </section>
)}
