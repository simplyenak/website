---
import { getLangFromUrl, localizePath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);

interface Props {
  headline?: string;
  eyebrow?: string;
  tagline?: string;
  body?: string;
  attributionName?: string;
  attributionRole?: string;
  portraitSrc?: string;
  portraitAlt?: string;
  ctaText?: string;
  pillarPeopleLabel?: string;
  pillarPeopleBody?: string;
  pillarFoodLabel?: string;
  pillarFoodBody?: string;
  pillarPlaceLabel?: string;
  pillarPlaceBody?: string;
}

const {
  headline,
  eyebrow,
  tagline,
  body,
  attributionName,
  attributionRole,
  portraitSrc,
  portraitAlt,
  ctaText,
  pillarPeopleLabel = "THE PEOPLE",
  pillarPeopleBody = "Vendors who have fed their neighbourhood for generations. We introduce you by name.",
  pillarFoodLabel = "THE FOOD",
  pillarFoodBody = "Chinese, Malay, Indian, Peranakan — cooking side by side for 200 years. Every dish has a history.",
  pillarPlaceLabel = "THE PLACE",
  pillarPlaceBody = "The back lanes, the shophouses, the stalls that refuse to be replaced. Coming here is how they survive.",
} = Astro.props;

// Only show portrait when a real image is available — not a placeholder
const showPortrait = portraitSrc && !portraitSrc.includes('placehold.co');
---

<section class="relative overflow-hidden bg-dark text-white">

  <!-- Top accent rule -->
  <div class="absolute top-0 inset-x-0 h-px pointer-events-none" style="background: linear-gradient(90deg, transparent 0%, rgba(255,163,51,0.28) 50%, transparent 100%);" aria-hidden="true"></div>

  <!-- Dot-grid texture, masked to text side -->
  <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(rgba(255,255,255,0.032) 1px, transparent 1px); background-size: 28px 28px; -webkit-mask-image: linear-gradient(to right, black 45%, transparent 75%); mask-image: linear-gradient(to right, black 45%, transparent 75%);" aria-hidden="true"></div>

  <!-- Ghost quote mark -->
  <div class="absolute pointer-events-none select-none font-merriweather font-bold text-white" style="font-size: clamp(16rem, 35vw, 28rem); opacity: 0.022; top: -10%; left: -1%; line-height: 0.75;" aria-hidden="true">"</div>

  <!-- Full-width flex: text left, image right (bleeds to viewport edge) -->
  <div class="relative z-10 flex" style="min-height: clamp(420px, 65vw, 680px);">

    <!-- Text column: left padding tracks main-container alignment -->
    <div class:list={["flex flex-col justify-center manifesto-reveal manifesto-text", showPortrait ? "flex-1" : "flex-1 max-w-3xl"]} style="padding-top: clamp(3rem, 7vw, 6rem); padding-bottom: clamp(3rem, 7vw, 6rem); padding-right: clamp(1.5rem, 4vw, 3.5rem);">

      <span class="text-orange text-eyebrow mb-4 block">{eyebrow}</span>

      <h2 class="font-merriweather font-bold text-white leading-[1.05] mb-5 text-h2">
        {headline}
      </h2>

      <div class="flex items-center gap-3 mb-5" aria-hidden="true">
        <div class="h-px bg-white/10 w-12"></div>
      </div>

      <p class="font-merriweather italic text-white/65 leading-snug mb-7" style="font-size: clamp(0.9rem, 2vw, 1.3rem);">
        {tagline}
      </p>

      <p class="text-white/70 leading-relaxed border-l border-orange/25 pl-4 mb-8" style="font-size: clamp(0.82rem, 1.3vw, 0.95rem); line-height: 1.85; max-width: 42ch;">
        {body}
      </p>

      <div class="flex items-center gap-3">
        <div class="w-4 h-px bg-orange/40"></div>
        <div>
          <p class="text-[12px] font-bold text-white tracking-wide">{attributionName}</p>
          <p class="text-[10px] text-white/50 tracking-[0.15em] uppercase mt-0.5">{attributionRole}</p>
        </div>
      </div>

      {ctaText && (
        <div class="mt-10">
          <a href={localizePath('/tours/', lang)} class="cta-secondary inline-flex" style="border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.75);">
            {ctaText}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      )}

    </div>

    <!-- Image column: only rendered when a real portrait is available -->
    {showPortrait && (
      <div class="w-[43%] sm:w-[41%] lg:w-[40%] flex-shrink-0 relative manifesto-reveal manifesto-portrait">
        <div class="absolute inset-0 overflow-hidden">
          <img
            src={portraitSrc}
            alt={portraitAlt || "Pauline — co-founder of Simply Enak"}
            class="w-full h-full object-cover object-top"
            width="520"
            height="720"
            loading="lazy"
          />
          <!-- Left-edge fade -->
          <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to right, rgba(15,14,14,0.96) 0%, rgba(15,14,14,0.5) 22%, rgba(15,14,14,0.1) 50%, transparent 75%);"></div>
          <!-- Bottom vignette -->
          <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(15,14,14,0.65) 0%, transparent 45%);"></div>
        </div>
        <!-- Corner accent -->
        <div class="absolute top-5 right-5 w-10 h-10 border-t border-r border-orange/30 pointer-events-none z-10"></div>
      </div>
    )}

  </div>

  <!-- Compact three pillars — replaces separate ThreePillarsSection -->
  <div class="relative z-10 border-t border-white/[0.06]">
    <div class="main-container">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/[0.07] py-10">
        <div class="py-6 md:py-0 md:px-8 first:md:pl-0">
          <span class="text-orange text-[10px] font-bold tracking-[0.25em] uppercase block mb-2">{pillarPeopleLabel}</span>
          <p class="text-white/55 text-sm leading-relaxed">{pillarPeopleBody}</p>
        </div>
        <div class="py-6 md:py-0 md:px-8">
          <span class="text-orange text-[10px] font-bold tracking-[0.25em] uppercase block mb-2">{pillarFoodLabel}</span>
          <p class="text-white/55 text-sm leading-relaxed">{pillarFoodBody}</p>
        </div>
        <div class="py-6 md:py-0 md:px-8 last:md:pr-0">
          <span class="text-orange text-[10px] font-bold tracking-[0.25em] uppercase block mb-2">{pillarPlaceLabel}</span>
          <p class="text-white/55 text-sm leading-relaxed">{pillarPlaceBody}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom rule -->
  <div class="absolute bottom-0 inset-x-0 h-px bg-white/[0.05]" aria-hidden="true"></div>

</section>

<style>
  @keyframes manifestoFadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes manifestoFadeLeft {
    from { opacity: 0; transform: translateX(24px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .manifesto-text {
    padding-left: max(0.75rem, calc((100vw - 80rem) / 2 + 0.75rem));
  }
  @media (min-width: 768px) {
    .manifesto-text {
      padding-left: max(1.25rem, calc((100vw - 80rem) / 2 + 1.25rem));
    }
  }
  @media (min-width: 1280px) {
    .manifesto-text {
      padding-left: max(7.5rem, calc((100vw - 80rem) / 2 + 7.5rem));
    }
  }
  .manifesto-reveal { opacity: 0; }
  .manifesto-reveal.is-visible { animation: manifestoFadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .manifesto-portrait.is-visible { animation: manifestoFadeLeft 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both; }
  @media (prefers-reduced-motion: reduce) {
    .manifesto-reveal, .manifesto-portrait { opacity: 1; animation: none; }
  }
</style>

<script>
  const revealEls = document.querySelectorAll('.manifesto-reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.12 });
    revealEls.forEach(el => obs.observe(el));
  } else {
    revealEls.forEach(el => el.classList.add('is-visible'));
  }
</script>
