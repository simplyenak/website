---
import chipsData from "@/data/content/segment-chips.json";
import { getLangFromUrl, localizePath } from "@/i18n/utils";

interface Chip {
  label: string;
  href: string;
  size: "large" | "medium" | "small";
  rotate: string;
  accent?: "orange";
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  viewAllText?: string;
}

const { eyebrow, heading, subheading, viewAllText } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const chips: Chip[] = chipsData as Chip[];

function chipClass(chip: Chip) {
  const base = "inline-block rounded-full font-bold transition-all duration-200";
  const hover = chip.accent === "orange"
    ? "border-orange/50 text-orange hover:bg-orange hover:text-white hover:border-orange hover:shadow-[0_4px_14px_rgba(234,124,33,0.30)]"
    : "border-primary/40 text-primary hover:bg-primary hover:text-white hover:border-primary hover:shadow-[0_4px_18px_rgba(181,45,56,0.28)]";

  if (chip.size === "large") return `${base} px-6 py-2.5 border-2 text-base ${hover} hover:-translate-y-1 hover:scale-[1.04]`;
  if (chip.size === "medium") {
    const medHover = chip.accent === "orange"
      ? "border-orange/50 text-orange hover:bg-orange hover:text-white hover:border-orange hover:shadow-[0_4px_14px_rgba(234,124,33,0.30)]"
      : "border-primary/30 text-primary hover:bg-primary hover:text-white hover:border-primary hover:shadow-[0_4px_14px_rgba(181,45,56,0.22)]";
    return `${base} px-4 py-2 border text-sm font-semibold ${medHover} hover:-translate-y-0.5 hover:scale-[1.04]`;
  }
  // small
  const smHover = chip.accent === "orange"
    ? "border-orange/40 text-orange hover:bg-orange hover:text-white hover:border-orange hover:shadow"
    : "border-primary/25 text-primary hover:bg-primary hover:text-white hover:border-primary hover:shadow";
  return `${base} px-3 py-1.5 border text-xs font-medium ${smHover}`;
}
---

<section class="bg-cream py-16 md:py-24 border-b border-gray-100 relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: radial-gradient(rgba(181,45,56,0.04) 1px, transparent 1px); background-size: 22px 22px;"
    aria-hidden="true"
  ></div>
  <div class="main-container relative z-10">
    <div class="text-center mb-14">
      {eyebrow && <p class="text-eyebrow text-orange mb-3">{eyebrow}</p>}
      {heading && (
        <h2 class="font-merriweather text-3xl md:text-4xl font-bold text-primary leading-tight">
          {heading}
        </h2>
      )}
      {subheading && (
        <p class="text-gray-500 mt-4 text-sm max-w-xs mx-auto leading-relaxed">
          {subheading}
        </p>
      )}
    </div>

    <div class="segment-chips flex flex-wrap justify-center items-center gap-3 md:gap-4 px-4 sm:px-6">
      {chips.map((chip, i) => (
        <a
          href={chip.href}
          style={`rotate: ${chip.rotate}; animation: chipIn 0.5s ease-out ${(i * 0.05).toFixed(2)}s both;`}
          class={chipClass(chip)}
        >
          {chip.label}
        </a>
      ))}
    </div>

    {viewAllText && (
      <div class="text-center mt-12">
        <a href={localizePath('/tours/', lang)} class="inline-flex items-center gap-2 text-sm text-primary font-semibold hover:underline underline-offset-4">
          {viewAllText}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style is:global>
  @keyframes chipIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (max-width: 639px) {
    .segment-chips a {
      rotate: none !important;
    }
  }
</style>
