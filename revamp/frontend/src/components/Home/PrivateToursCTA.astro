---
// PrivateToursCTA.astro
// Full-bleed dark section surfacing private and tailored tours.
// All text comes via props from the content layer / translation overlay.

import { siteConfig } from '@/lib/site-config';

interface Props {
  eyebrow?: string;
  heading?: string;
  ctaText?: string;
  ctaAriaLabel?: string;
  whatsappNumber?: string;
  features?: string[];
  stats?: string[];
}

const {
  eyebrow,
  heading,
  ctaText,
  ctaAriaLabel,
  whatsappNumber,
  features = [],
  stats = [],
} = Astro.props;

const wa = whatsappNumber ?? siteConfig.whatsappNumber;
const waNumber = wa ? wa.replace(/\D/g, '') : '';
const waUrl = waNumber
  ? `https://wa.me/${waNumber}?text=${encodeURIComponent("Hi! I'm interested in a private food tour.")}`
  : '/contact/';
---

<section class="relative bg-dark text-white overflow-hidden py-16 md:py-24">

  <!-- Dot-grid texture -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 28px 28px;"
    aria-hidden="true"
  ></div>

  <!-- Top accent rule -->
  <div
    class="absolute top-0 inset-x-0 h-px pointer-events-none"
    style="background: linear-gradient(90deg, transparent 0%, rgba(255,163,51,0.3) 50%, transparent 100%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 main-container">
    <div class="max-w-3xl">

      <span class="text-eyebrow text-orange block mb-4">{eyebrow}</span>

      <h2
        class="font-merriweather font-bold text-white leading-[1.1] mb-6 text-h2"
      >
        {heading}
      </h2>

      <ul class="space-y-4 mb-10">
        {features.map((f) => (
          <li class="flex items-start gap-3 text-white/70 leading-relaxed">
            <span class="text-orange mt-0.5 flex-shrink-0 font-bold" aria-hidden="true">-&gt;</span>
            {f}
          </li>
        ))}
      </ul>

      <a
        href={waUrl}
        class="cta-primary cta-primary-lg inline-flex group"
        aria-label={ctaAriaLabel}
      >
        {ctaText}
        <svg
          class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </a>

      <!-- Stats row -->
      {stats.length > 0 && (
        <div class="flex flex-wrap gap-x-6 gap-y-2 mt-8">
          {stats.map((s, i) => (
            <span class="text-white/40 text-xs">{s}{i < stats.length - 1 ? ' ·' : ''}</span>
          ))}
        </div>
      )}

    </div>
  </div>

  <!-- Bottom rule -->
  <div class="absolute bottom-0 inset-x-0 h-px bg-white/[0.05]" aria-hidden="true"></div>

</section>
