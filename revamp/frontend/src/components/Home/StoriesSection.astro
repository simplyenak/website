---
interface Props {
  eyebrow?: string;
  title?: string;
  stories?: { slug: string; title: string; image?: string; excerpt?: string }[];
}

const { eyebrow, title, stories } = Astro.props;
const resolvedStories = stories && stories.length > 0 ? stories : [];

const isAsymmetric = resolvedStories.length >= 3;
const featuredStory = resolvedStories[0];
const sideStories = resolvedStories.slice(1, 3);
const extraStories = resolvedStories.slice(3);
---

{resolvedStories.length > 0 && (
  <section class="py-20 md:py-24 bg-cream">
    <div class="main-container">
      <div class="text-center mb-12">
        {eyebrow && <p class="text-eyebrow text-orange mb-3">{eyebrow}</p>}
        {title && <h2 class="text-h2 text-primary">{title}</h2>}
      </div>

      {isAsymmetric ? (
        <>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a
              href={`/stories/${featuredStory.slug}`}
              class="group md:col-span-2 bg-white border-t-2 border-orange overflow-hidden block"
            >
              <div class="aspect-video overflow-hidden">
                <img
                  src={featuredStory.image}
                  alt={featuredStory.title}
                  class="size-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-6 md:p-8">
                <h3 class="font-merriweather font-bold text-primary text-2xl mb-3 group-hover:text-orange transition-colors duration-200">
                  {featuredStory.title}
                </h3>
                <p class="text-gray-600 leading-relaxed line-clamp-3">{featuredStory.excerpt}</p>
              </div>
            </a>

            <div class="flex flex-col gap-6">
              {sideStories.map((story) => (
                <a
                  href={`/stories/${story.slug}`}
                  class="group bg-white border-t-2 border-orange overflow-hidden flex-1 block"
                >
                  <div class="overflow-hidden" style="aspect-ratio: 4/3;">
                    <img
                      src={story.image}
                      alt={story.title}
                      class="size-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-4 md:p-5">
                    <h3 class="font-merriweather font-bold text-primary text-lg mb-2 group-hover:text-orange transition-colors duration-200 line-clamp-2">
                      {story.title}
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed line-clamp-2 hidden sm:block">
                      {story.excerpt}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>

          {extraStories.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
              {extraStories.map((story) => (
                <a
                  href={`/stories/${story.slug}`}
                  class="group bg-white border-t-2 border-orange overflow-hidden block"
                >
                  <div class="h-[200px] overflow-hidden">
                    <img
                      src={story.image}
                      alt={story.title}
                      class="size-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-4 md:p-5">
                    <h3 class="font-merriweather font-bold text-primary text-lg mb-2 group-hover:text-orange transition-colors duration-200 line-clamp-2">
                      {story.title}
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed line-clamp-2">{story.excerpt}</p>
                  </div>
                </a>
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {resolvedStories.map((story) => (
            <a
              href={`/stories/${story.slug}`}
              class="group bg-white border-t-2 border-orange overflow-hidden block"
            >
              <div class="h-[240px] overflow-hidden">
                <img
                  src={story.image}
                  alt={story.title}
                  class="size-full object-cover group-hover:scale-105 transition-transform duration-300 ease-in-out"
                  loading="lazy"
                />
              </div>
              <div class="p-4 md:p-5 space-y-3">
                <h3 class="text-subheading hover:text-primary duration-300 line-clamp-2">
                  {story.title}
                </h3>
                <p class="text-body line-clamp-3">{story.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
)}
