---
import { siteConfig } from "@/lib/site-config";
interface Props {
  title?: string;
  highlightedText?: string;
  titleEnd?: string;
  subtitle?: string;
  priceInfo?: string;
  bgImage?: string;
  whatsappNumber?: string;
  ctaPrimaryText?: string;
  ctaPrimaryUrl?: string;
  ctaSecondaryText?: string;
  ctaSecondaryUrl?: string;
}

const heroSection = {
  title: Astro.props.title ?? "Food Tours that Reveal the",
  highlightedText: Astro.props.highlightedText ?? "Hidden Culture and Heritage",
  titleEnd: Astro.props.titleEnd ?? "of Malaysia",
  subtitle: Astro.props.subtitle ?? "Walk with a local. Taste real stories. See the Malaysia most tourists miss.",
  priceInfo: Astro.props.priceInfo ?? `From ${siteConfig.tourPrice.display} · ${siteConfig.tourDuration} · Max ${siteConfig.maxPeoplePerTour} people`,
  bgImage: Astro.props.bgImage ?? "https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg",
  whatsappNumber: Astro.props.whatsappNumber ?? siteConfig.whatsappNumber,
  ctaPrimaryText: Astro.props.ctaPrimaryText ?? "SEE OUR TOURS",
  ctaPrimaryUrl: Astro.props.ctaPrimaryUrl ?? "/tours/",
  ctaSecondaryText: Astro.props.ctaSecondaryText ?? "WHY CHOOSE US",
  ctaSecondaryUrl: Astro.props.ctaSecondaryUrl ?? "#about",
};
---

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .animate-delay-1 {
    animation-delay: 0.2s;
    opacity: 0;
  }

  .animate-delay-2 {
    animation-delay: 0.4s;
    opacity: 0;
  }

  .animate-delay-3 {
    animation-delay: 0.6s;
    opacity: 0;
  }
</style>

<section
  class="bg-dark text-white pt-16 md:pt-20 pb-6 md:pb-8 relative overflow-hidden"
>
  <div class="main-container text-center relative z-20">
    <!-- Headline -->
    <h1
      class="text-3xl md:text-4xl lg:text-5xl font-merriweather mb-3 leading-tight text-white animate-fade-in-up max-w-5xl mx-auto"
    >
      {heroSection.title}<br />
      <span
        class="bg-orange text-black px-3 py-1 inline-block shadow-lg transform -rotate-1 rounded"
      >
        {heroSection.highlightedText}
      </span> {heroSection.titleEnd}
    </h1>

    <!-- Subheadline -->
    <p
      class="text-lg md:text-xl font-merriweather italic mb-2 text-white max-w-4xl mx-auto animate-fade-in-up animate-delay-1"
    >
      {heroSection.subtitle}
    </p>

    <!-- Price Info -->
    <p
      class="text-sm md:text-base text-gray-300 mb-4 max-w-4xl mx-auto animate-fade-in-up animate-delay-1"
    >
      {heroSection.priceInfo}
    </p>

    <!-- Buttons -->
    <div
      class="flex flex-col sm:flex-row justify-center gap-3 mb-6 animate-fade-in-up animate-delay-2"
    >
      <a
        href={heroSection.ctaPrimaryUrl}
        class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-bold text-xs uppercase tracking-wider rounded shadow-lg hover:bg-primary/90 hover:shadow-xl hover:scale-105 transition-all duration-300"
      >
        {heroSection.ctaPrimaryText}
      </a>
      <a
        href={heroSection.ctaSecondaryUrl}
        class="inline-flex items-center justify-center px-6 py-3 bg-transparent text-white font-bold text-xs uppercase tracking-wider rounded border-2 border-white hover:bg-white/10 hover:scale-105 transition-all duration-300"
      >
        {heroSection.ctaSecondaryText}
      </a>
    </div>

    <!-- Social Proof -->
    <div
      class="flex justify-center items-center gap-6 mb-6 animate-fade-in-up animate-delay-3"
    >
      <!-- Google -->
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
        </svg>
        <div class="flex flex-col items-start leading-none">
          <div class="flex text-orange text-xs">★★★★★</div>
          <span class="text-[10px] text-gray-200">4.9 Rating</span>
        </div>
      </div>

      <!-- TripAdvisor -->
      <div class="flex items-center gap-2">
        <svg
          class="w-6 h-6 text-[#00AF87]"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5-8c0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3-3 1.34-3 3zm6 0c0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3-3 1.34-3 3z"
          ></path>
          <circle cx="10" cy="12" r="1.5"></circle>
          <circle cx="17" cy="12" r="1.5"></circle>
        </svg>
        <div class="flex flex-col items-start leading-none">
          <div class="flex text-[#00AF87] text-xs">★★★★★</div>
          <span class="text-[10px] text-gray-200">Travellers' Choice</span>
        </div>
      </div>
    </div>

    <!-- Image Banner -->
    <div
      class="relative w-full max-w-4xl mx-auto animate-fade-in-up animate-delay-3"
    >
      <!-- Badge -->
      <div
        class="absolute -top-8 right-3 md:-top-10 md:right-6 z-30 bg-orange text-black rounded-full w-28 h-28 md:w-36 md:h-36 flex items-center justify-center text-center p-3 shadow-2xl transform rotate-12 border-4 border-white"
      >
        <span class="text-base md:text-lg font-bold leading-tight"
          >Since<br />2011</span
        >
      </div>

      <div class="relative rounded-lg overflow-hidden shadow-2xl">
        <img
          src={heroSection.bgImage}
          alt="Malaysian Food Tour Experience"
          class="w-full h-[240px] md:h-[320px] object-cover"
          width="1200"
          height="320"
          loading="eager"
          fetchpriority="high"
        />

        <!-- Footer Bar Overlay -->
        <div
          class="absolute bottom-0 left-0 right-0 bg-black/80 backdrop-blur-sm py-3 md:py-4"
        >
          <div
            class="flex flex-wrap justify-center gap-4 md:gap-8 text-[10px] md:text-xs uppercase tracking-widest font-semibold text-gray-200"
          >
            <span class="flex items-center gap-1.5">
              <span class="text-orange">✓</span> Heritage Vendors
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-orange">✓</span> Low-Waste Tours
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-orange">✓</span> Slow Travel Values
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
