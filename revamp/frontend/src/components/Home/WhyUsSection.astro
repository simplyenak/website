---
// WhyUsSection.astro
// Six reasons to book with Simply Enak over anyone else.
// All text comes via props from the content layer / translation overlay.

interface Reason {
  icon?: string;
  stat?: string;
  heading?: string;
  body?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  reasons?: Reason[];
}

const {
  eyebrow,
  title,
  subtitle,
  reasons = [],
} = Astro.props;

// Icon map from string name to SVG
const iconMap: Record<string, string> = {
  'map-pin': `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  'users': `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
  'shield-check': `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  'book-open': `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`,
  'chat': `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
  'puzzle': `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>`,
};
---

<section class="bg-white py-16 md:py-24">
  <div class="main-container">

    <div class="text-center mb-14">
      <span class="text-eyebrow text-orange block mb-3">{eyebrow}</span>
      <h2 class="font-merriweather text-3xl md:text-4xl font-bold text-primary leading-tight">
        {title}
      </h2>
      <p class="text-gray-500 text-sm mt-4 max-w-sm mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {reasons.map((reason) => (
        <div class="flex flex-col">
          <!-- Icon + stat -->
          <div class="flex items-center gap-3 mb-4">
            <div class="flex-shrink-0 text-orange" aria-hidden="true" set:html={iconMap[reason.icon || ''] || ''} />
            {reason.stat && (
              <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-orange/70 border border-orange/20 rounded-full px-2.5 py-0.5">
                {reason.stat}
              </span>
            )}
          </div>
          <!-- Heading -->
          <h3 class="font-merriweather font-bold text-primary text-lg leading-snug mb-2">
            {reason.heading}
          </h3>
          <!-- Body -->
          <p class="text-gray-500 text-sm leading-relaxed">
            {reason.body}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
