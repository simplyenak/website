---
interface Props {
  title?: string;
}

const { title } = Astro.props;

import { Image } from "astro:assets";
import gourmetTravellerLogo from "@/assets/images/gourmet-traveller-logo.svg";
import natgeoLogo from "@/assets/images/natgeo-logo.svg";
import discoveryLogo from "@/assets/images/discovery-logo.svg";
import lonelyPlanetLogo from "@/assets/images/lonely-planet-logo.svg";

const pressLogos = [
  { logo: natgeoLogo, name: "National Geographic" },
  { logo: lonelyPlanetLogo, name: "Lonely Planet" },
  { logo: discoveryLogo, name: "Discovery Channel" },
  { logo: gourmetTravellerLogo, name: "Gourmet Traveller" },
];
---

<section class="bg-dark py-10">
  <div class="main-container">
    {title && (
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-orange text-center mb-8">
        {title}
      </p>
    )}
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-14">
      {pressLogos.map((item) => (
        <div class="w-[100px] md:w-[130px] h-[36px] flex items-center justify-center">
          <Image
            src={item.logo}
            alt={item.name}
            class="max-w-full max-h-[28px] w-auto h-auto object-contain"
            style="filter: brightness(0) invert(1); opacity: 0.5;"
            loading="lazy"
          />
        </div>
      ))}
      <!-- BBC Logo -->
      <div class="w-[100px] md:w-[130px] h-[36px] flex items-center justify-center opacity-50">
        <svg viewBox="0 0 96 24" width="90" height="22" xmlns="http://www.w3.org/2000/svg" aria-label="BBC">
          <rect x="0" y="0" width="28" height="24" rx="1.5" fill="white"/>
          <rect x="34" y="0" width="28" height="24" rx="1.5" fill="white"/>
          <rect x="68" y="0" width="28" height="24" rx="1.5" fill="white"/>
          <text x="14" y="17" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="bold" text-anchor="middle" fill="#0f0e0e">B</text>
          <text x="48" y="17" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="bold" text-anchor="middle" fill="#0f0e0e">B</text>
          <text x="82" y="17" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="bold" text-anchor="middle" fill="#0f0e0e">C</text>
        </svg>
      </div>
      <!-- Channel 7 (Seven Network Australia) -->
      <div class="w-[100px] md:w-[130px] h-[36px] flex items-center justify-center opacity-50">
        <svg viewBox="0 0 80 32" width="80" height="28" xmlns="http://www.w3.org/2000/svg" aria-label="Channel 7">
          <path d="M12 4 L30 4 L22 28 L16 28 L22 10 L12 10 Z" fill="none" stroke="white" stroke-width="2.5" stroke-linejoin="round"/>
          <line x1="10" y1="10" x2="32" y2="10" stroke="white" stroke-width="2"/>
          <text x="44" y="22" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="600" fill="white" letter-spacing="1.5">SEVEN</text>
        </svg>
      </div>
    </div>
  </div>
</section>
