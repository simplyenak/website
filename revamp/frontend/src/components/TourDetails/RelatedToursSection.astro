---
import { getAllTours } from "@/lib/content";
import { getImageUrl } from "@/lib/content";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

function localizePath(path: string, currentLang: string): string {
  if (currentLang === 'en') return path;
  return `/${currentLang}${path}`;
}

const tours = await getAllTours();
const otherTours = tours.filter((t) => t.slug !== slug).slice(0, 6);
---

{
  otherTours.length > 0 && (
    <section class="main-container py-20">
      <h2 class="text-h2 text-primary text-center">{t('tours.relatedTours')}</h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {otherTours.map((tour) => (
          <a
            href={localizePath(`/tours/${tour.slug}/`, lang)}
            class="rounded-lg bg-white shadow-md overflow-hidden group"
          >
            <div class="h-32 w-full overflow-hidden">
              <img
                src={getImageUrl(tour.hero_image)}
                alt={tour.name}
                class="size-full object-cover group-hover:scale-105 duration-300"
                height={360}
                width={230}
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="text-sm font-semibold group-hover:text-primary">
                {tour.name}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}
