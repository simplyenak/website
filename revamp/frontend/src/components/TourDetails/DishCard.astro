---
interface Props {
  name: string;
  story?: string;
  image?: string;
  vendor?: string;
}

const { name, story, image, vendor } = Astro.props;
---

<div class="flex flex-col bg-cream rounded-xl overflow-hidden border border-orange/10 h-full">
  {image && (
    <div class="h-40 overflow-hidden shrink-0">
      <img
        src={image}
        alt={`Photo of ${name}`}
        class="w-full h-full object-cover"
        loading="lazy"
        width={400}
        height={160}
      />
    </div>
  )}
  <div class="p-4 flex flex-col gap-1 flex-1">
    <p class="font-merriweather font-bold text-primary text-sm leading-snug">{name}</p>
    {story && <p class="text-gray-600 text-xs leading-relaxed flex-1">{story}</p>}
    {vendor && (
      <p class="text-[10px] uppercase tracking-widest text-orange font-bold mt-2">{vendor}</p>
    )}
  </div>
</div>
