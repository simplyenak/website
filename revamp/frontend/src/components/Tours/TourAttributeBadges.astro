    CN: '<svg viewBox="0 0 513 342" width="20" height="13" style="border-radius:1.5px"><path fill="#D80027" d="M0 0h513v342H0z"/><g fill="#FFDA44"><path d="m226.8 239.2-9.7-15.6-17.9 4.4 11.9-14.1-9.7-15.6 17.1 6.9 11.8-14.1-1.3 18.4 17.1 6.9-17.9 4.4zM290.6 82l-10.1 15.4 11.6 14.3-17.7-4.8-10.1 15.5-1-18.4-17.7-4.8 17.2-6.6-1-18.4 11.6 14.3zM236.2 25.4l-2 18.3 16.8 7.6-18 3.8-2 18.3-9.2-16-17.9 3.8 12.3-13.7-9.2-15.9 16.8 7.5zM292.8 161.8l-14.9 10.9 5.8 17.5-14.9-10.8-14.9 11 5.6-17.6-14.9-10.7 18.4-.1 5.6-17.6 5.8 17.5zM115 46.3l17.3 53.5h56.2l-45.4 32.9 17.3 53.5-45.4-33-45.5 33 17.4-53.5-45.5-32.9h56.3z"/></g></svg>',
    FR: '<svg viewBox="0 0 513 342" width="20" height="13" style="border-radius:1.5px"><path fill="#FFF" d="M0 0h513v342H0z"/><path fill="#00318A" d="M0 0h171v342H0z"/><path fill="#D80027" d="M342 0h171v342H342z"/></svg>',
    JP: '<svg viewBox="0 0 513 342" width="20" height="13" style="border-radius:1.5px"><path fill="#FFF" d="M0 0h513v342H0z"/><circle cx="256.5" cy="171" r="114" fill="#D80027"/></svg>',
    KR: '<svg viewBox="0 0 513 342" width="20" height="13" style="border-radius:1.5px"><rect fill="#FFF" width="513" height="342"/><g fill="#D80027"><path d="M230.4 85.6c2.8-1 4.6-3.6 4.6-6.6v-1c0-4-3.2-7.2-7.2-7.2-2.2 0-4.2 1-5.5 2.7a45.6 45.6 0 0 0-66 0c-1.3-1.7-3.3-2.7-5.5-2.7-4 0-7.2 3.2-7.2 7.2v1c0 3 1.8 5.6 4.6 6.6a45.3 45.3 0 0 0 9.7 42.6c1.7 1.9 3.9 3.3 6.4 3.8l-2.1 27.5c-.2 2.1 1.3 4 3.5 4.3l4.7.6c2.1.3 4.2-1.2 4.5-3.3l2.1-28.5a5 5 0 0 0 2-.4 4.8 4.8 0 0 0 1.4-.9l3.2 23.7c.4 2.7 3 4.6 5.8 4.2l4.7-.6c2.7-.4 4.6-3 4.2-5.8l-3.2-23.5c.2-.2.4-.4.6-.7a33.4 33.4 0 0 0 5.8-.6 47.1 47.1 0 0 0 9-42.8zm-51 30a30 30 0 0 1-2-42.5v.2c.2-2 .7-4 1.4-5.9a30 30 0 0 1 .6 48.2zm8.2 5.5a15 15 0 0 1-5-10.8c.4-3.2 1.5-6.2 3.2-8.8a15 15 0 0 1-5.7 12.2zm.4-27.5a15 15 0 0 1 7-1.8c3.3.1 6.5 1.2 9.2 3a15 15 0 0 1-8 11.7 14.9 14.9 0 0 1-8.2-12.9z"/><path d="M199.9 172.2c-2.8 1-4.6 3.6-4.6 6.6v1c0 4 3.2 7.2 7.2 7.2 2.2 0 4.2-1 5.5-2.7a45.6 45.6 0 0 0 66 0c1.3 1.7 3.3 2.7 5.5 2.7 4 0 7.2-3.2 7.2-7.2v-1c0-3-1.8-5.6-4.6-6.6a45.3 45.3 0 0 0-9.7-42.6c-1.7-1.9-3.9-3.3-6.4-3.8l2.1-27.5c.2-2.1-1.3-4-3.5-4.3l-4.7-.6c-2.1-.3-4.2 1.2-4.5 3.3l-2.1 28.5a5 5 0 0 0-2 .4 4.8 4.8 0 0 0-1.4.9l-3.2-23.7c-.4-2.7-3-4.6-5.8-4.2l-4.7.6c-2.7.4-4.6 3-4.2 5.8l3.2 23.5c-.2.2-.4.4-.6.7a33.4 33.4 0 0 0-5.8.6 47.1 47.1 0 0 0-9 42.8zm51-30a30 30 0 0 1 2 42.5v-.2c-.2 2-.7 4-1.4 5.9a30 30 0 0 1-.6-48.2zm-8.2-5.5a15 15 0 0 1 5 10.8c-.4 3.2-1.5 6.2-3.2 8.8a15 15 0 0 1 5.7-12.2zm-.4 27.5a15 15 0 0 1-7 1.8c-3.3-.1-6.5-1.2-9.2-3a15 15 0 0 1 8-11.7 14.9 14.9 0 0 1 8.2 12.9z"/></g><g fill="#00318A"><path d="M228.3 85.6c-2.8-1-4.6-3.6-4.6-6.6 0-4 3.2-7.2 7.2-7.2 2.2 0 4.2 1 5.5 2.7a45.6 45.6 0 0 1 66 0c1.3-1.7 3.3-2.7 5.5-2.7 4 0 7.2 3.2 7.2 7.2 0 3-1.8 5.6-4.6 6.6a45.3 45.3 0 0 1 9.7 42.6c-1.7 1.9-3.9 3.3-6.4 3.8l2.1 27.5c.2 2.1-1.3 4-3.5 4.3l-4.7.6c-2.1.3-4.2-1.2-4.5-3.3l-2.1-28.5a5 5 0 0 1-2 .4 4.8 4.8 0 0 1-1.4.9l-3.2 23.7c-.4 2.7-3 4.6-5.8 4.2l-4.7-.6c-2.7-.4-4.6-3-4.2-5.8l3.2-23.5c-.2-.2-.4-.4-.6-.7a33.4 33.4 0 0 1-5.8.6 47.1 47.1 0 0 1-9-42.8z"/><path d="M262.1 172.2c2.8 1 4.6 3.6 4.6 6.6 0 4-3.2 7.2-7.2 7.2-2.2 0-4.2-1-5.5-2.7a45.6 45.6 0 0 1-66 0c-1.3 1.7-3.3 2.7-5.5 2.7-4 0-7.2-3.2-7.2-7.2 0-3 1.8-5.6 4.6-6.6a45.3 45.3 0 0 1-9.7-42.6c1.7-1.9 3.9-3.3 6.4-3.8l-2.1-27.5c-.2-2.1 1.3-4 3.5-4.3l4.7-.6c2.1-.3 4.2 1.2 4.5 3.3l2.1 28.5a5 5 0 0 1 2 .4c.5.2 1 .5 1.4.9l3.2-23.7c.4-2.7 3-4.6 5.8-4.2l4.7.6c2.7.4 4.6 3 4.2 5.8l-3.2 23.5c.2.2.4.4.6.7a33.4 33.4 0 0 1 5.8.6 47.1 47.1 0 0 1 9 42.8z"/></g></svg>',
    DE: '<svg viewBox="0 0 513 342" width="20" height="13" style="border-radius:1.5px"><path fill="#464646" d="M0 0h513v114H0z"/><path fill="#DD0000" d="M0 114h513v114H0z"/><path fill="#FFCE00" d="M0 228h513v114H0z"/></svg>',
