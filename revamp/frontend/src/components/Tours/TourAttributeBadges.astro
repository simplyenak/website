  return flags[code] || '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#FFA333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';
}

// ── Lucide icon SVGs (red #B52D38 for Info, orange #FFA333 for Tags) ──

const R = '#B52D38'; // red for Info section
const O = '#FFA333'; // orange for Tags section

const icons = {
  // Info (red)
  clock: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${R}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${R}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>`,
  calendar: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${R}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  user: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${R}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  shieldCheck: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${O}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  wheelchair: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="${R}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="16" r="5"/><circle cx="7" cy="18" r="2.5"/><line x1="7.5" y1="16" x2="18" y2="12"/><line x1="18" y1="12" x2="18" y2="7"/><circle cx="18" cy="5" r="2"/><path d="M16 9 Q14 11 14 14"/></svg>`,

  // Tags (orange)
  leaf: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${O}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 2c1 2 2 4.5 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  vegan: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${O}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8q6 0 6-6-6 0-6 6"/><path d="M17.41 3.59a10 10 0 1 0 3 3"/><path d="M2 2a20.3 20.3 0 0 1 4 5.5"/></svg>`,
  handshake: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${O}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>`,
  circleSlash: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${O}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>`,

  // Halal (custom — Arabic calligraphy)
  halal: `<svg viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="10" fill="none" stroke="${O}" stroke-width="1.5" opacity="0.35"/><text x="12" y="12.3" text-anchor="middle" dominant-baseline="central" font-family="'Noto Naskh Arabic','Traditional Arabic','Arial',sans-serif" font-size="9" fill="${O}" opacity="0.75">حلال</text></svg>`,

  // Family (custom three-figure silhouette)
  family: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="${O}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="2.5"/><path d="M5.5 21v-3.5a3.5 3.5 0 0 1 3.5-3.5"/><circle cx="18" cy="8" r="2"/><path d="M21 21v-2a3 3 0 0 0-3-3"/><circle cx="13.5" cy="5" r="1.5"/><path d="M12 21v-4.5A1.5 1.5 0 0 1 13.5 15h0"/></svg>`,

  // Age badge with number
  ageBadge: (age: number): string => {
    const textSize = age >= 100 ? 7 : age >= 10 ? 9 : 11;
    const label = age <= 0 ? 'All' : `${age}+`;
    const finalSize = age <= 0 ? 8 : textSize;
    return `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="${R}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><text x="12" y="12.3" text-anchor="middle" dominant-baseline="central" font-family="system-ui,sans-serif" font-size="${finalSize}" font-weight="400" fill="${R}">${label}</text></svg>`;
  },

  // GF badge
  gfBadge: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="${O}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><text x="12" y="12.3" text-anchor="middle" dominant-baseline="central" font-family="system-ui,sans-serif" font-size="7" font-weight="400" fill="${O}">GF</text></svg>`,
};

// ── Build box arrays ──

interface BoxItem {
  icon: string;
  label: string;
  type: 'info' | 'tag';
}

const infoBoxes: BoxItem[] = [];

if (duration) {
  infoBoxes.push({ icon: icons.clock, label: duration, type: 'info' });
}
if (groupSize) {
  infoBoxes.push({ icon: icons.users, label: groupSize, type: 'info' });
}
if (tourFrequency) {
  infoBoxes.push({ icon: icons.calendar, label: tourFrequency, type: 'info' });
}
if (wheelchairAccessible) {
  infoBoxes.push({ icon: icons.wheelchair, label: wheelchairAccessible, type: 'info' });
}
if (isPrivate) {
  infoBoxes.push({ icon: icons.user, label: 'Private', type: 'info' });
}
if (minAge && minAge > 0) {
  infoBoxes.push({ icon: icons.ageBadge(minAge), label: `Min ${minAge}+`, type: 'info' });
} else if (minAge === null || minAge === undefined) {
  // Show "All Ages" badge when no age restriction
  infoBoxes.push({ icon: icons.ageBadge(0), label: 'All Ages', type: 'info' });
}
if (freeCancel) {
  infoBoxes.push({ icon: icons.shieldCheck, label: 'Free Cancel', type: 'info' });
}

// Language — factual info, not a tag
for (const lang of languagesOffered) {
  infoBoxes.push({
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B52D38" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    label: lang.trim(),
    type: 'info'
  });
}

const tagBoxes: BoxItem[] = [];

// Walking bar
if (wl > 0) {
  const labels: Record<number, string> = { 1: 'Easy Walking', 2: 'Gentle Walking', 3: 'Moderate Walking', 4: 'Active Walking', 5: 'Strenuous Walking' };
  tagBoxes.push({ icon: walkingBarSvg(wl), label: `${labels[wl] || 'Walking'}`, type: 'tag' });
}

// Dietary badges
if (isHalal) {
  tagBoxes.push({ icon: icons.halal, label: 'Halal', type: 'tag' });
}
if (isVegetarian) {
  tagBoxes.push({ icon: icons.leaf, label: 'Vegetarian', type: 'tag' });
}
if (isVegan) {
  tagBoxes.push({ icon: icons.vegan, label: 'Vegan', type: 'tag' });
}
if (isGlutenFree) {
  tagBoxes.push({ icon: icons.gfBadge, label: 'Gluten-free', type: 'tag' });
}
if (isKidFriendly) {
  tagBoxes.push({ icon: icons.family, label: 'Family', type: 'tag' });
}
if (isNoAlcohol) {
  tagBoxes.push({ icon: icons.circleSlash, label: 'No alcohol', type: 'tag' });
}
// Local Impact is a brand-wide badge, not per-tour — shown always
tagBoxes.push({ icon: icons.handshake, label: 'Local Impact', type: 'tag' });
if (freeCancel) {
  tagBoxes.push({ icon: icons.shieldCheck, label: 'Free Cancel', type: 'tag' });
}

const hasTags = tagBoxes.length > 0;
---

<div class="flex flex-wrap items-start gap-x-6 gap-y-2">
{
  hasTags && (
    <div class="flex-shrink-0">
      <div class="attribute-row">
        {tagBoxes.map((box) => (
          <div class="box tag">
            <span set:html={box.icon} />
            <span class="label">{box.label}</span>
          </div>
        ))}
      </div>
    </div>
  )
}
</div>

<style is:global>
  /* ── Section titles ── */
  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }
  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
  }
  .section-title.info {
    color: #888;
  }
  .section-title.info::after {
    background: rgba(255,255,255,0.12);
  }
  .section-title.tags {
    color: #FFA333;
  }
  .section-title.tags::after {
    background: rgba(255,163,51,0.3);
  }

  /* ── Attribute rows ── */
  .attribute-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ── Individual boxes ── */
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 8px;
    border: 1px solid;
    min-width: 64px;
  }
  .box svg {
    display: block;
  }
  .box .label {
    font-size: 12px;
    font-weight: 500;
    text-align: center;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Info boxes: subtle white border on dark */
  .box.info {
    border-color: rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
  }
  .box.info .label {
    color: #bbb;
  }

  /* Tag boxes: subtle orange border on dark */
  .box.tag {
    border-color: rgba(255,163,51,0.25);
    background: rgba(255,163,51,0.05);
  }
  .box.tag .label {
    color: #ffcc80;
  }

  /* Responsive: larger boxes on wider screens */
  @media (min-width: 900px) {
    .box {
      padding: 12px 20px;
      min-width: 72px;
    }
    .box .label {
      font-size: 12px;
    }
  }
</style>
