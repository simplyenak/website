---
/**
 * TourAttributeBadges — v14 Boxed Chip Design for tour detail hero area.
 *
 * Dark theme: "Info" section (white/border boxes, red #B52D38 icons) for
 * logistical stats + "Good For" section (orange border boxes, orange #FFA333
 * icons) for suitability/tag indicators.
 *
 * One option per box, no food metaphors, degrades gracefully with null data.
 *
 * Usage: <TourAttributeBadges duration={...} groupSize={...} ... />
 *
 * Full specification documented in:
 *   sketches/pill-alternatives/v14.html  (live at port 9876)
 */

interface Props {
  duration?: string | null;
  groupSize?: string | null;
  tourFrequency?: string | null;

  // Difficulty → 5-level walking bar
  difficulty?: string | null;
  walkingDistance?: string | null;

  // Text-array fields from CMS sync
  dietaryOptions?: string[];
  languagesOffered?: string[];

  // Boolean / derived fields
  tailoredAvailable?: boolean | null;
  cancellationPolicy?: string | null;

  // NEW fields — null until CMS schema is extended
  wheelchairAccessible?: string | null;   // "limited" | "difficult" | "easy" | null
  minAge?: number | null;                  // e.g., 12, 18, null (all ages)
  alcoholPolicy?: string | null;           // "no-alcohol" | null
}

const {
  duration,
  groupSize,
  tourFrequency,
  difficulty,
  walkingDistance,
  dietaryOptions = [],
  languagesOffered = [],
  tailoredAvailable,
  cancellationPolicy,
  wheelchairAccessible,
  minAge,
  alcoholPolicy,
} = Astro.props;

// ── Helpers ──────────────────────────────────────────────

function walkingLevel(d: string | null | undefined): number {
  const map: Record<string, number> = { easy: 1, gentle: 2, moderate: 3, active: 4, challenging: 5 };
  return map[d?.toLowerCase() ?? ''] ?? 0;
}

function hasFreeCancel(policy: string | null | undefined): boolean {
  return !!policy && /free\s+cancell?ation/i.test(policy);
}

/**
 * Exact-match dietary detection by slug/type — avoids "vegetarian" matching "vegan"
 * or "kid-friendly" conflating with dietary purpose. Each option text is checked
 * against known patterns for the icon it should map to.
 */
function detectDietary(options: string[], type: string): boolean {
  const patterns: Record<string, RegExp[]> = {
    vegetarian: [/vegetarian/i, /^veg\b/i],
    vegan: [/^vegan/i],
    halal: [/^halal/i],
    glutenFree: [/gluten.?free/i, /gluten.?friendly/i],
    kidFriendly: [/kid.?friendly/i, /^family$/i],
  };
  return (patterns[type] || []).some((re) => options.some((o) => re.test(o.trim())));
}

const wl = walkingLevel(difficulty);
const freeCancel = hasFreeCancel(cancellationPolicy);
const isPrivate = tailoredAvailable === true;
const isNoAlcohol = alcoholPolicy === 'no-alcohol';

// Derived dietary flags — uses detectDietary for precise pattern matching
const isVegetarian = detectDietary(dietaryOptions, 'vegetarian');
const isVegan = detectDietary(dietaryOptions, 'vegan');
const isHalal = detectDietary(dietaryOptions, 'halal');
const isGlutenFree = detectDietary(dietaryOptions, 'glutenFree');
const isKidFriendly = detectDietary(dietaryOptions, 'kidFriendly');

// Language → country flag code mapping
const langToFlag: Record<string, string> = {
  english: 'GB', mandarin: 'CN', chinese: 'CN',
  malay: 'MY', malaysian: 'MY', bahasa: 'MY',
  french: 'FR', french: 'FR',
  japanese: 'JP', korean: 'KR',
  german: 'DE', spanish: 'ES', italian: 'IT',
};

// ── Walking bar SVG ──

function walkingBarSvg(level: number, total: number = 5): string {
  const bars = Array.from({ length: total }, (_, i) => {
    const fill = i < level ? 'fill="rgba(255,163,51,0.5)"' : 'fill="rgba(255,163,51,0.18)"';
    const x = 1 + i * 5;
    return `<rect x="${x}" y="${total * 3 - 2}" width="3" height="${total * 3}" rx="0.8" ${fill}/>`;
  }).join('');
  return `<svg viewBox="0 0 ${total * 5 + 1} ${total * 3 + 3}" width="20" height="17" fill="none" stroke="none">${bars}</svg>`;
}

// ── Country flag SVG helper ──

function flagSvg(code: string): string {
