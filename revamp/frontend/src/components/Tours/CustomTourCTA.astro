---
import { siteConfig } from "@/lib/site-config";
import { getLangFromUrl, localizePath } from "@/i18n/utils";
/**
 * CustomTourCTA — shown on segment pages that have no pre-built tours.
 * Frames the absence of a listed tour as an invitation to design together.
 */
interface Props {
  typeName: string; // e.g. "Multi-Day Tours", "Families"
  typeDescription?: string; // optional override for the intro line
}

const { typeName, typeDescription } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const waMessage = encodeURIComponent(
  `Hi! I'm interested in a ${typeName} tour with Simply Enak. Can we talk about what's possible?`
);
---

<section class="bg-[#f9f5ef] border-y border-amber-100">
  <div class="max-w-5xl mx-auto px-6 py-20">

    <!-- Header -->
    <div class="max-w-2xl mb-14">
      <p class="text-sm font-bold uppercase tracking-widest text-primary mb-3">Custom Tour</p>
      <h2 class="text-h2 text-gray-900 mb-4">
        We'll design this one together
      </h2>
      <p class="text-body text-gray-600">
        {typeDescription ??
          `Our ${typeName.toLowerCase()} tours are built around you — your group, your pace, your interests. There is no off-the-shelf version because there shouldn't be.`
        }
      </p>
    </div>

    <!-- Process steps -->
    <div class="grid sm:grid-cols-3 gap-6 mb-14">
      <div class="bg-white rounded-2xl p-7 shadow-sm border border-amber-50">
        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg mb-5">
          1
        </div>
        <h3 class="font-bold text-gray-900 mb-2">Tell us what matters</h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          Cities, dates, group size, dietary needs, how much you like to walk. The more you share, the better we can plan.
        </p>
      </div>
      <div class="bg-white rounded-2xl p-7 shadow-sm border border-amber-50">
        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg mb-5">
          2
        </div>
        <h3 class="font-bold text-gray-900 mb-2">We sketch a route</h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          We put together a draft itinerary based on what we know — vendors, timing, neighbourhoods — and share it with you. You push back, we adjust.
        </p>
      </div>
      <div class="bg-white rounded-2xl p-7 shadow-sm border border-amber-50">
        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg mb-5">
          3
        </div>
        <h3 class="font-bold text-gray-900 mb-2">You show up, we take it from there</h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          On the day, your guide already knows what you want. The vendors are briefed. You just follow your nose.
        </p>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <a
        href={`https://wa.me/${siteConfig.whatsappDigits}?text=${waMessage}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold px-7 py-3.5 rounded-full transition-colors shadow-sm"
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.884.902-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.494.999-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 4.976 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        Start on WhatsApp
      </a>
      <a
        href={localizePath("/contact/", lang)}
        class="inline-flex items-center gap-2 text-primary hover:text-secondary font-semibold transition-colors"
      >
        Or send us a message
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
