---
const testimonials = [
  {
    text: "I've lived in KL for 5 years and never knew Kampung Baru existed until this tour. Meeting Pak Hassan and hearing his family's story was incredible.",
    author: "Michael Tan",
    location: "Singapore",
    source: "TripAdvisor",
  },
  {
    text: "Our guide grew up in these neighborhoods and knew everyone. You can taste why these families refuse to change.",
    author: "Emma & James",
    location: "London, UK",
    source: "Google Reviews",
  },
  {
    text: "Vegetarian-friendly and every stop had proper vegetarian versions — not just the token option. The guide's knowledge was impressive.",
    author: "Yuki Tanaka",
    location: "Tokyo, Japan",
    source: "TripAdvisor",
  },
];
---

<div class="relative overflow-hidden" role="region" aria-label="Guest testimonials">
  <div
    class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 scrollbar-hide"
    role="list"
  >
    {
      testimonials.map((testimonial) => (
        <div class="flex-none w-full md:w-[400px] snap-center" role="listitem">
          <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-100 h-full flex flex-col">
            <div class="flex text-orange-400 mb-4" aria-label="5 out of 5 stars" role="img">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <blockquote class="text-gray-700 text-lg italic mb-6 flex-grow leading-relaxed">
              "{testimonial.text}"
            </blockquote>

            <div class="flex items-center justify-between mt-auto">
              <div>
                <div class="font-bold text-gray-900">{testimonial.author}</div>
                <div class="text-sm text-gray-500">{testimonial.location}</div>
              </div>
              <div class="text-xs font-medium px-3 py-1 bg-gray-100 rounded-full text-gray-600">
                {testimonial.source}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
