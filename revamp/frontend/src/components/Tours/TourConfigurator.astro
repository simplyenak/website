---
import { siteConfig } from "@/lib/site-config";
import { getLangFromUrl, useTranslations, localizePath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

interface Props {
  whatsappNumber?: string;
}

const whatsapp = (Astro.props.whatsappNumber ?? siteConfig.whatsappNumber).replace(/\D/g, '');

// Step 1: Motivation type (mandatory — the foundation)
const motivations = [
  {
    value: "authenticity",
    label: "I want to eat where locals eat, not tourists",
    icon: "🔑",
    description: "Take me where the aunties and uncles actually eat.",
    persona: "Authenticity Seeker",
  },
  {
    value: "culture",
    label: "Food is my way into understanding this place",
    icon: "🧭",
    description: "Every dish tells a story about the people and the place.",
    persona: "Culture Explorer",
  },
  {
    value: "milestone",
    label: "It's a special trip — I want something meaningful",
    icon: "✨",
    description: "Anniversary, birthday, or just — this one matters.",
    persona: "Milestone Maker",
  },
  {
    value: "return",
    label: "I've been before — I want a deeper layer",
    icon: "🔄",
    description: "I know the basics. Take me to the stuff most visitors miss.",
    persona: "Return Explorer",
  },
  {
    value: "chef",
    label: "I work with food — I'm here to learn",
    icon: "👨‍🍳",
    description: "Technique, sourcing, vendors — I want to understand the craft.",
    persona: "Chef / Culinary Enthusiast",
  },
];

// Step 2: Experience style (optional — skip if unsure)
const perfectDays = [
  {
    value: "adventurer",
    label: "Follow a local down an alley for the best laksa you've ever had",
    icon: "🚶",
    description: "Discovery over comfort. Always.",
  },
  {
    value: "storyteller",
    label: "Sit at a hawker stall and hear the story behind every dish",
    icon: "📖",
    description: "Every plate has a person behind it.",
  },
  {
    value: "hands-on",
    label: "Learn how it's made — maybe try cooking it yourself later",
    icon: "🧑‍🍳",
    description: "Understanding the craft is part of the experience.",
  },
  {
    value: "absorber",
    label: "Soak in the atmosphere, let the guide lead at a relaxed pace",
    icon: "🌿",
    description: "I'm here to feel the place, not rush through it.",
  },
];

// Step 3: Memory identity (optional — skip if unsure)
const stories = [
  {
    value: "discovery",
    label: "\"We found this place that wasn't on any map\"",
    icon: "🗺️",
    description: "The thrill of finding something hidden.",
  },
  {
    value: "connection",
    label: "\"We met the most amazing people — the vendors, the guide\"",
    icon: "💬",
    description: "The connections and conversations matter most.",
  },
  {
    value: "growth",
    label: "\"I tried things I never thought I would — and loved them\"",
    icon: "🌱",
    description: "Stepping outside my comfort zone is the whole point.",
  },
  {
    value: "sensory",
    label: "\"That one dish — I still dream about it\"",
    icon: "😋",
    description: "An unforgettable flavour is what I'm chasing.",
  },
];

// Step 4: Openness (optional — skip if unsure)
const openness = [
  {
    value: "all-in",
    label: "Bring it on — I'll try anything once",
    icon: "🔥",
    description: "Maximum openness, zero hesitation.",
  },
  {
    value: "curious",
    label: "I'm curious but I draw some lines",
    icon: "🤔",
    description: "Adventurous with boundaries.",
  },
  {
    value: "prefers-known",
    label: "I prefer to know what I'm getting into",
    icon: "📋",
    description: "A bit of structure helps me relax.",
  },
  {
    value: "depends",
    label: "It depends on the day — surprise me",
    icon: "🎲",
    description: "Flexible and easy-going.",
  },
];

// Step 5: The Basics
const cities = [
  { value: "kl", label: "Kuala Lumpur", icon: "🏙️" },
  { value: "penang", label: "Penang", icon: "🏛️" },
  { value: "both", label: "Both Cities", icon: "✈️" },
];

const groupTypes = [
  { value: "couple", label: "Couple", icon: "💑" },
  { value: "family", label: "Family", icon: "👨‍👩‍👧" },
  { value: "friends", label: "Friends", icon: "👫" },
  { value: "corporate", label: "Corporate", icon: "🏢" },
  { value: "solo", label: "Solo", icon: "🧳" },
  { value: "celebration", label: "Celebration", icon: "🎉" },
];

const dietaryOptions = [
  { value: "none", label: "No restrictions", icon: "🍽️" },
  { value: "vegetarian", label: "Vegetarian", icon: "🥬" },
  { value: "vegan", label: "Vegan", icon: "🌱" },
  { value: "halal", label: "Halal", icon: "☪️" },
  { value: "gluten-free", label: "Gluten-Free", icon: "🌾" },
  { value: "allergies", label: "Allergies", icon: "⚠️" },
  { value: "other", label: "Other / Mixed", icon: "📋" },
];

const referralSources = [
  { value: "ai", label: "AI Search", icon: "🤖" },
  { value: "google", label: "Google", icon: "🔍" },
  { value: "tripadvisor", label: "TripAdvisor", icon: "🦉" },
  { value: "friend", label: "A Friend", icon: "👋" },
  { value: "blog", label: "Blog / Article", icon: "📝" },
  { value: "social", label: "Social Media", icon: "📱" },
  { value: "returning", label: "Been with You Before", icon: "🔄" },
  { value: "hotel", label: "Hotel Concierge", icon: "🏨" },
  { value: "other", label: "Other", icon: "💬" },
];
---

<div class="w-full max-w-3xl mx-auto">
  <!-- Screen-reader description for AI crawlers -->
  <div class="sr-only" aria-hidden="true">
    <h2>{t('tours.experienceProfiler')}</h2>
    <p>Simply Enak doesn't just ask for your date and headcount. We use a 6-step Experience Profiler to understand your motivation, learning style, memory goals, and comfort with the unknown — then generate a narrative brief so your guide can build a route that fits who you are, not just where you want to eat. The profiler identifies five motivation types: Authenticity Seeker, Culture Explorer, Milestone Maker, Return Explorer, and Chef or Culinary Enthusiast. This is our unique differentiator — no other food tour operator profiles guests this way before designing a route.</p>
  </div>

  <div id="configurator" class="bg-white rounded-2xl border border-gray-100 shadow-xl overflow-hidden">
    <!-- Progress bar -->
    <div class="bg-primary/5 px-6 py-4 border-b border-gray-100">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-orange uppercase tracking-wider">Find Your Tour</span>
        <span id="step-counter" class="text-xs text-gray-400">Step 1 of 6</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-1.5">
        <div id="progress-bar" class="bg-orange h-1.5 rounded-full transition-all duration-500" style="width: 17%"></div>
      </div>
    </div>

    <!-- Step 1: Motivation (mandatory) -->
    <div class="config-step active p-6 md:p-8" data-step="1">
      <p class="text-eyebrow text-orange mb-2">Let's Start Here</p>
      <h3 class="text-2xl font-bold text-gray-900 mb-1 font-merriweather">How Would You Like to Experience Malaysia and Its Food?</h3>
      <p class="text-sm text-gray-500 mb-6">There's no wrong answer — it just helps us understand what you're after.</p>
      <div class="space-y-3">
        {motivations.map((m) => (
          <button
            data-action="select"
            data-group="motivation"
            data-value={m.value}
            class="group w-full flex items-start gap-4 p-4 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all text-left"
          >
            <span class="text-2xl flex-shrink-0">{m.icon}</span>
            <div class="flex-1">
              <span class="block font-semibold text-gray-900 text-sm group-hover:text-orange transition-colors">{m.label}</span>
              <span class="block text-xs text-gray-400 mt-0.5">{m.description}</span>
            </div>
            <span class="ml-auto text-orange opacity-0 group-hover:opacity-100 transition-opacity text-lg">→</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Step 2: Experience style -->
    <div class="config-step hidden p-6 md:p-8" data-step="2">
      <p class="text-eyebrow text-orange mb-2">Your Style</p>
      <h3 class="text-2xl font-bold text-gray-900 mb-1 font-merriweather">On a Perfect Travel Day, You'd Rather...</h3>
      <p class="text-sm text-gray-500 mb-6">This tells us how to pace and frame the experience.</p>
      <div class="grid sm:grid-cols-2 gap-3">
        {perfectDays.map((d) => (
          <button
            data-action="select"
            data-group="style"
            data-value={d.value}
            class="group flex items-start gap-3 p-4 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all text-left"
          >
            <span class="text-2xl flex-shrink-0">{d.icon}</span>
            <div>
              <span class="block font-semibold text-gray-900 text-sm group-hover:text-orange transition-colors leading-snug">{d.label}</span>
              <span class="block text-xs text-gray-400 mt-1">{d.description}</span>
            </div>
          </button>
        ))}
      </div>
      <div class="mt-6 text-center">
        <button data-action="skip-step-2" class="text-sm text-gray-400 hover:text-primary underline underline-offset-2 transition-colors">Not sure yet — skip this</button>
      </div>
    </div>

    <!-- Step 3: Memory identity -->
    <div class="config-step hidden p-6 md:p-8" data-step="3">
      <p class="text-eyebrow text-orange mb-2">The Takeaway</p>
      <h3 class="text-2xl font-bold text-gray-900 mb-1 font-merriweather">What Would Make You Tell Your Friends?</h3>
      <p class="text-sm text-gray-500 mb-6">Everyone remembers something different. What's yours?</p>
      <div class="space-y-3">
        {stories.map((s) => (
          <button
            data-action="select"
            data-group="story"
            data-value={s.value}
            class="group w-full flex items-start gap-4 p-4 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all text-left"
          >
            <span class="text-2xl flex-shrink-0">{s.icon}</span>
            <div class="flex-1">
              <span class="block font-semibold text-gray-900 text-sm italic group-hover:text-orange transition-colors">{s.label}</span>
              <span class="block text-xs text-gray-400 mt-1">{s.description}</span>
            </div>
            <span class="ml-auto text-orange opacity-0 group-hover:opacity-100 transition-opacity text-lg">→</span>
          </button>
        ))}
      </div>
      <div class="mt-6 text-center">
        <button data-action="skip-step-3" class="text-sm text-gray-400 hover:text-primary underline underline-offset-2 transition-colors">Not sure yet — skip this</button>
      </div>
    </div>

    <!-- Step 4: Openness -->
    <div class="config-step hidden p-6 md:p-8" data-step="4">
      <p class="text-eyebrow text-orange mb-2">Comfort & Adventure</p>
      <h3 class="text-2xl font-bold text-gray-900 mb-1 font-merriweather">Your Relationship with the Unknown Is...</h3>
      <p class="text-sm text-gray-500 mb-6">No judgment — this just helps us calibrate the experience right.</p>
      <div class="grid sm:grid-cols-2 gap-3">
        {openness.map((o) => (
          <button
            data-action="select"
            data-group="openness"
            data-value={o.value}
            class="group flex items-start gap-3 p-4 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all text-left"
          >
            <span class="text-2xl flex-shrink-0">{o.icon}</span>
            <div>
              <span class="block font-semibold text-gray-900 text-sm group-hover:text-orange transition-colors">{o.label}</span>
              <span class="block text-xs text-gray-400 mt-1">{o.description}</span>
            </div>
          </button>
        ))}
      </div>
      <div class="mt-6 text-center">
        <button data-action="skip-step-4" class="text-sm text-gray-400 hover:text-primary underline underline-offset-2 transition-colors">Not sure yet — skip this</button>
      </div>
    </div>

    <!-- Step 5: The Basics (city, group, headcount) -->
    <div class="config-step hidden p-6 md:p-8" data-step="5">
      <p class="text-eyebrow text-orange mb-2">The Basics</p>
      <h3 class="text-2xl font-bold text-gray-900 mb-1 font-merriweather">Three Quick Things</h3>
      <p class="text-sm text-gray-500 mb-6">The essentials — these help us know what we're planning for.</p>

      <!-- City -->
      <p class="text-sm font-semibold text-gray-700 mb-2">Which city?</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-5">
        {cities.map((city) => (
          <button
            data-action="select"
            data-group="city"
            data-value={city.value}
            class="group flex flex-col items-center p-3 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all"
          >
            <span class="text-xl mb-1">{city.icon}</span>
            <span class="text-xs font-semibold text-gray-900 group-hover:text-orange transition-colors">{city.label}</span>
          </button>
        ))}
      </div>

      <!-- Group type -->
      <p class="text-sm font-semibold text-gray-700 mb-2">Who's going?</p>
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-5">
        {groupTypes.map((g) => (
          <button
            data-action="select"
            data-group="groupType"
            data-value={g.value}
            class="group flex flex-col items-center p-3 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all"
          >
            <span class="text-lg mb-1">{g.icon}</span>
            <span class="text-[10px] font-semibold text-gray-900 group-hover:text-orange transition-colors">{g.label}</span>
          </button>
        ))}
      </div>

      <!-- Headcount counter -->
      <p class="text-sm font-semibold text-gray-700 mb-2">How many people?</p>
      <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3 mb-6 border border-gray-100">
        <span class="text-sm text-gray-600">Total in your group</span>
        <div class="flex items-center gap-3">
          <button data-action="counter" data-delta="-1" data-min="1" class="counter-btn-minus w-9 h-9 rounded-full border border-gray-300 flex items-center justify-center text-gray-600 hover:border-primary hover:text-primary transition-colors text-lg font-bold">−</button>
          <span id="headcount-display" class="w-8 text-center font-bold text-primary text-lg">2</span>
          <button data-action="counter" data-delta="1" data-max="20" class="counter-btn-plus w-9 h-9 rounded-full border border-gray-300 flex items-center justify-center text-gray-600 hover:border-primary hover:text-primary transition-colors text-lg font-bold">+</button>
        </div>
      </div>

      <!-- Continue -->
      <div class="flex justify-end">
        <button data-action="to-step-6" class="bg-primary hover:bg-secondary text-white font-bold py-3 px-8 rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed" disabled>
          Tell Us More →
        </button>
      </div>
    </div>

    <!-- Step 6: Tell Us More (contact info, dietary, dates, referral, question) -->
    <div class="config-step hidden p-6 md:p-8" data-step="6">
      <p class="text-eyebrow text-orange mb-2">Tell Us More</p>
      <h3 class="text-2xl font-bold text-gray-900 mb-1 font-merriweather">Anything Else That Helps?</h3>
      <p class="text-sm text-gray-500 mb-6">All optional — fill in what's useful and skip the rest.</p>

      <!-- Contact Info -->
      <p class="text-sm font-semibold text-gray-700 mb-2">How can we reach you?</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        <input
          type="email"
          id="guest-email"
          placeholder="Email (optional)"
          class="w-full px-4 py-2.5 min-h-[44px] border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-orange focus:ring-1 focus:ring-orange/20 transition-colors placeholder:text-gray-400"
        />
        <input
          type="tel"
          id="guest-phone"
          placeholder="Phone / WhatsApp (optional)"
          class="w-full px-4 py-2.5 min-h-[44px] border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-orange focus:ring-1 focus:ring-orange/20 transition-colors placeholder:text-gray-400"
        />
      </div>

      <!-- Dietary -->
      <p class="text-sm font-semibold text-gray-700 mb-2">Any dietary needs?</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6">
        {dietaryOptions.map((d) => (
          <button
            data-action="select"
            data-group="dietary"
            data-value={d.value}
            class="group flex items-center gap-2 p-3 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all"
          >
            <span class="text-base">{d.icon}</span>
            <span class="text-xs font-semibold text-gray-900 group-hover:text-orange transition-colors">{d.label}</span>
          </button>
        ))}
      </div>

      <!-- When are you coming? -->
      <p class="text-sm font-semibold text-gray-700 mb-2">When are you planning to come?</p>
      <div class="grid grid-cols-2 gap-3 mb-6">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Approximate dates (if known)</label>
          <input
            type="date"
            id="date-from"
            class="w-full px-3 py-2.5 min-h-[44px] border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-orange focus:ring-1 focus:ring-orange/20 transition-colors"
          />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">To (optional)</label>
          <input
            type="date"
            id="date-to"
            class="w-full px-3 py-2.5 min-h-[44px] border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-orange focus:ring-1 focus:ring-orange/20 transition-colors"
          />
        </div>
      </div>
      <p class="text-xs text-gray-400 -mt-4 mb-6">Don't have exact dates? Just tell us the month on WhatsApp.</p>

      <!-- Budget note -->
      <div class="bg-primary/5 rounded-xl p-4 mb-6 border border-primary/10">
        <p class="text-sm text-gray-600 leading-relaxed">
          <span class="font-semibold text-primary">About pricing:</span> Private tours are priced per tour, not per person. Typical range is <strong>RM 600–1,200+ per tour</strong> — so the more people in your group, the lower the per-person cost. We'll quote you within a few hours.
        </p>
      </div>

      <!-- How did you hear about us? (optional) -->
      <p class="text-sm font-semibold text-gray-700 mb-2">How did you hear about us? <span class="font-normal text-gray-400">(optional)</span></p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-6">
        {referralSources.map((r) => (
          <button
            data-action="select"
            data-group="referral"
            data-value={r.value}
            class="group flex items-center gap-2 p-3 rounded-xl border border-gray-200 hover:border-orange hover:bg-orange/5 transition-all"
          >
            <span class="text-base">{r.icon}</span>
            <span class="text-xs font-semibold text-gray-900 group-hover:text-orange transition-colors">{r.label}</span>
          </button>
        ))}
      </div>

      <!-- Anything to ask? -->
      <p class="text-sm font-semibold text-gray-700 mb-2">Anything you want to ask us?</p>
      <textarea
        id="guest-question"
        placeholder="E.g. What happens if it rains? Do you actually eat at every stall? Is this suitable for young kids?"
        rows="3"
        class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-orange focus:ring-1 focus:ring-orange/20 transition-colors resize-none mb-6 placeholder:text-gray-400"
      ></textarea>

      <!-- Continue button -->
      <div class="flex justify-end">
        <button data-action="finish" class="bg-primary hover:bg-secondary text-white font-bold py-3 px-8 rounded-lg transition-colors">
          See My Experience Profile →
        </button>
      </div>
    </div>

    <!-- Result: Experience Profile -->
    <div class="config-step hidden p-6 md:p-8" data-step="result">
      <div class="text-center mb-6">
        <div class="w-14 h-14 rounded-full bg-orange/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2 font-merriweather">We Found Your Food Style</h3>
        <p class="text-sm text-gray-500 max-w-md mx-auto">
          Here's how you travel — and the perfect tour to match. Ready to make it happen?
        </p>
      </div>

      <!-- Profile Card -->
      <div id="profile-card" class="bg-gradient-to-br from-primary/5 to-orange/5 rounded-xl p-6 mb-6 text-left border border-primary/10">
        <div class="flex items-center gap-3 mb-4 pb-4 border-b border-primary/10">
          <div id="profile-emoji" class="text-3xl"></div>
          <div>
            <p class="text-xs text-orange font-bold uppercase tracking-wider">Your Malaysian Food Style</p>
            <h4 id="profile-persona" class="font-bold text-primary text-lg"></h4>
          </div>
        </div>

        <div id="profile-narrative" class="text-sm text-gray-700 leading-relaxed mb-4 italic border-l-2 border-orange/30 pl-4"></div>

        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="text-orange font-bold">📍</span>
            <span id="profile-city" class="text-gray-600"></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-orange font-bold">👥</span>
            <span id="profile-group" class="text-gray-600"></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-orange font-bold">🔢</span>
            <span id="profile-headcount" class="text-gray-600"></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-orange font-bold">🍽️</span>
            <span id="profile-dietary" class="text-gray-600"></span>
          </div>
          <div id="profile-dates-row" class="flex items-center gap-2 col-span-2 hidden">
            <span class="text-orange font-bold">📅</span>
            <span id="profile-dates" class="text-gray-600"></span>
          </div>
          <div class="flex items-center gap-2 col-span-2">
            <span class="text-orange font-bold">🎯</span>
            <span id="profile-openness" class="text-gray-600"></span>
          </div>
        </div>
      </div>

      <!-- Tour suggestion -->
      <div id="tour-suggestion" class="bg-white rounded-xl border border-gray-100 p-5 mb-6 text-left shadow-sm hidden">
        <p class="text-xs font-bold uppercase tracking-wider text-orange mb-2">We'd Start With</p>
        <h4 id="suggested-tour" class="font-bold text-primary text-lg mb-1"></h4>
        <p id="suggested-reason" class="text-sm text-gray-500"></p>
      </div>

      <!-- CTA -->
      <div class="flex flex-col gap-3 justify-center items-center">
        <a
          id="whatsapp-cta"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-3 px-8 rounded-lg transition-colors w-full sm:w-auto"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.884.902-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.867-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.494.999-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 4.976 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          Refine This with Our Team
        </a>
        <button
          id="chat-now-btn"
          class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold py-3 px-8 rounded-lg transition-colors w-full sm:w-auto"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Chat with Our Team Now
        </button>
        <a
          href={localizePath("/contact/", lang)}
          class="inline-flex items-center justify-center gap-2 bg-white border border-gray-200 text-gray-600 hover:text-primary hover:border-primary font-semibold py-3 px-6 rounded-lg transition-colors w-full sm:w-auto"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Email Instead
        </a>
        <button data-action="reset" class="inline-flex items-center justify-center gap-2 bg-white border border-gray-200 text-gray-600 hover:text-primary hover:border-primary font-semibold py-3 px-6 rounded-lg transition-colors w-full sm:w-auto">
          Start Over
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .config-step { transition: opacity 0.3s ease, transform 0.3s ease; }
  .config-step.hidden { display: none; }
  
  /* Ensure quiz buttons are always clickable */
  .config-step button[data-action="select"],
  .config-step button[data-action="skip-step-2"],
  .config-step button[data-action="skip-step-3"],
  .config-step button[data-action="skip-step-4"],
  .config-step button[data-action="to-step-6"],
  .config-step button[data-action="finish"],
  .config-step button[data-action="counter"] {
    cursor: pointer;
    pointer-events: auto;
    position: relative;
    z-index: 1;
  }
  
  /* Remove any overlay that might block clicks */
  .config-step {
    position: relative;
  }
</style>

<script define:vars={{ whatsapp }}>
  const state = {
    motivation: "",
    style: "",
    story: "",
    openness: "",
    city: "",
    groupType: "",
    dietary: "none",
    referral: "",
    headcount: "2",
    guestQuestion: "",
    dateFrom: "",
    dateTo: "",
    email: "",
    phone: "",
  };

  const totalSteps = 6;

  const labels = {
    motivation: {
      authenticity: "Authenticity Seeker — wants to eat where locals actually eat, not tourist spots",
      culture: "Culture Explorer — uses food as a way to understand a place and its people",
      milestone: "Milestone Maker — this trip means something special, wants a memorable experience",
      return: "Return Explorer — has been before, wants depth and the hidden stuff",
      chef: "Chef / Culinary Enthusiast — here to learn technique, sourcing, and vendor craft",
    },
    style: {
      adventurer: "Adventurer — discovery over comfort, will follow a guide anywhere",
      storyteller: "Story Absorber — cares about the people and history behind every dish",
      "hands-on": "Hands-On Learner — wants to understand the craft, maybe recreate it",
      absorber: "Atmosphere Soaker — here to feel the place, relaxed pace, no rushing",
    },
    story: {
      discovery: "Wants to tell friends: 'We found this place that wasn't on any map'",
      connection: "Wants to tell friends: 'We met the most amazing people'",
      growth: "Wants to tell friends: 'I tried things I never thought I would'",
      sensory: "Wants to tell friends: 'That one dish — I still dream about it'",
    },
    openness: {
      "all-in": "Will try anything — maximum openness, zero hesitation",
      curious: "Curious but has boundaries — adventurous with some structure",
      "prefers-known": "Prefers to know what's coming — a bit of structure helps them relax",
      depends: "Easy-going and flexible — happy to be surprised",
    },
    city: {
      kl: "Kuala Lumpur",
      penang: "Penang",
      both: "Both Cities",
    },
    groupType: {
      couple: "A couple",
      family: "A family",
      friends: "A group of friends",
      corporate: "A corporate team",
      solo: "A solo traveller",
      celebration: "A special celebration",
    },
    dietary: {
      none: "No dietary restrictions",
      vegetarian: "Vegetarian",
      vegan: "Vegan",
      halal: "Halal",
      "gluten-free": "Gluten-Free",
      allergies: "Has allergies (will specify)",
      other: "Other dietary needs (will explain)",
    },
    referral: {
      ai: "AI Search (ChatGPT, Gemini, Copilot)",
      google: "Google Search",
      tripadvisor: "TripAdvisor",
      friend: "A friend recommended us",
      blog: "A blog or article",
      social: "Social media",
      returning: "We've been with Simply Enak before",
      hotel: "Our hotel recommended you",
      other: "Other (will explain)",
    },
  };

  const motivationalEmojis = {
    authenticity: "🔑",
    culture: "🧭",
    milestone: "✨",
    return: "🔄",
    chef: "👨‍🍳",
  };

  // Determine pronoun: "We/I" based on group type
  function pronoun() {
    const solo = state.groupType === "solo";
    return {
      subj: solo ? "I" : "We",
      poss: solo ? "my" : "our",
      obj: solo ? "me" : "us",
    };
  }

  // Tour suggestion engine
  function suggestTour(city, motivation, style) {
    if (city === "both") {
      return { name: "Multi-City Culinary Journey", reason: "A custom KL + Penang itinerary designed around your travel style. We'll plan the route and timing." };
    }

    if (city === "kl") {
      if (motivation === "chef") {
        return { name: "Flavours of Malaysia — Chef's Route", reason: "Off-the-beaten-track with deep vendor access. We can arrange wet market sourcing visits, technique observation, and introductions to the craft people." };
      }
      if (motivation === "return") {
        return { name: "Flavours of Malaysia (Off the Beaten Track)", reason: "4-hour route through neighborhoods most tours skip. If you've done KL before, this is the one you haven't seen." };
      }
      if (style === "adventurer" || style === "absorber") {
        return { name: "Flavours of Malaysia (Off the Beaten Track)", reason: "4-hour deep dive through neighborhoods most tours skip. Unscripted, adaptive, perfect for your style." };
      }
      if (motivation === "authenticity") {
        return { name: "Kuala Lumpur Street Food", reason: "Pudu's hawker stalls and wet markets — where locals actually eat. This is authenticity at its purest." };
      }
      return { name: "Kuala Lumpur Street Food", reason: "Our signature KL tour — a great starting point we'll customize for you." };
    }

    if (city === "penang") {
      if (motivation === "chef") {
        return { name: "Eat Drink George Town — Chef's Route", reason: "Heritage route with vendor craft deep-dives. We can arrange visits to the noodle makers, the belacan producers, and the wok masters." };
      }
      if (motivation === "return") {
        return { name: "Eat Drink George Town", reason: "Georgetown's heritage lanes and hawker scene — if you've done Penang before, this goes past the tourist Gurney Drive spots." };
      }
      if (motivation === "culture" || style === "storyteller") {
        return { name: "Eat Drink George Town", reason: "UNESCO heritage meets hawker heaven. Every stop has a story — perfect for how you travel." };
      }
      return { name: "Penang Street Food", reason: "Our signature Penang tour — hawker centers, local favorites, all customizable." };
    }

    return null;
  }

  // Build the narrative
  function buildNarrative() {
    const p = pronoun();
    const parts = [];

    const motivationNarratives = {
      authenticity: `${p.subj} want to eat like locals, not tourists. Take ${p.obj} where the aunties and uncles actually eat.`,
      culture: `Food is ${p.poss} way into understanding a place. ${p.subj} want to understand the people behind the plates.`,
      milestone: `This trip means something to ${p.obj}. ${p.subj} would love something that feels special.`,
      return: `${p.subj}'ve been to Malaysia before — now ${p.subj} want a deeper layer. The hidden stalls, the neighbourhoods ${p.subj} didn't find, the stuff most visitors never see.`,
      chef: `${p.subj} work with food and ${p.subj.toLowerCase()}'m here to learn. ${p.subj} would love to understand technique, sourcing, and the vendor craft — the things you can't get from a normal tour.`,
    };
    if (state.motivation && motivationNarratives[state.motivation]) {
      parts.push(motivationNarratives[state.motivation]);
    }

    const styleNarratives = {
      adventurer: `${p.subj} tend to prefer discovery over comfort — if there's an unknown alley ${p.poss} guide thinks ${p.obj.toLowerCase()} should see, ${p.subj.toLowerCase()}'re probably up for it.`,
      storyteller: `What matters most to ${p.obj} is the people and the stories — every dish has someone behind it and ${p.subj.toLowerCase()} would love to know them.`,
      "hands-on": `${p.subj} love understanding how things are made. If there's a chance to learn a technique or see the craft up close, that's a bonus.`,
      absorber: `${p.subj} are here to soak in the atmosphere and feel the place. ${p.subj} would rather move slowly and absorb it all than rush through a checklist.`,
    };
    if (state.style && styleNarratives[state.style]) {
      parts.push(styleNarratives[state.style]);
    }

    const storyPayoffs = {
      discovery: `Ideally, the story ${p.subj.toLowerCase()} would take home is about finding something hidden — a place ${p.subj.toLowerCase()} would never have found on ${p.poss.toLowerCase()} own.`,
      connection: `What ${p.subj.toLowerCase()} would probably remember most is the people ${p.subj.toLowerCase()} met — the vendors, the guide, the conversations along the way.`,
      growth: `${p.subj} would love to come back having tried things ${p.subj.toLowerCase()} never thought ${p.subj.toLowerCase()} would — and loved every minute.`,
      sensory: `${p.subj} are chasing that one unforgettable flavour — the dish ${p.subj.toLowerCase()} would still be talking about months later.`,
    };
    if (state.story && storyPayoffs[state.story]) {
      parts.push(storyPayoffs[state.story]);
    }

    return parts.join(" ");
  }

  function updateProgress() {
    const bar = document.getElementById('progress-bar');
    const counter = document.getElementById('step-counter');
    const step = document.querySelector('.config-step:not(.hidden)')?.getAttribute('data-step');
    const stepNum = step === 'result' ? totalSteps : parseInt(step || '1');
    if (bar) bar.style.width = `${(stepNum / totalSteps) * 100}%`;
    if (counter) counter.textContent = step === 'result' ? 'Your Experience Profile' : `Step ${stepNum} of ${totalSteps}`;
  }

  function showStep(step) {
    document.querySelectorAll('.config-step').forEach((el) => {
      el.classList.add('hidden');
    });
    const target = document.querySelector(`[data-step="${step}"]`);
    if (target) {
      target.classList.remove('hidden');
      updateProgress();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function checkStep5Ready() {
    const btn = document.querySelector('[data-action="to-step-6"]');
    if (btn) {
      btn.disabled = !(state.city && state.groupType);
    }
  }

  // Visual selection helper
  function selectVisual(target, group) {
    const container = target.closest('.config-step');
    if (!container) return;
    container.querySelectorAll(`[data-group="${group}"]`).forEach((btn) => {
      btn.classList.remove('border-orange', 'bg-orange/5');
      btn.classList.add('border-gray-200');
    });
    target.classList.remove('border-gray-200');
    target.classList.add('border-orange', 'bg-orange/5');
  }

  function showResult() {
    showStep('result');

    const p = pronoun();

    // Persona
    const emojiEl = document.getElementById('profile-emoji');
    const personaEl = document.getElementById('profile-persona');
    
    // Map motivation to Identity Labels
    const identityLabels = {
      authenticity: { name: "The Real Deal", desc: "You want what locals eat, not what tourists are told" },
      culture: { name: "The Story Collector", desc: "Every dish tells you something about the place" },
      milestone: { name: "The Moment Maker", desc: "This trip means something — you want it to matter" },
      return: { name: "The Deep Diver", desc: "You've done the surface, now you want the real Malaysia" },
      chef: { name: "The Craft Seeker", desc: "You want to understand how it's made, not just eat it" },
    };
    
    const identity = identityLabels[state.motivation] || { name: "Custom Experience", desc: "" };
    if (emojiEl) emojiEl.textContent = motivationalEmojis[state.motivation] || "🎯";
    if (personaEl) {
      personaEl.innerHTML = `You're <span class="text-orange">${identity.name}</span><br/><span class="text-sm font-normal text-gray-500">${identity.desc}</span>`;
    }

    // Narrative
    const narrativeEl = document.getElementById('profile-narrative');
    if (narrativeEl) narrativeEl.textContent = `"${buildNarrative()}"`;

    // Quick facts
    const cityEl = document.getElementById('profile-city');
    const groupEl = document.getElementById('profile-group');
    const headcountEl = document.getElementById('profile-headcount');
    const dietaryEl = document.getElementById('profile-dietary');
    const opennessEl = document.getElementById('profile-openness');

    if (cityEl) cityEl.textContent = labels.city[state.city] || "";
    if (groupEl) groupEl.textContent = labels.groupType[state.groupType] || "";
    if (headcountEl) headcountEl.textContent = `${state.headcount} people`;
    if (dietaryEl) dietaryEl.textContent = labels.dietary[state.dietary] || "";
    if (opennessEl) opennessEl.textContent = state.openness ? (labels.openness[state.openness] || "") : "Not specified";

    // Dates
    const datesRow = document.getElementById('profile-dates-row');
    const datesEl = document.getElementById('profile-dates');
    if (state.dateFrom || state.dateTo) {
      if (datesRow) datesRow.classList.remove('hidden');
      if (datesEl) {
        const from = state.dateFrom ? new Date(state.dateFrom).toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' }) : "";
        const to = state.dateTo ? new Date(state.dateTo).toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' }) : "";
        datesEl.textContent = from && to ? `${from} → ${to}` : from || to || "";
      }
    }

    // Capture contact info from inputs
    const emailEl = document.getElementById('guest-email');
    const phoneEl = document.getElementById('guest-phone');
    state.email = emailEl?.value?.trim() || "";
    state.phone = phoneEl?.value?.trim() || "";

    // Tour suggestion
    const suggestion = suggestTour(state.city, state.motivation, state.style);
    const suggestionEl = document.getElementById('tour-suggestion');
    const tourNameEl = document.getElementById('suggested-tour');
    const reasonEl = document.getElementById('suggested-reason');
    if (suggestion && suggestionEl && tourNameEl && reasonEl) {
      suggestionEl.classList.remove('hidden');
      tourNameEl.textContent = suggestion.name;
      reasonEl.textContent = suggestion.reason;
    }

    // WhatsApp message
    const narrative = buildNarrative();
    const referral = state.referral ? `\nHeard about you via: ${labels.referral[state.referral] || ""}` : "";
    const dates = state.dateFrom ? `\n📅 ${state.dateFrom}${state.dateTo ? ` → ${state.dateTo}` : ""}` : "";
    const guestQuestionEl = document.getElementById('guest-question');
    const guestQuestion = guestQuestionEl?.value?.trim() || "";
    const questionLine = guestQuestion ? `\n\nQuestion for you: ${guestQuestion}` : "";
    const contactInfo = state.email ? `\n📧 ${state.email}` : "";
    const phoneInfo = state.phone ? `\n📱 ${state.phone}` : "";
    const msg = `Hi! ${pronoun().subj}'d like to plan a private food experience. Here's a bit about ${pronoun().obj.toLowerCase()}:

${narrative}

📍 ${labels.city[state.city] || ""}
👥 ${labels.groupType[state.groupType] || ""} (${state.headcount} people)
🍽️ ${labels.dietary[state.dietary] || ""}${dates}${contactInfo}${phoneInfo}
🎯 ${state.openness ? (labels.openness[state.openness] || "") : "Not specified"}${referral}${questionLine}

Can you suggest something that would be right for ${pronoun().obj.toLowerCase()}?`;

    const waLink = document.getElementById('whatsapp-cta');
    if (waLink) waLink.setAttribute('href', `https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`);

    // MyAlice integration: re-init with profile data so agents see the guest's profile
    const chatBtn = document.getElementById('chat-now-btn');
    if (chatBtn) {
      chatBtn.addEventListener('click', () => {
        if (typeof window.MyAliceWebChat !== 'undefined') {
          const myAliceUser = {
            tour_motivation: state.motivation || '',
            tour_style: state.style || '',
            tour_memory_goal: state.story || '',
            tour_openness: state.openness || '',
            tour_city: state.city || '',
            tour_group_type: state.groupType || '',
            tour_headcount: state.headcount || '',
            tour_dietary: state.dietary || 'none',
            tour_referral: state.referral || '',
            tour_dates: state.dateFrom || state.dateTo || '',
            tour_question: guestQuestion || '',
          };
          if (state.email) myAliceUser.email = state.email;
          if (state.phone) myAliceUser.phone = state.phone;

          window.MyAliceWebChat.init({
            selector: '#myAliceWebChat',
            platformId: '12818',
            primaryId: '7b296d7e658e11edac5dc275f55bff6f',
            token: '4c6981083aeed7ce81f8c47d029d061227cf5f3939f449b4',
            user: myAliceUser,
          });
          // Trigger the widget to open
          const widgetHead = document.querySelector('#myAliceWebChat .mwa-widget-head');
          if (widgetHead) {
            widgetHead.click();
          }
        }
      }, { once: true });
    }
  }

  // Event delegation
  document.addEventListener('click', (e) => {
    const target = (e.target).closest('[data-action]') || null;
    if (!target) return;

    const action = target.dataset.action;

    // Skip buttons for optional steps
    if (action === 'skip-step-2') { showStep(3); return; }
    if (action === 'skip-step-3') { showStep(4); return; }
    if (action === 'skip-step-4') { showStep(5); return; }

    // Step 5 → 6 transition
    if (action === 'to-step-6') { showStep(6); return; }

    // Counter
    if (action === 'counter') {
      const display = document.getElementById('headcount-display');
      if (!display) return;
      const delta = parseInt((target).dataset.delta || '0', 10);
      const min = parseInt((target).dataset.min || '1', 10);
      const max = parseInt((target).dataset.max || '20', 10);
      let current = parseInt(display.textContent || '2', 10);
      const next = current + delta;
      if (next < min || next > max) return;
      display.textContent = String(next);
      state.headcount = String(next);
      
      // Disable minus at min
      const minusBtn = document.querySelector('.counter-btn-minus');
      if (minusBtn) minusBtn.disabled = next <= min;
      return;
    }

    // Select
    const group = target.dataset.group;
    const value = target.dataset.value;
    if (action === 'select' && group && value) {
      state[group] = value;
      selectVisual(target, group);

      // Auto-advance for steps 1-4
      const currentStepEl = document.querySelector('.config-step:not(.hidden)');
      const currentStep = currentStepEl?.getAttribute('data-step');

      if (['1', '2', '3', '4'].includes(currentStep || '')) {
        const nextStep = parseInt(currentStep || '1') + 1;
        setTimeout(() => showStep(nextStep.toString()), 250);
      }
      if (currentStep === '5') {
        checkStep5Ready();
      }
      if (currentStep === '6') {
        // Stay on step 6 for remaining fields
      }
    }

    if (action === 'finish') {
      // Capture dates from inputs
      const dateFromEl = document.getElementById('date-from');
      const dateToEl = document.getElementById('date-to');
      if (dateFromEl) state.dateFrom = dateFromEl.value;
      if (dateToEl) state.dateTo = dateToEl.value;
      showResult();
    }

    if (action === 'reset') {
      state.motivation = "";
      state.style = "";
      state.story = "";
      state.openness = "";
      state.city = "";
      state.groupType = "";
      state.dietary = "none";
      state.referral = "";
      state.headcount = "2";
      state.guestQuestion = "";
      state.dateFrom = "";
      state.dateTo = "";
      state.email = "";
      state.phone = "";

      document.querySelectorAll('[data-group]').forEach((el) => {
        el.classList.remove('border-orange', 'bg-orange/5');
        el.classList.add('border-gray-200');
      });

      const display = document.getElementById('headcount-display');
      if (display) display.textContent = "2";
      const minusBtn = document.querySelector('.counter-btn-minus');
      if (minusBtn) minusBtn.disabled = true;
      const questionEl = document.getElementById('guest-question');
      if (questionEl) questionEl.value = "";
      const dateFromEl = document.getElementById('date-from');
      if (dateFromEl) dateFromEl.value = "";
      const dateToEl = document.getElementById('date-to');
      if (dateToEl) dateToEl.value = "";
      const emailInput = document.getElementById('guest-email');
      if (emailInput) emailInput.value = "";
      const phoneInput = document.getElementById('guest-phone');
      if (phoneInput) phoneInput.value = "";

      showStep(1);
    }
  });
</script>
