---
import Layout from "../layouts/Layout.astro";
import CTASection from "@/components/CTASection.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import GetInTouchSection from "@/components/Contact/GetInTouchSection.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import Icon from "@/components/Icon.astro";
import { getSiteSettings, getContactPage } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";
import { siteConfig } from "@/lib/site-config";

export const prerender = true;

// Get language from URL
const lang = getLangFromUrl(Astro.url);

const settings = await getSiteSettings();
const contactPage = await getContactPage(lang);
const webhookUrl: string = (settings as any)?.contact_webhook_url || import.meta.env.PUBLIC_FORMS_WEBHOOK || siteConfig.formsWebhookUrl;

// Build structured data for SEO
const seoTitle = contactPage?.seo_title || "Contact Simply Enak";
const seoDescription = contactPage?.seo_description || "Get in touch with Simply Enak. WhatsApp, email, or call us to book a food tour in Kuala Lumpur or Penang.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: seoTitle,
  description: seoDescription,
};

const heroSection = {
  title: contactPage?.hero_title,
  highlight: contactPage?.hero_highlight,
  description: contactPage?.hero_subtitle,
};

const getInTouchSection = {
  title: contactPage?.get_in_touch_title,
  contents: contactPage?.get_in_touch_contents,
  formEmbedUrl: "",
};

// Planning scenarios from content JSON
const planningScenarios = contactPage?.planning_scenarios || [];

// Why Reach Out cards from content JSON
const whyReachOut = contactPage?.why_reach_out || [];

// Our Promise section
const ourPromise = contactPage?.our_promise || null;

// Get contact-relevant FAQs
const contactFaqs = await getContactFAQs(lang);

async function getContactFAQs(lang: string) {
  const faqsData = (await import("@/data/content/faqs.json")).default;
  const targetIds = [9, 10, 19, 22, 14];
  const faqs = faqsData
    .filter((f: any) => targetIds.includes(f.id))
    .sort((a: any, b: any) => targetIds.indexOf(a.id) - targetIds.indexOf(b.id))
    .map((f: any) => {
      const t = (f.translations || []).find((t: any) => t.languages_code === lang)
             || (f.translations || []).find((t: any) => t.languages_code === "en");
      if (!t) return { question: f.question, answer: f.answer };
      return {
        question: t.question || f.question,
        answer: t.answer ?? f.answer,
      };
    });
  return faqs;
}

// Contact method details
const whatsappUrl = `https://wa.me/${siteConfig.whatsappDigits}`;
const phoneUrl = `tel:${siteConfig.phone.replace(/\s/g, "")}`;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  structuredData={structuredData}
  hreflangPath="/contact/"
>
  {/* 1. HERO */}
  <GlobalHero
    title={heroSection.title}
    highlight={heroSection.highlight}
    description={heroSection.description}
  />

  {/* 2. CONTACT METHOD CARDS */}
  <Section animate={true}>
    <div class="text-center mb-12 max-w-2xl mx-auto scroll-animate">
      <h2 class="text-h2 text-primary">How Can We Help?</h2>
      <p class="text-body mt-4">Choose the easiest way to reach us. We read every message.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      {/* WhatsApp Card */}
      <div class="scroll-animate">
        <Card class="text-center h-full flex flex-col">
          <div class="w-14 h-14 mx-auto mb-4 text-[#25D366] min-w-[56px] min-h-[56px] flex items-center justify-center">
            <Icon name="icon-whatsapp" class="w-full h-full" />
          </div>
          <h3 class="text-h3 text-primary mb-1">Chat with us</h3>
          <p class="text-body text-gray-600 mb-2">Fastest response</p>
          <p class="text-body font-medium text-gray-800 mb-6">{siteConfig.phone}</p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-lg hover:bg-[#1da851] transition-colors"
            aria-label="Open WhatsApp chat"
          >
            <Icon name="icon-whatsapp" class="w-5 h-5" />
            Open WhatsApp
          </a>
        </Card>
      </div>

      {/* Email Card */}
      <div class="scroll-animate" style="transition-delay: 100ms">
        <Card class="text-center h-full flex flex-col">
          <div class="w-14 h-14 mx-auto mb-4 text-secondary min-w-[56px] min-h-[56px] flex items-center justify-center">
            <Icon name="icon-envelope" class="w-full h-full" />
          </div>
          <h3 class="text-h3 text-primary mb-1">Send us an email</h3>
          <p class="text-body text-gray-600 mb-2">For detailed plans</p>
          <p class="text-body font-medium text-gray-800 mb-6">{siteConfig.email}</p>
          <button
            id="copy-email-btn"
            data-email={settings?.contact_email || siteConfig.email}
            class="mt-auto inline-flex items-center justify-center gap-2 bg-primary text-white font-semibold px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors cursor-pointer"
            aria-label="Copy email address"
          >
            <Icon name="icon-envelope" class="w-5 h-5" />
            <span id="copy-email-text">Copy email</span>
          </button>
        </Card>
      </div>

      {/* Phone Card */}
      <div class="scroll-animate" style="transition-delay: 200ms">
        <Card class="text-center h-full flex flex-col">
          <div class="w-14 h-14 mx-auto mb-4 text-primary min-w-[56px] min-h-[56px] flex items-center justify-center">
            <Icon name="icon-phone" class="w-full h-full" />
          </div>
          <h3 class="text-h3 text-primary mb-1">Call us</h3>
          <p class="text-body text-gray-600 mb-2">For urgent queries</p>
          <p class="text-body font-medium text-gray-800 mb-6">{siteConfig.phone}</p>
          <a
            href={phoneUrl}
            class="mt-auto inline-flex items-center justify-center gap-2 bg-dark text-white font-semibold px-6 py-3 rounded-lg hover:bg-gray-800 transition-colors"
            aria-label="Call us now"
          >
            <Icon name="icon-phone" class="w-5 h-5" />
            Call now
          </a>
        </Card>
      </div>
    </div>
  </Section>

  {/* 3. PLANNING SCENARIOS */}
  {planningScenarios.length > 0 && (
    <Section variant="light" animate={true}>
      <div class="text-center mb-12 max-w-2xl mx-auto scroll-animate">
        <h2 class="text-h2 text-primary">Whatever Stage You're At</h2>
        <p class="text-body mt-4">We've helped guests at every stage — from "just browsing" to "we land tomorrow."</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {planningScenarios.map((scenario: any, i: number) => (
          <div class="scroll-animate" style={`transition-delay: ${i * 100}ms`}>
            <Card class="text-center h-full">
              <div class="w-12 h-12 mx-auto mb-4 text-secondary min-w-[48px] min-h-[48px] flex items-center justify-center">
                <Icon name={scenario.icon || "icon-compass"} class="w-full h-full" />
              </div>
              <h3 class="text-h4 text-primary mb-2">{scenario.title}</h3>
              <p class="text-body text-gray-600 text-sm">{scenario.description}</p>
            </Card>
          </div>
        ))}
      </div>
    </Section>
  )}

  {/* 4. WHY REACH OUT */}
  {whyReachOut.length > 0 && (
    <Section animate={true}>
      <div class="text-center mb-12 max-w-2xl mx-auto scroll-animate">
        <h2 class="text-h2 text-primary">Good Reasons to Get in Touch</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {whyReachOut.map((item: any, i: number) => (
          <div class="scroll-animate text-center" style={`transition-delay: ${i * 100}ms`}>
            <div class="w-14 h-14 mx-auto mb-4 bg-cream rounded-full flex items-center justify-center min-w-[56px] min-h-[56px]">
              <Icon name={item.icon || "icon-message-circle"} class="w-7 h-7 text-primary" />
            </div>
            <h3 class="text-h4 text-primary mb-2">{item.title}</h3>
            <p class="text-body text-gray-600">{item.description}</p>
          </div>
        ))}
      </div>
    </Section>
  )}

  {/* 5. OUR PROMISE + FORM */}
  <Section variant="light" animate={true}>
    {ourPromise && (
      <div class="text-center mb-12 max-w-2xl mx-auto scroll-animate">
        <h2 class="text-h2 text-primary mb-4">{ourPromise.title}</h2>
        <p class="text-body text-lg text-gray-700 mb-6">{ourPromise.description}</p>
        {Array.isArray(ourPromise.highlights) && ourPromise.highlights.length > 0 && (
          <ul class="text-left max-w-md mx-auto space-y-3">
            {ourPromise.highlights.map((h: string) => (
              <li class="flex items-start gap-3">
                <span class="text-secondary mt-1 flex-shrink-0">
                  <Icon name="icon-check" class="w-5 h-5" />
                </span>
                <span class="text-body text-gray-700">{h}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    )}
    <GetInTouchSection
      title={getInTouchSection.title}
      contents={getInTouchSection.contents}
      webhookUrl={webhookUrl}
    />
  </Section>

  {/* 6. QUICK FAQ */}
  <Section animate={true}>
    <div class="text-center mb-12 scroll-animate">
      <h2 class="text-h2 text-primary">Common Questions</h2>
    </div>
    <div class="max-w-3xl mx-auto space-y-4">
      {contactFaqs.map((faq: any) => (
        <details class="group bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden scroll-animate">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-lg text-gray-900 hover:bg-gray-50 transition-colors">
            <span>{faq.question}</span>
            <Icon name="icon-chevron-down" class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0 ml-4" />
          </summary>
          <div class="px-6 pb-6">
            <p class="text-body leading-relaxed" set:html={faq.answer} />
          </div>
        </details>
      ))}
    </div>
    <div class="text-center mt-10">
      <a
        href="/faq/"
        class="text-body font-semibold text-primary hover:underline inline-flex items-center gap-2"
      >
        <Icon name="icon-arrow-right" class="w-4 h-4" />
        See all questions
      </a>
    </div>
  </Section>

  {/* 7. CTA */}
  <CTASection />
</Layout>

<script define:vars={{ contactEmail: settings?.contact_email || siteConfig.email }}>
  // Copy email functionality
  const btn = document.getElementById("copy-email-btn");
  const textEl = document.getElementById("copy-email-text");
  if (btn && textEl) {
  const email = btn.dataset.email || contactEmail;
  btn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(email);
      textEl.textContent = "Copied!";
      setTimeout(() => { textEl.textContent = "Copy email"; }, 2000);
    } catch {
      window.location.href = "mailto:" + email;
    }
  });
  }
</script>
