---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import { getHowItWorksPage } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";

export const prerender = true;

// Get language from URL
const lang = getLangFromUrl(Astro.url);

// Fetch how it works page content from Payload
const page = await getHowItWorksPage(lang);

// Tour formats (private vs join-in cards) — from JSON
const tourTypes = Array.isArray(page?.formats) && page.formats.length > 0 ? page.formats : [];

// Inclusions list — JSON has [{ id, item }] structure
const inclusions = Array.isArray(page?.inclusions)
  ? page.inclusions.map((inc: any) => (typeof inc === 'string' ? inc : inc.item)).filter(Boolean)
  : [];

// Steps / process list — JSON has [{ id, number, title, detail }] structure
const steps = Array.isArray(page?.steps) && page.steps.length > 0
  ? page.steps.map((s: any) => ({ n: s.n ?? s.number ?? s.id, title: s.title, detail: s.detail }))
  : [];
---

<Layout
  title={page?.seo_title}
  description={page?.seo_description}
  hreflangPath="/how-it-works/"

>
  <GlobalHero
    title={page?.hero_title}
    highlight={page?.hero_highlight}
    subtitle={page?.hero_subtitle}
  />

  <!-- Breadcrumb -->
  <Section variant="light" spacing="compact">
    <nav class="flex items-center text-sm text-gray-600 max-w-4xl mx-auto" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-primary font-medium">How It Works</span>
    </nav>
  </Section>

  <!-- Two ways to tour -->
  <Section variant="light">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        {page?.formats_title && <h2 class="text-h2 text-primary">{page.formats_title}</h2>}
        {page?.formats_subtitle && (
          <p class="text-body mt-3 max-w-2xl mx-auto">
            {page.formats_subtitle}
          </p>
        )}
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {tourTypes.map((tt) => (
          <Card href={tt.href} variant="featured">
            <div class="text-3xl mb-4">{tt.emoji}</div>
            <h3 class="text-h3 text-primary mb-3">{tt.heading}</h3>
            <ul class="space-y-2 text-sm text-gray-600 mb-4">
              {tt.features.map((feature: string) => (
                <li class="flex items-start gap-2">
                  <span class="text-primary font-bold flex-shrink-0">✓</span> {feature}
                </li>
              ))}
            </ul>
            <span class="text-primary font-semibold text-sm">{tt.cta_text}</span>
          </Card>
        ))}
      </div>
    </div>
  </Section>

  <!-- What every tour includes -->
  <Section>
    <div class="max-w-4xl mx-auto">
      {page?.inclusions_title && <h2 class="text-h2 text-primary text-center mb-10">{page.inclusions_title}</h2>}
      <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        {inclusions.map((item: string) => (
          <div class="flex items-center gap-3 bg-white border border-gray-100 rounded-xl p-4 shadow-sm">
            <span class="w-7 h-7 flex-shrink-0 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">✓</span>
            <span class="text-sm text-gray-700">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- From booking to the last bite -->
  <Section variant="light">
    <div class="max-w-3xl mx-auto">
      {page?.steps_section_title && <h2 class="text-h2 text-primary text-center mb-10">{page.steps_section_title}</h2>}
      <ol class="space-y-6">
        {steps.map((step) => (
          <li class="flex gap-5">
            <div class="w-9 h-9 flex-shrink-0 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">
              {step.n}
            </div>
            <div class="pt-1">
              <h3 class="text-h4 text-primary mb-1">{step.title}</h3>
              <p class="text-sm text-gray-600">{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- Practical info link -->
  <Section>
    <div class="max-w-2xl mx-auto text-center">
      {page?.practical_title && <h2 class="text-h2 text-primary mb-4">{page.practical_title}</h2>}
      {page?.practical_body && (
        <p class="text-body text-gray-600 mb-8">
          {page.practical_body}
        </p>
      )}
      {page?.practical_cta_text && page?.practical_cta_href && (
        <a
          href={page.practical_cta_href}
          class="cta-primary"
        >
          {page.practical_cta_text}
        </a>
      )}
    </div>
  </Section>

  <CTASection />
</Layout>
