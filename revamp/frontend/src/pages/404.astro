---
import Layout from "@/layouts/Layout.astro";
import { getAllTours } from "@/lib/content";
import { siteConfig } from "@/lib/site-config";

const tours = await getAllTours();

const popularPages = [
  { label: "All Tours", url: "/tours/", desc: "Browse all our food tours" },
  { label: "Contact Us", url: "/contact/", desc: "Book, ask, or plan your trip" },
  { label: "Stories", url: "/stories/", desc: "Malaysian food culture & guides" },
  { label: "Directions", url: "/directions/", desc: "Find your meeting point" },
  { label: "About Simply Enak", url: "/about/", desc: "Who we are and why we do this" },
  { label: "Prepare for Your Tour", url: "/how-to-prepare/", desc: "What to wear, bring, expect" },
];
---

<Layout
  title="Page Not Found | Simply Enak"
  description="Sorry, we couldn't find that page. See our Malaysian food tours or get in touch."
  noindex={true}
>
  <div class="bg-gradient-to-br from-amber-50 to-orange-50 py-20 md:py-28">
    <div class="main-container text-center">

      <div class="text-7xl mb-6">🍜</div>

      <h1 class="text-4xl md:text-5xl font-merriweather font-bold text-gray-900 mb-4">
        Lost in the hawker market?
      </h1>

      <p class="text-lg text-gray-600 mb-8 max-w-xl mx-auto">
        We can't find that page — it may have moved or never existed. Here are some good places to start.
      </p>

      <!-- Primary CTAs -->
      <div class="flex flex-wrap gap-4 justify-center mb-16">
        <a
          href="/tours/"
          class="bg-primary text-white px-7 py-3 rounded-full font-semibold hover:bg-primary/90 transition"
        >
          Browse Our Tours
        </a>
        <a
          href="/contact/"
          class="border-2 border-primary text-primary px-7 py-3 rounded-full font-semibold hover:bg-primary hover:text-white transition"
        >
          Ask Us Anything
        </a>
      </div>

    </div>
  </div>

  <!-- All Tours -->
  {tours.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="main-container">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 text-center mb-8">
          Our food tours
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {tours.map((tour: any) => (
            <a
              href={`/tours/${tour.slug}/`}
              class="group bg-white rounded-2xl shadow-sm border border-gray-100 p-5 hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col"
            >
              <div class="text-xs font-semibold uppercase tracking-wide text-secondary mb-2">
                {tour.location}
              </div>
              <h2 class="font-bold text-gray-900 mb-1 group-hover:text-primary transition-colors leading-snug">
                {tour.name}
              </h2>
              <p class="text-xs text-gray-500 mb-3 flex-grow">{tour.tagline}</p>
              <div class="flex items-center justify-between">
                <span class="text-primary font-bold text-sm">{tour.currency || 'MYR'} {tour.price}</span>
                <span class="text-xs text-gray-400">{tour.duration}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Popular pages -->
  <section class="py-12 bg-cream">
    <div class="main-container">
      <p class="text-xs font-bold uppercase tracking-widest text-gray-400 text-center mb-8">
        Popular pages
      </p>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {popularPages.map((page) => (
          <a
            href={page.url}
            class="bg-white rounded-xl border border-gray-100 px-5 py-4 hover:border-primary hover:shadow-sm transition-all group"
          >
            <div class="font-semibold text-gray-900 group-hover:text-primary transition-colors">{page.label}</div>
            <div class="text-xs text-gray-500 mt-0.5">{page.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Friendly fallback -->
  <section class="py-12 text-center">
    <div class="main-container">
      <p class="text-gray-600 mb-2">Still can't find what you're looking for?</p>
      <a href={`https://wa.me/${siteConfig.whatsappDigits}`} class="text-primary font-semibold hover:underline">
        WhatsApp us directly → {siteConfig.phone}
      </a>
    </div>
  </section>

</Layout>
