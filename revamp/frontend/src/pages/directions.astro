---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import { getAllTours, getDirectionsPage } from "@/lib/content";
import { siteConfig } from "@/lib/site-config";
import { getLangFromUrl } from "@/i18n/utils";

export const prerender = true;

const lang = getLangFromUrl(Astro.url);
const [allTours, page] = await Promise.all([
  getAllTours({}, lang),
  getDirectionsPage(lang),
]);
const toursWithDirections = allTours.filter((t: any) => t.directions_html);

// Group by city for the quick-jump nav
const kl = toursWithDirections.filter((t: any) => t.location?.includes("Kuala Lumpur"));
const penang = toursWithDirections.filter((t: any) => t.location?.includes("Penang") || t.location?.includes("George Town"));
---

<Layout
  title={page?.seo_title}
  description={page?.seo_description}
  hreflangPath="/directions/"

>
  <GlobalHero
    title={page?.hero_title}
    highlight={page?.hero_highlight}
    description={page?.hero_description}
    image={page?.hero_image ?? undefined}
  />

  <!-- Quick jump nav -->
  <div class="sticky top-0 z-20 bg-white border-b border-gray-100 shadow-sm">
    <div class="main-container flex gap-2 py-3 overflow-x-auto">
      {page?.jump_to_label && <span class="text-sm font-medium text-gray-500 mr-2 whitespace-nowrap self-center">{page.jump_to_label}</span>}
      {toursWithDirections.map((tour: any) => (
        <a
          href={`#tour-${tour.slug}`}
          class="text-sm whitespace-nowrap px-3 py-1.5 rounded-full border border-gray-200 text-gray-700 hover:border-primary hover:text-primary transition-colors"
        >
          {tour.name}
        </a>
      ))}
    </div>
  </div>

  <!-- Intro -->
  {page?.intro_text && (
    <Section spacing="compact">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-body">{page.intro_text}</p>
      </div>
    </Section>
  )}

  <!-- Tour directions -->
  {toursWithDirections.map((tour: any, i: number) => (
    <Section id={`tour-${tour.slug}`} variant={i % 2 === 0 ? "default" : "light"}>
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row gap-10 items-start">

          <!-- Text side -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-xs font-semibold uppercase tracking-widest text-secondary">
                {tour.location}
              </span>
            </div>
            <h2 class="text-h2 text-primary mb-2">{tour.name}</h2>
            <p class="text-sm text-gray-500 mb-4">
              Meeting point: <strong class="text-gray-700">{tour.meeting_point}</strong>
            </p>

            <div
              class="prose prose-gray max-w-none text-gray-700 leading-relaxed
                     [&_p]:mb-3 [&_strong]:text-gray-900 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1"
              set:html={tour.directions_html}
            />

            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href={`/tours/${tour.slug}/`}
                class="inline-flex items-center gap-2 bg-primary text-white px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-primary/90 transition"
              >
                {page?.tour_details_btn}
              </a>
              {page?.ask_question_btn && (
                <a
                  href="/contact/"
                  class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 px-5 py-2.5 rounded-full text-sm font-semibold hover:border-primary hover:text-primary transition"
                >
                  {page.ask_question_btn}
                </a>
              )}
            </div>
          </div>

          <!-- Image side -->
          {tour.meeting_point_image_url && (
            <div class="w-full md:w-72 flex-shrink-0">
              <img
                src={tour.meeting_point_image_url}
                alt={`Meeting point for ${tour.name}`}
                class="w-full rounded-2xl shadow-md object-cover aspect-[4/3]"
                loading="lazy"
                width={576}
                height={432}
              />
            </div>
          )}
        </div>
      </div>
    </Section>
  ))}

  <!-- General tips -->
  {page?.tips_heading && (
    <Section variant="dark">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-h2 mb-8">{page.tips_heading}</h2>
        <div class="grid sm:grid-cols-3 gap-6 text-left">
          {page?.tip_1_heading && (
            <div class="bg-white/10 rounded-xl p-5">
              {page.tip_1_emoji && <div class="text-2xl mb-3">{page.tip_1_emoji}</div>}
              <h3 class="font-bold mb-2">{page.tip_1_heading}</h3>
              {page.tip_1_body && <p class="text-sm text-gray-300">{page.tip_1_body}</p>}
            </div>
          )}
          {page?.tip_2_heading && (
            <div class="bg-white/10 rounded-xl p-5">
              {page.tip_2_emoji && <div class="text-2xl mb-3">{page.tip_2_emoji}</div>}
              <h3 class="font-bold mb-2">{page.tip_2_heading}</h3>
              {page.tip_2_body && <p class="text-sm text-gray-300">{page.tip_2_body}</p>}
            </div>
          )}
          {page?.tip_3_heading && (
            <div class="bg-white/10 rounded-xl p-5">
              {page.tip_3_emoji && <div class="text-2xl mb-3">{page.tip_3_emoji}</div>}
              <h3 class="font-bold mb-2">{page.tip_3_heading}</h3>
              {page.tip_3_body && (
                <p class="text-sm text-gray-300">
                  {page.tip_3_body} <a href={`https://wa.me/${siteConfig.whatsappDigits}`} class="underline">{siteConfig.phone}</a>
                </p>
              )}
            </div>
          )}
        </div>
      </div>
    </Section>
  )}

  <CTASection />
</Layout>
