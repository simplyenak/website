---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import SocialProof from "@/components/SocialProof.astro";
import siteSettingsData from "@/data/content/site-settings.json";

const durianSeasons = [
  {
    season: "Main Season",
    months: "June - August",
    peak: "Mid-June to Mid-July",
    description: "The biggest durian season. Prices drop, variety increases, and every stall has multiple varieties. This is when Musang King floods the market.",
  },
  {
    season: "Off Season",
    months: "December - January",
    peak: "Late December",
    description: "Smaller season but still excellent quality. Fewer varieties available, but prices are lower than main season. Perfect for avoiding crowds.",
  },
];

const durianVarieties = [
  {
    name: "Musang King (Mao Shan Wang)",
    chinese: "猫山王",
    price: "RM 80-150/kg",
    taste: "Bitter-sweet, creamy, intense",
    description: "The king of durians. Bright yellow flesh, bitter-sweet taste, creamy texture. Look for the star-shaped pattern on the shell.",
  },
  {
    name: "D24",
    chinese: "苏丹王",
    price: "RM 40-70/kg",
    taste: "Sweet, mild, less creamy",
    description: "The people's durian. More affordable, sweeter, less intense than Musang King. Great for first-timers.",
  },
  {
    name: "Red Prawn (Ang Heh)",
    chinese: "红虾",
    price: "RM 50-80/kg",
    taste: "Sweet, fruity, orange-red flesh",
    description: "Named for its reddish flesh. Sweeter than Musang King, with a fruity aroma. Popular during main season.",
  },
  {
    name: "Black Thorn",
    chinese: "黑刺",
    price: "RM 150-250/kg",
    taste: "Complex, bitter-sweet, rare",
    description: "Rarer and more expensive than Musang King. Small seed, thick flesh, complex flavor profile. For serious durian lovers.",
  },
  {
    name: "Hor Lor",
    chinese: "葫芦",
    price: "RM 30-50/kg",
    taste: "Mild, sweet, watery",
    description: "Budget-friendly, mild taste. Good for beginners who find Musang King too strong.",
  },
];

const whereToBuy = [
  {
    location: "Chow Kit Market, KL",
    bestFor: "Variety and local prices",
    when: "Daily, 8am-6pm (best in morning)",
    tip: "Arrive early for best selection. Bargaining is expected.",
  },
  {
    location: "Jalan Alor, KL",
    bestFor: "Tourist-friendly, late night",
    when: "Evening, 6pm-2am",
    tip: "More expensive than Chow Kit, but convenient for tourists.",
  },
  {
    location: "Air Itam, Penang",
    bestFor: "Penang durian during season",
    when: "June-August, daily",
    tip: "Famous durian hill. Drive up for the full experience.",
  },
  {
    location: "SS2 Petaling Jaya, KL",
    bestFor: "Musang King specialists",
    when: "Season only, 10am-10pm",
    tip: "Multiple stalls competing on quality. Taste before buying.",
  },
];

const durianEtiquette = [
  {
    rule: "Don't bring durian on public transport",
    why: "Banned on LRT, MRT, buses, and airplanes due to smell",
  },
  {
    rule: "Don't eat durian in hotels",
    why: "Most Malaysian hotels ban durians. Fines up to RM 500.",
  },
  {
    rule: "Use the stem to smell",
    why: "Smell the stem, not the shell. Fresh durian has a fragrant stem.",
  },
  {
    rule: "Press the shell gently",
    why: "Ripe durian gives slightly when pressed. Too soft = overripe.",
  },
  {
    rule: "Listen for the thud",
    why: "Shake gently. A slight thud means the flesh has separated = ripe.",
  },
  {
    rule: "Drink water after eating",
    why: "Malaysians believe durian is 'heaty'. Drink water from the shell.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Complete Guide to Durian Season in Malaysia",
  description: "When is durian season in Malaysia? What varieties should you try? Where to buy durian in KL and Penang? Complete guide from Simply Enak.",
  datePublished: "2026-03-30",
  dateModified: "2026-03-30",
  author: {
    "@type": "Organization",
    name: "Simply Enak",
  },
  mainEntity: {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "When is durian season in Malaysia?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Main durian season is June-August, with peak in mid-June to mid-July. There's also a smaller off-season in December-January. During main season, prices drop and variety increases dramatically.",
        },
      },
      {
        "@type": "Question",
        name: "What is the best durian variety?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Musang King (Mao Shan Wang) is considered the king of durians - bitter-sweet, creamy, intense. For beginners, D24 is sweeter and milder. Black Thorn is rarer and more expensive, for serious durian lovers.",
        },
      },
      {
        "@type": "Question",
        name: "Where can I buy durian in Kuala Lumpur?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Chow Kit Market has the best variety and local prices (go early morning). Jalan Alor is tourist-friendly and open late. SS2 Petaling Jaya has Musang King specialists. Prices range from RM 30-250/kg depending on variety.",
        },
      },
      {
        "@type": "Question",
        name: "Why is durian banned in hotels and public transport?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Durian's strong smell lingers for days. Malaysian hotels ban durians with fines up to RM 500. LRT, MRT, buses, and airplanes also prohibit durians. Eat at designated stalls or outdoor areas.",
        },
      },
      {
        "@type": "Question",
        name: "How do I choose a ripe durian?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Smell the stem (should be fragrant), press the shell gently (should give slightly), shake gently (listen for a slight thud = flesh separated). Avoid cracked shells or sour smell.",
        },
      },
    ],
  },
};
---

<Layout
  title="Complete Guide to Durian Season in Malaysia | Simply Enak"
  description="When is durian season? What varieties should you try? Where to buy durian in KL and Penang? Complete guide from Simply Enak's 14 years of experience."
  structuredData={structuredData}
  hreflangPath="/stories/durian-guide/"
>
  <GlobalHero
    title="The Complete Guide to Durian in Malaysia"
    subtitle="Seasons, varieties, where to buy, and how not to offend locals"
  />

  <SocialProof variant="compact" />

  <!-- Durian Seasons -->
  <Section variant="light" animate={true}>
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        When Is Durian Season in Malaysia?
      </h2>
      <p class="text-gray-700 mb-12 text-center max-w-2xl mx-auto">
        Malaysia has two durian seasons. The main season (June-August) is when durian floods the market and prices drop. The off-season (December-January) is smaller but still excellent.
      </p>

      <div class="grid md:grid-cols-2 gap-8">
        {durianSeasons.map((season) => (
          <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-orange-500">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{season.season}</h3>
            <p class="text-orange-600 font-semibold mb-4">{season.months}</p>
            <p class="text-gray-700 mb-3">{season.description}</p>
            {season.peak && (
              <p class="text-sm text-gray-500">
                <strong>Peak:</strong> {season.peak}
              </p>
            )}
          </div>
        ))}
      </div>

      <div class="mt-8 bg-orange-50 border border-orange-200 rounded-lg p-6">
        <h4 class="font-semibold text-gray-900 mb-2">💡 Pro Tip</h4>
        <p class="text-gray-700">
          Visit during <strong>mid-June to mid-July</strong> for the best durian experience. Prices are lowest, variety is highest, and every stall has multiple varieties to taste. Some vendors let you taste before buying during peak season.
        </p>
      </div>
    </div>
  </Section>

  <!-- Durian Varieties -->
  <Section variant="white" animate={true}>
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        Durian Varieties: Which One Should You Try?
      </h2>
      <p class="text-gray-700 mb-12 text-center max-w-2xl mx-auto">
        There are over 100 durian varieties in Malaysia. These are the most common ones you'll find at stalls. Prices vary by season and quality.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-lg shadow-md overflow-hidden">
          <thead class="bg-orange-600 text-white">
            <tr>
              <th class="px-6 py-4 text-left font-semibold">Variety</th>
              <th class="px-6 py-4 text-left font-semibold">Chinese</th>
              <th class="px-6 py-4 text-left font-semibold">Price</th>
              <th class="px-6 py-4 text-left font-semibold">Taste</th>
              <th class="px-6 py-4 text-left font-semibold">Best For</th>
            </tr>
          </thead>
          <tbody>
            {durianVarieties.map((variety, index) => (
              <tr class={index % 2 === 0 ? "bg-gray-50" : "bg-white"}>
                <td class="px-6 py-4 font-semibold text-gray-900">{variety.name}</td>
                <td class="px-6 py-4 text-gray-700">{variety.chinese}</td>
                <td class="px-6 py-4 text-gray-700">{variety.price}</td>
                <td class="px-6 py-4 text-gray-700">{variety.taste}</td>
                <td class="px-6 py-4 text-gray-700">{variety.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 grid md:grid-cols-2 gap-6">
        <div class="bg-green-50 border border-green-200 rounded-lg p-6">
          <h4 class="font-semibold text-gray-900 mb-2">👑 For First-Timers</h4>
          <p class="text-gray-700">
            Start with <strong>D24</strong> or <strong>Hor Lor</strong>. They're sweeter, milder, and more affordable. If you love it, upgrade to Musang King.
          </p>
        </div>
        <div class="bg-purple-50 border border-purple-200 rounded-lg p-6">
          <h4 class="font-semibold text-gray-900 mb-2">💎 For Durian Lovers</h4>
          <p class="text-gray-700">
            Go for <strong>Musang King</strong> or <strong>Black Thorn</strong>. Complex bitter-sweet flavor, creamy texture, unforgettable experience.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Where to Buy -->
  <Section variant="light" animate={true}>
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        Where to Buy Durian in KL & Penang
      </h2>
      <p class="text-gray-700 mb-12 text-center max-w-2xl mx-auto">
        Durian is sold at dedicated stalls, markets, and roadside stands during season. Prices range from RM 30-250/kg depending on variety and season.
      </p>

      <div class="grid md:grid-cols-2 gap-8">
        {whereToBuy.map((place, index) => (
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{place.location}</h3>
            <p class="text-orange-600 font-semibold mb-4 text-sm">{place.bestFor}</p>
            <p class="text-gray-700 mb-2"><strong>When:</strong> {place.when}</p>
            <p class="text-gray-700"><strong>Tip:</strong> {place.tip}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Durian Etiquette -->
  <Section variant="white" animate={true}>
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        Durian Etiquette: Don't Make These Mistakes
      </h2>
      <p class="text-gray-700 mb-12 text-center max-w-2xl mx-auto">
        Durian is beloved but controversial. Follow these rules to avoid offending locals and getting fined.
      </p>

      <div class="space-y-4">
        {durianEtiquette.map((rule, index) => (
          <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-red-500">
            <h4 class="font-semibold text-gray-900 mb-2">❌ {rule.rule}</h4>
            <p class="text-gray-700">{rule.why}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
        <h4 class="font-semibold text-gray-900 mb-2">💡 Malaysian Belief: Durian is "Heaty"</h4>
        <p class="text-gray-700 mb-3">
          Malaysians believe durian is a "heaty" food that raises body temperature. Traditional remedy: drink water from the durian shell, or eat mangosteen (a "cooling" fruit).
        </p>
        <p class="text-gray-700">
          Don't eat durian if you have high blood pressure, and don't mix durian with alcohol (believed to cause digestive issues).
        </p>
      </div>
    </div>
  </Section>

  <!-- How to Eat Durian -->
  <Section variant="light" animate={true}>
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        How to Eat Durian: A Step-by-Step Guide
      </h2>

      <div class="space-y-6">
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold">1</div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Find the Seams</h3>
              <p class="text-gray-700">Durian has natural seams running from stem to bottom. Look for the lines where the shell segments meet.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold">2</div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Cut Along the Seams</h3>
              <p class="text-gray-700">Use a sharp knife to cut along the seams. Don't stab the durian — follow the natural lines. The shell is thick and tough.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold">3</div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Open the Shell</h3>
              <p class="text-gray-700">Once you've cut all seams, pry the shell open with your hands. Wear gloves if you have them — the spikes are sharp.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold">4</div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Remove the Flesh</h3>
              <p class="text-gray-700">Use a spoon or your hands to remove the flesh pods. Each pod has a seed in the middle. Don't eat the seed raw (it's toxic).</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold">5</div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Eat Immediately</h3>
              <p class="text-gray-700">Durian is best eaten fresh. The smell intensifies as it sits. Store leftovers in an airtight container in the fridge (max 2 days).</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Durian on Our Tours -->
  <Section variant="white" animate={true}>
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">
        Try Durian on Our Food Tours
      </h2>
      <p class="text-gray-700 mb-12 max-w-2xl mx-auto">
        We include durian tastings on our tours during season (June-August). Your guide will explain the varieties, help you choose, and share the cultural stories behind Malaysia's most controversial fruit.
      </p>

      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <a href="/tours/kuala-lumpur-street-food/" class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
          <h3 class="font-semibold text-gray-900 mb-2">KL Street Food Tour</h3>
          <p class="text-gray-700 text-sm">Chinatown durian stalls</p>
          <p class="text-orange-600 text-sm mt-2">From RM {siteSettingsData?.tour_price ?? 285}</p>
        </a>
        <a href="/tours/penang-street-food/" class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
          <h3 class="font-semibold text-gray-900 mb-2">Penang Street Food</h3>
          <p class="text-gray-700 text-sm">Air Itam durian hill</p>
          <p class="text-orange-600 text-sm mt-2">From RM {siteSettingsData?.tour_price ?? 285}</p>
        </a>
        <a href="/tours/vegetarian-food-tour-around-kuala-lumpur/" class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
          <h3 class="font-semibold text-gray-900 mb-2">Vegetarian Tour</h3>
          <p class="text-gray-700 text-sm">Durian is plant-based!</p>
          <p class="text-orange-600 text-sm mt-2">From RM {siteSettingsData?.tour_price ?? 289}</p>
        </a>
      </div>

      <a href="/tours/" class="inline-block px-8 py-4 bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-lg transition-colors">
        View All Our Tours
      </a>
    </div>
  </Section>

  <CTASection />
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .scroll-animate {
    animation: fadeInUp 0.6s ease-out forwards;
  }
</style>
