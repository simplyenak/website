---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import Section from "@/components/Design/Section.astro";
import Badge from "@/components/Design/Badge.astro";
import Button from "@/components/Button.astro";
import { getAllStories, getSiteSettings, getStoriesIndexPage } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";
import { siteConfig } from "@/lib/site-config";

export const prerender = true;

const lang = getLangFromUrl(Astro.url);
const [allStories, settings, page] = await Promise.all([
  getAllStories(),
  getSiteSettings(),
  getStoriesIndexPage(lang),
]);
// Exclude placeholder stubs (content too short to be a real article)
const MIN_CONTENT_CHARS = 500;
const substantialStories = allStories.filter(
  (s) => (s._contentText?.trim().length ?? 0) >= MIN_CONTENT_CHARS
);
const featuredStory = substantialStories[0];
const remainingStories = substantialStories.slice(1);

// Format date for display
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// Filter stories for each section — filter from remainingStories so the
// featured story (allStories[0]) does not appear again in the category grids.
const vendorStories = remainingStories.filter((s) =>
  s.categories.includes("People & Stories")
);
const expertStories = remainingStories.filter(
  (s) =>
    s.categories.includes("Food Culture") || s.categories.includes("Travel Tips")
);
const cultureStories = remainingStories.filter((s) =>
  s.categories.includes("Culture & Heritage")
);
const valuesStories = remainingStories.filter((s) =>
  s.categories.includes("Our Values")
);
---

<Layout
  title={page?.seo_title}
  description={page?.seo_description}
  image={page?.seo_image}
  hreflangPath="/stories/"

>
  <!-- Hero Section -->
  <GlobalHero
    title={page?.hero_title}
    highlight={page?.hero_highlight}
    subtitle={page?.hero_subtitle}
    image={page?.hero_image ?? undefined}
  />

  <!-- Sticky breadcrumb + category nav — anchored below the sticky header -->
  <div class="sticky top-[72px] md:top-[88px] z-40 bg-white border-b border-gray-100 shadow-sm">
    <div class="main-container flex items-center gap-3 py-2">

      <!-- Breadcrumb trail (hidden on very small screens) -->
      <nav
        aria-label="Breadcrumb"
        class="hidden sm:flex items-center gap-1.5 text-xs text-gray-400 shrink-0 pr-4 border-r border-gray-200"
      >
        <a href="/" class="hover:text-primary transition-colors whitespace-nowrap">{page?.breadcrumb_home}</a>
        <svg class="w-3 h-3 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-gray-700 font-semibold whitespace-nowrap">{page?.breadcrumb_current}</span>
      </nav>

      <!-- Category pills -->
      <nav
        class="flex items-center gap-1 md:gap-2 overflow-x-auto whitespace-nowrap scrollbar-hide flex-1"
        aria-label="Story categories"
      >
        <a
          href="#vendor-stories"
          class="text-xs md:text-sm font-semibold text-gray-600 hover:text-primary hover:bg-orange-50 px-3 py-1.5 rounded-full transition-all"
        >
          {page?.nav_vendor_stories}
        </a>
        <span class="text-gray-300 text-xs select-none">·</span>
        <a
          href="#insider-expertise"
          class="text-xs md:text-sm font-semibold text-gray-600 hover:text-primary hover:bg-orange-50 px-3 py-1.5 rounded-full transition-all"
        >
          {page?.nav_insider_expertise}
        </a>
        <span class="text-gray-300 text-xs select-none">·</span>
        <a
          href="#culture"
          class="text-xs md:text-sm font-semibold text-gray-600 hover:text-primary hover:bg-orange-50 px-3 py-1.5 rounded-full transition-all"
        >
          {page?.nav_culture_heritage}
        </a>
        <span class="text-gray-300 text-xs select-none">·</span>
        <a
          href="#our-values"
          class="text-xs md:text-sm font-semibold text-gray-600 hover:text-primary hover:bg-orange-50 px-3 py-1.5 rounded-full transition-all"
        >
          {page?.nav_our_values}
        </a>
      </nav>

    </div>
  </div>

  <!-- Featured Story -->
  {featuredStory && (
    <Section>
      <a href={`/stories/${featuredStory.slug}/`} class="group grid md:grid-cols-2 gap-8 items-center no-underline">
        {featuredStory.hero_image && (
          <div class="rounded-xl overflow-hidden h-64 md:h-80">
            <img
              src={featuredStory.hero_image}
              alt={featuredStory.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="eager"
              width={800}
              height={500}
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        )}
        <div>
          {featuredStory.categories?.[0] && <Badge>{featuredStory.categories[0]}</Badge>}
          <h2 class="text-h2 text-primary mt-3 mb-3 leading-snug group-hover:text-orange transition-colors">
            {featuredStory.title}
          </h2>
          {featuredStory.excerpt && (
            <p class="text-gray-600 leading-relaxed mb-4">
              {featuredStory.excerpt}
            </p>
          )}
          {page?.featured_story_cta && <span class="text-primary font-semibold text-sm group-hover:underline">{page.featured_story_cta}</span>}
        </div>
      </a>
    </Section>
  )}

  <!-- Section 1: Meet the Heritage Keepers (Vendor Stories) -->
  <Section variant="light" id="vendor-stories">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        {page?.section_vendor_eyebrow && <p class="text-eyebrow text-orange mb-2">{page.section_vendor_eyebrow}</p>}
        {page?.section_vendor_heading && <h2 class="text-h2 text-primary mb-4">{page.section_vendor_heading}</h2>}
        {page?.section_vendor_body && <p class="text-body">{page.section_vendor_body}</p>}
      </div>
      {page?.section_vendor_view_all && (
        <Button
          href="/stories/archive/?filter=People+%26+Stories"
          title={page.section_vendor_view_all}
          buttonType="secondary-btn-small"
          class="hidden md:inline-flex"
        />
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[300px]">
      {
        vendorStories.slice(0, 5).map((story, index) => (
          <a
            href={`/stories/${story.slug}/`}
            class:list={[
              "group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1",
              index === 0
                ? "md:col-span-2 md:row-span-2"
                : "col-span-1 row-span-1",
            ]}
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={story.hero_image}
                alt={story.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <div class="absolute top-6 left-6">
                {page?.section_vendor_badge && (
                  <Badge
                    variant={index === 0 ? "accent" : "secondary"}
                    size={index === 0 ? "medium" : "small"}
                  >
                    {page.section_vendor_badge}
                  </Badge>
                )}
              </div>

              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3
                  class:list={[
                    "font-bold font-merriweather mb-2 leading-tight",
                    index === 0 ? "text-3xl md:text-4xl" : "text-xl",
                  ]}
                >
                  {story.title}
                </h3>

                {index === 0 && (
                  <p class="text-gray-200 mb-4 line-clamp-2 text-lg max-w-xl">
                    {story.excerpt}
                  </p>
                )}

                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-gray-300 font-medium uppercase tracking-wider">
                    {formatDate(story.published_at ?? '')}
                  </span>
                  <div class="flex items-center gap-2 text-orange font-bold uppercase tracking-wider text-xs opacity-60 group-hover:opacity-100 transition-opacity duration-300">
                    <span>{page?.section_vendor_cta}</span>
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Section 2: Insider Expertise -->
  <Section id="insider-expertise">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        {page?.section_insider_eyebrow && <p class="text-eyebrow text-orange mb-2">{page.section_insider_eyebrow}</p>}
        {page?.section_insider_heading && <h2 class="text-h2 text-primary mb-4">{page.section_insider_heading}</h2>}
        {page?.section_insider_body && <p class="text-body">{page.section_insider_body}</p>}
      </div>
      {page?.section_insider_view_all && (
        <Button
          href="/stories/archive/"
          title={page.section_insider_view_all}
          buttonType="secondary-btn-small"
          class="hidden md:inline-flex"
        />
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[300px]">
      {
        expertStories.slice(0, 3).map((story, index) => (
          <a
            href={`/stories/${story.slug}/`}
            class:list={[
              "group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1",
              index === 0
                ? "md:col-span-2 md:row-span-2"
                : "col-span-1 row-span-1",
            ]}
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={story.hero_image}
                alt={story.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <div class="absolute top-6 left-6">
                {page?.section_insider_badge && <Badge variant="secondary" size="small">{page.section_insider_badge}</Badge>}
              </div>

              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3
                  class:list={[
                    "font-bold font-merriweather mb-2 leading-tight",
                    index === 0 ? "text-3xl md:text-4xl" : "text-xl",
                  ]}
                >
                  {story.title}
                </h3>

                {index === 0 && (
                  <p class="text-gray-200 mb-4 line-clamp-2 text-lg max-w-xl">
                    {story.excerpt}
                  </p>
                )}

                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-gray-300 font-medium uppercase tracking-wider">
                    {formatDate(story.published_at ?? '')}
                  </span>
                  <div class="flex items-center gap-2 text-orange font-bold uppercase tracking-wider text-xs opacity-60 group-hover:opacity-100 transition-opacity duration-300">
                    <span>{page?.section_insider_cta}</span>
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Section 3: Malaysian Culture 101 -->
  <Section variant="accent" id="culture">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        {page?.section_culture_eyebrow && <p class="text-eyebrow text-orange mb-2">{page.section_culture_eyebrow}</p>}
        {page?.section_culture_heading && <h2 class="text-h2 text-primary mb-4">{page.section_culture_heading}</h2>}
        {page?.section_culture_body && <p class="text-body">{page.section_culture_body}</p>}
      </div>
      {page?.section_culture_view_all && (
        <Button
          href="/stories/archive/?filter=Culture+%26+Heritage"
          title={page.section_culture_view_all}
          buttonType="secondary-btn-small"
          class="hidden md:inline-flex"
        />
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 auto-rows-[300px]">
      {
        cultureStories.slice(0, 2).map((story) => (
          <a
            href={`/stories/${story.slug}/`}
            class="group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={story.hero_image}
                alt={story.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <div class="absolute top-6 left-6">
                {page?.section_culture_badge && <Badge variant="accent" size="small">{page.section_culture_badge}</Badge>}
              </div>

              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3 class="text-h4 mb-2">
                  {story.title}
                </h3>

                <p class="text-gray-200 mb-4 line-clamp-2 text-sm">
                  {story.excerpt}
                </p>

                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-gray-300 font-medium uppercase tracking-wider">
                    {formatDate(story.published_at ?? '')}
                  </span>
                  <div class="flex items-center gap-2 text-orange font-bold uppercase tracking-wider text-xs opacity-60 group-hover:opacity-100 transition-opacity duration-300">
                    <span>{page?.section_culture_cta}</span>
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Our Values Stories -->
  {valuesStories.length > 0 && (
    <Section id="our-values">
      <div class="max-w-4xl mx-auto text-center mb-12">
        {page?.section_values_eyebrow && <p class="text-orange text-sm font-bold uppercase tracking-widest mb-3">{page.section_values_eyebrow}</p>}
        {page?.section_values_heading && <h2 class="text-h2 text-primary mb-4">{page.section_values_heading}</h2>}
        {page?.section_values_body && <p class="text-body text-gray-700">{page.section_values_body}</p>}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {
          valuesStories.slice(0, 4).map((story) => (
            <a
              href={`/stories/${story.slug}/`}
              class="group flex gap-4 p-4 rounded-xl border border-gray-100 hover:border-primary hover:shadow-md transition-all bg-white"
            >
              {story.hero_image && (
                <img
                  src={story.hero_image}
                  alt={story.title}
                  class="w-24 h-24 rounded-lg object-cover flex-shrink-0"
                  width={96}
                  height={96}
                  loading="lazy"
                />
              )}
              <div class="min-w-0 flex-1">
                <h3 class="text-h5 text-gray-900 group-hover:text-primary transition-colors mb-1">{story.title}</h3>
                <p class="text-sm text-gray-600 line-clamp-2">{story.excerpt}</p>
                {page?.section_values_cta && <span class="text-xs text-primary font-semibold mt-2 inline-block">{page.section_values_cta}</span>}
              </div>
            </a>
          ))
        }
      </div>
    </Section>
  )}

  <!-- Newsletter / CTA -->
  <Section variant="dark">
    <div class="max-w-2xl mx-auto text-center">
      {page?.newsletter_eyebrow && <p class="text-orange text-sm font-bold uppercase tracking-widest mb-3">{page.newsletter_eyebrow}</p>}
      {page?.newsletter_heading && <h2 class="text-h2 text-white mb-4">{page.newsletter_heading}</h2>}
      {page?.newsletter_body && <p class="text-gray-300 text-body mb-8">{page.newsletter_body}</p>}
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" novalidate>
        <!-- Honeypot: hidden from real users, bots fill this in -->
        <div style="position:absolute;left:-9999px;top:-9999px;opacity:0;visibility:hidden;" aria-hidden="true">
          <label for="newsletter-hp">Leave this blank</label>
          <input type="text" id="newsletter-hp" name="honeypot_website" tabindex="-1" autocomplete="off" />
        </div>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          placeholder={page?.newsletter_placeholder}
          required
          class="px-4 py-3 rounded-lg border border-white/20 bg-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange flex-grow"
        />
        <button
          id="newsletter-submit"
          type="submit"
          class="bg-orange text-black px-6 py-3 rounded-lg font-bold hover:bg-orange/90 transition-colors whitespace-nowrap disabled:opacity-60 disabled:cursor-not-allowed"
        >
          {page?.newsletter_submit}
        </button>
      </form>
      <p id="newsletter-message" class="hidden mt-4 text-sm font-medium"></p>
      <p class="text-xs text-gray-400 mt-3">We'll send you stories about Malaysian food and culture. Unsubscribe any time. <a href="/privacy-policy/" class="underline hover:text-white transition-colors">Privacy Policy</a>.</p>
    </div>
  </Section>

  <script define:vars={{
    MSG_SUCCESS: page?.newsletter_success,
    MSG_ERROR_EMAIL: page?.newsletter_error_email,
    MSG_ERROR_CONFIG: page?.newsletter_error_config,
    MSG_SUBMITTING: page?.newsletter_submitting,
    MSG_ERROR_GENERIC: page?.newsletter_error_generic,
    MSG_SUBMIT_LABEL: page?.newsletter_submit,
    NEWSLETTER_WEBHOOK: import.meta.env.PUBLIC_FORMS_WEBHOOK || siteConfig.formsWebhookUrl,
  }}>

    const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
    const emailInput = document.getElementById("newsletter-email") as HTMLInputElement | null;
    const submitBtn = document.getElementById("newsletter-submit") as HTMLButtonElement | null;
    const messageEl = document.getElementById("newsletter-message") as HTMLElement | null;

    function showMessage(text: string, isError: boolean) {
      if (!messageEl) return;
      messageEl.textContent = text;
      messageEl.className = isError
        ? "mt-4 text-sm font-medium text-red-300"
        : "mt-4 text-sm font-medium text-green-300";
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() ?? "";
      const honeypot = (document.getElementById("newsletter-hp") as HTMLInputElement)?.value;

      // Silently drop if honeypot filled
      if (honeypot) { form.reset(); showMessage(MSG_SUCCESS, false); return; }

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showMessage(MSG_ERROR_EMAIL, true);
        return;
      }

      if (!NEWSLETTER_WEBHOOK) {
        showMessage(MSG_ERROR_CONFIG, true);
        return;
      }

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = MSG_SUBMITTING || submitBtn.textContent; }

      try {
        const res = await fetch(NEWSLETTER_WEBHOOK, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            honeypot_website: honeypot,
            submittedAt: new Date().toISOString(),
            source: window.location.href,
          }),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        form.reset();
        showMessage(MSG_SUCCESS, false);
      } catch (err) {
        console.error("Newsletter error:", err);
        showMessage(MSG_ERROR_GENERIC || "Something went wrong. Please try again.", true);
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = MSG_SUBMIT_LABEL || submitBtn.textContent; }
      }
    });
  </script>

  <style>
    /* Hide scrollbar for navigation */
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</Layout>
