---
import Layout from "../layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import Badge from "@/components/Design/Badge.astro";
import { getTrackRecordPage } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";

export const prerender = true;

const lang = getLangFromUrl(Astro.url);
const page = await getTrackRecordPage(lang);

const stats: { number: string; label: string }[] = Array.isArray(page.stats) ? page.stats : [];
const segments: { num: string; emoji: string; name: string; description: string; anchor: string }[] = Array.isArray(page.segments) ? page.segments : [];
const caseStudies: { id: string; segmentLabel: string; variant: string; headline: string; challenge: string; whatWeDid: string; outcome: string; quote: string; attribution: string }[] = Array.isArray(page.case_studies) ? page.case_studies : [];
const press: { outlet: string; description: string; year: string }[] = Array.isArray(page.press) ? page.press : [];
const awards: { year: string; label: string }[] = Array.isArray(page.awards) ? page.awards : [];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Simply Enak Track Record",
    description: "14 years of food tours across five distinct groups of guests.",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Simply Enak Awards",
    itemListElement: awards.map((a, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${a.label} ${a.year}`,
      url: "https://www.tripadvisor.com",
    })),
  },
];
---

<Layout
  title={page.seo_title}
  description={page.seo_description}
  structuredData={schema}
  hreflangPath="/track-record/"

>
  <!-- Hero -->
  <GlobalHero
    title={page.hero_title}
    highlight={page.hero_highlight}
    subtitle={page.hero_subtitle}
  />

  <!-- Stats Bar -->
  <Section variant="light" spacing="compact">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {
        stats.map((stat) => (
          <div class="text-center border-t-4 border-primary/25 pt-6">
            <div class="text-4xl md:text-5xl font-bold text-primary mb-2 font-merriweather">
              {stat.number}
            </div>
            <div class="text-body text-gray-600">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Unscripted philosophy -->
  <Section variant="light" spacing="compact">
    <div class="text-center max-w-2xl mx-auto">
      {page?.how_we_work_eyebrow && <p class="text-eyebrow text-orange mb-3">{page.how_we_work_eyebrow}</p>}
      {page?.philosophy_quote && (
        <p class="font-merriweather italic text-gray-700 text-lg leading-relaxed">
          "{page.philosophy_quote}"
        </p>
      )}
    </div>
  </Section>

  <!-- Segment Overview -->
  <Section>
    <div class="text-center mb-12 max-w-3xl mx-auto">
      {page?.segments_heading && <h2 class="text-h2 text-primary">{page.segments_heading}</h2>}
      {page?.segments_body && (
        <p class="text-body mt-4 text-gray-600">
          {page.segments_body}
        </p>
      )}
    </div>
    <div class="grid md:grid-cols-3 lg:grid-cols-5 gap-6">
      {
        segments.map((seg) => (
          <a href={seg.anchor} class="block h-full no-underline">
            <Card class="text-center h-full hover:shadow-lg transition-shadow cursor-pointer">
              <div class="text-3xl font-bold text-primary/20 font-merriweather mb-2">{seg.num}</div>
              <div class="text-3xl mb-3">{seg.emoji}</div>
              <h3 class="text-sm font-bold text-primary mb-2 leading-snug">{seg.name}</h3>
              <p class="text-xs text-gray-500 leading-relaxed">{seg.description}</p>
            </Card>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Case Studies -->
  {
    caseStudies.map((cs) => (
      <Section id={cs.id} variant={cs.variant}>
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <!-- Left: Case Study -->
          <div>
            <Badge variant="primary" size="small" class="mb-4">
              {cs.segmentLabel}
            </Badge>
            <h2 class="text-h2 text-primary mt-3 mb-6">{cs.headline}</h2>
            <div class="space-y-4">
              <div>
                {page?.case_study_challenge_label && (
                <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-2">
                  {page.case_study_challenge_label}
                </h3>
              )}
                <p class="text-body text-gray-700">{cs.challenge}</p>
              </div>
              <div>
                {page?.case_study_what_we_did_label && (
                  <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-2">
                    {page.case_study_what_we_did_label}
                  </h3>
                )}
                <p class="text-body text-gray-700">{cs.whatWeDid}</p>
              </div>
              <p class="text-sm font-semibold text-primary border-l-4 border-primary/30 pl-4 py-1 mt-4">
                {cs.outcome}
              </p>
            </div>
          </div>

          <!-- Right: Pull Quote -->
          <div class="md:pt-16">
            <Card variant="featured">
              <div class="text-6xl font-merriweather text-primary/30 leading-none mb-4 select-none">
                &ldquo;
              </div>
              <p class="text-body italic text-gray-700 leading-relaxed mb-6">{cs.quote}</p>
              <p class="text-sm font-semibold text-primary">— {cs.attribution}</p>
            </Card>
          </div>
        </div>
      </Section>
    ))
  }

  <!-- Press & Recognition -->
  <Section variant="light">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      {page?.press_heading && <h2 class="text-h2 text-primary">{page.press_heading}</h2>}
      {page?.press_body && (
        <p class="text-body mt-4 text-gray-600">
          {page.press_body}
        </p>
      )}
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        press.map((item) => (
          <Card>
            <div class="flex items-start justify-between mb-3">
              <span class="text-base font-bold text-primary">{item.outlet}</span>
              <Badge variant="outline" size="small">
                {item.year}
              </Badge>
            </div>
            <p class="text-body text-gray-600 text-sm leading-relaxed">{item.description}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Awards -->
  <Section>
    <div class="text-center mb-10 max-w-3xl mx-auto">
      <h2 class="text-h2 text-primary">TripAdvisor Travellers' Choice</h2>
      <p class="text-body mt-4 text-gray-600">
        Awarded six times by travellers who shared their experience on TripAdvisor — including a gap year and a return in 2023.
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-4">
      {awards.map((award) => (
        <div class="flex flex-col items-center justify-center w-28 h-28 rounded-full border-2 border-[#00AF87]/40 bg-[#00AF87]/5 shadow-sm">
          <span class="text-[#00AF87] text-xl font-bold font-merriweather">{award.year}</span>
          <span class="text-[9px] uppercase tracking-[0.15em] text-gray-500 text-center mt-1 px-2 leading-tight">Travellers'<br/>Choice</span>
        </div>
      ))}
    </div>
  </Section>

  <CTASection />
</Layout>
