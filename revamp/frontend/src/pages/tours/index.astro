</style>

<script>
  const NAV_SECTION_IDS = ['tours', 'private', 'city', 'dietary', 'specialty', 'travel-style', 'custom', 'experiences']

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')

  function setActive(id: string) {
    navLinks.forEach((link) => {
      const isActive = link.dataset.navLink === id
      link.classList.toggle('is-active', isActive)
    })
  }

  // Activate first section by default
  setActive('tours')

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          setActive(entry.target.id)
          break
        }
      }
    },
    // Trigger when a section's top edge crosses the 30% mark from the top
    { rootMargin: '-30% 0px -65% 0px' }
  )

  NAV_SECTION_IDS.forEach((id) => {
    const el = document.getElementById(id)
    if (el) observer.observe(el)
  })
</script>
