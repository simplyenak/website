---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Design/Section.astro";
import Button from "@/components/Button.astro";
import Badge from "@/components/Design/Badge.astro";
import FAQ from "@/components/FAQ.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import TourQuiz from "@/components/Tours/TourQuiz.astro";
import TestimonialCarousel from "@/components/Tours/TestimonialCarousel.astro";
import { getAllTours, getAllSpecialtyLandingPages, getAllTravelTypeLandingPages, getAllLocationLandingPages, getAllDietaryLandingPages, getImageUrl, getToursIndexPage, getFAQsForPage, getMainTourSlugs } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";
import { siteConfig } from "@/lib/site-config";
import toursIndexContent from "@/data/content/tours-index-page.json";
import siteSettingsData from "@/data/content/site-settings.json";

export const prerender = true;

// Static JSON content — translation-safe fallbacks for all hardcoded strings
const tip = toursIndexContent;

// Get language from URL
const lang = getLangFromUrl(Astro.url);

// Fetch all data from Payload
const [allTours, specialtyPages, travelTypePages, locationPages, dietaryPages, toursIndexPage, pageFaqs] = await Promise.all([
  getAllTours(),
  getAllSpecialtyLandingPages(),
  getAllTravelTypeLandingPages(),
  getAllLocationLandingPages(),
  getAllDietaryLandingPages(),
  getToursIndexPage(lang),
  getFAQsForPage('tours', lang),
]);

// Use Payload content or fallback to JSON defaults
const hero = {
  title: toursIndexPage?.hero_title ?? tip.hero_title,
  subtitle: toursIndexPage?.hero_subtitle ?? tip.hero_subtitle,
  description: toursIndexPage?.hero_description ?? tip.hero_description,
  backgroundImage: toursIndexPage?.hero_background_image ?? tip.hero_background_image,
};

// Specialty pages split: experience-type (shown in Specialty section) vs
// audience-type (corporate/celebrations/custom — shown in Custom & Group section)
const AUDIENCE_SPECIALTY_SLUGS = ['corporate', 'celebrations', 'custom', 'tailored'];
const experienceSpecialtyPages = specialtyPages.filter(
  (s: any) => !AUDIENCE_SPECIALTY_SLUGS.includes(s.slug)
);

// Fallback images for segments without hero_image in Payload
const specialtyFallbackImages: Record<string, string> = {
  'street-food': 'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
  'cultural':    'https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg',
  'heritage':    'https://se-website-images.s3.nl-ams.scw.cloud/story-heritage.jpg',
  'multi-day':   'https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg',
  'chefs':        'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
  'corporate':    'https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg',
  'celebrations': 'https://se-website-images.s3.nl-ams.scw.cloud/hari-raya-foods.jpg',
  'custom':       'https://se-website-images.s3.nl-ams.scw.cloud/story-heritage.jpg',
  'night-tour':   'https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg',
  'market-tour':  'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
};
const travelTypeFallbackImages: Record<string, string> = {
  'family':        'https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg',
  'family-friendly': 'https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg',
  'adults-only':     'https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg',
  'couples':         'https://se-website-images.s3.nl-ams.scw.cloud/penang-heritage-tour.jpg',
  'solo':            'https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg',
  'solo-traveler':   'https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg',
  'foodie':          'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
  'foodies':         'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
  'first-timers':    'https://se-website-images.s3.nl-ams.scw.cloud/story-heritage.jpg',
};

const dietaryFallbackImages: Record<string, string> = {
  'halal':            'https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg',
  'gluten-free':      'https://se-website-images.s3.nl-ams.scw.cloud/story-heritage.jpg',
  'vegan':            'https://se-website-images.s3.nl-ams.scw.cloud/dietary-adaptations.jpg',
  'jain':             'https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg',
  'shellfish-allergy':'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
  'nut-allergy':      'https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg',
  'dairy-free':       'https://se-website-images.s3.nl-ams.scw.cloud/hari-raya-foods.jpg',
  'vegetarian':       'https://se-website-images.s3.nl-ams.scw.cloud/dietary-adaptations.jpg',
};

const locationFallbackImages: Record<string, string> = {
  'penang':         'https://se-website-images.s3.nl-ams.scw.cloud/penang-heritage-tour.jpg',
  'kuala-lumpur':   'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
};

// Location-based segments — data-driven from location-landing-pages.json
const locationSegments = locationPages.map((loc: any) => ({
  name: loc.location_name,
  slug: `/tours/locations/${loc.slug}/`,
  shortDescription: loc.hero_subtitle,
  fullDescription: loc.hero_description,
  image: loc.hero_image || locationFallbackImages[loc.slug] || '',
  available: true,
  badge: loc.badge ?? undefined,
}));

// Dietary preference segments — data-driven + static catchall card
const dietarySegments = [
  ...dietaryPages.map((d: any) => ({
    name: d.dietary_name,
    slug: `/tours/dietary/${d.slug}/`,
    shortDescription: d.hero_subtitle,
    fullDescription: d.hero_description,
    image: d.hero_image || dietaryFallbackImages[d.slug] || '',
    available: true,
    badge: d.badge ?? undefined,
  })),
  {
    name: tip.dietary_catchall_name,
    slug: tip.dietary_catchall_slug,
    shortDescription: tip.dietary_catchall_short_description,
    fullDescription: tip.dietary_catchall_full_description,
    image: tip.dietary_catchall_image,
    available: true,
  },
];

// Group & custom segments — driven from JSON content file
const groupSegments = Array.isArray(tip.group_segments)
  ? tip.group_segments.map((s: any) => ({
      name: s.name,
      slug: s.slug,
      shortDescription: s.short_description,
      fullDescription: s.full_description,
      image: s.image,
      available: true,
    }))
  : [
      {
        name: "Family Adventures",
        slug: "/tours/travel-types/family-friendly/",
        shortDescription: "Kid-friendly food, parent-approved experiences",
        fullDescription:
          "Traveling with children? We get it. We adapt dishes for young palates, pace the tour for small legs, and make sure everyone learns something.",
        image: "https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg",
        available: true,
      },
      {
        name: "Corporate Team Building",
        slug: "/tours/specialty/corporate/",
        shortDescription: "Bonding over food, not trust falls",
        fullDescription:
          "Want your team to actually connect? Walk through hawker markets together. Learn to spot fresh ingredients. Debate whether char kway teow is better in Penang or KL.",
        image: "https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg",
        available: true,
      },
      {
        name: "Special Celebrations",
        slug: "/tours/specialty/celebrations/",
        shortDescription: "Birthdays, anniversaries, reunions",
        fullDescription:
          "Celebrate milestones the Malaysian way: surrounded by food, family, and stories. We'll create an experience that matches the occasion.",
        image: "https://se-website-images.s3.nl-ams.scw.cloud/hari-raya-foods.jpg",
        available: true,
      },
      {
        name: "Tailored Experiences",
        slug: "/tours/specialty/custom/",
        shortDescription: "Your vision, our local knowledge",
        fullDescription:
          "Have specific interests? Want to combine cities? Need multi-day experiences? We'll design a tour that exists nowhere else.",
        image: "https://se-website-images.s3.nl-ams.scw.cloud/story-heritage.jpg",
        available: true,
      },
    ];

// FAQ data from Payload, falling back to JSON content file
const faqs = pageFaqs.length > 0
  ? pageFaqs
  : (Array.isArray(tip.fallback_faqs) ? tip.fallback_faqs : [
      {
        question: "How do I decide which tour is right for me?",
        answer:
          "Start with location—which city interests you? Then consider your dietary needs and group type. If you're solo or a couple, join our regular tours. Families and groups of 6+ benefit from custom experiences. Still unsure? Contact us—we love helping people find their perfect Malaysian food adventure.",
      },
      {
        question: "What if I have dietary restrictions?",
        answer:
          "Every tour can be adapted. Vegetarian, vegan, halal, gluten-free, allergies—just tell us when booking. Our dedicated vegetarian heritage tours follow Malaysia's 140-year plant-based tradition. For other dietary needs, we work with vendors who can accommodate while maintaining local flavours.",
      },
    ]);

const mainTourSlugs = getMainTourSlugs();
const PRIORITY_SLUGS = mainTourSlugs;

// Bento grid caps — prevent sections from growing unwieldy as content is added
const DIETARY_CAP = 6;
const SPECIALTY_CAP = 6;
const TRAVEL_CAP = 6;

const dietaryVisible = dietarySegments.slice(0, DIETARY_CAP);
const dietaryOverflow = dietarySegments.length > DIETARY_CAP;
const specialtyVisible = experienceSpecialtyPages.slice(0, SPECIALTY_CAP);
const specialtyOverflow = experienceSpecialtyPages.length > SPECIALTY_CAP;
const travelVisible = travelTypePages.slice(0, TRAVEL_CAP);
const travelOverflow = travelTypePages.length > TRAVEL_CAP;
const realTours = allTours
  .filter((t: any) => PRIORITY_SLUGS.includes(t.slug))
  .sort((a: any, b: any) => PRIORITY_SLUGS.indexOf(a.slug) - PRIORITY_SLUGS.indexOf(b.slug));

const schemaTours = allTours.filter((t: any) => !t.noindex);

const TOUR_BADGES: Record<string, { label: string; color: string }> = {
  'eat-drink-george-town': { label: 'Most Popular', color: 'bg-amber-500' },
  'kuala-lumpur-street-food': { label: 'Guest Favourite', color: 'bg-orange-500' },
  'secrets-of-kl-nightlife-street-art-and-cocktails': { label: 'Evening Tour', color: 'bg-purple-600' },
};

// SEO data — driven from JSON content file with string fallbacks
const seoData = {
  title: toursIndexPage?.seo_title ?? tip.seo_title,
  description: toursIndexPage?.seo_description ?? tip.seo_description,
  image: hero.backgroundImage,
  structuredData: [
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "Simply Enak Food Tours",
      description:
        "Malaysian food and cultural experiences by location, dietary preference, and group type",
      url: "https://simplyenak.com/tours/",
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Simply Enak Food Tours",
      url: "https://simplyenak.com/tours/",
      numberOfItems: schemaTours.length,
      itemListElement: schemaTours.map((t: any, i: number) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "TouristTrip",
          name: t.name,
          url: `https://simplyenak.com/tours/${t.slug}/`,
          description: t.short_description ?? t.tagline,
          image: t.hero_image,
          offers: t.price ? {
            "@type": "Offer",
            price: String(t.price),
            priceCurrency: t.currency,
          } : undefined,
        },
      })),
    },
    {
      "@context": "https://schema.org",
      "@type": "TourOperator",
      "@id": "https://simplyenak.com/#business",
      name: "Local Culinary Travel Experiences Sdn. Bhd.",
      url: "https://simplyenak.com/",
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "4.9",
        reviewCount: String(siteSettingsData.review_count ?? 5000),
        bestRating: "5",
        worstRating: "1",
      },
    },
  ],
};
---

<Layout
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  structuredData={seoData.structuredData}
  hreflangPath="/tours/"
 
>
  <GlobalHero
    title={hero.title}
    highlight={toursIndexPage?.hero_highlight ?? tip.hero_highlight}
    subtitle={hero.subtitle}
    image={hero.backgroundImage}
    ctaPrimary={{ text: toursIndexPage?.hero_cta_primary ?? tip.hero_cta_primary, href: "/tours/private-tours/" }}
    ctaSecondary={{ text: toursIndexPage?.hero_cta_secondary ?? tip.hero_cta_secondary, href: "#tours" }}
  />

  <!-- Two Ways to Experience Malaysia -->
  <Section variant="light" id="private">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <p class="text-eyebrow text-orange mb-2">Your Choice</p>
      <h2 class="text-h2 text-primary mb-4">Two Ways to Experience Malaysia</h2>
      <p class="text-body max-w-2xl mx-auto">
        A tour built entirely around your group, or a seat at our table with fellow food lovers. Both will change how you see Malaysia. One is personal.
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- Private Tour Card -->
      <a href="/tours/private-tours/" class="group block bg-white rounded-2xl border-2 border-primary/20 shadow-lg hover:border-orange hover:shadow-xl transition-all duration-300 overflow-hidden">
        <div class="p-8 flex flex-col h-full">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-xl bg-orange/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a4.902 4.902 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-xs font-bold uppercase tracking-widest text-orange">Recommended</span>
          </div>
          <h3 class="text-h3 text-gray-900 mb-2 group-hover:text-orange transition-colors">Your Own Private Tour</h3>
          <p class="text-sm text-gray-600 mb-6 flex-1 leading-relaxed">
            Your guide. Your group. Your pace. Tell us what matters — dietary needs, interests, schedule — and we build a route around you. From just 2 people.
          </p>
          <ul class="space-y-2 text-sm text-gray-500 mb-6">
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> Route designed for your group only</li>
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> Dietary needs briefed in advance, not as afterthought</li>
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> Pre-tour WhatsApp planning call</li>
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> Start time that works for you</li>
          </ul>
          <div class="flex items-center gap-2 text-primary font-semibold group-hover:text-orange transition-colors">
            <span>Plan Your Tour</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>
      <!-- Join-In Tour Card -->
      <a href="/tours/join-in-tours/" class="group block bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden">
        <div class="p-8 flex flex-col h-full">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a4.902 4.902 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-xs font-bold uppercase tracking-widest text-gray-400">Shared Group</span>
          </div>
          <h3 class="text-h3 text-gray-900 mb-2 group-hover:text-primary transition-colors">Join a Small Group</h3>
          <p class="text-sm text-gray-600 mb-6 flex-1 leading-relaxed">
            Book a spot on one of our scheduled tours. Max 12 guests, small enough to feel personal. Great for solo travellers and couples.
          </p>
          <ul class="space-y-2 text-sm text-gray-500 mb-6">
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> From RM 285 per person</li>
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> Max 12 guests — never a crowd</li>
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> Book instantly online</li>
            <li class="flex items-start gap-2"><span class="text-green-600 font-bold">✓</span> Meet fellow travellers</li>
          </ul>
          <div class="flex items-center gap-2 text-primary font-semibold group-hover:text-primary transition-colors">
            <span>See Join-In Tours</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>
    </div>
  </Section>

  <!-- Category Navigation -->
  <div
    class="sticky top-[72px] md:top-[88px] z-40 bg-white border-b border-gray-200 shadow-md transition-all duration-300"
  >
    <div class="max-w-4xl mx-auto px-4">
      <nav
        class="flex items-center gap-2 overflow-x-auto py-3 scrollbar-hide"
        aria-label="Tours page sections"
      >
        <a
          href="#tours"
          data-nav-link="tours"
          class="inline-flex items-center px-5 py-3 min-h-[48px] text-[15px] md:text-base font-bold rounded-full whitespace-nowrap transition-all
                 text-gray-600 hover:text-primary hover:bg-primary/5
                 is-active:text-primary is-active:bg-primary/10"
        >
          {toursIndexPage?.nav_all ?? tip.nav_all}
        </a>
        <a
          href="#private"
          data-nav-link="private"
          class="inline-flex items-center px-5 py-3 min-h-[48px] text-[15px] md:text-base font-bold rounded-full whitespace-nowrap transition-all
                 text-gray-600 hover:text-primary hover:bg-primary/5
                 is-active:text-primary is-active:bg-primary/10"
        >
          {toursIndexPage?.nav_private ?? tip.nav_private}
        </a>
        <a
          href="#city"
          data-nav-link="city"
          class="inline-flex items-center px-5 py-3 min-h-[48px] text-[15px] md:text-base font-bold rounded-full whitespace-nowrap transition-all
                 text-gray-600 hover:text-primary hover:bg-primary/5
                 is-active:text-primary is-active:bg-primary/10"
        >
          {toursIndexPage?.nav_by_city ?? tip.nav_by_city}
        </a>
        <a
          href="#dietary"
          data-nav-link="dietary"
          class="inline-flex items-center px-5 py-3 min-h-[48px] text-[15px] md:text-base font-bold rounded-full whitespace-nowrap transition-all
                 text-gray-600 hover:text-primary hover:bg-primary/5
                 is-active:text-primary is-active:bg-primary/10"
        >
          {toursIndexPage?.nav_dietary ?? tip.nav_dietary}
        </a>
        <a
          href="#specialty"
          data-nav-link="specialty"
          class="inline-flex items-center px-5 py-3 min-h-[48px] text-[15px] md:text-base font-bold rounded-full whitespace-nowrap transition-all
                 text-gray-600 hover:text-primary hover:bg-primary/5
                 is-active:text-primary is-active:bg-primary/10"
        >
          {toursIndexPage?.nav_specialty ?? tip.nav_specialty}
        </a>
        <a
          href="#travel-style"
          data-nav-link="travel-style"
          class="inline-flex items-center px-5 py-3 min-h-[48px] text-[15px] md:text-base font-bold rounded-full whitespace-nowrap transition-all
                 text-gray-600 hover:text-primary hover:bg-primary/5
                 is-active:text-primary is-active:bg-primary/10"
        >
          {toursIndexPage?.nav_travel_style ?? tip.nav_travel_style}
        </a>
        <a
          href="#custom"
          data-nav-link="custom"
          class="inline-flex items-center px-5 py-3 min-h-[48px] text-[15px] md:text-base font-bold rounded-full whitespace-nowrap transition-all
                 text-gray-600 hover:text-primary hover:bg-primary/5
                 is-active:text-primary is-active:bg-primary/10"
        >
          {toursIndexPage?.nav_custom ?? tip.nav_custom}
        </a>
      </nav>
    </div>
  </div>

  <!-- Featured Tours — Main 5 Tours Only -->
  <Section id="tours">
    <div class="flex justify-between items-end mb-10">
      <div class="max-w-2xl">
        <p class="text-h6 tracking-[0.25em] text-orange font-bold mb-2">{toursIndexPage?.signature_tours_eyebrow ?? tip.signature_tours_eyebrow}</p>
        <h2 class="text-h2 text-primary mb-3">{toursIndexPage?.signature_tours_heading ?? tip.signature_tours_heading}</h2>
        <p class="text-body">
          {toursIndexPage?.signature_tours_subtext ?? tip.signature_tours_subtext}
        </p>
      </div>
      {(toursIndexPage?.browse_by_city_btn ?? tip.browse_by_city_btn) && <Button href="#city" title={toursIndexPage?.browse_by_city_btn ?? tip.browse_by_city_btn} buttonType="secondary-btn" />}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        realTours.map((tour: any, index) => (
          <a
            href={`/tours/${tour.slug}/`}
            class="group block"
            aria-label={`View details for ${tour.name}: ${tour.tagline || tour.location} food tour`}
          >
            <div class="bg-white rounded-xl sm:rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 h-full flex flex-col">
              {tour.hero_image ? (
                <div class="overflow-hidden h-48 sm:h-52 flex-shrink-0 relative">
                  <img
                    src={getImageUrl(tour.hero_image, { width: 600, height: 420 }) ?? tour.hero_image}
                    alt={tour.name}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                  {TOUR_BADGES[tour.slug] && (
                    <div class={`absolute top-3 left-3 z-10 ${TOUR_BADGES[tour.slug]!.color} text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-sm`}>
