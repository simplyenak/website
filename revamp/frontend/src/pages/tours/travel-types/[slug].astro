---
/**
 * Travel Type Landing Page (Audience segments)
 * URL: /tours/travel-types/[slug]
 * Example: /tours/travel-types/family-friendly
 */

import SegmentPage from '@/components/Segments/SegmentPage.astro';
import { getTravelTypeLandingPageBySlug, getAllTravelTypeLandingPages, getToursByTravelType } from '@/lib/content';
import { markdownToHtml } from '@/lib/markdown-to-html';
import segmentChips from '@/data/content/segment-chips.json';

export const prerender = true;

export async function getStaticPaths() {
  const pages = await getAllTravelTypeLandingPages();
  return pages.map((page: any) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
const page = await getTravelTypeLandingPageBySlug(slug as string);

if (!page) return Astro.redirect('/404');

// Combine why_perfect + expect + tips into editorial
const editorialParts = [];
if (page.why_perfect_content) editorialParts.push(page.why_perfect_content);
if (page.expect_content) editorialParts.push(page.expect_content);
if (page.tips_content) editorialParts.push(page.tips_content);
const editorialRaw = editorialParts.join('\n\n');
const editorialHtml = editorialRaw ? await markdownToHtml(editorialRaw) : '';
const tours = await getToursByTravelType(slug as string);

const reviews = page.reviews || [];
const faq = page.faq || [];
const relatedSegments = page.related_segments || [];

const hasUniqueContent = (page.hero_description && page.hero_description.length > 100) || !!(page.why_perfect_content || page.expect_content || page.tips_content);
const noindex = false; // Segment pages are content marketing hubs — always indexed

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://simplyenak.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://simplyenak.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": page.travel_type_name, "item": `https://simplyenak.com/tours/travel-types/${slug}/` },
  ],
};
---

<SegmentPage
  slug={slug as string}
  segmentType="audience"
  segmentName={page.travel_type_name}
  metaTitle={page.meta_title || `${page.travel_type_name} Food Tours Malaysia – Simply Enak`}
  metaDescription={page.meta_description || `Perfect food tours for ${page.travel_type_name.toLowerCase()}.`}
  heroSubtitle={page.hero_subtitle}
  heroDescription={page.hero_description}
  heroImage={page.hero_image || undefined}
  editorialHtml={editorialHtml}
  tours={tours}
  reviews={reviews}
  faq={faq}
  relatedSegments={relatedSegments}
  segmentChips={segmentChips}
  tips={page.tips || []}
  structuredData={[breadcrumbSchema]}
  hreflangPath={`/tours/travel-types/${slug}/`}
  noindex={noindex}
/>
