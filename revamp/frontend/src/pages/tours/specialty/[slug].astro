---
/**
 * Specialty Landing Page
 * URL: /tours/specialty/[slug]
 * Example: /tours/specialty/street-food
 */

import SegmentPage from '@/components/Segments/SegmentPage.astro';
import { getSpecialtyLandingPageBySlug, getAllSpecialtyLandingPages, getToursBySpecialty } from '@/lib/content';
import { markdownToHtml } from '@/lib/markdown-to-html';
import segmentChips from '@/data/content/segment-chips.json';

export const prerender = true;

export async function getStaticPaths() {
  const pages = await getAllSpecialtyLandingPages();
  return pages.map((page: any) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
const page = await getSpecialtyLandingPageBySlug(slug as string);

if (!page) return Astro.redirect('/404');

const editorialHtml = page.intro_content ? await markdownToHtml(page.intro_content) : '';
const tours = await getToursBySpecialty(slug as string);

const reviews = page.reviews || [];
const faq = page.faq || [];
const relatedSegments = page.related_segments || [];

const hasUniqueContent = (page.hero_description && page.hero_description.length > 100) || !!(page.intro_content);
const noindex = false; // Segment pages are content marketing hubs — always indexed

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://simplyenak.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://simplyenak.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": page.specialty_name, "item": `https://simplyenak.com/tours/specialty/${slug}/` },
  ],
};
---

<SegmentPage
  slug={slug as string}
  segmentType="specialty"
  segmentName={page.specialty_name}
  metaTitle={page.meta_title || `${page.specialty_name} Tours in Malaysia – Simply Enak`}
  metaDescription={page.meta_description || `${page.specialty_name} food tours in Malaysia with Simply Enak.`}
  heroSubtitle={page.hero_subtitle}
  heroDescription={page.hero_description}
  heroImage={page.hero_image || undefined}
  editorialHtml={editorialHtml}
  tours={tours}
  reviews={reviews}
  faq={faq}
  relatedSegments={relatedSegments}
  segmentChips={segmentChips}
  highlights={page.highlights || []}
  tips={page.tips || []}
  structuredData={[breadcrumbSchema]}
  hreflangPath={`/tours/specialty/${slug}/`}
  noindex={noindex}
/>
