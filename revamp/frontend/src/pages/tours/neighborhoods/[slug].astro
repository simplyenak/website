---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import { getAllTours, getImageUrl, getSiteSettings } from '@/lib/content';
import Breadcrumb from '@/components/Breadcrumb.astro';

export async function getStaticPaths() {
  const neighborhoods = [
    {
      slug: 'chow-kit',
      name: 'Chow Kit',
      city: 'Kuala Lumpur',
      citySlug: 'kuala-lumpur',
      description: 'KL\'s largest wet market - a sensory explosion of exotic fruits, aromatic spices, and local delicacies.',
      foodCulture: 'Chow Kit Market has been the heart of KL\'s food scene for 100+ years. This is where local chefs, restaurant owners, and home cooks shop for the freshest ingredients. The market is a maze of stalls selling everything from tropical fruits to aromatic spices, fresh seafood to Malay kuih.',
      mustTry: [
        { name: 'Exotic Tropical Fruits', description: 'Durian, rambutan, mangosteen, and fruits you\'ve never seen' },
        { name: 'Aromatic Spices', description: 'Fresh and dried spices for Malay, Indian, and Chinese cooking' },
        { name: 'Malay Kuih', description: 'Colorful bite-sized cakes and sweets — recipes unchanged for generations' },
        { name: 'Fresh Seafood', description: 'Fresh catch from Malaysian waters' }
      ],
      tourIds: ['kuala-lumpur-street-food', 'flavours-of-malaysia', 'secrets-of-kl-nightlife-street-art-and-cocktails']
    },
    {
      slug: 'chinatown-petaling-street',
      name: 'Chinatown (Petaling Street)',
      city: 'Kuala Lumpur',
      citySlug: 'kuala-lumpur',
      description: 'Historic Chinatown with temples, street markets, and Chinese-Malaysian food that\'s been cooking here since the 1800s.',
      foodCulture: 'Petaling Street is the heart of KL\'s Chinatown, a bustling market street lined with food stalls, temples, and shophouses. The area has been a food hub since the 1800s, where Hokkien, Cantonese, and Hakka families have been cooking the same Chinese-Malaysian dishes for generations.',
      mustTry: [
        { name: 'Hokkien Mee', description: 'Thick noodles stir-fried in dark soy sauce' },
        { name: 'Dim Sum', description: 'Steamed dumplings and small plates, served as Cantonese families have eaten them for a century' },
        { name: 'Roast Duck', description: 'Crispy-skinned duck served with rice' },
        { name: 'Herbal Tea', description: 'Chinese medicinal teas — the same brews locals have used for centuries' }
      ],
      tourIds: ['kuala-lumpur-street-food', 'flavours-of-malaysia', 'secrets-of-kl-nightlife-street-art-and-cocktails']
    },
    {
      slug: 'chowrasta-georgetown',
      name: 'Chowrasta & Georgetown',
      city: 'Penang',
      citySlug: 'penang',
      description: 'UNESCO Heritage Georgetown with historic market, street art, and Peranakan culture.',
      foodCulture: 'Georgetown is the culinary heart of Penang, a UNESCO World Heritage site where Chinese, Malay, Indian, and Peranakan cultures have fused for 200+ years. Chowrasta Market is the epicenter, selling ingredients and ready-to-eat dishes that define Penang\'s reputation as Malaysia\'s food capital.',
      mustTry: [
        { name: 'Asam Laksa', description: 'Sour, spicy fish-based noodle soup - Penang\'s signature dish' },
        { name: 'Char Kway Teow', description: 'Stir-fried rice noodles with prawns and cockles' },
        { name: 'Popiah', description: 'Fresh spring rolls with sweet sauce' },
        { name: 'Nasi Kandar', description: 'Rice with various curries - Indian Muslim specialty' }
      ],
      tourIds: ['eat-drink-george-town', 'penang-street-food']
    },
    {
      slug: 'brickfields-little-india',
      name: 'Brickfields (Little India)',
      city: 'Kuala Lumpur',
      citySlug: 'kuala-lumpur',
      description: 'KL\'s Little India - South Indian restaurants, spice shops, and banana leaf rice where the community has eaten for 140+ years.',
      foodCulture: 'Brickfields has been KL\'s Little India for 140+ years. The area is famous for its banana leaf rice restaurants, vegetarian curry houses, and sweet shops. Many vendors have been here for generations, with recipes passed down through the same families.',
      mustTry: [
        { name: 'Banana Leaf Rice', description: 'Rice served on banana leaf with various curries' },
        { name: 'Vegetarian Curry', description: 'South Indian vegetarian curries with roti' },
        { name: 'Tandoori Chicken', description: 'Clay oven-roasted chicken with spices' },
        { name: 'Indian Sweets', description: 'Mithai and sweets from recipes the families here have made for generations' }
      ],
      tourIds: ['kuala-lumpur-street-food', 'flavours-of-malaysia', 'secrets-of-kl-nightlife-street-art-and-cocktails']
    }
  ];

  return neighborhoods.map(n => ({
    params: { slug: n.slug },
    props: { neighborhood: n }
  }));
}

const { slug } = Astro.params;
const { neighborhood } = Astro.props;

const settings = await getSiteSettings();
const allTours = await getAllTours();
const neighborhoodTours = allTours.filter(t => neighborhood.tourIds.includes(t.slug));
---

<Layout
  title={`${neighborhood.name} Food Tour | ${neighborhood.city} | Simply Enak`}
  description={neighborhood.description}
  hreflangPath={`/tours/neighborhoods/${slug}/`}
  hreflangEnOnly={true}
>
  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-end bg-dark overflow-hidden">
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,9,9,0.98) 0%, rgba(10,9,9,0.75) 40%, transparent 100%);"></div>
    
    <div class="relative z-10 main-container w-full pb-16 pt-40">
      <p class="text-eyebrow text-orange mb-5">
        {neighborhood.city} Neighborhood
      </p>
      
      <h1 class="text-h1 text-white mb-4">
        {neighborhood.name}
      </h1>
      
      <p class="text-white/60 mb-6 max-w-xl leading-relaxed" style="font-size: clamp(1rem, 1.8vw, 1.2rem);">
        {neighborhood.description}
      </p>
    </div>
  </section>

  <Breadcrumb crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Tours', href: '/tours/' },
    { label: neighborhood.city, href: `/tours/locations/${neighborhood.citySlug}/` },
    { label: neighborhood.name },
  ]} />

  <!-- Food Culture -->
  <section class="bg-white py-20 md:py-28">
    <div class="main-container max-w-3xl">
      <p class="text-eyebrow text-orange mb-5">{settings?.label_food_culture}</p>
      <h2 class="text-h2 text-primary mb-8">
        {neighborhood.name}'s Food Scene
      </h2>
      <p class="text-gray-700 leading-relaxed text-lg mb-6">
        {neighborhood.foodCulture}
      </p>
    </div>
  </section>

  <!-- Must Try Foods -->
  <section class="bg-cream py-20 md:py-28">
    <div class="main-container">
      <p class="text-eyebrow text-orange mb-5">{settings?.label_local_specialties}</p>
      <h2 class="text-h2 text-primary mb-12">What to Eat Here</h2>
      
      <div class="grid md:grid-cols-2 gap-6">
        {neighborhood.mustTry.map((item, i) => (
          <div class="bg-white p-6 border border-primary/10">
            <h3 class="text-h4 text-primary mb-2">{item.name}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tours in This Neighborhood -->
  <section class="bg-white py-20 md:py-28">
    <div class="main-container">
      <p class="text-eyebrow text-orange mb-5">{settings?.label_walk_it_with_us}</p>
      <h2 class="text-h2 text-primary mb-4">Tours in {neighborhood.name}</h2>
      <p class="text-gray-400 text-sm mb-12 max-w-md leading-relaxed">Walk this neighborhood's food culture with our local guides.</p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {neighborhoodTours.map((tour: any) => (
          <a href={`/tours/${tour.slug}/`} class="group">
            <div class="bg-cream border border-primary/10 p-6 h-full group-hover:border-orange/30 group-hover:shadow-sm transition-all duration-200">
              {tour.featured && (
                <span class="inline-block px-2 py-0.5 bg-orange text-dark text-[10px] font-bold uppercase tracking-widest mb-3">Bestseller</span>
              )}
              <h3 class="text-h5 text-primary mb-2 group-hover:text-orange transition-colors">{tour.name}</h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">{tour.short_description}</p>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">{tour.duration}</span>
                <span class="font-merriweather font-bold text-orange">From RM {tour.price}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-dark py-20">
    <div class="main-container text-center">
      <h2 class="text-h2 text-white mb-6">Ready to Walk {neighborhood.name} With Us?</h2>
      <p class="text-white/60 mb-10 max-w-xl mx-auto">Come walk {neighborhood.name}'s streets and markets with us. You'll know your way around — and what to order — by the end of the morning.</p>
      <a href="/tours/" class="cta-primary inline-block">View All Tours</a>
    </div>
  </section>
</Layout>
