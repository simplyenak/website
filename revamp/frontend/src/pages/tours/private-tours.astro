---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import TourConfigurator from "@/components/Tours/TourConfigurator.astro";
import { getPrivateToursPage, getAllTours } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";
import { siteConfig } from "@/lib/site-config";
import siteSettingsData from "@/data/content/site-settings.json";

export const prerender = true;

const lang = getLangFromUrl(Astro.url);

const [privatePage, allTours] = await Promise.all([
  getPrivateToursPage(lang),
  getAllTours(),
]);
const tours = (allTours as any[]).filter((t: any) =>
  (t._status === 'published' || !t._status) &&
  (t.is_bookable === true || !!t.ticketing_hub_id?.trim())
);

const seoTitle = privatePage?.seo_title || siteSettingsData?.meta_title || 'Private Food Tours | Simply Enak';
const seoDescription = privatePage?.seo_description || siteSettingsData?.meta_description || 'Bespoke private food tours in Kuala Lumpur and Penang designed around who you are.';

const onEveryTourItems = Array.isArray(privatePage?.on_every_tour) ? privatePage.on_every_tour : [];
const privateExtrasItems = Array.isArray(privatePage?.private_extras) ? privatePage.private_extras : [];
const comparisonRows = Array.isArray(privatePage?.comparison_rows) ? privatePage.comparison_rows : [];

let whyPrivate = [];
let audiences = [];

try {
  whyPrivate = privatePage?.why_private_json ? JSON.parse(privatePage.why_private_json) : [];
  audiences = privatePage?.audiences_json ? JSON.parse(privatePage.audiences_json) : [];
} catch (e) {
  console.error('Error parsing JSON from Payload:', e);
}
if (whyPrivate.length === 0) whyPrivate = Array.isArray(privatePage?.why_private) ? privatePage.why_private : [];
if (audiences.length === 0) audiences = Array.isArray(privatePage?.audiences) ? privatePage.audiences : [];

const pageFaqs = Array.isArray(privatePage?.faqs) ? privatePage.faqs : [];

const faqSchema = pageFaqs.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": pageFaqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.name,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
} : null;

const experienceProfilerSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Private Food Tour",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://simplyenak.com/#localbusiness",
    "name": "Simply Enak"
  },
  "slogan": "A tour built around who you are, not just where you want to eat",
  "areaServed": ["Kuala Lumpur", "George Town, Penang"],
  "description": "Simply Enak designs private food tours using a 6-step Experience Profiler that understands each guest's motivation, experience style, memory identity, openness to discovery, practical needs, and personal questions. The profiler generates a narrative Experience Profile that the guide uses to design a bespoke route.",
  "offers": {
    "@type": "Offer",
    "priceSpecification": {
      "@type": "PriceSpecification",
      "priceCurrency": "MYR",
      "description": "RM 600–1,200+ per tour (not per person). Price depends on group size, duration, and customisation. Quote provided within a few hours."
    },
    "availability": "https://schema.org/InStock",
    "url": "https://simplyenak.com/tours/private-tours/"
  },
  "url": "https://simplyenak.com/tours/private-tours/"
};

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<Layout
  title={seoTitle}
  description={seoDescription}
  structuredData={faqSchema ? [experienceProfilerSchema, faqSchema] : [experienceProfilerSchema]}
  hreflangPath="/tours/private-tours/"
>
  <GlobalHero
    title={privatePage?.hero_title}
    highlight={privatePage?.hero_highlight}
    subtitle={privatePage?.hero_subtitle}
    image={privatePage?.hero_image}
    ctaPrimary={privatePage?.hero_cta_primary_text ? { text: privatePage.hero_cta_primary_text, href: privatePage?.hero_cta_primary_href ?? "#pricing" } : undefined}
    ctaSecondary={privatePage?.hero_cta_secondary_text ? { text: privatePage.hero_cta_secondary_text, href: privatePage?.hero_cta_secondary_href ?? "#tours" } : undefined}
    badges={[`${siteSettingsData?.guests_hosted} Guests`, `${siteSettingsData?.rating} Rating`].filter(Boolean)}
  />

  <Breadcrumb crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Tours', href: '/tours/' },
    { label: 'Private Tours', href: '/tours/private-tours/' },
  ]} />

  <!-- Three-way comparison: join-in / private / tailored -->
  {comparisonRows.length > 0 && (
    <section class="py-16 md:py-24 bg-cream">
      <div class="main-container">
        <div class="max-w-4xl mx-auto">
          {privatePage?.comparison_eyebrow && (
            <p class="text-orange text-eyebrow mb-3">{privatePage.comparison_eyebrow}</p>
          )}
          {privatePage?.comparison_heading && (
            <h2 class="text-h2 text-primary mb-10">{privatePage.comparison_heading}</h2>
          )}

          <!-- Comparison table -->
          <div class="overflow-x-auto -mx-4 px-4">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-primary">
                  <th class="text-left py-3 pr-4 w-1/4 font-normal text-gray-400 text-xs tracking-widest uppercase"></th>
                  <th class="py-3 px-4 text-center">
                    <span class="font-bold text-gray-400 text-base">{privatePage?.comparison_joinin_label}</span>
                  </th>
                  <th class="py-3 px-4 text-center bg-primary/5 rounded-t">
                    <span class="font-bold text-primary text-base">{privatePage?.comparison_private_label}</span>
                  </th>
                  <th class="py-3 px-4 text-center">
                    <span class="font-bold text-orange text-base">{privatePage?.comparison_tailored_label}</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {comparisonRows.map((row: any, i: number) => (
                  <tr class:list={["border-b border-gray-100", i % 2 === 0 ? "" : "bg-gray-50/50"]}>
                    <td class="py-4 pr-4 text-xs font-bold tracking-[0.12em] uppercase text-gray-400">{row.label}</td>
                    <td class="py-4 px-4 text-center text-gray-500">{row.joinin}</td>
                    <td class="py-4 px-4 text-center font-semibold text-primary bg-primary/5">{row.private}</td>
                    <td class="py-4 px-4 text-center text-gray-700">{row.tailored}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <td></td>
                  <td class="pt-6 px-4 text-center">
                    {privatePage?.comparison_joinin_cta && privatePage?.comparison_joinin_href && (
                      <a href={privatePage.comparison_joinin_href} class="text-xs font-semibold text-gray-400 hover:text-primary transition-colors underline">{privatePage.comparison_joinin_cta}</a>
                    )}
                  </td>
                  <td class="pt-6 px-4 text-center bg-primary/5">
                    <a href="#tours" class="text-xs font-semibold text-primary hover:text-orange transition-colors underline">See the tours</a>
                  </td>
                  <td class="pt-6 px-4 text-center">
                    {privatePage?.comparison_tailored_cta && (
                      <a href="#design" class="text-xs font-semibold text-orange hover:text-primary transition-colors underline">{privatePage.comparison_tailored_cta}</a>
                    )}
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>

        </div>
      </div>
    </section>
  )}

  <!-- Tailored tour example — concrete proof before the pillars -->
  {privatePage?.tailored_example_heading && (
    <section class="py-16 md:py-24 bg-white">
      <div class="main-container">
        <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start max-w-5xl mx-auto">
          <!-- Text column -->
          <div>
            <div class="flex items-start justify-between gap-6 mb-6 flex-wrap">
              <div>
                {privatePage?.tailored_example_eyebrow && (
                  <p class="text-orange text-eyebrow mb-2">{privatePage.tailored_example_eyebrow}</p>
                )}
                {privatePage?.tailored_example_occasion && (
                  <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400">{privatePage.tailored_example_occasion}</p>
                )}
              </div>
              {privatePage?.tailored_example_logo && (
                <img
                  src={privatePage.tailored_example_logo}
                  alt={privatePage?.tailored_example_logo_alt || "Conference logo"}
                  class="flex-shrink-0 object-contain"
                  style="height: 48px; max-width: 140px;"
                  loading="lazy"
                />
              )}
            </div>
            <h2 class="text-h2 text-primary mb-8">
              {privatePage.tailored_example_heading}
            </h2>
            <div class="space-y-5 border-l border-orange/30 pl-6">
              {privatePage.tailored_example_body.split('\n\n').map((para: string) => (
                <p class="text-gray-600 text-sm leading-relaxed">{para}</p>
              ))}
            </div>
            {privatePage?.tailored_example_cta && (
              <div class="mt-8">
                <a href="#design" class="inline-flex items-center gap-2 text-sm font-semibold text-orange hover:text-primary transition-colors">
                  {privatePage.tailored_example_cta}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            )}
          </div>

          <!-- Image column -->
          {privatePage?.tailored_example_image && (
            <div class="relative md:sticky md:top-24">
              <div class="rounded-2xl overflow-hidden">
                <img
                  src={privatePage.tailored_example_image}
                  alt={privatePage?.tailored_example_image_alt || "Tailored food tour experience"}
                  class="w-full h-72 md:h-[420px] object-cover"
                  loading="lazy"
                />
              </div>
              <div class="absolute -bottom-4 -left-4 w-20 h-20 border border-orange/20 rounded-xl hidden md:block" aria-hidden="true"></div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- What a private tour means — dark numbered pillars -->
  {whyPrivate.length > 0 && (
    <section class="relative overflow-hidden bg-dark text-white py-20 md:py-28">
      <div class="absolute top-0 inset-x-0 h-px pointer-events-none" style="background: linear-gradient(90deg, transparent 0%, rgba(255,163,51,0.28) 50%, transparent 100%);" aria-hidden="true"></div>
      <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(rgba(255,255,255,0.028) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>

      <div class="main-container relative z-10">
        <div class="mb-14">
          {privatePage?.why_title && (
            <h2 class="text-h2 text-white mb-4">{privatePage.why_title}</h2>
          )}
          {privatePage?.why_subtitle && (
            <p class="text-white/55 leading-relaxed max-w-xl" style="font-size: clamp(0.85rem, 1.5vw, 1rem);">{privatePage.why_subtitle}</p>
          )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/[0.06]">
          {whyPrivate.map((item: any, i: number) => (
            <div class="relative bg-dark p-8 md:p-10 pillar-reveal" style={`animation-delay: ${i * 0.12}s`}>
              <span class="absolute right-5 top-4 font-bold text-white/[0.055] pointer-events-none select-none leading-none" style="font-size: 6rem;" aria-hidden="true">{pad(i)}</span>
              <span class="text-orange text-[10px] font-bold tracking-[0.25em] uppercase mb-5 block">{pad(i)}</span>
              <div class="w-8 h-px bg-orange/40 mb-6"></div>
              <h3 class="text-h4 text-white mb-3 leading-snug">{item.title}</h3>
              <p class="text-white/55 text-sm leading-relaxed">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="absolute bottom-0 inset-x-0 h-px bg-white/[0.05]" aria-hidden="true"></div>
    </section>
  )}

  <!-- Who books private tours — typographic grid -->
  {audiences.length > 0 && (
    <section class="py-16 md:py-20 bg-white">
      {privatePage?.audiences_image && (
        <div class="main-container mb-12">
          <div class="rounded-2xl overflow-hidden">
            <img
              src={privatePage.audiences_image}
              alt={privatePage?.audiences_image_alt || "Private tour group enjoying Malaysian food"}
              class="w-full h-52 md:h-72 object-cover"
              loading="lazy"
            />
          </div>
        </div>
      )}
      <div class="main-container">
        <div class="max-w-4xl mx-auto">
          {privatePage?.audiences_title && (
            <h2 class="text-h2 text-primary mb-10">{privatePage.audiences_title}</h2>
          )}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
            {audiences.map((a: any) => (
              <div class="border-t border-gray-200 pt-6">
                <p class="font-bold text-primary text-lg leading-snug mb-2">{a.label}</p>
                <p class="text-gray-500 text-sm leading-relaxed">{a.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- What's included -->
  {(onEveryTourItems.length > 0 || privateExtrasItems.length > 0) && (
    <section class="py-16 md:py-20 bg-cream">
      <div class="main-container">
        <div class="max-w-4xl mx-auto">
          {privatePage?.inclusions_heading && (
            <h2 class="text-h2 text-primary mb-10">{privatePage.inclusions_heading}</h2>
          )}
          <div class="grid sm:grid-cols-2 gap-10 md:gap-16">
            {onEveryTourItems.length > 0 && (
              <div>
                {privatePage?.on_every_tour_label && (
                  <p class="text-[10px] font-bold tracking-[0.25em] uppercase text-orange mb-5">{privatePage.on_every_tour_label}</p>
                )}
                <ul class="space-y-4">
                  {onEveryTourItems.map((item: string) => (
                    <li class="flex items-start gap-3 border-t border-gray-200 pt-4">
                      <span class="w-1 h-1 rounded-full bg-primary mt-2 flex-shrink-0"></span>
                      <span class="text-sm text-gray-600 leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {privateExtrasItems.length > 0 && (
              <div>
                {privatePage?.private_extras_label && (
                  <p class="text-[10px] font-bold tracking-[0.25em] uppercase text-orange mb-5">{privatePage.private_extras_label}</p>
                )}
                <ul class="space-y-4">
                  {privateExtrasItems.map((item: string) => (
                    <li class="flex items-start gap-3 border-t border-gray-200 pt-4">
                      <span class="w-1 h-1 rounded-full bg-primary mt-2 flex-shrink-0"></span>
                      <span class="text-sm text-gray-600 leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- All tours available privately -->
  <Section id="tours">
    <div class="max-w-5xl mx-auto">
      <div class="mb-10">
        {privatePage?.available_privately_heading && (
          <h2 class="text-h2 text-primary mb-3">{privatePage.available_privately_heading}</h2>
        )}
        {privatePage?.available_privately_subtext && (
          <p class="text-body text-gray-500 max-w-2xl">{privatePage.available_privately_subtext}</p>
        )}
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {tours.slice(0, 6).map((tour: any) => (
          <Card href={`/tours/${tour.slug}/`} variant="default">
            {tour.hero_image && (
              <img src={tour.hero_image} alt={tour.name} class="w-full h-44 object-cover rounded-lg mb-4" loading="lazy" />
            )}
            <h3 class="text-h4 text-gray-900 mb-1">{tour.name}</h3>
            <p class="text-sm text-gray-500 mb-3">{tour.location} · {tour.duration}</p>
            <p class="text-sm font-semibold text-primary">from RM {tour.price} / person</p>
          </Card>
        ))}
      </div>
      {privatePage?.corporate_callout && (
        <div class="mt-12 bg-cream p-6 rounded-2xl border border-primary/10">
          <p class="text-sm text-gray-600 text-center">
            <strong class="text-primary">{privatePage.corporate_callout}</strong>{' '}
            {privatePage?.corporate_cta_text && privatePage?.corporate_cta_href && (
              <a href={privatePage.corporate_cta_href} class="text-orange hover:underline">{privatePage.corporate_cta_text}</a>
            )}
          </p>
        </div>
      )}
    </div>
  </Section>

  <!-- Testimonials framing — renders when quote fields are filled in Payload -->
  {(privatePage?.testimonials_eyebrow || privatePage?.private_testimonial_quote) && (
    <section class="py-16 md:py-20 bg-cream">
      <div class="main-container">
        <div class="max-w-3xl mx-auto">
          {privatePage?.testimonials_eyebrow && (
            <p class="text-orange text-eyebrow mb-3">{privatePage.testimonials_eyebrow}</p>
          )}
          {privatePage?.testimonials_intro && !privatePage?.private_testimonial_quote && (
            <p class="italic text-primary/70 leading-relaxed" style="font-size: clamp(1rem, 2vw, 1.2rem);">{privatePage.testimonials_intro}</p>
          )}
          {privatePage?.private_testimonial_quote && (
            <figure class="mt-6">
              <blockquote class="border-l border-orange/40 pl-6">
                <p class="italic text-primary leading-relaxed" style="font-size: clamp(1rem, 2vw, 1.2rem);">"{privatePage.private_testimonial_quote}"</p>
              </blockquote>
              {(privatePage?.private_testimonial_name || privatePage?.private_testimonial_detail) && (
                <figcaption class="mt-5 pl-6 flex items-center gap-3">
                  <div class="w-4 h-px bg-orange/40"></div>
                  <div>
                    {privatePage?.private_testimonial_name && (
                      <p class="text-xs font-bold text-primary tracking-wide">{privatePage.private_testimonial_name}</p>
                    )}
                    {privatePage?.private_testimonial_detail && (
                      <p class="text-[10px] text-gray-400 tracking-[0.15em] uppercase mt-0.5">{privatePage.private_testimonial_detail}</p>
                    )}
                  </div>
                </figcaption>
              )}
            </figure>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Design Your Tour Configurator — after tours so context is established -->
  <Section variant="accent" id="design">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        {privatePage?.configurator_eyebrow && <p class="text-eyebrow text-orange mb-2">{privatePage.configurator_eyebrow}</p>}
        {privatePage?.configurator_heading && <h2 class="text-h2 text-gray-900 mb-4">{privatePage.configurator_heading}</h2>}
        {privatePage?.configurator_body && <p class="text-body text-gray-600 max-w-2xl mx-auto">{privatePage.configurator_body}</p>}
      </div>
      <TourConfigurator whatsappNumber={siteConfig.whatsappNumber} />
    </div>
  </Section>

  <!-- Pricing -->
  <section class="py-16 md:py-20 bg-white" id="pricing">
    <div class="main-container">
      <div class="max-w-2xl mx-auto text-center">
        {privatePage?.pricing_heading && <h2 class="text-h2 text-primary mb-4">{privatePage.pricing_heading}</h2>}
        {privatePage?.pricing_body && <p class="text-body text-gray-600 mb-8">{privatePage.pricing_body}</p>}
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`https://wa.me/${siteConfig.whatsappDigits}?text=${privatePage?.pricing_cta_whatsapp_message}`}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-whatsapp"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 4.977 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-4.931-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {privatePage?.pricing_cta_whatsapp}
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center gap-2 bg-white text-primary border border-primary px-7 py-3 rounded-full font-semibold hover:bg-primary/5 transition"
          >
            {privatePage?.pricing_cta_message}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ — dark section -->
  {pageFaqs.length > 0 && (
    <section class="relative overflow-hidden bg-dark text-white py-20 md:py-28">
      <div class="absolute top-0 inset-x-0 h-px pointer-events-none" style="background: linear-gradient(90deg, transparent 0%, rgba(255,163,51,0.28) 50%, transparent 100%);" aria-hidden="true"></div>
      <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(rgba(255,255,255,0.028) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>

      <div class="main-container relative z-10 max-w-3xl">
        {privatePage?.faq_eyebrow && <p class="text-orange text-eyebrow mb-4 block">{privatePage.faq_eyebrow}</p>}
        {privatePage?.faq_heading && (
          <h2 class="text-h2 text-white mb-12">{privatePage.faq_heading}</h2>
        )}
        <div class="divide-y divide-white/[0.08]">
          {pageFaqs.map((faq: any) => (
            <div class="py-7">
              <h3 class="text-h4 text-white mb-3 leading-snug">{faq.name}</h3>
              <p class="text-white/55 text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="absolute bottom-0 inset-x-0 h-px bg-white/[0.05]" aria-hidden="true"></div>
    </section>
  )}

  <!-- Internal Linking -->
  <Section variant="light" spacing="compact">
    <div class="max-w-4xl mx-auto">
      {privatePage?.internal_links_heading && (
