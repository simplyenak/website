                  <h3 class="text-h5 text-white leading-snug mb-2 group-hover:text-orange transition-colors">{rt.name}</h3>
                  {rt.tagline && (
                    <p class="text-white/50 text-xs leading-relaxed mb-3 flex-1 line-clamp-2">{rt.tagline}</p>
                  )}
                  <div class="flex items-center justify-between mt-auto pt-3 border-t border-white/[0.08]">
                    {rt.price && <span class="text-orange font-bold text-sm">{rt.currency ?? 'RM'} {rt.price}</span>}
                    <span class="text-xs font-semibold text-orange group-hover:translate-x-0.5 transition-transform ml-auto">See tour →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })()}

  <CTASection whatsappNumber={settings?.whatsapp_number} />

</Layout>

<style>
  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-reveal {
    animation: heroReveal 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-d1 { animation-delay: 0.1s; }
  .hero-d2 { animation-delay: 0.28s; }
  .hero-d3 { animation-delay: 0.46s; }
  .hero-d4 { animation-delay: 0.62s; }
  .hero-d5 { animation-delay: 0.78s; }
  .hero-d6 { animation-delay: 0.94s; }

  .vendor-polaroid {
    background-color: #eaeaea;
    padding: 14px 14px 44px;
    transform: rotate(var(--rot, 0deg));
    box-shadow: 2px 4px 14px rgba(0,0,0,0.18), 0 1px 3px rgba(0,0,0,0.12);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .vendor-polaroid-wrap:hover .vendor-polaroid {
    transform: rotate(0deg) scale(1.04);
    box-shadow: 4px 8px 24px rgba(0,0,0,0.22), 0 2px 6px rgba(0,0,0,0.14);
  }
  .vendor-caption {
    font-family: 'Caveat', cursive;
    font-size: 1.1rem;
    font-weight: 500;
    color: #2c2c2c;
    text-align: center;
    margin-top: 16px;
  }
  .vendor-caption-sub {
    font-family: 'Caveat', cursive;
    font-size: 0.9rem;
    color: #888;
    text-align: center;
    margin-top: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal { animation: none; opacity: 1; transform: none; }
    .scroll-animate img { transition: none !important; transform: none !important; }
  }
</style>

<script>
  // Subtle parallax effect on hero image - only if reduced motion is not preferred
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const heroImage = document.querySelector('.hero-reveal + img[src]');
    if (heroImage) {
      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        const maxScroll = window.innerHeight * 0.5;
        const parallax = Math.min(scrolled / maxScroll, 1) * 10;
        (heroImage as HTMLElement).style.transform = `translateY(${parallax}px) scale(1.02)`;
      }, { passive: true });
    }
  }

  // Smooth scroll #booking link on mobile
  document.querySelectorAll('a[href="#booking"]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const target = document.getElementById('booking');
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
