---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import { getAllTours, getJoinInToursPage } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";
import siteSettingsData from "@/data/content/site-settings.json";

export const prerender = true;

// Get language from URL
const lang = getLangFromUrl(Astro.url);

// Fetch data from Payload
const [allTours, joinInPage] = await Promise.all([
  getAllTours(),
  getJoinInToursPage(lang),
]);

const tours = allTours.filter((t: any) => t._status === "published" && t.is_bookable === true);

// Parse JSON arrays from Payload
let whatJoinInMeans = [];
let faqs = [];

try {
  whatJoinInMeans = joinInPage?.what_it_means_json ? JSON.parse(joinInPage.what_it_means_json) : [];
  faqs = joinInPage?.faqs_json ? JSON.parse(joinInPage.faqs_json) : [];
} catch (e) {
  console.error('Error parsing JSON from Payload:', e);
}

// Fallback content if Payload is empty
if (whatJoinInMeans.length === 0) {
  whatJoinInMeans = [];
}

// faqs remain empty if not set in Payload

// FAQ schema for join-in tours — only emit when there are FAQs to avoid invalid empty mainEntity
const faqSchema = faqs.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a,
    },
  })),
} : null;
---

<Layout
  title={joinInPage?.seo_title}
  description={joinInPage?.seo_description}
  structuredData={[faqSchema].filter(Boolean)}
  hreflangPath="/tours/join-in-tours/"
>
  <GlobalHero
    title={joinInPage?.hero_title}
    highlight={joinInPage?.hero_highlight}
    subtitle={joinInPage?.hero_subtitle}
    image={joinInPage?.hero_image}
    ctaPrimary={joinInPage?.hero_cta_primary_text ? { text: joinInPage.hero_cta_primary_text, href: joinInPage.hero_cta_primary_href } : undefined}
    ctaSecondary={joinInPage?.hero_cta_secondary_text ? { text: joinInPage.hero_cta_secondary_text, href: joinInPage.hero_cta_secondary_href } : undefined}
    badges={[siteSettingsData?.guests_hosted, siteSettingsData?.rating, joinInPage?.badge_solo].filter(Boolean)}
  />

  <Breadcrumb crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Tours', href: '/tours/' },
    { label: 'Join-In Tours', href: '/tours/join-in-tours/' },
  ]} />

  <!-- What join-in means -->
  <Section variant="light" id="how-it-works">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        {joinInPage?.how_it_works_title && <h2 class="text-h2 text-primary">{joinInPage.how_it_works_title}</h2>}
        {joinInPage?.how_it_works_subtitle && <p class="text-body mt-3 max-w-2xl mx-auto">{joinInPage.how_it_works_subtitle}</p>}
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {whatJoinInMeans.map((item) => (
          <Card>
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-h4 text-gray-900 mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600">{item.detail}</p>
          </Card>
        ))}
      </div>
    </div>
  </Section>

  <!-- The social angle -->
  <Section>
    <div class="max-w-3xl mx-auto text-center">
      {joinInPage?.solo_heading && <h2 class="text-h2 text-primary mb-6">{joinInPage.solo_heading}</h2>}
      {joinInPage?.solo_body && <p class="text-body text-gray-700 mb-8">{joinInPage.solo_body}</p>}
      {joinInPage?.solo_testimonial_quote && (
        <blockquote class="bg-gray-50 border-l-4 border-primary rounded-r-2xl px-8 py-6 text-left">
          <p class="text-gray-700 italic text-lg leading-relaxed">"{joinInPage.solo_testimonial_quote}"</p>
          {joinInPage?.solo_testimonial_attribution && <footer class="mt-3 text-sm text-gray-500">— {joinInPage.solo_testimonial_attribution}</footer>}
        </blockquote>
      )}
    </div>
  </Section>

  <!-- All join-in tours -->
  <Section variant="light" id="tours">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        {joinInPage?.all_tours_heading && <h2 class="text-h2 text-primary">{joinInPage.all_tours_heading}</h2>}
        {joinInPage?.all_tours_subtext && <p class="text-body mt-3 max-w-2xl mx-auto">{joinInPage.all_tours_subtext}</p>}
      </div>
      {(() => {
        const cities = [...new Set(tours.map((t: any) => t.location))].filter(Boolean);
        const multiCity = cities.length > 1;
        return multiCity ? (
          <div class="space-y-10">
            {cities.map((city: string) => (
              <div>
                <h3 class="text-h3 text-primary mb-4 pb-2 border-b border-gray-200">{city}</h3>
                <div class="grid sm:grid-cols-2 gap-6">
                  {tours.filter((t: any) => t.location === city).map((tour: any) => (
                    <Card href={`/tours/${tour.slug}/`} variant="default">
                      {tour.hero_image && (
                        <img
                          src={tour.hero_image}
                          alt={tour.name}
                          class="w-full h-44 object-cover rounded-lg mb-4"
                          loading="lazy"
                        />
                      )}
                      <h3 class="text-h4 text-gray-900 mb-0.5">{tour.name}</h3>
                      {tour.tagline && <p class="text-sm text-primary/70 italic mb-2">{tour.tagline}</p>}
                      <p class="text-sm text-gray-500 mb-2">{tour.location} · {tour.duration}</p>
                      <p class="text-xl font-bold text-primary">RM {tour.price} <span class="text-sm font-normal text-gray-500">per person</span></p>
                    </Card>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="grid sm:grid-cols-2 gap-6">
            {tours.map((tour: any) => (
              <Card href={`/tours/${tour.slug}/`} variant="default">
                {tour.hero_image && (
                  <img
                    src={tour.hero_image}
                    alt={tour.name}
                    class="w-full h-44 object-cover rounded-lg mb-4"
                    loading="lazy"
                  />
                )}
                <h3 class="text-h4 text-gray-900 mb-0.5">{tour.name}</h3>
                {tour.tagline && <p class="text-sm text-primary/70 italic mb-2">{tour.tagline}</p>}
                <p class="text-sm text-gray-500 mb-2">{tour.location} · {tour.duration}</p>
                <p class="text-xl font-bold text-primary">RM {tour.price} <span class="text-sm font-normal text-gray-500">per person</span></p>
              </Card>
            ))}
          </div>
        );
      })()}
    </div>
  </Section>

  <!-- Quick FAQ -->
  <Section>
    <div class="max-w-3xl mx-auto">
      {joinInPage?.faqs_heading && <h2 class="text-h2 text-primary text-center mb-10">{joinInPage.faqs_heading}</h2>}
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer font-semibold text-gray-900 group-open:text-primary transition-colors list-none">
              {faq.q}
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:text-primary transition-transform group-open:rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </Section>

  <!-- Internal Linking -->
  {joinInPage?.internal_links_heading && (
    <Section variant="light" spacing="compact">
      <div class="max-w-4xl mx-auto">
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-widest mb-4">{joinInPage.internal_links_heading}</p>
        <div class="flex flex-wrap gap-2">
          {joinInPage?.link_all_tours_text && <><a href={joinInPage.link_all_tours_href} class="text-sm text-primary hover:text-orange transition-colors underline">{joinInPage.link_all_tours_text}</a><span class="text-gray-300">·</span></>}
          {joinInPage?.link_private_tours_text && <><a href={joinInPage.link_private_tours_href} class="text-sm text-primary hover:text-orange transition-colors underline">{joinInPage.link_private_tours_text}</a><span class="text-gray-300">·</span></>}
          {joinInPage?.link_kl_text && <><a href={joinInPage.link_kl_href} class="text-sm text-primary hover:text-orange transition-colors underline">{joinInPage.link_kl_text}</a><span class="text-gray-300">·</span></>}
          {joinInPage?.link_penang_text && <><a href={joinInPage.link_penang_href} class="text-sm text-primary hover:text-orange transition-colors underline">{joinInPage.link_penang_text}</a><span class="text-gray-300">·</span></>}
          {joinInPage?.link_stories_text && <a href={joinInPage.link_stories_href} class="text-sm text-primary hover:text-orange transition-colors underline">{joinInPage.link_stories_text}</a>}
        </div>
      </div>
    </Section>
  )}

  <CTASection />
</Layout>
