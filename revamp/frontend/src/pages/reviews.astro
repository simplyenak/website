---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import SocialProof from "@/components/SocialProof.astro";
import { getFeaturedTestimonials } from "@/lib/content";
import { getLangFromUrl } from "@/i18n/utils";
import siteSettingsData from "@/data/content/site-settings.json";

export const prerender = true;

const lang = getLangFromUrl(Astro.url);
const testimonials = await getFeaturedTestimonials(lang);

// Generate Review schema for AI search
const rating = siteSettingsData?.rating || '4.9';
const reviewCount = siteSettingsData?.review_count || '5000+';
const guestsHosted = siteSettingsData?.guests_hosted || '5,000+';
const yearsOperating = siteSettingsData?.years_operating || '14+';
const maxPeople = siteSettingsData?.max_people_per_tour || 8;

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "AggregateRating",
  itemReviewed: {
    "@type": "LocalBusiness",
    name: "Simply Enak",
    description: "Malaysian food tour company offering authentic cultural food experiences in Kuala Lumpur and Penang since 2011"
  },
  ratingValue: rating,
  reviewCount: testimonials.length > 0 ? testimonials.length.toString() : reviewCount,
  bestRating: "5",
  worstRating: "1"
};

const individualReviews = testimonials.map(t => ({
  "@type": "Review",
  author: {
    "@type": "Person",
    name: t.author_name
  },
  reviewRating: {
    "@type": "Rating",
    ratingValue: t.rating.toString(),
    bestRating: "5",
    worstRating: "1"
  },
  reviewBody: t.review_text,
  datePublished: t.date || new Date().toISOString().split('T')[0]
}));

const fullSchema = {
  "@context": "https://schema.org",
  "@graph": [
    reviewSchema,
    {
      "@type": "ItemList",
      itemListElement: individualReviews.map((review, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: review
      }))
    }
  ]
};

function generateStars(rating: number) {
  return Array(5).fill(0).map((_, i) => i < rating);
}
---

<Layout
  title={`Guest Reviews & Testimonials | Simply Enak`}
  description={`Read what ${guestsHosted} guests discovered on Simply Enak food tours in Kuala Lumpur and Penang. ${rating} rating from travelers worldwide. Real stories, real experiences.`}
  structuredData={fullSchema}
  hreflangPath="/reviews/"
>
  <GlobalHero
    title="What Our Guests Discovered"
    subtitle="Real stories from real travelers. No scripts, no filters."
  />

  <!-- Social Proof -->
  <SocialProof variant="compact" />

  <!-- Overall Rating Summary -->
  <Section variant="light" animate={true}>
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="flex items-center justify-center gap-4 mb-6">
        <div class="flex gap-2">
          {generateStars(parseFloat(rating)).map((filled) => (
            <svg
              class={`w-8 h-8 ${filled ? 'text-yellow-400' : 'text-gray-300'} fill-current`}
              viewBox="0 0 20 20"
            >
              <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
            </svg>
          ))}
        </div>
        <span class="text-3xl font-bold text-gray-900">{rating}</span>
        <span class="text-xl text-gray-600">
          ({reviewCount}+ reviews)
        </span>
      </div>
      <p class="text-lg text-gray-700 max-w-2xl mx-auto">
        We've hosted {guestsHosted} guests since 2011, maintaining a {rating} rating.
        Here's what they learned about Malaysian food, culture, and themselves.
      </p>
    </div>

    <!-- Review Cards -->
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {testimonials.map((testimonial, index) => (
          <article 
            class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-300 scroll-animate"
            style={`transition-delay: ${index * 100}ms`}
          >
            <!-- Header -->
            <div class="flex items-start justify-between mb-4">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="font-semibold text-gray-900">{testimonial.author_name}</h3>
                  {testimonial.verified && (
                    <svg
                      class="w-4 h-4 text-blue-500"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                      title="Verified guest"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  )}
                </div>
                <p class="text-sm text-gray-500">{testimonial.author_location}</p>
              </div>
              <div class="flex gap-1">
                {generateStars(testimonial.rating).map((filled) => (
                  <svg
                    class={`w-4 h-4 ${filled ? 'text-yellow-400' : 'text-gray-300'} fill-current`}
                    viewBox="0 0 20 20"
                  >
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                  </svg>
                ))}
              </div>
            </div>

            <!-- Review Title -->
            <h4 class="font-semibold text-gray-900 mb-3">
              {testimonial.review_title}
            </h4>

            <!-- Review Text -->
            <blockquote class="text-gray-700 leading-relaxed mb-4">
              "{testimonial.review_text}"
            </blockquote>

            <!-- Platform Badge (if available) -->
            {testimonial.platform && (
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                Verified on {testimonial.platform}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>

    <!-- Trust Links -->
    <div class="max-w-4xl mx-auto mt-16 text-center">
      <p class="text-gray-600 mb-8">
        Read more stories from guests who discovered Malaysian food culture
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={siteSettingsData?.social_tripadvisor}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-300"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          Read More on TripAdvisor
        </a>
        <a
          href="https://www.google.com/search?q=Simply+Enak+Food+Experiences+Kuala+Lumpur&ludocid=12345678901234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-300"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
          </svg>
          Google Reviews
        </a>
      </div>
    </div>
  </Section>

  <!-- Statistics Section -->
  <Section variant="white" animate={true}>
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">
        {yearsOperating} Years of People Who Trusted Us With Their Table
      </h2>

      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">{guestsHosted}</div>
          <div class="text-gray-600">Guests Hosted</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">{siteSettingsData?.tours_count || '312+'}</div>
          <div class="text-gray-600">Tours Since 2011</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">{rating}</div>
          <div class="text-gray-600">Average Rating</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">{reviewCount}</div>
          <div class="text-gray-600">Verified Reviews</div>
        </div>
      </div>
    </div>
  </Section>

  <CTASection />
</Layout>

<style>
  .scroll-animate {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
