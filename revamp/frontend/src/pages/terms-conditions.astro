---
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/Prose.astro";
import CTASection from "@/components/CTASection.astro";
import { getLegalPageBySlug } from "@/lib/content";

export const prerender = true;

const page = await getLegalPageBySlug("terms-conditions");
if (!page) return Astro.redirect("/404");
---

<Layout title={page.meta_title} hreflangPath="/terms-conditions/" hreflangEnOnly={true}>
  <section
    class="py-15 bg-[#ffa33f1a] min-h-[250px] flex items-center justify-center h-full"
  >
    <div class="main-container text-center">
      <h1 class="text-3xl md:text-5xl font-bold font-merriweather">
        {page.headline}
      </h1>
    </div>
  </section>
  <section class="main-container py-15">
    <Prose>
      <div set:html={page.content} />
    </Prose>
  </section>
  <CTASection />
</Layout>
