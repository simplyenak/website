---
import Layout from "../layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";

import rawItems from "@/data/content/media-coverage.json";
import { getMediaPage, getMediaCoverage } from "@/lib/content";
import siteSettingsData from "@/data/content/site-settings.json";
import { getLangFromUrl } from "@/i18n/utils";

export const prerender = true;

const lang = getLangFromUrl(Astro.url);
const mediaPage = await getMediaPage(lang);
const mediaItems = await getMediaCoverage(lang);

function logoSrc(domain: string | null | undefined): string {
  if (!domain) return "/images/press-logos/default.png";
  return `/images/press-logos/${domain}.png`;
}

type RawItem = {
  id: number;
  sort: number;
  status: string;
  category: string;
  outlet: string;
  year: string;
  detail: string;
  url?: string | null;
  label?: string | null;
  logo_domain?: string | null;
  highlight?: string | null;
};

const items = rawItems as RawItem[];

const CATEGORIES: { id: string; heading: string }[] = Array.isArray(mediaPage.categories)
  ? mediaPage.categories
  : [
      { id: "television", heading: "Television" },
      { id: "print", heading: "Print & Guides" },
      { id: "youtube", heading: "YouTube & Online Video" },
      { id: "podcasts", heading: "Podcasts & Radio" },
      { id: "blogs", heading: "Blogs & Online Press" },
    ];

const lightSections = new Set(["print", "podcasts"]);
---

<Layout
  title={mediaPage?.seo_title}
  description={mediaPage?.seo_description}
  hreflangPath="/media/"

>
  <GlobalHero
    title={mediaPage?.hero_title}
    highlight={mediaPage?.hero_highlight}
    subtitle={mediaPage?.hero_subtitle}
    image={mediaPage?.hero_image ?? undefined}
  />

  <!-- Media enquiries banner -->
  {mediaPage?.enquiries_text && (
    <Section variant="light">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-body text-gray-600 mb-4">{mediaPage.enquiries_text}</p>
        {mediaPage?.enquiries_cta && (
          <a
            href="/contact/"
            class="inline-block bg-primary text-white font-semibold px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors"
          >
            {mediaPage.enquiries_cta}
          </a>
        )}
      </div>
    </Section>
  )}

  <!-- Featured video -->
  {mediaPage?.featured_video_url && (
    <Section>
      <div class="max-w-3xl mx-auto">
        {mediaPage?.featured_eyebrow && <p class="text-eyebrow text-orange mb-3 text-center">{mediaPage.featured_eyebrow}</p>}
        {mediaPage?.featured_video_heading && <h2 class="text-h2 text-primary text-center mb-8">{mediaPage.featured_video_heading}</h2>}
        <div class="aspect-video w-full rounded-xl overflow-hidden shadow-lg">
          <iframe
            src={mediaPage.featured_video_url}
            title={mediaPage?.featured_video_title}
            class="w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </Section>
  )}

  <!-- Category sections -->
  {CATEGORIES.map((cat) => {
    const catItems = items.filter((i) => i.category === cat.id);
    if (catItems.length === 0) return null;
    return (
      <Section id={cat.id} variant={lightSections.has(cat.id) ? "light" : "white"}>
        <h2 class="text-h2 text-primary mb-8">{cat.heading}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {catItems.map((item) => {
            const isFirst = item.highlight === "first";
            const isLatest = item.highlight === "latest";
            const logo = logoSrc(item.logo_domain);
            return (
              <div class:list={[
                "relative border rounded-xl p-5 bg-white hover:shadow-md transition-shadow duration-200",
                isFirst ? "border-orange/40 ring-1 ring-orange/20" : "border-gray-100",
                isLatest ? "border-primary/40 ring-1 ring-primary/20" : "",
              ]}>
                <!-- Milestone badge -->
                {isFirst && (
                  <span class="absolute -top-2.5 left-4 bg-orange text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">
                    First coverage
                  </span>
                )}
                {isLatest && (
                  <span class="absolute -top-2.5 left-4 bg-primary text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">
                    Latest
                  </span>
                )}

                <!-- External link badge -->
                {item.url && (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${item.outlet} — ${item.label ?? mediaPage?.media_item_default_label}`}
                    class="absolute top-3 right-3 text-gray-300 hover:text-primary transition-colors duration-200"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4" aria-hidden="true">
                      <path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                      <path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                    </svg>
                  </a>
                )}

                <div class="flex items-start gap-3 mb-3">
                  <!-- Outlet logo -->
                  <div class="shrink-0 w-9 h-9 rounded-lg bg-gray-50 border border-gray-100 flex items-center justify-center overflow-hidden">
                    <img
                      src={logo}
                      alt={item.outlet}
                      width="36"
                      height="36"
                      class="w-7 h-7 object-contain"
                      loading="lazy"
                    />
                  </div>

                  <!-- Outlet name + year -->
                  <div class="flex-1 min-w-0">
                    <span class="block font-merriweather font-bold text-primary text-sm leading-snug">
                      {item.outlet}
                    </span>
                    <span class="text-[10px] text-gray-400 font-mono">
                      {item.year}
                    </span>
                  </div>
                </div>

                <p class="text-sm text-gray-600 leading-relaxed mb-3 pl-12">{item.detail}</p>

                {item.url && (
                  <div class="pl-12">
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs font-semibold text-primary hover:text-orange transition-colors duration-200"
                    >
                      {item.label ?? mediaPage?.media_item_default_label} →
                    </a>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </Section>
    );
  })}

  <CTASection />
</Layout>
