---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/Home/HeroSection.astro";
import MeetTheVendorsSection from "@/components/Home/MeetTheVendorsSection.astro";
import OurToursSection from "@/components/Home/OurToursSection.astro";
import OurValuesSection from "@/components/Home/OurValuesSection.astro";
import TestimonialsSection from "@/components/Home/TestimonialsSection.astro";
import StoriesSection from "@/components/Home/StoriesSection.astro";
import FAQSection from "@/components/Home/FAQSection.astro";
import CTASection from "@/components/CTASection.astro";
import ManifestoSection from "@/components/Home/ManifestoSection.astro";
import OnThePlateSection from "@/components/Home/OnThePlateSection.astro";
import MediaLogosStrip from "@/components/Home/MediaLogosStrip.astro";
import RightForYouSection from "@/components/Home/RightForYouSection.astro";
import WhyUsSection from "@/components/Home/WhyUsSection.astro";
import GradientTransition from "@/components/Home/GradientTransition.astro";
import PrivateToursCTA from "@/components/Home/PrivateToursCTA.astro";
import { getHomePage, getAllTours, getFeaturedTestimonials, getFeaturedStories, getFeaturedVendors, getFAQsByPage, getImageUrl, getSiteSettings, getMainTourSlugs } from "@/lib/content";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import tourImg1 from "@/assets/images/bg1.jpg";
import tourImg2 from "@/assets/images/bg2.webp";
import tourImg3 from "@/assets/images/bg3.webp";
import tourImg4 from "@/assets/images/bg4.jpg";
import tourImg5 from "@/assets/images/bg5.jpg";

// Per-tour fallback images — used until real images are uploaded to Payload
const tourFallbackImages: Record<string, { src: string }> = {
  'kuala-lumpur-street-food': tourImg1,
  'flavours-of-malaysia': tourImg2,
  'eat-drink-george-town': tourImg3,
  'penang-street-food': tourImg4,
  'secrets-of-kl-nightlife-street-art-and-cocktails': tourImg5,
};

// English home page at root /
const lang = getLangFromUrl(Astro.url);
const t = useTranslations('en');

// Fetch ALL content from JSON snapshots
const [homePage, siteSettings, allTours, testimonials, stories, vendors, faqs] = await Promise.all([
  getHomePage('en'),
  getSiteSettings(),
  getAllTours({ limit: 100 }, 'en'),
  getFeaturedTestimonials(),
  getFeaturedStories('en'),
  getFeaturedVendors(3, 'en'),
  getFAQsByPage('home', 'en'),
]);

// Get content from home-page.json
const content = homePage || {};

// Map testimonials to component format
const testimonialCards = testimonials.map((t: any) => ({
  title: t.review_title || "Great Experience",
  review: t.review_text,
  name: t.author_name,
  country: t.author_location,
  image: t.author_photo ? getImageUrl(t.author_photo) : undefined,
}));

// Map stories to component format
const storyCards = stories.map((s: any) => ({
  slug: s.slug,
  title: s.title,
  image: s.hero_image ? getImageUrl(s.hero_image) : undefined,
  excerpt: s.excerpt,
}));

// Map tours to OurToursSection card format (ONLY main 5 tours)
const mainTourSlugs = getMainTourSlugs();
const tourCards = allTours
  .filter((tour: any) => mainTourSlugs.includes(tour.slug))
  .map((tour: any) => {
    const fallback = tourFallbackImages[tour.slug];
    return {
      title: tour.name,
      link: `/tours/${tour.slug}/`,
      image: tour.hero_image
        ? { url: getImageUrl(tour.hero_image) }
        : { url: fallback?.src },
      price: `${content?.tour_card_price_prefix || 'from'} ${tour.currency || "MYR"} ${tour.price}`,
      duration: tour.duration,
      location: tour.location,
      featured: tour.featured,
      buttons: [{ title: content?.tour_card_button || "Join This Tour", href: `/tours/${tour.slug}`, buttonType: "primary-btn-small" as const }],
    };
  });

// Build SEO from site settings
const rawSiteTitle = siteSettings?.meta_title;
const parsedSiteTitle = (typeof rawSiteTitle === 'string' && rawSiteTitle.startsWith('{'))
  ? (() => { try { return JSON.parse(rawSiteTitle); } catch { return null; } })()
  : rawSiteTitle;
const localSiteTitle = parsedSiteTitle && typeof parsedSiteTitle === 'object'
  ? (parsedSiteTitle as Record<string, string>)['en']
  : parsedSiteTitle;
const seoTitle = content?.meta_title || localSiteTitle || 'Simply Enak | Malaysian Food Tours';
const rawSiteDesc = siteSettings?.meta_description;
const parsedSiteDesc = (typeof rawSiteDesc === 'string' && rawSiteDesc.startsWith('{'))
  ? (() => { try { return JSON.parse(rawSiteDesc); } catch { return null; } })()
  : rawSiteDesc;
const localSiteDesc = parsedSiteDesc && typeof parsedSiteDesc === 'object'
  ? (parsedSiteDesc as Record<string, string>)['en']
  : parsedSiteDesc;
const seoDescription = content?.meta_description || localSiteDesc || 'Small-group Malaysian food tours with guides who grew up eating at these stalls';
const seoImage = siteSettings?.og_image || content?.hero_bg_image || 'https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg';
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
  hreflangPath="/"
>
  {/* HERO SECTION - All from home-page.json */}
  <HeroSection
    eyebrow={content?.hero_eyebrow}
    title={content?.hero_title}
    highlightedText={content?.hero_highlight}
    titleEnd={content?.hero_title_end}
    subtitle={content?.hero_subtitle}
    description={content?.hero_description}
    priceInfo={content?.hero_price_info}
    bgImage={content?.hero_bg_image}
    whatsappNumber={siteSettings?.whatsapp_number}
    ctaPrimaryText={content?.hero_cta_primary}
    ctaPrimaryUrl={content?.hero_cta_primary_url}
    ctaSecondaryText={content?.hero_cta_secondary}
    ctaSecondaryUrl={content?.hero_cta_secondary_url}
    establishedLabel={content?.hero_established_label}
    establishedYear={content?.hero_established_year}
    locationLabel={content?.hero_location_label}
    googleLabel={content?.hero_google_label}
    tripadvisorLabel={content?.hero_tripadvisor_label}
    socialProofRating={content?.hero_social_proof_rating}
    guestsHosted={content?.hero_guests_hosted}
    sinceLabel={content?.hero_since}
  />

  {/* ═══════════════════════════════════════════════════════
      SECTION ORDER — Conversion-first architecture
      Matches English homepage exactly
      ═══════════════════════════════════════════════════════ */}

  {/* ── 2. OUR TOURS — What we do, immediate conversion path ── */}
  <OurToursSection
    eyebrow={content?.featured_tours_eyebrow}
    title={content?.featured_tours_title}
    cards={tourCards.length > 0 ? tourCards : []}
    button={{
      title: content?.featured_tours_cta_text,
      href: `/tours/`,
      buttonType: 'cta-primary' as const,
    }}
  />

  {/* ── 3. PRIVATE & TAILORED — The direction we're heading ── */}
  <PrivateToursCTA
    eyebrow={content?.private_tours_eyebrow}
    heading={content?.private_tours_heading}
    ctaText={content?.private_tours_cta_text}
    ctaAriaLabel={content?.private_tours_cta_aria}
    whatsappNumber={siteSettings?.whatsapp_number}
    features={content?.private_tours_features}
    stats={content?.private_tours_stats}
  />

  {/* ── 4. SOCIAL PROOF — Guest reviews, confirm the recommendation ── */}
  <TestimonialsSection
    eyebrow={content?.testimonials_eyebrow}
    heading={content?.testimonials_heading}
    ctaText={content?.testimonials_cta_text}
    cards={testimonialCards.length > 0 ? testimonialCards : undefined}
  />

  {/* ── 5. PRESS CREDIBILITY — Publication logos and features ── */}
  <MediaLogosStrip
    features={content?.press_features}
    eyebrow={content?.press_eyebrow}
  />

  {/* ── 6. WHAT TO EXPECT — Stats and value ── */}
  {siteSettings?.show_values !== false && (
    <OurValuesSection
      eyebrow={content?.expect_eyebrow}
      title={content?.expect_title}
      subtitle={content?.expect_subtitle}
      ctaText={content?.expect_cta_text}
      stats={[
        {
          number: content?.expect_stat1_number,
          heading: content?.expect_stat1_heading,
          body: content?.expect_stat1_body,
        },
        {
          number: content?.expect_stat2_number,
          heading: content?.expect_stat2_heading,
          body: content?.expect_stat2_body,
        },
        {
          number: content?.expect_stat3_number,
          heading: content?.expect_stat3_heading,
          body: content?.expect_stat3_body,
        },
        {
          number: content?.expect_stat4_number,
          heading: content?.expect_stat4_heading,
          body: content?.expect_stat4_body,
        },
      ]}
    />
  )}

  {/* ── 7. WHY US — Six reasons to book with Simply Enak ── */}
  <WhyUsSection
    eyebrow={content?.why_us_eyebrow}
    title={content?.why_us_title}
    subtitle={content?.why_us_subtitle}
    reasons={[
      { icon: content?.why_us_reason_0_icon, stat: content?.why_us_reason_0_stat, heading: content?.why_us_reason_0_heading, body: content?.why_us_reason_0_body },
      { icon: content?.why_us_reason_1_icon, stat: content?.why_us_reason_1_stat, heading: content?.why_us_reason_1_heading, body: content?.why_us_reason_1_body },
      { icon: content?.why_us_reason_2_icon, stat: content?.why_us_reason_2_stat, heading: content?.why_us_reason_2_heading, body: content?.why_us_reason_2_body },
      { icon: content?.why_us_reason_3_icon, stat: content?.why_us_reason_3_stat, heading: content?.why_us_reason_3_heading, body: content?.why_us_reason_3_body },
      { icon: content?.why_us_reason_4_icon, stat: content?.why_us_reason_4_stat, heading: content?.why_us_reason_4_heading, body: content?.why_us_reason_4_body },
      { icon: content?.why_us_reason_5_icon, stat: content?.why_us_reason_5_stat, heading: content?.why_us_reason_5_heading, body: content?.why_us_reason_5_body },
    ]}
  />

  {/* ── 8. IS THIS RIGHT FOR YOU? — Honest qualifier, filters leads ── */}
  <RightForYouSection
    heading={content?.right_for_you_heading}
    forLabel={content?.right_for_you_for_label}
    notLabel={content?.right_for_you_not_label}
    forYouItems={content?.right_for_you_for_items}
    notForYouItems={content?.right_for_you_not_items}
  />

  <GradientTransition />

  {/* ── 9. BRAND STATEMENT — Pauline's voice, below the fold ── */}
  <ManifestoSection
    headline={content?.manifesto_headline}
    eyebrow={content?.manifesto_eyebrow}
    tagline={content?.manifesto_tagline}
    body={content?.manifesto_body}
    attributionName={content?.manifesto_attribution_name}
    attributionRole={content?.manifesto_attribution_role}
    portraitSrc={content?.manifesto_portrait ? getImageUrl(content.manifesto_portrait) : undefined}
    portraitAlt={content?.manifesto_portrait_alt}
    ctaText={content?.manifesto_cta_text}
    pillarPeopleLabel={t('manifesto.people')}
    pillarPeopleBody={t('manifesto.peopleBody')}
    pillarFoodLabel={t('manifesto.food')}
    pillarFoodBody={t('manifesto.foodBody')}
    pillarPlaceLabel={t('manifesto.place')}
    pillarPlaceBody={t('manifesto.placeBody')}
  />

  {/* ── 10. ON THE PLATE — Food culture showcase ── */}
  <OnThePlateSection
    eyebrow={content?.on_the_plate_eyebrow}
    title={content?.on_the_plate_title}
    subtitle={content?.on_the_plate_subtitle}
    dishes={content?.on_the_plate_dishes}
  />

  {/* ── 11. VENDORS + STORIES — Community and authority content ── */}
  {siteSettings?.show_vendors !== false && vendors.length > 0 && (
    <MeetTheVendorsSection
      eyebrow={content?.vendors_eyebrow}
      title={content?.vendors_title}
      subtitle={content?.vendors_subtitle}
      vendors={vendors}
      meetOnTourText={content?.vendors_meet_on_tour}
      footerText={content?.vendors_footer}
      readStoriesText={content?.vendors_read_stories}
      readStoriesUrl={content?.vendors_read_stories_url}
    />
  )}

  <StoriesSection
    eyebrow={content?.stories_eyebrow}
    title={content?.stories_section_title}
    stories={storyCards.length > 0 ? storyCards : undefined}
  />

  {/* ── 12. FAQ — Objection handling ── */}
  <FAQSection
    eyebrow={content?.faq_eyebrow}
    title={content?.faq_title}
    ctaText={content?.faq_cta_text}
    faqs={faqs.length > 0 ? faqs : undefined}
  />

  {/* ── 13. FINAL CTA — Booking push ── */}
  <CTASection
    eyebrow={content?.cta_eyebrow}
    title={content?.cta_title}
    subtitle={content?.cta_subtitle}
    whatsappNumber={siteSettings?.whatsapp_number}
    freeCancellationText={content?.cta_free_cancellation}
    replyTimeText={content?.cta_reply_time}
    maxPeopleText={content?.cta_max_people}
    bookExperienceText={content?.cta_book_experience}
    chatWhatsAppText={content?.cta_chat_whatsapp}
  />
</Layout>
