---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import { getHowItWorksPage } from "@/lib/content";
import { SUPPORTED_LANGS } from "@/i18n/utils";
import siteSettingsData from "@/data/content/site-settings.json";

export const prerender = true;

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}


// Get language from URL
const urlLang = (Astro.params.lang as string) || 'en';
const lang = urlLang;

// Fetch how it works page content from Payload
const page = await getHowItWorksPage(lang);

// Tour types (private vs join-in cards)
const tourTypes = Array.isArray(page?.tour_types) ? page.tour_types : [
  {
    type: "Private",
    heading: "Private Tours",
    emoji: "🧭",
    href: "/tours/private-tours/",
    features: [
      "Your group only, no other guests",
      "Custom start time, flexible route",
      "Pre-tour planning call with your guide",
      "Quoted price based on group size",
    ],
    cta_text: "See private tours →",
  },
  {
    type: "Join-In",
    heading: "Join-In Tours",
    emoji: "👥",
    href: "/tours/join-in-tours/",
    features: [
      "Small shared group, max 12 guests",
      "Per-person pricing, no minimums",
      "Solo-friendly, social atmosphere",
      `From RM ${siteSettingsData?.tour_price ?? 285} per person`,
    ],
    cta_text: "See join-in tours →",
  },
];

// Inclusions list
const inclusions = Array.isArray(page?.inclusions) ? page.inclusions : [
  "Certified local guide",
  "Food samples at every stop",
  "Cultural context at each stall",
  "Bottled water throughout",
  "Small group (max 12 guests)",
  "No tourist trap restaurants",
  "Local prices — always",
];

// Steps / process list — support both JSON-snapshot array and legacy steps_json string
let steps: { n: number; title: string; detail: string }[] = [];

if (Array.isArray(page?.steps) && page.steps.length > 0) {
  steps = page.steps;
} else if (page?.steps_json) {
  try {
    steps = JSON.parse(page.steps_json);
  } catch (e) {
    console.error("Error parsing steps_json from Payload:", e);
  }
}

if (steps.length === 0) {
  steps = [
    { n: 1, title: "Pick your tour and format", detail: "Browse our tours across KL and Penang." },
    { n: 2, title: "Book via WhatsApp or the tour page", detail: "Send us a WhatsApp or complete the booking form." },
    { n: 3, title: "We confirm and send you the prep guide", detail: "You'll get confirmation with meeting point details." },
    { n: 4, title: "Show up at the meeting point", detail: "Look for the Simply Enak guide with a blue badge." },
    { n: 5, title: "Walk, eat, ask anything", detail: "Your guide takes you through 8 to 10+ tasting stops." },
    { n: 6, title: "Leave a review if you loved it", detail: "Reviews on TripAdvisor and Google help others find us." },
  ];
}
---

<Layout
  title={page?.seo_title ?? page?.hero_title}
  description={page?.seo_description ?? page?.hero_subtitle}
  hreflangPath="/how-it-works/"
>
  <GlobalHero
    title={page?.hero_title}
    highlight={page?.hero_highlight}
    subtitle={page?.hero_subtitle}
  />

  <!-- Two ways to tour -->
  <Section variant="light">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        {page?.formats_title && <h2 class="text-h2 text-primary">{page.formats_title}</h2>}
        {page?.formats_subtitle && <p class="text-body mt-3 max-w-2xl mx-auto">{page.formats_subtitle}</p>}
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {tourTypes.map((tt) => (
          <Card href={tt.href} variant="featured">
            <div class="text-3xl mb-4">{tt.emoji}</div>
            <h3 class="font-bold text-xl text-gray-900 mb-3">{tt.heading}</h3>
            <ul class="space-y-2 text-sm text-gray-600 mb-4">
              {tt.features.map((feature: string) => (
                <li class="flex items-start gap-2">
                  <span class="text-primary font-bold flex-shrink-0">✓</span> {feature}
                </li>
              ))}
            </ul>
            <span class="text-primary font-semibold text-sm">{tt.cta_text}</span>
          </Card>
        ))}
      </div>
    </div>
  </Section>

  <!-- What every tour includes -->
  <Section>
    <div class="max-w-4xl mx-auto">
      {page?.inclusions_title && <h2 class="text-h2 text-primary text-center mb-10">{page.inclusions_title}</h2>}
      <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        {inclusions.map((item: string) => (
          <div class="flex items-center gap-3 bg-white border border-gray-100 rounded-xl p-4 shadow-sm">
            <span class="w-7 h-7 flex-shrink-0 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">✓</span>
            <span class="text-sm text-gray-700">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- From booking to the last bite -->
  <Section variant="light">
    <div class="max-w-3xl mx-auto">
      {page?.steps_section_title && <h2 class="text-h2 text-primary text-center mb-10">{page.steps_section_title}</h2>}
      <ol class="space-y-6">
        {steps.map((step) => (
          <li class="flex gap-5">
            <div class="w-9 h-9 flex-shrink-0 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">
              {step.n}
            </div>
            <div class="pt-1">
              <h3 class="font-bold text-gray-900 mb-1">{step.title}</h3>
              <p class="text-sm text-gray-600">{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- Practical info link -->
  <Section>
    <div class="max-w-2xl mx-auto text-center">
      {page?.practical_title && <h2 class="text-h2 text-primary mb-4">{page.practical_title}</h2>}
      {page?.practical_body && <p class="text-body text-gray-600 mb-8">{page.practical_body}</p>}
      {page?.practical_cta_href && page?.practical_cta_text && (
        <a
          href={page.practical_cta_href}
          class="inline-flex items-center gap-2 bg-primary text-white px-7 py-3 rounded-full font-semibold hover:bg-primary/90 transition"
        >
          {page.practical_cta_text}
        </a>
      )}
    </div>
  </Section>

  <CTASection />
</Layout>
