---
export const prerender = true;

export async function getStaticPaths() {

  return SUPPORTED_LANGS.map((lang: string) => ({ params: { lang } }));
}

import { SUPPORTED_LANGS, localizePath } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import Badge from "@/components/Design/Badge.astro";
import { getAllStories, getStoriesArchivePage } from "@/lib/content";
import CTASection from "@/components/CTASection.astro";

const lang = (Astro.params.lang as string) || 'en';

// BCP 47 locale tags for date formatting — raw lang codes may not be
// recognized by all Node.js ICU builds (e.g. 'ms' vs 'ms-MY').
const LOCALE_MAP: Record<string, string> = {
  ms: 'ms-MY', zh: 'zh-CN', de: 'de-DE', es: 'es-ES',
  fr: 'fr-FR', nl: 'nl-NL', ru: 'ru-RU', ja: 'ja-JP', pt: 'pt-BR',
};
const locale = LOCALE_MAP[lang] ?? lang;

const [allStories, page] = await Promise.all([
  getAllStories({}, lang),
  getStoriesArchivePage(lang),
]);
const sortedStories = [...(allStories as any[])].sort(
  (a, b) => new Date(b.published_at ?? 0).getTime() - new Date(a.published_at ?? 0).getTime()
);

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString(locale, {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title={page?.seo_title}
  description={page?.seo_description}
  hreflangPath="/stories/archive/"
>
  <GlobalHero
    title={page?.hero_title}
    highlight={page?.hero_highlight}
    subtitle={page?.hero_subtitle}
    image={page?.hero_image ?? undefined}
  />

  <Section>
    <!-- Category Filter -->
    <div class="flex flex-wrap gap-3 justify-center mb-12">
      {page?.back_href && page?.back_label && (
        <a href={page.back_href} class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 text-sm font-semibold hover:bg-gray-200 transition-colors">
          {page.back_label}
        </a>
      )}
      {page?.filter_all_label && (
        <button data-filter="all" class="filter-pill px-4 py-2 rounded-full bg-primary text-white text-sm font-semibold transition-colors">
          {page.filter_all_label}
        </button>
      )}
      {(Array.isArray(page?.filter_categories) ? page.filter_categories : []).map((cat: any) => (
        <button data-filter={cat.filter} class="filter-pill px-4 py-2 rounded-full bg-gray-100 text-gray-700 text-sm font-semibold hover:bg-gray-200 transition-colors">
          {cat.label}
        </button>
      ))}
    </div>

    <div id="stories-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        sortedStories.map((story) => (
          <a
            href={localizePath(`/stories/${story.slug}/`, lang)}
            class="group h-full story-card"
            data-categories={JSON.stringify(story.categories ?? [])}
          >
            <Card class="h-full flex flex-col">
              <div class="relative h-56 overflow-hidden rounded-t-lg flex-shrink-0">
                <img
                  src={story.hero_image}
                  alt={story.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                  {(story.categories ?? []).slice(0, 1).map((category) => (
                    <Badge variant="secondary" size="small">
                      {category}
                    </Badge>
                  ))}
                </div>
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-h4 text-primary mb-3 group-hover:text-secondary transition-colors line-clamp-2">
                  {story.title}
                </h3>
                <p class="text-body text-sm mb-4 line-clamp-3 flex-grow">
                  {story.excerpt}
                </p>
                <div class="flex items-center justify-between text-xs text-gray-500 mt-auto pt-4 border-t border-gray-100">
                  <span>{formatDate(story.published_at ?? '')}</span>
                  {page?.read_story_label && (
                    <span class="text-primary font-semibold group-hover:translate-x-1 transition-transform">
                      {page.read_story_label}
                    </span>
                  )}
                </div>
              </div>
            </Card>
          </a>
        ))
      }
    </div>

    <p id="no-results" data-no-results-text={page?.no_results_text} class="hidden text-center text-gray-500 py-16">{page?.no_results_text}</p>
  </Section>

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.story-card');
    const noResults = document.getElementById('no-results');

    function applyFilter(filter: string) {
      pills.forEach(p => {
        p.classList.remove('bg-primary', 'text-white');
        p.classList.add('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');
      });
      const active = [...pills].find(p => p.dataset.filter === filter) ?? pills[0];
      active.classList.add('bg-primary', 'text-white');
      active.classList.remove('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');

      let visible = 0;
      cards.forEach(card => {
        const cats: string[] = JSON.parse(card.dataset.categories ?? '[]');
        const show = filter === 'all' || cats.includes(filter);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    const urlFilter = new URLSearchParams(window.location.search).get('filter') ?? 'all';
    applyFilter(urlFilter);

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        applyFilter(pill.dataset.filter ?? 'all');
      });
    });
  </script>

  <CTASection />
</Layout>
