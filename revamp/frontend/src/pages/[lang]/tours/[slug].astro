              {whatToBring.length > 0 && (
                <div class="mt-6 pt-5 border-t border-gray-100">
                  <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-3">{t('tourDetail.whatToBring')}</p>
                  <ul class="flex flex-wrap gap-2">
                    {whatToBring.map((item: string) => (
                      <li class="text-sm bg-cream text-gray-700 px-3 py-1.5 border border-orange/20">{item}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}

          {tour.meeting_point && (
            <div aria-labelledby="meeting-heading" class="pt-4 border-t border-gray-100">
              <p class="text-eyebrow text-orange mb-3">{settings?.label_where_to_find_us}</p>
              <h3 id="meeting-heading" class="font-merriweather text-2xl font-bold text-primary mb-4">{t('tourDetail.meetingPoint')}</h3>
              <p class="text-gray-700 leading-relaxed text-sm font-semibold mb-3">{tour.meeting_point}</p>
              {tour.directions_html ? (
                <div class="text-sm text-gray-500 leading-relaxed prose prose-sm max-w-none prose-p:my-1.5" set:html={tour.directions_html} />
              ) : (
                <a href={`/directions/#tour-${tour.slug}`} class="text-sm text-primary hover:text-orange transition-colors">
                  Get directions →
                </a>
              )}
              {tour.cancellation_policy && (
                <p class="mt-5 text-sm text-gray-400 border-t border-gray-100 pt-4">
                  <span class="font-semibold text-gray-600">{t('tourDetail.cancellation')}</span>{tour.cancellation_policy}
                </p>
              )}
            </div>
          )}

          <div aria-labelledby="before-heading" class="pt-4 border-t border-gray-100">
            <p class="text-eyebrow text-orange mb-3">{settings?.label_good_to_know}</p>
            <h3 id="before-heading" class="font-merriweather text-2xl font-bold text-primary mb-5">{t('tourDetail.beforeYouJoin')}</h3>
            {tour.walking_distance && (
              <p class="text-sm text-gray-600 mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 text-orange/60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                This tour covers roughly <strong>{tour.walking_distance}</strong> on foot — flat streets, comfortable pace.
              </p>
            )}
            <a href="/how-to-prepare/" class="group flex items-center gap-4 border border-gray-100 p-4 hover:border-orange/30 hover:shadow-sm transition-all duration-200">
              <div class="w-8 h-8 flex-shrink-0 bg-primary/6 flex items-center justify-center text-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <div class="flex-1">
                <p class="font-semibold text-gray-900 text-sm group-hover:text-primary transition-colors">{t('tourDetail.howToPrepare')}</p>
                <p class="text-xs text-gray-400">{t('tourDetail.whatToWear')}</p>
              </div>
              <svg class="w-3.5 h-3.5 text-gray-300 group-hover:text-orange group-hover:translate-x-0.5 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>

          {faqs.length > 0 && (
            <div aria-labelledby="faq-heading" class="pt-4 border-t border-gray-100">
              <p class="text-eyebrow text-orange mb-3">{settings?.label_common_questions}</p>
              <h3 id="faq-heading" class="font-merriweather text-2xl font-bold text-primary mb-8">{t('tourDetail.questionsWeHear')}</h3>
              <div>
                {faqs.map((faq: any) => (
                  <div class="border-b border-gray-100 last:border-0 py-5">
                    <p class="font-merriweather font-semibold text-gray-800 text-sm mb-2">{faq.question}</p>
                    <p class="text-gray-500 text-sm leading-relaxed" set:html={renderInlineMarkdown(faq.answer)} />
                  </div>
                ))}
              </div>
            </div>
          )}

        </section>

        <!-- ===================== FURTHER READING ===================== -->
        {relatedStories.length > 0 && (
          <section aria-labelledby="further-reading-heading">
            <p class="text-eyebrow text-orange mb-3">{settings?.label_background}</p>
            <h2 id="further-reading-heading" class="font-merriweather text-2xl font-bold text-primary mb-2">{t('tourDetail.furtherReading')}</h2>
            <p class="text-gray-500 text-sm mb-8">The food on this tour has a history. Here's some of it.</p>
            <div class="grid sm:grid-cols-2 gap-6">
              {relatedStories.map((s: any) => (
                <a
                  href={`/stories/${s.slug}/`}
                  class="group bg-white border border-gray-100 hover:border-orange/30 hover:shadow-sm transition-all duration-200 flex flex-col overflow-hidden"
                >
                  {s.hero_image && (
                    <img
                      src={s.hero_image}
                      alt={s.title}
                      class="w-full h-40 object-cover group-hover:opacity-90 transition-opacity duration-300"
                      loading="lazy"
                      width={600}
                      height={320}
                    />
                  )}
                  <div class="p-5 flex flex-col flex-1">
                    {s.category && (
                      <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-gray-400 mb-2">{s.category}</span>
                    )}
                    <h3 class="font-merriweather font-bold text-primary text-base leading-snug mb-2 group-hover:text-orange transition-colors duration-200 line-clamp-2">{s.title}</h3>
                    {s.excerpt && (
                      <p class="text-sm text-gray-500 leading-relaxed line-clamp-2 mb-4 flex-1">{s.excerpt}</p>
                    )}
                    <span class="text-xs font-semibold text-primary group-hover:text-orange transition-colors duration-200 mt-auto">{t('tourDetail.readMore')}</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- ===================== GUIDE TOURS (guide pages only) ===================== -->
        {!isBookable && guideTours.length > 0 && (
          <section id="our-tours" class="bg-dark rounded-xl px-6 md:px-10 py-10">
            <p class="text-eyebrow text-orange mb-3">Ready to taste it?</p>
            <h2 class="font-merriweather text-2xl md:text-3xl font-bold text-white mb-3">
              {(t('tourDetail.ourCityTours') || 'Our {city} Food Tours').replace('{city}', tour.location)}
            </h2>
            <p class="text-white/55 text-sm mb-8 leading-relaxed max-w-2xl">
              This guide covers a lot of ground. If you want to actually eat your way through {tour.location} with us — here's where to start.
            </p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {guideTours.map((gt: any) => (
                <a
                  href={`/tours/${gt.slug}/`}
                  class="group bg-white/[0.05] border border-white/[0.08] hover:border-orange/40 hover:bg-white/[0.08] transition-all duration-200 flex flex-col overflow-hidden"
                >
                  {gt.hero_image && (
                    <img
                      src={gt.hero_image}
                      alt={gt.name}
                      class="w-full h-36 object-cover group-hover:opacity-90 transition-opacity duration-300"
                      loading="lazy"
                      width={480}
                      height={270}
                    />
                  )}
                  <div class="p-5 flex flex-col flex-1">
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-orange mb-1.5">{gt.location} · Food Tour</p>
                    <h3 class="font-merriweather font-bold text-white text-base leading-snug mb-2 group-hover:text-orange transition-colors">{gt.name}</h3>
                    {gt.tagline && (
                      <p class="text-white/50 text-xs leading-relaxed mb-3 flex-1 line-clamp-2">{gt.tagline}</p>
                    )}
                    <div class="flex items-center justify-between mt-auto pt-3 border-t border-white/[0.08]">
                      {gt.price && <span class="text-orange font-bold text-sm">{gt.currency ?? 'RM'} {gt.price}</span>}
                      <span class="text-xs font-semibold text-orange group-hover:translate-x-0.5 transition-transform ml-auto">{t('tourDetail.seeTour')}</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- ===================== INTERNAL LINKS ===================== -->
        <section class="pt-8 border-t border-gray-100">
          <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-gray-400 mb-4">{t('tourDetail.seeMore')}</p>
          <div class="flex flex-wrap gap-2">
            {tour.location === 'Kuala Lumpur' && (
              <>
                <a href="/tours/locations/kuala-lumpur/" class="text-sm text-primary hover:text-orange transition-colors underline">Kuala Lumpur food tours</a>
                <span class="text-gray-300">·</span>
              </>
            )}
            {tour.location === 'Penang' && (
              <>
                <a href="/tours/locations/penang/" class="text-sm text-primary hover:text-orange transition-colors underline">Penang food tours</a>
                <span class="text-gray-300">·</span>
              </>
            )}
            {tour.dietary_options?.includes('Vegetarian') && (
              <>
                <a href="/tours/dietary/vegetarian/" class="text-sm text-primary hover:text-orange transition-colors underline">Vegetarian food tours</a>
                <span class="text-gray-300">·</span>
              </>
            )}
            <a href="/stories/" class="text-sm text-primary hover:text-orange transition-colors underline">Malaysian food stories</a>
            <span class="text-gray-300">·</span>
            <a href="/about/" class="text-sm text-primary hover:text-orange transition-colors underline">About Simply Enak</a>
          </div>
        </section>
      </div>

      <!-- Sidebar (bookable tours only) -->
      {isBookable && (
        <div class="lg:col-span-4">
          <div id="booking" class="lg:sticky lg:top-8">
            <div class="lg:hidden bg-white rounded-xl shadow-lg border border-gray-100 p-5 mb-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <div class="text-xs text-gray-500">{t('common.from') || 'From'}</div>
                  <div class="text-2xl font-bold text-primary">{tour.currency ?? 'RM'} {tour.price}<span class="text-sm text-gray-500 font-normal"> / {t('tourDetail.perPerson')}</span></div>
                </div>
                {tour.ticketing_hub_id?.trim() ? (
                  <button
                    data-widget-trigger={tour.ticketing_hub_id}
                    class="flex-shrink-0 bg-orange text-dark font-bold py-3 px-5 text-sm hover:bg-orange/90 transition-colors"
                  >
                    {t('tourDetail.checkAvailability')}
                  </button>
                ) : (
                  <a
                    href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hi! I'd like to join the ${tour.name} (RM ${tour.price}/person). Can you tell me about availability?`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-shrink-0 bg-orange text-dark font-bold py-3 px-5 text-sm hover:bg-orange/90 transition-colors"
                  >
                    {t('tourDetail.checkAvailability')}
                  </a>
                )}
              </div>
              <p class="text-xs text-gray-400 mt-3">{t('tourDetail.freeCancellation24h')}</p>
            </div>
            <TourSidebar
              price={tour.price}
              widgetId={tour.ticketing_hub_id}
              productName={tour.name}
            />
          </div>
        </div>
      )}

    </div>
  </div>

  <CTASection whatsappNumber={settings?.whatsapp_number} />


</Layout>

<style>
  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-reveal {
    animation: heroReveal 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-d1 { animation-delay: 0.1s; }
  .hero-d2 { animation-delay: 0.28s; }
  .hero-d3 { animation-delay: 0.46s; }
  .hero-d4 { animation-delay: 0.62s; }
  .hero-d5 { animation-delay: 0.78s; }
  .hero-d6 { animation-delay: 0.94s; }

  .vendor-polaroid {
    background-color: #eaeaea;
    padding: 14px 14px 44px;
    transform: rotate(var(--rot, 0deg));
    box-shadow: 2px 4px 14px rgba(0,0,0,0.18), 0 1px 3px rgba(0,0,0,0.12);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .vendor-polaroid-wrap:hover .vendor-polaroid {
    transform: rotate(0deg) scale(1.04);
    box-shadow: 4px 8px 24px rgba(0,0,0,0.22), 0 2px 6px rgba(0,0,0,0.14);
  }
  .vendor-caption {
    font-family: 'Caveat', cursive;
    font-size: 1.1rem;
    font-weight: 500;
    color: #2c2c2c;
    text-align: center;
    margin-top: 16px;
  }
  .vendor-caption-sub {
    font-family: 'Caveat', cursive;
    font-size: 0.9rem;
    color: #888;
    text-align: center;
    margin-top: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal { animation: none; opacity: 1; transform: none; }
    .scroll-animate img { transition: none !important; transform: none !important; }
  }
</style>

<script>
  // Subtle parallax effect on hero image - only if reduced motion is not preferred
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  if (!prefersReducedMotion) {
    const heroImage = document.querySelector('.hero-reveal + img[src]');
    if (heroImage) {
      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        const maxScroll = window.innerHeight * 0.5;
        const parallax = Math.min(scrolled / maxScroll, 1) * 10;
        heroImage.style.transform = `translateY(${parallax}px) scale(1.02)`;
      }, { passive: true });
    }
  }
</script>
