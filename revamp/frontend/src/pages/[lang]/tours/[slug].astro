---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getAllTours, getTourBySlug, getVendorsByTour, getFAQsByPage, getTestimonialsByPage, getSiteSettings, getAllStories, getRelatedStories, getMainTourSlugs } from "@/lib/content";
import { SUPPORTED_LANGS } from "@/i18n/utils";
import { useTranslations } from "@/i18n/utils";
import { siteConfig } from "@/lib/site-config";
import siteSettingsData from "@/data/content/site-settings.json";
import allToursData from "@/data/content/tours.json";
import TourSidebar from "@/components/Tours/TourSidebar.astro";
import CTASection from "@/components/CTASection.astro";
import ReviewCard from "@/components/TourDetails/ReviewCard.astro";
import SocialProof from "@/components/SocialProof.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import { renderInlineMarkdown, stripMarkdown } from '@/lib/render-inline-markdown';
import { TOUR_CHIPS } from '@/lib/tour-chips';
import type { ChipCfg } from '@/lib/tour-chips';



export async function getStaticPaths() {
  // Non-English language variants only — English lives at /tours/[slug]/

  const tours = await getAllTours();
  return SUPPORTED_LANGS.flatMap((lang: string) =>
    (tours as any[]).map((tour: any) => ({ params: { lang, slug: tour.slug } }))
  );
}

const { lang, slug } = Astro.params;
const t = useTranslations(lang as any);
const [tour, generalFaqs, tourFaqs, generalTestimonials, tourTestimonials, settings, allStories] = await Promise.all([
  getTourBySlug(slug, lang),
  getFAQsByPage("tours", lang),
  getFAQsByPage(slug, lang),
  getTestimonialsByPage("tours", lang),
  getTestimonialsByPage(slug, lang),
  getSiteSettings(),
  getAllStories({}, lang),
]);

const seenIds = new Set(tourFaqs.map((f: any) => f.id));
const faqs = [...tourFaqs, ...generalFaqs.filter((f: any) => !seenIds.has(f.id))];

const seenTestimonialIds = new Set(tourTestimonials.map((t: any) => t.id));
const testimonials = [...tourTestimonials, ...generalTestimonials.filter((t: any) => !seenTestimonialIds.has(t.id))];

const vendors = tour ? await getVendorsByTour(slug) : [];

if (!tour) return Astro.redirect("/tours/");

const relatedStories = getRelatedStories(tour, allStories, 2);

const whatsapp = (settings?.whatsapp_number ?? siteConfig.whatsappNumber).replace(/\D/g, '');
const isBookable = tour.is_bookable === true || !!(tour.ticketing_hub_id?.trim());

// For guide pages: load real tours in the same city to route readers to bookable products
const mainTourSlugs = getMainTourSlugs();
const realTours: any[] = (allToursData as any[]).filter((t: any) => mainTourSlugs.includes(t.slug));
const guideTours: any[] = !isBookable
  ? (realTours.filter((t: any) => t.location === tour.location).length > 0
      ? realTours.filter((t: any) => t.location === tour.location)
      : realTours.slice(0, 3))
  : [];

function parseField(val: any, fallback: any[] = []) {
  if (!val) return fallback;
  if (Array.isArray(val)) return val;
  try { return JSON.parse(val); } catch { return fallback; }
}

const highlights: string[]      = parseField(tour.highlights);
const included: string[]        = parseField(tour.whats_included);
const excluded: string[]        = parseField(tour.whats_excluded);
const dietary: string[]         = parseField(tour.dietary_options);
const travelTypes: string[]     = parseField(tour.travel_types);
const specialties: string[]     = parseField(tour.specialty_experiences);
const whatToBring: string[]     = parseField(tour.what_to_bring);
const languages: string[]       = parseField(tour.languages_offered);
const gallery: string[]         = parseField(tour.gallery_images);
const galleryAlts: (string | null)[] = Array.isArray(tour.gallery_image_alts) ? tour.gallery_image_alts : [];

interface ItineraryStop {
  time: string;
  title: string;
  description: string;
  tastings?: string[];
  cultural_context?: string;
}
const itinerary: ItineraryStop[] = parseField(tour.itinerary);

const allTags = [...dietary, ...travelTypes, ...specialties];

// TOUR_CHIPS imported from @/lib/tour-chips

function toIsoDuration(minutes: number | null | undefined): string | undefined {
  if (!minutes) return undefined;
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return h > 0 && m > 0 ? `PT${h}H${m}M` : h > 0 ? `PT${h}H` : `PT${m}M`;
}

const structuredData: Record<string, any> = {
  "@type": isBookable ? "TouristTrip" : "Article",
  "name": tour.name,
  "description": tour.short_description,
  "image": tour.hero_image,
  "url": `https://simplyenak.com/tours/${tour.slug}/`,
  ...(isBookable && tour.price ? {
    "offers": {
      "@type": "Offer",
      "price": String(tour.price),
      "priceCurrency": tour.currency,
      "availability": tour.instant_confirmation ? "https://schema.org/InStock" : "https://schema.org/PreOrder",
      "url": `https://simplyenak.com/tours/${tour.slug}/`,
      "priceValidUntil": `${new Date().getFullYear()}-12-31`,
    },
  } : {}),
  "touristType": travelTypes,
  "provider": { "@id": "https://simplyenak.com/#localbusiness" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "bestRating": "5",
    "reviewCount": siteSettingsData.review_count ?? 5000,
  },
};

const isoDuration = toIsoDuration(tour.duration_minutes);
if (isoDuration) structuredData["duration"] = isoDuration;
if (tour.max_participants) structuredData["maximumAttendeeCapacity"] = tour.max_participants;
if (languages.length > 0) structuredData["inLanguage"] = languages;

// startLocation: helps search engines understand exactly where this tour begins
if (tour.meeting_point) {
  structuredData["startLocation"] = {
    "@type": "Place",
    "name": tour.meeting_point,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": tour.location,
      "addressCountry": "MY",
    },
  };
}

// keywords from specialty_experiences (e.g. "Chinatown", "Petaling Street") — local area signals
const specialtyExperiences: string[] = Array.isArray(tour.specialty_experiences) ? tour.specialty_experiences : [];
if (specialtyExperiences.length > 0) {
  structuredData["keywords"] = specialtyExperiences.join(", ") + `, ${tour.location} food tour, Malaysia food tour`;
}

if (itinerary.length > 0) {
  structuredData["itinerary"] = itinerary.map((stop: any) => ({
    "@type": "TouristAttraction",
    "name": stop.title,
    "description": stop.description,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": tour.location,
      "addressCountry": "MY",
    },
  }));
}

// Individual Review nodes from real testimonials
if (testimonials.length > 0) {
  structuredData["review"] = testimonials.slice(0, 5).map((t: any) => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": t.author_name,
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": String(t.rating),
      "bestRating": "5",
    },
    "reviewBody": t.review_text,
    ...(t.date ? { "datePublished": t.date } : {}),
  }));
}

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://simplyenak.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://simplyenak.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": tour.name, "item": `https://simplyenak.com/tours/${tour.slug}/` },
  ],
};

// FAQPage schema — AI citation signal (Perplexity/Claude cite this heavily)
const faqSchema = faqs.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": stripMarkdown(faq.answer),
    },
  })),
} : null;

---

<Layout
  title={tour.meta_title ?? `${tour.name} | Simply Enak`}
  description={tour.meta_description ?? tour.short_description}
  image={tour.hero_image}
  structuredData={[structuredData, breadcrumbSchema, faqSchema].filter(Boolean)}
  noindex={tour.noindex === true || !isBookable}
  hreflangPath={`/tours/${slug}/`}
  hreflangEnOnly={tour.noindex === true || !isBookable}
>

  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-[85vh] flex items-end bg-dark overflow-hidden scroll-animate is-visible">
    {tour.hero_image && (
      <img
        src={tour.hero_image}
        alt={tour.hero_image_alt || tour.name}
        class="absolute inset-0 w-full h-full object-cover opacity-60 scale-[1.02] scroll-animate"
        loading="eager"
        fetchpriority="high"
        width={1920}
        height={1080}
        style="transition: transform 1.5s ease-out;"
      />
    )}
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,9,9,0.98) 0%, rgba(10,9,9,0.75) 40%, rgba(10,9,9,0.2) 75%, transparent 100%);"></div>

    <div class="relative z-10 main-container w-full pb-16 pt-40">

      <!-- Location eyebrow + special badges -->
      <div class="hero-reveal hero-d1 flex flex-wrap items-center gap-2.5 mb-5">
        <span class="text-h6 tracking-[0.25em] text-orange">Simply Enak · {tour.location} · Food Tour</span>
        {tour.featured && <span class="px-2.5 py-0.5 bg-orange text-dark text-h6 tracking-widest" aria-label="Bestseller tour">Bestseller</span>}
        {tour.new && <span class="px-2.5 py-0.5 bg-blue-500 text-white text-h6 tracking-widest" aria-label="New tour">New</span>}
        {tour.instant_confirmation && <span class="px-2.5 py-0.5 bg-green-600 text-white text-h6 tracking-widest" aria-label="Instant confirmation available">✓ Instant</span>}
      </div>

      <!-- Title -->
      <h1 class="hero-reveal hero-d2 font-merriweather font-bold text-white leading-[1.05] mb-4" style="font-size: clamp(2.4rem, 6vw, 5rem);">
        {tour.name}
      </h1>

      {tour.tagline && (
        <p class="hero-reveal hero-d3 text-white/60 mb-6 max-w-xl leading-relaxed" style="font-size: clamp(1rem, 1.8vw, 1.2rem);">{tour.tagline}</p>
      )}

      <!-- Qualifying tags — dietary + travel style — visible immediately -->
      {allTags.length > 0 && (
        <div class="hero-reveal hero-d4 flex flex-wrap gap-2 mb-6">
          {dietary.map((d: string) => (
            <span class="px-3 py-1 text-xs font-semibold rounded-full bg-white/10 text-white/80 border border-white/15 backdrop-blur-sm">{d}</span>
          ))}
          {travelTypes.map((t: string) => (
            <span class="px-3 py-1 text-xs font-semibold rounded-full bg-white/10 text-white/80 border border-white/15 backdrop-blur-sm">{t}</span>
          ))}
          {specialties.map((s: string) => (
            <span class="px-3 py-1 text-xs font-semibold rounded-full bg-orange/20 text-orange border border-orange/25 backdrop-blur-sm">{s}</span>
          ))}
        </div>
      )}

      <!-- Key stats — compact inline -->
      <div class="hero-reveal hero-d5 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-sm text-white/50 mb-10 pb-10 border-b border-white/[0.08]">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-orange/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {tour.duration}
        </span>
        {tour.tour_frequency && (
          <>
            <span class="hidden sm:inline text-white/[0.15]" aria-hidden="true">·</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-orange/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              {tour.tour_frequency}
            </span>
          </>
        )}
        {tour.start_times && (
          <>
            <span class="hidden sm:inline text-white/[0.15]" aria-hidden="true">·</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-orange/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              {tour.start_times}
            </span>
          </>
        )}
        <span class="hidden sm:inline text-white/[0.15]" aria-hidden="true">·</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-orange/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a4.902 4.902 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {tour.min_participants ?? 2}–{tour.max_participants ?? 9} {t('common.people') || 'people'}
        </span>
        <span class="hidden sm:inline text-white/[0.15]" aria-hidden="true">·</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-orange/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {t('tourDetail.freeCancellation')}
        </span>
        {tour.dishes_count && (
          <>
            <span class="hidden sm:inline text-white/[0.15]" aria-hidden="true">·</span>
            <span>{tour.dishes_count} tastings</span>
          </>
        )}
        {tour.difficulty && (
          <>
            <span class="hidden sm:inline text-white/[0.15]" aria-hidden="true">·</span>
            <span>{tour.difficulty}</span>
          </>
        )}
        {languages.length > 0 && (
          <>
            <span class="hidden sm:inline text-white/[0.15]" aria-hidden="true">·</span>
            <span>{languages.slice(0, 2).join(" & ")}</span>
          </>
        )}
      </div>

      <!-- Price — prominent anchor (bookable tours only) -->
      {isBookable && tour.price && (
        <div class="hero-reveal hero-d6 mb-5 leading-none">
          <div class="text-h6 uppercase tracking-[0.2em] text-gray-500 mb-1">{t('common.from') || 'From'}</div>
          <div class="font-merriweather font-bold text-orange" style="font-size: clamp(2.2rem, 5vw, 3rem);">{tour.currency ?? 'RM'} {tour.price}</div>
          <div class="text-body text-white/55 mt-1 tracking-wide">{t('tourDetail.perPerson')} · {t('tourDetail.freeCancellation')}</div>
        </div>
      )}

      <!-- CTAs -->
      <div class="hero-reveal hero-d6 flex flex-wrap items-center gap-4">
        {isBookable ? (
          <a
            href="#booking"
            class="cta-primary min-h-[44px] inline-flex items-center justify-center"
            aria-label={`Check availability for ${tour.name} tour`}
          >
            {t('tourDetail.checkAvailability')}
          </a>
        ) : (
          <a
            href="#our-tours"
            class="cta-primary min-h-[44px] inline-flex items-center justify-center"
            aria-label={`See our ${tour.location} food tours`}
          >
            {t('tourDetail.seeOurTours')}
          </a>
        )}
        <a
          href={`https://wa.me/${whatsapp}?text=Hi! I'm interested in the ${tour.name} tour.`}
          target="_blank"
          rel="noopener noreferrer"
          class="secondary-btn min-h-[44px] inline-flex items-center justify-center"
          aria-label="Ask on WhatsApp"
        >
          {t('tourDetail.askWhatsApp')}
        </a>
      </div>

      <!-- Enhanced Social Proof -->
      <div class="hero-reveal hero-d7 flex flex-wrap items-center gap-6 mt-10 pt-8 border-t border-white/[0.08]">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1">
            <svg class="w-5 h-5 text-orange" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-orange" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-orange" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-orange" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-orange" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <span class="text-white/90 text-sm font-semibold">{siteSettingsData?.rating || '4.9'} {t('common.rating') || 'rating'}</span>
        </div>
        <div class="hidden sm:block text-white/[0.15]" aria-hidden="true">|</div>
        <div class="flex items-center gap-2">
          <span class="text-white/90 text-sm">{siteSettingsData?.guests_hosted || '5,000+'} {t('tourDetail.guests') || 'guests'}</span>
        </div>
        <div class="hidden sm:block text-white/[0.15]" aria-hidden="true">|</div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span class="text-white/90 text-sm">TripAdvisor Travellers' Choice 2023</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Compact Social Proof (removed - now integrated in hero) -->

  <!-- Enhanced breadcrumbs with category context -->
  <Breadcrumb crumbs={[
    { label: t('nav.home') || 'Home', href: '/' },
    { label: t('nav.tours') || 'Tours', href: '/tours/' },
    ...(tour.segment_tags?.includes('kuala-lumpur') || tour.segment_tags?.includes('kl') ? [{ label: 'Kuala Lumpur', href: '/tours/locations/kuala-lumpur/' }] : []),
    ...(tour.segment_tags?.includes('penang') ? [{ label: 'Penang', href: '/tours/locations/penang/' }] : []),
    ...(tour.segment_tags?.includes('dietary') || tour.segment_tags?.includes('vegetarian') || tour.segment_tags?.includes('halal') || tour.segment_tags?.includes('vegan') ? [{ label: 'Dietary Tours', href: '/tours/dietary/vegetarian/' }] : []),
    ...(tour.segment_tags?.includes('neighborhood') ? [{ label: 'Neighborhoods', href: '/tours/' }] : []),
    { label: tour.name, href: `/tours/${tour.slug}/` },
  ].filter(Boolean)} />

  <!-- Guide page notice (informational pages only) -->
  {!isBookable && (
    <div class="bg-amber-50 border-b border-amber-100">
      <div class="main-container py-3 flex items-center gap-3">
        <svg class="w-4 h-4 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-sm text-amber-800">
          {t('tourDetail.notBookable')} <a href="#our-tours" class="font-semibold underline hover:text-amber-900">{t('tourDetail.seeOurTours')}</a>
        </p>
      </div>
    </div>
  )}

  <!-- ===================== QUICK FACTS BAR ===================== -->
  <div class="bg-white border-b border-gray-100">
    <div class="main-container py-5">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 bg-cream rounded-xl border border-orange/10 px-5 py-5 md:px-8 md:py-6 scroll-animate">
        {tour.duration && (
          <div class="flex flex-col items-center text-center gap-1.5">
