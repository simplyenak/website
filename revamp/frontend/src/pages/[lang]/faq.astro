---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import CTASection from "@/components/CTASection.astro";
import Section from "@/components/Design/Section.astro";
import SocialProof from "@/components/SocialProof.astro";
import { getFaqPage, getFAQsByPage } from "@/lib/content";
import { SUPPORTED_LANGS } from "@/i18n/utils";
import { renderInlineMarkdown, stripMarkdown } from '@/lib/render-inline-markdown';

export const prerender = true;

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}


// Get language from URL
const urlLang = (Astro.params.lang as string) || 'en';
const lang = urlLang;

// Fetch FAQ page metadata and FAQ items in parallel
const [faqPage, faqGroups] = await Promise.all([
  getFaqPage(lang),
  getFAQsByPage('faq', lang),
]);

// Group FAQs by category
const categories = {};
faqGroups.forEach((faq) => {
  const category = faq.category || 'general';
  if (!categories[category]) {
    categories[category] = [];
  }
  categories[category].push(faq);
});

// Convert to array format for rendering
const groupedFaqs = Object.entries(categories).map(([id, faqs]) => ({
  id,
  title: id.charAt(0).toUpperCase() + id.slice(1).replace(/_/g, ' '),
  faqs,
}));

const allFaqs = groupedFaqs.flatMap((g) => g.faqs);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: allFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: stripMarkdown(faq.answer),
    },
  })),
};
---

<Layout
  title={faqPage?.meta_title}
  description={faqPage?.meta_description}
  structuredData={faqSchema}
  hreflangPath="/faq/"
>
  <GlobalHero
    title={faqPage?.hero_title}
    subtitle={faqPage?.hero_subtitle}
  />

  <!-- Social Proof -->
  <SocialProof variant="compact" />

  <Section variant="light" animate={true}>
    <div class="max-w-3xl mx-auto space-y-14">
      {
        groupedFaqs.map((group, groupIndex) => (
          <div class="scroll-animate" style={`transition-delay: ${groupIndex * 100}ms`}>
            <h2 class="text-h2 text-primary mb-6">
              {group.title}
            </h2>
            <div class="space-y-3">
              {group.faqs.map((faq, faqIndex) => (
                <details class="bg-white rounded-lg shadow-sm border border-gray-100 group scroll-animate" style={`transition-delay: ${faqIndex * 50}ms`}>
                  <summary class="flex items-center justify-between p-5 cursor-pointer list-none font-semibold text-gray-900 hover:text-primary transition-colors duration-200 min-h-[44px]" aria-label={`Toggle question: ${faq.question}`}>
                    <span>{faq.question}</span>
                    <span class="ml-4 text-primary flex-shrink-0 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 4v16m8-8H4"
                        />
                      </svg>
                    </span>
                  </summary>
                  <div class="px-5 pb-5 pt-4 text-body text-gray-700 leading-relaxed border-t border-gray-100" set:html={renderInlineMarkdown(faq.answer)} />
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CTASection />
</Layout>
