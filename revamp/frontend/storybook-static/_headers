  Content-Security-Policy: upgrade-insecure-requests; default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://assets.ticketinghub.com https://challenges.cloudflare.com https://livechat.myalice.ai; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://se-website-images.s3.nl-ams.scw.cloud https://cdn.simplyenak.com https://ui-avatars.com data:; connect-src 'self' https://cdn.simplyenak.com https://www.google-analytics.com https://analytics.google.com https://api.ticketinghub.com https://livechat.myalice.ai https://contact.simplyenak.com; frame-src https://challenges.cloudflare.com https://assets.ticketinghub.com; object-src 'none'; base-uri 'self';
