# Payload Configuration for Simply Enak Frontend

# Payload API URL (local development — note: port 3000, not 1337)
PUBLIC_PAYLOAD_URL=http://localhost:3000

# Payload API URL (Production/Staging)
# Set in Cloudflare Pages environment variables:
# Production: https://cms.system.simplyenak.com
# Staging: https://cms-staging.system.simplyenak.com

# Site Configuration
PUBLIC_SITE_URL=https://simplyenak.com
PUBLIC_SITE_NAME="Simply Enak - Malaysian Food Tours"

# Contact Form
VITE_FORM_ENDPOINT=https://n8n.system.simplyenak.com/webhook/simply-enak-contact-2024-secure-form
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
