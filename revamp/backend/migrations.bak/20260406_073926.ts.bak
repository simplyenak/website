  ALTER TABLE "stories" ADD CONSTRAINT "stories_slug_unique" UNIQUE("slug");
  ALTER TABLE "vendors" ADD CONSTRAINT "vendors_slug_unique" UNIQUE("slug");
  ALTER TABLE "landing_pages" ADD CONSTRAINT "landing_pages_slug_key" UNIQUE("slug");
  ALTER TABLE "travel_types" ADD CONSTRAINT "travel_types_slug_key" UNIQUE("slug");
  ALTER TABLE "specialty_experiences" ADD CONSTRAINT "specialty_experiences_slug_key" UNIQUE("slug");
  ALTER TABLE "locations" ADD CONSTRAINT "locations_slug_key" UNIQUE("slug");
  ALTER TABLE "tours" ADD CONSTRAINT "tours_duration_positive" CHECK (duration_minutes > (0)::numeric);
  ALTER TABLE "tours" ADD CONSTRAINT "tours_max_participants_positive" CHECK (max_participants > (0)::numeric);
  ALTER TABLE "tours" ADD CONSTRAINT "tours_min_lte_max" CHECK (min_participants <= max_participants);
  ALTER TABLE "tours" ADD CONSTRAINT "tours_min_participants_positive" CHECK (min_participants > (0)::numeric);
  ALTER TABLE "tours" ADD CONSTRAINT "tours_price_positive" CHECK (price > (0)::numeric);
  ALTER TABLE "testimonials" ADD CONSTRAINT "testimonials_rating_range" CHECK ((rating >= (1)::numeric) AND (rating <= (5)::numeric));
  CREATE VIEW "public"."published_tours" AS (SELECT id, name, slug, price, currency, duration, location, featured, popular FROM tours WHERE status = 'published'::enum_tours_status ORDER BY featured DESC, name);
  CREATE VIEW "public"."featured_testimonials" AS (SELECT id, author_name, author_location, rating, review_text, platform, date FROM testimonials WHERE visibility_featured = true ORDER BY rating DESC, date DESC);
  CREATE VIEW "public"."published_stories" AS (SELECT id, title, slug, author_id, excerpt, published_date, status FROM stories WHERE status = 'published'::enum_stories_status ORDER BY published_date DESC);
  CREATE VIEW "public"."content_overview" AS (SELECT ( SELECT count(*) AS count FROM tours WHERE tours.status = 'published'::enum_tours_status) AS published_tours, ( SELECT count(*) AS count FROM tours WHERE tours.status = 'draft'::enum_tours_status) AS draft_tours, ( SELECT count(*) AS count FROM stories WHERE stories.status = 'published'::enum_stories_status) AS published_stories, ( SELECT count(*) AS count FROM testimonials) AS total_testimonials, ( SELECT count(*) AS count FROM vendors WHERE vendors.status = 'published'::enum_vendors_status) AS published_vendors, ( SELECT count(*) AS count FROM vendors WHERE vendors.status = 'draft'::enum_vendors_status) AS draft_vendors);
