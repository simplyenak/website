# Payload CMS — Required Environment variables

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/payload_local

# Payload encryption key (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Server URL
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Admin credentials (first-run seed)
ADMIN_EMAIL=admin@simplyenak.com
ADMIN_PASSWORD=changeme

# S3 Storage (optional — for media uploads)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
