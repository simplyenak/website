{
  "collectionName": "components_video_videos",
  "info": {
    "displayName": "Video"
  },
  "options": {},
  "attributes": {
    "fileType": {
      "type": "enumeration",
      "default": "external",
      "enum": [
        "upload",
        "external"
      ]
    },
    "url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fileType"
            },
            "external"
          ]
        }
      },
      "required": true
    },
    "videoFile": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "fileType"
            },
            "upload"
          ]
        }
      },
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "videos"
      ]
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "muted": {
      "type": "boolean",
      "default": false
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "controls": {
      "type": "boolean",
      "default": true
    }
  },
  "config": {}
}
