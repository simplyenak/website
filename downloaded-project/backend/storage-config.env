# Add this to your .env in Dokploy for cloud storage (optional)

# AWS S3 Configuration (recommended for production)
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=your-strapi-uploads-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Or use local storage with persistent volumes (already configured in docker-compose.production.yml)
