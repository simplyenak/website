---
type Props = {
  title?: string
  description?: string
  isBookingButton?: boolean
}
let { title, description, isBookingButton } = Astro.props
---

<section class="main-container">
  <div class="border-t border-text/10 pt-10 pb-16 text-center space-y-4">
    <h4 class="text-h4 text-primary">{title}</h4>
    <h5 class="text-h5 normal-case max-w-[900px] mx-auto font-medium">
      {description}
    </h5>
    {
      isBookingButton && (
        <>
          <a
            href="https://www.ticketinghub.com"
            style="display:none !important;"
          >
            www.ticketinghub.com
          </a>
          <script
            is:inline
            src="https://assets.ticketinghub.com/checkout.js"
            data-widget="468c4fec-ac58-4055-92c4-8cfefe20b716"
          />
        </>
      )
    }
  </div>
</section>
