---
import '~/styles/global.css';
import type { PageProps } from '~/env.d';

const { title, description, image, imageAlt, canonicalURL, noindex } = Astro.props;
const currentPath = Astro.url.pathname;

const SITE_NAME = 'Culinary Travel Experts';
const SITE_URL = 'https://culinarytravelexperts.com';

const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const fullDescription = description || 'Food and heritage ground partner in Malaysia for travel professionals. 15 years on the ground, structured for trade partners.';
const metaImage = image || 'https://cdn.simplyenak.com/cte-default-og-image.webp';
const metaCanonical = canonicalURL || `${SITE_URL}${currentPath}`;

const navLinks = [
  { href: '/what-we-do/', label: 'What We Do' },
  { href: '/itineraries/', label: 'Itineraries' },
  { href: '/partner-with-us/', label: 'Partner With Us' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/about/', label: 'About' },
  { href: '/trade-kit.html', label: 'Trade Kit' },
];

const footerServices = [
  { href: '/what-we-do/', label: 'What We Do' },
  { href: '/itineraries/', label: 'Itineraries' },
  { href: '/partner-with-us/', label: 'Partner With Us' },
  { href: '/destinations/', label: 'Destinations' },
];

const footerCompany = [
  { href: '/about/', label: 'About' },
  { href: '/contact.html', label: 'Contact' },
];

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={fullDescription} />
  <link rel="canonical" href={metaCanonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={fullDescription} />
  <meta property="og:image" content={metaImage} />
  <meta property="og:url" content={metaCanonical} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={fullDescription} />
  <meta name="twitter:image" content={metaImage} />
  {noindex && <meta name="robots" content="noindex" />}

  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet" />

  <!-- GA4 library: loads immediately for Consent Mode v2 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-KL53TYM1YR"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;

    // Consent Mode v2: default all signals to denied.
    // GA4 still receives cookieless pings (aggregate traffic counts).
    // Visitors who accept via cookie banner upgrade to granted.
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
      url_passthrough: true,
    });

    // Auto-upgrade returning conceded visitors
    try {
      if (localStorage.getItem('se_cte_cookie_consent') === 'accepted') {
        gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        });
        window._ga4Consented = true;
      }
    } catch (e) {}

    gtag('js', new Date());
    gtag('config', 'G-KL53TYM1YR', {
      send_page_view: true,
      anonymize_ip: true,
    });
  </script>

  <!-- Consent state change listeners -->
  <script>
    document.addEventListener('cookieConsent:accepted', function () {
      gtag('consent', 'update', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted',
      });
      window._ga4Consented = true;
    });

    document.addEventListener('cookieConsent:declined', function () {
      gtag('consent', 'update', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
      window._ga4Consented = false;
    });
  </script>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Skip to content -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-brand-700 focus:font-bold focus:rounded focus:shadow-lg">
    Skip to main content
  </a>

  <!-- Navigation -->
  <nav class="bg-white/90 backdrop-blur border-b border-brand-100 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2">
        <span class="font-serif text-lg sm:text-xl font-semibold text-brand-800">
          Culinary <span class="text-accent">Travel</span> Experts
        </span>
      </a>
      <button id="nav-toggle" class="md:hidden p-2" aria-label="Toggle navigation" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div id="nav-links" class="hidden md:flex items-center gap-6">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors ${
              currentPath === link.href || currentPath.startsWith(link.href)
                ? 'text-accent'
                : 'text-brand-700 hover:text-accent'
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="nav-mobile" class="hidden md:hidden border-t border-brand-100 bg-white/95 backdrop-blur">
      <div class="px-4 py-3 space-y-2">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`block py-2 text-sm font-medium ${
              currentPath === link.href ? 'text-accent' : 'text-brand-700'
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Main -->
  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-brand-800 text-white/80 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <p class="font-serif text-lg text-white">
            Culinary <span class="text-accent">Travel</span> Experts
          </p>
          <p class="mt-2 text-sm text-white/60">
            Food and heritage ground partner in Malaysia. The trade-facing side of Simply Enak's 15 years of local knowledge.
          </p>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3">Pages</h4>
          <ul class="space-y-2 text-sm">
            {footerServices.map(link => (
              <li><a href={link.href} class="hover:text-accent transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3">Company</h4>
          <ul class="space-y-2 text-sm">
            {footerCompany.map(link => (
              <li><a href={link.href} class="hover:text-accent transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 mt-8 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-white/50">
        <span>&copy; {currentYear} Local Culinary Travel Experiences Sdn. Bhd.</span>
        <span>Part of <a href="https://simplyenak.com" class="text-accent hover:underline">Simply Enak</a></span>
      </div>
    </div>
  </footer>

  <!-- Cookie consent notice (subtle footer bar) -->
  <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[2000] bg-brand-900/95 backdrop-blur border-t border-white/10 px-4 py-3 hidden" role="dialog" aria-label="Cookie consent" aria-live="polite">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <p class="text-sm text-white/80 flex-1">
        We use cookies to improve your experience and understand how you use our site.
        <a href="/privacy" class="text-accent underline hover:text-accent-hover transition-colors ml-1">Learn more</a>
      </p>
      <div class="flex gap-2 flex-shrink-0">
        <button id="cookie-decline" class="text-sm text-white/50 hover:text-white/80 border border-white/20 px-3 py-1.5 rounded-lg hover:border-white/40 transition-all cursor-pointer">
          Decline
        </button>
        <button id="cookie-accept" class="text-sm font-semibold bg-accent text-white px-4 py-1.5 rounded-lg hover:bg-accent-hover transition-colors cursor-pointer">
          Accept
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav toggle + Cookie consent logic -->
  <script>
    // Mobile nav
    const navToggle = document.getElementById('nav-toggle');
    const navMobile = document.getElementById('nav-mobile');
    if (navToggle && navMobile) {
      navToggle.addEventListener('click', () => {
        const isOpen = !navMobile.classList.contains('hidden');
        navMobile.classList.toggle('hidden');
        navToggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    // Cookie consent
    const CONSENT_KEY = 'se_cte_cookie_consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');

    function showBanner() {
      if (!banner) return;
      setTimeout(() => banner.classList.remove('hidden'), 800);
    }

    function hideBanner() {
      if (!banner) return;
      banner.classList.add('hidden');
    }

    try {
      const consent = localStorage.getItem(CONSENT_KEY);
      if (!consent) showBanner();
    } catch (e) {
      showBanner();
    }

    acceptBtn?.addEventListener('click', () => {
      try { localStorage.setItem(CONSENT_KEY, 'accepted'); } catch (e) {}
      hideBanner();
      document.dispatchEvent(new Event('cookieConsent:accepted'));
    });

    declineBtn?.addEventListener('click', () => {
      try { localStorage.setItem(CONSENT_KEY, 'declined'); } catch (e) {}
      hideBanner();
      document.dispatchEvent(new Event('cookieConsent:declined'));
    });
  </script>
</body>
</html>
