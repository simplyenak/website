---
import PageLayout from '~/layouts/PageLayout.astro';
---

<PageLayout title="Contact" description="Get in touch with Culinary Travel Experts. We respond within 24 hours.">

  <!-- Hero -->
  <section class="bg-brand-800 text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-white max-w-2xl">Get in Touch</h1>
      <p class="mt-6 text-lg text-white/85 max-w-3xl">Whether you have a client brief, a question about a destination, or just want to know if we can handle something. We respond within 24 hours.</p>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <span class="inline-block text-accent text-sm font-semibold tracking-wide uppercase mb-2">Send a Brief</span>
          <h2 class="text-3xl font-serif font-bold text-brand-900">Tell us about your client or group.</h2>
          <p class="mt-4 text-lg text-brand-700">Every field is optional. The more you share, the more precise our first proposal will be.</p>
          <form class="mt-8 space-y-5" action="https://formspree.io/f/xpwzgkvd" method="POST">
            <div>
              <label for="name" class="block text-sm font-medium text-brand-800 mb-1">Your name</label>
              <input type="text" id="name" name="name" class="w-full px-4 py-3 rounded-lg border border-brand-200 bg-white focus:outline-none focus:border-accent" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-brand-800 mb-1">Work email</label>
              <input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-lg border border-brand-200 bg-white focus:outline-none focus:border-accent" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-brand-800 mb-1">Company</label>
              <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-lg border border-brand-200 bg-white focus:outline-none focus:border-accent" />
            </div>
            <div>
              <label for="type" class="block text-sm font-medium text-brand-800 mb-1">What kind of partner are you?</label>
              <select id="type" name="partner_type" class="w-full px-4 py-3 rounded-lg border border-brand-200 bg-white focus:outline-none focus:border-accent">
                <option value="">Select...</option>
                <option value="hotel">Hotel / Concierge</option>
                <option value="agent">Travel Agent / DMC</option>
                <option value="organizer">Food Organizer / Chef</option>
                <option value="corporate">Corporate / Incentive</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-brand-800 mb-1">Tell us what you need</label>
              <textarea id="message" name="message" rows="5" placeholder="Group size, dates, destinations, dietary needs, anything we should know..." class="w-full px-4 py-3 rounded-lg border border-brand-200 bg-white focus:outline-none focus:border-accent resize-y"></textarea>
            </div>
            <button type="submit" class="inline-flex items-center px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-accent-hover transition-colors cursor-pointer">
              Send Brief
            </button>
          </form>
        </div>
        <div class="lg:pl-12">
          <div class="p-8 bg-brand-50 rounded-xl border border-brand-100">
            <h3 class="text-xl font-serif font-semibold text-brand-900">Direct contact</h3>
            <p class="mt-4 text-brand-700">Email: <a href="mailto:trade@simplyenak.com" class="text-accent hover:underline">trade@simplyenak.com</a></p>
            <p class="mt-2 text-brand-700">WhatsApp: <a href="https://wa.me/60172878929" class="text-accent hover:underline">+60 17-287 8929</a></p>
            <p class="mt-6 text-sm text-brand-600">Based in Kuala Lumpur, Malaysia. Operating since 2010.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
