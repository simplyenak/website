---
/**
 * MarkdownContent component
 * Renders markdown content from Payload CMS
 */
interface Props {
  content: string;
  className?: string;
}

const { content, className } = Astro.props;

// Convert markdown to HTML
function renderMarkdown(markdown: string): string {
  if (!markdown) return '';
  
  let html = markdown;
  
  // Headers
  html = html.replace(/^### (.*$)/gim, '<h3 class="text-2xl font-bold mt-8 mb-4">$1</h3>');
  html = html.replace(/^## (.*$)/gim, '<h2 class="text-3xl font-bold mt-10 mb-6">$1</h2>');
  html = html.replace(/^# (.*$)/gim, '<h1 class="text-4xl font-bold mt-12 mb-8">$1</h1>');
  
  // Bold
  html = html.replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>');
  
  // Italic
  html = html.replace(/\*(.*)\*/gim, '<em>$1</em>');
  
  // Links
  html = html.replace(/\[(.*)\]\((.*)\)/gim, '<a href="$2" class="text-accent hover:underline">$1</a>');
  
  // Line breaks
  html = html.replace(/\n/gim, '<br />');
  
  // Unordered lists
  html = html.replace(/^- (.*$)/gim, '<li>$1</li>');
  html = html.replace(/(<li>.*<\/li>\n?)+/gim, '<ul class="list-disc pl-6 space-y-2">$&</ul>');
  
  // Ordered lists
  html = html.replace(/^\d+\. (.*$)/gim, '<li>$1</li>');
  html = html.replace(/(<li>.*<\/li>\n?)+/gim, '<ol class="list-decimal pl-6 space-y-2">$&</ol>');
  
  return html;
}
---

<div class:list={{ 'prose prose-lg max-w-none': true, [className || '']: !!className }}>
  {@html renderMarkdown(content)}
</div>
