---
// DM Sans + DM Serif Display loaded via Google Fonts link in Layout
---

<style is:inline>
  :root {
    --aw-font-sans: 'DM Sans';
    --aw-font-serif: 'DM Serif Display';
    --aw-font-heading: 'DM Serif Display';

    --aw-color-primary: rgb(107 80 54);
    --aw-color-secondary: rgb(140 106 69);
    --aw-color-accent: rgb(200 138 50);

    --aw-color-text-heading: rgb(42 32 21);
    --aw-color-text-default: rgb(42 32 21);
    --aw-color-text-muted: rgb(74 56 37 / 66%);
    --aw-color-bg-page: rgb(253 248 243);

    --aw-color-bg-page-dark: rgb(42 32 21);

    ::selection {
      background-color: #c88a32;
      color: white;
    }
  }

  .dark {
    --aw-font-sans: 'DM Sans';
    --aw-font-serif: 'DM Serif Display';
    --aw-font-heading: 'DM Serif Display';

    --aw-color-primary: rgb(200 138 50);
    --aw-color-secondary: rgb(140 106 69);
    --aw-color-accent: rgb(200 138 50);

    --aw-color-text-heading: rgb(248 245 240);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(42 32 21);

    ::selection {
      background-color: #c88a32;
      color: white;
    }
  }
</style>
