---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'About Culinary Travel Experts — Malaysia Food Tour Partner',
  description: 'B2B partner for travel professionals. Licensed by MOTAC. Part of Simply Enak, KL and Penang food tour operator.',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Company"
    title="About Culinary Travel Experts"
    items={[
      {
        title: 'Built on Real Experience',
        description: 'We have been running food experiences across Malaysia since 2011. Every vendor and market we work with is personally known to our team.',
      },
      {
        title: 'Part of Simply Enak',
        description: "Culinary Travel Experts is the trade-facing side of Simply Enak, rated 5 stars on TripAdvisor. The same guides, the same quality, structured for trade partners.",
      },
      {
        title: 'Licensed & Insured',
        description: 'Registered with MOTAC (Ministry of Tourism, Arts and Culture Malaysia). Fully insured for public liability, with certified guides and food safety protocols.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/kl-street-food-tour-chinatown-char-siu-bao-hidden-vendor-steamer.jpg',
      alt: 'Street food in Kuala Lumpur',
    }}
  >
    <Fragment slot="content">
      We help travel professionals deliver Malaysian food experiences. You bring the client. We handle the details.
    </Fragment>
  </Content>
</Layout>
