---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'About Culinary Travel Experts — Food Culture & Heritage',
  description: 'Food culture and heritage ground partner in Malaysia. Licensed by MOTAC. Part of Simply Enak.',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Company"
    title="About Culinary Travel Experts"
    items={[
      {
        title: 'Built on Real Food Culture',
        description: 'We have been connecting travelers with Malaysia\'s food heritage since 2011. Every vendor we work with is personally known to us. Family recipes, traditional techniques, local producers who have been feeding their communities for generations.',
      },
      {
        title: 'Part of Simply Enak',
        description: "Culinary Travel Experts is the trade-facing side of Simply Enak, rated 5 stars on TripAdvisor. The same guides, the same community relationships, structured for trade partners.",
      },
      {
        title: 'Licensed & Insured',
        description: 'Registered with MOTAC (Ministry of Tourism, Arts and Culture Malaysia). Fully insured for public liability, with certified guides and food safety protocols.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/kl-street-food-tour-chinatown-char-siu-bao-hidden-vendor-steamer.jpg',
      alt: 'Street food in Kuala Lumpur',
    }}
  >
    <Fragment slot="content">
      We help travel professionals deliver Malaysian food experiences rooted in culture and community. You bring the client. We handle the details.
    </Fragment>
  </Content>
</Layout>
