---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'About',
  description: 'About Culinary Travel Experts — your food and heritage ground partner in Malaysia.',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Company"
    title="About Culinary Travel Experts"
    items={[
      { title: '15 Years on the Ground', description: 'Running food experiences across Malaysia since 2011. Every vendor personally vetted.' },
      { title: 'Part of Simply Enak', description: "The B2B arm of Simply Enak, KL & Penang's top-rated food tour operator." },
      { title: 'Licensed & Insured', description: 'Licensed tour operator, registered with MOTAC, fully insured.' },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/kl-street-food-tour-chinatown-char-siu-bao-hidden-vendor-steamer.jpg',
      alt: 'Street food in Kuala Lumpur',
    }}
  />
</Layout>
