---
import { getCollection } from 'astro:content';
import type { APIRoute } from 'astro';
import CteBlogList from '~/components/blog/CteBlogList.astro';

// Fetch posts from Payload CMS
async function fetchCtePosts() {
  try {
    const response = await fetch(
      `https://cms.system.simplyenak.com/api/cte-posts?limit=100&depth=0`,
      {
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${import.meta.env.PAYLOAD_TOKEN || ''}`
        }
      }
    );

    if (!response.ok) {
      console.error('Failed to fetch CTE posts:', response.status);
      return [];
    }

    const data = await response.json();
    return (data.docs || []).filter(doc => doc._status === 'published' && doc.workflowStatus === 'published');
  } catch (error) {
    console.error('Error fetching CTE posts:', error);
    return [];
  }
}

export const prerender = false;

let posts = [];
if (import.meta.env.SSR) {
  posts = await fetchCtePosts();
}
---

<html lang="en">
  <head>
    <title>Blog | Culinary Travel Experts</title>
    <meta name="description" content="Insights for travel agents on Malaysian food culture, destination knowledge, and selling culinary experiences." />
    <link rel="canonical" href="https://culinarytravelexperts.com/blog" />
  </head>
  <body>
    <main>
      <section class="py-20">
        <div class="max-w-4xl mx-auto px-4">
          <h1 class="text-4xl font-bold mb-6">Agent Insights</h1>
          <p class="text-xl text-muted mb-8">
            Destination knowledge, cultural context, and tips for selling Malaysian food experiences. Written by operators who've been doing this for 14 years.
          </p>

          <div class="prose prose-lg max-w-none mb-12">
            <p>
              This isn't generic travel advice. These are insights from people who run food tours in Malaysia every day, work with the same vendors for over a decade, and understand what agents need to know before selling these experiences.
            </p>
          </div>

          <CteBlogList posts={posts} />

          <div class="mt-12 text-center">
            <p class="text-muted mb-4">More insights coming soon. Subscribe to our agent newsletter for updates.</p>
            <a href="/contact" class="btn-primary">Join Our Agent Network</a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
