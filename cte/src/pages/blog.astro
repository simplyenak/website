---
// Blog listing — posts come from Payload CMS via sync-cte-content.mjs
// (src/data/content/cte-posts.json). Hardcoded posts below are the fallback
// until content is synced.
import ctePosts from '../data/content/cte-posts.json';

const FALLBACK_POSTS = [
  {
    title: 'Would You Sell Disappointment?',
    slug: 'would-you-sell-disappointment',
    publishedDate: '2026-08-01',
    excerpt: 'A guest wanted fireflies, blue tears, and a vegan dinner. The eco-boat uses diesel. The fireflies are often underwhelming. The vegan option conflicts with local food. Should we sell experiences that might not deliver?',
  },
  {
    title: 'Greenwashing in Malaysian Tourism',
    slug: 'greenwashing-malaysian-tourism',
    publishedDate: '2026-07-28',
    excerpt: 'Companies advertise "whispering boats" and eco-friendly experiences while running diesel engines. It\'s usually ignorance, not malice. But agents need to know how to spot genuine sustainability versus marketing spin.',
  },
  {
    title: 'How to Sell Malaysian Food Tours to Skeptical Clients',
    slug: 'how-to-sell-malaysian-food-tours',
    publishedDate: '2026-07-25',
    excerpt: 'Common objections: "Will they like the food?" "Is it safe?" "Is it too spicy?" Here is how to position the experience, manage expectations, and convert hesitant clients.',
  },
];

const posts = ctePosts.length > 0 ? ctePosts : FALLBACK_POSTS;
---

<html lang="en">
  <head>
    <title>Blog | Culinary Travel Experts</title>
    <meta name="description" content="Insights for travel agents on Malaysian food culture, destination knowledge, and selling culinary experiences." />
    <link rel="canonical" href="https://culinarytravelexperts.com/blog" />
  </head>
  <body>
    <main>
      <section class="py-20">
        <div class="max-w-4xl mx-auto px-4">
          <h1 class="text-4xl font-bold mb-6">Agent Insights</h1>
          <p class="text-xl text-muted mb-8">
            Destination knowledge, cultural context, and tips for selling Malaysian food experiences. Written by operators who've been doing this for 14 years.
          </p>

          <div class="prose prose-lg max-w-none mb-12">
            <p>
              This isn't generic travel advice. These are insights from people who run food tours in Malaysia every day, work with the same vendors for over a decade, and understand what agents need to know before selling these experiences.
            </p>
          </div>

          <div class="grid gap-6">
            {posts.map(post => (
              <div class="bg-card p-6 rounded-lg">
                <div class="flex justify-between items-start mb-3">
                  <h3 class="font-bold text-lg">{post.title}</h3>
                  <span class="text-sm text-muted">{new Date(post.publishedDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
                </div>
                <p class="text-muted mb-3">{post.excerpt}</p>
                <a href={`/blog/${post.slug}`} class="text-accent hover:underline">Read article →</a>
              </div>
            ))}
          </div>

          <div class="mt-12 text-center">
            <p class="text-muted mb-4">More insights coming soon. Subscribe to our agent newsletter for updates.</p>
            <a href="/contact" class="btn-primary">Join Our Agent Network</a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
