---
import Layout from '~/layouts/PageLayout.astro';
import ctePages from '~/data/content/cte-pages.json';

const pages = ctePages;
const page = pages.find(p => p.slug === 'fam-trip-resources');
if (!page) throw new Error('Page not found: fam-trip-resources');

function renderMarkdown(markdown) {
  if (!markdown) return '';
  
  let html = markdown
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  
  html = html.replace(/^### (.*$)/gm, '<h3 class="text-2xl font-bold mt-8 mb-4">$1</h3>');
  html = html.replace(/^## (.*$)/gm, '<h2 class="text-3xl font-bold mt-10 mb-6">$1</h2>');
  html = html.replace(/^# (.*$)/gm, '<h1 class="text-4xl font-bold mt-12 mb-8">$1</h1>');
  
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  
  html = html.replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2" class="text-accent hover:underline">$1</a>');
  
  html = html.replace(/\n/g, '<br />');
  
  html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
  html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ul class="list-disc pl-6 space-y-2">$&</ul>');
  
  html = html.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
  html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ol class="list-decimal pl-6 space-y-2">$&</ol>');
  
  return html;
}

const html = renderMarkdown(page.content_markdown);

const metadata = {
  title: page.meta_title || page.title,
  description: page.meta_description || '',
  canonical: `https://culinarytravelexperts.com/${page.slug}`,
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose prose-lg max-w-none" set:html={html} />
      <div class="mt-12">
        <a href="#contact" class="btn-primary">Request Trade Kit</a>
      </div>
    </div>
  </section>
</Layout>
