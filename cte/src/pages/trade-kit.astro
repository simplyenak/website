      <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-900">Trade Kit</h1>
      <p class="mt-4 text-lg text-brand-700 max-w-3xl">Coming soon — trade kit download.</p>
    </div>
  </section>
</Layout>
