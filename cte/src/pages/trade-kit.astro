---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Trade Kit',
  description: 'Request the Culinary Travel Experts trade kit.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Resources</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Trade Kit</h1>
      <p class="mt-4 text-lg text-muted max-w-2xl">Get our trade kit with sample itineraries, pricing, destination overviews, and partnership terms.</p>
      <form class="mt-10 max-w-xl">
        <div class="space-y-4">
          <input type="text" placeholder="Your name" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent" />
          <input type="email" placeholder="Work email" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent" />
          <textarea placeholder="Tell us about your clients" rows="3" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent"></textarea>
          <button type="submit" class="px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors cursor-pointer">Request Trade Kit</button>
        </div>
      </form>
    </div>
  </section>
</Layout>
