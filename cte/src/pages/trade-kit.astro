---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Trade Kit',
  description: 'Request the Culinary Travel Experts trade kit — sample itineraries, pricing, and partnership terms.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="text-4xl md:text-5xl font-bold font-heading">Trade Kit</h1>
      <p class="mt-4 text-lg text-muted max-w-3xl">Trade kit download coming soon.</p>
    </div>
  </section>
</Layout>
