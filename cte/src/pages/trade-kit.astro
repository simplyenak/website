---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Trade Kit — Partner Resources for Malaysia Food Tours',
  description: 'Request the Culinary Travel Experts trade kit. Sample itineraries, pricing, destination guides, and partnership terms for travel professionals.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Resources</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Trade Kit</h1>
      <p class="mt-4 text-lg text-muted max-w-2xl">Get our complete trade kit for travel professionals. Includes sample itineraries with pricing, destination overviews, partnership terms, and marketing materials. We will send it within 24 hours.</p>
      <form class="mt-10 max-w-xl" method="POST" action="https://formspree.io/f/your-form-id" netlify>
        <div class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-default">Your name</label>
            <input type="text" id="name" name="name" required class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-default">Work email</label>
            <input type="email" id="email" name="email" required class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default" />
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-default">Company name</label>
            <input type="text" id="company" name="company" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-default">Tell us about your clients</label>
            <textarea id="message" name="message" rows="3" placeholder="Group size, interests, dietary needs, preferred destinations..." class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default"></textarea>
          </div>
          <button type="submit" class="px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors cursor-pointer">Request Trade Kit</button>
        </div>
      </form>
      <p class="mt-4 text-sm text-muted">Prefer to email? <a href="mailto:hello@culinarytravelexperts.com" class="text-accent hover:underline">hello@culinarytravelexperts.com</a></p>
    </div>
  </section>
</Layout>
