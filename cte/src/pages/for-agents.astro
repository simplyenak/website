---
import Layout from '~/layouts/PageLayout.astro';
import { pages } from '~/data/content/cte-pages.json';
import MarkdownContent from '~/components/MarkdownContent.astro';

const page = pages.find(p => p.slug === 'for-agents');
if (!page) throw new Error('Page not found: for-agents');

const metadata = {
  title: page.meta_title || page.title,
  description: page.meta_description || '',
  image: page.featuredImage ? `https://cdn.simplyenak.com${page.featuredImage.url}` : 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
  canonical: `https://culinarytravelexperts.com/${page.slug}`,
  robots: {
    index: true,
    follow: true,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What types of food experiences do you offer for travel agents?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We offer multi-day itineraries, day experiences, custom trips, corporate events, and itinerary planning services across Kuala Lumpur, Penang, Ipoh, Melaka, Cameron Highlands, and Johor Bahru.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I book food tours for my clients?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sign our supplier agreement, receive our trade kit with destination guides and pricing, then book experiences for your clients. We handle all logistics and guest communication.',
      },
    },
    {
      '@type': 'Question',
      name: 'What makes your food tours different from TripAdvisor or GetYourGuide?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We build experiences around relationships, not routes. Your clients meet the families we have worked with for years — not standardized tours from the same meeting points.',
      },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

/Layout metadata={metadata}>
  <MarkdownContent content={page.content_markdown} />
  <div class="mt-12">
    <a href="#contact" class="btn-primary">Request Trade Kit</a>
    <p class="text-muted mt-4 text-sm">We respond within 24 hours. No obligation to join.</p>
  </div>
</Layout>
