---
// Blog post page — content comes from Payload CMS via sync-cte-content.mjs
// (src/data/content/cte-posts.json). Hardcoded fallback entries below keep
// the existing articles working until content is synced.
import { Marked } from 'marked';
import ctePosts from '../../data/content/cte-posts.json';

const marked = new Marked();

interface Props {
  params: { slug: string };
}

// JSON posts win; fallback fills the gap until content is synced from Payload.
// NOTE: everything is computed inside getStaticPaths — Astro runs it before
// the component body, so it cannot see const declarations in the body.
export function getStaticPaths() {
  const FALLBACK_POSTS = [
    {
      title: 'Greenwashing in Malaysian Tourism',
      slug: 'greenwashing-malaysian-tourism',
      excerpt: 'Companies advertise "whispering boats" and eco-friendly experiences while running diesel engines. It is usually ignorance, not malice. Here is how to spot genuine sustainability versus marketing spin.',
      publishedDate: '2026-07-28',
    },
    {
      title: 'How to Sell Malaysian Food Tours to Skeptical Clients',
      slug: 'how-to-sell-malaysian-food-tours',
      excerpt: 'Common objections: "Will they like the food?" "Is it safe?" "Is it too spicy?" Here is how to position the experience, manage expectations, and convert hesitant clients.',
      publishedDate: '2026-07-25',
    },
    {
      title: 'Would You Sell Disappointment?',
      slug: 'would-you-sell-disappointment',
      excerpt: 'A guest wanted fireflies, blue tears, and a vegan dinner. The eco-boat uses diesel. The fireflies are often underwhelming. The vegan option conflicts with local food. Should we sell experiences that might not deliver?',
      publishedDate: '2026-08-01',
    },
  ];

  const allPosts = [...ctePosts, ...FALLBACK_POSTS.filter(f => !ctePosts.some(p => p.slug === f.slug))];
  return allPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;

const body = post.content_markdown
  ? marked.parse(post.content_markdown)
  : `<p>${post.excerpt || post.description || ''}</p>`;
---

<html lang="en">
  <head>
    <title>{post.meta_title || post.title} | Culinary Travel Experts</title>
    <meta name="description" content={post.meta_description || post.excerpt || ''} />
    <link rel="canonical" href={`https://culinarytravelexperts.com/blog/${post.slug}`} />
  </head>
  <body>
    <main>
      <div class="py-20">
        <div class="max-w-3xl mx-auto px-4">
          <article>
            <header class="mb-8">
              <h1 class="text-4xl font-bold mb-4">{post.title}</h1>
              <div class="text-muted">
                {new Date(post.publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                {post.author && post.author !== 'CTE Team' && <span> · {post.author}</span>}
              </div>
            </header>

            {post.featuredImage && (
              <img
                src={post.featuredImage}
                alt={post.title}
                class="w-full h-64 object-cover rounded-lg mb-8"
                loading="eager"
              />
            )}

            <div class="prose prose-lg max-w-none" set:html={body}></div>
          </article>

          <div class="mt-12">
            <a href="/blog" class="text-accent hover:underline">← Back to all articles</a>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
