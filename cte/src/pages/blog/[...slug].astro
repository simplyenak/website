---
import type { APIRoute } from 'astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { slug: 'greenwashing-malaysian-tourism' } },
    { params: { slug: 'how-to-sell-malaysian-food-tours' } },
    { params: { slug: 'would-you-sell-disappointment' } },
  ];
}

interface Props {
  params: { slug: string };
}

const { slug } = Astro.props.params;

// Fallback content from static files
const fallbackPosts: Record<string, any> = {
  'greenwashing-malaysian-tourism': {
    title: 'Greenwashing in Malaysian Tourism',
    description: 'Companies advertise "whispering boats" and eco-friendly experiences while running diesel engines. It is usually ignorance, not malice. Here is how to spot genuine sustainability versus marketing spin.',
    publishDate: '2026-07-28',
  },
  'how-to-sell-malaysian-food-tours': {
    title: 'How to Sell Malaysian Food Tours to Skeptical Clients',
    description: 'Common objections: "Will they like the food?" "Is it safe?" "Is it too spicy?" Here is how to position the experience, manage expectations, and convert hesitant clients.',
    publishDate: '2026-07-25',
  },
  'would-you-sell-disappointment': {
    title: 'Would You Sell Disappointment?',
    description: 'A guest wanted fireflies, blue tears, and a vegan dinner. The eco-boat uses diesel. The fireflies are often underwhelming. The vegan option conflicts with local food. Should we sell experiences that might not deliver?',
    publishDate: '2026-08-01',
  },
};

const fallbackPost = fallbackPosts[slug];
---

{fallbackPost && (
  <div class="py-20">
    <div class="max-w-3xl mx-auto px-4">
      <article>
        <header class="mb-8">
          <h1 class="text-4xl font-bold mb-4">{fallbackPost.title}</h1>
          <div class="text-muted">
            {new Date(fallbackPost.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </div>
        </header>

        <div class="prose prose-lg max-w-none">
          <p>{fallbackPost.description}</p>
        </div>
      </article>

      <div class="mt-12">
        <a href="/blog" class="text-accent hover:underline">← Back to all articles</a>
      </div>
    </div>
  </div>
)}
