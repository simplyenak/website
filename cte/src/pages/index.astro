---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Malaysian Culinary and Heritage Traditions for Travel Professionals',
  description: "Connecting travel professionals with Malaysia's culinary traditions and cultural heritage. Fourth-generation producers, family recipes, heritage knowledge. Licensed by MOTAC.",
  image: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Your clients. Our Malaysia. Experiences that stay with them."
    actions={[
      { variant: 'primary', text: 'View Sample Itineraries', href: '/itineraries/' },
      { variant: 'secondary', text: 'Become a Partner', href: '/partner-with-us/' },
    ]}
    image={{ src: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg', alt: 'Penang street food' }}
  >
    <Fragment slot="title">
      We connect your clients with Malaysia's<br />
      <span class="text-accent">culinary and heritage traditions.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Every experience we design is built on relationships we have spent years developing. The fish cracker maker who has been working the same street for four decades. The Nyonya home cook who learned from her grandmother. The market vendors who practise methods their mothers taught them. We find these people, earn their trust, and build experiences around their knowledge. Your clients get more than a tour — they get access to people who have been living Malaysia's culinary and heritage traditions every day of their lives.
    </Fragment>
  </Hero>

  <Features
    id="services"
    tagline="What We Handle"
    title="Food experiences built around culture, community, and craft"
    columns="3"
    items={[
      {
        title: 'Multi-Day Itineraries',
        description: '3 to 7 days exploring Malaysia through its food culture. Market visits, home cooking sessions, heritage eateries, and producers who have been feeding their communities for generations.',
        icon: 'tabler:route',
      },
      {
        title: 'Day Experiences',
        description: 'Morning market walks, afternoon cooking classes with home cooks, evening hawker crawls through neighborhoods that have fed Kuala Lumpur for decades.',
        icon: 'tabler:sun',
      },
      {
        title: 'Custom & Sustainable Trips',
        description: "Dietary needs, special interests, or a focus on sustainable food systems. We build itineraries that support local economies and preserve traditional food knowledge.",
        icon: 'tabler:leaf',
      },
      {
        title: 'Corporate & Events',
        description: 'Team cooking with local ingredients, incentive trips that support village communities, gala dinners featuring heritage recipes from Malaysia's diverse cultures.',
        icon: 'tabler:building-community',
      },
      {
        title: 'Itinerary Planning',
        description: 'You want the local knowledge but prefer to operate it yourself. We plan the route with vetted vendors who practice sustainable and traditional food preparation methods.',
        icon: 'tabler:map',
      },
    ]}
  />

  <Content
    tagline="What makes an experience stay with you"
    title="Meaningful experiences don't come from a checklist"
    items={[
      {
        title: 'It starts with people, not places',
        description: 'We work with families who have been making the same dish for generations. Home cooks who learned from their parents. Fishermen who still go out the way their grandfathers did. Your clients do not just visit a destination. They meet the people who shape it.',
      },
      {
        title: 'Context changes everything',
        description: 'Knowing that a particular stall has been serving curry noodles from the same cart since 1965 changes how a bowl tastes. We do not just show your clients where to eat. We explain why the food is the way it is, who created it, and what it means to the people who make it.',
      },
      {
        title: 'Participation over observation',
        description: 'Your clients learn to pound spice paste in a mortar worn smooth by decades of use. They fold popiah skins alongside someone who has been doing it since she was eight. They taste palm sugar straight from the tree. These are not demonstrations. They are moments your clients take part in.',
      },
      {
        title: 'Every booking has an impact',
        description: 'The families we work with rely on these experiences. The fisherman who hosts your clients can afford to keep his traditional boat in service. The home cook can pass her recipes to her children. Every booking supports a way of life that might otherwise disappear.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/Penang008.jpg',
      alt: 'Traditional cooking in Penang',
    }}
  >
    <Fragment slot="content">
      We have been building these relationships for 15 years. We know which families welcome guests, which stories resonate, and how to create moments that stay with people long after they return home.
    </Fragment>
  </Content>

  <Content
    isReversed
    tagline="Sample Itinerary"
    title="3 Days in Penang"
    items={[
      {
        title: 'Day 1. George Town Heritage Food',
        description: 'Pulau Tikus morning market with local producers, Transfer Road roti canai made the same way for 60 years, Nyonya home restaurant featuring family recipes passed down through generations.',
      },
      {
        title: 'Day 2. Markets, Kitchens & Communities',
        description: 'Balat morning market where farmers sell direct, Nyonya cooking class in a family kitchen, sunset at a fishing village that still uses traditional methods.',
      },
      {
        title: 'Day 3. Fishermen, Farmers & Spice',
        description: 'Fishing village breakfast with the day's catch, family-owned durian farm visit, kampung cooking session using garden-grown ingredients, tropical spice garden walk.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
      alt: 'Dipping fried dough into Penang laksa',
    }}
  >
    <Fragment slot="content">
      Every itinerary connects travelers to the people behind the food. Family recipes, traditional techniques, local producers who have been feeding their communities for generations. Every booking supports local livelihoods and helps preserve Malaysia's culinary heritage.
    </Fragment>
  </Content>

  <CallToAction
    title="Get the trade kit."
    subtitle="Sample itineraries, pricing, destination overviews, and partnership terms. Designed for travel professionals who value real food culture and responsible travel."
    actions={[
      { variant: 'primary', text: 'Request Trade Kit', href: '/trade-kit/' },
    ]}
  />
</Layout>
