---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Malaysia Food Tour Partner for Travel Professionals — Culinary Travel Experts',
  description: "B2B food experiences in Malaysia for travel agents, DMCs, hotels, and event planners. 15 years on the ground. Licensed, insured, and ready for your clients.",
  image: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="B2B Food Partner in Malaysia"
    actions={[
      { variant: 'primary', text: 'View Sample Itineraries', href: '/itineraries/' },
      { variant: 'secondary', text: 'Become a Partner', href: '/partner-with-us/' },
    ]}
    image={{ src: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg', alt: 'Penang street food experience' }}
  >
    <Fragment slot="title">
      Malaysia Food Tours &amp; Culinary Experiences<br />
      <span class="text-accent">Built for Travel Professionals</span>
    </Fragment>

    <Fragment slot="subtitle">
      Your clients want authentic Malaysian food experiences — structured for groups, accommodating dietary needs, and backed by 15 years on the ground. We design and operate itineraries so you can sell with confidence. Licensed by MOTAC, 150+ 5-star reviews, 40+ nationalities hosted.
    </Fragment>
  </Hero>

  <Features
    id="services"
    tagline="What We Handle"
    title="Whatever your client needs, we can probably build it."
    columns="3"
    items={[
      {
        title: 'Multi-Day Itineraries',
        description: '3 to 7 days of eating through Malaysia. Every stop scouted, every meal tested, every guide trained by us. You sell it, we run it.',
        icon: 'tabler:route',
        href: '/what-we-do/',
      },
      {
        title: 'Day Experiences',
        description: 'Morning market walks, afternoon cooking classes, evening hawker crawls. Standalone or bolted onto an existing trip.',
        icon: 'tabler:sun',
        href: '/what-we-do/',
      },
      {
        title: 'Custom Trips',
        description: "Your client's diet, group size, or theme doesn't fit the standard routes. We build something that does. Same depth, different shape.",
        icon: 'tabler:adjustments',
        href: '/what-we-do/',
      },
      {
        title: 'Corporate & Events',
        description: 'Team cooking sessions, incentive trip food stops, gala dinners with local menus. Designed for groups, run by people who know the food.',
        icon: 'tabler:building-community',
        href: '/what-we-do/',
      },
      {
        title: 'Itinerary Planning',
        description: 'You want the local knowledge but prefer to run things yourself. We plan the route, you operate it. Detailed day-by-day plans with vetted vendors.',
        icon: 'tabler:map',
        href: '/what-we-do/',
      },
    ]}
  />

  <!-- Social Proof -->
  <Testimonials
    tagline="Trusted by Travel Professionals"
    title="Why partners work with us"
    items={[
      { testmonial: "Simply Enak has been our go-to ground partner for food experiences in Malaysia for over 5 years. Their knowledge, reliability, and ability to handle dietary restrictions at scale is unmatched.", name: 'Sarah Chen', job: 'Product Manager, Intrepid Travel' },
      { testmonial: "We sent 24 clients on a custom 5-day food itinerary through Penang and KL. Every detail was handled perfectly — from halal requirements to vegan options. Our clients still talk about it.", name: 'Marcus Weber', job: 'Luxury Travel Advisor, Audley Travel' },
      { testmonial: "The trade kit made it easy to sell. Professional materials, clear pricing, and a team that actually responds within hours. Exactly what we look for in a destination partner.", name: 'Aisha Rahman', job: 'Director, Southeast Asia Specialists' },
    ]}
  />

  <Content
    isReversed
    tagline="Sample Itinerary"
    title="3 Days in Penang"
    items={[
      {
        title: 'Day 1 — George Town Deep Dive',
        description: 'Pulau Tikus morning market, Transfer Road roti canai, Little India lunch, Nyonya home restaurant dinner, hawker centre crawl by night.',
      },
      {
        title: 'Day 2 — Markets & Nyonya Kitchen',
        description: 'Balat morning market, Nyonya cooking class in a home kitchen, afternoon tea at a heritage mansion, sunset at a fishing village.',
      },
      {
        title: 'Day 3 — Fishing Village & Spice Road',
        description: 'Fishing village breakfast with grilled fish and kerabu, durian farm visit, kampung cooking session, tropical spice garden walk.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
      alt: 'Dipping fried dough into Penang laksa',
    }}
  >
    <Fragment slot="content">
      A long weekend covering George Town's heritage food, Nyonya home cooking, and the fishing villages along the coast. Every stop personally vetted — we have eaten at every single one.
    </Fragment>
  </Content>

  <CallToAction
    title="Get the trade kit."
    subtitle="Sample itineraries, pricing structure, destination overviews, partnership terms. Filled with operational details for travel professionals. We will send it within 24 hours."
    actions={[
      { variant: 'primary', text: 'Request Trade Kit', href: '/trade-kit/' },
    ]}
  />
</Layout>
