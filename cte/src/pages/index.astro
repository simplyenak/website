---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Malaysian Culinary and Heritage Traditions for Travel Professionals',
  description: "Connecting travel professionals with Malaysia's culinary traditions and cultural heritage. Fourth-generation producers, family recipes, heritage knowledge. MOTAC application in progress.",
  image: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
};

// B2B Schema for CTE
const b2bSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Culinary Travel Experts',
  description: "Malaysia's B2B food experience partner for travel professionals. MOTAC application in progress. Part of Simply Enak.",
  url: 'https://culinarytravelexperts.com',
  image: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
  telephone: '+60 17-287 8929',
  email: 'hello@culinarytravelexperts.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kuala Lumpur',
    addressCountry: 'MY',
  },
  areaServed: ['Kuala Lumpur', 'Penang', 'Ipoh', 'Melaka', 'Cameron Highlands', 'Johor Bahru'],
  serviceType: ['Tour Operator', 'Destination Management Company', 'Food Tour Provider'],
  priceRange: '$$$',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '76',
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'Offer',
    name: 'B2B Partnership',
    description: 'Trade partnerships for travel agents, DMCs, hotels, and event planners',
    availability: 'https://schema.org/InStock',
  },
  brand: {
    '@type': 'Organization',
    name: 'Simply Enak',
    url: 'https://simplyenak.com',
  },
  sameAs: [
    'https://www.facebook.com/SimplyEnak',
    'https://www.instagram.com/simply.enak/',
    'https://www.tripadvisor.com/Attraction_Review-g298570-d2414763-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html',
  ],
};
---

<Layout metadata={metadata}>
  <!-- B2B Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(b2bSchema)} />
  <Hero
    tagline="For travel agents, DMCs and creators"
    actions={[
      { variant: 'primary', text: 'For Agents', href: '/for-agents' },
      { variant: 'secondary', text: 'For Creators', href: '/for-creators' },
    ]}
    image={{ src: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg', alt: 'Penang street food' }}
  >
    <Fragment slot="title">
      Your client wants something that<br />
      <span class="text-accent">does not fit a package. Say yes.</span>
    </Fragment>

    <Fragment slot="subtitle">
      A client who wants a halal food tour with a durian tasting, a cooking class, and a group of 12, leaving in three weeks. That request does not fit a brochure. It fits us. Since 2011 we have built the vendor relationships, the guides, and the logistics that let you say yes to the request and leave the rest to us.
    </Fragment>
  </Hero>

  <!-- Proof strip -->
  <Stats
    id="proof"
    title="Proof, not promises"
    subtitle="The numbers behind the people your clients will meet."
    stats={[
      { amount: '5.0', title: 'Google rating', icon: 'tabler:star' },
      { amount: '81', title: 'Guest reviews', icon: 'tabler:message-circle' },
      { amount: '6', title: 'Cities served', icon: 'tabler:map-pin' },
      { amount: '2011', title: 'Serving guests since', icon: 'tabler:calendar' },
    ]}
  />

  <!-- The two lanes -->
  <Features
    id="lanes"
    title="Two ways to work with us"
    subtitle="Whether you sell experiences or create content about them, we open the same doors."
    columns={2}
    items={[
      {
        title: 'Travel Agents and DMCs',
        description: 'Sell our experiences to your clients with a clear commission structure, marketing materials, and a dedicated account manager. You say yes to the complex request, we handle everything after that.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Travel Creators',
        description: 'Film and photograph the Malaysia tourists never see: the back of the market, the vendor\'s first batch of the day, the home cook\'s family recipe. Access, story angles, and hosting for creators whose audiences travel.',
        icon: 'tabler:video',
      },
    ]}
  />

  <!-- How it works -->
  <Steps2
    id="how-it-works"
    title="How it works"
    subtitle="Four steps between the client request and the experience."
    items={[
      {
        title: 'Tell us the request',
        description: 'Group size, dietary needs, interests, dates. A food tour for two, a team event for 40, a week-long itinerary across three cities. Nothing is too specific.',
      },
      {
        title: 'We design the experience',
        description: 'We match the request to the vendors, guides, and locations we have worked with for years. You get a proposal with pricing and a clear answer on what is possible.',
      },
      {
        title: 'Your client is handled',
        description: 'Pre-tour instructions, dietary coordination, day-of logistics, language support. Our guides speak English, Malay, Mandarin, and Cantonese.',
      },
      {
        title: 'You get paid',
        description: 'Commission on every booking, on time. High-volume partners get priority access to our most sought-after experiences.',
      },
    ]}
  />

  <!-- What makes an experience memorable -->
  <Content
    id="memory"
    title="Meaningful experiences do not come from a checklist"
    items={[
      {
        title: 'It starts with people, not places',
        description: 'We work with families who have been making the same dish for generations. Home cooks who learned from their parents. Fishermen who still go out the way their grandfathers did. Your clients do not just visit a destination. They meet the people who shape it.',
      },
      {
        title: 'Context changes everything',
        description: 'Knowing that a particular stall has been serving curry noodles from the same cart since 1965 changes how a bowl tastes. We do not just show your clients where to eat. We explain why the food is the way it is, who created it, and what it means to the people who make it.',
      },
      {
        title: 'Participation over observation',
        description: 'Your clients learn to pound spice paste in a mortar worn smooth by decades of use. They fold popiah skins alongside someone who has been doing it since she was eight. They taste palm sugar straight from the tree. These are not demonstrations. They are moments your clients take part in.',
      },
      {
        title: 'Every booking has an impact',
        description: 'The families we work with rely on these experiences. The fisherman who hosts your clients can afford to keep his traditional boat in service. The home cook can pass her recipes to her children. Every booking supports a way of life that might otherwise disappear.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/Penang008.jpg',
      alt: 'Traditional cooking in Penang',
    }}
  >
    <Fragment slot="content">
      We have been building these relationships since 2011. We know which families welcome guests, which stories resonate, and how to create moments that stay with people long after they return home.
    </Fragment>
  </Content>

  <!-- Destinations -->
  <section id="destinations" class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-center">Destinations We Operate In</h2>
      <p class="mt-4 text-lg text-muted max-w-3xl mx-auto text-center">Each destination has its own food culture, shaped by history, community, and tradition.</p>
      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"><h3 class="text-xl font-bold font-heading">Kuala Lumpur</h3><p class="mt-2 text-muted">Street food from three cultures, wet markets that have operated for generations, family-run hawker stalls in the communities that keep traditional food alive.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter"><h3 class="text-xl font-bold font-heading">Penang</h3><p class="mt-2 text-muted">George Town heritage food, Nyonya home cooking passed down through families, fishing villages using traditional methods, family-owned durian orchards.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-half"><h3 class="text-xl font-bold font-heading">Ipoh</h3><p class="mt-2 text-muted">White coffee from original Hainanese coffee shops, bean sprout chicken from farms using traditional methods, Hakka cuisine preserved by the community for over a century.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter"><h3 class="text-xl font-bold font-heading">Cameron Highlands</h3><p class="mt-2 text-muted">Family-run tea plantations, small-scale strawberry farms, steamboat dinners using locally grown vegetables, highland food traditions.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-half"><h3 class="text-xl font-bold font-heading">Melaka</h3><p class="mt-2 text-muted">Baba Nyonya heritage cuisine, Portuguese Eurasian dishes preserved for 500 years, Jonker Street's traditional food vendors.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter"><h3 class="text-xl font-bold font-heading">Johor Bahru</h3><p class="mt-2 text-muted">Laksa Johor made with traditional spice pastes, murtabak from families who have been making them for generations, the food culture of Malaysia's southern gateway.</p></div>
      </div>
    </div>
  </section>

  <!-- Partner With Us -->
  <section id="partner" class="py-16 md:py-24 bg-brand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-center">Partner With Us</h2>
      <p class="mt-4 text-lg text-muted max-w-3xl mx-auto text-center">We are Malaysia's B2B food experience partner, structured for trade. MOTAC application in progress. Part of Simply Enak.</p>
      <div class="mt-10 grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"><h3 class="text-xl font-bold font-heading">Travel Agents</h3><p class="mt-2 text-muted">Sell our itineraries to your clients. Clear commission structure, marketing materials, and a dedicated account manager.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter"><h3 class="text-xl font-bold font-heading">DMCs and Tour Operators</h3><p class="mt-2 text-muted">Your Malaysia ground partner for food experiences. FIT and group capabilities, licensing in progress.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-half"><h3 class="text-xl font-bold font-heading">Hotels and Resorts</h3><p class="mt-2 text-muted">Offer guests curated food experiences without building your own program. We handle booking and logistics.</p></div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter"><h3 class="text-xl font-bold font-heading">Travel Creators</h3><p class="mt-2 text-muted">Filming and photography access to the people and places tourists never see. Hosted experiences for creators whose audiences travel.</p></div>
      </div>
    </div>
  </section>

  <!-- About -->
  <Content
    id="about"
    title="About Culinary Travel Experts"
    items={[
      {
        title: 'Built on Real Food Culture',
        description: 'We have been connecting travelers with Malaysia food heritage since 2011. Every vendor we work with is personally known to us. Family recipes, traditional techniques, local producers who have been feeding their communities for generations.',
      },
      {
        title: 'Part of Simply Enak',
        description: "Culinary Travel Experts is the trade-facing side of Simply Enak, rated 5 stars on TripAdvisor. The same guides, the same community relationships, structured for trade partners.",
      },
      {
        title: 'Licensed and Insured',
        description: 'MOTAC application in progress (Ministry of Tourism, Arts and Culture Malaysia).',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/kl-street-food-tour-chinatown-char-siu-bao-hidden-vendor-steamer.jpg',
      alt: 'Street food in Kuala Lumpur',
    }}
  >
    <Fragment slot="content">
      We help travel professionals deliver Malaysian food experiences rooted in culture and community. You bring the client. We handle the details.
    </Fragment>
  </Content>

  <!-- Trade Kit CTA -->
  <CallToAction
    id="trade-kit"
    title="Get the trade kit."
    subtitle="Sample itineraries, pricing, destination overviews, and partnership terms. Designed for travel professionals who value real food culture and responsible travel."
    actions={[
      { variant: 'primary', text: 'Request Trade Kit', href: '#contact' },
    ]}
  />

  <!-- Contact -->
  <section id="contact" class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-center">Contact Us</h2>
      <div class="mt-10 grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
        <form>
          <div class="space-y-4">
            <input type="text" placeholder="Name" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default" />
            <input type="email" placeholder="Email" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default" />
            <textarea placeholder="Tell us about your requirements" rows="4" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default"></textarea>
            <button type="submit" class="px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors cursor-pointer">Send Message</button>
          </div>
        </form>
        <div class="space-y-8">
          <div><h3 class="font-bold font-heading text-lg">Email</h3><p class="text-muted mt-1"><a href="mailto:hello@culinarytravelexperts.com" class="text-accent hover:underline">hello@culinarytravelexperts.com</a></p></div>
          <div><h3 class="font-bold font-heading text-lg">Based In</h3><p class="text-muted mt-1">Kuala Lumpur, Malaysia</p></div>
          <div><h3 class="font-bold font-heading text-lg">Part of</h3><p class="text-muted mt-1"><a href="https://simplyenak.com" class="text-accent hover:underline">Simply Enak</a></p></div>
        </div>
      </div>
    </div>
  </section>
</Layout>
