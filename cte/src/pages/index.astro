---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Food & Heritage Ground Partner in Malaysia',
  description: "Your clients want specific things. Dietary needs that don't map neatly to hawker stalls. Group sizes that don't fit the brochure. We help you say yes. 15 years on the ground in Malaysia.",
  image: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="For Travel Professionals"
    actions={[
      { variant: 'primary', text: 'View Sample Itineraries', href: '/itineraries/' },
      { variant: 'secondary', text: 'Partner With Us', href: '/partner-with-us/' },
    ]}
  >
    <Fragment slot="title">
      Your clients want things that don't fit a package.<br />
      <span class="text-accent">We help you say yes.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Halal street food with a history angle. A vegan guest who wants to cook Nyonya food. Forty people from four countries with four sets of dietary needs, and dinner is tomorrow. When you have spent 15 years running food experiences across Malaysia, you know which stalls can handle a group of 12, which kitchen will adjust for a vegan guest, and which guide can explain laksa history while managing a gluten allergy at the same table. You bring the client. We handle the details.
    </Fragment>
  </Hero>

  <Features
    id="services"
    tagline="What We Handle"
    title="Whatever your client needs, we can probably build it."
    columns="3"
    items={[
      {
        title: 'Multi-Day Itineraries',
        description: '3 to 7 days of eating through Malaysia. Every stop scouted, every meal tested, every guide trained by us. You sell it, we run it.',
        icon: 'tabler:route',
      },
      {
        title: 'Day Experiences',
        description: 'Morning market walks, afternoon cooking classes, evening hawker crawls. Standalone or bolted onto an existing trip.',
        icon: 'tabler:sun',
      },
      {
        title: 'Custom Trips',
        description: "Your client's diet, group size, or theme doesn't fit the standard routes. We build something that does. Same depth, different shape.",
        icon: 'tabler:adjustments',
      },
      {
        title: 'Corporate & Events',
        description: 'Team cooking sessions, incentive trip food stops, gala dinners with local menus. Designed for groups, run by people who know the food.',
        icon: 'tabler:building-community',
      },
      {
        title: 'Itinerary Planning',
        description: 'You want the local knowledge but you prefer to run things yourself. We plan the route, you operate it.',
        icon: 'tabler:map',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Sample Itinerary"
    title="3 Days in Penang"
    items={[
      {
        title: 'Day 1 — George Town Deep Dive',
        description: 'Pulau Tikus morning market, Transfer Road roti canai, Little India lunch, Nyonya home restaurant dinner, hawker centre crawl by night.',
      },
      {
        title: 'Day 2 — Markets & Nyonya Kitchen',
        description: 'Balat morning market, Nyonya cooking class in a home kitchen, afternoon tea at a heritage mansion, sunset at a fishing village.',
      },
      {
        title: 'Day 3 — Fishing Village & Spice Road',
        description: 'Fishing village breakfast with grilled fish and kerabu, durian farm visit, kampung cooking session, tropical spice garden walk.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
      alt: 'Dipping fried dough into Penang laksa',
    }}
  >
    <Fragment slot="content">
      A long weekend covering George Town's heritage food, Nyonya home cooking, and the fishing villages along the coast.
    </Fragment>
  </Content>

  <CallToAction
    title="Get the trade kit."
    subtitle="Sample itineraries, pricing structure, destination overviews, partnership terms. Fill in the form and we will send it within 24 hours."
    actions={[
      { variant: 'primary', text: 'Request Trade Kit', href: '/trade-kit/' },
    ]}
  />
</Layout>
