---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Itineraries',
  description: 'Sample multi-day itineraries for travel professionals booking Malaysia food experiences.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="text-4xl md:text-5xl font-bold font-heading">Itineraries</h1>
      <p class="mt-4 text-lg text-muted max-w-3xl">Sample itineraries coming soon.</p>
    </div>
  </section>
</Layout>
