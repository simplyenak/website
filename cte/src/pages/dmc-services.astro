---
import Layout from '~/layouts/PageLayout.astro';
import { pages } from '~/data/content/cte-pages.json';
import MarkdownContent from '~/components/MarkdownContent.astro';

const page = pages.find(p => p.slug === 'dmc-services');
if (!page) throw new Error('Page not found: dmc-services');

const metadata = {
  title: page.meta_title || page.title,
  description: page.meta_description || '',
  image: page.featuredImage ? `https://cdn.simplyenak.com${page.featuredImage.url}` : 'https://cdn.simplyenak.com/payload-media/hand-dipping-lumpia-in-penang-laksa.jpg',
  canonical: `https://culinarytravelexperts.com/${page.slug}`,
  robots: {
    index: true,
    follow: true,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Culinary Travel Experts',
  description: "Malaysia's culinary destination management company specializing in food and cultural experiences for travel professionals.",
  url: `https://culinarytravelexperts.com/${page.slug}`,
  telephone: '+60 17-287 8929',
  email: 'hello@culinarytravelexperts.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kuala Lumpur',
    addressCountry: 'MY'
  },
  areaServed: [
    { '@type': 'City', 'name': 'Kuala Lumpur' },
    { '@type': 'City', 'name': 'Penang' },
    { '@type': 'City', 'name': 'Ipoh' },
    { '@type': 'City', 'name': 'Melaka' },
    { '@type': 'Place', 'name': 'Cameron Highlands' },
    { '@type': 'City', 'name': 'Johor Bahru' }
  ],
  serviceType: ['Tour Operator', 'Destination Management Company', 'Food Tour Provider'],
  provider: {
    '@type': 'Organization',
    name: 'Culinary Travel Experts',
    parentOrganization: {
      '@type': 'Organization',
      name: 'Simply Enak'
    }
  },
  agentRange: '2-200 travelers',
  pricing: {
    '@type': 'PriceSpecification',
    priceCurrency: 'MYR',
    minPrice: 285,
    maxPrice: 359
  }
})} />

/Layout metadata={metadata}>
  <MarkdownContent content={page.content_markdown} />
  <div class="mt-12">
    <a href="#contact" class="btn-primary">Get a Quote</a>
    <p class="text-muted mt-4 text-sm">We respond within 24 hours. Custom proposals available.</p>
  </div>
</Layout>
