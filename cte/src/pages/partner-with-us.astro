---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Partner With Us — Malaysia Food Tours for Travel Professionals',
  description: 'Become a partner. Malaysia food experiences for travel agents, DMCs, hotels, and event planners.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Partnerships</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Partner With Us</h1>
      <p class="mt-4 text-lg text-muted max-w-3xl">We are Malaysia's B2B food experience partner, structured for trade.</p>
      <div class="mt-10 grid md:grid-cols-2 gap-6 max-w-4xl">
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Travel Agents</h2>
          <p class="mt-2 text-muted">Sell our itineraries to your clients. Commission structure, marketing materials, and a dedicated account manager.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">DMCs & Tour Operators</h2>
          <p class="mt-2 text-muted">Your Malaysia ground partner for food experiences. FIT and group capabilities, licensed and insured.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Hotels & Resorts</h2>
          <p class="mt-2 text-muted">Offer your guests curated food experiences without building your own program. We handle booking and logistics.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Event & Incentive Planners</h2>
          <p class="mt-2 text-muted">Corporate dinners, team building, incentive groups. We design food-focused experiences.</p>
        </div>
      </div>
      <div class="mt-8">
        <a href="/contact/" class="inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors no-underline">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>
