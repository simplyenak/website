---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Partner With Us — Malaysia Food Tours for Travel Professionals',
  description: 'Become a partner. Malaysia food experiences for travel agents, DMCs, hotels, and event planners. Commission structure, trade materials, 24/7 support.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Partnerships</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Partner With Us</h1>
      <p class="mt-4 text-lg text-muted max-w-3xl">We are Malaysia's dedicated B2B food experience partner. 15 years of local relationships, licensed and insured, structured for trade.</p>
      <div class="mt-10 grid md:grid-cols-2 gap-6 max-w-4xl">
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Travel Agents</h2>
          <p class="mt-2 text-muted">Sell our itineraries to your clients with confidence. Commission structure, marketing materials, and a dedicated account manager.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">DMCs & Tour Operators</h2>
          <p class="mt-2 text-muted">Your Malaysia ground partner for food experiences. FIT and group capabilities, 15 years of vendor relationships, fully licensed and insured.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Hotels & Resorts</h2>
          <p class="mt-2 text-muted">Offer your guests curated food experiences without building your own program. We handle booking, logistics, and guest communication.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Event & Incentive Planners</h2>
          <p class="mt-2 text-muted">Corporate dinners, team building, incentive groups, gala events. We design food-focused experiences from 10 to 200 guests.</p>
        </div>
      </div>
      <div class="mt-10 bg-brand-50 border border-brand-100 p-8 rounded-xl max-w-4xl">
        <h2 class="text-2xl font-bold font-heading">Why Partner With Us</h2>
        <ul class="mt-4 space-y-3">
          <li class="flex gap-3"><span class="text-accent font-bold">✓</span> <span><strong>15 years</strong> running food experiences across Malaysia</span></li>
          <li class="flex gap-3"><span class="text-accent font-bold">✓</span> <span><strong>150+</strong> 5-star reviews on TripAdvisor</span></li>
          <li class="flex gap-3"><span class="text-accent font-bold">✓</span> <span><strong>Licensed</strong> by MOTAC (Ministry of Tourism, Malaysia)</span></li>
          <li class="flex gap-3"><span class="text-accent font-bold">✓</span> <span><strong>40+</strong> nationalities hosted — dietary needs handled</span></li>
          <li class="flex gap-3"><span class="text-accent font-bold">✓</span> <span><strong>24/7</strong> in-country support for your clients</span></li>
        </ul>
      </div>
      <div class="mt-8">
        <a href="/contact/" class="inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors no-underline">Get in touch to discuss partnership</a>
      </div>
    </div>
  </section>
</Layout>
