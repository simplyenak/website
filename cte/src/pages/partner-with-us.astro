---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Partner With Us',
  description: 'Partner with Culinary Travel Experts for Malaysia food experiences.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Partnerships</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Partner With Us</h1>
      <div class="mt-8 grid md:grid-cols-2 gap-8 max-w-4xl">
        <div class="bg-white border border-gray-200 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Travel Agents</h2>
          <p class="mt-2 text-muted">Sell our itineraries to your clients with confidence. Commission structure available.</p>
        </div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">DMCs & Tour Operators</h2>
          <p class="mt-2 text-muted">Your Malaysia ground partner for food experiences. 15 years of local vendor relationships.</p>
        </div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Hotels & Resorts</h2>
          <p class="mt-2 text-muted">Offer guests curated food experiences without building your own program.</p>
        </div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Event Planners</h2>
          <p class="mt-2 text-muted">Corporate dinners, team building, incentive groups. We design food-focused events.</p>
        </div>
      </div>
      <div class="mt-12">
        <a href="/contact/" class="inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors no-underline">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>
