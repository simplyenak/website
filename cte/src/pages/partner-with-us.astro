---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Partner With Us — Malaysia Food Culture & Heritage Tours',
  description: 'Partner with Culinary Travel Experts. Food culture and heritage experiences for travel agents, DMCs, hotels, and event planners.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Partnerships</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Partner With Us</h1>
      <p class="mt-4 text-lg text-muted max-w-3xl">We connect your clients with Malaysia's real food culture — the family recipes, traditional techniques, and local communities that make Malaysian food unique. Structured for trade, built on heritage.</p>
      <div class="mt-10 grid md:grid-cols-2 gap-6 max-w-4xl">
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Travel Agents</h2>
          <p class="mt-2 text-muted">Offer your clients food experiences that go beyond restaurant meals. Market visits, home cooking, heritage food walks. Commission structure and marketing materials included.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">DMCs & Tour Operators</h2>
          <p class="mt-2 text-muted">Your Malaysia ground partner for food culture and heritage experiences. FIT and group capabilities, licensed, insured, with strong local community relationships.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Hotels & Resorts</h2>
          <p class="mt-2 text-muted">Offer guests curated food experiences that connect them with local producers and traditional food culture. We handle design, booking, and logistics.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Event & Incentive Planners</h2>
          <p class="mt-2 text-muted">Corporate events featuring heritage cuisine, team building with local food producers, incentive programs that support traditional food communities.</p>
        </div>
      </div>
      <div class="mt-8">
        <a href="/contact/" class="inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors no-underline">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>
