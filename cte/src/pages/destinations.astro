---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="Destinations" description="Malaysia destinations we operate in — Kuala Lumpur, Penang, Ipoh, and beyond.">
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block text-accent text-sm font-semibold tracking-wide uppercase mb-2">Places</span>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-900">Destinations</h1>
      <p class="mt-4 text-lg text-brand-700 max-w-3xl">Coming soon — destination guides.</p>
    </div>
  </section>
</Layout>
