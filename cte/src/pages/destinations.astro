---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Destinations',
  description: 'Malaysia destinations we operate in — Kuala Lumpur, Penang, Ipoh, and beyond.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Places</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Destinations</h1>
      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white border border-gray-200 p-6 rounded-xl"><h2 class="text-xl font-bold font-heading">Kuala Lumpur</h2><p class="mt-2 text-muted">Malaysia's capital. Street food from three cultures, Chinatown, Kampung Baru, and the best hawker centres.</p></div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl"><h2 class="text-xl font-bold font-heading">Penang</h2><p class="mt-2 text-muted">The food capital. George Town heritage, Nyonya cuisine, fishing villages, and durian orchards.</p></div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl"><h2 class="text-xl font-bold font-heading">Ipoh</h2><p class="mt-2 text-muted">White coffee, bean sprout chicken, Hakka cuisine in a heritage town setting.</p></div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl"><h2 class="text-xl font-bold font-heading">Cameron Highlands</h2><p class="mt-2 text-muted">Tea plantations, strawberry farms, steamboat dinners, highland cuisine.</p></div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl"><h2 class="text-xl font-bold font-heading">Melaka</h2><p class="mt-2 text-muted">Baba Nyonya heritage, Portuguese influences, Jonker Street food.</p></div>
        <div class="bg-white border border-gray-200 p-6 rounded-xl"><h2 class="text-xl font-bold font-heading">Johor</h2><p class="mt-2 text-muted">Laksa Johor, murtabak, southern Malaysia's unique food culture.</p></div>
      </div>
    </div>
  </section>
</Layout>
