---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Malaysia Food Tour Destinations — Kuala Lumpur, Penang, Ipoh & Beyond',
  description: 'Explore our Malaysia food tour destinations. We operate across Kuala Lumpur, Penang, Ipoh, Cameron Highlands, Melaka, Johor, and more.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Places</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Destinations We Operate In</h1>
      <p class="mt-4 text-lg text-muted max-w-3xl">From street food capitals to highland tea plantations — we cover Malaysia's most food-rich destinations.</p>
      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Kuala Lumpur</h2>
          <p class="mt-2 text-muted">Street food from three cultures, Chinatown, Kampung Baru, Brickfields, and the best hawker centres in the region.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Penang</h2>
          <p class="mt-2 text-muted">George Town heritage, Balat morning market, Nyonya cuisine, fishing villages, and durian orchards. Malaysia's food capital.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Ipoh</h2>
          <p class="mt-2 text-muted">White coffee, bean sprout chicken, Hakka cuisine, and a burgeoning food scene in Perak's heritage capital.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Cameron Highlands</h2>
          <p class="mt-2 text-muted">Tea plantations, strawberry farms, steamboat dinners, and the unique cuisine of Malaysia's highland communities.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Melaka</h2>
          <p class="mt-2 text-muted">Baba Nyonya heritage, Portuguese influences, Jonker Street night market, and the original fusion cuisine of Malaysia.</p>
        </div>
        <div class="bg-white border border-brand-100 p-6 rounded-xl">
          <h2 class="text-xl font-bold font-heading">Johor Bahru</h2>
          <p class="mt-2 text-muted">Laksa Johor, murtabak Singapura, and the unique food culture of Malaysia's southern gateway. Easy day trip from Singapore.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
