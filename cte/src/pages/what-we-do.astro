---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'What We Do',
  description: 'Food and heritage ground partner services in Malaysia for travel professionals.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="text-4xl md:text-5xl font-bold font-heading">What We Do</h1>
      <p class="mt-4 text-lg text-muted max-w-3xl">Full service breakdown coming soon.</p>
    </div>
  </section>
</Layout>
