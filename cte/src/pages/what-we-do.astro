---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'What We Do — Malaysian Food Culture & Heritage Tours',
  description: 'Food culture and heritage experiences in Malaysia. Multi-day itineraries, day tours, and sustainable travel for travel professionals.',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Services"
    title="What We Do"
    items={[
      {
        title: 'Multi-Day Food Culture Itineraries',
        description: '3 to 7 days exploring Malaysia through its food heritage. Each stop features producers and cooks who have been feeding their communities for generations. You sell it, we run it.',
      },
      {
        title: 'Day Experiences',
        description: 'Morning market walks with the farmers who supply them, cooking classes in family kitchens, hawker crawls through neighborhoods that have defined Kuala Lumpur\'s food culture for decades.',
      },
      {
        title: 'Sustainable & Community-Focused Trips',
        description: 'Itineraries designed to support local economies, preserve traditional food knowledge, and connect travelers with the people behind Malaysian cuisine. Farm visits, village cooking, producer meetups.',
      },
      {
        title: 'Corporate & Events',
        description: 'Team cooking using local ingredients sourced directly from producers, incentive trips that include community visits, gala dinners featuring heritage recipes from Malaysia\'s diverse culinary cultures.',
      },
      {
        title: 'Itinerary Planning for Partners',
        description: 'You know your clients. We know the food. We plan routes featuring vendors who practice traditional cooking methods and source locally. Detailed day-by-day plans with vetted partners.',
      },
    ]}
    image={{
      src: 'https://cdn.simplyenak.com/payload-media/Penang008.jpg',
      alt: 'Street food in Penang',
    }}
  />
</Layout>
