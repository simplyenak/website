---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact Culinary Travel Experts — Malaysia Food Tour Partner',
  description: 'Get in touch with Culinary Travel Experts. Malaysia food experiences for travel professionals.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="text-accent font-semibold tracking-wide uppercase text-sm">Get in Touch</span>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold font-heading">Contact Us</h1>
      <p class="mt-4 text-lg text-muted max-w-2xl">Send us a message and we will respond.</p>
      <div class="mt-10 grid md:grid-cols-2 gap-12 max-w-4xl">
        <form>
          <div class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-default">Name</label>
              <input type="text" id="name" name="name" required class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-default">Email</label>
              <input type="email" id="email" name="email" required class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default" />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-default">Message</label>
              <textarea id="message" name="message" rows="4" required placeholder="Tell us about your requirements..." class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-accent focus:border-accent text-default"></textarea>
            </div>
            <button type="submit" class="px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-secondary transition-colors cursor-pointer">Send Message</button>
          </div>
        </form>
        <div class="space-y-8">
          <div>
            <h3 class="font-bold font-heading text-lg">Email</h3>
            <p class="text-muted mt-1"><a href="mailto:hello@culinarytravelexperts.com" class="text-accent hover:underline">hello@culinarytravelexperts.com</a></p>
          </div>
          <div>
            <h3 class="font-bold font-heading text-lg">Based In</h3>
            <p class="text-muted mt-1">Kuala Lumpur, Malaysia</p>
          </div>
          <div>
            <h3 class="font-bold font-heading text-lg">Part of</h3>
            <p class="text-muted mt-1"><a href="https://simplyenak.com" class="text-accent hover:underline">Simply Enak</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
