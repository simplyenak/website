---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <section class="py-24 md:py-32 text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-6xl font-serif font-bold text-brand-900">404</h1>
      <p class="mt-4 text-lg text-brand-700">Page not found.</p>
      <a href="/" class="mt-8 inline-flex items-center px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-accent-hover transition-colors no-underline">
        Back to home
      </a>
    </div>
  </section>
</Layout>
