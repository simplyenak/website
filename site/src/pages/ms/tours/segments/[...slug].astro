---
import SegmentPage from '~/components/segment/SegmentPage.astro';
import {travelTypeSegments} from '~/data/segments';

export async function getStaticPaths() {
  return travelTypeSegments.map((s: any) => ({
    params: { slug: s.slug },
    props: { segment: s },
  }));
}

const { segment } = Astro.props;
---
<SegmentPage locale="ms" segmentType="travel_type" segment={segment} />
