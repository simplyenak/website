---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { getAllTours, getFAQs, getDietaryOptionList, getTravelTypeList } from '~/lib/content';
import PlayfulGallery from '~/components/widgets/PlayfulGallery.astro';
import reviews from '~/data/content/reviews.json';

const locale = 'ms';

export async function getStaticPaths() {
  const tours = await getAllTours('ms');
  return tours.map((tour: any) => ({ params: { slug: tour.slug }, props: { tour } }));
}

const { tour } = Astro.props;
const allTours = await getAllTours(locale);
const faqs = await getFAQs();
const dietaryOptions = await getDietaryOptionList();
const travelTypes = await getTravelTypeList();

// Extract city from location string for related tours
const extractCity = (loc: string) => {
  if (!loc) return '';
  const l = loc.toLowerCase();
  if (l.includes('penang')) return 'Penang';
  if (l.includes('kl') || l.includes('kuala lumpur')) return 'Kuala Lumpur';
  return loc.split(':')[0]?.trim() || loc;
};
const currentCity = extractCity(tour.location || '');
const sameCityTours = allTours.filter((t: any) => t.slug !== tour.slug && extractCity(t.location || '') === currentCity).slice(0, 4);

// Filter reviews matching this tour's location
const tourLocation = tour.location?.toLowerCase().includes('penang') ? 'Penang' : 'KL';
const tourReviews = reviews.filter((r: any) => r.location === tourLocation).slice(0, 6);

if (!tour) return Astro.redirect('/ms/tours');

const heroImg = tour.image;
const foods = tour.foods || [];
const foodDescriptions = tour.foodDescriptions || {};
const itinerary = tour.itinerary || [];
const normalizedItinerary = itinerary.map((stop: any) => ({
  time: stop.time,
  title: stop.title,
  description: stop.description || stop.desc || '',
}));

const firstTime = normalizedItinerary.length > 0 ? normalizedItinerary[0].time : '';
let tourTime = 'Daily';
if (firstTime) {
  const hour = parseInt(firstTime.split(':')[0] || '0', 10);
  if (hour < 11) tourTime = 'Morning';
  else if (hour < 16) tourTime = 'Afternoon';
  else tourTime = 'Evening';
}

const meta = {
  title: `${tour.tagline || tour.name}  -  Simply Enak`,
  description: tour.shortDesc || tour.tagline || '',
};

const tourSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristTrip', 'Product'],
  name: tour.name,
  description: tour.shortDesc || tour.tagline || '',
  url: `https://simplyenak.com/ms/tours/${tour.slug}`,
  image: tour.image || 'https://cdn.simplyenak.com/simply_enak_logo_5e7725db1d.webp',
  offers: {
    '@type': 'Offer',
    price: tour.price ? tour.price.replace('RM ', '') : '285',
    priceCurrency: 'MYR',
    availability: 'https://schema.org/InStock',
    url: `https://simplyenak.com/ms/tours/${tour.slug}`,
  },
  itinerary: tour.itinerary?.map((stop: any) => ({
    '@type': 'TouristAttraction',
    name: stop.title,
    description: stop.description || stop.desc || '',
  })) || undefined,
  provider: {
    '@type': 'TouristInformationCenter',
    name: 'Simply Enak',
    url: 'https://simplyenak.com',
  },
};

// Split foods description by comma to allow individual item rendering
const foodList = (tour.foodDescriptions?.split(',') || []).map((f: string) => f.trim()).filter(Boolean);
---

<Layout metadata={meta} structuredData={tourSchema}>
  <!-- Breadcrumb -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-3 text-xs text-muted">
        <a href="/ms" class="hover:text-primary transition-colors">Laman Utama</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/ms/tours" class="hover:text-primary transition-colors">Pusingan</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">{tour.name}</span>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      {heroImg ? (
        <img src={heroImg} alt={tour.name} class="w-full h-full object-cover opacity-50" />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-primary/80 to-accent/60" />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <div class="flex flex-wrap justify-center gap-2 mb-4">
        {tour.featured && <span class="bg-accent text-black text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Pilihan Kami</span>}
        {tour.duration && <span class="bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full">{tour.duration}</span>}
        {tour.tastings && <span class="bg-primary/80 text-white text-xs font-bold px-3 py-1 rounded-full">{tour.tastings}</span>}
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4 leading-tight">{tour.name}</h1>
      {tour.tagline && <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto">{tour.tagline}</p>}
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        {tour.price && (
          <div class="bg-white/10 backdrop-blur-sm rounded-lg px-5 py-3">
            <p class="text-xs text-white/60 uppercase tracking-wider">Harga</p>
            <p class="text-2xl font-bold">{tour.price} <span class="text-sm font-normal text-white/60">/orang</span></p>
          </div>
        )}
        {tour.duration && (
          <div class="bg-white/10 backdrop-blur-sm rounded-lg px-5 py-3">
            <p class="text-xs text-white/60 uppercase tracking-wider">Tempoh</p>
            <p class="text-lg font-bold">{tour.duration}</p>
          </div>
        )}
        {tour.availability && (
          <div class="bg-white/10 backdrop-blur-sm rounded-lg px-5 py-3">
            <p class="text-xs text-white/60 uppercase tracking-wider">Ketersediaan</p>
            <p class="text-lg font-bold">{tour.availability}</p>
          </div>
        )}
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="https://wa.me/601116205810?text=Saya%20berminat%20dengan%20pusingan%20makanan%20Simply%20Enak" target="_blank" class="inline-flex items-center gap-2 bg-green-600 text-white font-bold px-6 py-3 rounded hover:bg-green-700 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Tempah Sekarang
        </a>
        <a href="/ms/contact" class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Hubungi Kami
        </a>
      </div>
    </div>
  </section>

  <!-- Sticky Mobile CTA Bar -->
  <div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 shadow-lg md:hidden p-3">
    <div class="flex items-center justify-between max-w-lg mx-auto">
      <div>
        {tour.price && <p class="text-sm text-muted">{tour.price} <span class="text-xs">/orang</span></p>}
        <p class="text-xs text-muted">{tour.duration || ''}</p>
      </div>
      <div class="flex gap-2">
        <a href="https://wa.me/601116205810?text=Saya%20berminat%20dengan%20pusingan%20makanan%20Simply%20Enak" target="_blank" class="bg-green-600 text-white text-sm font-bold px-4 py-2 rounded whitespace-nowrap">Tempah</a>
        <a href="/ms/contact" class="bg-accent text-black text-sm font-bold px-4 py-2 rounded whitespace-nowrap">Tanya</a>
      </div>
    </div>
  </div>

  <!-- Highlights / Stats -->
  <section class="py-12 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {tour.price && (
          <div>
            <p class="text-2xl font-bold text-primary">{tour.price}</p>
            <p class="text-xs text-muted mt-1">Harga setiap orang</p>
          </div>
        )}
        {tour.duration && (
          <div>
            <p class="text-2xl font-bold text-primary">{tour.duration}</p>
            <p class="text-xs text-muted mt-1">Tempoh</p>
          </div>
        )}
        {tour.tastings && (
          <div>
            <p class="text-2xl font-bold text-primary">{tour.tastings}</p>
            <p class="text-xs text-muted mt-1">Hidangan</p>
          </div>
        )}
        <div>
          <p class="text-2xl font-bold text-primary">{tour.maxGuests || '8'}</p>
          <p class="text-xs text-muted mt-1">Tetamu maks</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About This Tour -->
  <section class="py-16 bg-page">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="flex flex-wrap gap-2 mb-6">
        <span class="bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full">{tourTime}</span>
        {tour.tourCity && <span class="bg-accent/10 text-accent text-xs font-bold px-3 py-1 rounded-full">{tour.tourCity}</span>}
        {tour.location && <span class="bg-muted text-xs font-bold px-3 py-1 rounded-full">{tour.location}</span>}
      </div>
      <h2 class="text-2xl md:text-3xl font-bold font-heading mb-6">Mengenai Pusingan Ini</h2>
      
      <!-- Key Info Grid -->
      {tour.highlights && Array.isArray(tour.highlights) && tour.highlights.length > 0 && (
        <div class="grid gap-4 sm:grid-cols-2 mb-8">
          {tour.highlights.map((h: string, i: number) => (
            <div class="flex items-start gap-3 bg-white rounded-lg border border-gray-100 p-4 shadow-sm">
              <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <span class="text-accent text-sm font-bold">{i + 1}</span>
              </div>
              <p class="text-sm">{h}</p>
            </div>
          ))}
        </div>
      )}

      {tour.shortDesc && (
        <div class="text-muted text-sm leading-relaxed whitespace-pre-line mb-8">{tour.shortDesc}</div>
      )}

      {tour.fullDescription && (
        <div class="prose prose-sm max-w-none text-muted">
          {tour.fullDescription}
        </div>
      )}
    </div>
  </section>

  <!-- Food Gallery -->
  {foods.length > 0 && (
    <section class="py-16 bg-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-4">Apa Yang Akan Anda Rasai</h2>
        <p class="text-sm text-muted mb-8">Setiap hidangan menceritakan kisah tentang warisan makanan Malaysia yang kaya</p>
        <PlayfulGallery items={foods.map((f: any) => ({ ...f, alt: f.name }))} />
        {foodDescriptions && typeof foodDescriptions === 'string' && (
          <div class="mt-6">
            <p class="text-sm text-muted italic">{foodDescriptions}</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Itinerary -->
  {normalizedItinerary.length > 0 && (
    <section class="py-16 bg-page" id="itinerary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-2">Jadual Perjalanan</h2>
        <p class="text-sm text-muted mb-10">Perjalanan langkah demi langkah melalui pengembaraan makanan anda</p>
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute left-5 top-0 bottom-0 w-0.5 bg-accent/20 hidden md:block"></div>
          <div class="space-y-8">
            {normalizedItinerary.map((stop: any, i: number) => (
              <div class="relative md:pl-14">
                <div class="hidden md:flex absolute left-0 w-10 h-10 rounded-full bg-accent text-black items-center justify-center font-bold text-sm z-10 shadow-md">
                  {i + 1}
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                  <div class="flex items-center gap-2 mb-2">
                    {stop.time && <span class="bg-accent/10 text-accent text-xs font-bold px-2 py-0.5 rounded">{stop.time}</span>}
                  </div>
                  <h3 class="text-lg font-bold font-heading mb-2">{stop.title}</h3>
                  {stop.description && <p class="text-sm text-muted leading-relaxed">{stop.description}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- What's Included / What's Not -->
  {(tour.whatsIncluded?.length > 0 || tour.whatsExcluded?.length > 0) && (
    <section class="py-16 bg-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="grid md:grid-cols-2 gap-8">
          {tour.whatsIncluded?.length > 0 && (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
              <h3 class="font-bold font-heading text-lg mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Termasuk
              </h3>
              <ul class="space-y-3">
                {tour.whatsIncluded.map((item: string, i: number) => (
                  <li class="flex items-start gap-2 text-sm"><span class="text-green-600 mt-0.5">•</span>{item}</li>
                ))}
              </ul>
            </div>
          )}
          {tour.whatsExcluded?.length > 0 && (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
              <h3 class="font-bold font-heading text-lg mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Tidak Termasuk
              </h3>
              <ul class="space-y-3">
                {tour.whatsExcluded.map((item: string, i: number) => (
                  <li class="flex items-start gap-2 text-sm"><span class="text-red-500 mt-0.5">•</span>{item}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Meeting Points -->
  {tour.meetingPoints?.length > 0 && (
    <section class="py-16 bg-page">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-2">Titik Pertemuan</h2>
        <p class="text-sm text-muted mb-8">Kami akan menjemput anda dari penginapan anda atau berjumpa di lokasi pusat</p>
        <div class="space-y-4">
          {tour.meetingPoints.map((mp: any, i: number) => (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-sm">{mp.name}</p>
                {mp.address && <p class="text-xs text-muted mt-1">{mp.address}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Booking CTA -->
  <section class="py-16 bg-primary/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold font-heading mb-4">Sedia Untuk Pengalaman Ini?</h2>
      <p class="text-muted max-w-lg mx-auto mb-8">Tempah pusingan anda hari ini dan temui cita rasa sebenar Malaysia bersama pemandu tempatan kami.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://wa.me/601116205810?text=Saya%20berminat%20dengan%20pusingan%20makanan%20Simply%20Enak" target="_blank" class="inline-flex items-center gap-2 bg-green-600 text-white font-bold px-6 py-3 rounded hover:bg-green-700 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Tempah Sekarang
        </a>
        <a href="/ms/contact" class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Ada Soalan?
        </a>
      </div>
    </div>
  </section>

  <!-- Related Tours -->
  {sameCityTours.length > 0 && (
    <section class="py-16 bg-page">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-8">Pusingan Lain di Bandar Ini</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {sameCityTours.map((related: any) => (
            <a href={`/ms/tours/${related.slug}`} class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1">
              <div class="aspect-[16/9] overflow-hidden">
                <img src={related.image || ''} alt={related.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <div class="p-4">
                <h3 class="font-bold font-heading group-hover:text-primary transition-colors">{related.name}</h3>
                <p class="text-xs text-muted mt-1">{related.duration} &middot; {related.price}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Reviews -->
  {tourReviews.length > 0 && (
    <section class="py-16 bg-muted/20" id="reviews">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-2">Apa Kata Tetamu Kami</h2>
        <p class="text-sm text-muted mb-8">Ulasan daripada tetamu yang mengalami pusingan ini</p>
        <div class="grid gap-6 sm:grid-cols-2">
          {tourReviews.slice(0, 4).map((r: any, i: number) => (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
              <div class="flex items-center gap-1 mb-3">
                {[...Array(5)].map((_, j) => (
                  <svg class={`w-4 h-4 ${j < (r.rating || 5) ? 'text-yellow-400' : 'text-gray-200'}`} fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <p class="text-sm text-muted italic mb-4">"{r.text?.slice(0, 250)}{r.text?.length > 250 ? '...' : ''}"</p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <div>
                  <p class="text-sm font-semibold">{r.author}</p>
                  <p class="text-xs text-muted">{r.date} &middot; via Google</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

