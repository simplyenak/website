---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

let pageData: any = {};
try {
  pageData = (await import('~/data/content/how-to-prepare-page.json')).default;
} catch {}

const whatToWear = pageData.whatToWear || [];
const whatToBring = pageData.whatToBring || [];
const whatToExpect = pageData.whatToExpect || [];
const dietaryNotes = pageData.dietary_notes || [];

const heroTitle = pageData.hero_title || 'How to Prepare for Your Food Tour';
const heroDescription = pageData.hero_description || 'A few simple tips to make sure you have the best experience possible.';
const dietaryHeading = pageData.dietary_heading || 'Dietary Notes';
const dietaryIntro = pageData.dietary_intro || 'We can accommodate most dietary requirements. Let us know when you book.';
const ctaText = pageData.directions_cta_text || 'Need directions to the meeting point?';
const ctaButton = pageData.directions_cta_button || 'View Directions';

const meta = {
  title: pageData.seo_title || 'How to Prepare | Simply Enak',
  description: pageData.seo_description || 'How to prepare for your Simply Enak food tour in Malaysia.',
};
---
<Layout metadata={meta}>
  <!-- Breadcrumb -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-3 text-xs text-muted">
        <a href="/ms/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">How To Prepare</span>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <div class="w-full h-full bg-gradient-to-br from-[#2a1a1a] to-[#1a1a1a]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black/80"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <p class="text-accent/90 text-xs uppercase tracking-[0.2em] font-bold mb-3">Preparation</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4">
        <span class="inline-block bg-accent text-black px-4 py-1 rounded-sm" style="transform:rotate(-0.7deg)">
          {heroTitle}
        </span>
        <span class="block text-white/90 text-xl md:text-2xl mt-3 font-normal font-sans">
          {heroDescription}
        </span>
      </h1>
    </div>
  </section>

  <!-- What to Wear -->
  {whatToWear.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Attire</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">What to Wear</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {whatToWear.map((item: any) => (
            <div class="p-6 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm">
              <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center mb-4 text-xl">
                <Icon name="tabler:shirt" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="font-bold font-heading text-default mb-2">{item.title}</h3>
              {item.description && <p class="text-sm text-muted leading-relaxed">{item.description}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- What to Bring -->
  {whatToBring.length > 0 && (
    <section class="py-16 md:py-20 bg-muted/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Packing</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">What to Bring</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {whatToBring.map((item: any) => (
            <div class="p-6 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm">
              <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center mb-4 text-xl">
                <Icon name="tabler:backpack" class="w-5 h-5 text-accent" />
              </div>
              <h3 class="font-bold font-heading text-default mb-2">{item.title}</h3>
              {item.description && <p class="text-sm text-muted leading-relaxed">{item.description}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- What to Expect -->
  {whatToExpect.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Experience</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">What to Expect</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {whatToExpect.map((item: any) => (
            <div class="p-6 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm">
              <h3 class="font-bold font-heading text-default mb-2">{item.title}</h3>
              {item.description && <p class="text-sm text-muted leading-relaxed">{item.description}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dietary -->
  <section class="py-16 md:py-20 bg-muted/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Dietary</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{dietaryHeading}</h2>
        <p class="text-muted max-w-2xl mx-auto mt-3 text-sm">{dietaryIntro}</p>
      </div>
      {dietaryNotes.length > 0 && (
        <div class="grid sm:grid-cols-2 gap-6">
          {dietaryNotes.map((note: any) => (
            <div class="p-6 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm">
              <h3 class="font-bold font-heading text-default mb-2">{note.title}</h3>
              {note.description && <p class="text-sm text-muted leading-relaxed">{note.description}</p>}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold font-heading mb-4">{ctaText}</h2>
      <a href="/ms/directions"
         class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors text-sm">
        <Icon name="tabler:map-pin" class="w-4 h-4" />
        {ctaButton}
      </a>
    </div>
  </section>
</Layout>
