---
import SegmentPage from '~/components/segment/SegmentPage.astro';
import {dietarySegments} from '~/data/segments';

export async function getStaticPaths() {
  return dietarySegments.map((s: any) => ({
    params: { slug: s.slug },
    props: { segment: s },
  }));
}

const { segment } = Astro.props;
---
<SegmentPage locale="ja" segmentType="dietary" segment={segment} />
