---
import Layout from '~/layouts/PageLayout.astro';
import { marked } from 'marked';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStoryBySlug, getImageUrl } from '~/lib/content';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const all = (await import('~/data/content/stories.json')).default as any[];
  return all
    .filter((s: any) => (s.workflowStatus === 'published' || s._status === 'published' || !s._status) && s.content_markdown)
    .map((s: any) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const story = await getStoryBySlug(slug!, 'ja');
if (!story) return Astro.redirect('/ja');

const image = getImageUrl(story.featuredImage || '') as ImageMetadata | string | undefined;

const contentHtml = story.content_markdown ? marked.parse(story.content_markdown) : '';

// Use translated content if available
let finalContent = contentHtml;
if (story.translations) {
  const locale = Astro.url.pathname.split('/')[1];
  const trans = story.translations.find((t: any) => t.languages_code === locale);
  if (trans?.content && typeof trans.content === 'string' && !trans.content.startsWith('[object Object]')) {
    try {
      // Strip leading h1 and code fences from translated markdown to avoid duplicate with template
      let translatedMarkdown = trans.content;
      // Remove markdown code fences if present
      translatedMarkdown = translatedMarkdown.replace(/^```[a-z]*\n?/, '').replace(/```$/,'');
      // Remove leading # Title pattern
      translatedMarkdown = translatedMarkdown.replace(/^#[^\n]+\n\n?/, '');
      finalContent = marked.parse(translatedMarkdown);
    } catch {}
  }
}

// Shape story data into a Post-like object for SinglePost
const post = {
  id: 'payload-' + story.id,
  slug: story.slug,
  permalink: story.slug,
  publishDate: new Date(story.publishedDate || story.createdAt || Date.now()),
  title: story.title || '',
  excerpt: story.excerpt || '',
  image: image,
  author: 'Pauline',
  category: story.category
    ? { title: story.category, slug: story.category.toLowerCase().replace(/\s+/g, '-') }
    : { title: 'Food & Culture Guides', slug: 'food-culture-guides' },
  tags: [],
  locations: story.locationsRef || [],
  metadata: { title: story.meta_title || story.title, description: story.excerpt || '' },
  contents: story.content_markdown || '',
};

const url = getCanonical(getPermalink(post.permalink, 'post'));

const meta = {
  title: story.meta_title || story.title || '',
  description: story.excerpt || '',
};
---

<Layout metadata={meta}>
  <SinglePost post={post} url={url}>
    <div class="prose prose-sm md:prose-base max-w-none dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:text-default prose-headings:leading-tight prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-blockquote:border-l-4 prose-blockquote:border-accent prose-blockquote:bg-accent/5 prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-default prose-blockquote:font-medium prose-blockquote:text-lg prose-li:my-1 dark:prose-blockquote:bg-accent/10 dark:prose-blockquote:text-white" set:html={finalContent} />
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
