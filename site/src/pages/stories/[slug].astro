---
import { marked } from 'marked';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStoryBySlug, getImageUrl, extractLexicalText } from '~/lib/content';
import type { ImageMetadata } from 'astro';
import RelatedTours from '~/components/blog/RelatedTours.astro';
import RelatedLocations from '~/components/blog/RelatedLocations.astro';
import GooglePreferredSources from '~/components/common/GooglePreferredSources.astro';
import { getLangFromUrl } from '~/i18n/utils';

export async function getStaticPaths() {
  // Use resolveStories pipeline so getStaticPaths and getStoryBySlug
  // share the same data source (Live Payload API -> snapshot fallback).
  // Otherwise paths generated at build time can 404 at runtime when
  // live data differs from snapshot (status mismatch, API timeout).
  const { resolveStories } = await import('~/lib/content');
  const all = await resolveStories('en');
  return all
    .filter((s: any) => (s.workflowStatus === 'published' || s._status === 'published' || !s._status) && (s.content_markdown || s.content))
    .map((s: any) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const story = await getStoryBySlug(slug!, 'en');
if (!story) return Astro.redirect('/');

const image = getImageUrl(story.featuredImage || '') as ImageMetadata | string | undefined;

const contentHtml = story.content_markdown ? marked.parse(story.content_markdown) : (story.content ? marked.parse(extractLexicalText(story.content)) : '');

// Shape story data into a Post-like object for SinglePost
const post = {
  id: 'payload-' + story.id,
  slug: story.slug,
  permalink: story.slug,
  publishDate: new Date(story.publishedDate || story.createdAt || Date.now()),
  title: story.title || '',
  excerpt: story.excerpt || '',
  image: image,
  author: 'Pauline',
  category: story.category
    ? { title: story.category, slug: story.category.toLowerCase().replace(/\s+/g, '-') }
    : { title: 'Food & Culture Guides', slug: 'food-culture-guides' },
  tags: [],
  metadata: { title: story.meta_title || story.title, description: story.excerpt || '' },
  contents: story.content_markdown || '',
};

const url = getCanonical(getPermalink(post.permalink, 'post'));

const meta = {
  title: story.meta_title || story.title || '',
  description: story.excerpt || '',
};

// Detect language for the Preferred Sources button
const currentLang = getLangFromUrl(Astro.url);
---

<Layout metadata={meta}>
  <SinglePost post={post} url={url}>
    <div class="prose prose-sm md:prose-base max-w-none dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:text-default prose-headings:leading-tight prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-blockquote:border-l-4 prose-blockquote:border-accent prose-blockquote:bg-accent/5 prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-default prose-blockquote:font-medium prose-blockquote:text-lg prose-li:my-1 dark:prose-blockquote:bg-accent/10 dark:prose-blockquote:text-white" set:html={contentHtml} />
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
  <RelatedLocations locationsRef={story.locationsRef} />
  <RelatedTours specialtyIds={story.specialtyExperiences?.map((s: any) => typeof s === 'object' ? s.id : s) || []} />
  
  <!-- Google Preferred Sources: placed after the story, where readers are most engaged -->
  <GooglePreferredSources lang={currentLang} />
</Layout>
