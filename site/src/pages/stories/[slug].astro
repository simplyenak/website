---
import Layout from '~/layouts/PageLayout.astro';
import { marked } from 'marked';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStoryBySlug, getImageUrl } from '~/lib/content';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const all = (await import('~/data/content/stories.json')).default as any[];
  return all
    .filter((s: any) => (s.workflowStatus === 'published' || s._status === 'published' || !s._status) && s.content_markdown)
    .map((s: any) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const story = await getStoryBySlug(slug!, 'en');
if (!story) return Astro.redirect('/');

const image = getImageUrl(story.featuredImage || '') as ImageMetadata | string | undefined;

const contentHtml = story.content_markdown ? marked.parse(story.content_markdown) : '';

// Shape story data into a Post-like object for SinglePost
const post = {
  id: 'payload-' + story.id,
  slug: story.slug,
  permalink: story.slug,
  publishDate: new Date(story.publishedDate || story.createdAt || Date.now()),
  title: story.title || '',
  excerpt: story.excerpt || '',
  image: image,
  author: typeof story.author === 'object' && story.author !== null
    ? (story.author.fullName || story.author.name || 'Simply Enak')
    : (story.author || 'Simply Enak Team'),
  category: story.category
    ? { title: story.category, slug: story.category.toLowerCase().replace(/\s+/g, '-') }
    : { title: 'Food & Culture Guides', slug: 'food-culture-guides' },
  tags: [],
  metadata: { title: story.meta_title || story.title, description: story.excerpt || '' },
  contents: story.content_markdown || '',
};

const url = getCanonical(getPermalink(post.permalink, 'post'));

const meta = {
  title: story.meta_title || story.title || '',
  description: story.excerpt || '',
};
---

<Layout metadata={meta}>
  <SinglePost post={post} url={url}>
    <div class="prose prose-sm md:prose-base max-w-none prose-headings:font-heading prose-headings:font-bold prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl" set:html={contentHtml} />
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
