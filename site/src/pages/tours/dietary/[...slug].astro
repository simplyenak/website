---
import Layout from '~/layouts/PageLayout.astro';
import { getAllTours, getLandingPageBySlug } from '~/lib/content';
import { dietarySegments } from '~/data/segments';
import { marked } from 'marked';
import reviews from '~/data/content/reviews.json';

// Configure marked for clean output
marked.setOptions({
  breaks: true,
  gfm: true,
});

export async function getStaticPaths() {
  return dietarySegments.map((s: any) => ({
    params: { slug: s.slug },
    props: { segment: s },
  }));
}

const { segment } = Astro.props;
if (!segment) return Astro.redirect('/tours');

const allTours = await getAllTours();
const matchingTours = allTours.filter((t: any) => {
  if (t.dietaryOptions && t.dietaryOptions.includes(segment.slug)) return true;
  if (t.segmentTags && t.segmentTags.includes(segment.slug)) return true;
  if (segment.tours && segment.tours.includes(t.slug)) return true;
  return false;
});

const landingPage = await getLandingPageBySlug(segment.slug);
const intro = landingPage?.hero_description || landingPage?.introduction || segment.description || '';

// Filter reviews mentioning dietary keywords
const dietaryKeywords: Record<string, string> = {
  'vegetarian-food-tours-kuala-lumpur': 'vegetarian',
  'halal-food-tours-kuala-lumpur': 'halal',
  'gluten-free-food-tours-kuala-lumpur': 'gluten free',
  'vegan-food-tours-kuala-lumpur': 'vegan',
  'jain-food-tours-kuala-lumpur': 'jain',
};
const dietKeyword = dietaryKeywords[segment.slug] || '';
const dietaryReviews = dietKeyword ? reviews.filter((r: any) => r.text.toLowerCase().includes(dietKeyword)) : [];
const featuredDietaryReviews = dietaryReviews.length > 0 ? dietaryReviews.slice(0, 6) : [];

const meta = {
  title: `${landingPage?.meta_title || landingPage?.metaTitle || segment.metaTitle || segment.nameFull || segment.name}  -  Simply Enak`,
  description: landingPage?.meta_description || landingPage?.metaDescription || segment.description || '',
};

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: landingPage?.metaTitle || segment.nameFull || segment.name,
  description: landingPage?.metaDescription || segment.description || '',
  url: `https://simplyenak.com/tours/dietary/${segment.slug}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: matchingTours.slice(0, 10).map((t: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: t.name,
        url: `https://simplyenak.com/tours/${t.slug}`,
        description: t.shortDesc || t.tagline || '',
      },
    })),
  },
};
---

<Layout metadata={meta} structuredData={schemaOrg}>
  <!-- Breadcrumb -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-3 text-xs text-muted">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/tours" class="hover:text-primary transition-colors">Tours</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/tours/dietary" class="hover:text-primary transition-colors">Dietary</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">{segment.name}</span>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      {landingPage?.heroImage ? (
        <img src={landingPage.heroImage} alt="" class="w-full h-full object-cover opacity-40" />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-[#2a1a1a] to-[#1a1a1a]"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black/80"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <p class="text-accent/90 text-xs uppercase tracking-[0.2em] font-bold mb-3">Dietary</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4">
        <span class="inline-block bg-accent text-black px-4 py-1 rounded-sm" style="transform:rotate(-0.7deg)">
          {segment.name}
        </span>
        <span class="block text-white/90 text-xl md:text-2xl mt-3 font-normal font-sans">
          {segment.heroSubtitle || landingPage?.heroSubtitle || `Food Tours`}
        </span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto text-sm md:text-base">
        {intro}
      </p>
        )}
    </div>
  </section>

  <!-- Rich editorial content -->
  {landingPage?.content && (
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <div class="prose prose-gray dark:prose-invert max-w-none
                  prose-headings:font-heading prose-headings:font-bold
                  prose-h2:text-2xl prose-h2:md:text-3xl prose-h2:mt-12 prose-h2:mb-4
                  prose-p:text-muted prose-p:text-sm prose-p:md:text-base prose-p:leading-relaxed
                  prose-ul:my-4 prose-li:my-1
                  prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
           set:html={await marked.parse(landingPage.content)} />
    </section>
  )}

  <!-- Tour cards -->
  <section class="bg-muted/30 py-16 scroll-mt-16" id="tours">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{segment.name} Tours</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{matchingTours.length > 0 ? `Our ${segment.name} Tours` : 'Related Tours'}</h2>
        {matchingTours.length > 0 ? (
          <p class="text-muted max-w-2xl mx-auto mt-4 text-sm">Curated for your dietary preferences</p>
        ) : (
          <p class="text-muted max-w-2xl mx-auto mt-4 text-sm">Browse all our available tours</p>
        )}
      </div>

      {matchingTours.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {matchingTours.map((tour: any) => (
            <a href={`/tours/${tour.slug}`} class="group block rounded-xl border bg-card shadow-sm overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1">
              {tour.image && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img src={tour.image} alt={tour.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </div>
              )}
              <div class="p-5">
                <h3 class="text-lg font-bold font-heading group-hover:text-primary">{tour.name}</h3>
                <p class="text-sm text-muted mt-1 line-clamp-2">{tour.tagline}</p>
                <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
                  <span class="font-semibold text-foreground">{tour.price}</span>
                  {tour.duration && <span>{tour.duration}</span>}
                  {tour.schedule && <span>&middot; {tour.schedule}</span>}
                </div>
                <div class="mt-3">
                  <span class="inline-block text-accent text-xs font-semibold group-hover:underline">View Details &rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center">
          <a href="/tours" class="inline-block bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors text-sm">
            Browse All Tours
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Guest reviews -->
  {featuredDietaryReviews.length > 0 && (
    <section class="py-16 bg-gradient-to-b from-transparent to-muted/20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">What Guests Say</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">Real Reviews from Real Guests</h2>
          <p class="text-muted max-w-2xl mx-auto mt-4 text-sm">Guest experiences on our {segment.name}</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredDietaryReviews.map((r: any) => (
            <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col">
              <div class="flex items-center gap-1 mb-3">
                {Array.from({ length: r.rating }).map(() => (
                  <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="text-sm text-muted italic flex-grow">&ldquo;{r.text.length > 180 ? r.text.slice(0, 180) + '&hellip;' : r.text}&rdquo;</p>
              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/10">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-semibold">{r.author}</p>
                    <p class="text-xs text-muted">{r.guide ? `with ${r.guide} &middot; ` : ''}{r.date}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dietary segment chips (other dietary options) -->
  {dietarySegments.length > 1 && (
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h3 class="text-xl font-bold font-heading mb-6">Explore More Dietary Options</h3>
        <div class="flex flex-wrap gap-3 justify-center">
          {dietarySegments.filter((s: any) => s.slug !== segment.slug).map((s: any) => (
            <a href={`/tours/dietary/${s.slug}`}
               class="chip inline-block border-2 border-gray-300 dark:border-white/20 rounded-full px-5 py-2 text-sm font-semibold text-default hover:bg-primary hover:border-primary hover:text-white transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
              {s.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
