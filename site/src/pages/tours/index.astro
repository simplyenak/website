---
import Layout from '~/layouts/PageLayout.astro';
import { getAllTours, getSpecialtyList, getTravelTypeList } from '~/lib/content';
import { dietarySegments, locationSegments, specialtySegments, travelTypeSegments } from '~/data/segments';
const tours = await getAllTours();
const specialties = await getSpecialtyList();
const travelTypeList = await getTravelTypeList();

const metadata = {
  title: 'Food Tours in Malaysia',
  description: 'Explore our range of authentic Malaysian food and culture tours in Kuala Lumpur, Penang, Melaka, Ipoh and beyond.',
};

// All 5 signature tours
const signatureTours = tours.slice(0, 5);

// Experience types - map specialty slugs to hero images and landing page slugs
const experienceImages: Record<string, string> = {
  'street-food': 'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
  'market-tour': 'https://se-website-images.s3.nl-ams.scw.cloud/Flavours_of_Malaysia001_41094a74f7.jpg',
  'heritage': 'https://se-website-images.s3.nl-ams.scw.cloud/Eat_Drink_Georgetown1_72aaaf12b6.jpg',
  'night-tour': 'https://se-website-images.s3.nl-ams.scw.cloud/secrets_of_KL_Nightlife_Tour002_294155fa7e.jpg',
};
const experienceSlugMap: Record<string, string> = {
  'street-food': 'street-food-tours-kuala-lumpur',
  'market-tour': 'market-tours-kuala-lumpur',
  'heritage': 'heritage-food-tours-kuala-lumpur',
  'night-tour': 'night-food-tours-kuala-lumpur',
};
const experienceTypes = specialties
  .filter((s: any) => experienceImages[s.slug] && experienceSlugMap[s.slug])
  .map((s: any) => ({ name: s.name, slug: experienceSlugMap[s.slug], image: experienceImages[s.slug] }));

// Travel types with hero images and correct segment slugs
const travelImages: Record<string, { image: string; icon: string }> = {
  'family': { image: 'https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg', icon: '👨‍👩‍👧‍👦' },
  'couples': { image: 'https://se-website-images.s3.nl-ams.scw.cloud/Eat_Drink_George_Town_Bart_1527cf1f89.jpeg', icon: '💑' },
  'foodie': { image: 'https://se-website-images.s3.nl-ams.scw.cloud/Flavours_of_Malaysia001_41094a74f7.jpg', icon: '🍽️' },
};
const travelSlugMap: Record<string, string> = {
  'family': 'food-tours-for-families-kuala-lumpur',
  'couples': 'food-tours-for-couples-kuala-lumpur',
  'foodie': 'food-tours-for-foodies-kuala-lumpur',
};
const travelWith = travelTypeList
  .filter((t: any) => travelImages[t.slug] && travelSlugMap[t.slug])
  .map((t: any) => ({ name: t.name, slug: travelSlugMap[t.slug], image: travelImages[t.slug].image, icon: travelImages[t.slug].icon }));
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg" alt="" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a1a]/70 via-[#1a1a1a]/85 to-[#1a1a1a]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-6 leading-tight">
        Food, Culture & Heritage Tours<br />in <span class="text-accent">KL, Ipoh & Penang</span>
      </h1>
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <a href="#tours" class="bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors">
          SEE ALL TOURS
        </a>
        <a href="/tours" class="border border-white/30 text-white font-semibold px-6 py-3 rounded hover:bg-white/10 transition-colors">
          PLAN A PRIVATE TOUR
        </a>
      </div>
    </div>
  </section>

  <!-- Sticky Navigation -->
  <nav class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm" aria-label="Tours page sections">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-2 py-3 overflow-x-auto">
        <a href="#tours" class="text-sm font-semibold px-4 py-1.5 rounded-full bg-primary text-white whitespace-nowrap">All Tours</a>
        <a href="#private" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Private</a>
        <a href="#city" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">By City</a>
        <a href="#dietary" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Dietary</a>
        <a href="#experiences" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Experiences</a>
        <a href="#who" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Who With</a>
        <a href="#groups" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Groups</a>
      </div>
    </div>
  </nav>

  <!-- Breadcrumb -->
  <div class="bg-page py-4 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="flex items-center text-sm text-muted">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-primary font-medium">Tours</span>
      </nav>
    </div>
  </div>

  <!-- Three Ways to Experience -->
  <section class="py-16 bg-page" id="private">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">YOUR CHOICE</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Three Ways to Experience Malaysia</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Private tour, tailored route, or small group. Pick what fits you.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Private Tour -->
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <h3 class="text-xl font-bold font-heading mb-3">Private Tour</h3>
          <p class="text-sm text-muted mb-4">Any of our signature tours, run privately for your group. Includes hotel pickup and dietary needs accommodated in advance.</p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Your group only</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Hotel pickup included</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Flexible start time</li>
          </ul>
          <a href="/tours/private-tours" class="inline-block bg-primary text-white font-semibold px-5 py-2.5 rounded hover:bg-primary/90 transition-colors text-sm">Book a Private Tour</a>
        </div>

        <!-- Tailored Experience -->
        <div class="bg-white rounded-xl border-2 border-accent shadow-md p-6 relative">
          <span class="absolute -top-3 left-4 bg-accent text-black text-xs font-bold px-3 py-1 rounded-full">POPULAR</span>
          <h3 class="text-xl font-bold font-heading mb-3">Tailored Experience</h3>
          <p class="text-sm text-muted mb-4">Custom route designed around your interests. Pre-tour WhatsApp planning with your guide.</p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Fully customized route</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Any duration</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Special dietary focus</li>
          </ul>
          <a href="/contact" class="inline-block bg-accent text-black font-semibold px-5 py-2.5 rounded hover:bg-accent/90 transition-colors text-sm">Tell Us What You Want</a>
        </div>

        <!-- Join a Small Group -->
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <h3 class="text-xl font-bold font-heading mb-3">Join a Small Group</h3>
          <p class="text-sm text-muted mb-4">Book a spot on one of our scheduled tours alongside fellow travellers. Max 9 guests.</p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> From RM 285/person</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Max 9 guests</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Fixed schedule</li>
          </ul>
          <a href="#tours" class="inline-block bg-primary text-white font-semibold px-5 py-2.5 rounded hover:bg-primary/90 transition-colors text-sm">Browse All Tours</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Signature Food Tours -->
  <section class="py-16" id="tours">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">THE ORIGINALS</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Our Signature Food Tours</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">The 5 tours that started it all. Each one built around vendors we've known for over a decade.</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {signatureTours.map((tour: any) => (
          <a href={`/tours/${tour.slug}`} class="group block bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={tour.image} alt={tour.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute bottom-2 left-2 flex gap-2">
                <span class="bg-primary text-white text-xs font-bold px-2 py-1 rounded">{tour.duration}</span>
                <span class="bg-accent text-black text-xs font-bold px-2 py-1 rounded">{tour.tastings || '8-10 tastings'}</span>
              </div>
            </div>
            <div class="p-4">
              <h3 class="font-bold font-heading text-lg group-hover:text-primary">{tour.name}</h3>
              <p class="text-xs text-muted mt-1">{tour.tagline}</p>
              <p class="text-xs text-accent font-semibold mt-1">FOOD TOUR</p>
              <div class="mt-3 flex items-center justify-between">
                <div>
                  <span class="text-xs text-muted">from</span>
                  <span class="font-bold text-primary ml-1">{tour.price}</span>
                </div>
                <span class="text-sm text-accent font-semibold group-hover:underline">View Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tours by City -->
  <section class="py-16 bg-muted/30" id="city">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">BY DESTINATION</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Tours by City</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Every Malaysian city tells a different food story. Choose your chapter.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Kuala Lumpur -->
        <a href="/tours/locations/food-tours-kuala-lumpur" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg" alt="Kuala Lumpur" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">KUALA LUMPUR</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Kuala Lumpur</h3>
            <p class="text-sm text-white/80 mt-2">From Chinatown hawkers to Indian curry houses. KL's multicultural food scene.</p>
            <span class="text-accent font-semibold text-sm mt-3">3 tours →</span>
          </div>
        </a>

        <!-- Penang -->
        <a href="/tours/locations/food-tours-penang" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/Eat_Drink_Georgetown1_72aaaf12b6.jpg" alt="Penang" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">PENANG</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Penang</h3>
            <p class="text-sm text-white/80 mt-2">Asia's food capital. Peranakan heritage, hawker culture, and island charm.</p>
            <span class="text-accent font-semibold text-sm mt-3">2 tours →</span>
          </div>
        </a>

        <!-- Melaka -->
        <a href="/tours/locations/food-tours-melaka" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/melaka-cultural-tour.jpg" alt="Melaka" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">MELAKA</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Melaka</h3>
            <p class="text-sm text-white/80 mt-2">600 years of Peranakan heritage. Nyonya cuisine and Portuguese-Eurasian flavors.</p>
            <span class="text-accent font-semibold text-sm mt-3">Coming soon →</span>
          </div>
        </a>

        <!-- Ipoh -->
        <a href="/tours/locations/food-tours-ipoh" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/ipoh-old-town.jpg" alt="Ipoh" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">IPOH</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Ipoh</h3>
            <p class="text-sm text-white/80 mt-2">Old town charm, white coffee heritage, and bean sprout chicken fame.</p>
            <span class="text-accent font-semibold text-sm mt-3">Coming soon →</span>
          </div>
        </a>

        <!-- Klang -->
        <a href="/tours/locations/food-tours-klang" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg" alt="Klang" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">KLANG</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Klang</h3>
            <p class="text-sm text-white/80 mt-2">Birthplace of bak kut teh. Royal Malay heritage and port town traditions.</p>
            <span class="text-accent font-semibold text-sm mt-3">Coming soon →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- By Dietary -->
  <section class="py-16" id="dietary">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">DIETARY PREFERENCES</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Tours by Dietary Need</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Every tour can be adapted. These are our dedicated dietary experiences.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {dietarySegments.filter((s: any, i: number, arr: any[]) => 
          i === arr.findIndex((a: any) => a.name === s.name)
        ).map((s: any) => (
          <a href={`/tours/dietary/${s.slug}`} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src="https://se-website-images.s3.nl-ams.scw.cloud/vegetarian-heritage.jpg" alt={s.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <h3 class="text-xl font-bold font-heading">{s.name}</h3>
              <span class="text-sm text-white/80 group-hover:underline mt-1">Tours →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- By Experience -->
  <section class="py-16 bg-muted/30" id="experiences">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">EXPERIENCE TYPE</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Tours by Experience</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">From morning markets to night food adventures.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {experienceTypes.map((s: any) => (
          <a href={`/tours/specialty/${s.slug}`} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src={s.image} alt={s.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <h3 class="text-xl font-bold font-heading">{s.name}</h3>
              <span class="text-sm text-white/80 group-hover:underline mt-1">View →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Who You're Traveling With -->
  <section class="py-16" id="who">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">TRAVEL STYLE</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Who You're Traveling With</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Tours designed for your specific travel group.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {travelWith.map((s: any) => (
          <a href={`/tours/segments/${s.slug}`} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src={s.image} alt={s.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <span class="text-2xl mb-1">{s.icon}</span>
              <h3 class="text-xl font-bold font-heading">{s.name}</h3>
