---
import SegmentPage from '~/components/segment/SegmentPage.astro';
import {locationSegments} from '~/data/segments';

export async function getStaticPaths() {
  return locationSegments.map((s: any) => ({
    params: { slug: s.slug },
    props: { segment: s },
  }));
}

const { segment } = Astro.props;
---
<SegmentPage locale="en" segmentType="location" segment={segment} />
