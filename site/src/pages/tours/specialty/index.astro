---
import Layout from '~/layouts/PageLayout.astro';
import { specialtySegments } from '~/data/segments';

const metadata = {
  title: 'Food Tours by Specialty in Malaysia',
  description: 'Browse our food tours by specialty: street food, heritage, market tours, night food, and durian season experiences.',
  canonical: 'https://simplyenak.com/tours/specialty',
};

// Sort by name for consistent ordering
const sorted = [...specialtySegments].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">Food Tours by Specialty</h1>
    <p class="text-xl text-gray-600 mb-12">Choose a specialty to find the perfect food experience.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((segment) => (
        <a href={`/tours/specialty/${segment.slug}`} class="group block p-6 bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100">
          <h2 class="text-xl font-semibold mb-2 group-hover:text-accent">{segment.nameFull || segment.name}</h2>
          <p class="text-gray-600 text-sm mb-4 line-clamp-3">{segment.description}</p>
          <span class="text-accent font-medium text-sm">View tours →</span>
        </a>
      ))}
    </div>

    <div class="mt-12 p-6 bg-gray-50 rounded-lg">
      <h2 class="text-xl font-semibold mb-4">Popular Tours</h2>
      <ul class="space-y-2">
        <li><a href="/tours/specialty/street-food-tours" class="text-accent hover:underline">Street Food Tours</a></li>
        <li><a href="/tours/specialty/heritage-food-tours" class="text-accent hover:underline">Heritage Food Tours</a></li>
        <li><a href="/tours/specialty/market-tours" class="text-accent hover:underline">Market Tours</a></li>
        <li><a href="/tours/specialty/night-food-tours" class="text-accent hover:underline">Night Food Tours</a></li>
        <li><a href="/tours/specialty/durian-season-malaysia" class="text-accent hover:underline">Durian Season Tours</a></li>
      </ul>
    </div>
  </div>
</Layout>
