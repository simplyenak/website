---
import Layout from '~/layouts/PageLayout.astro';
import { getAllTours, getLandingPageBySlug } from '~/lib/content';
import { specialtySegments } from '~/data/segments';
import { marked } from 'marked';

// Configure marked for clean output
marked.setOptions({
  breaks: true,
  gfm: true,
});

export async function getStaticPaths() {
  return specialtySegments.map((s: any) => ({
    params: { slug: s.slug },
    props: { segment: s },
  }));
}

const { segment } = Astro.props;
if (!segment) return Astro.redirect('/tours');

const allTours = await getAllTours();
const matchingTours = allTours.filter((t: any) => {
  if (t.specialtyExperiences && t.specialtyExperiences.includes(segment.slug)) return true;
  if (t.segmentTags && t.segmentTags.includes(segment.slug)) return true;
  if (segment.tours && segment.tours.includes(t.slug)) return true;
  return false;
});

const landingPage = await getLandingPageBySlug(segment.slug);
const intro = landingPage?.hero_description || landingPage?.introduction || segment.description || '';

const meta = {
  title: `${landingPage?.meta_title || landingPage?.metaTitle || segment.metaTitle || segment.nameFull || `${segment.name} Tours`}  -  Simply Enak`,
  description: landingPage?.meta_description || landingPage?.metaDescription || segment.description || '',
};

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: landingPage?.meta_title || landingPage?.metaTitle || `${segment.name} Tours`,
  description: landingPage?.meta_description || landingPage?.metaDescription || segment.description || '',
  url: `https://simplyenak.com/tours/specialty/${segment.slug}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: matchingTours.slice(0, 10).map((t: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: t.name,
        url: `https://simplyenak.com/tours/${t.slug}`,
        description: t.shortDesc || t.tagline || '',
      },
    })),
  },
};
---

<Layout metadata={meta} structuredData={schemaOrg}>
  <!-- Breadcrumb -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-3 text-xs text-muted">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/tours" class="hover:text-primary transition-colors">Tours</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/tours/specialty" class="hover:text-primary transition-colors">Experiences</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">{segment.name}</span>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      {landingPage?.hero_image || landingPage?.heroImage ? (
        <img src={landingPage.hero_image || landingPage.heroImage} alt="" class="w-full h-full object-cover opacity-40" />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-[#2a1a2a] to-[#1a1a1a]"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black/80"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <p class="text-accent/90 text-xs uppercase tracking-[0.2em] font-bold mb-3">Experience</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4">
        <span class="inline-block bg-accent text-black px-4 py-1 rounded-sm" style="transform:rotate(-0.7deg)">
          {landingPage?.hero_title || segment.name}
        </span>
        <span class="block text-white/90 text-xl md:text-2xl mt-3 font-normal font-sans">
          {landingPage?.hero_subtitle || segment.heroSubtitle || landingPage?.heroSubtitle || `Tours`}
        </span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto text-sm md:text-base">
        {intro}
      </p>
    </div>
  </section>

  <!-- Rich editorial content -->
  {landingPage?.content && (
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <div class="prose prose-gray dark:prose-invert max-w-none
                  prose-headings:font-heading prose-headings:font-bold
                  prose-h2:text-2xl prose-h2:md:text-3xl prose-h2:mt-12 prose-h2:mb-4
                  prose-p:text-muted prose-p:text-sm prose-p:md:text-base prose-p:leading-relaxed
                  prose-ul:my-4 prose-li:my-1
                  prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
           set:html={await marked.parse(landingPage.content)} />
    </section>
  )}

  <!-- City variant links for generic pages -->
  {segment.cityVariants && segment.cityVariants.length > 0 && (
    <section class="py-12 bg-white dark:bg-[#1e1c1c]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Explore by City</p>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-default mb-8">Choose Your Destination</h2>
        <div class="flex flex-wrap gap-3 justify-center">
          {segment.cityVariants.map((variantSlug: string) => {
            const variant = specialtySegments.find((s: any) => s.slug === variantSlug);
            return variant ? (
              <a href={`/tours/specialty/${variant.slug}`}
                 class="inline-flex items-center gap-2 border-2 border-gray-200 dark:border-white/20 rounded-full px-6 py-3 text-sm font-semibold text-default hover:bg-primary hover:border-primary hover:text-white transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
                {variant.nameFull || variant.name}
              </a>
            ) : null;
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Tour cards -->
  <section class="bg-muted/30 py-16 scroll-mt-16" id="tours">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{segment.name} Tours</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{matchingTours.length > 0 ? `Our ${segment.name} Tours` : 'Related Tours'}</h2>
        <p class="text-muted max-w-2xl mx-auto mt-4 text-sm">Curated experiences</p>
      </div>

      {matchingTours.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {matchingTours.map((tour: any) => (
            <a href={`/tours/${tour.slug}`} class="group block rounded-xl border bg-card shadow-sm overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1">
              {tour.image && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img src={tour.image} alt={tour.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </div>
              )}
              <div class="p-5">
                <h3 class="text-lg font-bold font-heading group-hover:text-primary">{tour.name}</h3>
                <p class="text-sm text-muted mt-1 line-clamp-2">{tour.tagline}</p>
                <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
                  <span class="font-semibold text-foreground">{tour.price}</span>
                  {tour.duration && <span>{tour.duration}</span>}
                  {tour.schedule && <span>&middot; {tour.schedule}</span>}
                </div>
                <div class="mt-3">
                  <span class="inline-block text-accent text-xs font-semibold group-hover:underline">View Details &rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center">
          <a href="/tours" class="inline-block bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors text-sm">
            Browse All Tours
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Specialty segment chips (other specialty options) -->
  {specialtySegments.length > 1 && (
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h3 class="text-xl font-bold font-heading mb-6">Explore More Experiences</h3>
        <div class="flex flex-wrap gap-3 justify-center">
          {specialtySegments.filter((s: any) => s.slug !== segment.slug).map((s: any) => (
            <a href={`/tours/specialty/${s.slug}`}
               class="chip inline-block border-2 border-gray-300 dark:border-white/20 rounded-full px-5 py-2 text-sm font-semibold text-default hover:bg-primary hover:border-primary hover:text-white transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
              {s.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
