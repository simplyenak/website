---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { getAllTours } from '~/lib/content';

let pageData: any = {};
try {
  pageData = (await import('~/data/content/comparison-page.json')).default;
} catch {}

const allTours = await getAllTours();
const signatureTours = allTours.slice(0, 5);

const pageTitle = pageData.page_title || 'Why Simply Enak — See How We Compare to Other Food Tours';
const pageSubtitle = pageData.page_subtitle || '';
const heroDescription = pageData.hero_description || 'No fluff, no fake claims. Here is how we actually compare to Food Tour Malaysia and Secret Food Tours, the two most visible food tour operators in Kuala Lumpur and Penang. See for yourself what matters.';
const comparisonIntro = pageData.comparison_intro || 'There are two main food tour operators in KL and Penang besides Simply Enak: Food Tour Malaysia (independent, running since 2012) and Secret Food Tours (international chain with a KL outpost). This page compares Simply Enak against these real alternatives with actual data verified from their websites.';
const competitors = pageData.competitors || [];
const comparisonRows = pageData.comparison_rows || [];
const trustBadges = pageData.trust_badges || [];
const ctaSection = pageData.cta_section || {};

// Hardcoded comparator names for display
const competitorLabels = ['Food Tour Malaysia', 'Secret Food Tours'];

// Head-to-head: specific tour comparisons (hardcoded as they reference specific tours)
const headToHead = [
  {
    ourTour: 'Flavours of Malaysia',
    ourSlug: 'flavours-of-malaysia',
    ourPrice: 'RM 289',
    ourDesc: 'Wet market walkthrough, 10 tastings, 4 hours. KL\'s largest wet market plus Chinatown and temples.',
    competitorName: 'Secret Food Tours: Kuala Lumpur',
    competitorPrice: 'USD 49.99 (~RM 220)',
    competitorDesc: '3-3.5 hours, 12+ stops, hawker stalls and cafes. Max 12 people. Global franchise format.',
    advantage: 'Simply Enak takes you through a real working wet market where your guide knows every stall owner by name. You won\'t find that on any other KL food tour.',
    ourTag: 'Simply Enak',
    competitorTag: 'Secret Food Tours',
  },
  {
    ourTour: 'KL Street Food',
    ourSlug: 'kuala-lumpur-street-food',
    ourPrice: 'RM 285',
    ourDesc: 'Chinatown and Little India, 8-10 tastings, 3.5 hours. Easy walking pace with rest stops.',
    competitorName: 'Food Tour Malaysia - Off The Eaten Track',
    competitorPrice: 'USD 62 (~RM 275)',
    competitorDesc: 'Evening 7-11PM, min 2 pax, private vehicle transport between stops. Same-style format.',
    advantage: 'Simply Enak stays on foot through actual neighbourhoods. You walk into the city, not just its food courts. Small groups mean you hear every story.',
    ourTag: 'Simply Enak',
    competitorTag: 'Food Tour Malaysia',
  },
  {
    ourTour: 'Eat Drink George Town',
    ourSlug: 'georgetown-night-food-durian',
    ourPrice: 'RM 359',
    ourDesc: 'Evening tour, 8 tastings plus craft cocktails, 4 hours. Speakeasy bars and secret society tales.',
    competitorName: 'Food Tour Malaysia - Eat Like A Local (Penang)',
    competitorPrice: 'USD 67 (~RM 297)',
    competitorDesc: 'Brunch or dinner, 3.5-4 hours, private vehicle. Requires 2-day advance booking.',
    advantage: 'Simply Enak is the only tour combining Penang street food with speakeasy cocktail culture. Secret society tales and hidden bars make it a night out, not just dinner.',
    ourTag: 'Simply Enak',
    competitorTag: 'Food Tour Malaysia',
  },
];

const meta = {
  title: pageData.meta_title || 'Why Simply Enak — See How We Compare to Other Food Tours',
  description: pageData.meta_description || 'Wondering what makes us different? Small groups (max 9), real wet markets, 10+ year vendor relationships, and every diet accommodated. Here is how we compare to other food tours in KL and Penang.',
  structuredData: {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How is Simply Enak different from Food Tour Malaysia?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Simply Enak runs genuinely small groups (max 9), visits real working wet markets instead of driving between food courts, accommodates all diets by default (vegetarian, vegan, halal, gluten-free), and has guides with 10+ year relationships with every vendor. Food Tour Malaysia uses private vehicle transport between stops rather than walking, requires advance booking, and explicitly disclaims dietary liability."
        }
      },
      {
        "@type": "Question",
        "name": "How does Simply Enak compare to Secret Food Tours?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Secret Food Tours offers one standardized tour in KL for 12 people at USD 49.99. Simply Enak offers 5 distinct tours across KL and Penang at RM 285-359, each with different themes like wet markets, evening speakeasies, and heritage exploration. Simply Enak's groups are smaller (max 9), the experience is local and guide-led rather than a global franchise format."
        }
      }
    ]
  }
};
---

<Layout metadata={meta}>
  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://cdn.simplyenak.com/Flavours_of_Malaysia001_41094a74f7.jpg" alt="" class="w-full h-full object-cover opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a1a]/70 via-[#1a1a1a]/85 to-[#1a1a1a]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-center">
      <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">HONEST COMPARISON</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4 leading-tight">
        Why Simply Enak<br /><span class="text-lg md:text-xl font-normal text-white/80">See How We Compare</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto text-sm md:text-base">
        {heroDescription}
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <div class="bg-page py-4 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="flex items-center text-sm text-muted">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/tours" class="hover:text-primary transition-colors">Tours</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-primary font-medium">Comparison</span>
      </nav>
    </div>
  </div>

  <!-- Intro -->
  <section class="py-12 bg-page">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-6">Why This Comparison Exists</h2>
        <div class="space-y-4 text-sm text-muted leading-relaxed">
          <p>{comparisonIntro}</p>
          <p>This page compares <strong>Simply Enak</strong> against these real alternatives with actual data we verified from their websites. No generic competitors, no straw men. Just an honest look at what changes when you pick one over another.</p>
          <p class="bg-accent/10 border-l-4 border-accent p-4 rounded text-default">
            <strong>Short version:</strong> If you want small groups (max 9), real markets, a guide who's been visiting the same vendors for a decade, and dietary accommodation that's actually covered, Simply Enak is the only operator in KL doing all of this.
          </p>
        </div>
      </div>

      <!-- TL;DR Box -->
      <div class="max-w-3xl mx-auto mt-8">
        <div class="bg-accent/10 border-2 border-accent rounded-xl p-6">
          <p class="text-xs uppercase tracking-wider text-accent font-bold mb-2">TL;DR</p>
          <p class="text-sm text-default leading-relaxed font-medium">
            <strong>Simply Enak wins for real food tours.</strong> It's the only operator walking you through working wet markets, keeping groups to 9 people max, with guides who've known their vendors for a decade. All diets covered, no extra charge. <strong>Food Tour Malaysia</strong> uses private vehicles between food-court stops and puts dietary responsibility on you. <strong>Secret Food Tours</strong> is a global franchise with one standardized KL tour for $49.99. Good value, but max 12 people and no market walk.
          </p>
          <p class="text-xs text-muted mt-2">
            Pick Simply Enak for the real thing. Pick Secret Food Tours for a budget-friendly intro. Pick Food Tour Malaysia if you prefer a vehicle between stops.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- At a Glance: Feature Comparison (from JSON) -->
  {comparisonRows.length > 0 && (
    <section class="py-12 bg-muted/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">AT A GLANCE</p>
          <h2 class="text-2xl md:text-3xl font-bold font-heading">Simply Enak vs Real Competitors</h2>
          <p class="text-muted max-w-xl mx-auto mt-3 text-sm">Compared against {competitors.length > 1 ? competitors.slice(1).map((c: any) => c.name).join(' and ') : 'the most visible alternatives'}, the two most visible alternatives.</p>
        </div>

        <div class="overflow-x-auto rounded-xl shadow-sm border border-gray-100">
          <table class="w-full text-sm bg-white">
            <thead>
              <tr class="bg-[#1a1a1a] text-white">
                <th class="text-left px-5 py-4 font-bold">Feature</th>
                <th class="text-left px-5 py-4 font-bold text-accent">
                  <span class="flex items-center gap-2">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                    Simply Enak
                  </span>
                </th>
                {competitors.slice(1).map((comp: any) => (
                  <th class="text-left px-5 py-4 font-bold text-muted">{comp.name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row: any, i: number) => (
                <tr class={`${i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'} ${row.highlight ? 'border-l-2 border-accent' : ''}`}>
                  <td class="px-5 py-4 font-semibold whitespace-nowrap">{row.feature}</td>
                  <td class="px-5 py-4 text-primary font-medium text-sm leading-relaxed">{row.us_value}</td>
                  {row.competitor_values && row.competitor_values.map((cv: any) => (
                    <td class="px-5 py-4 text-muted text-sm leading-relaxed">{cv.value}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- Trust Badges -->
  {trustBadges.length > 0 && (
    <section class="py-12 bg-page">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {trustBadges.map((badge: any) => (
            <div class="text-center p-4">
              <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-3">
                {badge.icon ? (
                  <Icon name={badge.icon} class="w-5 h-5 text-accent" />
                ) : (
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                )}
              </div>
              <p class="text-xs font-semibold text-default">{badge.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Head to Head: Real Comparisons -->
  <section class="py-12 bg-muted/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">TOUR BY TOUR</p>
        <h2 class="text-2xl md:text-3xl font-bold font-heading">How Our Tours Compare Head-to-Head</h2>
        <p class="text-muted max-w-xl mx-auto mt-3 text-sm">Specific comparisons against the closest alternatives available in KL and Penang.</p>
      </div>

      <div class="space-y-6">
        {headToHead.map((h2h) => (
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="grid md:grid-cols-2 gap-0">
              <!-- Our Tour -->
              <div class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-gray-100">
                <span class="text-xs uppercase tracking-wider text-accent font-bold mb-2 block">
                  <svg class="w-4 h-4 inline mr-1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                  Simply Enak
                </span>
                <h3 class="text-xl font-bold font-heading mb-1">
                  <a href={`/tours/${h2h.ourSlug}`} class="hover:text-primary transition-colors">{h2h.ourTour}</a>
                </h3>
                <span class="text-accent font-bold text-lg">{h2h.ourPrice}</span>
                <p class="text-sm text-muted mt-3 leading-relaxed">{h2h.ourDesc}</p>
              </div>
              <!-- Competitor -->
              <div class="p-6 md:p-8 bg-gray-50/50">
                <span class="text-xs uppercase tracking-wider text-muted font-bold mb-2 block">{h2h.competitorTag}</span>
                <h3 class="text-xl font-bold font-heading mb-1 text-muted">{h2h.competitorName}</h3>
                <span class="text-muted font-bold text-lg">{h2h.competitorPrice}</span>
                <p class="text-sm text-muted mt-3 leading-relaxed">{h2h.competitorDesc}</p>
              </div>
            </div>
            <div class="bg-accent/5 px-6 md:px-8 py-4 border-t border-gray-100">
              <p class="text-sm font-medium flex items-start gap-2">
                <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>{h2h.advantage}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Price Comparison -->
  <section class="py-12 bg-page">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">VALUE FOR MONEY</p>
        <h2 class="text-2xl md:text-3xl font-bold font-heading">Price Comparison</h2>
        <p class="text-muted max-w-xl mx-auto mt-3 text-sm">What you actually get for your money. All Simply Enak prices include dietary accommodation by default, no hidden costs.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {signatureTours.map((tour: any) => (
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 flex flex-col">
            <h3 class="font-bold font-heading text-lg mb-1">{tour.name}</h3>
            <div class="flex items-baseline gap-2 mb-3">
              <span class="text-2xl font-bold text-accent">{tour.price}</span>
              <span class="text-xs text-muted">/ person</span>
            </div>
            <ul class="space-y-2 mb-4 text-sm text-muted">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> {tour.duration}</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> {tour.tastings || '8-10 tastings'}</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> {tour.groupSize || '2\u20139 people'}</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> {tour.cancellation}</li>
            </ul>
            <div class="mt-auto pt-4 border-t border-gray-100">
              <p class="text-xs text-muted mb-3">
                <span class="font-semibold text-green-600">Competitors:
                {tour.slug === 'flavours-of-malaysia' ? ' SFT: USD 49.99 (~RM 220) for 12 pax, 3hrs, no market. FTM: USD 62 (~RM 275) for vehicle-based tour.' : 
                 tour.slug === 'eat-drink-george-town' ? ' FTM Penang: USD 67 (~RM 297) for brunch/dinner, no cocktails, no speakeasies.' : 
                 tour.slug === 'kuala-lumpur-street-food' ? ' SFT: USD 49.99 (~RM 220), same area, double the group size. FTM: USD 62 (~RM 275) evening vehicle tour.' :
                 tour.slug === 'penang-street-food' ? ' FTM Penang Walk: USD 62 (~RM 275), max 8 pax. FTM Eat Like A Local: USD 67 (~RM 297).' :
                 ' FTM: USD 62-67 (~RM 275-297). SFT: USD 49.99 (~RM 220).'
                }
                </span>
              </p>
              <a href={`/tours/${tour.slug}`} class="inline-block bg-primary text-white font-semibold text-sm px-5 py-2.5 rounded hover:bg-primary/90 transition-colors w-full text-center">
                View Tour Details
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who Should Choose What -->
  <section class="py-12 bg-muted/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">WHICH TOUR OPERATOR IS RIGHT FOR YOU</p>
        <h2 class="text-2xl md:text-3xl font-bold font-heading">Who Should Choose What</h2>
        <p class="text-muted max-w-xl mx-auto mt-3 text-sm">Honest recommendations based on what you're actually looking for.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <div class="text-2xl mb-3">🍜</div>
          <h3 class="font-bold font-heading text-lg mb-2">Real Food Seekers</h3>
          <p class="text-sm text-muted mb-3">You want wet markets, family-run stalls, a guide who knows every vendor by name and has been bringing guests there for years. The real thing.</p>
          <span class="inline-block bg-accent text-black text-xs font-bold px-3 py-1 rounded-full">Choose Simply Enak</span>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <div class="text-2xl mb-3">💰</div>
          <h3 class="font-bold font-heading text-lg mb-2">Budget-Conscious Travellers</h3>
          <p class="text-sm text-muted mb-3">You want a quick, affordable food tour to tick the box. Secret Food Tours at $49.99 is the cheapest option. You will get a solid 3-hour overview of Chinatown and Little India.</p>
          <span class="inline-block bg-muted/50 text-muted text-xs font-bold px-3 py-1 rounded-full">Choose Secret Food Tours</span>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <div class="text-2xl mb-3">🚐</div>
          <h3 class="font-bold font-heading text-lg mb-2">Vehicle Preferrers</h3>
          <p class="text-sm text-muted mb-3">You dislike walking or have mobility concerns. Food Tour Malaysia uses private vehicles to drive between food stops. Less walking, but also less time in the actual neighbourhood.</p>
          <span class="inline-block bg-muted/50 text-muted text-xs font-bold px-3 py-1 rounded-full">Choose Food Tour Malaysia</span>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <div class="text-2xl mb-3">🌙</div>
          <h3 class="font-bold font-heading text-lg mb-2">Nightlife and Cocktail Fans</h3>
          <p class="text-sm text-muted mb-3">You want an evening out with speakeasy bars, craft cocktails, and secret society tales. Simply Enak's Eat Drink George Town is the only tour combining street food with hidden bars.</p>
          <span class="inline-block bg-accent text-black text-xs font-bold px-3 py-1 rounded-full">Choose Simply Enak</span>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <div class="text-2xl mb-3">🥬</div>
          <h3 class="font-bold font-heading text-lg mb-2">Dietary-Restricted Eaters</h3>
          <p class="text-sm text-muted mb-3">You are vegetarian, vegan, halal, or gluten-free. Simply Enak covers all diets by default at no extra charge. FTM puts the responsibility on you and disclaims liability. SFT requires advance notice.</p>
          <span class="inline-block bg-accent text-black text-xs font-bold px-3 py-1 rounded-full">Choose Simply Enak</span>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <div class="text-2xl mb-3">👥</div>
          <h3 class="font-bold font-heading text-lg mb-2">Group Bookings and Private Tours</h3>
          <p class="text-sm text-muted mb-3">You have a group of 10+ and need a private tour. Simply Enak offers tailored private tours with flexible routes and multi-city itineraries.</p>
          <span class="inline-block bg-accent text-black text-xs font-bold px-3 py-1 rounded-full">Choose Simply Enak</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Verdict Summary -->
  <section class="py-12 bg-page">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">VERDICT</p>
        <h2 class="text-2xl md:text-3xl font-bold font-heading">Category Winners at a Glance</h2>
        <p class="text-muted max-w-xl mx-auto mt-3 text-sm">Simply Enak wins across the dimensions that matter most for a real food tour. The exceptions tell you when a competitor makes sense.</p>
      </div>
      <div class="overflow-x-auto rounded-xl shadow-sm border border-gray-100">
        <table class="w-full text-sm bg-white">
          <thead>
            <tr class="bg-[#1a1a1a] text-white">
              <th class="text-left px-5 py-4 font-bold">Category</th>
              <th class="text-left px-5 py-4 font-bold text-accent">Winner</th>
              <th class="text-left px-5 py-4 font-bold text-muted">Why</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white"><td class="px-5 py-3 font-semibold">Group Size</td><td class="px-5 py-3 text-primary font-bold">Simply Enak</td><td class="px-5 py-3 text-muted">Max 9 vs 10-12. Smaller means a better pace.</td></tr>
            <tr class="bg-gray-50/50"><td class="px-5 py-3 font-semibold">Market Walk</td><td class="px-5 py-3 text-primary font-bold">Simply Enak</td><td class="px-5 py-3 text-muted">Only operator visiting a real working wet market.</td></tr>
            <tr class="bg-white"><td class="px-5 py-3 font-semibold">Guide Relationships</td><td class="px-5 py-3 text-primary font-bold">Simply Enak</td><td class="px-5 py-3 text-muted">10+ year vendor ties vs rotating freelancers.</td></tr>
