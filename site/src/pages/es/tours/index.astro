---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/i18n/utils';
import { getAllTours, getSpecialtyList, getTravelTypeList } from '~/lib/content';
import { dietarySegments, locationSegments, specialtySegments, travelTypeSegments } from '~/data/segments';

const lang = 'es';
const t = useTranslations(lang);

const tours = await getAllTours(lang);
const specialties = await getSpecialtyList(lang);
const travelTypeList = await getTravelTypeList(lang);

const metadata = {
  title: 'Pusingan Makanan di Malaysia',
  description: 'Terokai pelbagai pusingan makanan dan budaya Malaysia yang autentik di Kuala Lumpur, Pulau Pinang, Melaka, Ipoh dan seterusnya.',
};
export const prerender = true;

// All 5 signature tours
const signatureTours = tours.slice(0, 5);

// Experience types - map specialty slugs to hero images and landing page slugs
const experienceImages: Record<string, string> = {
  'street-food': 'https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg',
  'market-tour': 'https://se-website-images.s3.nl-ams.scw.cloud/Flavours_of_Malaysia001_41094a74f7.jpg',
  'heritage': 'https://se-website-images.s3.nl-ams.scw.cloud/Eat_Drink_Georgetown1_72aaaf12b6.jpg',
  'night-tour': 'https://se-website-images.s3.nl-ams.scw.cloud/secrets_of_KL_Nightlife_Tour002_294155fa7e.jpg',
};
const experienceSlugMap: Record<string, string> = {
  'street-food': 'street-food-tours-kuala-lumpur',
  'market-tour': 'market-tours-kuala-lumpur',
  'heritage': 'heritage-food-tours-kuala-lumpur',
  'night-tour': 'night-food-tours-kuala-lumpur',
};
const experienceTypes = specialties
  .filter((s: any) => experienceImages[s.slug] && experienceSlugMap[s.slug])
  .map((s: any) => ({ name: s.name, slug: experienceSlugMap[s.slug], image: experienceImages[s.slug] }));

// Travel types with hero images and correct segment slugs
const travelImages: Record<string, { image: string; icon: string }> = {
  'family': { image: 'https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg', icon: '\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}' },
  'couples': { image: 'https://se-website-images.s3.nl-ams.scw.cloud/Eat_Drink_George_Town_Bart_1527cf1f89.jpeg', icon: '\u{1F491}' },
  'foodie': { image: 'https://se-website-images.s3.nl-ams.scw.cloud/Flavours_of_Malaysia001_41094a74f7.jpg', icon: '\u{1F37D}\u{FE0F}' },
};
const travelSlugMap: Record<string, string> = {
  'family': 'food-tours-for-families-kuala-lumpur',
  'couples': 'food-tours-for-couples-kuala-lumpur',
  'foodie': 'food-tours-for-foodies-kuala-lumpur',
};
const travelWith = travelTypeList
  .filter((t: any) => travelImages[t.slug] && travelSlugMap[t.slug])
  .map((t: any) => ({ name: t.name, slug: travelSlugMap[t.slug], image: travelImages[t.slug].image, icon: travelImages[t.slug].icon }));
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg" alt="" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a1a]/70 via-[#1a1a1a]/85 to-[#1a1a1a]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-6 leading-tight">
        Pusingan Makanan, Budaya & Warisan<br />di <span class="text-accent">KL, Ipoh & Pulau Pinang</span>
      </h1>
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <a href="#tours" class="bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors">
          LIHAT SEMUA PUSINGAN
        </a>
        <a href="/es/tours/private-tours" class="border border-white/30 text-white font-semibold px-6 py-3 rounded hover:bg-white/10 transition-colors">
          RANCANG PUSINGAN PERSENDIRIAN
        </a>
      </div>
    </div>
  </section>

  <!-- Sticky Navigation -->
  <nav class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm" aria-label="Bahagian halaman pusingan">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-2 py-3 overflow-x-auto">
        <a href="#tours" class="text-sm font-semibold px-4 py-1.5 rounded-full bg-primary text-white whitespace-nowrap">Semua Pusingan</a>
        <a href="#private" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Persendirian</a>
        <a href="#city" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Mengikut Bandar</a>
        <a href="#dietary" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Diet</a>
        <a href="#experiences" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Pengalaman</a>
        <a href="#who" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Bersama Siapa</a>
        <a href="#groups" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Kumpulan</a>
      </div>
    </div>
  </nav>

  <!-- Breadcrumb -->
  <div class="bg-page py-4 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="flex items-center text-sm text-muted">
        <a href="/es/" class="hover:text-primary transition-colors">{t('nav.home')}</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-primary font-medium">{t('nav.tours')}</span>
      </nav>
    </div>
  </div>

  <!-- Three Ways to Experience -->
  <section class="py-16 bg-page" id="private">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">PILIHAN ANDA</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Tiga Cara untuk Mengalami Malaysia</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Pusingan persendirian, laluan tersuai, atau kumpulan kecil. Pilih yang sesuai untuk anda.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Private Tour -->
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <h3 class="text-xl font-bold font-heading mb-3">Pusingan Persendirian</h3>
          <p class="text-sm text-muted mb-4">Mana-mana pusingan signature kami, dijalankan secara persendirian untuk kumpulan anda. Termasuk pengambilan hotel dan keperluan diet diuruskan lebih awal.</p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Kumpulan anda sahaja</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Pengambilan hotel termasuk</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Masa mula yang fleksibel</li>
          </ul>
          <a href="/es/tours/private-tours" class="inline-block bg-primary text-white font-semibold px-5 py-2.5 rounded hover:bg-primary/90 transition-colors text-sm">Tempah Pusingan Persendirian</a>
        </div>

        <!-- Tailored Experience -->
        <div class="bg-white rounded-xl border-2 border-accent shadow-md p-6 relative">
          <span class="absolute -top-3 left-4 bg-accent text-black text-xs font-bold px-3 py-1 rounded-full">POPULAR</span>
          <h3 class="text-xl font-bold font-heading mb-3">Pengalaman Tersuai</h3>
          <p class="text-sm text-muted mb-4">Laluan tersuai direka berdasarkan minat anda. Perancangan pra-pusingan melalui WhatsApp dengan pemandu anda.</p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Laluan tersuai sepenuhnya</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Sebarang tempoh masa</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Fokus diet khas</li>
          </ul>
          <a href="/es/contact" class="inline-block bg-accent text-black font-semibold px-5 py-2.5 rounded hover:bg-accent/90 transition-colors text-sm">Beritahu Kami Apa Yang Anda Mahu</a>
        </div>

        <!-- Join a Small Group -->
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
          <h3 class="text-xl font-bold font-heading mb-3">Sertai Kumpulan Kecil</h3>
          <p class="text-sm text-muted mb-4">Tempah tempat pada salah satu pusingan berjadual kami bersama rakan pengembara lain. Maksimum 9 tetamu.</p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Dari RM 285/orang</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Maksimum 9 tetamu</li>
            <li class="flex items-center gap-2 text-sm"><svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Jadual tetap</li>
          </ul>
          <a href="#tours" class="inline-block bg-primary text-white font-semibold px-5 py-2.5 rounded hover:bg-primary/90 transition-colors text-sm">Lihat Semua Pusingan</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Signature Food Tours -->
  <section class="py-16" id="tours">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">YANG ASLI</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Pusingan Makanan Signature Kami</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">5 pusingan yang memulakan semuanya. Setiap satu dibina di sekitar peniaga yang telah kami kenali selama lebih sedekad.</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {signatureTours.map((tour: any) => (
          <a href={`/es/tours/${tour.slug}`} class="group block bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={tour.image} alt={tour.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute bottom-2 left-2 flex gap-2">
                <span class="bg-primary text-white text-xs font-bold px-2 py-1 rounded">{tour.duration}</span>
                <span class="bg-accent text-black text-xs font-bold px-2 py-1 rounded">{tour.tastings || '8-10 hidangan'}</span>
              </div>
            </div>
            <div class="p-4">
              <h3 class="font-bold font-heading text-lg group-hover:text-primary">{tour.name}</h3>
              <p class="text-xs text-muted mt-1">{tour.tagline}</p>
              <p class="text-xs text-accent font-semibold mt-1">PUSINGAN MAKANAN</p>
              <div class="mt-3 flex items-center justify-between">
                <div>
                  <span class="text-xs text-muted">{t('common.from')}</span>
                  <span class="font-bold text-primary ml-1">{tour.price}</span>
                </div>
                <span class="text-sm text-accent font-semibold group-hover:underline">Lihat Butiran &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tours by City -->
  <section class="py-16 bg-muted/30" id="city">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">MENGIKUT DESTINASI</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Pusingan Mengikut Bandar</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Setiap bandar di Malaysia menceritakan kisah makanan yang berbeza. Pilih bab anda.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Kuala Lumpur -->
        <a href="/es/tours/locations/food-tours-kuala-lumpur" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/kuala_lumpur_street_food_cd4fad4122.jpg" alt="Kuala Lumpur" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">KUALA LUMPUR</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Kuala Lumpur</h3>
            <p class="text-sm text-white/80 mt-2">Dari penjaja Chinatown ke rumah kari India. Adegan makanan pelbagai budaya KL.</p>
            <span class="text-accent font-semibold text-sm mt-3">3 pusingan &rarr;</span>
          </div>
        </a>

        <!-- Penang -->
        <a href="/es/tours/locations/food-tours-penang" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/Eat_Drink_Georgetown1_72aaaf12b6.jpg" alt="Pulau Pinang" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">PULAU PINANG</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Pulau Pinang</h3>
            <p class="text-sm text-white/80 mt-2">Ibu kota makanan Asia. Warisan Peranakan, budaya penjaja, dan pesona pulau.</p>
            <span class="text-accent font-semibold text-sm mt-3">2 pusingan &rarr;</span>
          </div>
        </a>

        <!-- Melaka -->
        <a href="/es/tours/locations/food-tours-melaka" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/melaka-cultural-tour.jpg" alt="Melaka" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">MELAKA</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Melaka</h3>
            <p class="text-sm text-white/80 mt-2">600 tahun warisan Peranakan. Masakan Nyonya dan rasa Portugis-Eurasia.</p>
            <span class="text-accent font-semibold text-sm mt-3">Akan datang &rarr;</span>
          </div>
        </a>

        <!-- Ipoh -->
        <a href="/es/tours/locations/food-tours-ipoh" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/ipoh-old-town.jpg" alt="Ipoh" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">IPOH</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Ipoh</h3>
            <p class="text-sm text-white/80 mt-2">Pesona bandar lama, warisan kopi putih, dan keenakan ayam tauge.</p>
            <span class="text-accent font-semibold text-sm mt-3">Akan datang &rarr;</span>
          </div>
        </a>

        <!-- Klang -->
        <a href="/es/tours/locations/food-tours-klang" class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
          <div class="absolute inset-0">
            <img src="https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg" alt="Klang" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          </div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-wider text-accent font-bold">KLANG</span>
            <h3 class="text-2xl font-bold font-heading mt-1">Klang</h3>
            <p class="text-sm text-white/80 mt-2">Tempat kelahiran bak kut teh. Warisan Melayu diraja dan tradisi bandar pelabuhan.</p>
            <span class="text-accent font-semibold text-sm mt-3">Akan datang &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- By Dietary -->
  <section class="py-16" id="dietary">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">KEPERLUAN DIET</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Pusingan Mengikut Keperluan Diet</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Setiap pusingan boleh diubah suai. Ini adalah pengalaman diet khusus kami.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {dietarySegments.filter((s: any, i: number, arr: any[]) => 
          i === arr.findIndex((a: any) => a.name === s.name)
        ).map((s: any) => (
          <a href={`/es/tours/dietary/${s.slug}`} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src="https://se-website-images.s3.nl-ams.scw.cloud/vegetarian-heritage.jpg" alt={s.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <h3 class="text-xl font-bold font-heading">{s.name}</h3>
              <span class="text-sm text-white/80 group-hover:underline mt-1">Pusingan &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- By Experience -->
  <section class="py-16 bg-muted/30" id="experiences">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">JENIS PENGALAMAN</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Pusingan Mengikut Pengalaman</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">Dari pasar pagi ke pengembaraan makanan malam.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {experienceTypes.map((s: any) => (
          <a href={`/es/tours/specialty/${s.slug}`} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src={s.image} alt={s.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <h3 class="text-xl font-bold font-heading">{s.name}</h3>
