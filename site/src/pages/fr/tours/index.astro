---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/i18n/utils';
import { getAllTours, getToursPage, getImageUrl } from '~/lib/content';
import { dietarySegments, locationSegments, specialtySegments, travelTypeSegments } from '~/data/segments';
import { getDietaryOptionList, getLocationList, getSpecialtyList, getTravelTypeList } from '~/lib/content';

const lang = 'fr';
const t = useTranslations(lang);

const tp = await getToursPage('fr');
const tours = await getAllTours('fr');

// Payload reference data for segment images (user uploads in admin)
const dietaryRefs = await getDietaryOptionList();
const locationRefs = await getLocationList();
const specialtyRefs = await getSpecialtyList();
const travelTypeRefs = await getTravelTypeList();

const metadata = {
  title: tp.seo_title || 'Food Tours in Malaysia',
  description: tp.seo_description || 'Explore our range of authentic Malaysian food and culture tours in Kuala Lumpur, Penang, Melaka, Ipoh and beyond.',
  canonical: 'https://simplyenak.com/tours',
};

// All 5 signature tours
const signatureTours = tours.slice(0, 5);

// Build image lookups from Payload reference data — managed in Payload admin, not code
const locationImageMap: Record<string, string> = {};
locationRefs.forEach((s: any) => { const url = getImageUrl(s.image); if (url) locationImageMap[s.slug] = url; });
const dietaryImageMap: Record<string, string> = {};
dietaryRefs.forEach((s: any) => { const url = getImageUrl(s.image); if (url) dietaryImageMap[s.slug] = url; });
const specialtyImageMap: Record<string, string> = {};
specialtyRefs.forEach((s: any) => { const url = getImageUrl(s.image); if (url) specialtyImageMap[s.slug] = url; });
const travelTypeImageMap: Record<string, string> = {};
travelTypeRefs.forEach((s: any) => { const url = getImageUrl(s.image); if (url) travelTypeImageMap[s.slug] = url; });
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src={getImageUrl(tp.hero_image) || ''} alt="" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a1a]/70 via-[#1a1a1a]/85 to-[#1a1a1a]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-6 leading-tight" set:html={tp.hero_title?.replace(/\{highlight\}/g, `<span class="text-accent">`).replace(/\{\/highlight\}/g, `</span>`) || 'Food, Culture & Heritage Tours<br />in <span class="text-accent">KL, Ipoh & Penang</span>'} />
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        {tp.hero_cta_primary_text && (
          <a href={tp.hero_cta_primary_href || '#tours'} class="bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors">
            {tp.hero_cta_primary_text}
          </a>
        )}
        {tp.hero_cta_secondary_text && (
          <a href={tp.hero_cta_secondary_href || '/tours'} class="border border-white/30 text-white font-semibold px-6 py-3 rounded hover:bg-white/10 transition-colors">
            {tp.hero_cta_secondary_text}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Sticky Navigation -->
  <nav class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm" aria-label="Tours page sections">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-2 py-3 overflow-x-auto">
        <a href="#tours" class="text-sm font-semibold px-4 py-1.5 rounded-full bg-primary text-white whitespace-nowrap">All Tours</a>
        <a href="#private" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Private</a>
        <a href="#city" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">By City</a>
        <a href="#dietary" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Dietary</a>
        <a href="#experiences" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Experiences</a>
        <a href="#who" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Who With</a>
        <a href="#groups" class="text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-default hover:border-primary hover:text-primary transition-colors whitespace-nowrap">Groups</a>
      </div>
    </div>
  </nav>

  <!-- Breadcrumb -->
  <div class="bg-page py-4 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="flex items-center text-sm text-muted">
        <a href="/fr/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-primary font-medium">Tours</span>
      </nav>
    </div>
  </div>

  <!-- Three Ways to Experience -->
  <section class="py-16 bg-page" id="private">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.three_ways_eyebrow || 'YOUR CHOICE'}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{tp.three_ways_heading || 'Three Ways to Experience Malaysia'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">{tp.three_ways_description || 'Private tour, tailored route, or small group. Pick what fits you.'}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {(tp.three_ways || [
          { title: 'Private Tour', description: 'Any of our signature tours, run privately for your group. Includes hotel pickup and dietary needs accommodated in advance.', features: [{ feature: 'Your group only' }, { feature: 'Hotel pickup included' }, { feature: 'Flexible start time' }], cta_text: 'Book a Private Tour', cta_href: '/tours/private-tours' },
          { title: 'Tailored Experience', description: 'Custom route designed around your interests. Pre-tour WhatsApp planning with your guide.', features: [{ feature: 'Fully customized route' }, { feature: 'Any duration' }, { feature: 'Special dietary focus' }], cta_text: 'Tell Us What You Want', cta_href: '/contact', is_popular: true },
          { title: 'Join a Small Group', description: 'Book a spot on one of our scheduled tours alongside fellow travellers. Max 9 guests.', features: [{ feature: 'From RM 285/person' }, { feature: 'Max 9 guests' }, { feature: 'Fixed schedule' }], cta_text: 'Browse All Tours', cta_href: '#tours' },
        ]).map((card: any) => (
          <div class={`bg-white rounded-xl ${card.is_popular ? 'border-2 border-accent shadow-md relative' : 'border border-gray-100 shadow-sm'} p-6`}>
            {card.is_popular && <span class="absolute -top-3 left-4 bg-accent text-black text-xs font-bold px-3 py-1 rounded-full">POPULAR</span>}
            <h3 class="text-xl font-bold font-heading mb-3">{card.title}</h3>
            <p class="text-sm text-muted mb-4">{card.description}</p>
            {(card.features && card.features.length > 0) && (
              <ul class="space-y-2 mb-6">
                {card.features.map((f: any) => (
                  <li class="flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {f.feature || f}
                  </li>
                ))}
              </ul>
            )}
            {card.cta_text && (
              <a href={card.cta_href || '#'} class={`inline-block ${card.is_popular ? 'bg-accent text-black' : 'bg-primary text-white'} font-semibold px-5 py-2.5 rounded hover:bg-opacity-90 transition-colors text-sm`}>
                {card.cta_text}
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Signature Food Tours -->
  <section class="py-16" id="tours">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.signature_eyebrow || 'THE ORIGINALS'}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{tp.signature_heading || 'Our Signature Food Tours'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">{tp.signature_description || 'The 5 tours that started it all. Each one built around vendors we\'ve known for over a decade.'}</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {signatureTours.map((tour: any) => (
          <a href={`/tours/${tour.slug}`} class="group block bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={tour.image} alt={tour.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute bottom-2 left-2 flex gap-2">
                <span class="bg-primary text-white text-xs font-bold px-2 py-1 rounded">{tour.duration}</span>
                <span class="bg-accent text-black text-xs font-bold px-2 py-1 rounded">{tour.tastings || '8-10 tastings'}</span>
              </div>
              {tour.tourType === 'private' && (
                <div class="absolute top-2 left-2">
                  <span class="bg-purple-600 text-white text-xs font-bold px-2 py-1 rounded shadow-sm">Private Tour</span>
                </div>
              )}
            </div>
            <div class="p-4">
              <h3 class="font-bold font-heading text-lg group-hover:text-primary">{tour.name}</h3>
              <p class="text-xs text-muted mt-1">{tour.tagline}</p>
              <p class="text-xs text-accent font-semibold mt-1">FOOD TOUR</p>
              <div class="mt-3 flex items-center justify-between">
                <div>
                  <span class="text-xs text-muted">from</span>
                  <span class="font-bold text-primary ml-1">{tour.price}</span>
                </div>
                <span class="text-sm text-accent font-semibold group-hover:underline">View Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tours by City -->
  <section class="py-16 bg-muted/30" id="city">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.city_eyebrow || 'BY DESTINATION'}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{tp.city_heading || 'Tours by City'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">{tp.city_description || 'Every Malaysian city tells a different food story. Choose your chapter.'}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {(tp.cities || []).map((city: any) => (
          <a href={city.href || '/tours'} class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[16/9]">
            <div class="absolute inset-0">
              <img src={locationImageMap[city.slug] || getImageUrl(city.image) || ''} alt={city.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            </div>
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <span class="text-xs uppercase tracking-wider text-accent font-bold">{city.name}</span>
              <h3 class="text-2xl font-bold font-heading mt-1">{city.name}</h3>
              {city.description && <p class="text-sm text-white/80 mt-2">{city.description}</p>}
              {city.tour_count_label && <span class="text-accent font-semibold text-sm mt-3">{city.tour_count_label}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- By Dietary -->
  <section class="py-16" id="dietary">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.dietary_eyebrow || 'DIETARY PREFERENCES'}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{tp.dietary_heading || 'Tours by Dietary Need'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">{tp.dietary_description || 'Every tour can be adapted. These are our dedicated dietary experiences.'}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {dietarySegments.filter((s: any, i: number, arr: any[]) =>
          i === arr.findIndex((a: any) => a.name === s.name)
        ).map((s: any) => (
          <a href={`/tours/dietary/${s.slug}`} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src={dietaryImageMap[s.slug] || getImageUrl(tp.dietary_image) || ''} alt={s.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <h3 class="text-xl font-bold font-heading">{s.name}</h3>
              <span class="text-sm text-white/80 group-hover:underline mt-1">Tours →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- By Experience -->
  <section class="py-16 bg-muted/30" id="experiences">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.experience_eyebrow || 'EXPERIENCE TYPE'}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{tp.experience_heading || 'Tours by Experience'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">{tp.experience_description || 'From morning markets to night food adventures.'}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {(tp.experiences || []).map((exp: any) => (
          <a href={exp.href || '/tours'} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src={specialtyImageMap[exp.specialty_slug] || getImageUrl(exp.image) || ''} alt={exp.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <h3 class="text-xl font-bold font-heading">{exp.name}</h3>
              <span class="text-sm text-white/80 group-hover:underline mt-1">View →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Who You're Traveling With -->
  <section class="py-16" id="who">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.travel_with_eyebrow || 'TRAVEL STYLE'}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{tp.travel_with_heading || 'Who You\'re Traveling With'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">{tp.travel_with_description || 'Tours designed for your specific travel group.'}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {(tp.travel_with_options || []).map((opt: any) => (
          <a href={opt.href || '/tours'} class="group relative overflow-hidden rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src={travelTypeImageMap[opt.name] || getImageUrl(opt.image) || ''} alt={opt.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-end text-white">
              <h3 class="text-xl font-bold font-heading">{opt.icon ? `${opt.icon} ${opt.name}` : opt.name}</h3>
              <span class="text-sm text-white/80 group-hover:underline mt-1">View →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Groups & Events -->
  <section class="py-16 bg-muted/30" id="groups">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.groups_eyebrow || 'FOR GROUPS'}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">{tp.groups_heading || 'Groups & Events'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-4 text-sm">{tp.groups_description || 'Private tours, corporate outings, and custom experiences.'}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {(tp.groups || []).map((group: any) => (
          <a href={group.href || '/tours'} class="group relative overflow-hidden rounded-2xl shadow-lg transition-all hover:shadow-xl hover:-translate-y-1 aspect-[4/3]">
            <div class="absolute inset-0">
              <img src={getImageUrl(group.image) || ''} alt={group.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            </div>
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <h3 class="text-2xl font-bold font-heading">{group.title}</h3>
              {group.description && <p class="text-sm text-white/80 mt-2">{group.description}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tailor Make Your Own Tour -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-xl">
        <div class="grid md:grid-cols-2">
          <div class="relative aspect-[16/9] md:aspect-auto">
            <img src={getImageUrl(tp.tailor_image) || ''} alt="Tailor Make Your Own Tour" loading="lazy" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-r from-[#1a1a1a] via-transparent to-transparent md:block hidden"></div>
          </div>
          <div class="p-8 md:p-12 text-white flex flex-col justify-center">
            <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{tp.tailor_eyebrow || 'FULLY CUSTOM'}</p>
            <h2 class="text-3xl md:text-4xl font-bold font-heading mb-4">{tp.tailor_heading || 'Tailor Make Your Own Tour'}</h2>
            <p class="text-white/70 text-sm mb-6">{tp.tailor_description || 'Have something specific in mind? We\'ll design a tour around your interests, dietary needs, and schedule. Multi-city itineraries, special dietary focuses, or themed experiences — if you can imagine it, we can create it.'}</p>
            {(tp.tailor_features && tp.tailor_features.length > 0) && (
              <ul class="space-y-2 mb-8">
                {tp.tailor_features.map((f: any) => (
                  <li class="flex items-center gap-2 text-sm text-white/80">
                    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {f.feature || f}
                  </li>
                ))}
              </ul>
            )}
            {tp.tailor_cta_text && (
              <a href={tp.tailor_cta_href || '/contact'} class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors w-fit">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                {tp.tailor_cta_text}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Find Your Perfect Tour - Pills -->
  <section class="py-16 bg-muted/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold font-heading">{tp.find_tour_heading || 'Find Your Perfect Tour'}</h2>
        <p class="text-muted max-w-xl mx-auto mt-3 text-sm">{tp.find_tour_description || 'Browse all our tour categories'}</p>
      </div>

      <!-- By Location -->
      <div class="mb-8">
        <h3 class="text-sm font-bold text-muted uppercase tracking-wider mb-4">By Location</h3>
        <div class="flex flex-wrap gap-2">
          {locationSegments.map((s: any) => (
            <a href={`/tours/locations/${s.slug}`} class="text-sm px-4 py-2 rounded-full border border-gray-200 bg-white text-default hover:text-white hover:bg-primary hover:border-primary transition-colors shadow-sm">
              {s.name}
            </a>
          ))}
        </div>
      </div>

      <!-- By Dietary -->
      <div class="mb-8">
        <h3 class="text-sm font-bold text-muted uppercase tracking-wider mb-4">By Dietary</h3>
        <div class="flex flex-wrap gap-2">
          {dietarySegments.map((s: any) => (
            <a href={`/tours/dietary/${s.slug}`} class="text-sm px-4 py-2 rounded-full border border-gray-200 bg-white text-default hover:text-white hover:bg-primary hover:border-primary transition-colors shadow-sm">
              {s.nameFull || s.name}
            </a>
          ))}
        </div>
      </div>

      <!-- By Experience -->
      <div class="mb-8">
        <h3 class="text-sm font-bold text-muted uppercase tracking-wider mb-4">By Experience</h3>
        <div class="flex flex-wrap gap-2">
          {specialtySegments.map((s: any) => (
            <a href={`/tours/specialty/${s.slug}`} class="text-sm px-4 py-2 rounded-full border border-gray-200 bg-white text-default hover:text-white hover:bg-primary hover:border-primary transition-colors shadow-sm">
              {s.nameFull || s.name}
            </a>
          ))}
        </div>
      </div>

      <!-- By Travel Style -->
      <div>
        <h3 class="text-sm font-bold text-muted uppercase tracking-wider mb-4">By Travel Style</h3>
        <div class="flex flex-wrap gap-2">
          {travelTypeSegments.map((s: any) => (
            <a href={`/tours/segments/${s.slug}`} class="text-sm px-4 py-2 rounded-full border border-gray-200 bg-white text-default hover:text-white hover:bg-primary hover:border-primary transition-colors shadow-sm">
              {s.nameFull || s.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Not Sure CTA -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold font-heading mb-6">{tp.not_sure_heading || 'Not Sure Which Tour to Pick?'}</h2>
      <p class="text-muted mb-8">{tp.not_sure_description || 'Chat with us and we\'ll help you find the perfect food experience.'}</p>
