---
import Layout from '~/layouts/PageLayout.astro';
import { getPageBySlug } from '~/lib/content';

const page = await getPageBySlug('terms');
const metadata = {
  title: page?.metaTitle || 'Terms & Conditions',
  description: page?.metaDescription || 'Terms and conditions for Simply Enak Food Experiences.',
};
const html = page?.content || '<p>Terms and conditions content goes here.</p>';
const title = page?.title || 'Terms & Conditions';
---

<Layout metadata={metadata}>
  <nav class="bg-page border-b border-gray-100 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">Terms & Conditions</span>
      </div>
    </div>
  </nav>

  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h1 class="text-4xl md:text-5xl font-bold font-heading text-default mb-8">{title}</h1>
      <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-heading" set:html={html}></div>
    </div>
  </section>
</Layout>
