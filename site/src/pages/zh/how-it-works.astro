---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

let pageData: any = {};
try {
  pageData = (await import('~/data/content/how-it-works-page.json')).default;
} catch {}

const steps = pageData.steps || [];
const inclusions = pageData.inclusions || [];
const formats = pageData.formats || [];

const heroTitle = pageData.hero_title || 'How Our Food Tours Work';
const heroSubtitle = pageData.hero_subtitle || 'From booking to eating — here\'s exactly what to expect.';
const stepsTitle = pageData.steps_title || 'How it Works';
const inclusionsTitle = pageData.inclusions_title || 'What\'s Included';
const formatsTitle = pageData.formats_title || 'Tour Formats';
const formatsSubtitle = pageData.formats_subtitle || 'Pick the format that suits you best.';

const meta = {
  title: pageData.seo_title || 'How It Works | Simply Enak',
  description: pageData.seo_description || 'Learn how Simply Enak food tours work in Malaysia.',
};
---
<Layout metadata={meta}>
  <!-- Breadcrumb -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-3 text-xs text-muted">
        <a href="/zh/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">How It Works</span>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <div class="w-full h-full bg-gradient-to-br from-[#2a1a1a] to-[#1a1a1a]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black/80"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <p class="text-accent/90 text-xs uppercase tracking-[0.2em] font-bold mb-3">How It Works</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4">
        <span class="inline-block bg-accent text-black px-4 py-1 rounded-sm" style="transform:rotate(-0.7deg)">
          {heroTitle}
        </span>
        <span class="block text-white/90 text-xl md:text-2xl mt-3 font-normal font-sans">
          {heroSubtitle}
        </span>
      </h1>
    </div>
  </section>

  <!-- Steps -->
  {steps.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Process</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">{stepsTitle}</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {steps.map((step: any) => (
            <div class="relative p-6 md:p-8 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm">
              <span class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-accent text-black font-bold flex items-center justify-center text-lg shadow-md">
                {step.number}
              </span>
              <h3 class="text-lg font-bold font-heading mb-2 mt-2">{step.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{step.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Inclusions -->
  {inclusions.length > 0 && (
    <section class="py-16 md:py-20 bg-muted/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Included</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">{inclusionsTitle}</h2>
        </div>
        <div class="p-8 rounded-xl border border-gray-100 dark:border-white/10 bg-card max-w-2xl mx-auto">
          <ul class="space-y-3">
            {inclusions.map((item: any) => (
              <li class="flex items-start gap-3 text-sm text-muted">
                <Icon name="tabler:check" class="w-4 h-4 text-green-500 shrink-0 mt-0.5" />
                <span>{item.item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- Formats -->
  {formats.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Formats</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">{formatsTitle}</h2>
          <p class="text-muted max-w-2xl mx-auto mt-3 text-sm">{formatsSubtitle}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {formats.map((format: any) => (
            <div class="p-6 md:p-8 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm">
              <h3 class="text-lg font-bold font-heading mb-2">{format.name}</h3>
              <p class="text-sm text-muted leading-relaxed">{format.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-muted/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold font-heading mb-4">Ready to explore Malaysia?</h2>
      <p class="text-muted text-sm mb-6">Browse our tours and pick your next food adventure.</p>
      <a href="/zh/tours"
         class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors text-sm">
        <Icon name="tabler:compass" class="w-4 h-4" />
        View All Tours
      </a>
    </div>
  </section>
</Layout>
