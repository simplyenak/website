---
import Layout from '~/layouts/PageLayout.astro';
import { getAboutPage, getImageUrl } from '~/lib/content';

const ap = await getAboutPage();

const metadata = {
  title: 'About Simply Enak  -  Malaysian Food Tours Since 2011',
  description: "Since 2011, Simply Enak has been sharing Malaysia's food heritage through small-group walking tours in Kuala Lumpur and Penang. Meet the guides, meet the vendors, taste the real Malaysia.",
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden py-20 md:py-28">
    <div class="absolute inset-0">
      <img src={getImageUrl(ap.heroImage) || "https://se-website-images.s3.nl-ams.scw.cloud/payload-media/Food_Experience_optimized_adc493606c.jpg"} alt="" class="w-full h-full object-cover opacity-25" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a1a]/70 via-[#1a1a1a]/85 to-[#1a1a1a]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-accent text-xs md:text-sm uppercase tracking-[0.25em] font-bold mb-5">{ap.heroEyebrow ?? "Our Story"}</p>
      <h1 class="text-3xl md:text-5xl font-bold font-heading leading-tight mb-6" style="font-size: clamp(1.75rem, 6vw, 3.5rem);">
        {ap.heroHeading ?? "Born in Malaysia. Raised on "}<span class="inline-block bg-accent text-black px-4 py-1.5 rounded-sm shadow-xl font-black" style="transform: rotate(-0.5deg); font-size: clamp(1.3rem, 4.5vw, 3rem);">Street Food</span>
      </h1>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
        {ap.heroDescription ?? "What started as showing friends around Chow Kit market has become 14 years of sharing the real Malaysia, one meal at a time."}
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-page border-b border-gray-100 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">About</span>
      </div>
    </div>
  </nav>

  <!-- Founder Story -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">{ap.founderSection?.eyebrow ?? "Meet Pauline"}</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-6">
            {ap.founderSection?.heading ?? "She Started by Taking Friends to the Market"}
          </h2>
          <div class="space-y-4 text-default leading-relaxed">
            {(ap.founderSection?.paragraphs ?? [
              "Growing up in Malaysia, I spent my mornings walking through wet markets with my mom. While she haggled for the freshest fish, I watched the hawkers craft dishes that had been passed down for generations. The sizzle of char kway teow on a screaming hot wok. The aromatic clouds of curry. The careful art of folding roti canai. This was my Malaysia.",
              "When I started bringing friends from overseas around, I realised they were missing all of it. They'd eat at air-conditioned restaurants with picture menus, never knowing that two streets away, a grandmother was making laksa the same way her mother taught her 60 years ago.",
              "Simply Enak started in 2011 because I wanted to share what I grew up with. Not the Malaysia in guidebooks, the one I know. The night markets. The family recipes. The vendors who remember your face and your favourite dish. The real Malaysia that tourists walk past every day."
            ]).map((p: string) => (
              <p>{p}</p>
            ))}
          </div>
        </div>
        <div class="relative">
          <div class="rounded-xl overflow-hidden">
            <img
              src={ap.founderSection?.image || "https://se-website-images.s3.nl-ams.scw.cloud/payload-media/pauline-founder-portrait.jpg"}
              alt="Pauline  -  Founder & Lead Guide of Simply Enak"
              class="w-full h-full object-cover aspect-[4/3]"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="bg-primary/5 dark:bg-primary/10 py-12 border-y border-primary/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {(ap.stats ?? [
          { number: '5,000+', label: 'Happy Guests' },
          { number: '4.9/5', label: 'TripAdvisor Rating' },
          { number: '14 Years', label: 'Experience' },
          { number: 'Max 8', label: 'Group Size' },
        ]).map((stat: any) => (
          <div>
            <div class="text-3xl md:text-4xl font-bold font-heading text-primary">{stat.number}</div>
            <div class="text-sm text-muted mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="py-16 md:py-24 bg-white dark:bg-[#1e1c1c]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-14">
        <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">{ap.philosophySection?.eyebrow ?? "What Guides Us"}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-default">{ap.philosophySection?.heading ?? "Three Things We Won't Compromise On"}</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {(ap.philosophySection?.items ?? [
          { number: "01", title: "No Scripts", description: "Our guides are licensed professionals, but they talk to you like friends. Real stories, not rehearsed speeches. You'll get a different tour every time because you're different every time." },
          { number: "02", title: "Slow Down", description: "We walk. We pause. We take the time to notice things: the architecture, the smells, the sounds of the neighbourhood. A food tour shouldn't feel like a marathon." },
          { number: "03", title: "Support Local", description: "We focus on small, local vendors  -  many family-run for generations. Your tour fee goes to the heritage keepers of Malaysian food culture  -  the same people who've been feeding this neighbourhood for decades." },
        ]).map((item: any) => (
          <div class="text-center p-8 rounded-xl border border-gray-100 dark:border-white/10 hover:shadow-md transition-shadow">
            <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mx-auto mb-5">
              <span class="text-2xl font-bold text-accent">{item.number}</span>
            </div>
            <h3 class="text-xl font-bold font-heading text-default mb-3">{item.title}</h3>
            <p class="text-muted leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Media Coverage Timeline -->
  <section class="py-16 md:py-24 bg-gray-50 dark:bg-[#151313]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">{ap.timelineSection?.eyebrow ?? "2011  -  Present"}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-4">{ap.timelineSection?.heading ?? "14 Years of Simply Enak"}</h2>
        <p class="text-muted max-w-2xl mx-auto">{ap.timelineSection?.description ?? "From a first food walk through Chow Kit to features in National Geographic, BBC, and Lonely Planet. A few things happened along the way."}</p>
      </div>

      <!-- Timeline -->
      <div class="relative">
        <div class="absolute left-4 md:left-1/2 md:-translate-x-px top-0 bottom-0 w-0.5 bg-gradient-to-b from-accent via-primary to-primary/15"></div>

        <div class="space-y-8">
          {(ap.timelineSection?.milestones ?? [
            { year: 'Today', title: "5,000+ guests and still eating", description: "Every week, travellers from around the world join us at the same stalls we've eaten at for 14 years. The guides know the vendors by name. The vendors know us.", isToday: true },
            { year: '2024', title: 'BBC World Service', description: "Pauline joins the BBC World Service to share the story behind Simply Enak and what makes Malaysian food culture so unique on the world stage.", logo: '/images/press-logos/bbc.svg', url: 'https://www.bbc.co.uk/programmes/w3ct8sw1' },
            { year: '2011', title: 'Simply Enak Founded', description: "Pauline leads her first food walk through Chow Kit market with a small group of friends. Nobody calls it a tour yet  -  it's just lunch.", logo: '/images/press-logos/simplyenak.com.png' },
          ]).map((milestone: any, index: number) => {
            const isEven = index % 2 === 0;
            const isVideo = milestone.url?.includes('youtube.com') || milestone.url?.includes('9now.com.au');
            const isPodcast = milestone.title?.toLowerCase().includes('podcast') || milestone.title?.toLowerCase().includes('bbc world');
            const linkLabel = isVideo ? 'Watch' : isPodcast ? 'Listen' : 'Read';
            return (
              <div class="relative flex flex-col md:flex-row md:items-center">
                {/* Content card */}
                <div class:list={[
                  isEven ? 'md:w-1/2 md:text-right md:pr-12 pl-12 md:pl-0' : 'md:w-1/2 md:pl-12 pl-12 md:ml-[50%]',
                ]}>
                  <div class:list={[
                    milestone.isToday
                      ? 'bg-accent/5 dark:bg-accent/10 border border-accent/20 dark:border-accent/30'
                      : 'bg-white dark:bg-[#1e1c1c] border border-gray-100 dark:border-white/10',
                    'p-6 rounded-lg shadow-sm inline-block',
                  ]}>
                    {/* Year + Logo row */}
                    <div class:list={[
                      'flex items-center gap-2 mb-1',
                      isEven ? 'md:flex-row-reverse' : '',
                    ]}>
                      <p class="text-xs text-accent font-bold uppercase tracking-wider">{milestone.year === 'Today' ? 'Present Day' : milestone.year}</p>
                      {milestone.logo && (
                        <div class="w-10 h-10 rounded bg-gray-50 dark:bg-gray-700 border border-gray-100 dark:border-white/10 flex items-center justify-center overflow-hidden flex-shrink-0">
                          <img
                            src={milestone.logo}
                            alt={`${milestone.title} logo`}
                            width="40"
                            height="40"
                            class="w-8 h-8 object-scale-down"
                            loading="lazy"
                          />
                        </div>
                      )}
                    </div>

                    <h3 class:list={[
                      'text-lg font-bold font-heading mb-1',
                      milestone.isToday ? 'text-accent' : 'text-default',
                    ]}>
                      {milestone.title}
                    </h3>
                    <p class="text-sm text-muted mt-1">{milestone.description}</p>

                    {/* Link */}
                    {milestone.url && (
                      <a
                        href={milestone.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 mt-3 text-xs font-semibold text-primary hover:text-accent transition-colors duration-200"
                      >
                        {linkLabel}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="currentColor" class="w-3 h-3" aria-hidden="true">
                          <path d="M4.5 2.5a.5.5 0 0 0 0 1H7.793L2.146 9.146a.5.5 0 0 0 .708.708L9 3.707V7a.5.5 0 0 0 1 0V2.5H4.5Z"/>
                        </svg>
                      </a>
                    )}
                  </div>
                </div>

                {/* Dot */}
                <div
                  class:list={[
                    'absolute left-4 md:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full border-4 border-page shadow',
                    milestone.isToday ? 'bg-accent' : 'bg-primary',
                  ]}
                  style={milestone.isToday ? 'box-shadow: 0 0 0 4px rgba(255,163,51,0.2), 0 4px 12px rgba(181,45,56,0.25);' : ''}
                ></div>

                {/* Spacer for even items */}
                {isEven && <div class="hidden md:block md:w-1/2 md:pl-12"></div>}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the Team -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">{ap.teamSection?.eyebrow ?? "The Team"}</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-4">{ap.teamSection?.heading ?? "The People Behind the Flavours"}</h2>
        <p class="text-muted max-w-2xl mx-auto">{ap.teamSection?.description ?? "We're a small team, all licensed with Tourism Malaysia. More importantly, we grew up eating at these same stalls. We know the vendors by name, the neighbourhoods by heart, and the stories behind every dish."}</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {(ap.teamSection?.members ?? [
          { name: 'Pauline', role: 'Founder & Lead Guide', specialty: '15 Years Building Relationships', description: 'Started Simply Enak in 2011 after watching too many tourists miss the real Malaysia. Grew up walking wet markets with her mom.', image: 'https://se-website-images.s3.nl-ams.scw.cloud/payload-media/pauline-founder-portrait.jpg' },
          { name: 'Maarten', role: 'Partner', specialty: 'Operations & Growth', description: "Manages operations and business development, ensuring every aspect of Simply Enak stays true to the same standard: stalls we'd take our own families to." },
          { name: 'Trish', role: 'Licensed Guide', specialty: 'Tourism Malaysia Certified', description: 'Brings warmth and deep local knowledge to every tour. A natural storyteller who makes every guest feel like family.' },
        ]).map((member: any) => (
          <div class="group relative overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300 aspect-[3/4]">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/30 to-secondary/30">
              <div class="w-full h-full flex items-center justify-center bg-primary/10">
                {member.image ? (
                  <img src={member.image} alt={member.name} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <span class="text-6xl font-heading font-bold text-primary/30">{member.name.charAt(0)}</span>
                )}
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-5 transition-opacity duration-300 group-hover:opacity-0">
              <h3 class="text-lg font-bold text-white mb-0.5">{member.name}</h3>
              <p class="text-sm text-white/90">{member.role}</p>
            </div>
            <div class="absolute inset-0 bg-primary/95 flex flex-col items-center justify-center p-5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <h3 class="text-lg font-bold text-white mb-0.5 text-center">{member.name}</h3>
              <p class="text-xs text-accent font-semibold mb-2 text-center uppercase tracking-wide">{member.specialty}</p>
              <p class="text-sm text-white/85 text-center leading-relaxed">{member.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial highlight -->
  <section class="py-16 md:py-20 bg-white dark:bg-[#1e1c1c]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-accent text-sm uppercase tracking-[0.2em] font-bold mb-4">What Guests Say</p>
      <blockquote class="text-2xl md:text-3xl font-heading font-bold text-default leading-relaxed">
        {(ap.testimonial?.text) ?? "\"The Penang Heritage tour exceeded our expectations. Our guide shared amazing stories and the food was outstanding. Every dish had a story.\""}
      </blockquote>
      <div class="mt-6">
        <div class="flex items-center justify-center gap-2 text-accent text-lg">★★★★★</div>
        <p class="font-semibold text-default mt-2">{ap.testimonial?.name ?? "David Lee"}</p>
        <p class="text-sm text-muted">{ap.testimonial?.location ?? "USA"}</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#1a1a1a] py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-white mb-4">
        {ap.ctaSection?.heading ?? "Ready to Eat With Us?"}
      </h2>
      <p class="text-white/70 text-lg mb-8">
        {ap.ctaSection?.description ?? "Browse our tours, or message us on WhatsApp. We reply in minutes."}
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={ap.ctaSection?.ctaPrimary?.url ?? "/tours"} class="inline-flex items-center justify-center gap-2 bg-accent text-black font-bold px-8 py-4 rounded hover:bg-[#e8922e] transition-colors text-sm shadow-lg">
          {ap.ctaSection?.ctaPrimary?.text ?? "Browse Tours"}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={ap.ctaSection?.ctaSecondary?.url ?? "https://wa.me/60172878929"} target="_blank" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white font-bold px-8 py-4 rounded hover:bg-white/10 hover:border-white/50 transition-all text-sm">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          {ap.ctaSection?.ctaSecondary?.text ?? "WhatsApp Us"}
        </a>
      </div>
    </div>
  </section>
</Layout>
