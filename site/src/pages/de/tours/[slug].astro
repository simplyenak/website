---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { getAllTours, getFAQs, getDietaryOptionList, getTravelTypeList, getImageUrl } from '~/lib/content';
import PlayfulGallery from '~/components/widgets/PlayfulGallery.astro';
import { useTranslations } from '~/i18n/utils';
import reviews from '~/data/content/reviews.json';

export async function getStaticPaths() {
  const tours = await getAllTours('de');
  return tours.map((tour: any) => ({ params: { slug: tour.slug }, props: { tour } }));
}

const { tour } = Astro.props;
const allTours = await getAllTours('de');
const locale = 'de';
const t = useTranslations('de');
const faqs = await getFAQs();
const dietaryOptions = await getDietaryOptionList();
const travelTypes = await getTravelTypeList();

// Extract city from location string for related tours
const extractCity = (loc: string) => {
  if (!loc) return '';
  const l = loc.toLowerCase();
  if (l.includes('penang')) return 'Penang';
  if (l.includes('kl') || l.includes('kuala lumpur')) return 'Kuala Lumpur';
  return loc.split(':')[0]?.trim() || loc;
};
const currentCity = extractCity(tour.location || '');
const sameCityTours = allTours.filter((t: any) => t.slug !== tour.slug && extractCity(t.location || '') === currentCity).slice(0, 4);

// Filter reviews matching this tour's location
const tourLocation = tour.location?.toLowerCase().includes('penang') ? 'Penang' : 'KL';
const tourReviews = reviews.filter((r: any) => r.location === tourLocation).slice(0, 6);

if (!tour) return Astro.redirect('/tours');

// Hero image: handle Payload media object or plain URL, rewrite to CDN
const heroImgRaw = tour.image || tour.heroImage || '';
const heroImgUrl = typeof heroImgRaw === 'object' && heroImgRaw !== null
  ? (heroImgRaw.url || heroImgRaw.src || '')
  : heroImgRaw;
const heroImg = getImageUrl(heroImgUrl) || '';

// Fallback: if CDN blocks the hero image (problematic chars), use first gallery image
const isHeroBlocked = heroImg.includes('%20') || heroImg.includes('(') || heroImg.includes(')');
const galleryImages = [...(Array.isArray(tour.gallery_images) ? tour.gallery_images : []), ...(Array.isArray(tour.galleryImages) ? tour.galleryImages : [])];
const firstGalleryImg = galleryImages[0];
const fallbackImg = firstGalleryImg ? getImageUrl(firstGalleryImg.src || firstGalleryImg.url || '') : '';
const heroImgFinal = (isHeroBlocked && fallbackImg) ? fallbackImg : heroImg;
const foods = tour.foods || [];
const foodDescriptions = tour.foodDescriptions || {};
const itinerary = tour.itinerary || [];
// Normalize itinerary stops: data has `desc`, template expects `description`
const normalizedItinerary = itinerary.map((stop: any) => ({
  time: stop.time,
  title: stop.title,
  description: stop.description || stop.desc || '',
}));

// Determine tour time of day from first itinerary stop
const firstTime = normalizedItinerary.length > 0 ? normalizedItinerary[0].time : '';
let tourTime = 'Daily';
if (firstTime) {
  const hour = parseInt(firstTime.split(':')[0], 10);
  const ampm = firstTime.includes('PM') ? 'PM' : 'AM';
  const hour24 = ampm === 'PM' && hour !== 12 ? hour + 12 : (ampm === 'AM' && hour === 12 ? 0 : hour);
  if (hour24 < 12) tourTime = 'Morning';
  else if (hour24 < 17) tourTime = 'Afternoon';
  else tourTime = 'Evening';
}
const widgetId = tour.widgetId || tour.ticketingHubId || '';
const highlights = tour.highlights || [];

// Premium Icon mapping — Tabler SVG icons instead of emoji
const dietaryIconMap: Record<string, string> = {
  vegan: 'leaf', vegetarian: 'seeding', pescatarian: 'fish',
  halal: 'moon', 'gluten-free': 'grain', 'dairy-free': 'droplet',
  'nut-free': 'cherry', 'egg-free': 'egg', 'low-sodium': 'salt',
  'no-msg': 'x', spicy: 'flame', kosher: 'star',
};
const travelIconMap: Record<string, string> = {
  solo: 'user', foodie: 'chef-hat', family: 'users', couples: 'heart',
};
// Dietary landing page URL builder
const dietaryUrl = (slug: string) => `/tours/dietary/${slug}-food-tours-kuala-lumpur`;
// Travel type landing page URL builder
const travelUrl = (slug: string) => {
  const pluralMap: Record<string, string> = { family: 'families', couple: 'couples', foodie: 'foodies' };
  return `/tours/segments/food-tours-for-${pluralMap[slug] || slug + 's'}-kuala-lumpur`;
};

const meta = {
  title: `${tour.tagline || tour.name}  -  Simply Enak`,
  description: tour.shortDesc || tour.tagline || '',
};

// Build Tour schema (TouristTrip + Product + map signal)
// Use meeting point for precise map link, fall back to city-level
const meetingPoint = tour.meetingPoint || tour.meeting_point || '';
let mapUrl = 'https://maps.google.com/maps?q=Malaysia&z=10';
if (meetingPoint) {
  mapUrl = `https://maps.google.com/maps?q=${encodeURIComponent(meetingPoint)}&z=16`;
} else {
  const mapUrls: Record<string, string> = {
  'kuala lumpur': 'https://maps.google.com/maps?q=Kuala+Lumpur+Malaysia&z=13',
  'kl': 'https://maps.google.com/maps?q=Kuala+Lumpur+Malaysia&z=13',
  'penang': 'https://maps.google.com/maps?q=George+Town+Penang+Malaysia&z=13',
  'penang road': 'https://maps.google.com/maps?q=Penang+Road+Malaysia&z=13',
  };
  const locKey = (tour.location || 'kl').toLowerCase();
  mapUrl = mapUrls[locKey] || 'https://maps.google.com/maps?q=Malaysia&z=10';
}

const tourSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristTrip', 'Product'],
  name: tour.name,
  description: tour.shortDesc || tour.tagline || '',
  url: `https://simplyenak.com/tours/${tour.slug}`,
  image: heroImgFinal || 'https://cdn.simplyenak.com/simply_enak_logo_5e7725db1d.webp',
  location: {
    '@type': 'Place',
    name: tour.location || 'Kuala Lumpur',
    address: {
      '@type': 'PostalAddress',
      addressLocality: tour.location || 'Kuala Lumpur',
      addressCountry: 'MY',
    },
    hasMap: mapUrl,
  },
  offers: {
    '@type': 'Offer',
    price: tour.price ? tour.price.replace('RM ', '') : '285',
    priceCurrency: 'MYR',
    availability: 'https://schema.org/InStock',
    url: `https://simplyenak.com/tours/${tour.slug}`,
  },
  itinerary: tour.itinerary?.map((stop: any) => ({
    '@type': 'TouristAttraction',
    name: stop.title,
    description: stop.description || stop.desc || '',
  })) || undefined,
  provider: {
    '@type': 'TravelAgency',
    name: 'Simply Enak',
    url: 'https://simplyenak.com',
    telephone: '+60 17-287 8929',
  },
};
---

<Layout metadata={meta}>
  <!-- TouristTrip + Product Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(tourSchema)} />
  <!-- Breadcrumb + Section Nav -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="md:flex md:items-center md:gap-4 py-3">
        <nav class="flex gap-2 overflow-x-auto" aria-label="Tour sections">
          {[
            { id: 'overview', label: t('tour.overview') },
            { id: 'itinerary-section', label: t('tour.itinerary') },
            { id: 'tour-gallery', label: t('tour.gallery') },
            { id: 'food', label: t('tour.whatYouTaste') },
            { id: 'faq', label: 'FAQ' },
          ].filter(s => {
            if (s.id === 'food' && foods.length === 0) return false;
            return true;
          }).map(s => (
            <a href={`#${s.id}`}
               class="px-4 py-1.5 rounded-full text-sm font-semibold text-default border border-gray-200 dark:border-white/20 hover:border-primary hover:text-primary transition-colors">
              {s.label}
            </a>
          ))}
        </nav>
        <div class="hidden md:flex items-center gap-1.5 text-xs text-muted shrink-0 ml-auto">
          <a href="/" class="hover:text-primary transition-colors whitespace-nowrap">Home</a>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/tours" class="hover:text-primary transition-colors whitespace-nowrap">Tours</a>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-default font-semibold whitespace-nowrap">{tour.tagline || tour.name}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Hero: side-by-side layout -->
  <section class="bg-[#1a1a1a] relative text-white">
    <div class="max-w-7xl mx-auto">
      <div class="md:grid md:grid-cols-2 md:min-h-[450px]">
        <div class="overflow-hidden relative h-72 md:h-full md:max-h-[500px]">
          {heroImgFinal && <img src={heroImgFinal} alt={tour.tagline || tour.name} class="w-full h-full object-cover" />}
          <div class="absolute inset-0 bg-gradient-to-r from-black/60 hidden md:block to-transparent"></div>
        </div>
        <div class="flex justify-center flex-col bg-[#1a1a1a] md:p-10 p-8">
          <p class="font-bold text-xs uppercase mb-2 tracking-[0.2em] text-accent/80">{tour.tagline || 'Food Tour'}</p>
          <h1 class="font-bold font-heading text-3xl md:text-4xl leading-tight lg:text-5xl mb-2" style="font-size:clamp(1.5rem, 4.5vw, 3rem)">
            <span class="text-white">
              <span class="px-4 bg-accent font-black inline-block py-1 rounded-sm shadow-xl text-black" style="transform:rotate(-.7deg);font-size:clamp(1.3rem, 4.5vw, 3rem)">
                {tour.name}
              </span>
            </span>
          </h1>
          <p class="text-sm mb-4 text-white/60">{tour.shortDesc ? tour.shortDesc.substring(0, 120) + '...' : ''}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {(tour.dietaryOptions || []).map((opt) => {
              const tag = dietaryOptions.find((d: any) => d.slug === opt);
              return tag ? (
                <a href={dietaryUrl(opt)}
                   class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium hover:opacity-80 transition-opacity"
                   style="background:rgba(255,163,51,.12);border:1px solid rgba(255,163,51,.25);color:#FFA333">
                  <Icon name={`tabler:${dietaryIconMap[opt] || 'check'}`} class="w-3.5 h-3.5" />
                  {tag.name || opt}
                </a>
              ) : null;
            })}
            {(tour.travelTypes || []).map((t) => {
              const tag = travelTypes.find((tt: any) => tt.slug === t);
              return tag ? (
                <a href={travelUrl(t)}
                   class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium hover:opacity-80 transition-opacity"
                   style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.85)">
                  <Icon name={`tabler:${travelIconMap[t] || 'user'}`} class="w-3.5 h-3.5" />
                  {tag.name || t}
                </a>
              ) : null;
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-16">
    <div class="grid gap-10 md:grid-cols-5">
      <!-- Left: Main Content -->
      <div class="md:col-span-3 min-w-0">
          <!-- Overview -->
          <section id="overview" class="mb-16 scroll-mt-20">
            <h2 class="font-bold font-heading text-default text-2xl md:text-3xl mb-6">{t('tour.aboutThisTour')}</h2>
            <div class="text-default leading-relaxed space-y-4">
              {tour.shortDesc && <p class="text-muted">{tour.shortDesc}</p>}
              {tour.fullDesc && <div class="text-muted space-y-4 set-html-content" set:html={tour.fullDesc} />}
            </div>

          {highlights.length > 0 && (
            <div class="mt-8">
              <h3 class="font-bold font-heading text-default text-xl mb-4">{t('tour.highlights')}</h3>
              <ul class="space-y-3">
                {highlights.map((h) => (
                  <li class="flex items-start gap-3 text-muted">
                    <span class="text-accent shrink-0 mt-1">✦</span>
                    <span class="break-words">{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>

        <!-- Itinerary -->
        {tour.itinerary && tour.itinerary.length > 0 && (
          <section id="itinerary-section" class="mb-16 scroll-mt-20">
            <div class="text-center mb-10">
              <p class="font-bold text-xs uppercase text-accent mb-2 tracking-[0.2em]">What You'll Experience</p>
              <h2 class="font-bold font-heading text-default text-2xl md:text-3xl">{t('tour.itinerary')}</h2>
            </div>
            <div class="relative">
              <div class="absolute bg-primary/20 bottom-0 left-[19px] top-0 w-0.5"></div>
              <div class="space-y-8">
                {normalizedItinerary.map((stop, i) => (
                  <div class="flex gap-6 relative">
                    <div class="flex items-center flex-col">
                      <div class="text-sm items-center flex justify-center bg-primary font-bold font-heading h-10 relative rounded-full text-white w-10 z-10">{i + 1}</div>
                    </div>
                    <div class="flex-1 pt-1.5">
                      <h3 class="font-bold font-heading text-default text-lg mt-0.5">{stop.title}</h3>
                      {stop.description && <p class="text-sm text-muted mt-1">{stop.description}</p>}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- Polaroid Gallery -->
        <section id="tour-gallery" class="mb-16 scroll-mt-20">
          <PlayfulGallery
            tagline="Photos From This Tour"
            title={`${tour.name} Gallery`}
            images={[
              // Tier 1: gallery_images (flat format from sync: [{src, alt, caption}])
              ...(Array.isArray(tour.gallery_images) && tour.gallery_images.length > 0
                ? tour.gallery_images.map((gi: any) => ({
                    src: getImageUrl(gi.src || gi.url),
                    alt: gi.alt || tour.name,
                    caption: gi.caption || '',
                  }))
                : []),
              // Tier 2: galleryImages (nested Payload format: [{id, image: {url, alt}}])
              ...(Array.isArray(tour.galleryImages) && tour.galleryImages.length > 0
                ? tour.galleryImages.map((gi: any) => {
                    const img = gi.image || gi;
                    return {
                      src: getImageUrl(gi.src || gi.url || (typeof img === 'object' ? (img.url || img.src) : img) || ''),
                      alt: gi.alt || img.alt || tour.name,
                      caption: gi.caption || '',
                    };
                  })
                : []),
              // Tier 3: Fallback to hero image
              ...(heroImgFinal ? [{ src: heroImgFinal, alt: tour.name, caption: tour.tagline || tour.name }] : []),
            ].filter(i => i.src)}
          />
        </section>

        <!-- Food Cards -->
        {foods.length > 0 && (
          <section id="food" class="mb-16 scroll-mt-20">
            <div class="text-center mb-10">
              <p class="font-bold text-xs uppercase text-accent mb-2 tracking-[0.2em]">What's on the Menu</p>
              <h2 class="font-bold font-heading text-default text-2xl md:text-3xl">Food You'll Taste</h2>
            </div>
            <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
              {foods.map((food: any) => (
                <div class="flex items-start gap-4 bg-white border border-gray-100 p-5 rounded-lg shadow-sm">
                  <div class="flex items-center justify-center rounded-full bg-accent/10 flex-shrink-0 h-12 text-xl w-12">🍽️</div>
                  <div>
                    <h3 class="font-bold font-heading text-default">{food.name}</h3>
                    <p class="text-sm text-muted mt-0.5">{food.desc || foodDescriptions[food.name] || 'Authentic Malaysian dish'}</p>
                  </div>
                </div>
              ))}
            </div>
            <p class="text-center text-sm text-muted mt-6 italic">... and more  -  these are just some of the highlights</p>
          </section>
        )}

        <!-- FAQ -->
        <section id="faq" class="mb-16 scroll-mt-20">
          <div class="text-center mb-10">
            <p class="font-bold text-xs uppercase text-accent mb-2 tracking-[0.2em]">{t('tour.commonQuestions')}</p>
            <h2 class="font-bold font-heading text-default text-2xl md:text-3xl">Questions We Often Hear</h2>
          </div>
          <div class="space-y-2 max-w-2xl mx-auto">
            {faqs.filter((f: any) => {
              const vis = f.page_visibility || [];
              const tourSlugMap = {
                'kuala-lumpur-street-food': 'kl-street-food',
                'secrets-of-kl-nightlife-street-art-and-cocktails': 'secrets-of-kl-nightlife',
              };
              const pageKey = tourSlugMap[tour.slug] || tour.slug;
              return vis.length === 0 || vis.includes('all') || vis.includes('tour-detail') || vis.includes(pageKey);
            }).slice(0, 12).map((faq: any) => {
              const question = faq.question || faq.q || '';
              let answer = faq.answer || faq.a || '';
              if (typeof answer === 'object' && answer?.root?.children) {
                answer = answer.root.children.map((c: any) => c.children?.map((ch: any) => ch.text).join('') || '').join(' ');
              }
              return (
              <details class="border border-gray-100 bg-white dark:bg-[#1e1c1c] dark:border-white/10 overflow-hidden group rounded-lg">
                <summary class="text-sm items-center flex cursor-pointer dark:hover:bg-white/5 hover:bg-gray-50 justify-between list-none p-4 transition-colors">
                  <span class="text-default font-semibold pr-4">{question}</span>
                  <svg class="text-primary flex-shrink-0 group-open:rotate-180 h-4 transition-transform w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                </summary>
                <div class="px-4 pb-4"><p class="text-sm text-muted">{answer}</p></div>
              </details>
              );
            })}
          </div>
        </section>

        <!-- Related tours in same city -->
        <section class="mb-16">
          <h2 class="font-bold font-heading text-default text-2xl mb-8 text-center">{t('tour.youMayAlsoEnjoy')}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {sameCityTours.length > 0 ? sameCityTours.map((related: any) => (
              <a href={`/de/tours/${related.slug}`} class="border border-gray-100 bg-white overflow-hidden group block hover:shadow-md rounded shadow-sm transition-all">
                <div class="h-40 overflow-hidden relative">
                  {related.image && <img src={getImageUrl(related.image)} alt={related.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />}
                </div>
                <div class="p-4">
                  <h3 class="text-sm font-bold font-heading text-default mb-1 group-hover:text-primary transition-colors">{related.name}</h3>
                  <p class="text-xs text-muted mb-2">{related.duration} · {related.price}</p>
                  <span class="text-muted text-xs group-hover:text-primary transition-colors">View tour →</span>
                </div>
              </a>
            )) : (
              <a href="/tours" class="border border-gray-100 bg-white overflow-hidden group block hover:shadow-md rounded shadow-sm transition-all col-span-2 text-center py-10">
                <span class="text-muted text-sm group-hover:text-primary transition-colors">Browse All Tours →</span>
              </a>
            )}
          </div>
        </section>
      </div>

      <!-- Right: Sidebar -->
      <div class="md:col-span-2 min-w-0">
        <div class="md:sticky md:top-24 border border-gray-100 bg-white dark:bg-[#1e1c1c] dark:border-white/10 overflow-hidden shadow-sm rounded-xl">
          <div class="border-b border-gray-100 dark:border-white/10 p-6">
            <p class="text-muted text-xs mb-1 tracking-wide uppercase">From</p>
            <div class="font-bold font-heading text-3xl text-primary">{tour.price || 'RM 285'}</div>
            <p class="text-muted text-xs mt-1">per person · free cancellation</p>
          </div>
          <div class="border-b border-gray-100 dark:border-white/10 p-6">
            <div class="text-sm grid grid-cols-2 gap-y-3">
              <div>
                <div class="flex items-center gap-1.5">
                  <Icon name="tabler:clock" class="w-4 h-4 text-muted" />
                  <span class="text-muted">Duration</span>
                </div>
                <p class="text-default font-semibold">{tour.duration || '3.5 hours'}</p>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <Icon name="tabler:bowl-chopsticks" class="w-4 h-4 text-muted" />
                  <span class="text-muted">Tastings</span>
                </div>
                <p class="text-default font-semibold">{tour.tastings || foods.length + ' dishes'}</p>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <Icon name="tabler:calendar-time" class="w-4 h-4 text-muted" />
                  <span class="text-muted">Start</span>
                </div>
                <p class="text-default font-semibold">{firstTime || tour.schedule || 'Daily'}</p>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <Icon name={tourTime === 'Morning' ? 'tabler:sun' : tourTime === 'Afternoon' ? 'tabler:sunset' : 'tabler:moon'} class="w-4 h-4 text-muted" />
                  <span class="text-muted">Schedule</span>
                </div>
                <p class="text-default font-semibold">{tourTime || tour.schedule || 'Daily'}</p>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <Icon name="tabler:users" class="w-4 h-4 text-muted" />
                  <span class="text-muted">Group</span>
                </div>
                <p class="text-default font-semibold">{tour.groupSize || '2–9 people'}</p>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <Icon name="tabler:walk" class="w-4 h-4 text-muted" />
                  <span class="text-muted">Difficulty</span>
                </div>
                <p class="text-default font-semibold">{tour.difficulty || 'Easy'}</p>
              </div>
              {tour.cancellation && (
                <div class="col-span-2">
                  <div class="flex items-center gap-1.5">
                    <Icon name="tabler:shield-check" class="w-4 h-4 text-default" />
                    <span class="text-muted">Cancellation</span>
                  </div>
                  <p class="text-default font-semibold text-green-600">{tour.cancellation}</p>
                </div>
              )}
            </div>
          </div>
          <div class="p-6 space-y-3">
            {widgetId && (
              <div class="mx-auto max-w-fit" id={`widget-container-${widgetId}`}>
                <script src="https://assets.ticketinghub.com/checkout.js" async data-widget={widgetId}></script>
              </div>
            )}
            <a href="https://wa.me/60172878929" target="_blank"
               class="inline-flex items-center justify-center gap-2 w-full border-2 border-primary text-primary font-bold px-5 py-3 rounded-lg hover:bg-primary hover:text-white transition-colors text-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9z"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
              Chat on WhatsApp
            </a>
            <a href="/tours/private-tours"
               class="inline-flex items-center justify-center gap-2 w-full border border-gray-300 dark:border-white/20 text-muted font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors text-sm">
              <Icon name="tabler:users" class="w-4 h-4" />
              Book as a Private Tour
            </a>
          </div>
          <!-- Map embed — signal to Google Maps (no API key needed) -->
          <div class="border-t border-gray-100 dark:border-white/10 p-6">
            <p class="text-xs text-muted uppercase tracking-wider font-semibold mb-3">Location</p>
            <div class="rounded-lg overflow-hidden shadow-sm aspect-[2/1]">
              <iframe
                class="w-full h-full"
                loading="lazy"
                src={`https://www.google.com/maps?q=${encodeURIComponent(tour.location || 'Kuala Lumpur, Malaysia')}&output=embed&z=12`}
                title={`Map of ${tour.location || 'Kuala Lumpur'}`}
                style="border:0;"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>
            <a href={mapUrl} target="_blank" rel="noopener noreferrer"
               class="block p-2 text-center text-xs text-accent font-semibold hover:underline">
              Open in Google Maps &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Guest reviews -->
  {tourReviews.length > 0 && (
    <section class="py-16 bg-gradient-to-b from-transparent to-muted/20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">{t('tour.whatGuestsSay')}</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">{t('tour.realReviews')}</h2>
          <p class="text-muted max-w-2xl mx-auto mt-4 text-sm">What our guests say about tours in {tourLocation}</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {tourReviews.map((r: any) => (
            <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col">
              <div class="flex items-center gap-1 mb-3">
                {Array.from({ length: r.rating }).map(() => (
                  <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="text-sm text-muted italic flex-grow">&ldquo;{r.text.replace('Pauline','our guide').replace('Danny','our guide').replace('Gary','our guide').replace('Wei Shen','our guide').replace('Ronald','our guide').replace('Jackie','our guide').replace('Ron','our guide').replace('Suraiya','our guide').replace('Grace','our guide').replace('Su Li','our guide').replace('Mark','our guide').replace('Mimi','our guide').replace('Ezz','our guide').length > 180 ? r.text.replace('Pauline','our guide').replace('Danny','our guide').replace('Gary','our guide').replace('Wei Shen','our guide').replace('Ronald','our guide').replace('Jackie','our guide').replace('Ron','our guide').replace('Suraiya','our guide').replace('Grace','our guide').replace('Su Li','our guide').replace('Mark','our guide').replace('Mimi','our guide').replace('Ezz','our guide').slice(0, 180) + '&hellip;' : r.text.replace('Pauline','our guide').replace('Danny','our guide').replace('Gary','our guide').replace('Wei Shen','our guide').replace('Ronald','our guide').replace('Jackie','our guide').replace('Ron','our guide').replace('Suraiya','our guide').replace('Grace','our guide').replace('Su Li','our guide').replace('Mark','our guide').replace('Mimi','our guide').replace('Ezz','our guide')}&rdquo;</p>
              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/10">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-semibold">{r.author}</p>
                    <p class="text-xs text-muted">{r.date} &middot; via Google</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
<script is:inline>
  if (window.trackTourInterest) window.trackTourInterest('{tour.name || tour.tagline || ''}');
</script>
<style is:global>
  .set-html-content img,
  .set-html-content table,
  .set-html-content pre,
  .set-html-content iframe {
    max-width: 100% !important;
    height: auto;
  }
</style>
