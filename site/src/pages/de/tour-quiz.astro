---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

import { useTranslations } from '~/i18n/utils';

const t = useTranslations('de');

let quizData: any = {};
try {
  quizData = (await import('~/data/content/tour-quiz.json')).default;
} catch {}

const steps = quizData.steps || [];
const personalities = quizData.personalities || [];
const scoringWeights = quizData.scoring_weights || [];
const resultHeadlines = quizData.result_headlines || [];

const meta = {
  title: 'Find Your Perfect Food Tour | Simply Enak Quiz',
  description: 'Not sure which tour to pick? Take our quick quiz and discover the perfect Malaysian food tour for your style and appetite.',
};
---

<Layout metadata={meta}>
  <!-- Breadcrumb -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-3 text-xs text-muted">
        <a href="/de/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">Tour Quiz</span>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <div class="w-full h-full bg-gradient-to-br from-[#2a1a1a] to-[#1a1a1a]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black/80"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <p class="text-accent/90 text-xs uppercase tracking-[0.2em] font-bold mb-3">Find Your Tour</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4">
        <span class="inline-block bg-accent text-black px-4 py-1 rounded-sm" style="transform:rotate(-0.7deg)">
          {t('tour_quiz.title')}
        </span>
        <span class="block text-white/90 text-xl md:text-2xl mt-3 font-normal font-sans">
          Answer a few quick questions and we'll match you with the perfect Malaysian food experience.
        </span>
      </h1>
    </div>
  </section>

  <!-- Quiz Section -->
  <section class="py-16 md:py-20 bg-muted/30" id="quiz-section">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div id="quiz-container" class="bg-card border border-gray-100 dark:border-white/10 rounded-xl shadow-sm p-6 md:p-10">
        <!-- Empty shell — JS renders into these -->
        <div id="quiz-progress" class="mb-6"></div>
        <div id="quiz-body"></div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      // ── Data from Astro imported JSON ───────────────────────────────
      const STEPS = {JSON.stringify(steps)};
      const PERSONALITIES = {JSON.stringify(personalities)};
      const SCORING_WEIGHTS = {JSON.stringify(scoringWeights)};
      const RESULT_HEADLINES = {JSON.stringify(resultHeadlines)};

      const quizContainer = document.getElementById('quiz-container');
      const progressEl = document.getElementById('quiz-progress');
      const bodyEl = document.getElementById('quiz-body');

      // ── State ───────────────────────────────────────────────────────
      let currentStep = 0;
      let answers = {}; // { question_id: answer_value }

      // Build a lookup: question_id -> answer_value -> weights
      // Also map step question IDs
      const questionIdMap = {};
      STEPS.forEach(function(step, idx) {
        // The step id might be "1","2","3" etc, and scoring uses question_ids like "malaysian_exposure", "comfort_zone"
        // We need to figure out mapping from step index to question_id used in scoring_weights
        // scoring uses: malaysian_exposure (step 1), comfort_zone (step 2), draw (step 3), ideal_scene (step 4), food_memory (step 5)
        const QUESTION_IDS = ['malaysian_exposure', 'comfort_zone', 'draw', 'ideal_scene', 'food_memory'];
        questionIdMap[idx] = QUESTION_IDS[idx] || ('q_' + idx);
      });

      // Build weights lookup: { question_id: { answer_value: { personality_key: score } } }
      const weightsLookup = {};
      SCORING_WEIGHTS.forEach(function(w) {
        if (!weightsLookup[w.question_id]) weightsLookup[w.question_id] = {};
        weightsLookup[w.question_id][w.answer_value] = w.weights;
      });

      // ── Render Functions ────────────────────────────────────────────

      function renderProgress() {
        const totalSteps = STEPS.length;
        const percent = ((currentStep + 1) / totalSteps) * 100;
        progressEl.innerHTML =
          '<div class="flex items-center justify-between mb-2">' +
            '<span class="text-xs font-semibold text-muted">Question ' + (currentStep + 1) + ' of ' + totalSteps + '</span>' +
            '<span class="text-xs text-muted">' + Math.round(percent) + '%</span>' +
          '</div>' +
          '<div class="w-full bg-gray-200 dark:bg-white/10 rounded-full h-2">' +
            '<div class="bg-accent h-2 rounded-full transition-all duration-500" style="width:' + percent + '%"></div>' +
          '</div>';
      }

      function renderStep() {
        var step = STEPS[currentStep];
        if (!step) {
          renderResults();
          return;
        }

        var html = '<div class="min-h-[300px]">';

        // Question
        html += '<h2 class="text-xl md:text-2xl font-bold font-heading mb-2">' + step.question + '</h2>';

        // Options
        html += '<div class="mt-6 space-y-3">';
        step.options.forEach(function(opt) {
          html +=
            '<button type="button" class="quiz-option w-full text-left p-4 md:p-5 rounded-xl border border-gray-100 dark:border-white/10 bg-card hover:border-accent hover:bg-accent/5 transition-all cursor-pointer group" data-value="' + opt.value + '">' +
              '<div class="flex items-start gap-4">' +
                '<span class="text-2xl shrink-0">' + (opt.icon || '🍽️') + '</span>' +
                '<div class="flex-1">' +
                  '<span class="block font-bold font-heading text-default group-hover:text-accent transition-colors">' + opt.label + '</span>' +
                  (opt.description ? '<span class="block text-sm text-muted mt-1">' + opt.description + '</span>' : '') +
                '</div>' +
                '<span class="shrink-0 w-5 h-5 rounded-full border-2 border-gray-300 dark:border-white/20 group-hover:border-accent flex items-center justify-center mt-1 transition-colors">' +
                  '<span class="w-2.5 h-2.5 rounded-full hidden group-hover:block bg-accent"></span>' +
                '</span>' +
              '</div>' +
            '</button>';
        });
        html += '</div>';

        // Nav buttons
        html += '<div class="mt-8 flex justify-between">';
        if (currentStep > 0) {
          html += '<button type="button" id="quiz-prev" class="inline-flex items-center gap-2 text-sm font-semibold text-muted hover:text-default transition-colors px-4 py-2">' +
                    '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>' +
                    'Previous' +
                  '</button>';
        } else {
          html += '<div></div>';
        }
        html += '</div>';

        html += '</div>';

        bodyEl.innerHTML = html;

        // Attach click handlers to options
        bodyEl.querySelectorAll('.quiz-option').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            var value = btn.getAttribute('data-value');
            handleAnswer(value);
          });
        });

        // Attach prev handler
        var prevBtn = document.getElementById('quiz-prev');
        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            if (currentStep > 0) {
              currentStep--;
              renderProgress();
              renderStep();
            }
          });
        }

        // Scroll into view smoothly
        quizContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function handleAnswer(value) {
        var qId = questionIdMap[currentStep];
        answers[qId] = value;

        if (currentStep < STEPS.length - 1) {
          currentStep++;
          renderProgress();
          renderStep();
        } else {
          // Calculate results
          renderProgress();
          renderResults();
        }
      }

      function calculateScores() {
        var scores = {};
        PERSONALITIES.forEach(function(p) {
          scores[p.key] = 0;
        });

        // Aggregate weights from all answers
        for (var qId in answers) {
          if (!answers.hasOwnProperty(qId)) continue;
          var answerValue = answers[qId];
          var qWeights = weightsLookup[qId];
          if (!qWeights) continue;
          var answerWeights = qWeights[answerValue];
          if (!answerWeights) continue;
          for (var personalityKey in answerWeights) {
            if (!answerWeights.hasOwnProperty(personalityKey)) continue;
            if (scores[personalityKey] !== undefined) {
              scores[personalityKey] += answerWeights[personalityKey];
            }
          }
        }

        return scores;
      }

      function getTopPersonality(scores) {
        var maxScore = -1;
        var topKey = null;
        for (var key in scores) {
          if (scores.hasOwnProperty(key) && scores[key] > maxScore) {
            maxScore = scores[key];
            topKey = key;
          }
        }
        // Find the personality with that key
        var matched = null;
        PERSONALITIES.forEach(function(p) {
          if (p.key === topKey) matched = p;
        });
        return { personality: matched, score: maxScore, scores: scores };
      }

      function getHeadline(key) {
        var headlineData = null;
        RESULT_HEADLINES.forEach(function(h) {
          if (h.key === key) headlineData = h;
        });
        if (!headlineData && RESULT_HEADLINES.length > 0) {
          headlineData = RESULT_HEADLINES[RESULT_HEADLINES.length - 1];
        }
        return headlineData;
      }

      function renderResults() {
        var scores = calculateScores();
        var result = getTopPersonality(scores);
        var headline = getHeadline('single_match') || getHeadline('fallback');

        var html = '<div class="text-center min-h-[300px]">';

        // Headline
        html += '<div class="mb-8">';
        if (headline) {
          html += '<p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">YOUR RESULT</p>';
          html += '<h2 class="text-2xl md:text-3xl font-bold font-heading mb-2">' + (headline.headline || t('tour_quiz.perfectMatch')}') + '</h2>';
          if (headline.subtext) {
            html += '<p class="text-muted text-sm max-w-md mx-auto">' + headline.subtext + '</p>';
          }
        }
        html += '</div>';

        // Personality card
        if (result.personality) {
          html +=
            '<div class="max-w-md mx-auto bg-card border border-gray-100 dark:border-white/10 rounded-xl p-8 shadow-sm mb-8">' +
              '<div class="text-5xl mb-4">' + (result.personality.emoji || '🌟') + '</div>' +
              '<h3 class="text-xl font-bold font-heading mb-2">' + result.personality.title + '</h3>' +
              '<p class="text-sm text-muted leading-relaxed">' + result.personality.description + '</p>';

          if (result.personality.tour_match) {
            html +=
              '<div class="mt-6 pt-6 border-t border-gray-100 dark:border-white/10">' +
                '<p class="text-xs uppercase tracking-wider text-accent font-bold mb-2">Recommended For You</p>' +
                '<p class="text-sm font-semibold text-default">' + result.personality.tour_match + '</p>' +
              '</div>';
          }
          html += '</div>';
        } else {
          html += '<p class="text-muted mb-8">We couldn\'t determine a match. Browse our tours to find what appeals to you.</p>';
        }

        // Score breakdown (compact)
        html += '<div class="max-w-md mx-auto mb-8">';
        html += '<p class="text-xs uppercase tracking-wider text-muted font-bold mb-3">Your Match Scores</p>';
        html += '<div class="space-y-2">';
        if (result.scores) {
          var maxScore = 0;
          for (var k in result.scores) if (result.scores[k] > maxScore) maxScore = result.scores[k];
          PERSONALITIES.forEach(function(p) {
            var score = result.scores[p.key] || 0;
            var pct = maxScore > 0 ? (score / maxScore) * 100 : 0;
            html +=
              '<div class="flex items-center gap-3">' +
                '<span class="text-sm w-8 shrink-0 text-center">' + (p.emoji || '') + '</span>' +
                '<span class="text-xs font-semibold text-default text-left w-28 shrink-0">' + p.title + '</span>' +
                '<div class="flex-1 bg-gray-200 dark:bg-white/10 rounded-full h-2">' +
                  '<div class="bg-accent h-2 rounded-full transition-all" style="width:' + Math.round(pct) + '%"></div>' +
                '</div>' +
                '<span class="text-xs text-muted w-8 text-right">' + score + '</span>' +
              '</div>';
          });
        }
        html += '</div></div>';

        // CTA
        html +=
          '<div class="flex flex-wrap gap-4 justify-center">' +
            '<a href="/de/tours" class="inline-flex items-center gap-2 bg-accent text-black font-bold px-8 py-3 rounded-lg hover:bg-accent/90 transition-colors">' +
              '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>' +
              t('tour_quiz.browseAll') +
            '</a>' +
            '<button type="button" id="quiz-restart" class="inline-flex items-center gap-2 border-2 border-gray-300 dark:border-white/20 text-default font-semibold px-8 py-3 rounded-lg hover:border-accent transition-colors">' +
              '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>' +
              t('tour_quiz.takeAgain') +
            '</button>' +
          '</div>';

        html += '</div>';

        bodyEl.innerHTML = html;

        // Restart handler
        var restartBtn = document.getElementById('quiz-restart');
        if (restartBtn) {
          restartBtn.addEventListener('click', function() {
            currentStep = 0;
            answers = {};
            renderProgress();
            renderStep();
          });
        }

        quizContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // ── Initial Render ─────────────────────────────────────────────
      function init() {
        if (STEPS.length === 0) {
          bodyEl.innerHTML = '<p class="text-center text-muted py-8">Quiz questions are being prepared. Check back soon!</p>';
          return;
        }
        renderProgress();
        renderStep();
      }

      init();
    })();
  </script>

  <style is:inline>
    .quiz-option:focus {
      outline: 2px solid #d97706;
      outline-offset: 2px;
    }
    .quiz-option:focus:not(:focus-visible) {
      outline: none;
    }
  </style>
</Layout>
