---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

import { useTranslations } from '~/i18n/utils';

const t = useTranslations('pt');

let pageData: any = {};
try {
  pageData = (await import('~/data/content/directions-page.json')).default;
} catch {}

const heroTitle = pageData.hero_title || 'Meeting Points & Directions';
const heroDescription = pageData.hero_description || 'Find your meeting point and get ready for an authentic Malaysian food adventure.';
const meetingPoints = pageData.meeting_points || [];
const generalTips = pageData.general_tips || [];

const meta = {
  title: pageData.seo_title || 'Meeting Points & Directions',
  description: pageData.seo_description || 'Meeting points and directions for Simply Enak Malaysian food tours in KL and Penang.',
};
---

<Layout metadata={meta}>
  <!-- Breadcrumb -->
  <div class="sticky top-0 z-30 bg-page border-b border-gray-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-3 text-xs text-muted">
        <a href="/pt/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">Directions</span>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden">
    <div class="absolute inset-0">
      <div class="w-full h-full bg-gradient-to-br from-[#2a1a1a] to-[#1a1a1a]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black/80"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <p class="text-accent/90 text-xs uppercase tracking-[0.2em] font-bold mb-3">Getting Here</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4">
        <span class="inline-block bg-accent text-black px-4 py-1 rounded-sm" style="transform:rotate(-0.7deg)">
          {heroTitle}
        </span>
        <span class="block text-white/90 text-xl md:text-2xl mt-3 font-normal font-sans">
          {heroDescription}
        </span>
      </h1>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="https://wa.me/60172878929?text=Hi%2C+I+need+help+finding+the+meeting+point"
           class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors text-sm">
          <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
          Need Help? Chat With Us
        </a>
      </div>
    </div>
  </section>

  <!-- Meeting Points -->
  {meetingPoints.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Meeting Points</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">Tour Meeting Locations</h2>
          <p class="text-muted max-w-2xl mx-auto mt-3 text-sm">Where to meet your guide for each tour. All locations are central and easy to reach.</p>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
          {meetingPoints.map((point: any) => (
            <div class="p-6 md:p-8 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center text-accent">
                  <Icon name="tabler:map-pin" class="w-5 h-5" />
                </div>
                <h3 class="text-lg font-bold font-heading">{point.tour || point.location_name}</h3>
              </div>

              {point.location_name && (
                <p class="text-sm font-semibold text-default mb-1">{point.location_name}</p>
              )}

              {point.address && (
                <p class="text-sm text-muted mb-3 flex items-start gap-2">
                  <Icon name="tabler:map" class="w-4 h-4 shrink-0 mt-0.5 text-muted" />
                  <span>{point.address}</span>
                </p>
              )}

              {point.directions && (
                <div class="mb-3">
                  <p class="text-xs uppercase tracking-wider text-muted font-bold mb-1 flex items-center gap-1">
                    <Icon name="tabler:direction-sign" class="w-3 h-3" /> Directions
                  </p>
                  <p class="text-sm text-muted">{point.directions}</p>
                </div>
              )}

              {point.landmark && (
                <p class="text-sm text-default mb-2 flex items-center gap-2">
                  <Icon name="tabler:building-arch" class="w-4 h-4 text-accent shrink-0" />
                  <span><span class="font-semibold">Landmark:</span> {point.landmark}</span>
                </p>
              )}

              {point.parking_info && (
                <p class="text-sm text-muted mb-2 flex items-start gap-2">
                  <Icon name="tabler:car" class="w-4 h-4 shrink-0 mt-0.5 text-muted" />
                  <span>{point.parking_info}</span>
                </p>
              )}

              {point.public_transport && (
                <p class="text-sm text-muted mb-4 flex items-start gap-2">
                  <Icon name="tabler:bus" class="w-4 h-4 shrink-0 mt-0.5 text-muted" />
                  <span>{point.public_transport}</span>
                </p>
              )}

              {point.map_url && (
                <a href={point.map_url} target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary/80 transition-colors">
                  <Icon name="tabler:external-link" class="w-4 h-4" />
                  Open in Google Maps
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- General Tips -->
  {generalTips.length > 0 && (
    <section class="py-16 md:py-20 bg-muted/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Tips</p>
          <h2 class="text-3xl md:text-4xl font-bold font-heading">Helpful Tips for Your Visit</h2>
        </div>
        <div class="max-w-2xl mx-auto">
          <ul class="space-y-3">
            {generalTips.map((tip: any) => (
              <li class="flex items-start gap-3 p-4 rounded-lg border border-gray-100 dark:border-white/10 bg-card">
                <Icon name="tabler:check" class="w-5 h-5 text-green-500 shrink-0 mt-0.5" />
                <span class="text-sm text-default">{tip.tip || tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-[#1a1a1a] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">Still Have Questions?</p>
      <h2 class="text-2xl md:text-3xl font-bold font-heading mb-4">Need Help Finding Your Way?</h2>
      <p class="text-white/70 max-w-xl mx-auto mb-8 text-sm">Not sure which meeting point applies to your booking? Contact us and we'll guide you.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/pt/contact"
           class="inline-flex items-center gap-2 bg-accent text-black font-bold px-8 py-4 rounded-lg hover:bg-accent/90 transition-colors">
          <Icon name="tabler:mail" class="w-5 h-5" />
          Contact Us
        </a>
        <a href="https://wa.me/60172878929?text=Hi%2C+I+need+help+finding+the+meeting+point"
           target="_blank"
           class="inline-flex items-center gap-2 border border-white/30 text-white font-semibold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
