---
import Layout from '~/layouts/PageLayout.astro';
import { getFAQsByPage } from '~/lib/content';

import { useTranslations } from '~/i18n/utils';

const lang = 'pt';

const faqs = await getFAQsByPage('faq', 'pt');


const t = useTranslations(lang);
const metadata = {
  title: 'Frequently Asked Questions About Malaysian Food Tours',
  description: "Everything you need to know about Simply Enak's food tours in Kuala Lumpur and Penang. Dietary requirements, group sizes, pricing, cancellation policy, and more.",
};

// Build FAQPage structured data
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq: any) => ({
    '@type': 'Question',
    name: faq.question || faq.q || '',
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer || faq.a || '',
    },
  })),
};
---
---

<Layout metadata={metadata}>
  <!-- FAQPage Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden py-20 md:py-28">
    <div class="absolute inset-0">
      <img src="https://se-website-images.s3.nl-ams.scw.cloud/payload-media/Food_Experience_optimized_adc493606c.jpg" alt="" class="w-full h-full object-cover opacity-30" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a1a]/70 via-[#1a1a1a]/85 to-[#1a1a1a]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-accent/90 text-sm md:text-base uppercase tracking-[0.2em] font-bold mb-4">FAQ</p>
      <h1 class="text-4xl md:text-5xl font-bold font-heading mb-6 leading-tight" style="font-size: clamp(1.5rem, 5vw, 3.25rem);">
        <span class="block text-white mb-2">Frequently <span class="inline-block bg-accent text-black px-4 py-1.5 rounded-sm shadow-xl font-black" style="transform: rotate(-0.7deg); font-size: clamp(1.3rem, 4.5vw, 3rem);">Asked Questions</span></span>
      </h1>
      <p class="text-xl text-white/80 max-w-2xl mx-auto">
        Everything you need to know before experiencing Malaysia's best food tours.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-page border-b border-gray-100 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <a href="/pt/" class="hover:text-primary transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">FAQ</span>
      </div>
    </div>
  </nav>

  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="space-y-4">
        {faqs.map((faq: any) => {
          // Handle both Payload format (question/answer) and hardcoded fallback (q/a)
          const question = faq.question || faq.q || '';
          let answer = faq.answer || faq.a || '';
          // Payload rich text: extract text from nested children
          if (typeof answer === 'object' && answer?.en?.root?.children) {
            answer = answer.en.root.children
              .map((c: any) => c.children?.map((ch: any) => ch.text).join('') || '')
              .join(' ');
          } else if (typeof answer === 'object') {
            // Try direct children array
            const children = answer.root?.children || answer.children || [];
            answer = children.map((c: any) => c.children?.map((ch: any) => ch.text).join('') || c.text || '').join(' ');
          }
          return (
          <details class="group bg-white rounded shadow-sm border border-gray-100 overflow-hidden">
            <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-gray-50 transition-colors">
              <h3 class="text-lg font-bold font-heading text-default pr-4">{question}</h3>
              <svg class="w-5 h-5 text-primary flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-default leading-relaxed">{answer}</p>
            </div>
          </details>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Still have questions CTA -->
  <section class="py-16 bg-white text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold font-heading text-default mb-4">Still Have Questions?</h2>
      <p class="text-muted text-lg mb-8">We're here to help. Reach out anytime.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/pt/contact" class="inline-flex items-center gap-2 bg-primary text-white font-bold px-8 py-3.5 rounded hover:bg-[#a02830] transition-all shadow-md">
          Contact Us
        </a>
        <a href="https://wa.me/60172878929" target="_blank" class="inline-flex items-center gap-2 border-2 border-primary text-primary font-bold px-8 py-3.5 rounded hover:bg-primary hover:text-white transition-all">
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>
</Layout>
