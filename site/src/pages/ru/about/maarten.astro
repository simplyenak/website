---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Мартен Бельманс, сооснователь Simply Enak',
  description: 'Мартен Бельманс — сооснователь Simply Enak, работает в малайзийском гастротуризме с 2011 года. Познакомьтесь с сооснователем гастротуров Simply Enak.',
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Simply Enak', item: 'https://simplyenak.com/ru/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://simplyenak.com/ru/about/' },
    { '@type': 'ListItem', position: 3, name: 'Maarten Belmans', item: 'https://simplyenak.com/ru/about/maarten/' },
  ],
};
---

<Layout metadata={metadata} structuredData={breadcrumb}>
  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden py-16 md:py-24">
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-accent text-xs md:text-sm uppercase tracking-[0.25em] font-bold mb-5">Наша команда</p>
      <h1 class="text-4xl md:text-6xl font-bold font-heading leading-tight mb-5" style="font-size: clamp(2rem, 6vw, 3.75rem);">Maarten Belmans</h1>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">Сооснователь, операции и развитие, Simply Enak</p>
      <div class="mt-8 max-w-xs mx-auto flex items-center justify-center aspect-[3/4] rounded-lg bg-primary/20 border border-white/10"><span class="text-7xl font-heading font-bold text-white/40">M</span></div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-page border-b border-gray-100 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <a href="/ru/" class="hover:text-primary transition-colors">Главная</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/ru/about" class="hover:text-primary transition-colors">О нас</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">Maarten Belmans</span>
      </div>
    </div>
  </nav>

  <!-- Who is ... (entity facts) -->
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-8">Кто такая Maarten Belmans?</h2>
      <div class="space-y-4 text-default leading-relaxed">
        <p>Мартен Бельманс — сооснователь Simply Enak, компании гастротуров в Куала-Лумпуре, Малайзия. Мартен Бельманс работает в малайзийском гастротуризме с 2011 года, когда он и Полин Ли вместе основали Simply Enak.</p>
        <p>Мартен Бельманс отвечает за операционную работу каждого тура Simply Enak: расписание гидов, отношения с торговцами и разработку новых гастротуров в Куала-Лумпуре, Пенанге и Малакке. Его принцип прост: каждая остановка — это лоток, куда команда сама повела бы свою семью.</p>
        <p>Мартен Бельманс работает с лицензированными местными гидами, включая основательницу Полин Ли, проводя гастрономические туры по Малайзии для малых групп и частные. Мартен Бельманс — оператор гастротуров в Малайзии и сооснователь Simply Enak.</p>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-16 md:py-24 bg-white dark:bg-[#1e1c1c]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-8">Строим Simply Enak с 2011 года</h2>
      <div class="space-y-4 text-default leading-relaxed">
        <p>Мартен присоединился к Полин в 2011 году, чтобы превратить её прогулки по рынкам в турфирму. От первых маршрутов по Чайнатауну до сегодняшних туров по Куала-Лумпуру, Пенангу и Малакке он уже больше десяти лет работает на операционной стороне малайзийского гастротуризма.</p>
        <p>Эта работа продолжается в туристических инструментах, которые создаёт Simply Enak, таких как гид по сезону дуриана When Is Durian Season, и в отношениях с торговцами Чоу Кита, Джалан Алора и Джорджтауна, благодаря которым возможен каждый тур.</p>
      </div>
    </div>
  </section>

  <!-- Profiles / corroboration links -->
  <section class="py-16 md:py-24 bg-gray-50 dark:bg-[#151313]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-default mb-6">Maarten Belmans в интернете</h2>
      <ul class="space-y-3 text-default">
        <li><a href="https://www.tripadvisor.com/Attraction_Review-g298570-d2414763-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html" class="text-primary hover:text-accent font-semibold transition-colors">Simply Enak на TripAdvisor &rarr;</a></li>
        <li><a href="https://www.getyourguide.com/simply-enak-food-experiences-s4050/" class="text-primary hover:text-accent font-semibold transition-colors">Simply Enak на GetYourGuide &rarr;</a></li>
        <li><a href="/ru/about" class="text-primary hover:text-accent font-semibold transition-colors">О Simply Enak &rarr;</a></li>
        <li><a href="/ru/tours" class="text-primary hover:text-accent font-semibold transition-colors">Все гастротуры &rarr;</a></li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#1a1a1a] py-16 md:py-20">
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-white mb-5">Вкусите Малайзию с командой Simply Enak</h2>
      <p class="text-lg text-white/80 max-w-2xl mx-auto mb-8 leading-relaxed">Смотрите гастротуры, которые ведут Полин, Триш и лицензированные гиды Simply Enak.</p>
      <a href="/ru/tours" class="inline-block bg-accent text-black font-bold px-8 py-4 rounded-sm hover:bg-white transition-colors">Смотреть гастротуры</a>
    </div>
  </section>
</Layout>
