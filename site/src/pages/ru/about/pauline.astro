---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Полин Ли, основательница и главный гид Simply Enak',
  description: 'Полин Ли основала Simply Enak в 2011 году и с тех пор проводит стритфуд-туры по Куала-Лумпуру. Познакомьтесь с основательницей и главным гидом Simply Enak.',
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Simply Enak', item: 'https://simplyenak.com/ru/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://simplyenak.com/ru/about/' },
    { '@type': 'ListItem', position: 3, name: 'Pauline Lee', item: 'https://simplyenak.com/ru/about/pauline/' },
  ],
};
---

<Layout metadata={metadata} structuredData={breadcrumb}>
  <!-- Hero -->
  <section class="relative bg-[#1a1a1a] text-white overflow-hidden py-16 md:py-24">
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-accent text-xs md:text-sm uppercase tracking-[0.25em] font-bold mb-5">Наша команда</p>
      <h1 class="text-4xl md:text-6xl font-bold font-heading leading-tight mb-5" style="font-size: clamp(2rem, 6vw, 3.75rem);">Pauline Lee</h1>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">Основательница и главный гид, Simply Enak</p>
      <div class="mt-8 max-w-xs mx-auto"><img src="https://se-website-images.s3.nl-ams.scw.cloud/payload-media/pauline-founder-portrait.jpg" alt="Pauline Lee" class="w-full rounded-lg shadow-2xl border-2 border-white/10" loading="eager" /></div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-page border-b border-gray-100 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <a href="/ru/" class="hover:text-primary transition-colors">Главная</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/ru/about" class="hover:text-primary transition-colors">О нас</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-default font-semibold">Pauline Lee</span>
      </div>
    </div>
  </nav>

  <!-- Who is ... (entity facts) -->
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-8">Кто такая Pauline Lee?</h2>
      <div class="space-y-4 text-default leading-relaxed">
        <p>Полин Ли — гид гастрономических туров и основательница Simply Enak, компании гастротуров в Куала-Лумпуре, Малайзия. Полин основала Simply Enak в 2011 году и с тех пор проводит стритфуд-туры по Куала-Лумпуру. Гости её туров знают её просто как Полин.</p>
        <p>Полин Ли выросла в Малайзии: она ходила с матерью по влажным рынкам, пока торговцы вокруг готовили блюда, которые их семьи передавали из поколения в поколение. Она создала Simply Enak, чтобы путешественники могли попробовать эту сторону Малайзии: лотки, торговцев, которых она знает по именам, и истории за каждым блюдом.</p>
        <p>Полин Ли ведёт гастрономические туры для небольших групп и частные туры по районам Куала-Лумпура, таким как Чайнатаун, Чоу Кит и Джалан Алор, а также проводит туры в Джорджтауне на Пенанге. Тысячи гостей оставили отзывы о её турах на TripAdvisor, GetYourGuide, Viator и Google. Полин Ли — основательница Simply Enak и гид гастротуров в Куала-Лумпуре с опытом более десяти лет.</p>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-16 md:py-24 bg-white dark:bg-[#1e1c1c]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-8">От влажных рынков к Simply Enak</h2>
      <div class="space-y-4 text-default leading-relaxed">
        <p>В детстве Полин проводила утра на влажных рынках с мамой. Пока мама торговалась за самую свежую рыбу, Полин наблюдала, как торговцы готовят блюда, передаваемые из поколения в поколение. Шипение чар кway тео в раскалённом воке. Ароматные облака карри. Искусство складывания роти чанай. Это была её Малайзия.</p>
        <p>Когда друзья приезжали из-за границы, она вела их мимо кондиционированных ресторанов с меню с картинками, через две улицы, к бабушке, которая готовила лаксу точно так, как научила её мать 60 лет назад. В 2011 году эти прогулки стали Simply Enak.</p>
      </div>
    </div>
  </section>

  <!-- Guest quotes -->
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-default mb-10">Что говорят гости о турах с Полин</h2>
      <div class="space-y-8">
        <blockquote class="border-l-4 border-accent pl-6"><p class="text-lg text-default leading-relaxed">&ldquo;Pauline gave us a wonderful tour of Chinatown! So many things I'd not noticed before, all the wonderful tastes and flavours of Malaysia and relaxing cocktails.&rdquo;</p><cite class="block mt-3 text-sm text-muted not-italic">&mdash; Laura Scott, TripAdvisor review</cite></blockquote>
        <blockquote class="border-l-4 border-accent pl-6"><p class="text-lg text-default leading-relaxed">&ldquo;Pauline was an awesome guide for our food tour around Old KL. Even though it was super humid, she made the walk really fun with her friendly vibe and great stories.&rdquo;</p><cite class="block mt-3 text-sm text-muted not-italic">&mdash; Alicia Hiew, GetYourGuide review</cite></blockquote>
      </div>
    </div>
  </section>

  <!-- Profiles / corroboration links -->
  <section class="py-16 md:py-24 bg-gray-50 dark:bg-[#151313]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-default mb-6">Pauline Lee в интернете</h2>
      <ul class="space-y-3 text-default">
        <li><a href="https://www.linkedin.com/in/pauline-simplyenak/" rel="nofollow" class="text-primary hover:text-accent font-semibold transition-colors">Pauline Lee в LinkedIn &rarr;</a></li>
        <li><a href="https://www.tripadvisor.com/Attraction_Review-g298570-d2414763-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html" class="text-primary hover:text-accent font-semibold transition-colors">Simply Enak на TripAdvisor &rarr;</a></li>
        <li><a href="https://www.getyourguide.com/simply-enak-food-experiences-s4050/" class="text-primary hover:text-accent font-semibold transition-colors">Simply Enak на GetYourGuide &rarr;</a></li>
        <li><a href="/ru/about" class="text-primary hover:text-accent font-semibold transition-colors">О Simply Enak &rarr;</a></li>
        <li><a href="/ru/tours" class="text-primary hover:text-accent font-semibold transition-colors">Все гастротуры &rarr;</a></li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#1a1a1a] py-16 md:py-20">
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold font-heading text-white mb-5">Куала-Лумпур вместе с Полин</h2>
      <p class="text-lg text-white/80 max-w-2xl mx-auto mb-8 leading-relaxed">Присоединяйтесь к туру в малой группе или закажите частичную прогулку по районам, где она выросла.</p>
      <a href="/ru/tours" class="inline-block bg-accent text-black font-bold px-8 py-4 rounded-sm hover:bg-white transition-colors">Смотреть гастротуры</a>
    </div>
  </section>
</Layout>
