---
import SegmentPage from '~/components/segment/SegmentPage.astro';
import {specialtySegments} from '~/data/segments';

export async function getStaticPaths() {
  return specialtySegments.map((s: any) => ({
    params: { slug: s.slug },
    props: { segment: s },
  }));
}

const { segment } = Astro.props;
---
<SegmentPage locale="ru" segmentType="specialty" segment={segment} />
