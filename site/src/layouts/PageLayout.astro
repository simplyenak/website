---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';

import { headerData, footerData, getHeaderData, getFooterData } from '~/navigation';
import { getLangFromUrl, localizePath } from '~/i18n/utils';

import type { MetaData } from '~/types';
import type { Language } from '~/i18n/ui';

export interface Props {
  metadata?: MetaData;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { metadata, structuredData } = Astro.props;

// Detect language from the current URL
const currentLang: Language = getLangFromUrl(Astro.url);

// Use language-aware navigation for non-English, fall back to default for English
const navData = currentLang === 'en' ? { links: headerData.links, actions: headerData.actions } : getHeaderData(currentLang);
const footerNavData = currentLang === 'en' ? footerData : getFooterData(currentLang);
---

<Layout metadata={metadata} structuredData={structuredData}>
  <slot name="announcement">
    <Announcement />
  </slot>
  <slot name="header">
    <Header {...navData} currentLang={currentLang} isSticky showToggleTheme />
  </slot>
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerNavData} />
  </slot>
</Layout>
