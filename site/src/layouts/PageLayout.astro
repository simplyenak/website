---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import GooglePreferredSources from '~/components/common/GooglePreferredSources.astro';
import Announcement from '~/components/widgets/Announcement.astro';

import { headerData, footerData, getHeaderData, getFooterData } from '~/navigation';
import { getMenuTours } from '~/lib/content';
import { getLangFromUrl, localizePath } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

import type { MetaData } from '~/types';
import type { Language } from '~/i18n/ui';

export interface Props {
  metadata?: MetaData;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { metadata, structuredData } = Astro.props;

// Detect language from the current URL
const currentLang: Language = getLangFromUrl(Astro.url);

// Use language-aware navigation for non-English, fall back to default for English
const navData = currentLang === 'en' ? { links: headerData.links, actions: headerData.actions } : getHeaderData(currentLang);
const footerNavData = currentLang === 'en' ? footerData : getFooterData(currentLang);

// Inject dynamic tour links into the header navigation
const menuTours = await getMenuTours();
if (menuTours && menuTours.length > 0) {
  const toursDropdown = navData.links?.find((l: any) => l.text === 'Tours' || l.links);
  if (toursDropdown) {
    // Keep static links: All Tours (first), replace rest with dynamic tours
    const allToursLink = toursDropdown.links?.[0];
    toursDropdown.links = [
      allToursLink,
      ...menuTours.map((t: any) => ({
        text: t.tagline || t.name || t.slug,
        href: getPermalink(`/tours/${t.slug}`),
      })),
      { text: '───', href: '' },
      { text: 'Private Tours', href: getPermalink('/tours/private-tours'), icon: 'tabler:lock', class: 'font-bold text-accent md:bg-accent/10 md:-mx-2 md:px-7 md:rounded-md md:border md:border-accent/20' } as any,
    ].filter(Boolean);
  }
}

// Build BreadcrumbList from URL path
const pathname = Astro.url.pathname.replace(/\/$/, '') || '';
const segments = pathname.split('/').filter(Boolean);
const breadcrumbItems = segments.length > 0
  ? [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplyenak.com/' }]
  : [];

let currentPath = '';
for (let i = 0; i < segments.length; i++) {
  currentPath += '/' + segments[i];
  const name = segments[i].replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: i + 2,
    name: name,
    item: 'https://simplyenak.com' + currentPath,
  });
}

const breadcrumbSchema = breadcrumbItems.length > 1 ? {
  '@type': 'BreadcrumbList',
  '@id': 'https://simplyenak.com' + pathname + '/#breadcrumb',
  itemListElement: breadcrumbItems,
} : null;

const mergedStructuredData = breadcrumbSchema
  ? [breadcrumbSchema, ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])]
  : structuredData;
---

<Layout metadata={metadata} structuredData={mergedStructuredData} lang={currentLang !== 'en' ? currentLang : undefined}>
  <slot name="announcement">
    <Announcement />
  </slot>
  <slot name="header">
    <Header {...navData as any} currentLang={currentLang} isSticky showToggleTheme />
  </slot>
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerNavData} />
    <GooglePreferredSources />
  </slot>
</Layout>
