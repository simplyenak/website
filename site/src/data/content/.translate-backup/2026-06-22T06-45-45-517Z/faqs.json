  {
    "id": 26,
    "question": "Can we change the route on a private tour?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Once you book, your guide will reach out before the day to discuss preferences. Want more seafood? Less walking? A specific neighbourhood? It's your tour — we adjust.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          }
