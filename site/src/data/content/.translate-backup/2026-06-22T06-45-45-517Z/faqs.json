  {
    "id": 23,
    "question": "Can children join the tour?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Absolutely. Kids under 6 join free, and our guides know how to keep them engaged. The walking pace is gentle with plenty of seating stops. Let us know ages when booking so we can prepare.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          }
