  {
    "id": 27,
    "question": "How far ahead should we book a private tour?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "A week ahead is comfortable, two is better. We've pulled tours together in 48 hours before, but the best routes take time to plan. For large groups or specific dietary needs, the earlier the better.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          }
        ],
        "direction": "ltr"
      }
