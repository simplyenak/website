        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Very much so. Around 30% of our guests come alone. You'll be in a small group of 2-8 people, and our guides are experts at bringing everyone into the conversation. Many solo travellers tell us it's the highlight of their trip.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          }
        ],
