  {
    "id": 22,
    "question": "What if I have a food allergy?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Flag it when you book and we'll brief your guide. Malaysian cooking uses peanuts, shrimp paste, and soy frequently — but we know which stalls can accommodate and which to avoid. We take allergies seriously.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          }
        ],
        "direction": "ltr"
      }
