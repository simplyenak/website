[
  {
    "id": 28,
    "question": "Can you handle dietary restrictions on a private tour?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "That's one of the main reasons people go private. On a join-in tour we work around what's available, but on a private tour we can build the entire route around your needs. Vegetarian, vegan, gluten-free, halal — we've done it all. Just let us know when you book.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          }
        ],
        "direction": "ltr"
      }
    },
