  {
    "id": 20,
    "question": "What dietary options do you accommodate?",
    "answer": {
      "en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "We accommodate vegetarian, halal, vegan, gluten-free, and most dietary needs. Just let us know when you book. Our guides work with each food stall to ensure your meal is prepared correctly.",
                  "type": "text",
                  "style": "",
                  "format": 0,
                  "version": 1
                }
              ],
              "textStyle": ""
            }
          ],
          "direction": null
        }
      }
