  {
    "id": 26,
    "question": "Can we change the route on a private tour?",
    "answer": {
      "en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Once you book, your guide will reach out before the day to discuss preferences. Want more street food? Less walking? A specific dish you're dying to try? We'll adjust.",
                  "type": "text",
                  "style": "",
                  "format": 0,
                  "version": 1
                }
              ],
              "textStyle": ""
            }
          ],
          "direction": null
        }
      }
