  {
    "id": 27,
    "question": "How far ahead should we book a private tour?",
    "answer": {
      "en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "A week ahead is comfortable, two is better. We've pulled tours together in 48 hours before, but the more notice we have, the better we can tailor the experience.",
                  "type": "text",
                  "style": "",
                  "format": 0,
                  "version": 1
                }
              ],
              "textStyle": ""
            }
          ],
          "direction": null
        }
      }
