    "_status": "draft"
  },
  {
    "id": 23,
    "question": "Can I book a private tour?",
    "answer": {
      "en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Yes. Private tours are available for groups, families, and corporate events. Contact us for pricing and availability. Private tours give you flexibility on timing, route, and pace.",
                  "type": "text",
                  "style": "",
                  "format": 0,
                  "version": 1
                }
              ],
              "textStyle": ""
            }
          ],
          "direction": null
        }
