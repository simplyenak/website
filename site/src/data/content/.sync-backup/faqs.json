  {
    "id": 24,
    "question": "Is a private tour worth the extra cost?",
    "answer": {
      "en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "That depends on what you're after. If you want to move at your own pace, have the guide all to yourselves, customise the route, or need specific dietary accommodation, a private tour is absolutely worth it.",
                  "type": "text",
                  "style": "",
                  "format": 0,
                  "version": 1
                }
              ],
              "textStyle": ""
            }
          ],
          "direction": null
        }
      }
    },
