  {
    "id": 21,
    "question": "Is the food spicy?",
    "answer": {
      "en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Malaysian food has heat, but your guide will help navigate spice levels. Mild options are always available and we'll warn you before anything particularly spicy arrives.",
                  "type": "text",
                  "style": "",
                  "format": 0,
                  "version": 1
                }
              ],
              "textStyle": ""
            }
          ],
          "direction": null
        }
