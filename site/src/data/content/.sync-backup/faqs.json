  {
    "id": 22,
    "question": "What happens if it rains?",
    "answer": {
      "en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Tours run rain or shine. Many food stops have covered seating. In extreme weather we'll adjust the route to include more sheltered spots — but a bit of rain has never stopped a Malaysian from eating.",
                  "type": "text",
                  "style": "",
                  "format": 0,
                  "version": 1
                }
              ],
              "textStyle": ""
            }
          ],
          "direction": null
        }
      }
