---
// Cookie consent banner — GDPR compliant.
// Stores consent in localStorage. Fires custom event 'cookieConsent:accepted'
// so Analytics.astro can gate GA4 initialization on consent.
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[2000] bg-[#1a1a1a] border-t border-white/10 shadow-[0_-4px_24px_rgba(0,0,0,0.15)] px-4 py-4 hidden"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <div class="flex items-start gap-3 flex-1">
      <span class="text-accent text-xl leading-none mt-0.5" aria-hidden="true">🍪</span>
      <p class="text-sm text-white/80 leading-relaxed">
        We use cookies to improve your experience and understand how you use our site.
        <a href="/privacy" class="text-accent underline hover:text-[#e8922e] transition-colors">Learn more</a>.
      </p>
    </div>
    <div class="flex gap-3 flex-shrink-0 self-end sm:self-center">
      <button
        id="cookie-decline"
        class="text-sm text-white/50 hover:text-white/80 border border-white/20 px-4 py-2 rounded-lg hover:border-white/40 transition-all cursor-pointer"
      >
        Decline
      </button>
      <button
        id="cookie-accept"
        class="text-sm font-semibold bg-accent text-black px-5 py-2 rounded-lg hover:bg-[#e8922e] transition-colors cursor-pointer"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'se_cookie_consent';

  function initBanner() {
    const consent = localStorage.getItem(CONSENT_KEY);
    if (consent) return;

    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');
    if (!banner) return;

    // Show after brief delay so it doesn't flash on first paint
    setTimeout(() => {
      banner.classList.remove('hidden');
      document.body.classList.add('cookie-banner-visible');
    }, 800);

    function hideBanner() {
      banner!.classList.add('hidden');
      document.body.classList.remove('cookie-banner-visible');
    }

    acceptBtn?.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'accepted');
      hideBanner();
      document.dispatchEvent(new Event('cookieConsent:accepted'));
    });

    declineBtn?.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'declined');
      hideBanner();
      document.dispatchEvent(new Event('cookieConsent:declined'));
    });
  }

  document.addEventListener('DOMContentLoaded', initBanner);
  document.addEventListener('astro:after-swap', initBanner);
</script>
