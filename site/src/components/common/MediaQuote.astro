---
interface Props {
  quote: string;
  person: string;
  role: string;
  outlet: string;
  outletUrl: string;
  imageUrl?: string;
}

const { quote, person, role, outlet, outletUrl, imageUrl } = Astro.props;
const imgSrc = imageUrl || "https://se-website-images.s3.nl-ams.scw.cloud/payload-media/pauline-founder-portrait.jpg";
---

<div class="flex gap-4 p-5 rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm hover:shadow-md transition-all">
  <div class="flex-shrink-0">
    <img
      src={imgSrc}
      alt={person}
      class="w-12 h-12 rounded-full object-cover ring-2 ring-primary/20"
      loading="lazy"
    />
  </div>
  <div class="flex-1 min-w-0">
    <blockquote class="text-sm text-default leading-relaxed italic">
      " {quote} "
    </blockquote>
    <div class="mt-3 flex items-center gap-2 text-xs text-muted">
      <span class="font-semibold text-default not-italic">{person}</span>
      <span aria-hidden="true">·</span>
      <a href={outletUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors not-italic underline underline-offset-2 decoration-dotted">
        {outlet}
      </a>
    </div>
  </div>
</div>
