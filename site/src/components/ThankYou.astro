---
interface Step {
  title: string;
  description: string;
}

interface Button {
  title: string;
  href: string;
}

interface Props {
  title: string;
  subtitle: string;
  paragraphs: string[];
  nextSteps: Step[];
  ctaText: string;
  buttons: Button[];
}

const { title, subtitle, paragraphs, nextSteps, ctaText, buttons } = Astro.props;
---

<section class="min-h-[70vh] flex items-center bg-white dark:bg-[#1e1c1c]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center py-20">
    <!-- Checkmark -->
    <div class="w-20 h-20 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-8">
      <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-4">{subtitle}</p>
    <h1 class="text-3xl md:text-4xl font-bold font-heading text-default mb-6 leading-tight">
      {title}
    </h1>

    {paragraphs.map((p) => (
      <p class="text-muted text-lg mb-4 max-w-lg mx-auto">{p}</p>
    ))}

    <!-- What happens next -->
    <div class="bg-gray-50 dark:bg-[#151313] rounded-xl p-8 mb-8 text-left max-w-lg mx-auto border border-gray-100 dark:border-white/10 mt-8">
      <p class="text-xs text-accent font-bold uppercase tracking-wider mb-4">What happens next</p>
      <div class="space-y-4">
        {nextSteps.map((step, index) => (
          <div class="flex items-start gap-3">
            <div class="w-7 h-7 rounded-full bg-accent/10 flex items-center justify-center text-xs font-bold text-accent flex-shrink-0 mt-0.5">{index + 1}</div>
            <div>
              <p class="text-sm font-semibold text-default">{step.title}</p>
              <p class="text-xs text-muted">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <p class="text-lg font-semibold text-default mb-6">{ctaText}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
      {buttons.map((btn, i) => (
        i === 0
          ? <a href={btn.href} class="inline-flex items-center justify-center gap-2 bg-accent text-black font-bold px-8 py-4 rounded hover:bg-[#e8922e] transition-colors text-sm shadow-lg">
              {btn.title}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          : <a href={btn.href} class="inline-flex items-center justify-center gap-2 border-2 border-gray-200 dark:border-white/20 text-default font-bold px-8 py-4 rounded hover:bg-gray-50 dark:hover:bg-white/5 transition-all text-sm">
              {btn.title}
            </a>
      ))}
    </div>

    <!-- Contact footer -->
    <div class="border-t border-gray-100 dark:border-white/10 pt-6 max-w-sm mx-auto">
      <p class="text-xs text-muted mb-2">Something urgent?</p>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm">
        <a href="https://wa.me/60172878929" target="_blank" class="inline-flex items-center justify-center gap-1.5 text-accent font-semibold hover:underline">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          WhatsApp +60 17-287 8929
        </a>
        <span class="text-gray-300 dark:text-gray-600">|</span>
        <a href="/contact" class="text-accent font-semibold hover:underline">Send Another Message</a>
      </div>
    </div>
  </div>
</section>
