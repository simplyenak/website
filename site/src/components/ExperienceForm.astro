/**
 * Experience Note Submission Form
 * 
 * A simple form for guides to submit first-hand insights after tours.
 * Submitted notes go directly to Payload CMS.
 * 
 * Usage: Add this component to your site or deploy as a standalone page.
 */

import { Icon } from 'astro-icon/components';

interface FormData {
  title: string;
  location: string;
  noteType: string;
  dishes: Array<{ name: string; price: string; vendor: string; notes: string }>;
  vendors: Array<{ name: string; type: string; address: string; ownerName: string; yearsRunning: string; signatureDish: string; story: string; tips: string }>;
  sensoryDetails: Array<{ detail: string; category: string }>;
  surprises: string;
  recommendations: Array<{ tip: string; priority: string }>;
  bestTime: string;
  priceRange: string;
  rawNote: string;
  email: string;
  guideName: string;
}

const NOTE_TYPES = [
  { value: 'tour_debrief', label: 'Tour Debrief', desc: 'Insights from a guided tour' },
  { value: 'vendor_discovery', label: 'Vendor Discovery', desc: 'New vendor or stall found' },
  { value: 'location_scout', label: 'Location Scout', desc: 'Researching a new area' },
  { value: 'seasonal_update', label: 'Seasonal Update', desc: 'Changes to vendors, hours, prices' },
