---
/**
 * LandingPageSections.astro — Conversion-focused landing page
 * 
 * Story arc (PAS + StoryBrand + AIDA integrated):
 * 1. Hero — Name the problem + bold hook (PAS start)
 * 2. Problem/Agitate — Short pain-point acknowledgement (PAS)
 * 3. Tours — The solution, shown immediately (PAS solution + AIDA desire)
 * 4. How It Works — 3 steps, builds confidence (StoryBrand plan)
 * 5. People/Places/Stories — Why we're the right guide (StoryBrand guide)
 * 6. Guide link — Deeper dive for the interested
 * 7. Social proof — Reviews (AIDA desire reinforcement)
 * 8. CTA — Urgency + risk reversal (AIDA action)
 */
import { getImageUrl } from '~/lib/content';

interface Props {
  segment: any;
  landingPage: any;
  matchingTours: any[];
  featuredReviews: any[];
  segmentType: 'dietary' | 'specialty' | 'location' | 'travel_type';
  allSegments: any[];
}

const { segment, landingPage, matchingTours, featuredReviews, segmentType, allSegments } = Astro.props;
const intro = landingPage?.hero_description || landingPage?.introduction || segment.description || '';
const tourCount = matchingTours.length;

// Fetch guide story for the visual guide card
const guideSlug = (landingPage?.guide_slug || '').replace(/--+/g, '-');

let guideStory: any = null;
if (guideSlug) {
  try {
    const { getStoryBySlug } = await import('~/lib/content');
    guideStory = await getStoryBySlug(guideSlug);
  } catch {}
}

const segmentPaths: Record<string, string> = {
  dietary: '/tours/dietary/', specialty: '/tours/specialty/',
  location: '/tours/locations/', travel_type: '/tours/segments/',
};
const segmentPath = segmentPaths[segmentType] || '/tours/';
const segmentLabel = { dietary: 'Dietary', specialty: 'Experience', location: 'Location', travel_type: 'Travel Style' }[segmentType] || '';

const bgImages = [
  'https://cdn.simplyenak.com/Flavours_of_Malaysia001_41094a74f7.jpg',
  'https://cdn.simplyenak.com/kuala_lumpur_street_food_cd4fad4122.jpg',
  'https://cdn.simplyenak.com/Eat_Drink_Georgetown1_72aaaf12b6.jpg',
  'https://cdn.simplyenak.com/secrets_of_KL_Nightlife_Tour002_294155fa7e.jpg',
];
const heroBg = landingPage?.heroImage || landingPage?.hero_image || bgImages[Math.floor(Math.random() * bgImages.length)];
const heroBgAlt = landingPage?.heroImageAlt || landingPage?.hero_image_alt || '';

// Story hooks — PAS problem + bold hook, per segment type
const getHook = () => {
  const name = segment.name || 'this';
  const first = (segment.slug || '').split('-')[0];
  const hooks: Record<string, string> = {
    location: `Most visitors to ${name} leave thinking they've experienced Malaysian food. They haven't. Real ${name} tastes like a charcoal wok at midnight, a curry that has been simmering since dawn, and a kuih lady who remembers your order from last time.`,
    dietary: `You've been burned by places that claim to be ${name.toLowerCase()} but really aren't. In Kuala Lumpur, the good news is this: finding food you can actually trust is easier than you think. You just need to know which stalls to walk into.`,
    specialty: `You don't want the tourist version of ${name.toLowerCase()}. You want the real thing — where locals queue, where the wok hasn't stopped moving in 40 years. Here, ${name.toLowerCase()} is not a tourist activity. It is how the city feeds itself.`,
    travel_type: `Finding the right food tour for ${name.toLowerCase()} shouldn't mean compromising. Whether you want a private experience or a shared table, here's what actually works.`,
  };
  // Specific segment hooks override the generic type
  if (first === 'halal') return `Finding food you can trust in a foreign city is exhausting. You ask, they nod, but you're never 100% sure. What if you didn't have to ask? What if every single bite was verified before you arrived?`;
  if (first === 'vegetarian') return `You're tired of tours where 'vegetarian options' means a sad plate of vegetables while everyone else eats the real meal. What if you could eat every single dish on the tour — and never worry about what's in it?`;
  if (first === 'vegan') return `Vegan-friendly in Southeast Asia usually means a fruit platter and a lot of white rice. But what if it meant the same full meal everyone else is eating — just made entirely from plants?`;
  if (first === 'gluten') return `Everyone warns you about gluten in Asia. Soy sauce, noodles, hidden wheat. But here's the secret: Malaysia's best food was never made with wheat. You've been avoiding the wrong things.`;
  if (first === 'kuala') return `Most visitors to Kuala Lumpur eat in the same few tourist spots and leave thinking they've seen the city. They haven't. Real KL lives in alleyways no guidebook sends you to — and that's where we'll take you.`;
  if (first === 'penang') return `Penang has the best street food in Asia — but finding the right stalls without a local means queuing at tourist traps while the real gems stay hidden. We know exactly who does what dish best.`;
  if (first === 'ipoh') return `Most travellers skip Ipoh. That's their loss. This is where Malaysian Chinese food tastes the way it did 50 years ago — before shortcuts, before compromise, before tourism changed everything.`;
  if (first === 'melaka') return `Melaka created the world's first fusion cuisine 600 years ago. But most visitors only scratch the surface — eating at the same Jonker Street stalls everyone goes to. The real Melaka is hiding in plain sight.`;
  return hooks[segmentType] || `This is what ${name} looks like with a local who knows where to go.`;
};

// Problem/Agitate — segment-specific pain point
const getProblem = () => {
  const first = (segment.slug || '').split('-')[0];
  const probs: Record<string, { title: string; desc: string }> = {
    halal: { title: "The 'Is this halal?' problem", desc: "You spend half your meal asking questions instead of enjoying the food. One stall says yes, another says mostly. You end up at a chain restaurant because at least that's safe. You didn't travel across the world to eat at a chain." },
    vegetarian: { title: 'The sad side-dish problem', desc: 'Tour food tours don\'t cater to vegetarians. You get one option while everyone else eats properly. So you either settle for less or spend your trip policing what goes into your mouth. Neither is a vacation.' },
    vegan: { title: "The 'vegan-friendly' trap", desc: "'Vegan-friendly' in Southeast Asia can mean anything from a fruit platter to something cooked in shrimp paste with a leaf of lettuce on top. You can't relax when you're not sure. So you stick to what's safe and miss the real experience." },
    gluten: { title: 'The gluten anxiety', desc: 'Everyone told you Asia would be hard for gluten-free. Soy sauce, noodles, hidden wheat in everything. So you walk into every meal on guard, asking questions, reading labels, never fully relaxing. You deserve better than that on vacation.' },
    kuala: { title: 'The tourist trap problem', desc: "KL's tourist areas are full of food that looks Malaysian but was designed for tourists. The real city — where locals have eaten for generations — is hiding in neighborhoods most visitors never find. Without a guide, you'll walk right past it." },
    penang: { title: 'The paralysis of choice', desc: "Penang has hundreds of hawker stalls. The famous ones have long queues and inflated prices. The real gems don't advertise. Without a local, you'll pick based on Instagram likes and miss what makes Penang actually special." },
    ipoh: { title: 'The overlooked city', desc: "Ipoh isn't on most tourist itineraries, which means most visitors miss the most intact traditional food scene in Malaysia. The city that invented white coffee, where Hakka recipes have survived unchanged for generations — it's right here, waiting." },
    melaka: { title: 'The surface-level visit', desc: "Melaka's history draws millions, but most visitors eat at the same tourist-oriented restaurants on Jonker Street. The Peranakan (Nyonya) cooks who created the world's first fusion cuisine are still here, cooking recipes from the 1400s. You just need to know where." },
  };
  return probs[first] || null;
};

// The landing page content (short intro from Payload)
const pageContent = landingPage?.content || '';
const introHeading = landingPage?.intro_heading || '';
const guideLinkText = landingPage?.guide_link_text || 'Read the full guide';
const ctaText = landingPage?.cta_text || 'Browse tours';

// People, Places, Stories — segment-specific sales pitch
const getPeoplePlacesStories = () => {
  const name = segment.name || 'this experience';
  const first = (segment.slug || '').split('-')[0]; // e.g. 'halal', 'vegetarian', 'kuala'

  // Specific pitches keyed by the segment's first slug word
  const specific: Record<string, { people: string; places: string; stories: string }> = {
    halal: {
      people: "The hawkers and cooks who make Malaysian halal food so good that locals queue for it. From Malay nasi campur veterans to the Chinese Muslim restaurants serving halal versions of classic dishes — every stall we visit is personally vetted so you never have to ask. You can trust every bite, and that changes how you eat.",
      places: "Kampung Baru's hidden Malay supper spots, the Chinese Muslim eateries where halal Char Siu is an art form, and the night markets where everything is naturally halal. The places tourists don't know exist — but where every local Muslim foodie goes.",
      stories: "Islam arrived in Malaysia with traders from the Middle East and India over 600 years ago. It didn't replace the food culture — it shaped it. Malay food is naturally halal by definition, but the real story is how Chinese, Indian, and Malay cuisines each found their own way to stay halal while keeping their soul.",
    },
    vegetarian: {
      people: "The stall owners who understand vegetarian cooking isn't about what they leave out — it's about what they put in. From the Indian banana leaf aunties who've been serving lunch for 40 years to the Buddhist temple chefs who've perfected the art of mock meats, these cooks make vegetables sing.",
      places: "Brickfields' legendary banana leaf row where you can eat a dozen vegetarian dishes on a single leaf. The temple kitchens serving vegetarian zhai that tastes nothing like 'health food.' And the Indian Muslim stalls that have been making perfect roti canai with coconut milk all along.",
      stories: "KL's vegetarian traditions span centuries. Buddhist monastic cooking brought plant-based eating to China centuries ago, and Chinese immigrants brought it here. Tamil Hindu culinary heritage means some of the best vegetarian food in Malaysia comes from Indian-Muslim hawkers. Three traditions, one city, infinite options.",
    },
    vegan: {
      people: "The vendors who prove vegan food in Malaysia is anything but limited. We've found the stalls that use coconut milk instead of dairy, palm sugar instead of honey, and vegetables so fresh they don't need to hide behind butter. These cooks understand that vegan means delicious first, plant-based second.",
      places: "The Buddhist zhai kitchens where vegan cooking has been perfected over centuries — no dairy, no eggs, just pure plant-based flavor. Indian banana leaf joints serving coconut-milk curries that happen to be completely vegan. And the night market stalls where you'll find snacks you thought you'd never eat again.",
      stories: "Malaysia's vegan tradition runs deep — Buddhist monastic diets have been entirely plant-based for over a thousand years. When Chinese Buddhist immigrants arrived, they brought a cuisine that was already 100% vegan, using tofu, gluten, and vegetable proteins in ways most Western vegan food still hasn't caught up with.",
    },
    gluten: {
      people: "The hawkers who understand that gluten-free isn't a trend here — it's the original recipe. Rice, rice noodles, rice flour. These cooks have been making food that happens to be gluten-free for generations, using ingredients that are naturally safe. We vet every stall personally so you don't have to worry.",
      places: "The rice noodle stalls where fresh-made hor fun and kway teow are the foundation of the cuisine. The nasi lemak vendors serving coconut rice that's naturally safe. The satay stalls grilling over charcoal with sauces made from scratch. Malaysia's best food is already gluten-free — you just need to know where.",
      stories: "Rice is the soul of Malaysian food, and rice has no gluten. While Western cuisine leans on wheat, Malaysia built its food culture around rice noodles, rice flour, and coconut. The cooks here don't adapt recipes to be gluten-free — they've been cooking this way all along.",
    },
    kuala: {
      people: "The third-generation hawkers who've been feeding KL's neighborhoods since before the Petronas Towers existed. The roti canai masters who've flipped dough for 40+ years. The kopitiam uncles who remember when this was a tin-mining town. These aren't just cooks — they're KL's living culinary archive.",
      places: "Hidden alleyways in Chow Kit where the best curry laksa waits. The bustling market stalls of Pudu where families have shopped for three generations. Streets around Masjid India that transform at night into an open-air feast. The places no guidebook sends you — because they don't need to.",
      stories: "KL's food tells the story of Malaysia itself. Chinese immigrants who built kopitiam culture around strong coffee and kaya toast. Indian-Muslim traders who brought banana leaf rice and roti canai. Malay villagers who carried their nasi lemak recipes from kampungs to the city. Three cultures, one table, 150 years of history in every bite.",
    },
    penang: {
      people: "The hawkers who've made Penang the street food capital of Asia. These aren't restaurant chefs — they're stallholders who've dedicated their lives to a single dish, often working the same spot for 30+ years. Every bowl of Char Koay Teow tells you something about the person who cooked it.",
      places: "George Town's heritage streets where the best hawker stalls hide behind century-old shophouses. The air-conditioned kopitiams where Hokkien families gather. The night markets along Gurney Drive. And the quiet neighborhood stalls where locals eat — the ones that never make it to any 'best of' list.",
      stories: "Penang's food is the story of the Straits — where Chinese traders, Malay royalty, and European colonizers created a culture that's unlike anywhere else. Penang was the first British settlement in Southeast Asia, and its food reflects every wave of migration that followed. It's not just street food — it's 200 years of history on a plate.",
    },
    ipoh: {
      people: "The coffee masters who've been roasting Ipoh's famous white coffee since before Malaysia existed. The Hakka families who brought their distinctive cuisine and never left. The hawkers who still cook the same way their grandparents did — because if it isn't broken, don't fix it.",
      places: "The old-town coffee shops where Ipoh's white coffee culture was born. The Hakka eateries serving dishes you can't find anywhere else. The quiet neighborhoods where the best curry mee hides in plain sight. Ipoh's food doesn't shout — it doesn't need to.",
      stories: "Ipoh was once the richest city in Malaysia, built on tin mining. That wealth attracted migrants from southern China, especially the Hakka, who brought a cuisine that's survived almost unchanged. Ipoh's food is a time capsule — what Malaysian Chinese food tasted like before globalization.",
    },
    melaka: {
      people: "The Peranakan (Straits Chinese) cooks who created one of the world's first fusion cuisines — and have been perfecting it for 600 years. The Malay-Muslim hawkers serving dishes that trace back to Portuguese colonizers. The Portuguese-Eurasian families who still cook recipes from the 1500s.",
      places: "Jonker Street's heritage shophouses where Nyonya cooking reigns. The Portuguese Settlement where Eurasian descendants still make their traditional devil's curry. The Malay kampungs serving food that's pure Peranakan-Malay — a mix that only exists in Melaka.",
      stories: "Melaka's food is the original fusion. When Chinese traders married Malay women in the 1400s, they created Peranakan (Nyonya) cuisine — a blend of Chinese techniques with Malay ingredients. Then came the Portuguese in 1511, then the Dutch, then the British. Every colonizer left something on the plate.",
    },
  };

  // Type-based fallbacks
  const typeFallback: Record<string, { people: string; places: string; stories: string }> = {
    location: {
      people: `Family-run stalls that have been feeding their neighborhoods for decades. ${name}'s hawkers take pride in recipes passed down through generations — and our guides personally know the stories behind each one.`,
      places: `Hidden alleyways, bustling markets, and streets that transform at night. The best food in ${name} lives where the locals eat — not where the guidebooks send you.`,
      stories: `${name}'s food tells the story of migration, trade, and community — Chinese kopitiams, Indian banana leaf joints, Malay warungs. Every dish carries a history.`,
    },
    dietary: {
      people: `Stall owners who understand ${name.toLowerCase()} cooking aren't just accommodating — they're specialists. We personally vet every vendor so you can eat with complete confidence.`,
      places: `From temple kitchens to dedicated hawker stalls that genuinely get it right, we know exactly where to find food that meets your needs without compromising on taste.`,
      stories: `Dietary traditions in Malaysia go back centuries — shaped by temple diets, religious practices, and immigrant communities who adapted their food to new ingredients without losing their identity.`,
    },
    specialty: {
      people: `Hawkers who have spent 40+ years perfecting a single dish. They don't just cook — they're the guardians of a craft, and their wok is the canvas.`,
      places: `The most atmospheric spots where ${name.toLowerCase()} culture thrives — from pre-dawn wet markets to midnight alleyways buzzing with charcoal fires and the clatter of woks.`,
      stories: `Every dish has a migration story. Hokkien mee from Fujian, satay from Java, roti canai from India — modified, improved, made Malaysian. That's the story on every plate.`,
    },
    travel_type: {
      people: `Our guides are natural hosts who tailor every stop to your group — keeping curious minds engaged and making sure everyone feels welcome at the table.`,
      places: `Spots with seating, space, and the right atmosphere for your group to connect over great food — no stressful queues, no surprises, just the memories you came for.`,
      stories: `Tales of migration, trade, and tradition that make food come alive. Each stop on your tour comes with a story that connects your group to Malaysia's rich cultural tapestry.`,
    },
  };

  // Try specific first, fall back to type-based
  const s = specific[first];
  const f = typeFallback[segmentType] || typeFallback.location;
  return {
    people: { title: 'The People', desc: s?.people || f.people },
    places: { title: 'The Places', desc: s?.places || f.places },
    stories: { title: 'The Stories', desc: s?.stories || f.stories },
  };
};

const pitch = getPeoplePlacesStories();

// Gallery images from Payload or CDN fallback
const galleryImages = (landingPage?.images || []).filter((img: any) => img.position !== 'hero')
  .map((img: any) => ({
    url: typeof img.image === 'object' ? img.image?.url : img.image,
    alt: img.alt || '', caption: img.caption || '',
  })).filter((img: any) => img.url);

const cdnFallbackImages = [
  { url: 'https://cdn.simplyenak.com/Flavours_of_Malaysia001_41094a74f7.jpg', alt: 'Food tasting on tour', caption: '' },
  { url: 'https://cdn.simplyenak.com/kuala_lumpur_street_food_cd4fad4122.jpg', alt: 'KL street food stall', caption: '' },
  { url: 'https://cdn.simplyenak.com/Eat_Drink_Georgetown1_72aaaf12b6.jpg', alt: 'Local guide explaining dishes', caption: '' },
  { url: 'https://cdn.simplyenak.com/eatdrinkgeorgetown_1_263d654742.jpg', alt: 'Market visit on tour', caption: '' },
];
const displayImages = galleryImages.length > 0 ? galleryImages : cdnFallbackImages.slice(0, 4);

const lowestPrice = tourCount > 0 ? Math.min(...matchingTours.map((t: any) => {
  const p = typeof t.price === 'string' ? parseInt(t.price.replace(/[^0-9]/g, '')) : t.price;
  return p || 999;
})) : 285;
---

<!-- Sticky mobile CTA -->
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 shadow-[0_-4px_20px_rgba(0,0,0,0.1)] md:hidden">
  <div class="flex items-center justify-between px-4 py-3 max-w-lg mx-auto">
    <div>
      <p class="text-xs text-muted">From RM {lowestPrice} MYR/pax</p>
      <p class="text-xs font-semibold">{tourCount} tour{tourCount !== 1 ? 's' : ''} available</p>
    </div>
    <a href="#tours" class="bg-accent text-black font-bold px-6 py-2.5 rounded text-sm hover:bg-accent/90 transition-colors">
      Book Now
    </a>
  </div>
</div>

<!-- 1. HERO — Hook with a bold statement -->
<section class="relative min-h-[60vh] flex items-center bg-[#1a1a1a] text-white overflow-hidden">
  <div class="absolute inset-0">
    <img src={getImageUrl(heroBg)} alt={heroBgAlt} class="w-full h-full object-cover opacity-40" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/65 to-black/90"></div>
  </div>
  <div class="relative w-full max-w-4xl mx-auto px-4 sm:px-6 py-20 md:py-28">
    {segmentLabel && (
      <p class="text-accent/80 text-xs uppercase tracking-[0.25em] font-bold mb-4">{segmentLabel}</p>
    )}
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-heading mb-6 leading-tight">
      {segment.name}
    </h1>
    <p class="text-xl md:text-2xl text-white/85 font-normal font-sans leading-relaxed max-w-2xl mb-8">
      {getHook()}
    </p>
    {intro && (
      <p class="text-white/50 max-w-xl text-sm md:text-base leading-relaxed mb-8">{intro}</p>
    )}
    <div class="flex flex-wrap gap-4">
      <a href="#tours" class="inline-flex items-center gap-2 bg-accent text-black font-bold px-7 py-3.5 rounded hover:bg-[#e8922e] transition-colors text-sm shadow-lg shadow-accent/20">
        {tourCount > 0 ? `${ctaText} (${tourCount})` : ctaText}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 border-2 border-white/20 text-white font-semibold px-7 py-3.5 rounded hover:bg-white/5 transition-colors text-sm">
        Ask a Question
      </a>
    </div>
    {tourCount > 0 && (
      <div class="mt-10 flex items-center gap-6 text-sm text-white/40">
        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg> 5,000+ reviews</span>
        <span>From RM {lowestPrice}/person</span>
        <span>Max 8 guests</span>
      </div>
    )}
  </div>
</section>

<!-- 2. PROBLEM/AGITATE — name the pain before showing the solution -->
{(() => {
  const prob = getProblem();
  if (!prob) return null;
  return <section class="py-14 bg-muted/20 border-y border-gray-100 dark:border-white/5">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">Sound familiar?</p>
      <h2 class="text-2xl md:text-3xl font-bold font-heading mb-4">{prob.title}</h2>
      <p class="text-muted text-base leading-relaxed max-w-2xl mx-auto">{prob.desc}</p>
      <div class="mt-6 flex items-center justify-center gap-2 text-sm">
        <span class="w-8 h-px bg-gray-300 dark:bg-white/20"></span>
        <span class="text-accent font-semibold text-xs uppercase tracking-wider">That's where we come in</span>
        <span class="w-8 h-px bg-gray-300 dark:bg-white/20"></span>
      </div>
    </div>
  </section>;
})()}

<!-- 3. TOURS FIRST — show the solution immediately -->
{tourCount > 0 ? (
  <section class="py-16 bg-white dark:bg-[#1e1c1c]" id="tours">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <h2 class="text-3xl md:text-4xl font-bold font-heading mb-3">
          {tourCount === 1 ? 'The Tour' : `${tourCount} Tours Available`}
        </h2>
        <p class="text-muted text-sm max-w-xl">
          {tourCount === 1
            ? `This is the tour we recommend for ${segment.name}.`
            : `These are the tours that work best for ${segment.name}. Pick one, or ask us which fits your group.`}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {matchingTours.map((tour: any) => (
          <a href={`/tours/${tour.slug}`} class="group block rounded-xl border border-gray-100 dark:border-white/10 bg-card shadow-sm overflow-hidden transition-all hover:shadow-xl hover:-translate-y-1">
            <div class="aspect-[16/10] overflow-hidden relative">
              <img src={tour.image || 'https://cdn.simplyenak.com/Flavours_of_Malaysia001_41094a74f7.jpg'} alt={tour.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
              <div class="absolute bottom-3 left-3 bg-white/90 dark:bg-black/70 backdrop-blur-sm rounded-lg px-3 py-1.5">
                <span class="font-bold text-default text-sm">RM {tour.price}</span>
                <span class="text-xs text-muted">/pax</span>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold font-heading group-hover:text-primary transition-colors">{tour.name}</h3>
              <p class="text-sm text-muted mt-1.5 line-clamp-2 leading-relaxed">{tour.tagline || tour.shortDescription}</p>
              <div class="mt-4 flex items-center gap-3 text-xs text-muted">
                {tour.duration && <span class="flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> {tour.duration}</span>}
                {tour.location && <span class="flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg> {tour.location}</span>}
              </div>
              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                <span class="inline-flex items-center gap-1 text-accent text-xs font-semibold group-hover:gap-2 transition-all">
                  View Details <span>&rarr;</span>
                </span>
                <span class="text-[10px] text-muted">Free cancellation</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Can't decide? Cross-link to quiz or contact -->
