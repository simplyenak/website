---
/**
 * LandingPageSections.astro — Conversion-focused sections for segment landing pages
 *
 * Designed to sell the tour experience first. Short, scannable, action-oriented.
 * Used by dietary/specialty/location/segments templates.
 */
interface Props {
  segment: any;
  landingPage: any;
  matchingTours: any[];
  featuredReviews: any[];
  segmentType: 'dietary' | 'specialty' | 'location' | 'travel_type';
  allSegments: any[];
}

const { segment, landingPage, matchingTours, featuredReviews, segmentType, allSegments } = Astro.props;
const intro = landingPage?.hero_description || landingPage?.introduction || segment.description || '';
const tourCount = matchingTours.length;

// Build segment link path
const segmentPaths: Record<string, string> = {
  dietary: '/tours/dietary/',
  specialty: '/tours/specialty/',
  location: '/tours/locations/',
  travel_type: '/tours/segments/',
};
const segmentPath = segmentPaths[segmentType] || '/tours/';
const segmentLabel = { dietary: 'Dietary', specialty: 'Experience', location: 'Location', travel_type: 'Travel Style' }[segmentType] || '';

// Key features pulled from segment or landing page data
const features = [
  { icon: '🍜', label: `${tourCount} Tour${tourCount !== 1 ? 's' : ''} Available`, desc: `Choose from ${tourCount} hand-picked experience${tourCount !== 1 ? 's' : ''}` },
  { icon: '👤', label: 'Small Groups', desc: 'Max 8 guests per tour — intimate and personal' },
  { icon: '🗓️', label: 'Daily Tours', desc: 'Morning and afternoon slots available' },
  { icon: '💰', label: 'Best Price Guarantee', desc: 'From RM 285 per person, no hidden fees' },
];
---

<!-- Hero -->
<section class="relative bg-[#1a1a1a] text-white overflow-hidden">
  <div class="absolute inset-0">
    {landingPage?.heroImage ? (
      <img src={landingPage.heroImage} alt="" class="w-full h-full object-cover opacity-40" />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-[#2a1a1a] to-[#1a1a1a]"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black/80"></div>
  </div>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
    {segmentLabel && (
      <p class="text-accent/90 text-xs uppercase tracking-[0.2em] font-bold mb-3">{segmentLabel}</p>
    )}
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading mb-4">
      <span class="inline-block bg-accent text-black px-4 py-1 rounded-sm" style="transform:rotate(-0.7deg)">
        {segment.name}
      </span>
      <span class="block text-white/90 text-xl md:text-2xl mt-3 font-normal font-sans">
        {segment.heroSubtitle || landingPage?.heroSubtitle || `Food Tours`}
      </span>
    </h1>
    <p class="text-white/70 max-w-2xl mx-auto text-sm md:text-base">
      {intro}
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="#tours" class="btn-primary inline-flex items-center gap-2">
        Browse Tours
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </a>
      <a href="/contact" class="btn-secondary inline-flex items-center gap-2">
        Ask a Question
      </a>
    </div>
  </div>
</section>

<!-- Key features / selling points -->
<section class="py-12 bg-white dark:bg-[#1e1c1c] border-b border-gray-100 dark:border-white/10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {features.map((f) => (
        <div class="text-center">
          <span class="text-3xl block mb-2">{f.icon}</span>
          <h3 class="text-sm font-bold font-heading">{f.label}</h3>
          <p class="text-xs text-muted mt-1">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Tour cards (main conversion section) -->
<section class="py-16 bg-muted/30" id="tours">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold font-heading">{segment.name} Tours in Malaysia</h2>
      <p class="text-muted max-w-2xl mx-auto mt-3">Small-group walking food tours through neighbourhoods where locals actually eat</p>
    </div>

    {matchingTours.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {matchingTours.map((tour: any) => (
          <a href={`/tours/${tour.slug}`} class="group block rounded-xl border bg-card shadow-sm overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1">
            {tour.image && (
              <div class="aspect-[16/9] overflow-hidden">
                <img src={tour.image} alt={tour.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              </div>
            )}
            <div class="p-5">
              <h3 class="text-lg font-bold font-heading group-hover:text-primary">{tour.name}</h3>
              <p class="text-sm text-muted mt-1 line-clamp-2">{tour.tagline || tour.shortDescription}</p>
              <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
                <span class="font-semibold">RM {tour.price}</span>
                {tour.duration && <span>&middot; {tour.duration}</span>}
              </div>
              <div class="mt-3">
                <span class="inline-block text-accent text-xs font-semibold group-hover:underline">View Tour &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center">
        <p class="text-muted mb-4">No specific tours found for this category.</p>
        <a href="/tours" class="inline-block bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors text-sm">
          Browse All Tours
        </a>
      </div>
    )}
  </div>
</section>

<!-- Guest reviews -->
{featuredReviews.length > 0 && (
  <section class="py-16 bg-gradient-to-b from-transparent to-muted/20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-3">What Guests Say</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">Real Reviews from Real Guests</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featuredReviews.slice(0, 6).map((r: any) => (
          <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col">
            <div class="flex items-center gap-1 mb-3">
              {Array.from({ length: r.rating || 5 }).map(() => (
                <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-sm text-muted italic flex-grow">&ldquo;{(r.text || '').length > 150 ? (r.text || '').slice(0, 150) + '&hellip;' : (r.text || '')}&rdquo;</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/10">
              <p class="text-sm font-semibold">{r.author || 'Guest'}</p>
              {r.location && <p class="text-xs text-muted">via {r.location}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- FAQ -->
{landingPage?.content && (
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl font-bold font-heading mb-4">Frequently Asked Questions</h2>
      <p class="text-muted mb-8">Everything you need to know about {segment.name.toLowerCase()} tours</p>
      <a href="/faq" class="text-accent font-semibold text-sm hover:underline">View all FAQs &rarr;</a>
    </div>
  </section>
)}

<!-- Final CTA -->
<section class="py-16 bg-accent/5 border-t border-gray-100 dark:border-white/10">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold font-heading mb-4">Ready to Experience {segment.name} Tours?</h2>
    <p class="text-muted text-lg mb-8">Book your spot today. Small groups, local guides, unforgettable meals.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="#tours" class="bg-accent text-black font-bold px-8 py-3 rounded hover:bg-accent/90 transition-colors">
        Book a Tour
      </a>
      <a href="/contact" class="border-2 border-gray-300 dark:border-white/20 text-default font-bold px-8 py-3 rounded hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
        Contact Us
      </a>
    </div>
  </div>
</section>

<!-- Explore more -->
{allSegments.length > 1 && (
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h3 class="text-lg font-bold font-heading mb-6">Explore More Options</h3>
      <div class="flex flex-wrap gap-3 justify-center">
        {allSegments.filter((s: any) => s.slug !== segment.slug).slice(0, 12).map((s: any) => (
          <a href={`${segmentPath}${s.slug}`}
             class="chip inline-block border-2 border-gray-300 dark:border-white/20 rounded-full px-5 py-2 text-sm font-semibold text-default hover:bg-primary hover:border-primary hover:text-white transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
            {s.name}
          </a>
        ))}
      </div>
    </div>
  </section>
)}
