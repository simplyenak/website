---
/**
 * LandingPageSections.astro — Premium, visually-rich landing page
 */
interface Props {
  segment: any;
  landingPage: any;
  matchingTours: any[];
  featuredReviews: any[];
  segmentType: 'dietary' | 'specialty' | 'location' | 'travel_type';
  allSegments: any[];
}

const { segment, landingPage, matchingTours, featuredReviews, segmentType, allSegments } = Astro.props;
const intro = landingPage?.hero_description || landingPage?.introduction || segment.description || '';
const tourCount = matchingTours.length;

const segmentPaths: Record<string, string> = {
  dietary: '/tours/dietary/', specialty: '/tours/specialty/',
  location: '/tours/locations/', travel_type: '/tours/segments/',
};
const segmentPath = segmentPaths[segmentType] || '/tours/';
const segmentLabel = { dietary: 'Dietary', specialty: 'Experience', location: 'Location', travel_type: 'Travel Style' }[segmentType] || '';

const bgImages = [
  'https://cdn.simplyenak.com/Flavours_of_Malaysia001_41094a74f7.jpg',
  'https://cdn.simplyenak.com/kuala_lumpur_street_food_cd4fad4122.jpg',
  'https://cdn.simplyenak.com/Eat_Drink_Georgetown1_72aaaf12b6.jpg',
  'https://cdn.simplyenak.com/secrets_of_KL_Nightlife_Tour002_294155fa7e.jpg',
];
const heroBg = landingPage?.heroImage || bgImages[Math.floor(Math.random() * bgImages.length)];

// Segment-specific key features
const getFeatures = () => {
  const base = [
    { icon: '👤', label: 'Small Groups', desc: 'Max 8 guests, personal guide' },
    { icon: '⭐', label: '5-Star Rated', desc: '5000+ reviews on Google & TA' },
    { icon: '💰', label: tourCount > 0 ? `From RM ${matchingTours[0]?.price || 285}` : 'From RM 285', desc: 'All tastings included' },
  ];
  const segFeatures: Record<string, { icon: string; label: string; desc: string }[]> = {
    dietary: [{ icon: '🥗', label: 'Dietary-Friendly', desc: 'Stalls vetted for your needs' }, ...base],
    specialty: [{ icon: '🍜', label: 'Curated Routes', desc: 'Hand-picked stalls by our guides' }, ...base],
    location: [{ icon: '📍', label: 'Local Neighbourhoods', desc: 'Areas tourists rarely see' }, ...base],
    travel_type: [{ icon: '👥', label: 'Tailored Experience', desc: 'Matched to your travel style' }, ...base],
  };
  return segFeatures[segmentType] || base;
};

// Gallery images
const galleryImages = (landingPage?.images || []).filter((img: any) => img.position !== 'hero')
  .map((img: any) => ({
    url: typeof img.image === 'object' ? img.image?.url : img.image,
    alt: img.alt || '', caption: img.caption || '',
  })).filter((img: any) => img.url);

const cdnFallbackImages = [
  { url: 'https://cdn.simplyenak.com/Eat_Drink_Georgetown001_7f2c0b4c3f.jpg', alt: 'Food tasting', caption: '' },
  { url: 'https://cdn.simplyenak.com/Kuala_Lumpur_Street_Food001_6fcced575c.jpg', alt: 'Street food', caption: '' },
  { url: 'https://cdn.simplyenak.com/Eat_Drink_Georgetown003_c7b4448cd0.jpg', alt: 'Local guide', caption: '' },
  { url: 'https://cdn.simplyenak.com/Eat_Drink_Georgetown2_1a84f7f151.jpg', alt: 'Hawker stall', caption: '' },
  { url: 'https://cdn.simplyenak.com/eatdrinkgeorgetown_1_263d654742.jpg', alt: 'Market visit', caption: '' },
  { url: 'https://cdn.simplyenak.com/Eat_Drink_Georgetown3_08347c2ca0.jpg', alt: 'Food tour group', caption: '' },
];
const displayImages = galleryImages.length > 0 ? galleryImages : cdnFallbackImages.slice(0, 4);

const polaroidLabels = ['Local Guide', 'Fresh Ingredients', 'Hawker Stall', 'Small Groups'];
const segmentCtaText: Record<string, string> = {
  dietary: 'Book a tour that fits your dietary needs',
  specialty: 'Book a tour crafted around your interests',
  location: 'Explore the neighbourhood with a local',
  travel_type: 'Find the perfect tour for your group',
};
const ctaText = segmentCtaText[segmentType] || 'Book your tour today';
const features = getFeatures();
---

<!-- Sticky mobile CTA -->
<div class="fixed bottom-0 left-0 right-0 z-50 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 shadow-[0_-4px_20px_rgba(0,0,0,0.1)] md:hidden">
  <div class="flex items-center justify-between px-4 py-3 max-w-lg mx-auto">
    <div>
      <p class="text-xs text-muted">From {tourCount > 0 ? `RM ${matchingTours[0]?.price || 285}` : 'RM 285'}/pax</p>
      <p class="text-xs font-semibold">{tourCount} tour{tourCount !== 1 ? 's' : ''} available</p>
    </div>
    <a href="#tours" class="bg-accent text-black font-bold px-6 py-2.5 rounded text-sm hover:bg-accent/90 transition-colors">
      Book Now
    </a>
  </div>
</div>

<!-- Hero -->
<section class="relative min-h-[70vh] flex items-center bg-[#1a1a1a] text-white overflow-hidden">
  <div class="absolute inset-0">
    <img src={heroBg} alt="" class="w-full h-full object-cover opacity-35" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/70 to-black/90"></div>
    <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,163,51,.08) 1px, transparent 1px); background-size: 32px 32px;"></div>
  </div>
  <div class="relative w-full max-w-5xl mx-auto px-4 sm:px-6 py-24 md:py-32 text-center">
    {segmentLabel && (
      <p class="text-accent/80 text-xs uppercase tracking-[0.25em] font-bold mb-4">{segmentLabel}</p>
    )}
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-heading mb-4 leading-tight">
      <span class="inline-block bg-accent text-black px-5 py-2 rounded-sm shadow-lg" style="transform:rotate(-0.5deg); font-size: clamp(1.5rem, 4vw, 2.5rem);">
        {segment.name}
      </span>
      <span class="block text-white/90 text-xl md:text-2xl lg:text-3xl mt-4 font-normal font-sans max-w-3xl mx-auto">
        {segment.heroSubtitle || landingPage?.heroSubtitle || `Food Tours`}
      </span>
    </h1>
    <p class="text-white/60 max-w-2xl mx-auto text-sm md:text-base leading-relaxed">{intro}</p>
    <div class="mt-10 flex justify-center gap-4 flex-wrap">
      <a href="#tours" class="inline-flex items-center gap-2 bg-accent text-black font-bold px-8 py-3.5 rounded hover:bg-[#e8922e] transition-colors text-sm shadow-lg shadow-accent/25">
        Browse Tours
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 border-2 border-white/20 text-white font-semibold px-8 py-3.5 rounded hover:bg-white/5 transition-colors text-sm">
        Ask a Question
      </a>
    </div>
  </div>
</section>

<!-- Image gallery — polaroid cards -->
{displayImages.length > 0 && (
  <section class="py-12 bg-white dark:bg-[#1e1c1c]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="text-center text-accent text-xs uppercase tracking-[0.25em] font-bold mb-8">What to Expect</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {displayImages.slice(0, 4).map((img: any, i: number) => (
          <div class="group" style={{ rotate: i === 0 ? '-1deg' : i === 1 ? '1.5deg' : i === 2 ? '-0.5deg' : '1deg' }}>
            <div class="bg-white dark:bg-gray-800 p-2 rounded-sm shadow-md hover:shadow-xl transition-shadow duration-300">
              <div class="aspect-square overflow-hidden">
                <img src={img.url} alt={img.alt || ''} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="pt-2 pb-1 text-center">
                <p class="text-xs font-semibold text-gray-700 dark:text-gray-300 font-heading">
                  {img.caption || polaroidLabels[i]}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Key features -->
<section class="py-14 bg-white dark:bg-[#1e1c1c] border-y border-gray-100 dark:border-white/5">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {features.map((f) => (
        <div class="text-center group">
          <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-accent/10 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            <span>{f.icon}</span>
          </div>
          <h3 class="text-sm font-bold font-heading">{f.label}</h3>
          <p class="text-xs text-muted mt-1">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- What to Expect — step guide -->
<section class="py-14 bg-muted/20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">How It Works</p>
    <h2 class="text-2xl md:text-3xl font-bold font-heading mb-10">A {segment.name} Tour in 3 Steps</h2>
    <div class="grid md:grid-cols-3 gap-8 text-left">
      <div class="bg-card border rounded-xl p-6 shadow-sm">
        <span class="text-3xl block mb-3">👋</span>
        <h3 class="font-bold font-heading mb-2">Meet Your Guide</h3>
        <p class="text-sm text-muted">Start at a recognisable landmark. Your guide will brief you on the route and answer any questions.</p>
      </div>
      <div class="bg-card border rounded-xl p-6 shadow-sm">
        <span class="text-3xl block mb-3">🍜</span>
        <h3 class="font-bold font-heading mb-2">Walk & Taste</h3>
        <p class="text-sm text-muted">Visit 5-8 family-run stalls. Taste dishes, hear their stories, learn how they're made.</p>
      </div>
      <div class="bg-card border rounded-xl p-6 shadow-sm">
        <span class="text-3xl block mb-3">⭐</span>
        <h3 class="font-bold font-heading mb-2">Finish Satisfied</h3>
        <p class="text-sm text-muted">End with a full stomach, food knowledge, and recommendations for the rest of your trip.</p>
      </div>
    </div>
  </div>
</section>

<!-- Tours -->
<section class="py-16 bg-muted/30" id="tours">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">Choose Your Tour</p>
      <h2 class="text-3xl md:text-4xl font-bold font-heading">{segment.name} Tours</h2>
      <p class="text-muted max-w-xl mx-auto mt-3 text-sm">Small-group walking food tours through real neighbourhoods, led by local guides</p>
    </div>

    {matchingTours.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {matchingTours.map((tour: any) => (
          <a href={`/tours/${tour.slug}`} class="group block rounded-xl border bg-card shadow-sm overflow-hidden transition-all hover:shadow-xl hover:-translate-y-1.5">
            <div class="aspect-[16/10] overflow-hidden relative">
              <img src={tour.image || 'https://cdn.simplyenak.com/Flavours_of_Malaysia001_41094a74f7.jpg'} alt={tour.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
              {segmentType === 'dietary' && (
                <span class="absolute top-3 left-3 bg-green-500 text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wide">{segment.name}-Friendly</span>
              )}
              {segmentType === 'specialty' && (
                <span class="absolute top-3 left-3 bg-accent text-black text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wide">{segment.name}</span>
              )}
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold font-heading group-hover:text-primary transition-colors">{tour.name}</h3>
              <p class="text-sm text-muted mt-1.5 line-clamp-2 leading-relaxed">{tour.tagline || tour.shortDescription}</p>
              <div class="mt-4 flex items-center gap-3 text-xs text-muted">
                <span class="font-bold text-default text-base">RM {tour.price}<span class="text-xs font-normal text-muted">/pax</span></span>
                {tour.duration && <><span class="text-gray-300">|</span><span>{tour.duration}</span></>}
              </div>
              <div class="mt-3 pt-3 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                <span class="inline-flex items-center gap-1 text-accent text-xs font-semibold group-hover:gap-2 transition-all">View Details <span>&rarr;</span></span>
                <span class="text-[10px] text-muted">Free cancellation</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-muted mb-6">No specific tours listed for this category yet.</p>
        <a href="/tours" class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded hover:bg-accent/90 transition-colors text-sm">
          Browse All Tours
        </a>
      </div>
    )}
  </div>
</section>

<!-- Reviews -->
{featuredReviews.length > 0 && (
  <section class="py-16 bg-gradient-to-b from-transparent to-muted/20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <p class="text-accent text-xs uppercase tracking-[0.25em] font-bold mb-3">Guest Reviews</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading">What Our Guests Say</h2>
        <p class="text-muted mt-2 text-sm">Rated 5 stars on Google and TripAdvisor</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featuredReviews.slice(0, 6).map((r: any) => (
          <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col hover:shadow-md transition-shadow">
            <div class="flex items-center gap-1 mb-3">
              {Array.from({ length: r.rating || 5 }).map(() => (
                <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-sm text-muted italic flex-grow leading-relaxed">&ldquo;{(r.text || '').length > 180 ? (r.text || '').slice(0, 180) + '&hellip;' : (r.text || '')}&rdquo;</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/5 flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-accent/15 flex items-center justify-center flex-shrink-0">
                <span class="text-accent text-xs font-bold">{(r.author || 'G')[0]}</span>
              </div>
              <div>
                <p class="text-sm font-semibold">{r.author || 'Guest'}</p>
                {r.location && <p class="text-xs text-muted">{r.location}</p>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- CTA -->
<section class="py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-accent/5 to-primary/5"></div>
  <div class="absolute inset-0" style="background-image: radial-gradient(rgba(181,45,56,.04) 1px, transparent 1px); background-size: 24px 24px;"></div>
  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold font-heading mb-4">Ready for Your {segment.name} Experience?</h2>
    <p class="text-muted text-lg mb-8 max-w-lg mx-auto">{ctaText}</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="#tours" class="bg-accent text-black font-bold px-8 py-3.5 rounded hover:bg-accent/90 transition-colors shadow-lg shadow-accent/20">
        Book a Tour
      </a>
      <a href="/contact" class="border-2 border-gray-300 dark:border-white/20 text-default font-bold px-8 py-3.5 rounded hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
        Contact Us
      </a>
    </div>
  </div>
</section>

<!-- Explore more -->
{allSegments.length > 1 && (
  <section class="py-14 bg-white dark:bg-[#1e1c1c]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h3 class="text-lg font-bold font-heading mb-2">Explore More</h3>
      <p class="text-muted text-sm mb-6">Other popular ways to experience Malaysian food</p>
      <div class="flex flex-wrap gap-3 justify-center">
        {allSegments.filter((s: any) => s.slug !== segment.slug).slice(0, 12).map((s: any) => (
          <a href={`${segmentPath}${s.slug}`}
             class="inline-block border-2 border-gray-200 dark:border-white/10 rounded-full px-5 py-2 text-sm font-semibold text-default hover:bg-primary hover:border-primary hover:text-white transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
            {s.name}
          </a>
        ))}
      </div>
    </div>
  </section>
)}
