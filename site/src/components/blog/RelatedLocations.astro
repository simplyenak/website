---
// RelatedLocations.astro — shows the location page links for a story's
// locationsRef (bidirectional linking: location pages link to stories via
// 'Guides for [City]', stories link back to their location pages here).
import { Icon } from 'astro-icon/components';

export interface Props {
  locationsRef?: any[];
}

const { locationsRef = [] } = Astro.props;

// Normalize location refs (Payload returns objects at depth>0, ids at depth=0)
const locations = (locationsRef || [])
  .map((l: any) => (typeof l === 'object' ? l : null))
  .filter((l: any) => l && l.slug && l.name)
  .map((l: any) => ({ slug: l.slug, name: l.name }))
  .slice(0, 3);
---

{
  locations.length > 0 && (
    <section class="py-16 md:py-20 border-t border-gray-100 dark:border-white/10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <p class="text-accent text-xs uppercase tracking-[0.2em] font-bold mb-2">Places</p>
          <h2 class="text-2xl md:text-3xl font-bold font-heading">Food tours in {locations.map((l) => l.name).join(', ')}</h2>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          {locations.map((l: any) => (
            <a
              href={`/tours/locations/food-tours-${l.slug}/`}
              class="group inline-flex items-center gap-2 px-6 py-3 rounded-full border border-gray-100 dark:border-white/10 bg-card hover:shadow-md hover:border-accent/30 transition-all text-sm font-semibold"
            >
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              {l.name} food tours
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
