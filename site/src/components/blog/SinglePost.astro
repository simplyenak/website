---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const readingTime = Math.max(1, Math.ceil((post.Content?.length || 1000) / 2000));
const siteUrl = 'https://simplyenak.com';
const blogSlug = typeof url === 'string' ? url.replace(siteUrl, '') : (url.pathname || '');
const authorName = post.author || 'Simply Enak';
---

<section class="mx-auto">
  <!-- BlogPosting Schema (Google Discover eligibility) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "image": post.image || "https://cdn.simplyenak.com/simply-enak-og-image.jpg",
    "datePublished": post.publishDate,
    "dateModified": post.updateDate || post.publishDate,
    "author": {
      "@type": "Person",
      "name": authorName,
      "description": post.author ? `${post.author} — food tour guide at Simply Enak` : "Simply Enak food tours team"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Simply Enak",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cdn.simplyenak.com/simply_enak_logo_5e7725db1d.webp"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": siteUrl + blogSlug
    }
  })} />
  <article>
    <!-- Hero with background image -->
    <header class="relative bg-[#1a1a1a] text-white overflow-hidden">
      {post.image && (
        <div class="absolute inset-0">
          <img src={post.image} alt="" class="w-full h-full object-cover opacity-30" loading="eager" />
          <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a1a]/70 via-[#1a1a1a]/85 to-[#1a1a1a]"></div>
        </div>
      )}
      <div class="relative max-w-3xl mx-auto px-4 sm:px-6 py-16 md:py-24">
        <!-- Meta row -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-white/60 mb-4">
          {post.publishDate && (
            <time datetime={String(post.publishDate)}>
              {getFormattedDate(post.publishDate)}
            </time>
          )}
          <span class="text-white/30">·</span>
          <span>{readingTime} min read</span>
          {post.category?.title && (
            <>
              <span class="text-white/30">·</span>
              <a class="hover:text-accent transition-colors" href={getPermalink(post.category.slug, 'category')}>
                {post.category.title}
              </a>
            </>
          )}
        </div>

        <!-- Title -->
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading leading-tight mb-4">
          {post.title}
        </h1>

        <!-- Excerpt -->
        {post.excerpt && (
          <p class="text-lg md:text-xl text-white/70 max-w-2xl leading-relaxed">
            {post.excerpt}
          </p>
        )}

        <!-- Author -->
        {post.author && (
          <div class="flex items-center gap-3 mt-6 pt-6 border-t border-white/10">
            <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center">
              <span class="text-accent font-bold text-sm">{post.author.charAt(0)}</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-white">{post.author}</p>
              <p class="text-xs text-white/50">Simply Enak</p>
            </div>
          </div>
        )}
      </div>
    </header>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <!-- Featured image after hero -->
      {post.image && (
        <div class="-mx-4 sm:mx-0 mb-10">
          <img
            src={post.image}
            alt={post.excerpt || post.title}
            class="w-full rounded-xl shadow-md"
            loading="eager"
          />
        </div>
      )}

      <!-- Article body -->
      <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:text-default prose-headings:leading-tight prose-a:text-primary prose-img:rounded-lg prose-blockquote:border-l-4 prose-blockquote:border-accent prose-blockquote:bg-accent/5 prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-default prose-blockquote:font-medium prose-blockquote:text-lg prose-li:my-1">
        <slot />
      </div>

      <!-- In-article CTA -->
      <div class="my-12 p-6 md:p-8 bg-accent/5 border border-accent/20 rounded-xl">
        <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
          <div class="flex-1">
            <p class="font-bold font-heading text-lg text-default mb-1">Ready to taste these flavours yourself?</p>
            <p class="text-sm text-muted">Join a Simply Enak food tour in Kuala Lumpur or Penang. Small groups, local guides, authentic experiences since 2011.</p>
          </div>
          <a href="/tours" class="inline-flex items-center gap-2 bg-accent text-black font-bold px-6 py-3 rounded-lg hover:bg-accent/90 transition-colors shrink-0 text-sm">
            Browse Tours
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Author bio card -->
      <div class="my-10 p-6 bg-gray-50 dark:bg-[#151313] rounded-xl border border-gray-100 dark:border-white/10">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-full bg-accent/20 flex items-center justify-center shrink-0">
            <span class="text-accent font-bold text-xl">{post.author ? post.author.charAt(0) : 'S'}</span>
          </div>
          <div class="flex-1">
            <p class="font-bold font-heading text-default">{post.author || 'Simply Enak Team'}</p>
            <p class="text-xs text-muted mb-2">Simply Enak Food Experiences</p>
            <p class="text-sm text-muted leading-relaxed">
              {post.author ? `${post.author} has been guiding food tours in Malaysia since 2011, sharing hidden gems and family-run stalls with travellers from around the world.` : 'Simply Enak has been sharing Malaysia\'s food heritage since 2011, leading small-group food tours through Kuala Lumpur, Penang, and beyond.'}
            </p>
            <div class="flex gap-3 mt-3">
              <a href="/about" class="text-xs text-accent font-semibold hover:underline">About Simply Enak →</a>
              <a href="/tours" class="text-xs text-accent font-semibold hover:underline">View our tours →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Tags + Share -->
      <div class="mt-12 pt-8 border-t border-gray-100 dark:border-white/10">
        <div class="flex flex-col sm:flex-row justify-between gap-4">
          <PostTags tags={post.tags} class="mr-5" />
          <SocialShare url={url} text={post.title} class="align-middle text-gray-500 dark:text-slate-600" />
        </div>
      </div>

      <!-- Link Equity Boost — Contextual links to pages that need authority -->
      {(() => {
        let boostData = null;
        try {
          boostData = (await import('~/data/content/link-equity-boost.json')).default;
        } catch {}
        const recs = boostData?.recommendations || [];
        if (recs.length === 0) return null;
        return (
          <div class="mt-8 p-4 bg-gray-50/50 dark:bg-[#151313]/50 rounded-xl border border-gray-100 dark:border-white/10">
            <p class="text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">You might also like</p>
            <div class="flex flex-wrap gap-2">
              {recs.map((r: any) => (
                <a
                  href={r.target_path}
                  class="inline-flex items-center gap-1 px-3 py-1 rounded-full border border-gray-200 dark:border-white/10 text-xs text-muted hover:text-accent hover:border-accent/30 transition-colors"
                >
                  {r.link_text}
                </a>
              ))}
            </div>
          </div>
        );
      })()}

      <!-- Related posts hint -->
      <div class="mt-12 p-6 bg-gray-50 dark:bg-[#151313] rounded-xl border border-gray-100 dark:border-white/10 text-center">
        <p class="text-sm text-muted">
          Enjoyed this story? <a href="/stories" class="text-accent font-semibold hover:underline">Browse all stories →</a>
        </p>
      </div>
    </div>
  </article>
</section>
