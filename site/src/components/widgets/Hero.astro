---
import Button from '~/components/ui/Button.astro';

const {
  title = '',
  subtitle = '',
  tagline = '',
  actions = [],
  bgImage,
  establishedLabel = 'EST',
  establishedYear = '2011',
} = Astro.props;
---

<section class="relative overflow-hidden not-prose bg-[#1a1a1a] text-white">
  {bgImage && (
    <div class="absolute inset-0">
      <img src={bgImage} alt="" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(26,26,26,0.78) 0%, rgba(26,26,26,0.42) 38%, rgba(26,26,26,0.60) 65%, rgba(26,26,26,0.94) 100%);"></div>
    </div>
  )}
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6" style="min-height: max(80svh, 500px);">
    <div class="flex flex-col justify-center items-center text-center pt-24 md:pt-32 pb-16 md:pb-24 min-h-[80svh]">
      
      {tagline && (
        <p class="text-[#ffa333]/90 text-sm md:text-base uppercase tracking-[0.2em] font-bold mb-4">
          {tagline}
        </p>
      )}

      <!-- EST Badge + Heading -->
      <div class="flex flex-col items-center gap-4 mb-4">

        <!-- EST Badge -->
        <div class="relative inline-flex flex-col items-center justify-center w-[72px] h-[72px] rounded-full" 
             style="border: 1.5px solid rgba(255, 163, 51, 0.55);" aria-label="Established 2011">
          <div class="absolute inset-[5px] rounded-full" style="border: 1px dashed rgba(255, 163, 51, 0.3);"></div>
          <span class="relative z-10 text-[#ffa333] text-[9px] font-bold tracking-[0.25em] uppercase leading-none mb-0.5">EST</span>
          <div class="relative z-10 w-5 h-px" style="background-color: rgba(255, 163, 51, 0.4);"></div>
          <span class="relative z-10 font-bold text-white text-lg leading-none" style="font-family: 'Merriweather', Georgia, serif;">2011</span>
        </div>

        {title && (
          <h1 class="font-bold leading-tight mb-2 max-w-4xl mx-auto text-white"
               style="font-family: 'Merriweather', Georgia, serif; font-size: clamp(1.5rem, 5vw, 3.25rem);">
            <span class="block text-white mb-2">Malaysia's Culture and Heritage<br />
              <span class="inline-block bg-[#ffa333] text-black px-4 py-1.5 rounded-sm shadow-xl font-black"
                    style="transform: rotate(-0.7deg); font-size: clamp(1.3rem, 4.5vw, 3rem);">
                As Only Locals Know It
              </span>
            </span>
          </h1>
        )}
      </div>
      
      {subtitle && (
        <p class="font-[family-name:var(--aw-font-heading)] italic text-gray-300 mb-6 max-w-3xl mx-auto"
           style="font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.5;">
          {subtitle}
        </p>
      )}
      
      {actions.length > 0 && (
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
          {actions.map((action) => (
            <Button {...(action || {})} />
          ))}
        </div>
      )}
      
      <!-- Platform Badges -->
      <div class="flex flex-wrap justify-center items-center gap-6 md:gap-8 p-3 px-5 rounded-lg" style="background-color: rgba(255,255,255,0.05); backdrop-filter: blur(4px);">
        <div class="flex items-center gap-2.5">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <div class="text-left">
            <div class="text-[#ffa333] text-sm">★★★★★</div>
            <div class="text-[10px] text-gray-400 uppercase tracking-wide">Google Reviews</div>
          </div>
        </div>
        
        <div class="w-px h-7 hidden sm:block" style="background-color: rgba(255,255,255,0.2);"></div>
        
        <div class="flex items-center gap-2.5">
          <svg class="w-7 h-7" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" fill="#00AF87"/>
            <path d="M12 7l1.5 3.5 3.5.5-2.5 2.5.5 3.5-3-1.5-3 1.5.5-3.5L7 11l3.5-.5z" fill="white"/>
          </svg>
          <div class="text-left">
            <div class="text-[#00AF87] text-sm">★★★★★</div>
            <div class="text-[10px] text-gray-400 uppercase tracking-wide">Travellers Choice</div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
