import type { APIRoute } from "astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export const GET: async ({ url }) => {
  const storiesCollection = getCollection("stories");
  
  // Group stories by category
  const storiesByCategory = {};
  
  storiesCollection.forEach((story) => {
    const categories = story.data.categories || [];
    const primaryCategory = categories[0] || 'uncategorized';
    
    if (!storiesByCategory[primaryCategory]) {
      storiesByCategory[primaryCategory] = {
        name: primaryCategory,
        displayName: formatCategoryName(primaryCategory),
        description: getCategoryDescription(primaryCategory),
        icon: getCategoryIcon(primaryCategory),
        color: getCategoryColor(primaryCategory),
        stories: [],
        count: 0,
        totalViews: 0
      };
    }
    
    storiesByCategory[primaryCategory].stories.push({
      slug: story.slug,
      title: story.data.title,
      description: story.data.description,
      date: story.data.pubDate,
      author: story.data.author,
      image: story.data.heroImage,
      readTime: story.data.readTime,
      categories: story.data.categories || [],
      tags: story.data.tags || [],
      featured: story.data.featured || false,
      views: story.data.views || 0
    });
    
    storiesByCategory[primaryCategory].count++;
    storiesByCategory[primaryCategory].totalViews += story.data.views || 0;
  });
  
  // Convert to array and sort by count (highest first)
  const categories = Object.values(storiesByCategory).sort((a, b) => b.count - a.count);
  
  // Add additional metadata
  const enhancedCategories = categories.map(category => ({
    ...category,
    lastUpdated: category.stories.length > 0 
      ? category.stories.reduce((latest, story) => 
          new Date(story.date) > latest ? new Date(story.date) : latest
      , category.stories[0].date)
      : new Date(),
    featuredStories: category.stories.filter(story => story.featured),
    storyUrls: category.stories.map(story => `/stories/${story.slug}`),
    slug: category.name.toLowerCase().replace(/\s+/g, '-'),
    seo: {
      title: `${category.displayName} - Simply Enak`,
      description: `Explore our ${category.description}. Read comprehensive guides about ${category.displayName}.`,
      keywords: [category.name, category.displayName, 'malaysian food', 'simply enak', ...category.tags]
    },
    stats: {
      totalStories: category.count,
      totalViews: category.totalViews,
      featuredCount: category.stories.filter(s => s.featured).length,
      avgReadTime: category.stories.reduce((sum, story) => sum + (story.readTime || 5), 0) / category.count,
      categoriesCount: category.stories.reduce((sum, story) => sum + (story.categories?.length || 1), 0) / category.count
    }
  }));
  
  const responseData = {
    categories: enhancedCategories,
    totalCount: storiesCollection.length,
    totalViews: storiesCollection.reduce((sum, story) => sum + (story.data.views || 0), 0),
    lastUpdated: storiesCollection.length > 0 
      ? storiesCollection.reduce((latest, story) => 
          new Date(story.data.pubDate) > latest ? new Date(story.data.pubDate) : latest
        , storiesCollection[0].data.pubDate)
      : new Date()
  };
  
  return new Response(JSON.stringify(responseData), {
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "public, max-age=3600, s-maxage=86400",
      "Access-Control-Allow-Origin": "*"
    }
  });
};

// Helper functions
function formatCategoryName(categoryName) {
  return categoryName
    .split(' ')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

