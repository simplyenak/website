---
import "@/styles/global.css";
import Header from "@/components/Header/header.astro";
import Footer from "@/components/Footer/footer.astro";
import SEO from "@/components/SEO.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "product";
  noindex?: boolean;
  nofollow?: boolean;
  canonicalURL?: string;
  structuredData?: object;
}

const {
  title = "Simply Enak – Food Tours and more",
  description,
  image,
  imageAlt,
  type,
  noindex,
  nofollow,
  canonicalURL,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      nofollow={nofollow}
      canonicalURL={canonicalURL}
      structuredData={structuredData}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Performance: Preconnect to critical origins -->
    <link rel="preconnect" href="https://api.system.simplyenak.com" crossorigin>
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://assets.ticketinghub.com">
    <link rel="preconnect" href="https://livechat.myalice.ai">
    <link rel="dns-prefetch" href="https://www.google-analytics.com">
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com">

    <script is:inline>
      (function () {
        const s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        s.async = true;
        s.defer = true;
        s.crossOrigin = "anonymous";
        s.onerror = () => setTimeout(() => document.head.appendChild(s), 2000);
        document.head.appendChild(s);
      })();
    </script>

    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-5CY08S07Z8"
    ></script>
    <script>
      declare global {
        interface Window {
          dataLayer: any[];
          trackTourBooking: (
            tourName: string,
            tourPrice: number,
            bookingId: string
          ) => void;
          trackTourInterest: (tourName: string) => void;
          trackCalendarView: () => void;
          trackContactForm: () => void;
        }
      }
      window.dataLayer = window.dataLayer || [];
      function gtag(...args: any[]) {
        window.dataLayer.push(args);
      }
      gtag("js", new Date());

      // Basic GA4 configuration
      gtag("config", "G-5CY08S07Z8", {
        // Enhanced measurement (automatic scroll, clicks, downloads)
        send_page_view: true,
        // Custom parameters for your food tour business
        custom_map: {
          tour_type: "custom_parameter_1",
          booking_source: "custom_parameter_2",
        },
      });

      // Helper function for tour booking conversion tracking (ready for when you need it)
      function trackTourBooking(
        tourName: string,
        tourPrice: number,
        bookingId: string
      ) {
        gtag("event", "purchase", {
          transaction_id: bookingId,
          value: tourPrice,
          currency: "USD",
          items: [
            {
              item_id: tourName.toLowerCase().replace(/\s+/g, "_"),
              item_name: tourName,
              category: "Food Tours",
              quantity: 1,
              price: tourPrice,
            },
          ],
        });
      }

      // Helper function for tour interest tracking
      function trackTourInterest(tourName: string) {
        gtag("event", "view_item", {
          currency: "USD",
          value: 0,
          items: [
            {
              item_id: tourName.toLowerCase().replace(/\s+/g, "_"),
              item_name: tourName,
              category: "Food Tours",
            },
          ],
        });
      }

      // Calendar page engagement tracking
      function trackCalendarView() {
        gtag("event", "view_item_list", {
          item_list_name: "Tour Calendar",
          currency: "USD",
        });
      }

      // Contact form submission tracking
      function trackContactForm() {
        gtag("event", "generate_lead", {
          currency: "USD",
          value: 0,
          method: "contact_form",
        });
      }

      // Make functions globally available
      window.trackTourBooking = trackTourBooking;
      window.trackTourInterest = trackTourInterest;
      window.trackCalendarView = trackCalendarView;
      window.trackContactForm = trackContactForm;
    </script>
  </head>
  <body class="min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Email Protection Fix Script -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Replace "email protected" with actual email
        const walker = document.createTreeWalker(
          document.body,
          NodeFilter.SHOW_TEXT,
          null,
          false
        );
        
        let node;
        while (node = walker.nextNode()) {
          if (node.textContent.includes('[email protected]')) {
            node.textContent = node.textContent.replace('[email protected]', 'contact@simplyenak.com');
          }
        }
      });
    </script>

    <!-- Performance: Load chat widget after page is interactive -->
    <script is:inline>
      (function () {
        // Defer chat widget load until browser is idle
        function loadChatWidget() {
          var e = document.createElement("div");
          e.id = "myAliceWebChat";
          var t = document.createElement("script");
          t.type = "text/javascript";
          t.async = true;
          t.src = "https://livechat.myalice.ai/index.js";
          var a = document.body.getElementsByTagName("script");
          a = a[a.length - 1];
          a.parentNode.insertBefore(t, a);
          a.parentNode.insertBefore(e, a);
          t.addEventListener("load", function () {
            MyAliceWebChat.init({
              selector: "#myAliceWebChat",
              platformId: "12818",
              primaryId: "7b296d7e658e11edac5dc275f55bff6f",
              token: "4c6981083aeed7ce81f8c47d029d061227cf5f3939f449b4",
            });
          });
        }

        // Load after page is fully interactive
        if ("requestIdleCallback" in window) {
          requestIdleCallback(loadChatWidget, { timeout: 3000 });
        } else {
          setTimeout(loadChatWidget, 2000);
        }
      })();
    </script>
  </body>
</html>