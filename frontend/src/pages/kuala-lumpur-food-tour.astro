---
import Layout from '../layouts/Layout.astro';
import { kualaLumpurLandingPage } from '../data/kl-landing-page';

export const prerender = true;
import SEO from '../components/SEO.astro';

const pageData = kualaLumpurLandingPage;

// SEO metadata - KL Landing Page v2
const seoData = {
  title: pageData.metaTitle,
  description: pageData.metaDescription,
  image: pageData.hero.backgroundImage,
  url: Astro.url.pathname,
  type: 'website',
  structuredData: {
    '@context': 'https://schema.org',
    '@type': ['TouristDestination', 'EducationalOrganization'],
    name: 'Simply Enak: Kuala Lumpur\'s Leading Food Heritage Authority',
    description: pageData.metaDescription + " Since 2018, Simply Enak has been Kuala Lumpur\'s most comprehensive resource for understanding the city\'s multicultural food evolution and cultural heritage.",
    url: `https://simplyenak.com${Astro.url.pathname}`,
    image: `https://simplyenak.com${pageData.hero.backgroundImage}`,
    educationalLevel: 'Cultural Education',
    teaches: ['Malaysian Food Heritage', 'Multicultural Culinary Traditions', 'Kuala Lumpur Food History'],
    address: {
      '@type': 'PostalAddress',
      addressLocality: pageData.geo.addressLocality,
      addressRegion: pageData.geo.addressRegion,
      postalCode: pageData.geo.postalCode,
      addressCountry: 'MY'
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: pageData.geo.latitude,
      longitude: pageData.geo.longitude
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: pageData.trustSignals.rating,
      reviewCount: pageData.trustSignals.reviewCount,
      bestRating: 5,
      worstRating: 1
    },
    sameAs: [
      pageData.googleMyBusiness.url,
      'https://www.tripadvisor.com/Attraction_Review-g298570-d2328058-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html'
    ],
    about: [
      {
        '@type': 'Thing',
        name: 'Malaysian Food Heritage',
        description: 'The multicultural evolution of Malaysian cuisine from Malay, Chinese, and Indian traditions'
      },
      {
        '@type': 'Thing',
        name: 'Kuala Lumpur Street Food Culture',
        description: 'Traditional hawker center and wet market food culture spanning 150+ years'
      }
    ],
    mainEntity: {
      '@type': 'EducationalOrganization',
      name: 'Simply Enak Food Heritage Education',
      description: 'Kuala Lumpur\'s leading authority on multicultural food heritage education since 2018',
      educationalLevel: 'Cultural Heritage Education',
      hasEducationalUse: 'Teaching Malaysian Food History and Cultural Traditions'
    }
  }
};
---

<Layout>
  <SEO {...seoData} />

  <!-- Blog Header -->
  <header class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-8">
        <div class="text-gray-500 mb-4">
          <time datetime="2025-10-03">October 3, 2025</time> •
          <span>By Simply Enak Team</span> •
          <span>15 min read</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          {pageData.hero.title}
        </h1>
        <p class="text-xl text-gray-600 mb-8 leading-relaxed max-w-3xl mx-auto">
          {pageData.hero.subtitle}
        </p>
      </div>

      <!-- Hero Image -->
      <img
        src={pageData.hero.backgroundImage}
        alt="Kuala Lumpur food scene"
        class="w-full h-64 md:h-96 object-cover rounded-lg"
        loading="eager"
      />
    </div>
  </header>

  
  <!-- Introduction -->
  <section class="py-8 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose prose-lg max-w-none">
        <p class="text-gray-700 leading-relaxed text-lg">
          {pageData.hero.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Heritage Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        {pageData.heritage.title}
      </h2>

      <!-- Heritage introduction as blog paragraphs -->
      <div class="prose prose-lg max-w-none mb-8">
        {pageData.heritage.introduction.split('\n\n').map((paragraph) => (
          <p class="text-gray-700 leading-relaxed mb-6 text-lg">
            {paragraph}
          </p>
        ))}
      </div>

      <!-- Key Heritage Facts -->
      <div class="bg-gray-50 p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-4">Key Facts About KL's Food Heritage</h3>
        <ul class="space-y-3">
          {pageData.heritage.keyFacts.map((fact) => (
            <li class="flex items-start">
              <span class="font-semibold text-gray-900 mr-2">{fact.label}:</span>
              <span class="text-gray-700">{fact.value}</span>
              {fact.description && (
                <span class="text-gray-600 text-sm block mt-1">{fact.description}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Food Cultures Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        The Three Cultures That Shape Kuala Lumpur's Food
      </h2>

      {pageData.foodCultures.map((culture) => (
        <div class="mb-12 bg-white p-6 rounded-lg">
          <img
            src={culture.image}
            alt={`${culture.name} cuisine`}
            class="w-full h-64 object-cover rounded-lg mb-6"
            loading="lazy"
          />
          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            {culture.name}
          </h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            {culture.description}
          </p>
          <div class="bg-gray-50 p-4 rounded">
            <h4 class="font-semibold mb-2">Key Dishes:</h4>
            <ul class="list-disc list-inside text-gray-700 space-y-1">
              {culture.keyDishes.map((dish) => (
                <li>{dish}</li>
              ))}
            </ul>
          </div>
          <p class="text-gray-600 leading-relaxed mt-4 italic">
            {culture.culturalContext}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Signature Dishes Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Signature Dishes You Must Try
      </h2>

      <div class="space-y-8">
        {pageData.signatureDishes.map((dish) => (
          <div class="border-b pb-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              {dish.name}
            </h3>
            <img
              src={dish.image}
              alt={dish.name}
              class="w-full h-48 object-cover rounded-lg mb-4"
              loading="lazy"
            />
            <p class="text-gray-700 leading-relaxed mb-3">
              {dish.description}
            </p>
            <div class="grid md:grid-cols-2 gap-4 text-sm">
              <div>
                <span class="font-semibold">Origin:</span> {dish.origin}
              </div>
              <div>
                <span class="font-semibold">Where to Find:</span> {dish.whereToFind}
              </div>
              {dish.vegetarian && (
                <div class="text-green-600 font-semibold">
                  ✓ Vegetarian Friendly
                </div>
              )}
              <div>
                <span class="font-semibold">Cultural:</span> {dish.cultural}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Neighborhoods Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Kuala Lumpur's Food Neighborhoods
      </h2>

      <div class="space-y-8">
        {pageData.neighborhoods.map((neighborhood) => (
          <div class="bg-white p-6 rounded-lg">
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              {neighborhood.name}
            </h3>
            <img
              src={neighborhood.image}
              alt={neighborhood.name}
              class="w-full h-64 object-cover rounded-lg mb-4"
              loading="lazy"
            />
            <p class="text-gray-700 leading-relaxed mb-4">
              {neighborhood.description}
            </p>
            <div class="bg-gray-50 p-4 rounded">
              <h4 class="font-semibold mb-2">Known For:</h4>
              <ul class="list-disc list-inside text-gray-700 space-y-1">
                {neighborhood.knownFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="text-gray-600 mt-3 italic">
                <strong>Vibe:</strong> {neighborhood.vibe}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Simply Enak -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Why Choose Simply Enak for Food Heritage Education?
      </h2>

      <p class="text-lg text-gray-700 leading-relaxed mb-6">
        {pageData.whyTourWithUs.description}
      </p>

      <div class="space-y-6">
        {pageData.whyTourWithUs.reasons.map((reason) => (
          <div class="border-l-4 border-blue-500 pl-4">
            <h3 class="text-xl font-semibold text-gray-900 mb-2">
              {reason.title}
            </h3>
            <p class="text-gray-700 leading-relaxed">
              {reason.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Experience Kuala Lumpur's Food Heritage
      </h2>

      <div class="grid gap-6">
        {pageData.featuredTours.map((tour) => (
          <div class="bg-white border rounded-lg p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2">
              {tour.name}
            </h3>
            <p class="text-gray-700 mb-4">{tour.description}</p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-semibold text-blue-600">
                RM {tour.price}
              </span>
              <a
                href={`/tours/${tour.slug}`}
                class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
              >
                Learn More
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet Your Guides -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Meet Your Food Heritage Guides
      </h2>

      <div class="space-y-8">
        {pageData.guides.map((guide) => (
          <div class="flex flex-col md:flex-row gap-6">
            <img
              src={guide.photo}
              alt={guide.name}
              class="w-full md:w-48 h-48 object-cover rounded-lg"
              loading="lazy"
            />
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">
                {guide.name}
              </h3>
              <p class="text-gray-700 leading-relaxed mb-4">
                {guide.bio}
              </p>
              <div>
                <h4 class="font-semibold mb-2">Specialties:</h4>
                <ul class="list-disc list-inside text-gray-700">
                  {guide.specialties.map((specialty) => (
                    <li>{specialty}</li>
                  ))}
                </ul>
                {guide.credentials && (
                  <div class="mt-4">
                    <h4 class="font-semibold mb-2">Credentials:</h4>
                    <ul class="list-disc list-inside text-gray-600 text-sm">
                      {guide.credentials.map((credential) => (
                        <li>{credential}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Simple Call to Action -->
  <section class="py-16 bg-blue-50">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Ready to Experience Kuala Lumpur's Food Heritage?
      </h2>
      <p class="text-lg text-gray-700 mb-8">
        Join us on a cultural journey that goes beyond tasting—you'll learn the stories, traditions, and significance behind Malaysia's incredible food diversity.
      </p>
      <a
        href="/tours"
        class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors text-lg font-semibold"
      >
        Explore Our Food Tours
      </a>
    </div>
  </section>
</Layout>

