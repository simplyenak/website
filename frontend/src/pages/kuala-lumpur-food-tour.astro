---
import Layout from '../layouts/Layout.astro';
import { kualaLumpurLandingPage } from '../data/kl-landing-page';

export const prerender = true;
import Hero from '../components/LandingPage/Hero.astro';
import TrustBar from '../components/LandingPage/TrustBar.astro';
import Heritage from '../components/LandingPage/Heritage.astro';
import FoodCultures from '../components/LandingPage/FoodCultures.astro';
import SignatureDishes from '../components/LandingPage/SignatureDishes.astro';
import Neighborhoods from '../components/LandingPage/Neighborhoods.astro';
import WhyChooseUs from '../components/LandingPage/WhyChooseUs.astro';
import ToursGrid from '../components/LandingPage/ToursGrid.astro';
import Reviews from '../components/LandingPage/Reviews.astro';
import Guides from '../components/LandingPage/Guides.astro';
import Expectations from '../components/LandingPage/Expectations.astro';
import FAQ from '../components/LandingPage/FAQ.astro';
import SEO from '../components/SEO.astro';

const pageData = kualaLumpurLandingPage;

// SEO metadata - KL Landing Page v2
const seoData = {
  title: pageData.metaTitle,
  description: pageData.metaDescription,
  image: pageData.hero.backgroundImage,
  url: Astro.url.pathname,
  type: 'website',
  structuredData: {
    '@context': 'https://schema.org',
    '@type': ['TouristDestination', 'EducationalOrganization'],
    name: 'Simply Enak: Kuala Lumpur\'s Leading Food Heritage Authority',
    description: pageData.metaDescription + " Since 2018, Simply Enak has been Kuala Lumpur\'s most comprehensive resource for understanding the city\'s multicultural food evolution and cultural heritage.",
    url: `https://simplyenak.com${Astro.url.pathname}`,
    image: `https://simplyenak.com${pageData.hero.backgroundImage}`,
    educationalLevel: 'Cultural Education',
    teaches: ['Malaysian Food Heritage', 'Multicultural Culinary Traditions', 'Kuala Lumpur Food History'],
    address: {
      '@type': 'PostalAddress',
      addressLocality: pageData.geo.addressLocality,
      addressRegion: pageData.geo.addressRegion,
      postalCode: pageData.geo.postalCode,
      addressCountry: 'MY'
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: pageData.geo.latitude,
      longitude: pageData.geo.longitude
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: pageData.trustSignals.rating,
      reviewCount: pageData.trustSignals.reviewCount,
      bestRating: 5,
      worstRating: 1
    },
    sameAs: [
      pageData.googleMyBusiness.url,
      'https://www.tripadvisor.com/Attraction_Review-g298570-d2328058-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html'
    ],
    about: [
      {
        '@type': 'Thing',
        name: 'Malaysian Food Heritage',
        description: 'The multicultural evolution of Malaysian cuisine from Malay, Chinese, and Indian traditions'
      },
      {
        '@type': 'Thing',
        name: 'Kuala Lumpur Street Food Culture',
        description: 'Traditional hawker center and wet market food culture spanning 150+ years'
      }
    ],
    mainEntity: {
      '@type': 'EducationalOrganization',
      name: 'Simply Enak Food Heritage Education',
      description: 'Kuala Lumpur\'s leading authority on multicultural food heritage education since 2018',
      educationalLevel: 'Cultural Heritage Education',
      hasEducationalUse: 'Teaching Malaysian Food History and Cultural Traditions'
    }
  }
};
---

<Layout>
  <SEO {...seoData} />

  <!-- Hero Section -->
  <Hero
    title={pageData.hero.title}
    subtitle={pageData.hero.subtitle}
    description={pageData.hero.description}
    ctaText={pageData.hero.ctaText}
    ctaUrl={pageData.hero.ctaUrl}
    backgroundImage={pageData.hero.backgroundImage}
    trustSignals={pageData.trustSignals}
  />

  
  <!-- Educational Authority Section -->
  <section class="py-16 bg-blue-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-white rounded-lg p-8 shadow-lg">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
            Kuala Lumpur's Leading Food Heritage Authority
          </h2>
          <p class="text-lg text-gray-700 mb-6 leading-relaxed">
            Since 2018, Simply Enak has been Kuala Lumpur's most comprehensive resource for understanding the city's multicultural food evolution. Our educational approach is used by cultural researchers, food historians, and visitors seeking authentic Malaysian food knowledge.
          </p>
          <div class="grid md:grid-cols-3 gap-6 mt-8">
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600 mb-2">6+ Years</div>
              <p class="text-gray-600">Documenting KL's food heritage</p>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600 mb-2">3,000+</div>
              <p class="text-gray-600">Visitors educated annually</p>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600 mb-2">100%</div>
              <p class="text-gray-600">Local-born expert guides</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Heritage Section -->
  <Heritage
    heritage={pageData.heritage}
    location={pageData.name}
  />

  <!-- Food Cultures Section -->
  <FoodCultures
    cultures={pageData.foodCultures}
    location={pageData.name}
  />

  <!-- Signature Dishes Section -->
  <SignatureDishes
    dishes={pageData.signatureDishes}
    location={pageData.name}
  />

  <!-- Neighborhoods Section -->
  <Neighborhoods neighborhoods={pageData.neighborhoods} />

  <!-- Why Choose Us Section -->
  <WhyChooseUs
    benefits={pageData.whyTourWithUs.reasons}
    location={pageData.name}
  />

  <!-- Featured Tours Section -->
  <ToursGrid
    tours={pageData.featuredTours}
    location={pageData.name}
  />

  <!-- Reviews Section -->
  <Reviews
    reviews={pageData.reviews}
    trustSignals={pageData.trustSignals}
  />

  <!-- Meet Your Guides Section -->
  <Guides guides={pageData.guides} />

  <!-- Educational Resource Center -->
  <section class="py-16 bg-green-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
          Educational Resources on Malaysian Food Heritage
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          As Kuala Lumpur's leading authority on food heritage education, we provide comprehensive resources for researchers, students, and food enthusiasts seeking to understand Malaysian culinary traditions.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto mb-8">
        <div class="bg-white rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-600 mb-2">150+</div>
          <p class="text-gray-600 text-sm">Years of Food History Documented</p>
        </div>
        <div class="bg-white rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-600 mb-2">3 Major</div>
          <p class="text-gray-600 text-sm">Cultural Traditions Covered</p>
        </div>
        <div class="bg-white rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-600 mb-2">Academic</div>
          <p class="text-gray-600 text-sm">Research-Grade Information</p>
        </div>
      </div>
    </div>
  </section>

  <!-- More Malaysian Food Experiences -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
          Exploring More of Malaysia's Food Culture?
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Discover the culinary heritage of Penang, or explore specialized food experiences across Malaysia
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Penang Food Tours -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-300">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900">Penang Food Heritage</h3>
          </div>
          <p class="text-gray-600 mb-4">
            Explore George Town's UNESCO World Heritage food scene—Nyonya cuisine, hawker centers, and 200+ years of multicultural culinary evolution.
          </p>
          <a
            href="/penang-food-tour"
            class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium"
          >
            Discover Penang's Food Story
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- All Malaysia Tours -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-300">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
                <path
                  fill-rule="evenodd"
                  d="M4 5a2 2 0 012-2 1 1 0 000 2H6a2 2 0 100 4h2a2 2 0 100 4h2a1 1 0 100 2 2 2 0 01-2 2H6a2 2 0 01-2-2V5z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900">All Malaysia Food Tours</h3>
          </div>
          <p class="text-gray-600 mb-4">
            Browse our complete collection of food experiences across Malaysia—from morning market tours to night street food adventures.
          </p>
          <a
            href="/tours"
            class="inline-flex items-center text-yellow-600 hover:text-yellow-700 font-medium"
          >
            View All Food Experiences
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="py-20 bg-gradient-to-r from-yellow-500 to-yellow-600">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        Ready to Experience Kuala Lumpur's Food Heritage?
      </h2>
      <p class="text-xl text-yellow-100 mb-8 max-w-2xl mx-auto">
        Join us on a cultural journey that goes beyond tasting—you'll learn the stories,
        traditions, and significance behind Malaysia's incredible food diversity.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="#featured-tours"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-yellow-600 bg-white hover:bg-gray-50 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105"
        >
          <svg
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6v6m0 0v6m0-6h6m-6 0H6"
            />
          </svg>
          Choose Your Cultural Experience
        </a>

        <a
          href="https://wa.me/60172878929"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white border-2 border-white hover:bg-white hover:text-yellow-600 rounded-lg transition-all duration-300"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            />
          </svg>
          Ask About Cultural Experiences
        </a>
      </div>

      <p class="text-yellow-100 mt-6 text-sm">
        <svg
          class="w-4 h-4 inline mr-1"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"
          />
        </svg>
        Cultural education first • Small groups (max 8 people) • Born & raised local guides
      </p>
    </div>
  </section>
</Layout>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Intersection Observer for animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
      }
    });
  }, observerOptions);

  // Observe all sections for animations
  document.querySelectorAll('section').forEach(section => {
    observer.observe(section);
  });
</script>

<style>
  /* Custom animations */
  @keyframes animate-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-in {
    animation: animate-in 0.6s ease-out forwards;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Sticky navigation highlight */
  section[id] {
    scroll-margin-top: 100px;
  }
</style>