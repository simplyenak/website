---
import Layout from "../layouts/Layout.astro";
import { kualaLumpurLandingPage } from "../data/kl-landing-page";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import ContentBlock from "@/components/Design/ContentBlock.astro";
import PriceTag from "@/components/Design/PriceTag.astro";
import Badge from "@/components/Design/Badge.astro";
import Button from "@/components/Button.astro";
import SEO from "../components/SEO.astro";
import FAQ from "@/components/FAQ.astro";
import GlobalHero from "@/components/GlobalHero.astro";

export const prerender = true;

const pageData = kualaLumpurLandingPage;

// SEO metadata
const seoData = {
  title: pageData.metaTitle,
  description: pageData.metaDescription,
  image: pageData.hero.backgroundImage,
  url: Astro.url.pathname,
  type: "website",
  structuredData: {
    "@context": "https://schema.org",
    "@type": ["TouristDestination", "EducationalOrganization"],
    name: "Simply Enak: Kuala Lumpur's Food Heritage Guide",
    description: pageData.metaDescription,
    url: `https://simplyenak.com${Astro.url.pathname}`,
    image: `https://simplyenak.com${pageData.hero.backgroundImage}`,
    educationalLevel: "Cultural Education",
    teaches: [
      "Malaysian Food Heritage",
      "Multicultural Culinary Traditions",
      "Kuala Lumpur Food History",
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: pageData.geo.addressLocality,
      addressRegion: pageData.geo.addressRegion,
      postalCode: pageData.geo.postalCode,
      addressCountry: "MY",
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: pageData.geo.latitude,
      longitude: pageData.geo.longitude,
    },
  },
};
---

<Layout>
  <SEO {...seoData} />

  <!-- Hero Section -->
  <GlobalHero title={pageData.hero.title} subtitle={pageData.hero.subtitle} />

  <!-- Image Section with 3 Key Points -->
  <section
    class="relative bg-cover bg-center h-[400px] md:h-[500px]"
    style={`background-image: url('${pageData.hero.backgroundImage}')`}
  >
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="main-container relative z-10 h-full flex items-center">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-12 w-full">
        <div
          class="bg-white/95 backdrop-blur-sm p-6 rounded-lg text-center shadow-lg"
        >
          <div class="text-4xl mb-3">🏙️</div>
          <h3 class="text-h4 text-primary mb-2">3 Cultures</h3>
          <p class="text-body">
            Malay, Chinese, and Indian traditions creating unique fusion
          </p>
        </div>
        <div
          class="bg-white/95 backdrop-blur-sm p-6 rounded-lg text-center shadow-lg"
        >
          <div class="text-4xl mb-3">🍲</div>
          <h3 class="text-h4 text-primary mb-2">6,000+ Stalls</h3>
          <p class="text-body">
            From Chinatown to Chow Kit, an endless food adventure
          </p>
        </div>
        <div
          class="bg-white/95 backdrop-blur-sm p-6 rounded-lg text-center shadow-lg"
        >
          <div class="text-4xl mb-3">🌃</div>
          <h3 class="text-h4 text-primary mb-2">24/7 Scene</h3>
          <p class="text-body">Breakfast markets to midnight mamak stalls</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Buttons Section -->
  <section class="py-12 bg-gray-50">
    <div class="main-container text-center">
      <div class="flex items-center gap-7 flex-wrap justify-center">
        <Button
          href="#tours"
          title="Come Taste With Us"
          buttonType="primary-btn"
        />
        <Button
          href="#heritage"
          title="Learn The Stories"
          buttonType="secondary-btn"
        />
      </div>
    </div>
  </section>

  <!-- Heritage Section -->
  <Section id="heritage" variant="light">
    <div class="text-center mb-12">
      <h2 class="text-h2 text-primary">{pageData.heritage.title}</h2>
      <p
        class="text-body mt-6 max-w-4xl mx-auto leading-relaxed whitespace-pre-line"
      >
        {pageData.heritage.introduction}
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-6 mb-12">
      {
        pageData.heritage.keyFacts.map((fact) => (
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-3xl font-bold text-primary mb-2">{fact.value}</div>
            <div class="font-semibold text-gray-900 mb-2">{fact.label}</div>
            <div class="text-sm text-gray-600">{fact.description}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Food Cultures Section -->
  <Section id="cultures">
    <h2 class="text-h2 text-primary text-center mb-12">
      The Three Main Food Cultures
    </h2>
    <div class="grid md:grid-cols-3 gap-8">
      {
        pageData.foodCultures.map((culture) => (
          <Card image={culture.image} imageAlt={culture.name}>
            <h3 class="text-h3 text-primary mb-3">{culture.name}</h3>
            <p class="text-body mb-4">{culture.description}</p>
            <div class="mb-4">
              <strong class="text-gray-900">Key Dishes:</strong>
              <ul class="list-disc list-inside text-body mt-2 space-y-1">
                {culture.keyDishes.slice(0, 3).map((dish) => (
                  <li>{dish}</li>
                ))}
              </ul>
            </div>
            <p class="text-sm text-gray-600 italic">
              {culture.culturalContext}
            </p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Signature Dishes Section -->
  <Section id="dishes" variant="light">
    <h2 class="text-h2 text-primary text-center mb-12">
      Must-Try Signature Dishes
    </h2>
    <div class="space-y-8">
      {
        pageData.signatureDishes.map((dish) => (
          <ContentBlock
            layout="image-left"
            image={dish.image}
            imageAlt={dish.name}
          >
            <h3 class="text-h3 text-primary mb-3">{dish.name}</h3>
            {dish.vegetarian && (
              <Badge variant="success" size="small" class="mb-3">
                Vegetarian
              </Badge>
            )}
            <p class="text-body mb-4">{dish.description}</p>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div>
                <strong>Origin:</strong> {dish.origin}
              </div>
              <div>
                <strong>Where:</strong> {dish.whereToFind}
              </div>
              <div class="col-span-2">
                <strong>Type:</strong> {dish.cultural}
              </div>
            </div>
          </ContentBlock>
        ))
      }
    </div>
  </Section>

  <!-- Vegetarian Options Callout -->
  <Section variant="accent">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-h2 text-primary mb-4">Vegetarian or Vegan?</h2>
      <p class="text-body mb-6">
        All our tours can be customized for vegetarian and vegan diets. Or
        discover Malaysia's incredible 140-year plant-based heritage on our <a
          href="/vegetarian-food-tours"
          class="text-primary underline hover:text-secondary transition-colors font-semibold"
          >dedicated vegetarian food tours</a
        > - from Buddhist temple kitchens to South Indian family recipes.
      </p>
      <Button
        href="/vegetarian-food-tours"
        title="Explore Vegetarian Tours"
        buttonType="secondary-btn"
      />
    </div>
  </Section>

  <!-- Neighborhoods Section -->
  <Section id="neighborhoods">
    <h2 class="text-h2 text-primary text-center mb-12">
      Best Food Neighborhoods
    </h2>
    <div class="grid md:grid-cols-2 gap-8">
      {
        pageData.neighborhoods.map((neighborhood) => (
          <Card image={neighborhood.image} imageAlt={neighborhood.name}>
            <h3 class="text-h3 text-primary mb-3">{neighborhood.name}</h3>
            <p class="text-body mb-4">{neighborhood.description}</p>
            <div class="bg-gray-50 p-4 rounded-lg">
              <strong class="text-gray-900">Known for:</strong>
              <ul class="list-disc list-inside text-body mt-2 space-y-1">
                {neighborhood.knownFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <div class="text-sm mt-3 italic">
                <strong>Vibe:</strong> {neighborhood.vibe}
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Tours Section -->
  <Section id="tours" variant="accent">
    <div class="text-center mb-12">
      <h2 class="text-h2 text-primary">
        Ready to Experience KL's Food Heritage?
      </h2>
      <p class="text-subheading mt-4">Choose your cultural food adventure</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      {
        pageData.featuredTours.map((tour) => (
          <Card variant="featured" image={tour.image} imageAlt={tour.name}>
            <h3 class="text-h3 text-primary mb-3">{tour.name}</h3>
            <p class="text-body mb-4">{tour.description}</p>

            <div class="mb-4">
              <PriceTag amount={tour.price} currency="RM" variant="large" />
              <div class="text-sm text-gray-600 mt-2">
                Duration: {tour.duration} • Max 8 people
              </div>
            </div>

            <ul class="list-disc list-inside text-sm text-gray-700 mb-6 space-y-1">
              {tour.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>

            <div class="flex gap-3">
              <Button
                href={`/tours/${tour.slug}`}
                title="Join This Tour"
                buttonType="primary-btn-small"
                class="flex-1"
              />
              <Button
                href={`https://wa.me/60172878929?text=I'm interested in ${tour.name}`}
                title="WhatsApp"
                buttonType="secondary-btn-small"
              />
            </div>
          </Card>
        ))
      }
    </div>

    <div class="text-center max-w-2xl mx-auto">
      <h3 class="text-h3 text-primary mb-4">Why Choose Simply Enak?</h3>
      <p class="text-body mb-6">
        {pageData.whyTourWithUs.description}
      </p>
      <div class="flex flex-wrap justify-center gap-6 text-sm">
        <a
          href="/tours"
          class="text-primary hover:text-secondary transition-colors"
          >All Tours</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="/contact"
          class="text-primary hover:text-secondary transition-colors"
          >Contact Us</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="/about"
          class="text-primary hover:text-secondary transition-colors"
          >About Us</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="tel:+60172878929"
          class="text-primary hover:text-secondary transition-colors"
          >+60 17-287 8929</a
        >
      </div>
    </div>
  </Section>

  <!-- Guides Section -->
  <Section id="guides" variant="light">
    <h2 class="text-h2 text-primary text-center mb-12">
      Meet Your Food Heritage Guides
    </h2>
    <div class="grid md:grid-cols-3 gap-8">
      {
        pageData.guides.map((guide) => (
          <Card>
            <div class="flex flex-col items-center text-center">
              <img
                src={guide.photo}
                alt={guide.name}
                class="w-32 h-32 object-cover rounded-full mb-4"
                loading="lazy"
              />
              <h3 class="text-h3 text-primary mb-3">{guide.name}</h3>
              <p class="text-body mb-4">{guide.bio}</p>
              <div class="w-full">
                <strong class="text-gray-900 text-sm">Specialties:</strong>
                <div class="flex flex-wrap gap-2 mt-2 justify-center">
                  {guide.specialties.map((specialty) => (
                    <Badge variant="primary" size="small">
                      {specialty}
                    </Badge>
                  ))}
                </div>
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Reviews Section -->
  <Section id="reviews">
    <h2 class="text-h2 text-primary text-center mb-12">What Our Guests Say</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {
        pageData.reviews.map((review) => (
          <Card>
            <div class="flex items-center mb-4">
              <div class="flex text-orange">
                {[...Array(5)].map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                  </svg>
                ))}
              </div>
            </div>
            <p class="text-body mb-4 italic">"{review.text}"</p>
            <div class="text-sm">
              <strong>{review.author}</strong>
              <div class="text-gray-600">{review.location}</div>
              <div class="text-gray-500 text-xs mt-1">
                {review.source} •{" "}
                {new Date(review.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                })}
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- FAQ Section with Schema Markup -->
  <FAQ faqs={pageData.faqs} />
</Layout>
