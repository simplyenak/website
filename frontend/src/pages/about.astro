---
import Layout from "../layouts/Layout.astro";
import CTASection from "@/components/CTASection.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import MediaSection from "@/components/Home/MediaSection.astro";
import TextWithLeftRightImage from "@/components/About/TextWithLeftRightImage.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import Icon from "@/components/Icon.astro";

export const prerender = true;

const data = {
  SEO: {
    title: "About Simply Enak | Authentic Malaysian Food Tours",
    description:
      "Learn about Simply Enak, our passion for Malaysian street food, and our mission to connect travelers with authentic local culture.",
    image:
      "https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg",
    schema: {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      name: "About Simply Enak",
      description: "Authentic Malaysian Food Tours",
    },
  },
  aboutHero: {
    title: "Our Story",
    subtitle:
      "Born in Malaysia. Raised on street food. Passionate about sharing the authentic side of our home with you.",
    image: "/images/about-hero.png",
  },
  founderStory: {
    title: "Meet Pauline, Our Founder",
    name: "Pauline",
    contents: `Growing up in Malaysia, I spent countless mornings walking through wet markets with my mom. While she haggled for the freshest fish and picked out vegetables, I watched the hawkers craft dishes that had been passed down through generations. The sizzle of char kway teow on a screaming hot wok, the aromatic clouds of curry rising from street stalls, the careful art of folding roti canai. This was my Malaysia.

    When I started bringing friends from other countries around, I realized they were missing this entire world. They'd eat at air-conditioned restaurants with picture menus, never knowing that just two streets away, a grandmother was making laksa the same way her mother taught her 60 years ago.

    Simply Enak started in 2010 because I wanted to share what I experienced as a child. Not the Malaysia you see in guidebooks, but the one I know: the night markets, the family recipes, the vendors who remember your face and your favorite dish. The authentic side of Malaysia that tourists walk past every day.`,
    imagePosition: "right",
    bgColor: "white",
    image: {
      url: "https://se-website-images.s3.nl-ams.scw.cloud/dumy-avatar.webp",
    },
  },
  timeline: {
    title: "Our Journey",
    milestones: [
      {
        year: "2010",
        title: "Simply Enak Founded",
        description: "Pauline launches the first authentic food tours in Penang and Kuala Lumpur",
      },
      {
        year: "2012",
        title: "100+ Happy Guests",
        description: "Word spreads through travel communities. We expand to Melaka tours.",
      },
      {
        year: "2015",
        title: "Featured by National Geographic",
        description: "Our tours recognized for authentic cultural experiences and vendor relationships.",
      },
      {
        year: "2018",
        title: "500+ Tours Conducted",
        description: "Licensed guides join the team. We refine our small-group philosophy.",
      },
      {
        year: "2020",
        title: "Adapting & Surviving",
        description: "Pivoted to support local vendors during challenging times.",
      },
      {
        year: "2024",
        title: "1,000+ Happy Guests",
        description: "14 years strong. Still walking the same markets, sharing the same passion.",
      },
    ],
  },
  stats: {
    items: [
      {
        number: "1,000+",
        label: "Happy Guests",
      },
      {
        number: "4.9/5",
        label: "TripAdvisor Rating",
      },
      {
        number: "14 Years",
        label: "Experience",
      },
      {
        number: "Max 8",
        label: "Group Size",
      },
    ],
  },
  ourPhilosophy: {
    title: "Our Philosophy",
    points: [
      {
        title: "Unscripted & Human",
        description:
          "We don't do canned jokes or rehearsed speeches. Our guides are licensed professionals, but they talk to you like friends: sharing real stories, not scripts.",
        icon: "icon-hands-join",
      },
      {
        title: "Slow Travel",
        description:
          "We walk. We pause. We take the time to appreciate the details: the architecture, the smells, the sounds of the neighborhood.",
        icon: "icon-compass",
      },
      {
        title: "Support Local",
        description:
          "We exclusively visit family-run businesses. Your tour fee directly supports the heritage keepers of our food culture.",
        icon: "icon-heart",
      },
    ],
  },
  meetTheTeam: {
    title: "Meet the Team",
    intro:
      "Simply Enak is a small, passionate team. We're all licensed with Tourism Malaysia, but more importantly, we grew up eating at these same stalls. We know the vendors by name, the neighborhoods by heart, and the stories behind every dish.",
    team: [
      {
        name: "Pauline",
        role: "Founder & Lead Guide",
        specialty: "14 Years Building Relationships",
        description:
          "Started Simply Enak in 2010 after watching too many tourists miss the real Malaysia. Grew up walking wet markets with her mom, learning which vendors had the freshest fish and the best stories. Now brings that childhood wonder to every tour.",
        icon: "icon-heart",
      },
      {
        name: "Danny",
        role: "Licensed Guide",
        specialty: "Tourism Malaysia Certified",
        description:
          "Licensed guide with deep knowledge of Malaysian food heritage and culture. Passionate about sharing the authentic stories behind every dish and connecting travelers with local communities.",
        icon: "icon-star",
      },
      {
        name: "Wei Shen",
        role: "Licensed Guide",
        specialty: "Tourism Malaysia Certified",
        description:
          "Licensed guide specializing in the cultural history of Malaysian cuisine. Expertly navigates the blend of Malay, Chinese, and Indian influences that make our food scene unique.",
        icon: "icon-star",
      },
      {
        name: "Ronald",
        role: "Licensed Guide",
        specialty: "Tourism Malaysia Certified",
        description:
          "Licensed guide with extensive knowledge of local neighborhoods and vendor relationships. Brings energy and authentic storytelling to every tour experience.",
        icon: "icon-star",
      },
      {
        name: "Maarten",
        role: "Partner",
        specialty: "Operations & Growth",
        description:
          "Manages operations and business development, ensuring every aspect of Simply Enak delivers on our promise of authentic, personal food experiences.",
        icon: "icon-compass",
      },
    ],
  },
  mediaSection: {
    title: "See Us in Action",
    videoEmbedUrl: "https://www.youtube.com/embed/VIDEO_ID_PLACEHOLDER",
  },
};
---

<Layout
  title={data.SEO.title}
  description={data.SEO.description}
  image={data.SEO.image}
  structuredData={data.SEO.schema}
>
  <GlobalHero
    title={data.aboutHero.title}
    subtitle={data.aboutHero.subtitle}
    image={data.aboutHero.image}
    isOverlay={true}
  />

  <!-- Founder Story Section -->
  <TextWithLeftRightImage
    title={data.founderStory.title}
    contents={data.founderStory.contents}
    imagePosition={data.founderStory.imagePosition}
    bgColor={data.founderStory.bgColor}
    image={data.founderStory.image}
  />

  <!-- Stats Section -->
  <Section variant="light">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {
        data.stats.items.map((stat) => (
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold text-primary mb-2">
              {stat.number}
            </div>
            <div class="text-body text-gray-600">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Visual Timeline Section -->
  <Section>
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-h2 text-primary">{data.timeline.title}</h2>
    </div>
    <div class="max-w-4xl mx-auto">
      <div class="relative">
        <!-- Timeline Line -->
        <div
          class="absolute left-8 md:left-1/2 transform md:-translate-x-1/2 h-full w-1 bg-gradient-to-b from-primary to-secondary"
        >
        </div>

        <!-- Timeline Items -->
        {
          data.timeline.milestones.map((milestone, index) => (
            <div
              class={`relative mb-12 md:mb-16 ${index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"} flex flex-row items-center`}
            >
              <div class="w-full md:w-5/12" />
              <div class="absolute left-8 md:left-1/2 transform md:-translate-x-1/2 w-16 h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold z-10 shadow-lg">
                {milestone.year}
              </div>
              <div class="w-full md:w-5/12 pl-24 md:pl-0">
                <Card class="h-full">
                  <h3 class="text-h3 text-primary mb-2">{milestone.title}</h3>
                  <p class="text-body text-gray-600">{milestone.description}</p>
                </Card>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Philosophy Section -->
  <Section variant="light">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <h2 class="text-h2 text-primary">{data.ourPhilosophy.title}</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        data.ourPhilosophy.points.map((point) => (
          <Card class="text-center h-full">
            <div class="w-16 h-16 mx-auto mb-4 text-primary">
              <Icon name={point.icon} />
            </div>
            <h3 class="text-h3 text-primary mb-3">{point.title}</h3>
            <p class="text-body">{point.description}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Meet The Team Section -->
  <Section>
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <h2 class="text-h2 text-primary">{data.meetTheTeam.title}</h2>
      <p class="text-body mt-4">{data.meetTheTeam.intro}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {
        data.meetTheTeam.team.map((member) => (
          <div class="group relative overflow-hidden rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 aspect-[3/4]">
            {/* Background Image */}
            <div class="absolute inset-0 bg-gradient-to-br from-primary/30 to-secondary/30">
              <img
                src={member.name === "Pauline" ? data.founderStory.image.url : "https://se-website-images.s3.nl-ams.scw.cloud/dumy-avatar.webp"}
                alt={member.name}
                class="w-full h-full object-cover opacity-80 group-hover:scale-110 transition-transform duration-500"
              />
            </div>

            {/* Default Overlay - Title */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-6 transition-opacity duration-300 group-hover:opacity-0">
              <h3 class="text-2xl font-bold text-white mb-1">{member.name}</h3>
              <p class="text-sm text-white/90">{member.role}</p>
              <p class="text-sm font-semibold text-secondary mt-2">
                {member.specialty}
              </p>
            </div>

            {/* Hover Overlay - Full Info */}
            <div class="absolute inset-0 bg-primary/95 flex flex-col justify-center p-6 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="w-12 h-12 text-white mb-4">
                <Icon name={member.icon} />
              </div>
              <h3 class="text-xl font-bold text-white mb-2">{member.name}</h3>
              <p class="text-sm text-white/90 mb-1">{member.role}</p>
              <p class="text-sm font-semibold text-secondary mb-4">
                {member.specialty}
              </p>
              <p class="text-sm text-white/90 leading-relaxed">
                {member.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>
  <MediaSection
    title={data.mediaSection.title}
    videoEmbedUrl={data.mediaSection.videoEmbedUrl}
  />
  <CTASection />
</Layout>
