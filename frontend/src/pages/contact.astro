---
import Layout from '../layouts/Layout.astro'
import CTASection from '@/components/CTASection.astro'
import GlobalHero from '@/components/GlobalHero.astro'
import bg4 from '@/assets/images/bg4.jpg'
import GetInTouchSection from '@/components/Contact/GetInTouchSection.astro'
---

<Layout title="Contact – Simply Enak">
  <GlobalHero
    title="WE ARE HERE TO HELP!"
    description="As Guides, we love answering your questions. Let us know how we can help you have the best possible experience visiting Malaysia."
    image={bg4}
    objectPosition="object-top"
  />
  <GetInTouchSection />
  <CTASection />
</Layout>
