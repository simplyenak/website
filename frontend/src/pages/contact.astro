---
import Layout from "../layouts/Layout.astro";
import CTASection from "@/components/CTASection.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import GetInTouchSection from "@/components/Contact/GetInTouchSection.astro";
import type {
  GlobalHeroTypes,
  GetInTouchSectionTypes,
  SEOTypes,
} from "@/types";
import fetchApi from "@/lib/strapi";
import { getFullMediaUrl } from "@/utils/getFullMediaUrl";

export const prerender = true;

const data: {
  SEO: SEOTypes;
  heroSection: GlobalHeroTypes;
  getInTouchSection: GetInTouchSectionTypes;
} = await fetchApi({
  endpoint:
    "contact?populate=heroSection.image&populate=getInTouchSection&populate=SEO.image",
  wrappedByKey: "data",
});
---

<Layout
  {...data?.SEO && {
    title: data.SEO.title,
    description: data.SEO.description,
    image: getFullMediaUrl(data.SEO.image),
    structuredData: data.SEO.schema,
  }}
>
  <GlobalHero
    title={data.heroSection.title}
    description={data.heroSection.description}
    image={data.heroSection.image}
    objectPosition={data.heroSection.objectPosition}
  />
  <GetInTouchSection
    title={data.getInTouchSection.title}
    contents={data.getInTouchSection.contents}
    formEmbedUrl={data.getInTouchSection.formEmbedUrl}
  />
  <CTASection />
</Layout>
