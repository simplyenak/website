---
import GlobalHero from "@/components/GlobalHero.astro";
import Layout from "@/layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import CTASection from "@/components/CTASection.astro";
import fetchApi from "@/lib/strapi";
import type { CustomToursMainPageTypes, CustomToursPageType } from "@/types";
import { getFullMediaUrl } from "@/utils/getFullMediaUrl";

export const prerender = true;

const data = await fetchApi<CustomToursMainPageTypes>({
  endpoint: `custom-tours-main?populate=heroSection.image&populate=SEO.image`,
  wrappedByKey: "data",
});

const customTours = await fetchApi<CustomToursPageType[]>({
  endpoint: `customs?populate=heroSection.image&populate=SEO.image`,
  wrappedByKey: "data",
});
---

<Layout
  {...data?.SEO && {
    title: data.SEO.title,
    description: data.SEO.description,
    image: getFullMediaUrl(data.SEO.image),
    structuredData: data.SEO.schema,
  }}
>
  <GlobalHero
    title={data?.heroSection.title || "Custom Tours"}
    description={data?.heroSection.description}
    image={data?.heroSection.image}
  />
  <section class="main-container py-16 md:py-20 lg:py-25">
    <p class="text-lg md:text-xl font-medium text-center mb-8 md:mb-12">
      SELECT THE IMAGE THAT BEST FITS YOUR SITUATION…
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-10">
      {
        customTours.map((tour) => (
          <div class="bg-[#efe5d9] rounded-lg overflow-hidden shadow-[2px_0px_20px_-5px_#00000066] group flex flex-col">
            <div class="h-50 w-full overflow-hidden">
              <Image
                src={getFullMediaUrl(tour.heroSection?.image)}
                alt={"Custom Tour Image"}
                class="size-full object-cover group-hover:scale-105 transition-transform duration-300"
                width={400}
                height={200}
              />
            </div>
            <div class="p-4 pb-8 md:pb-12 flex flex-col items-center justify-center text-center">
              <h3 class="text-2xl md:text-3xl font-semibold mb-2">
                {tour.heroSection?.title || "Custom Tour"}
              </h3>
              <p class="text-base md:text-lg">
                {tour.heroSection?.description}
              </p>
              <a
                href={`/custom-tours/${tour.slug}`}
                class="primary-btn max-w-[130px] !min-w-[130px] w-full hover:!text-primary hover:!border-primary mt-8 md:mt-12"
              >
                SELECT
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>
  <CTASection />
</Layout>
