---
import Layout from "../../layouts/Layout.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import ContentBlock from "@/components/Design/ContentBlock.astro";
import PriceTag from "@/components/Design/PriceTag.astro";
import Badge from "@/components/Design/Badge.astro";
import Button from "@/components/Button.astro";
import FAQ from "@/components/FAQ.astro";
import { Image } from "astro:assets";
import heroImage from "@/assets/images/7.jpg";

import {
  penangTourData,
  penangTourSchema,
} from "@/data/penang-heritage-food-trail";
import BookingWidget from "@/components/Tours/BookingWidget.astro";

export const prerender = true;
---

<Layout
  title={penangTourData.metaTitle}
  description={penangTourData.metaDescription}
  image={penangTourData.hero.image}
  structuredData={penangTourSchema}
>
  <!-- Split Layout Hero -->
  <section
    class="relative pt-32 pb-12 md:pt-40 md:pb-20 overflow-hidden bg-[#1a1a1a] text-white"
  >
    <div class="main-container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Text Content -->
        <div class="relative z-10 order-2 lg:order-1">
          <Badge variant="accent" customClasses="mb-6"
            >UNESCO World Heritage Route</Badge
          >
          <h1
            class="text-5xl md:text-7xl font-bold text-white mb-6 leading-tight tracking-tight"
          >
            {penangTourData.hero.title}
          </h1>
          <p
            class="text-xl md:text-2xl text-gray-300 mb-8 font-light leading-relaxed"
          >
            {penangTourData.hero.subtitle}
          </p>
          <div
            class="flex items-center gap-4 text-sm font-medium text-gray-400 mb-8"
          >
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="text-gray-600">/</span>
            <a href="/tours" class="hover:text-white transition-colors">Tours</a
            >
            <span class="text-gray-600">/</span>
            <span class="text-primary">Penang Heritage Food Trail</span>
          </div>
        </div>

        <!-- Hero Image -->
        <div
          class="relative order-1 lg:order-2 flex justify-center lg:justify-end"
        >
          <div
            class="relative rounded-[2rem] overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-700 ease-out max-w-[90%] lg:max-w-full"
          >
            <div
              class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent z-10 mix-blend-overlay"
            >
            </div>
            <Image
              src={heroImage}
              alt="Penang Heritage Food Trail"
              class="w-full h-[400px] lg:h-[450px] object-cover"
              width={800}
              height={600}
            />
          </div>
          <!-- Decorative Elements -->
          <div
            class="absolute -bottom-6 -left-6 w-24 h-24 bg-orange-500/20 rounded-full -z-10 blur-xl"
          >
          </div>
          <div
            class="absolute -top-6 -right-6 w-32 h-32 bg-blue-500/20 rounded-full -z-10 blur-xl"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Buttons Section -->
  <section class="py-12 bg-gray-50">
    <div class="main-container text-center">
      <div class="flex items-center gap-7 flex-wrap justify-center">
        <Button
          href="#booking"
          title="Join This Tour"
          buttonType="primary-btn"
        />
        <Button
          href="#journey"
          title="See the Tour"
          buttonType="secondary-btn"
        />
      </div>
    </div>
  </section>

  <!-- Quick Facts -->
  <Section>
    <div class="grid md:grid-cols-4 gap-6 text-center">
      {
        penangTourData.quickFacts.map((fact) => (
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-3xl font-bold text-primary mb-2">{fact.value}</div>
            <div class="text-sm text-gray-600">{fact.label}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- SECTION 2: Why This Location Matters (The Hook) -->
  <Section variant="light">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-h2 text-primary text-center mb-8">
        {penangTourData.whyPenangMatters.title}
      </h2>
      {
        penangTourData.whyPenangMatters.paragraphs.map((para) => (
          <p class="text-body mb-6 leading-relaxed text-center">{para}</p>
        ))
      }
    </div>
  </Section>

  <!-- SECTION 3: The Proof - One Deep Story (Insider Access) -->
  <Section>
    <ContentBlock
      layout="image-left"
      image={penangTourData.vendorSpotlight.image}
      imageAlt={`${penangTourData.vendorSpotlight.name}, ${penangTourData.vendorSpotlight.age}`}
      title={`Meet ${penangTourData.vendorSpotlight.name}, ${penangTourData.vendorSpotlight.age}`}
      titleTag="h2"
    >
      {
        penangTourData.vendorSpotlight.story.map((paragraph) => (
          <p class="text-body mb-4 leading-relaxed">{paragraph}</p>
        ))
      }
      <div class="mt-6 p-4 bg-blue-50 rounded-lg">
        <p class="text-sm text-gray-700 italic">
          <strong>What this means:</strong> We don't just visit vendors - we have
          relationships that give you access to stories, techniques, and personal
          histories most visitors never hear.
        </p>
      </div>
    </ContentBlock>
  </Section>

  <!-- SECTION 4: What Makes This Special -->
  <Section variant="light">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h2 class="text-h2 text-primary mb-4">
        {penangTourData.whatMakesSpecial.title}
      </h2>
      <p class="text-body">{penangTourData.whatMakesSpecial.intro}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {
        penangTourData.highlights.map((highlight) => (
          <Card>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary flex items-center justify-center mt-1">
                <svg
                  class="w-4 h-4 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </div>
              <p class="text-body flex-1">{highlight}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- SECTION 5: Transformation Journey (Your 5-Hour Journey) -->
  <Section id="journey">
    <h2 class="text-h2 text-primary text-center mb-12">
      Your 5-Hour Heritage Tour
    </h2>
    <div class="space-y-8 max-w-4xl mx-auto">
      {
        penangTourData.itinerary.map((stop, index) => (
          <Card>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div class="w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">
                  {stop.time}
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-h3 text-primary mb-3">{stop.title}</h3>
                <p class="text-body mb-4">{stop.description}</p>

                <div class="bg-gray-50 p-4 rounded-lg mb-3">
                  <strong class="text-gray-900">You'll Taste:</strong>
                  <ul class="list-disc list-inside text-body mt-2 space-y-1">
                    {stop.tastings.map((tasting) => (
                      <li>{tasting}</li>
                    ))}
                  </ul>
                </div>

                <p class="text-sm text-primary italic">
                  <strong>Why it matters:</strong> {stop.culturalContext}
                </p>
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- SECTION 6: Remove Friction (What's Included & Practical Info) -->
  <Section variant="light">
    <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
      <div>
        <h2 class="text-h2 text-primary mb-8">What's Included</h2>
        <div class="space-y-4">
          {
            penangTourData.included.map((item) => (
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-primary flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
                <span class="text-body">{item}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class="text-h2 text-primary mb-8">Not Included</h2>
        <div class="space-y-4">
          {
            penangTourData.notIncluded.map((item) => (
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-gray-400 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
                <span class="text-body text-gray-600">{item}</span>
              </div>
            ))
          }
        </div>

        <div class="mt-8 p-4 bg-blue-50 rounded-lg">
          <h3 class="font-semibold text-gray-900 mb-2">
            {penangTourData.dietary.title}
          </h3>
          <ul class="space-y-2 text-sm text-gray-700">
            {
              penangTourData.dietary.options.map((option) => (
                <li class="flex items-start gap-2">
                  <span class="text-primary">•</span>
                  <span>{option}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- What to Expect -->
  <Section>
    <h2 class="text-h2 text-primary text-center mb-12">What to Expect</h2>
    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {
        penangTourData.whatToExpect.map((expectation) => (
          <Card>
            <h3 class="text-h3 text-primary mb-3">{expectation.title}</h3>
            <p class="text-body">{expectation.description}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- FAQ Section -->
  <FAQ faqs={penangTourData.faqs} />

  <!-- SECTION 7: Social Proof (What Our Guests Say) -->
  <Section variant="light">
    <h2 class="text-h2 text-primary text-center mb-12">What Our Guests Say</h2>

    <!-- Stats -->
    <div class="grid md:grid-cols-4 gap-6 mb-12 max-w-5xl mx-auto">
      {
        penangTourData.stats.map((stat) => (
          <div class="text-center">
            <div class="text-4xl font-bold text-primary mb-2">
              {stat.number}
            </div>
            <div class="text-sm text-gray-600">{stat.label}</div>
          </div>
        ))
      }
    </div>

    <!-- Reviews -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        penangTourData.testimonials.map((review) => (
          <Card>
            <div class="flex items-center mb-4">
              <div class="flex text-orange">
                {[...Array(5)].map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                  </svg>
                ))}
              </div>
            </div>
            <p class="text-body mb-4 italic">"{review.text}"</p>
            <div class="text-sm">
              <strong>{review.name}</strong>
              <div class="text-gray-600">{review.location}</div>
              <div class="text-gray-500 text-xs mt-1">
                {review.source} •{" "}
                {new Date(review.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                })}
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- SECTION 8: Make Action Inevitable (Booking CTA) -->
  <Section id="booking" variant="accent">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-h2 text-primary mb-4">
        {penangTourData.bookingCta.title}
      </h2>
      <p class="text-body mb-8">{penangTourData.bookingCta.subtitle}</p>

      <div class="bg-white p-8 rounded-lg shadow-lg mb-8">
        <div class="flex items-center justify-center gap-8 mb-6 flex-wrap">
          <PriceTag
            amount={penangTourData.price}
            currency="RM"
            variant="large"
            label="per person"
          />
          <div class="text-left">
            <ul class="space-y-2 text-sm text-gray-700">
              {
                penangTourData.bookingCta.features.map((feature) => (
                  <li class="flex items-center gap-2">
                    <svg
                      class="w-4 h-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="flex gap-4 justify-center flex-wrap">
          <Button
            href="/contact"
            title={penangTourData.bookingCta.primaryButton}
            buttonType="primary-btn"
          />
          <Button
            href="https://wa.me/60172878929?text=I'm interested in Penang Heritage Food Trail"
            title={penangTourData.bookingCta.secondaryButton}
            buttonType="secondary-btn"
          />
        </div>
      </div>

      <!-- Persistent Booking Widget -->
      <BookingWidget
        price={penangTourData.price}
        widgetId={penangTourData.ticketingHubId}
        productName={penangTourData.name}
      />

      <div
        class="flex flex-wrap justify-center gap-6 text-sm pt-6 border-t border-gray-300"
      >
        <a
          href="/tours"
          class="text-primary hover:text-secondary transition-colors"
          >All Tours</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="/kuala-lumpur-food-tour"
          class="text-primary hover:text-secondary transition-colors"
          >KL Food Tours</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="/vegetarian-food-tours"
          class="text-primary hover:text-secondary transition-colors"
          >Vegetarian Options</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="/about"
          class="text-primary hover:text-secondary transition-colors"
          >About Simply Enak</a
        >
      </div>
    </div>
  </Section>
</Layout>
