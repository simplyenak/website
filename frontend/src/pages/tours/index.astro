---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import Button from "@/components/Button.astro";
import Badge from "@/components/Design/Badge.astro";
import FAQ from "@/components/FAQ.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import Icon from "@/components/Icon.astro";
import TourQuiz from "@/components/Tours/TourQuiz.astro";
import TestimonialCarousel from "@/components/Tours/TestimonialCarousel.astro";

export const prerender = true;

// Hero section
const hero = {
  title: "Choose Your Malaysian Food Adventure",
  subtitle:
    "Every path leads to authentic stories, family recipes, and cultural connections",
  description:
    "We're not tour operators—we're your temporary neighbors. For 14+ years, we've been walking guests through neighborhoods where we grew up eating, introducing them to vendors who've become family, and sharing the Malaysia we treasure. How would you like to explore?",
  backgroundImage: "/images/malaysian-food-hero.png",
};

// Location-based segments
const locationSegments = [
  {
    name: "Penang (Georgetown)",
    slug: "/tours/penang-segment",
    shortDescription: "UNESCO World Heritage street food capital",
    fullDescription:
      "Georgetown's food scene earned UNESCO recognition not by accident, but through generations of families perfecting their recipes. Hokkien, Teochew, and Peranakan communities created dishes you can't find anywhere else.",
    image:
      "https://se-website-images.s3.nl-ams.scw.cloud/penang-heritage-tour.jpg",
    available: true,
    badge: "Most Popular",
  },
  {
    name: "Kuala Lumpur",
    slug: "/tours/kuala-lumpur-segment",
    shortDescription: "Where three cultures meet on a plate",
    fullDescription:
      "In 1857, Chinese tin miners, Malay traders, and Indian Muslims converged at the muddy confluence of two rivers. Their cooking traditions didn't just coexist—they influenced each other.",
    image:
      "https://se-website-images.s3.nl-ams.scw.cloud/kl-chow-kit-market.jpg",
    available: true,
  },
  {
    name: "Melaka",
    slug: "/tours/melaka-cultural-food-journey",
    shortDescription: "Peranakan fusion capital of Malaysia",
    fullDescription:
      "When Chinese traders married Malay women in the 15th century, they created a unique culture—and a unique cuisine. Nyonya cooking blends Chinese techniques with Malay spices.",
    image:
      "https://se-website-images.s3.nl-ams.scw.cloud/melaka-cultural-tour.jpg",
    available: true,
  },
  {
    name: "Ipoh",
    slug: "/tours/ipoh-segment",
    shortDescription: "Old town hawker culture and white coffee heritage",
    fullDescription:
      "Ipoh's old town hasn't changed much since the tin mining boom. Family-run kopitiam serve Hainanese chicken rice the way it was meant to be.",
    image: "https://se-website-images.s3.nl-ams.scw.cloud/ipoh-old-town.jpg",
    available: true,
  },
  {
    name: "Klang",
    slug: "/tours/klang-segment",
    shortDescription: "Bak kut teh capital and royal Malay heritage",
    fullDescription:
      "Klang is where bak kut teh was born. This port town's Chinese laborers created the herbal pork rib soup that became a Malaysian obsession. But there's more—royal Malay cuisine and thriving Indian food scene.",
    image: "https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg",
    available: true,
  },
];

// Dietary preference segments
const dietarySegments = [
  {
    name: "Vegetarian & Vegan Heritage",
    slug: "/vegetarian-food-tours",
    shortDescription: "140 years of plant-based Malaysian tradition",
    fullDescription:
      "Most people don't know Malaysia has a 140-year vegetarian heritage. Buddhist temple kitchens, South Indian family recipes, and Peranakan innovation created a plant-based food culture that rivals any in Asia.",
    image:
      "https://se-website-images.s3.nl-ams.scw.cloud/vegetarian-heritage.jpg",
    available: true,
    badge: "Heritage Focus",
  },
  {
    name: "Halal-Certified Experiences",
    slug: "/contact",
    shortDescription: "All Malay & Muslim vendor tours",
    fullDescription:
      "Malaysia is a Muslim-majority country, which means exceptional halal food is everywhere. Our halal-certified tours focus on Malay kampung cooking and Muslim-Indian mamak traditions.",
    image: "https://se-website-images.s3.nl-ams.scw.cloud/halal-malay-food.jpg",
    available: false,
    badge: "Coming Soon",
  },
  {
    name: "All Dietary Needs Welcome",
    slug: "/contact",
    shortDescription: "We adapt every tour for your diet",
    fullDescription:
      "Allergies? Gluten-free? No pork? No problem. Every tour can be adapted for your dietary needs. We've been doing this for 14 years—we know which vendors can accommodate.",
    image:
      "https://se-website-images.s3.nl-ams.scw.cloud/dietary-adaptations.jpg",
    available: true,
  },
];

// Group & custom segments
const groupSegments = [
  {
    name: "Family Adventures",
    slug: "/contact",
    shortDescription: "Kid-friendly food, parent-approved experiences",
    fullDescription:
      "Traveling with children? We get it. We adapt dishes for young palates, pace the tour for small legs, and make sure everyone learns something.",
    image:
      "https://se-website-images.s3.nl-ams.scw.cloud/story-family-recipes.jpg",
    available: true,
  },
  {
    name: "Corporate Team Building",
    slug: "/contact",
    shortDescription: "Bonding over food, not trust falls",
    fullDescription:
      "Want your team to actually connect? Walk through hawker markets together. Learn to spot fresh ingredients. Debate whether char kway teow is better in Penang or KL.",
    image: "https://se-website-images.s3.nl-ams.scw.cloud/kl-street-food.jpg",
    available: true,
  },
  {
    name: "Special Celebrations",
    slug: "/contact",
    shortDescription: "Birthdays, anniversaries, reunions",
    fullDescription:
      "Celebrate milestones the Malaysian way: surrounded by food, family, and stories. We'll create an experience that matches the occasion.",
    image: "https://se-website-images.s3.nl-ams.scw.cloud/hari-raya-foods.jpg",
    available: true,
  },
  {
    name: "Fully Custom Itineraries",
    slug: "/contact",
    shortDescription: "Your vision, our local knowledge",
    fullDescription:
      "Have specific interests? Want to combine cities? Need multi-day experiences? We'll design a tour that exists nowhere else.",
    image: "https://se-website-images.s3.nl-ams.scw.cloud/story-heritage.jpg",
    available: true,
  },
];

// FAQ data
const faqs = [
  {
    question: "How do I decide which tour is right for me?",
    answer:
      "Start with location—which city interests you? Then consider your dietary needs and group type. If you're solo or a couple, join our regular tours. Families and groups of 6+ benefit from custom experiences. Still unsure? Contact us—we love helping people find their perfect Malaysian food adventure.",
  },
  {
    question: "What if I have dietary restrictions?",
    answer:
      "Every tour can be adapted. Vegetarian, vegan, halal, gluten-free, allergies—just tell us when booking. Our dedicated vegetarian heritage tours explore Malaysia's 140-year plant-based tradition. For other dietary needs, we work with vendors who can accommodate while maintaining authentic flavors.",
  },
  {
    question: "Do you offer tours in all these cities?",
    answer:
      "Currently running tours in Kuala Lumpur, Penang, and Melaka. Ipoh and specialized halal tours are coming soon. Want to be notified when they launch? Contact us and we'll add you to the list.",
  },
  {
    question: "What's included in the tour price?",
    answer:
      "All food tastings (8-10 different dishes), beverages, and your guide's time and knowledge. You'll eat enough to be comfortably full. Not included: transportation to the meeting point, alcoholic beverages (unless specified), or souvenirs.",
  },
  {
    question: "How long are the tours?",
    answer:
      "Regular tours run 3.5-4 hours. Custom tours can be shorter (2 hours) or longer (full day, multi-day). We pace based on your group—leisurely walks with plenty of time to chat with vendors and ask questions.",
  },
  {
    question: "Can we book a private tour?",
    answer:
      "Yes! Private tours work beautifully for families, corporate groups, celebrations, or anyone who wants a more intimate experience. Same great routes and vendors, but at your own pace with a guide dedicated to your group.",
  },
];

// SEO data
const seoData = {
  title: "Malaysian Food Tours | By Location, Diet & Group | Simply Enak",
  description:
    "Choose your Malaysian food adventure: explore by city (KL, Penang, Melaka), dietary preference (vegetarian, halal, all diets), or create a custom experience. Small groups, local guides, 14+ years sharing authentic food heritage.",
  image: hero.backgroundImage,
  structuredData: {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Simply Enak Food Tours",
    description:
      "Authentic Malaysian food and cultural experiences by location, dietary preference, and group type",
    url: "https://simplyenak.com/tours",
  },
};
---

<Layout
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  structuredData={seoData.structuredData}
>
  <GlobalHero
    title={hero.title}
    subtitle={hero.subtitle}
    description={hero.description}
    image={hero.backgroundImage}
    isOverlay={true}
  >
    <TourQuiz />
  </GlobalHero>

  <!-- Category Navigation -->
  <div
    class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-md transition-all duration-300"
  >
    <div class="max-w-4xl mx-auto px-4">
      <nav
        class="flex items-center justify-center gap-4 md:gap-12 overflow-x-auto py-5 text-base md:text-lg font-bold whitespace-nowrap scrollbar-hide"
      >
        <a
          href="#city"
          class="text-gray-600 hover:text-primary hover:bg-orange-50 px-4 py-2 rounded-full transition-all"
        >
          By City
        </a>
        <a
          href="#dietary"
          class="text-gray-600 hover:text-primary hover:bg-orange-50 px-4 py-2 rounded-full transition-all"
        >
          Dietary
        </a>
        <a
          href="#custom"
          class="text-gray-600 hover:text-primary hover:bg-orange-50 px-4 py-2 rounded-full transition-all"
        >
          Custom & Group
        </a>
      </nav>
    </div>
  </div>

  <!-- Breadcrumb Navigation -->
  <Section variant="light">
    <div class="max-w-4xl mx-auto">
      <nav
        class="flex items-center text-sm text-gray-600"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/tours" class="text-primary font-medium">Tours</a>
      </nav>
    </div>
  </Section>

  <!-- Section 1: Explore by City (Bento Grid) -->
  <Section variant="light" id="city">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-primary mb-4">Explore by City</h2>
        <p class="text-body">
          Every Malaysian city has its own food story. Choose your destination
          and discover why locals are passionate about their regional
          specialties.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[300px]">
      {
        locationSegments.map((location, index) => (
          <a
            href={location.slug}
            class:list={[
              "group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1",
              index === 0 ? "md:col-span-2 md:row-span-2" : "col-span-1 row-span-1"
            ]}
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={location.image}
                alt={location.name}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              {location.badge && (
                <div class="absolute top-6 left-6">
                  <Badge
                    variant="accent"
                    size={index === 0 ? "medium" : "small"}
                  >
                    {location.badge}
                  </Badge>
                </div>
              )}
              
              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3 class:list={[
                  "font-bold mb-2 leading-tight",
                  index === 0 ? "text-4xl md:text-5xl" : "text-2xl"
                ]}>
                  {location.name}
                </h3>
                
                <p class:list={[
                  "text-gray-200 mb-4 line-clamp-2",
                  index === 0 ? "text-lg max-w-xl" : "text-sm"
                ]}>
                  {location.fullDescription}
                </p>
                
                <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-wider text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">
                  <span>Explore Tour</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Section 2: Dietary Preferences -->
  <Section id="dietary">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-primary mb-4">Dietary Preferences</h2>
        <p class="text-body">
          Every diet has a story in Malaysia. Whether you're vegetarian,
          halal-observant, or have specific dietary needs, you'll discover a
          rich culinary heritage designed for you.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[300px]">
      {
        dietarySegments.map((segment, index) => (
          <a
            href={segment.slug}
            class:list={[
              "group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1",
              index === 0 ? "md:col-span-2 md:row-span-2" : "col-span-1 row-span-1"
            ]}
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={segment.image}
                alt={segment.name}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              {segment.badge && (
                <div class="absolute top-6 left-6">
                  <Badge
                    variant="accent"
                    size={index === 0 ? "medium" : "small"}
                  >
                    {segment.badge}
                  </Badge>
                </div>
              )}
              
              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3 class:list={[
                  "font-bold mb-2 leading-tight",
                  index === 0 ? "text-4xl md:text-5xl" : "text-2xl"
                ]}>
                  {segment.name}
                </h3>
                
                <p class:list={[
                  "text-gray-200 mb-4 line-clamp-2",
                  index === 0 ? "text-lg max-w-xl" : "text-sm"
                ]}>
                  {segment.fullDescription}
                </p>
                
                <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-wider text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">
                  <span>View Details</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Section 3: Custom & Group -->
  <Section variant="accent" id="custom">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-primary mb-4">Custom & Group Experiences</h2>
        <p class="text-body">
          Sometimes the best experiences are the ones designed specifically for
          you. Whether you're celebrating, team-building, or traveling with
          family, we'll create something perfect.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-[300px]">
      {
        groupSegments.map((segment) => (
          <a
            href={segment.slug}
            class="group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={segment.image}
                alt={segment.name}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3 class="text-2xl font-bold mb-2 leading-tight">
                  {segment.name}
                </h3>
                
                <p class="text-sm text-gray-200 mb-4 line-clamp-2">
                  {segment.fullDescription}
                </p>
                
                <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-wider text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">
                  <span>Plan This</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Social Proof Section -->
  <Section variant="light">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h2 class="text-h2 text-primary mb-4">What Our Guests Say</h2>
      <p class="text-body">
        Don't just take our word for it. Here's what travelers from around the world experienced.
      </p>
    </div>
    <TestimonialCarousel />
  </Section>

  <!-- Why Simply Enak -->
  <Section>
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-h2 text-primary mb-6">Why Simply Enak?</h2>
      <p class="text-body mb-8 leading-relaxed">
        We're not tour operators—we're your temporary neighbors in Malaysia. For
        over 14 years, we've been sharing the places and flavors we grew up
        eating, introducing guests to vendors who've become family, and
        revealing the stories behind every dish. Come as a guest, leave as a
        friend who sees, feels, and can taste the difference between tourist
        Malaysia and the Malaysia we treasure.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
        <!-- Feature 1 -->
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 rounded-2xl bg-orange-100 text-primary flex items-center justify-center mb-4 transform transition-transform group-hover:scale-110 group-hover:rotate-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">14+ Years</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Sharing Malaysian food heritage since 2011 with passion and pride.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 rounded-2xl bg-orange-100 text-primary flex items-center justify-center mb-4 transform transition-transform group-hover:scale-110 group-hover:-rotate-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Small Groups</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Maximum 8 guests per tour for an intimate, personal experience.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 rounded-2xl bg-orange-100 text-primary flex items-center justify-center mb-4 transform transition-transform group-hover:scale-110 group-hover:rotate-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">5-Star Rated</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            TripAdvisor Travellers' Choice Award Winner year after year.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 rounded-2xl bg-orange-100 text-primary flex items-center justify-center mb-4 transform transition-transform group-hover:scale-110 group-hover:-rotate-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Unscripted</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            No canned jokes or tourist traps. Just real, authentic connections.
          </p>
        </div>
      </div>

      <div
        class="flex flex-wrap justify-center gap-6 text-sm pt-6 border-t border-gray-300/50"
      >
        <a
          href="/about"
          class="text-primary hover:text-secondary transition-colors font-semibold"
          >About Us</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="/contact"
          class="text-primary hover:text-secondary transition-colors font-semibold"
          >Contact Us</a
        >
        <span class="text-gray-400">•</span>
        <a
          href="tel:+60172878929"
          class="text-primary hover:text-secondary transition-colors font-semibold"
          >+60 17-287 8929</a
        >
      </div>
    </div>
  </Section>

  <!-- Newsletter / CTA -->
  <Section variant="light">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-h2 text-primary mb-4">Hungry for More?</h2>
      <p class="text-body mb-8 max-w-2xl mx-auto">
        Join our newsletter to get the latest food stories, travel tips, and
