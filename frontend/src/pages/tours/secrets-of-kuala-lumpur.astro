---
import Layout from "../../layouts/Layout.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import ContentBlock from "@/components/Design/ContentBlock.astro";
import PriceTag from "@/components/Design/PriceTag.astro";
import Badge from "@/components/Design/Badge.astro";
import Button from "@/components/Button.astro";
import FAQ from "@/components/FAQ.astro";
import { Image } from "astro:assets";
import heroImage from "@/assets/images/6.jpg";

import {
  klSecretsTourData,
  klSecretsTourSchema,
} from "@/data/secrets-of-kuala-lumpur";
import TourSidebar from "@/components/Tours/TourSidebar.astro";
import MediaGallery from "@/components/Design/MediaGallery.astro";
import Comments from "@/components/Comments.astro";
import TourHighlights from "@/components/Tours/TourHighlights.astro";

// Gallery Images
import galleryImg1 from "@/assets/images/6.jpg";
import galleryImg2 from "@/assets/images/7.jpg";
import galleryImg3 from "@/assets/images/9.webp";
import galleryImg4 from "@/assets/images/bg1.jpg";
import galleryImg5 from "@/assets/images/bg2.jpg";

const galleryItems: { type: "image" | "video"; src: any; alt: string }[] = [
  { type: "image", src: galleryImg1, alt: "Authentic street food" },
  { type: "image", src: galleryImg2, alt: "Night market vibes" },
  { type: "image", src: galleryImg3, alt: "Fresh ingredients" },
  { type: "image", src: galleryImg4, alt: "Family dining" },
  { type: "image", src: galleryImg5, alt: "Heritage architecture" },
];
---

<Layout
  title={klSecretsTourData.metaTitle}
  description={klSecretsTourData.metaDescription}
  image={klSecretsTourData.hero.image}
  structuredData={klSecretsTourSchema}
>
  <!-- Split Layout Hero -->
  <section
    class="relative pt-32 pb-12 md:pt-40 md:pb-20 overflow-hidden bg-[#1a1a1a] text-white"
  >
    <div class="main-container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Text Content -->
        <div class="relative z-10 order-2 lg:order-1">
          <Badge variant="accent" customClasses="mb-6"
            >Bestseller • 4 Hours</Badge
          >
          <h1
            class="text-5xl md:text-7xl font-bold text-white mb-6 leading-tight tracking-tight"
          >
            {klSecretsTourData.hero.title}
          </h1>
          <p
            class="text-xl md:text-2xl text-gray-300 mb-8 font-light leading-relaxed"
          >
            {klSecretsTourData.hero.subtitle}
          </p>
          <div
            class="flex items-center gap-4 text-sm font-medium text-gray-400 mb-8"
          >
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="text-gray-600">/</span>
            <a href="/tours" class="hover:text-white transition-colors">Tours</a
            >
            <span class="text-gray-600">/</span>
            <span class="text-primary">Secrets of Kuala Lumpur</span>
          </div>
        </div>

        <!-- Hero Image -->
        <div
          class="relative order-1 lg:order-2 flex justify-center lg:justify-end"
        >
          <div
            class="relative rounded-[2rem] overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-700 ease-out max-w-[90%] lg:max-w-full"
          >
            <div
              class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent z-10 mix-blend-overlay"
            >
            </div>
            <Image
              src={heroImage}
              alt="Secrets of Kuala Lumpur Tour"
              class="w-full h-[400px] lg:h-[450px] object-cover"
              width={800}
              height={600}
            />
          </div>
          <!-- Decorative Elements -->
          <div
            class="absolute -bottom-6 -left-6 w-24 h-24 bg-orange-500/20 rounded-full -z-10 blur-xl"
          >
          </div>
          <div
            class="absolute -top-6 -right-6 w-32 h-32 bg-blue-500/20 rounded-full -z-10 blur-xl"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Buttons Section -->
  <section class="py-12 bg-gray-50">
    <div class="main-container text-center">
      <div class="flex items-center gap-7 flex-wrap justify-center">
        <Button href="#booking" title="Book Now" buttonType="primary-btn" />
        <Button
          href="#journey"
          title="See the Itinerary"
          buttonType="secondary-btn"
        />
      </div>
    </div>
  </section>

  <!-- Tour Highlights Bar -->
  <section class="main-container -mt-6 relative z-20">
    <TourHighlights
      duration="4 Hours"
      groupSize="Max 8"
      minAge="12+"
      walkingLevel="Moderate"
      alcohol={false}
      vegetarian={true}
      halal={true}
      timing="Evening"
      privateAvailable={true}
    />
  </section>

  <!-- Main Content & Sidebar Layout -->
  <div class="main-container grid lg:grid-cols-12 gap-12 my-12">
    <!-- Left Column: Content -->
    <div class="lg:col-span-8 space-y-16">
      <!-- SECTION 2: Why This Location Matters (The Hook) -->
      <div id="why-it-matters">
        <h2 class="text-h2 text-primary mb-8">
          {klSecretsTourData.whyKLSecretsMatter.title}
        </h2>
        {
          klSecretsTourData.whyKLSecretsMatter.paragraphs.map((para) => (
            <p class="text-body mb-6 leading-relaxed">{para}</p>
          ))
        }
      </div>

      <!-- SECTION 3: The Proof - One Deep Story (Insider Access) -->
      <div>
        <ContentBlock
          layout="image-left"
          image={klSecretsTourData.vendorSpotlight.image}
          imageAlt={`${klSecretsTourData.vendorSpotlight.name}, ${klSecretsTourData.vendorSpotlight.age}`}
          title={`Meet ${klSecretsTourData.vendorSpotlight.name}, ${klSecretsTourData.vendorSpotlight.age}`}
          titleTag="h2"
        >
          {
            klSecretsTourData.vendorSpotlight.story.map((paragraph) => (
              <p class="text-body mb-4 leading-relaxed">{paragraph}</p>
            ))
          }
          <div class="mt-6 p-4 bg-blue-50 rounded-lg">
            <p class="text-sm text-gray-700 italic">
              <strong>What this means:</strong> We don't just visit vendors - we
              have relationships that give you access to stories, techniques, and
              personal histories most visitors never hear.
            </p>
          </div>
        </ContentBlock>
      </div>

      <!-- SECTION 4: What Makes This Special -->
      <div class="bg-gray-50 p-8 rounded-2xl">
        <div class="text-center mb-8">
          <h2 class="text-h2 text-primary mb-4">
            {klSecretsTourData.whatMakesSpecial.title}
          </h2>
          <p class="text-body">{klSecretsTourData.whatMakesSpecial.intro}</p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {
            klSecretsTourData.highlights.map((highlight) => (
              <Card>
                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary flex items-center justify-center mt-1">
                    <svg
                      class="w-4 h-4 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  <p class="text-body flex-1">{highlight}</p>
                </div>
              </Card>
            ))
          }
        </div>
      </div>

      <!-- Media Gallery -->
      <MediaGallery
        items={galleryItems}
        title="A Glimpse of the Experience"
        description="See what awaits you on the streets of Kuala Lumpur."
      />

      <!-- SECTION 5: Transformation Journey (Your 4-Hour Journey) -->
      <div id="journey">
        <h2 class="text-h2 text-primary mb-8">Your 4-Hour Journey</h2>
        <div class="space-y-8">
          {
            klSecretsTourData.itinerary.map((stop, index) => (
              <Card>
                <div class="flex gap-6">
                  <div class="flex-shrink-0">
                    <div class="w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">
                      {stop.time}
                    </div>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-h3 text-primary mb-3">{stop.title}</h3>
                    <p class="text-body mb-4">{stop.description}</p>

                    <div class="bg-gray-50 p-4 rounded-lg mb-3">
                      <strong class="text-gray-900">You'll Taste:</strong>
                      <ul class="list-disc list-inside text-body mt-2 space-y-1">
                        {stop.tastings.map((tasting) => (
                          <li>{tasting}</li>
                        ))}
                      </ul>
                    </div>

                    <p class="text-sm text-primary italic">
                      <strong>Why it matters:</strong> {stop.culturalContext}
                    </p>
                  </div>
                </div>
              </Card>
            ))
          }
        </div>
      </div>

      <!-- SECTION 6: Remove Friction (What's Included & Practical Info) -->
      <div class="bg-gray-50 p-8 rounded-2xl">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="text-h2 text-primary mb-8">What's Included</h2>
            <div class="space-y-4">
              {
                klSecretsTourData.included.map((item) => (
                  <div class="flex items-start gap-3">
                    <svg
                      class="w-6 h-6 text-primary flex-shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span class="text-body">{item}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <h2 class="text-h2 text-primary mb-8">Not Included</h2>
            <div class="space-y-4">
              {
                klSecretsTourData.notIncluded.map((item) => (
                  <div class="flex items-start gap-3">
                    <svg
                      class="w-6 h-6 text-gray-400 flex-shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"
                      />
                    </svg>
                    <span class="text-body text-gray-600">{item}</span>
                  </div>
                ))
              }
            </div>

            <div class="mt-8 p-4 bg-blue-50 rounded-lg">
              <h3 class="font-semibold text-gray-900 mb-2">
                {klSecretsTourData.dietary.title}
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                {
                  klSecretsTourData.dietary.options.map((option) => (
                    <li class="flex items-start gap-2">
                      <span class="text-primary">•</span>
                      <span>{option}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- What to Expect -->
      <div>
        <h2 class="text-h2 text-primary mb-8">What to Expect</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {
            klSecretsTourData.whatToExpect.map((expectation) => (
              <Card>
                <h3 class="text-h3 text-primary mb-3">{expectation.title}</h3>
                <p class="text-body">{expectation.description}</p>
              </Card>
            ))
          }
        </div>
      </div>

      <!-- FAQ Section -->
      <div>
        <FAQ faqs={klSecretsTourData.faqs} />
      </div>

      <!-- SECTION 7: Social Proof (What Our Guests Say) -->
      <div class="bg-gray-50 p-8 rounded-2xl">
        <h2 class="text-h2 text-primary text-center mb-12">
          What Our Guests Say
        </h2>

        <!-- Stats -->
        <div class="grid md:grid-cols-4 gap-6 mb-12">
          {
            klSecretsTourData.stats.map((stat) => (
              <div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">
                  {stat.number}
                </div>
                <div class="text-sm text-gray-600">{stat.label}</div>
              </div>
            ))
          }
        </div>

        <!-- Reviews -->
        <div class="grid md:grid-cols-2 gap-8">
          {
            klSecretsTourData.testimonials.map((review) => (
              <Card>
                <div class="flex items-center mb-4">
                  <div class="flex text-orange">
                    {[...Array(5)].map(() => (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                      </svg>
                    ))}
                  </div>
                </div>
                <p class="text-body mb-4 italic">"{review.text}"</p>
                <div class="text-sm">
                  <strong>{review.name}</strong>
                  <div class="text-gray-600">{review.location}</div>
                  <div class="text-gray-500 text-xs mt-1">
                    {review.source} •{" "}
                    {new Date(review.date).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                    })}
                  </div>
                </div>
              </Card>
            ))
          }
        </div>
      </div>

      <!-- Comments Section -->
      <Comments />
    </div>

    <!-- Right Column: Sidebar -->
    <div class="lg:col-span-4 relative">
      <TourSidebar
        price={klSecretsTourData.price}
        widgetId={klSecretsTourData.ticketingHubId}
        productName={klSecretsTourData.name}
      />
    </div>
  </div>
</Layout>
