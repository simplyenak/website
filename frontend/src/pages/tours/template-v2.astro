---
import Layout from "../../layouts/Layout.astro";
import Section from "@/components/Design/Section.astro";
import Card from "@/components/Design/Card.astro";
import ContentBlock from "@/components/Design/ContentBlock.astro";
import PriceTag from "@/components/Design/PriceTag.astro";
import Badge from "@/components/Design/Badge.astro";
import Button from "@/components/Button.astro";
import FAQ from "@/components/FAQ.astro";
import GlobalHero from "@/components/GlobalHero.astro";

import {
  klSecretsTourData,
  klSecretsTourSchema,
} from "@/data/secrets-of-kuala-lumpur";

// Enhanced Schema with Aggregate Rating
const enhancedSchema = {
  ...klSecretsTourSchema,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": klSecretsTourData.aggregateRating?.ratingValue || "5",
    "reviewCount": klSecretsTourData.aggregateRating?.reviewCount || "100"
  }
};

export const prerender = true;
---

<Layout
  title={klSecretsTourData.metaTitle}
  description={klSecretsTourData.metaDescription}
  image={klSecretsTourData.hero.image}
  structuredData={enhancedSchema}
>
  <!-- Sticky Booking Bar (Mobile Only) -->
  <div class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 p-4 md:hidden shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)]">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">From</p>
        <p class="text-lg font-bold text-primary">RM {klSecretsTourData.price}</p>
      </div>
      <Button href="#booking" title="Book Now" buttonType="primary-btn" customClasses="!py-2 !px-6 !text-sm" />
    </div>
  </div>

  <!-- Hero Section -->
  <div class="relative h-[85vh] min-h-[600px] flex items-center justify-center overflow-hidden">
    <!-- Background Image with Gradient -->
    <div class="absolute inset-0 z-0">
      <img 
        src={klSecretsTourData.hero.image} 
        alt={klSecretsTourData.hero.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/80"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 main-container text-center text-white mt-16">
      <Badge variant="accent" size="large" customClasses="mb-6 mx-auto">Evening Food Adventure</Badge>
      <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight tracking-tight">
        {klSecretsTourData.hero.title}
      </h1>
      <p class="text-xl md:text-2xl text-gray-200 mb-8 max-w-3xl mx-auto font-light leading-relaxed">
        {klSecretsTourData.hero.subtitle}
      </p>
      
      <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6">
        <Button
          href="#booking"
          title="Check Availability"
          buttonType="primary-btn"
          customClasses="!text-lg !px-8 !py-4 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all"
        />
        <Button
          href="#journey"
          title="See the Journey"
          buttonType="secondary-btn"
          customClasses="!bg-white/10 !text-white !border-white/30 hover:!bg-white/20 backdrop-blur-sm"
        />
      </div>

      <!-- Social Proof Snippet -->
      <div class="mt-12 flex items-center justify-center gap-2 text-sm md:text-base text-gray-300">
        <div class="flex text-orange-400">
          {[...Array(5)].map(() => (
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
              <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
            </svg>
          ))}
        </div>
        <span class="font-semibold text-white">4.9/5</span>
        <span>from 1,000+ happy guests</span>
      </div>
    </div>
  </div>

  <!-- Quick Facts Bar -->
  <div class="bg-white border-b border-gray-100 relative z-20 -mt-2 rounded-t-3xl md:rounded-none shadow-lg md:shadow-none">
    <div class="main-container py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-12">
        {klSecretsTourData.quickFacts.map((fact) => (
          <div class="flex items-center gap-4 justify-center md:justify-start">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
               <!-- Icon placeholder based on label -->
               {fact.label === "Duration" && <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>}
               {fact.label === "Group Size" && <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>}
               {fact.label === "Starting Time" && <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>}
               {fact.label === "Price" && <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>}
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">{fact.label}</p>
              <p class="text-lg font-bold text-gray-900">{fact.value}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- The Hook: Why This Matters -->
  <Section variant="light" customClasses="!py-20">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 leading-tight">
        {klSecretsTourData.whyKLSecretsMatter.title}
      </h2>
      <div class="prose prose-lg mx-auto text-gray-600">
        {klSecretsTourData.whyKLSecretsMatter.paragraphs.map((para) => (
          <p class="mb-6 leading-relaxed">{para}</p>
        ))}
      </div>
    </div>
  </Section>

  <!-- Visual Itinerary: The Journey -->
  <Section id="journey" customClasses="!py-24">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <Badge variant="accent" customClasses="mb-4">The Experience</Badge>
        <h2 class="text-3xl md:text-5xl font-bold text-primary mb-6">Your Evening Journey</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">A curated 4-hour adventure through the hidden heart of Kuala Lumpur.</p>
      </div>

      <div class="relative">
        <!-- Vertical Line -->
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gray-200 transform md:-translate-x-1/2"></div>

        <div class="space-y-12">
          {klSecretsTourData.itinerary.map((stop, index) => (
            <div class={`relative flex flex-col md:flex-row gap-8 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
              
              <!-- Timeline Dot -->
              <div class="absolute left-4 md:left-1/2 top-0 w-4 h-4 rounded-full bg-primary border-4 border-white shadow-md transform -translate-x-1/2 z-10"></div>
              
              <!-- Time Label (Mobile: Next to dot, Desktop: Center) -->
              <div class="absolute left-10 md:left-1/2 top-0 transform md:-translate-x-1/2 md:-translate-y-8 bg-white px-3 py-1 rounded-full border border-gray-100 shadow-sm text-sm font-bold text-primary z-10">
                {stop.time}
              </div>

              <!-- Content -->
              <div class="ml-12 md:ml-0 md:w-1/2 md:px-12">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                  <h3 class="text-xl font-bold text-primary mb-3">{stop.title}</h3>
                  <p class="text-gray-600 mb-4 leading-relaxed">{stop.description}</p>
                  
                  <div class="bg-orange-50 p-4 rounded-xl mb-4">
                    <p class="text-sm font-bold text-orange-800 mb-2 flex items-center gap-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18zm-3-9v-2a2 2 0 00-2-2H8a2 2 0 00-2 2v2h12z"></path></svg>
                      You'll Taste
                    </p>
                    <ul class="text-sm text-gray-700 space-y-1">
                      {stop.tastings.map(tasting => (
                        <li class="flex items-start gap-2">
                          <span class="text-orange-400 mt-1">•</span>
                          {tasting}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <p class="text-xs text-gray-500 italic border-l-2 border-primary/20 pl-3">
                    {stop.culturalContext}
                  </p>
                </div>
              </div>
              
              <!-- Empty side for desktop balance -->
              <div class="hidden md:block md:w-1/2"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- Insider Access: The Vendor Spotlight -->
  <Section variant="light" customClasses="!py-24">
    <div class="max-w-6xl mx-auto">
      <div class="bg-white rounded-3xl overflow-hidden shadow-xl">
        <div class="grid md:grid-cols-2">
          <div class="relative h-64 md:h-auto">
            <img 
              src={klSecretsTourData.vendorSpotlight.image} 
              alt={klSecretsTourData.vendorSpotlight.name}
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent md:hidden"></div>
            <div class="absolute bottom-4 left-4 text-white md:hidden">
              <p class="text-sm font-bold uppercase tracking-wider opacity-80">Meet the Legend</p>
              <h3 class="text-2xl font-bold">{klSecretsTourData.vendorSpotlight.name}</h3>
            </div>
          </div>
          <div class="p-8 md:p-12 flex flex-col justify-center">
            <div class="hidden md:block mb-6">
              <Badge variant="outline">Insider Access</Badge>
            </div>
            <h2 class="hidden md:block text-3xl font-bold text-primary mb-6">
              Meet {klSecretsTourData.vendorSpotlight.name}, {klSecretsTourData.vendorSpotlight.age}
            </h2>
            <div class="space-y-4 text-gray-600 leading-relaxed mb-8">
              {klSecretsTourData.vendorSpotlight.story.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
              <p class="text-blue-900 font-medium italic">
                "We don't just point out tourist spots—we have relationships with families like Pak Hassan's who share why they fight to preserve their heritage."
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Highlights Grid -->
  <Section>
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-primary text-center mb-12">Why Guests Love This Tour</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {klSecretsTourData.highlights.map((highlight) => (
          <div class="flex items-start gap-4 p-4 rounded-xl hover:bg-gray-50 transition-colors">
            <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 flex-shrink-0 mt-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <p class="text-lg text-gray-700">{highlight}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Social Proof: Reviews -->
  <Section variant="light" customClasses="!py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary mb-4">Don't Just Take Our Word For It</h2>
        <div class="flex items-center justify-center gap-2 text-orange-400 mb-2">
          {[...Array(5)].map(() => (
            <svg class="w-6 h-6 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" /></svg>
          ))}
        </div>
        <p class="text-gray-600">Rated 4.9/5 by over 1,000+ happy guests on TripAdvisor & Google</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {klSecretsTourData.testimonials.map((review) => (
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full">
            <div class="flex items-center gap-1 text-orange-400 mb-6">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" /></svg>
              ))}
            </div>
            <p class="text-gray-700 italic mb-6 flex-grow leading-relaxed">"{review.text}"</p>
            <div class="flex items-center gap-4 mt-auto pt-6 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 font-bold text-sm">
                {review.name.charAt(0)}
              </div>
              <div>
                <p class="font-bold text-gray-900 text-sm">{review.name}</p>
                <p class="text-xs text-gray-500">{review.location}</p>
              </div>
              <div class="ml-auto text-xs text-gray-400 font-medium px-2 py-1 bg-gray-50 rounded">
                {review.source}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Booking Section -->
  <Section id="booking" customClasses="!py-24 bg-primary text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/pattern.png')] opacity-10"></div>
    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">{klSecretsTourData.bookingCta.title}</h2>
      <p class="text-xl text-blue-100 mb-12 max-w-2xl mx-auto">{klSecretsTourData.bookingCta.subtitle}</p>

      <div class="bg-white text-gray-900 rounded-3xl p-8 md:p-12 shadow-2xl max-w-3xl mx-auto">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-8 border-b border-gray-100 pb-8">
          <div class="text-left">
            <p class="text-sm text-gray-500 uppercase tracking-wider font-bold mb-1">Total Price</p>
            <div class="flex items-baseline gap-2">
              <span class="text-5xl font-bold text-primary">RM {klSecretsTourData.price}</span>
              <span class="text-gray-500">per person</span>
            </div>
          </div>
          <div class="flex flex-col gap-2 w-full md:w-auto">
             <Button
              href="/contact"
              title="Check Availability"
              buttonType="primary-btn"
              customClasses="!w-full !justify-center !text-lg !py-4"
            />
            <p class="text-xs text-center text-gray-400 mt-2">Instant confirmation • Free cancellation 24h before</p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-4 text-left">
          {klSecretsTourData.bookingCta.features.map((feature) => (
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-700">{feature}</span>
            </div>
          ))}
        </div>

        <!-- TicketingHub Widget -->
        <div class="mt-8">
            <script is:inline src="https://assets.ticketinghub.com/checkout.js" data-widget={klSecretsTourData.ticketingHubId}></script>
        </div>
      </div>
      
      <div class="mt-12">
        <p class="text-blue-200 mb-4">Have questions before booking?</p>
        <a href="https://wa.me/60172878929" class="inline-flex items-center gap-2 text-white hover:text-blue-200 transition-colors font-semibold">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </Section>

  <!-- FAQ Section -->
  <FAQ faqs={klSecretsTourData.faqs} />

</Layout>
