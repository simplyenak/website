---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout>
  <main>
    <div class="container mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold text-center">Kuala Lumpur Food Tour</h1>
      <p class="text-center mt-4">Discover Kuala Lumpur's amazing food heritage!</p>
      <p class="text-center mt-4">This is a simple test page to verify routing works.</p>
    </div>
  </main>
</Layout>