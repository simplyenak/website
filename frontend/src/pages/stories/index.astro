---
import Layout from "@/layouts/Layout.astro";
import GlobalHero from "@/components/GlobalHero.astro";
import Section from "@/components/Design/Section.astro";
import Badge from "@/components/Design/Badge.astro";
import Button from "@/components/Button.astro";
import { stories } from "@/data/stories-data";

export const prerender = true;

// Hero section
const hero = {
  title: "Malaysian Food Stories",
  subtitle:
    "Where food meets culture, history, and the people who keep traditions alive",
  image:
    "https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg",
};

// SEO data
const seoData = {
  title: "Malaysian Food Stories & Cultural Heritage | Simply Enak",
  description:
    "Discover the stories behind Malaysian food culture—from family recipes passed down through generations to the heritage that shapes our cuisine today.",
  image: hero.image,
};

// Format date for display
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// Filter stories for each section
const vendorStories = stories.filter((s) =>
  s.categories.includes("People & Stories")
);
const expertStories = stories.filter(
  (s) =>
    s.categories.includes("Food Culture") || s.categories.includes("Travel Tips")
);
const cultureStories = stories.filter((s) =>
  s.categories.includes("Culture & Heritage")
);
---

<Layout
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
>
  <!-- Hero Section -->
  <GlobalHero
    title={hero.title}
    subtitle={hero.subtitle}
    image={hero.image}
    isOverlay={true}
  />

  <!-- Category Navigation -->
  <div
    class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-md transition-all duration-300"
  >
    <div class="max-w-4xl mx-auto px-4">
      <nav
        class="flex items-center justify-center gap-4 md:gap-12 overflow-x-auto py-5 text-base md:text-lg font-bold whitespace-nowrap scrollbar-hide"
      >
        <a
          href="#vendor-stories"
          class="text-gray-600 hover:text-primary hover:bg-orange-50 px-4 py-2 rounded-full transition-all"
        >
          Vendor Stories
        </a>
        <a
          href="#insider-expertise"
          class="text-gray-600 hover:text-primary hover:bg-orange-50 px-4 py-2 rounded-full transition-all"
        >
          Insider Expertise
        </a>
        <a
          href="#culture"
          class="text-gray-600 hover:text-primary hover:bg-orange-50 px-4 py-2 rounded-full transition-all"
        >
          Culture & Heritage
        </a>
      </nav>
    </div>
  </div>

  <!-- Breadcrumb Navigation -->
  <Section variant="light">
    <div class="max-w-4xl mx-auto">
      <nav
        class="flex items-center text-sm text-gray-600"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/stories/" class="text-primary font-medium">Stories</a>
      </nav>
    </div>
  </Section>

  <!-- Section 1: Meet the Heritage Keepers (Vendor Stories) -->
  <Section variant="light" id="vendor-stories">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-primary mb-4">Meet the Heritage Keepers</h2>
        <p class="text-body">
          The real stars of Malaysian cuisine aren't chefs—they're the aunties
          and uncles who have perfected one dish over a lifetime.
        </p>
      </div>
      <Button
        href="/stories/archive/"
        title="View All"
        buttonType="secondary-btn-small"
        class="hidden md:inline-flex"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[300px]">
      {
        vendorStories.slice(0, 5).map((story, index) => (
          <a
            href={`/stories/${story.slug}/`}
            class:list={[
              "group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1",
              index === 0
                ? "md:col-span-2 md:row-span-2"
                : "col-span-1 row-span-1",
            ]}
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={story.image}
                alt={story.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <div class="absolute top-6 left-6">
                <Badge
                  variant={index === 0 ? "accent" : "secondary"}
                  size={index === 0 ? "medium" : "small"}
                >
                  Vendor Story
                </Badge>
              </div>

              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3
                  class:list={[
                    "font-bold mb-2 leading-tight",
                    index === 0 ? "text-3xl md:text-4xl" : "text-xl",
                  ]}
                >
                  {story.title}
                </h3>

                {index === 0 && (
                  <p class="text-gray-200 mb-4 line-clamp-2 text-lg max-w-xl">
                    {story.excerpt}
                  </p>
                )}

                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-gray-300 font-medium uppercase tracking-wider">
                    {formatDate(story.date)}
                  </span>
                  <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-wider text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <span>Read Story</span>
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Section 2: Insider Expertise -->
  <Section id="insider-expertise">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-primary mb-4">Insider Expertise</h2>
        <p class="text-body">
          How to eat like a local, spot a tourist trap, and understand the
          complex history on your plate.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[300px]">
      {
        expertStories.slice(0, 3).map((story, index) => (
          <a
            href={`/stories/${story.slug}/`}
            class:list={[
              "group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1",
              index === 0
                ? "md:col-span-2 md:row-span-2"
                : "col-span-1 row-span-1",
            ]}
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={story.image}
                alt={story.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <div class="absolute top-6 left-6">
                <Badge variant="secondary" size="small">
                  Expert Guide
                </Badge>
              </div>

              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3
                  class:list={[
                    "font-bold mb-2 leading-tight",
                    index === 0 ? "text-3xl md:text-4xl" : "text-xl",
                  ]}
                >
                  {story.title}
                </h3>

                {index === 0 && (
                  <p class="text-gray-200 mb-4 line-clamp-2 text-lg max-w-xl">
                    {story.excerpt}
                  </p>
                )}

                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-gray-300 font-medium uppercase tracking-wider">
                    {formatDate(story.date)}
                  </span>
                  <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-wider text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <span>Read Story</span>
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Section 3: Malaysian Culture 101 -->
  <Section variant="accent" id="culture">
    <div class="flex justify-between items-end mb-12">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-primary mb-4">Malaysian Culture 101</h2>
        <p class="text-body">
          Deep dives into the festivals, traditions, and communities that make
          Malaysia unique.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-[300px]">
      {
        cultureStories.slice(0, 2).map((story) => (
          <a
            href={`/stories/${story.slug}/`}
            class="group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
          >
            <!-- Background Image -->
            <div class="absolute inset-0">
              <img
                src={story.image}
                alt={story.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-white">
              <div class="absolute top-6 left-6">
                <Badge variant="accent" size="small">
                  Culture
                </Badge>
              </div>

              <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <h3 class="text-2xl font-bold mb-2 leading-tight">
                  {story.title}
                </h3>

                <p class="text-gray-200 mb-4 line-clamp-2 text-sm">
                  {story.excerpt}
                </p>

                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-gray-300 font-medium uppercase tracking-wider">
                    {formatDate(story.date)}
                  </span>
                  <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-wider text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <span>Read Story</span>
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Newsletter / CTA -->
  <Section variant="light">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-h2 text-primary mb-4">Hungry for More?</h2>
      <p class="text-body mb-8 max-w-2xl mx-auto">
        Join our newsletter to get the latest food stories, travel tips, and
        exclusive tour offers delivered straight to your inbox. No spam, just
        delicious content.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center max-w-md mx-auto mb-12"
      >
        <input
          type="email"
          placeholder="Your email address"
          class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-primary flex-grow"
        />
        <button
          class="bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-secondary transition-colors whitespace-nowrap"
        >
          Subscribe
        </button>
      </div>
    </div>
  </Section>

  <style>
    /* Hide scrollbar for navigation */
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</Layout>
