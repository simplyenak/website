---
import StoriesCardsSection from "@/components/Stories/StoriesCardsSection.tsx";
import Layout from "@/layouts/Layout.astro";
import StoriesSidebar from "@/components/Stories/StoriesSidebar.astro";

export const prerender = true;
---

<Layout
  title="Food Stories & Cultural Insights from Malaysia | Simply Enak"
  description="Read inspiring stories about Malaysian food culture, local traditions, and culinary adventures from Simply Enak's food tours. Discover the stories behind authentic Malaysian cuisine."
  type="website"
>
  <section
    class="py-20 md:py-32 main-container grid grid-cols-1 gap-8 xl:gap-16 md:grid-cols-7"
  >
    <StoriesCardsSection client:only="react" />
    <StoriesSidebar />
  </section>
</Layout>
