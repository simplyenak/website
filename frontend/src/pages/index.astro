---
import Layout from '../layouts/Layout.astro'
import fetchApi from '@/lib/strapi'
import type { MediaSectionTypes, OurToursSectionTypes } from '@/types'
import HeroSection from '@/components/Home/HeroSection.astro'
import PartnersSection from '@/components/Home/PartnersSection.astro'
import AboutSection from '@/components/Home/AboutSection.astro'
import OurToursSection from '@/components/Home/OurToursSection.astro'
import OurValuesSection from '@/components/Home/OurValuesSection.astro'
import tourImg1 from '@/assets/images/2.webp'
import IconMultiCircle from '@/assets/icons/icon-multicircle.svg'
import TestimonialsSection from '@/components/Home/TestimonialsSection.astro'
import MediaSection from '@/components/Home/MediaSection.astro'
import StoriesSection from '@/components/Home/StoriesSection.astro'
import CTASection from '@/components/CTASection.astro'

const data: {
  ourToursSection: OurToursSectionTypes
  experienceTodaySection: OurToursSectionTypes
  mediaSection: MediaSectionTypes
} = await fetchApi({
  endpoint:
    'home-page?populate=ourToursSection.button&populate=experienceTodaySection.button&populate=mediaSection',
  wrappedByKey: 'data',
})
const ourToursSectionData = data.ourToursSection
const experienceTodaySectionData = data.experienceTodaySection
const mediaSectionData = data.mediaSection
---

<Layout>
  <HeroSection />
  <PartnersSection />
  <AboutSection />
  <OurToursSection
    title={ourToursSectionData?.title ?? 'Our Tours'}
    cards={Array.from({ length: 3 }, () => ({
      title: 'Flavours of Malaysia (Off the Beaten Track)',
      link: '#',
      image: tourImg1,
      price: 'RM 285',
      duration: '4hrs',
      location: 'Penang, Malaysia',
      buttons: [
        {
          icon: null,
          text: 'Book Now',
          link: '#',
        },
      ],
    }))}
    button={ourToursSectionData?.button}
  />
  <OurValuesSection />
  <OurToursSection
    title={experienceTodaySectionData?.title ?? 'Experience Today'}
    cards={Array.from({ length: 5 }, () => ({
      title: 'Flavours of Malaysia (Off the Beaten Track)',
      link: '#',
      image: tourImg1,
      price: 'RM 285',
      duration: '4hrs',
      location: 'Penang, Malaysia',
      buttons: [
        {
          icon: null,
          text: 'Book Now',
          link: '#',
        },
        {
          icon: IconMultiCircle,
          text: 'View',
          link: '#',
        },
      ],
    }))}
    button={experienceTodaySectionData?.button}
  />
  <TestimonialsSection />
  <MediaSection
    title={mediaSectionData.title}
    videoEmbedUrl={mediaSectionData.videoEmbedUrl}
  />
  <StoriesSection />
  <CTASection />
</Layout>
