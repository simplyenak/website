---
interface Props {
  variant?: 'default' | 'featured' | 'minimal';
  image?: string;
  imageAlt?: string;
  href?: string;
  class?: string;
}

const {
  variant = 'default',
  image,
  imageAlt = '',
  href,
  class: className
} = Astro.props;

const variantClasses = {
  default: 'bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300',
  featured: 'bg-gradient-to-br from-primary/5 to-secondary/5 rounded-lg border-2 border-primary shadow-lg',
  minimal: 'bg-transparent'
};

const CardWrapper = href ? 'a' : 'div';
const wrapperProps = href ? { href } : {};
---

<CardWrapper {...wrapperProps} class:list={[
  'block overflow-hidden',
  variantClasses[variant],
  className
]}>
  {image && (
    <div class="aspect-[4/3] overflow-hidden">
      <img
        src={image}
        alt={imageAlt}
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    <slot />
  </div>
</CardWrapper>
