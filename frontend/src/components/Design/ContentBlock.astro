---
interface Props {
  layout?: 'image-left' | 'image-right' | 'image-top' | 'text-only';
  image?: string;
  imageAlt?: string;
  title?: string;
  titleTag?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  layout = 'image-left',
  image,
  imageAlt = '',
  title,
  titleTag = 'h2',
  class: className
} = Astro.props;

const layoutClasses = {
  'image-left': 'md:flex-row',
  'image-right': 'md:flex-row-reverse',
  'image-top': 'flex-col',
  'text-only': 'flex-col'
};

const TitleTag = titleTag;
const showImage = layout !== 'text-only' && image;
---

<div class:list={[
  'flex flex-col gap-6 md:gap-8',
  layoutClasses[layout],
  layout.startsWith('image-') && layout !== 'image-top' && 'md:items-center',
  className
]}>
  {showImage && (
    <div class:list={[
      'overflow-hidden rounded-lg',
      layout === 'image-top' ? 'w-full' : 'w-full md:w-1/2'
    ]}>
      <img
        src={image}
        alt={imageAlt}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
  )}
  <div class:list={[
    layout === 'image-top' || layout === 'text-only' ? 'w-full' : 'w-full md:w-1/2'
  ]}>
    {title && (
      <TitleTag class="text-h2 mb-4 md:mb-6">{title}</TitleTag>
    )}
    <div class="text-body space-y-4">
      <slot />
    </div>
  </div>
</div>
