---
import MobileMenu from '@/components/Header/mobile-menu.astro'
import TopBar from '@/components/Header/top-bar.astro'
import logo from '@/assets/images/simply_enak_logo.webp'
import { Image } from 'astro:assets'

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Food Tours', href: '/tours' },
  { name: 'Stories', href: '/stories' },
  { name: 'Contact', href: '/contact' },
]

const activeUrl = Astro.url.pathname
---

<header
  id="header"
  class="bg-white shadow-custom inset-x-0 top-0 duration-300 z-50 sticky"
>
  <TopBar />
  <nav
    class="main-container flex items-center justify-between gap-5 py-3 md:py-4"
  >
    <a href="/">
      <Image
        src={logo}
        alt="Simply Enak Logo"
        class="h-9 w-auto"
        height={72}
        width={270}
        priority
      />
    </a>
    <ul class="lg:flex hidden gap-5 items-center">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'text-primary hover:underline text-body duration-300 font-semibold font-merriweather',
                activeUrl === item.href ? 'underline' : '',
              ]}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
    <MobileMenu navItems={navItems} />
  </nav>
</header>
