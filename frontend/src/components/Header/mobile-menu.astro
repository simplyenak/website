---
import IconMenu from '@/assets/icons/icon-menu.svg'
import IconClose from '@/assets/icons/icon-close.svg'
type Props = {
  navItems: Array<{
    name: string
    href: string
  }>
}
let { navItems } = Astro.props

const activeUrl = Astro.url.pathname
---

<div class="lg:hidden">
  <button class="cursor-pointer" data-mobile-menu-open>
    <IconMenu class="size-8 text-primary" />
  </button>
  <div class="fixed inset-0 z-30 bg-black/20 hidden" data-mobile-menu-overlay>
  </div>
  <div
    class="max-w-[400px] z-40 w-full bg-white fixed right-0 inset-y-0 shadow-custom translate-x-full transition-transform duration-300"
    data-mobile-menu
    transition:persist
  >
    <button
      class="absolute top-4 right-4 cursor-pointer size-8 min-w-8 grid place-content-center text-primary hover:text-black duration-300 border border-text/10 rounded-full"
      data-mobile-menu-close
    >
      <IconClose class="size-5" />
    </button>
    <ul class="flex flex-col justify-start h-full py-16">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'px-10 py-2.5 text-body w-full block text-primary hover:bg-text/5 duration-300 font-semibold font-merriweather',
                activeUrl === item.href ? 'bg-text/5' : '',
              ]}
            >
              {item.name}
            </a>
          </li>
        ))
      }

      <!-- Book Now Button -->
      <li class="px-10 pt-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-6 py-3 bg-red-600 text-white font-bold text-sm uppercase tracking-wider rounded-lg shadow-lg hover:bg-red-700 hover:shadow-xl hover:scale-105 transition-all duration-300 w-full"
        >
          Book Now
        </a>
      </li>

      <!-- Contact Details for Mobile -->
      <li class="px-10 pt-6 space-y-4">
        <a
          href="tel:+60172878929"
          class="flex items-center gap-2 text-gray-700 hover:text-[#f59e0b] transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span class="text-sm font-medium">+60 17 287 8929</span>
        </a>

        <a
          href="mailto:booking@simplyenak.com"
          class="flex items-center gap-2 text-gray-700 hover:text-[#f59e0b] transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="text-sm font-medium">booking@simplyenak.com</span>
        </a>
      </li>

      <!-- Social Media Links -->
      <li class="px-10 pt-6">
        <div class="flex items-center gap-4">
          <a
            href="https://www.facebook.com/SimplyEnak"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#1877f2] transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12 5.373 12 12 12zm0-1.5c-5.799 0-10.5-4.701-10.5-10.5S18.201 1.073 24 6.873s4.701 10.5 10.5 10.5 10.5-4.701 10.5-10.5S23.799 1.073 18 1.073zm-3.5 8.5v-7h2.5v7h-2.5zm-3.5-8c0-.828.672-1.5 1.5-1.5s1.5.672 1.5 1.5-.672 1.5-1.5 1.5z"/>
            </svg>
          </a>

          <a
            href="https://www.instagram.com/simply.enak/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#E4405F] transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.262 6.173 1.44 8.414 2.642 1.778 1.229 3.162 2.642 4.241 1.44 1.266.058 2.646.07 4.85.07 3.204 0 3.584-.012 4.85-.07 3.252-.262 6.173-1.44 8.414-2.642 1.778-1.229 3.162-2.642 4.241-1.44 1.266-.058 2.646-.07 4.85-.07 3.204 0 3.584.012 4.85.07 3.252.262 6.173 1.44 8.414 2.642 2.642-1.629 4.241-2.642 1.229-1.229 2.642-2.642 1.44-3.252.262-6.173.07-3.252-.07zm0-1.5c-3.432 0-6.219 2.787-6.219 6.219s2.787 6.219 6.219 6.219 6.219-2.787 6.219-6.219-2.787-6.219-6.219-6.219zm12.963 4.13c-1.142 1.142-3.103 1.142-4.245 0s-3.103-1.142-4.245-3.103 1.142-3.103 3.103-1.142 4.245 0 3.103 1.142 4.245 3.103 1.142 3.103-1.142 4.245-3.103 1.142zm-4.245-1.892c0 1.371 1.111 2.482 2.482 2.482s2.482-1.111 2.482-2.482-1.111-2.482-2.482-2.482-2.482 1.111-2.482 2.482z"/>
            </svg>
          </a>

          <a
            href="https://www.tripadvisor.com/Attraction_Review-g298570-d2414763-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#00AF87] transition-colors"
            aria-label="TripAdvisor"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5-8c0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3-3 1.34-3 3zm6 0c0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3-3 1.34-3 3z"/>
            </svg>
          </a>
        </div>
      </li>
    </ul>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuOpen = document.querySelector('[data-mobile-menu-open]')
    const mobileMenuClose = document.querySelector('[data-mobile-menu-close]')
    const mobileMenu = document.querySelector('[data-mobile-menu]')
    const mobileMenuOverlay = document.querySelector(
      '[data-mobile-menu-overlay]'
    )

    function openMenu() {
      mobileMenu?.classList.remove('translate-x-full')
      mobileMenu?.classList.add('translate-x-0')
      mobileMenuOverlay?.classList.remove('hidden')
    }

    function closeMenu() {
      mobileMenu?.classList.remove('translate-x-0')
      mobileMenu?.classList.add('translate-x-full')
      mobileMenuOverlay?.classList.add('hidden')
    }

    if (mobileMenuOpen) {
      mobileMenuOpen.addEventListener('click', openMenu)
    }

    if (mobileMenuClose) {
      mobileMenuClose.addEventListener('click', closeMenu)
    }

    if (mobileMenuOverlay) {
      mobileMenuOverlay.addEventListener('click', closeMenu)
    }
  })
</script>
