---
import IconMenu from '@/assets/icons/icon-menu.svg'
import IconClose from '@/assets/icons/icon-close.svg'
import LanguageSelector from './LanguageSelector.astro'

type Props = {
  navItems: Array<{
    name: string
    href: string
  }>
}
let { navItems } = Astro.props

const activeUrl = Astro.url.pathname
---

<div class="lg:hidden">
  <button class="cursor-pointer" data-mobile-menu-open>
    <IconMenu class="size-8 text-primary" />
  </button>
  <div class="fixed inset-0 z-30 bg-black/20 hidden" data-mobile-menu-overlay>
  </div>
  <div
    class="max-w-[400px] z-40 w-full bg-white fixed right-0 inset-y-0 shadow-custom translate-x-full transition-transform duration-300"
    data-mobile-menu
    transition:persist
  >
    <button
      class="absolute top-4 right-4 cursor-pointer size-8 min-w-8 grid place-content-center text-primary hover:text-black duration-300 border border-text/10 rounded-full"
      data-mobile-menu-close
    >
      <IconClose class="size-5" />
    </button>
    <ul class="flex flex-col justify-start h-full py-16">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'px-10 py-2.5 text-body w-full block text-primary hover:bg-text/5 duration-300 font-semibold font-merriweather',
                activeUrl === item.href ? 'bg-text/5' : '',
              ]}
            >
              {item.name}
            </a>
          </li>
        ))
      }

      <!-- Book Now Button -->
      <li class="px-10 pt-4">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center px-6 py-3 bg-red-600 text-white font-bold text-sm uppercase tracking-wider rounded-lg shadow-lg hover:bg-red-700 hover:shadow-xl hover:scale-105 transition-all duration-300 w-full"
        >
          Book Now
        </a>
      </li>

      <!-- Contact Details for Mobile -->
      <li class="px-10 pt-6 space-y-4">
        <a
          href="tel:+60172878929"
          class="flex items-center gap-2 text-gray-700 hover:text-[#f59e0b] transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span class="text-sm font-medium">+60 17 287 8929</span>
        </a>

        <a
          href="mailto:booking@simplyenak.com"
          class="flex items-center gap-2 text-gray-700 hover:text-[#f59e0b] transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="text-sm font-medium">booking@simplyenak.com</span>
        </a>
      </li>

      <!-- Social Media Links -->
      <li class="px-10 pt-6">
        <div class="flex items-center gap-4">
          <a
            href="https://www.facebook.com/SimplyEnak"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#1877f2] transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <a
            href="https://www.instagram.com/simply.enak/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#E4405F] transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <a
            href="https://www.tripadvisor.com/Attraction_Review-g298570-d2414763-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-[#00AF87] transition-colors"
            aria-label="TripAdvisor"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.006 4.295c-2.67 0-5.338 1.645-6.916 4.023a6.863 6.863 0 00-3.584-.974C.675 7.344 0 8.019 0 8.85c0 .832.675 1.507 1.506 1.507.316 0 .61-.093.857-.253a8.47 8.47 0 00-.277 2.113c0 4.687 3.813 8.5 8.5 8.5 4.688 0 8.5-3.813 8.5-8.5 0-.746-.096-1.47-.277-2.113.247.16.54.253.857.253.831 0 1.506-.675 1.506-1.507 0-.831-.675-1.506-1.506-1.506a6.863 6.863 0 00-3.584.974c-1.578-2.378-4.246-4.023-6.916-4.023zm-4.905 9.976a2.44 2.44 0 012.44-2.44 2.44 2.44 0 012.44 2.44 2.44 2.44 0 01-2.44 2.44 2.44 2.44 0 01-2.44-2.44zm5.557 0c0-.612.497-1.109 1.11-1.109.612 0 1.109.497 1.109 1.109s-.497 1.11-1.11 1.11a1.109 1.109 0 01-1.109-1.11zm3.239 0a2.44 2.44 0 012.44-2.44 2.44 2.44 0 012.44 2.44 2.44 2.44 0 01-2.44 2.44 2.44 2.44 0 01-2.44-2.44zm-6.669 0c0-.612.497-1.109 1.11-1.109.612 0 1.109.497 1.109 1.109s-.497 1.11-1.11 1.11a1.109 1.109 0 01-1.109-1.11z"/>
            </svg>
          </a>
        </div>
      </li>

      <!-- Language Selector -->
      <li class="px-10 pt-6 border-t border-gray-200 mt-4">
        <LanguageSelector variant="light" />
      </li>
    </ul>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuOpen = document.querySelector('[data-mobile-menu-open]')
    const mobileMenuClose = document.querySelector('[data-mobile-menu-close]')
    const mobileMenu = document.querySelector('[data-mobile-menu]')
    const mobileMenuOverlay = document.querySelector(
      '[data-mobile-menu-overlay]'
    )

    function openMenu() {
      mobileMenu?.classList.remove('translate-x-full')
      mobileMenu?.classList.add('translate-x-0')
      mobileMenuOverlay?.classList.remove('hidden')
    }

    function closeMenu() {
      mobileMenu?.classList.remove('translate-x-0')
      mobileMenu?.classList.add('translate-x-full')
      mobileMenuOverlay?.classList.add('hidden')
    }

    if (mobileMenuOpen) {
      mobileMenuOpen.addEventListener('click', openMenu)
    }

    if (mobileMenuClose) {
      mobileMenuClose.addEventListener('click', closeMenu)
    }

    if (mobileMenuOverlay) {
      mobileMenuOverlay.addEventListener('click', closeMenu)
    }
  })
</script>
