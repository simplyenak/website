---
import IconPhone from "@/assets/icons/icon-phone.svg";
import IconEnvelope from "@/assets/icons/icon-envelope.svg";
import IconFacebook from "@/assets/icons/icon-facebook.svg";
import IconInstagram from "@/assets/icons/icon-instagram.svg";
import IconYoutube from "@/assets/icons/icon-youtube.svg";
import IconClock from "@/assets/icons/icon-clock.svg";
const links = [
  {
    icon: IconPhone,
    text: "+6 017 287 8929",
    link: "tel:+6 017 287 8929",
  },
  {
    icon: IconEnvelope,
    text: "booking@simplyenak.com",
    link: "mailto:booking@simplyenak.com",
  },
  {
    icon: IconClock,
    text: "Mon – Sun: 9:00 – 20:00",
    link: "",
  },
  {
    icon: IconInstagram,
    text: "",
    link: "https://www.instagram.com/simply.enak/",
  },
  {
    icon: IconFacebook,
    text: "",
    link: "https://facebook.com/simplyenak",
  },
  {
    icon: IconYoutube,
    text: "",
    link: "https://www.youtube.com/channel/UCgRvAZ86vyYwkk6-bvnDRCg/featured?view_as=subscriber",
  },
];
---

<div class="bg-[#1a1a1a] text-white">
  <div
    class="main-container flex items-center justify-center md:justify-between gap-1 md:gap-5 py-2.5"
  >
    <ul class="flex items-center gap-1 md:gap-5">
      {
        links.slice(0, 3).map((link) => (
          <li class="last:hidden md:last:block">
            <a
              href={link.link}
              class="flex items-center gap-2 text-sm hover:md:text-[#efe5d9] duration-300 size-9 min-w-9 md:size-auto rounded-full md:rounded-none hover:bg-orange hover:md:bg-transparent justify-center"
            >
              <link.icon class="size-4 md:text-orange text-white" />
              <span class="hidden md:block"> {link.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="flex items-center gap-1">
      {
        links.slice(3, 6).map((link) => (
          <li>
            <a
              href={link.link}
              class="flex items-center gap-2 text-sm duration-300 size-9 min-w-9 rounded-full hover:bg-orange justify-center"
            >
              <link.icon class="size-4 text-white" />
            </a>
          </li>
        ))
      }
      <!-- Language Selector -->
      <li class="ml-2 relative group">
        <button
          class="flex items-center gap-1 text-xs md:text-sm text-white hover:text-[#f59e0b] transition-colors py-1"
        >
          <span>EN</span>
          <svg
            class="w-3 h-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </button>
        <!-- Dropdown -->
        <div
          class="absolute right-0 top-full mt-1 w-24 bg-white rounded shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 overflow-hidden"
        >
          <a
            href="#"
            class="block px-4 py-2 text-sm text-gray-800 hover:bg-orange-50 hover:text-[#f59e0b]"
            >English</a
          >
          <a
            href="#"
            class="block px-4 py-2 text-sm text-gray-800 hover:bg-orange-50 hover:text-[#f59e0b]"
            >Bahasa</a
          >
          <a
            href="#"
            class="block px-4 py-2 text-sm text-gray-800 hover:bg-orange-50 hover:text-[#f59e0b]"
            >中文</a
          >
        </div>
      </li>
    </ul>
  </div>
</div>
