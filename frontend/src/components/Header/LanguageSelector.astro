---
const languages = [
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "ms", label: "Bahasa Malaysia", flag: "🇲🇾" },
  { code: "zh", label: "中文", flag: "🇨🇳" },
];

const currentLang = Astro.url.searchParams.get("lang") || "en";
const selectedLanguage =
  languages.find((l) => l.code === currentLang) || languages[0];

// Accept props for different styling contexts
const { variant = "light" } = Astro.props;
const isDark = variant === "dark";
---

<div class="relative group">
  <button
    class:list={[
      "flex items-center gap-2 transition-colors py-2 font-medium text-sm",
      isDark ? "text-white hover:text-[#f59e0b]" : "text-gray-700 hover:text-[#f59e0b]"
    ]}
    aria-label="Select Language"
  >
    <span class="text-base">{selectedLanguage.flag}</span>
    <span class="uppercase">{selectedLanguage.code}</span>
    <svg
      class="w-3 h-3 transition-transform group-hover:rotate-180"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown -->
  <div
    class="absolute right-0 top-full mt-1 w-32 bg-white rounded-lg shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right z-50"
  >
    <div class="py-1">
      {
        languages.map((lang) => (
          <a
            href={`?lang=${lang.code}`}
            class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-[#f59e0b] transition-colors"
          >
            <span class="text-lg">{lang.flag}</span>
            <span>{lang.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</div>
