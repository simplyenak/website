---
import IconMoney from '@/assets/icons/icon-money.svg'
import IconReload from '@/assets/icons/icon-reload.svg'
import IconPaperRoket from '@/assets/icons/icon-paper-rocket.svg'
import IconUser from '@/assets/icons/icon-user.svg'
import IconArrowRight from '@/assets/icons/icon-arrow-right.svg'
import IconClock from '@/assets/icons/icon-clock.svg'
import { Image } from 'astro:assets'
import { getFullMediaUrl } from '@/utils/getFullMediaUrl'
import type { TourDetailsHeroTypes } from '@/types'
type Props = {
  hero: TourDetailsHeroTypes
}
let { hero } = Astro.props

const items = [
  {
    icon: IconMoney,
    text: `Price: ${hero.price}`,
  },
  {
    icon: IconPaperRoket,
    text: hero.location,
  },
  {
    icon: IconReload,
    text: `Duration: ${hero.duration}`,
  },
  {
    icon: IconUser,
    text: `Max ${hero.maxParticipants} Participants`,
  },
  {
    icon: IconClock,
    text: hero.time,
  },
  {
    icon: IconArrowRight,
    text: hero.experienceType,
  },
]
---

<section class="h-[600px] relative">
  <div
    class="main-container relative z-20 flex flex-col items-center justify-center gap-8 h-full"
  >
    <h2 class="text-h2 text-white font-bold capitalize">{hero.title}</h2>
    <div class="px-6 md:px-10 py-4 md:py-6 rounded-2xl bg-[#f2f2f299]">
      <ul
        class="*:flex *:items-center *:gap-2 text-body space-y-1 grid grid-cols-1 md:grid-cols-2 gap-1 md:gap-x-12"
      >
        {
          items.map((item) => (
            <li class="flex items-center gap-2">
              <item.icon class="size-5 text-primary" />
              {item.text}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <Image
    src={getFullMediaUrl(hero.image)}
    alt="Tour Details Hero Image"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    width={1920}
    height={600}
  />
</section>
