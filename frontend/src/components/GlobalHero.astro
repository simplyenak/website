---
import { getFullMediaUrl } from "@/utils/getFullMediaUrl";

let {
  title,
  subtitle = "",
  description = "",
  image,
  objectPosition = "object-center",
  isOverlay = false,
} = Astro.props;
---

<section
  class="bg-[#1a1a1a] text-white py-20 md:py-32 relative text-center flex items-center justify-center overflow-hidden"
>
  {
    (typeof image === "string" ? image : getFullMediaUrl(image)) && (
      <img
        src={typeof image === "string" ? image : getFullMediaUrl(image)}
        alt={title}
        class:list={[
          "absolute inset-0 size-full object-cover z-0",
          objectPosition,
        ]}
        height={420}
        width={1920}
        loading="eager"
        fetchpriority="high"
      />
    )
  }

  {isOverlay && image ? <div class="absolute inset-0 bg-black/50 z-0" /> : null}

  <div class="main-container relative z-10 flex flex-col items-center">
    <h1 class="text-4xl md:text-6xl font-merriweather mb-6 leading-tight">
      {title}
    </h1>

    {
      subtitle ? (
        <p class="text-xl md:text-2xl font-merriweather italic mb-8 text-gray-200 max-w-4xl">
          {subtitle}
        </p>
      ) : null
    }

    {
      description ? (
        <p class="text-body max-w-3xl mx-auto mb-10 opacity-90 leading-relaxed">
          {description}
        </p>
      ) : null
    }

    <slot />
  </div>
</section>
