---
// Neighborhoods section showing KL's food districts
interface Props {
  neighborhoods: Array<{
    name: string;
    description: string;
    knownFor: string[];
    vibe: string;
    image: string;
    mapLink: string;
  }>;
}

const { neighborhoods } = Astro.props;
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Kuala Lumpur's Food Neighborhoods
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Each district tells a different story of KL's multicultural food heritage.
        From wet markets to night streets, these are where the city's food culture lives and breathes.
      </p>
    </div>

    <!-- Neighborhood Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {
        neighborhoods.map((neighborhood, index) => (
          <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
            {/* Image */}
            <div class="relative h-48 overflow-hidden">
              <img
                src={neighborhood.image}
                alt={`${neighborhood.name} food district`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <h3 class="absolute bottom-4 left-6 text-2xl font-bold text-white">
                {neighborhood.name}
              </h3>
            </div>

            {/* Content */}
            <div class="p-6">
              <p class="text-gray-700 mb-4 leading-relaxed">
                {neighborhood.description}
              </p>

              {/* Known For */}
              <div class="mb-4">
                <h4 class="font-semibold text-gray-900 mb-2">Known For:</h4>
                <ul class="space-y-1">
                  {neighborhood.knownFor.map((item) => (
                    <li class="flex items-start">
                      <svg
                        class="w-5 h-5 text-yellow-500 mr-2 mt-0.5 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      <span class="text-gray-600 text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Vibe */}
              <div class="mb-4">
                <h4 class="font-semibold text-gray-900 mb-2">The Vibe:</h4>
                <p class="text-gray-600 text-sm italic">"{neighborhood.vibe}"</p>
              </div>

              {/* Map Link */}
              <a
                href={neighborhood.mapLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-yellow-600 hover:text-yellow-700 font-medium text-sm"
              >
                <svg
                  class="w-4 h-4 mr-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                View on Map
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Section Footer -->
    <div class="text-center mt-12">
      <p class="text-gray-600 mb-4">
        Each neighborhood offers a unique window into KL's food culture.
        Our tours take you to the ones that match your interests and taste preferences.
      </p>
    </div>
  </div>
</section>

<style>
  /* Fade in animation for cards */
  .grid > div {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .grid > div:nth-child(1) { animation-delay: 0.1s; }
  .grid > div:nth-child(2) { animation-delay: 0.2s; }
  .grid > div:nth-child(3) { animation-delay: 0.3s; }
  .grid > div:nth-child(4) { animation-delay: 0.4s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Image hover effect */
  .relative img {
    transition: transform 0.3s ease;
  }

  .relative:hover img {
    transform: scale(1.05);
  }
</style>