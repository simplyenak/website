---
// Trust bar showing partner/platform logos for social proof

interface TrustLogo {
  name: string;
  logo: string;
  url: string;
}

interface Props {
  logos: TrustLogo[];
}

const { logos } = Astro.props;
---

<section class="trust-bar bg-gray-50 py-6 border-y border-gray-200">
  <div class="container mx-auto px-4">
    <p class="text-center text-sm text-gray-600 mb-4 font-medium uppercase tracking-wide">
      Featured On
    </p>
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
      {
        logos.map((logo) => (
          <a
            href={logo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="trust-logo-link grayscale hover:grayscale-0 opacity-70 hover:opacity-100 transition-all duration-300"
            title={logo.name}
          >
            <img
              src={logo.logo}
              alt={logo.name}
              class="h-8 md:h-10 w-auto object-contain"
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust-logo-link {
    display: block;
  }

  .trust-logo-link:hover {
    transform: scale(1.05);
  }
</style>
