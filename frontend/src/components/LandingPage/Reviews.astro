---
// Customer reviews section
interface Props {
  reviews: Array<{
    author: string;
    location: string;
    rating: number;
    date: string;
    text: string;
    source: string;
    verified: boolean;
  }>;
  trustSignals: {
    reviewCount: number;
    rating: number;
    tripadvisorRanking: number;
  };
}

const { reviews, trustSignals } = Astro.props;

// Format date to readable format
function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long'
  });
}

// Generate stars for rating
function generateStars(rating: number) {
  return Array(5).fill(0).map((_, i) => i < rating);
}
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        What Food Learners Discovered
      </h2>
      <div class="flex items-center justify-center gap-6 mb-4">
        <!-- Overall Rating -->
        <div class="flex items-center gap-2">
          <div class="flex gap-1">
            {generateStars(trustSignals.rating).map((filled) => (
              <svg
                class={`w-6 h-6 ${filled ? 'text-yellow-400' : 'text-gray-300'} fill-current`}
                viewBox="0 0 20 20"
              >
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
              </svg>
            ))}
          </div>
          <span class="text-lg font-semibold text-gray-900">
            {trustSignals.rating.toFixed(1)}
          </span>
          <span class="text-gray-600">
            ({trustSignals.reviewCount}+ reviews)
          </span>
        </div>

        <!-- TripAdvisor Badge -->
        <div class="flex items-center gap-2 bg-green-50 px-4 py-2 rounded-full">
          <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            />
          </svg>
          <span class="text-green-700 font-medium text-sm">
            #{trustSignals.tripadvisorRanking} Food Tour in Kuala Lumpur
          </span>
        </div>
      </div>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Discover what others learned about Malaysian food culture, heritage, and traditions
      </p>
    </div>

    <!-- Review Cards -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        reviews.map((review, index) => (
          <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-300">
            {/* Header */}
            <div class="flex items-start justify-between mb-4">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h4 class="font-semibold text-gray-900">{review.author}</h4>
                  {review.verified && (
                    <svg
                      class="w-4 h-4 text-blue-500"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  )}
                </div>
                <p class="text-sm text-gray-500">{review.location}</p>
              </div>
              <div class="flex items-center gap-1">
                {generateStars(review.rating).map((filled) => (
                  <svg
                    class={`w-4 h-4 ${filled ? 'text-yellow-400' : 'text-gray-300'} fill-current`}
                    viewBox="0 0 20 20"
                  >
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                  </svg>
                ))}
              </div>
            </div>

            {/* Review Text */}
            <blockquote class="text-gray-700 leading-relaxed mb-4">
              "{review.text}"
            </blockquote>

            {/* Footer */}
            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
              <span class="text-sm text-gray-500">
                {formatDate(review.date)}
              </span>
              <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded">
                {review.source}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Trust Links -->
    <div class="mt-12 text-center">
      <p class="text-gray-600 mb-6">
        Read more stories of cultural discovery and food learning from our experiences
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://www.tripadvisor.com/Attraction_Review-g298570-d2328058-Reviews-Simply_Enak_Food_Experiences-Kuala_Lumpur_Wilayah_Persekutuan.html"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-300"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          Read More Reviews on TripAdvisor
        </a>
        <a
          href="https://www.google.com/search?q=Simply+Enak+Food+Experiences+Kuala+Lumpur"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-300"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
          </svg>
          Google Reviews
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fade in animation for review cards */
  .grid > div {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .grid > div:nth-child(1) { animation-delay: 0.1s; }
  .grid > div:nth-child(2) { animation-delay: 0.2s; }
  .grid > div:nth-child(3) { animation-delay: 0.3s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>