---
// Tour options grid - showcasing featured tours for this location

interface Tour {
  name: string;
  slug: string;
  description: string;
  price: number;
  duration: string;
  image: string;
  highlights: string[];
}

interface Props {
  tours: Tour[];
  location: string;
}

const { tours, location } = Astro.props;
---

<section id="tours" class="tours-grid-section py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        Our {location} Food Tours
      </h2>
      <p class="text-lg text-gray-600 leading-relaxed">
        Each tour takes you deep into {location}'s authentic food culture. Small
        groups, local guides, and dishes you won't find in guidebooks.
      </p>
    </div>

    <!-- Tours Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        tours.map((tour) => (
          <article class="tour-card bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
            {/* Tour Image */}
            <div class="tour-image-wrapper relative h-64 overflow-hidden">
              <img
                src={tour.image}
                alt={tour.name}
                class="w-full h-full object-cover transition-transform duration-300 hover:scale-110"
              />
              <div class="absolute top-4 right-4 bg-yellow-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                {tour.duration}
              </div>
            </div>

            {/* Tour Content */}
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3">{tour.name}</h3>
              <p class="text-gray-600 mb-4 line-clamp-3">{tour.description}</p>

              {/* Highlights */}
              <ul class="space-y-2 mb-6">
                {tour.highlights.slice(0, 3).map((highlight) => (
                  <li class="flex items-start gap-2 text-sm text-gray-700">
                    <svg
                      class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>

              {/* Price and CTA */}
              <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                <div>
                  <p class="text-sm text-gray-500">From</p>
                  <p class="text-2xl font-bold text-gray-900">
                    MYR {tour.price}
                    <span class="text-sm font-normal text-gray-500">
                      {" "}
                      / person
                    </span>
                  </p>
                </div>
                <a
                  href={`/tours/${tour.slug}`}
                  class="inline-flex items-center px-6 py-3 bg-yellow-500 hover:bg-yellow-600 text-white font-semibold rounded-lg transition-colors duration-300"
                >
                  View Tour
                  <svg
                    class="w-4 h-4 ml-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12">
      <p class="text-gray-600 mb-4">
        Can't decide? Need a custom experience for your group?
      </p>
      <a
        href="https://wa.me/60172878929"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300"
      >
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        Chat with Us on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .tour-card {
    position: relative;
  }

  .tour-image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 60%,
      rgba(0, 0, 0, 0.1) 100%
    );
    pointer-events: none;
  }

  /* Line clamp for description */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
