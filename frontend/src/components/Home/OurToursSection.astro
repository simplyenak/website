---
import { Image } from 'astro:assets'

type Props = {
  title: string
  cards: Array<{
    title: string
    link: string
    image: ImageMetadata
    price: string
    duration: string
    location: string
    buttons: Array<{
      icon?: any
      text: string
      link: string
    }>
  }>
  button: {
    text: string
    link: string
  }
}

let { title, cards = [], button } = Astro.props
import type { ImageMetadata } from 'astro'
import ToursCard from '@/components/Tours/ToursCard.astro'
---

<section class="py-20 md:py-24">
  <div class="main-container">
    <h2 class="text-primary text-h2 pb-12 text-center">{title}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 sm:gap-8 xl:gap-12">
      {
        cards.map((card) => (
          <ToursCard
            title={card.title}
            link={card.link}
            image={card.image}
            price={card.price}
            duration={card.duration}
            buttons={card.buttons}
            location={card.location}
          />
        ))
      }
    </div>
    <a href={button.link} class="secondary-btn-small mx-auto max-w-max uppercase mt-12">{button.text}</a>
  </div>
</section>
