---
let { title, cards = [], button } = Astro.props
import type { ImageMetadata } from 'astro'
import ToursCard from '@/components/Tours/ToursCard.astro'
import Button from '../Button.astro'
import type { Button as ButtonType, Media } from '@/types'

type Props = {
  title: string
  cards: Array<{
    title: string
    link: string
    image: Media
    price: string
    duration: string
    location: string
    buttons: ButtonType[]
  }>
  button: ButtonType
}
---

<section class="py-20 md:py-24">
  <div class="main-container">
    <h2 class="text-primary text-h2 pb-12 text-center">{title}</h2>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 sm:gap-8 xl:gap-12"
    >
      {
        cards.map((card) => (
          <ToursCard
            title={card.title}
            link={card.link}
            image={card.image}
            price={card.price}
            duration={card.duration}
            buttons={card.buttons}
            location={card.location}
          />
        ))
      }
    </div>
    {
      button && (
        <Button
          href={button.href}
          title={button.title}
          icon={button.icon?.name}
          xs
          buttonType={button.buttonType}
          class="mx-auto max-w-max uppercase mt-12"
        />
      )
    }
  </div>
</section>
