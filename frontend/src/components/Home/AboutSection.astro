// Static data - no Strapi
const aboutSection = {
  title: "Who We Are",
  subTitle: "Come as a guest, leave as family",
  description: "Since 2011, we've been sharing Malaysia's living food heritage with visitors who become friends. Our guides grew up in these neighborhoods and want to share their culture, their stories, their home with you. You'll meet vendors like Aunty Lim, who's been making laksa here since 1982 using her grandmother's recipe. Experience Malaysia through taste, story, and connection.",
  image: "https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg"
