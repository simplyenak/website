---
import { Image } from "astro:assets";
import tripadvisorLogo from "@/assets/images/tripadvisor-logo.png";
import gourmetTravellerLogo from "@/assets/images/gourmet-traveller-logo.svg";

// Static data - matching simplyenak.com credentials
const partnersSection = {
  partnersImages: [
    {
      src: "https://cdn.worldvectorlogo.com/logos/national-geographic-1.svg",
      alt: "National Geographic",
      external: true
    },
    {
      src: "https://cdn.worldvectorlogo.com/logos/discovery-channel.svg",
      alt: "Discovery Channel",
      external: true
    },
    {
      src: "https://cdn.worldvectorlogo.com/logos/lonely-planet-1.svg",
      alt: "Lonely Planet",
      external: true
    },
    {
      src: tripadvisorLogo,
      alt: "TripAdvisor",
      external: false
    },
    {
      src: gourmetTravellerLogo,
      alt: "Gourmet Traveller",
      external: false
    },
  ],
};
---

<section class="bg-[#efe5d945] py-10">
  <div class="main-container text-center">
    <p class="text-sm font-bold uppercase tracking-widest text-gray-500 mb-8">
      As Featured In
    </p>

    <!-- Partner Logos -->
    <div
      class="flex items-center justify-center gap-8 md:gap-12 lg:gap-16 flex-wrap"
    >
      {
        partnersSection.partnersImages.map((partner) => (
          <div>
            {partner.external ? (
              <img
                src={partner.src}
                alt={partner.alt}
                class="mx-auto object-contain w-auto h-[45px] md:h-[55px] max-w-[180px] md:max-w-[220px] grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                loading="lazy"
              />
            ) : (
              <Image
                src={partner.src}
                alt={partner.alt}
                class="mx-auto object-contain w-auto h-[45px] md:h-[55px] max-w-[180px] md:max-w-[220px] grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                loading="lazy"
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
