---
import Button from "@/components/Button.astro";
import fetchApi from "@/lib/strapi";
import type { HeroSection } from "@/types";
import { getFullMediaUrl } from "@/utils/getFullMediaUrl";

const data: {
  heroSection: HeroSection;
} = await fetchApi({
  endpoint:
    "home-page?populate=heroSection.bgImage&populate=heroSection.buttons.icon",
  wrappedByKey: "data",
});
const heroSection = data.heroSection;
---

<section class="md:h-[640px] h-[742px] relative overflow-hidden hero-dark">
  <div
    class="main-container flex items-center justify-center text-center relative z-20 h-full text-white"
  >
    <div>
      <h1 class="text-h1">
        {heroSection.title.split(' ').map((word, index) => (
          word === 'AUTHENTIC' || word === 'HERITAGE' || word === 'CULTURAL' ?
            <span class="text-highlight">{word}</span> :
            word
        )).join(' ')}
      </h1>
      <p class="text-subheading pt-[30px] md:pt-10 pb-[50px] md:pb-[70px]">
        {heroSection.subTitle.split(' ').map((word, index) => (
          word.toLowerCase().includes('heritage') || word.toLowerCase().includes('authentic') ?
            <span class="text-highlight">{word}</span> :
            word
        )).join(' ')}
      </p>
      <div class="flex items-center gap-7 flex-wrap justify-center">
        {
          heroSection.buttons.map((button) => (
            <Button
              href={button.href}
              title={button.title}
              icon={button.icon?.name}
              buttonType={button.buttonType}
            />
          ))
        }
      </div>
    </div>
  </div>
  {
    getFullMediaUrl(heroSection.bgImage) && (
      <img
        src={getFullMediaUrl(heroSection.bgImage)}
        alt="Hero Image"
        class="absolute inset-0 object-cover size-full"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )
  }
</section>
