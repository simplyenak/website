---
import { Image } from 'astro:assets'
import bg1 from '@/assets/images/bg1.jpg'
import IconSerach from '@/assets/icons/icon-search.svg'
import IconThumbRight from '@/assets/icons/icon-thumb-right.svg'
---

<section class="md:h-[640px] h-[742px] relative overflow-hidden">
  <div
    class="main-container flex items-center justify-center text-center relative z-20 h-full text-white"
  >
    <div>
      <h1 class="text-h1">CULINARY EXPERIENCES FROM THE HEART</h1>
      <p class="text-subheading pt-[30px] md:pt-10 pb-[50px] md:pb-[70px]">
        The most authentic way to discover food and culture in Kuala Lumpur and
        Penang
      </p>
      <div class="flex items-center gap-7 flex-wrap justify-center">
        <a href="#" class="secondary-btn">
          <span>Learn More</span>
          <IconSerach class="size-5" />
        </a>
        <a href="/tours" class="primary-btn">
          <span>Book now</span>
          <IconThumbRight class="size-5" />
        </a>
      </div>
    </div>
  </div>
  <Image
    src={bg1}
    alt="Hero Image"
    class="absolute inset-0 object-cover size-full"
    loading="eager"
    width={1920}
    height={1080}
  />
</section>
