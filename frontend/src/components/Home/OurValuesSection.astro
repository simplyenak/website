---
import { Image } from 'astro:assets'
import bg2 from '@/assets/images/bg2.jpg'
import IconThumbsUp from '@/assets/icons/icon-thumbs-up.svg'
import IconCamera from '@/assets/icons/icon-camera.svg'
import IconHeart from '@/assets/icons/icon-heart.svg'
const items = [
  {
    icon: IconThumbsUp,
    title: 'Authentic',
    description:
      'Passionate from our hearts – we take pride in supporting local businesses and generations of vendors. We serve with our hearts.',
  },
  {
    icon: IconCamera,
    title: 'Explore',
    description:
      'All your senses: Smell, taste, hear, learn and feel the historic, delicious neighborhoods & off the beaten path communities full of hidden gems and stories.',
  },
  {
    icon: IconHeart,
    title: 'personal',
    description:
      'Attention and customer service from our experienced guides with extensive knowledge, ongoing training & education.',
  },
]
---

<section
  class="py-20 relative bg-[url('/src/assets/images/bg2.jpg')] bg-fixed bg-cover bg-center bg-no-repeat"
>
  <div class="main-container relative z-10">
    <h2 class="text-h2 text-primary mb-12 text-center">Our Core Values</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 lg:gap-12">
      {
        items.map((item) => (
          <div class="bg-white p-6 md:p-8 rounded-xl overflow-hidden space-y-3.5 border-[#dddddd] shadow-custom-1">
            <item.icon class="size-12 text-black" />
            <h4 class="text-xl font-merriweather uppercase text-primary font-semibold">
              {item.title}
            </h4>
            <p class="text-body">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class="absolute inset-0 bg-[#f7f7f785]"></div>
</section>
