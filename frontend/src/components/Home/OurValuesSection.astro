---
import Icon from '@/components/Icon.astro'

// Static data - no Strapi
const ourValuesSection = {
  bgImage: "https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg",
  title: "What to Expect on Tour",
  subtitle: "A typical day eating through Malaysia",
  items: [
    {
      icon: { name: "icon-hands-join" },
      title: "Morning: Meet at the Market",
      description: "We start where locals start—the morning market. You'll see vendors setting up, smell fresh roti being griddled, and taste breakfast dishes that have been made the same way for decades. No tour bus parking lot. Just a neighborhood waking up.",
      highlight: "Markets, not museums"
    },
    {
      icon: { name: "icon-heart" },
      title: "Midday: Walk & Talk",
      description: "We walk through the neighborhoods where we grew up. Stop when something catches your eye. Ask questions. Take photos. Chat with vendors. This isn't a march through checkpoints—it's a stroll through someone's hometown with friends who know every corner.",
      highlight: "Human-paced, not rush-paced"
    },
    {
      icon: { name: "icon-seedling" },
      title: "Afternoon: Stories Over Food",
      description: "By the end, you'll know everyone's name—the people you toured with AND the vendors you met. You'll have Aunty Lim's WhatsApp number. You'll know which stall to return to tomorrow. You'll leave with friends, not just photos.",
      highlight: "Connections, not just consumption"
    }
  ]
};
---

<section
  class:list={['py-20 relative bg-fixed bg-cover bg-center bg-no-repeat']}
  style={`background-image: url('${ourValuesSection.bgImage}');`}
>
  <div class="main-container relative z-10">
    <h2 class="text-h2 text-primary mb-3 text-center">{ourValuesSection.title}</h2>
    <p class="text-center text-lg text-gray-700 mb-12">{ourValuesSection.subtitle}</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {ourValuesSection.items.map((item) => (
        <div class="bg-white p-6 md:p-8 rounded-xl overflow-hidden space-y-3.5 border-[#dddddd] shadow-custom-1">
          <Icon name={item.icon.name} class="size-12 text-black" />
          <h4 class="text-xl font-merriweather text-primary font-semibold">
            {item.title}
          </h4>
          <p class="text-body mb-3">{item.description}</p>
          <p class="text-sm font-semibold text-[#c62828] italic">
            {item.highlight}
          </p>
        </div>
      ))}
    </div>
  </div>
  <div class="absolute inset-0 bg-[#f7f7f785]"></div>
</section>
