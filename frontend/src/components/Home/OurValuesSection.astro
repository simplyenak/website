---
import Icon from '@/components/Icon.astro'

// Static data - no Strapi
const ourValuesSection = {
  bgImage: "https://se-website-images.s3.nl-ams.scw.cloud/Food_Experience_optimized_adc493606c.jpg",
  highlightedText: "Sustainable Tourism & Community Partnerships",
  highlightedText: "Supporting local communities and preserving Malaysian culinary heritage through responsible tourism practices.",
  items: [
    {
      icon: { name: "icon-hands-join" },
      title: "Build Relationships with Openness",
      description: "Every interaction is an opportunity to build a genuine relationship—we welcome our guests as friends while supporting local communities and preserving cultural heritage."
    },
    {
      icon: { name: "icon-compass" },
      title: "Keep Discovering and Exploring",
      description: "Exploring lights us up. Let's keep walking new paths with fresh eyes and genuine excitement while discovering Malaysia's hidden cultural gems and traditional culinary practices."
    },
    {
      icon: { name: "icon-heart" },
      title: "Express Who You Are, Courageously",
      description: "We speak authentically and share the truth about Malaysian heritage and culture, building trust through transparency and genuine connections."
    },
    {
      icon: { name: "icon-leaf" },
      title: "Environmental Stewardship",
      description: "We're committed to protecting Malaysia's natural environment and culinary resources through sustainable tourism practices and environmental education."
    },
    {
      icon: { name: "icon-seedling" },
      title: "Cultural Preservation",
      description: "We actively work to preserve Malaysia's diverse culinary traditions and support cultural heritage programs that protect traditional knowledge and cooking methods."
    }
  ]
};
---

<section
  class:list={['py-20 relative bg-fixed bg-cover bg-center bg-no-repeat']}
  style={`background-image: url('${ourValuesSection.bgImage}');`}
>
  <div class="main-container relative z-10">
    <h2 class="text-h2 text-primary mb-12 text-center">Our Core Values</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 lg:gap-12">
      {ourValuesSection.items.map((item) => (
        <div class="bg-white p-6 md:p-8 rounded-xl overflow-hidden space-y-3.5 border-[#dddddd] shadow-custom-1">
          <Icon name={item.icon.name} class="size-12 text-black" />
          <h4 class="text-xl font-merriweather uppercase text-primary font-semibold">
            {item.title}
          </h4>
          <p class="text-body">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="absolute inset-0 bg-[#f7f7f785]"></div>
</section>
