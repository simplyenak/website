---
import fetchApi from '@/lib/strapi'
import type { OurValuesSection } from '@/types'
import Icon from '@/components/Icon.astro'
import { getFullMediaUrl } from '@/utils/getFullMediaUrl'

const data: {
  ourValuesSection: OurValuesSection
} = await fetchApi({
  endpoint:
    'home-page?populate=ourValuesSection.items.icon&populate=ourValuesSection.bgImage',
  wrappedByKey: 'data',
})
const ourValuesSection = data.ourValuesSection
---

<section
  class:list={['py-20 relative bg-fixed bg-cover bg-center bg-no-repeat']}
  style={`background-image: url('${getFullMediaUrl(ourValuesSection?.bgImage)}');`}
>
  <div class="main-container relative z-10">
    <h2 class="text-h2 text-primary mb-12 text-center">Our Core Values</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 lg:gap-12">
      {
        ourValuesSection?.items.map((item) => (
          <div class="bg-white p-6 md:p-8 rounded-xl overflow-hidden space-y-3.5 border-[#dddddd] shadow-custom-1">
            <Icon name={item.icon.name} class="size-12 text-black" />
            <h4 class="text-xl font-merriweather uppercase text-primary font-semibold">
              {item.title}
            </h4>
            <p class="text-body">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class="absolute inset-0 bg-[#f7f7f785]"></div>
</section>
