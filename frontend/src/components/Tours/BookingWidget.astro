---
import Button from "@/components/Button.astro";

interface Props {
  price: number;
  widgetId: string;
  productName: string;
}

const { price, widgetId, productName } = Astro.props;
---

<!-- Desktop Floating Widget (Bottom Right) -->
<div
  class="hidden lg:block fixed bottom-8 right-8 z-40 w-80 bg-white rounded-xl shadow-2xl border border-gray-100 overflow-hidden transition-all duration-300 transform translate-y-0 opacity-100"
  id="desktop-booking-widget"
>
  <div class="p-6">
    <div class="text-sm text-gray-500 mb-1">From</div>
    <div class="flex items-baseline gap-1 mb-4">
      <span class="text-3xl font-bold text-primary">RM {price}</span>
      <span class="text-gray-500">/ person</span>
    </div>

    <div class="space-y-3">
      <button
        data-widget-trigger={widgetId}
        class="w-full bg-primary hover:bg-secondary text-white font-bold py-3 px-6 rounded-lg transition-colors duration-300 shadow-lg hover:shadow-xl flex items-center justify-center gap-2"
      >
        <span>Book Now</span>
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
      </button>

      <div class="text-center">
        <a
          href="#journey"
          class="text-sm text-gray-500 hover:text-primary underline decoration-dotted"
        >
          View Itinerary
        </a>
      </div>
    </div>
  </div>

  <!-- Trust Badges -->
  <div
    class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex justify-between text-xs text-gray-500"
  >
    <span class="flex items-center gap-1">
      <svg
        class="w-3 h-3 text-green-500"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 13l4 4L19 7"></path>
      </svg>
      Instant Confirmation
    </span>
    <span class="flex items-center gap-1">
      <svg
        class="w-3 h-3 text-green-500"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 13l4 4L19 7"></path>
      </svg>
      Free Cancellation
    </span>
  </div>
</div>

<!-- Mobile Sticky Bottom Bar -->
<div
  class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] p-4 safe-area-pb"
>
  <div class="flex items-center justify-between gap-4">
    <div>
      <div class="text-xs text-gray-500">From</div>
      <div class="flex items-baseline gap-1">
        <span class="text-xl font-bold text-primary">RM {price}</span>
        <span class="text-xs text-gray-500">/ person</span>
      </div>
    </div>

    <button
      data-widget-trigger={widgetId}
      class="flex-1 bg-primary hover:bg-secondary text-white font-bold py-3 px-6 rounded-lg transition-colors duration-300 shadow-md flex items-center justify-center gap-2"
    >
      <span>Book Now</span>
    </button>
  </div>
</div>

<!-- TicketingHub Script -->
<script is:inline src="https://assets.ticketinghub.com/checkout.js"></script>

<script define:vars={{ widgetId }}>
  document.addEventListener("DOMContentLoaded", () => {
    // Open Modal Logic
    const openButtons = document.querySelectorAll(
      `[data-widget-trigger="${widgetId}"]`
    );
    const modal = document.getElementById("booking-modal-" + widgetId);
    const closeButton = document.getElementById("close-modal-" + widgetId);

    if (modal) {
      openButtons.forEach((button) => {
        button.addEventListener("click", (e) => {
          e.preventDefault();
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        });
      });

      // Close Modal Logic
      if (closeButton) {
        closeButton.addEventListener("click", () => {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        });
      }

      // Close on click outside
      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        }
      });
    }
  });
</script>

<!-- Modal Container for the Widget (Hidden by default) -->
<div
  id={`booking-modal-${widgetId}`}
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto relative"
  >
    <button
      id={`close-modal-${widgetId}`}
      class="absolute top-4 right-4 text-gray-500 hover:text-gray-700 z-10 bg-white rounded-full p-1"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="p-4" id={`widget-container-${widgetId}`}>
      <script
        is:inline
        src="https://assets.ticketinghub.com/checkout.js"
        data-widget={widgetId}></script>
    </div>
  </div>
</div>

<style>
  .safe-area-pb {
    padding-bottom: env(safe-area-inset-bottom, 1rem);
  }
</style>
