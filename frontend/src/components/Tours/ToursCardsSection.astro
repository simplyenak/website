---
import ToursCard from "@/components/Tours/ToursCard.astro";

let { title } = Astro.props;

import fetchApi from "@/lib/strapi";
import type { TourDetailsPageTypes } from "@/types";

const tours = await fetchApi<TourDetailsPageTypes[]>({
  endpoint: `tour?populate=hero.image&populate=tags`,
  wrappedByKey: "data",
});
const uniqueButtons = [
  ...Array.from(
    new Set(
      tours.flatMap((card) =>
        Array.isArray(card.tags)
          ? card.tags.map((tag) =>
              typeof tag === "object" && tag.name ? tag.name : tag
            )
          : []
      )
    )
  ),
  "All",
];
---

<section class="py-20 main-container">
  <h4 class="text-xl md:text-2xl text-center font-medium">
    {title}
  </h4>
  {
    tours && (
      <div class="mt-8">
        <div
          class="flex items-center justify-center overflow-x-auto gap-4"
          id="tab-buttons"
        >
          {uniqueButtons.map((button, idx) => (
            <button
              type="button"
              class={idx === 0 ? "tab-primary-btn" : "tab-secondary-btn"}
              data-button={button}
            >
              {button}
            </button>
          ))}
        </div>
        <div
          id="cards-grid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 sm:gap-8 xl:gap-12 mt-10"
        >
          {tours.map((card) => (
            <div
              class="tour-card"
              data-tags={card.tags.map((tag) => tag.name).join(", ")}
            >
              <ToursCard
                title={card.hero.title}
                link={`/tours/${card.slug}`}
                image={card.hero.image}
                price={card.hero.price}
                duration={card.hero.duration}
                location={card.hero.location}
                buttons={[
                  {
                    title: "Book Now",
                    href: `/tours/${card.slug}`,
                    buttonType: "primary-btn-small",
                  },
                ]}
              />
            </div>
          ))}
        </div>
      </div>
    )
  }
</section>

<script type="module" is:inline>
  const tabContainer = document.getElementById("tab-buttons");
  const cardsGrid = document.getElementById("cards-grid");
  let activeBtn = tabContainer.querySelector("button");
  activeBtn && (activeBtn.className = "tab-primary-btn");
  const firstFilter = activeBtn.dataset.button;
  [...cardsGrid.children].forEach((card) => {
    card.style.display =
      firstFilter === "All" || card.dataset.tags === firstFilter ? "" : "none";
  });
  tabContainer.onclick = (e) => {
    if (e.target.tagName !== "BUTTON") return;
    activeBtn && (activeBtn.className = "tab-secondary-btn");
    e.target.className = "tab-primary-btn";
    activeBtn = e.target;
    const sel = e.target.dataset.button;
    [...cardsGrid.children].forEach((card) => {
      card.style.display =
        sel === "All" || card.dataset.tags === sel ? "" : "none";
    });
  };
</script>

<script is:inline>
  if (typeof window !== "undefined" && window.trackCalendarView) {
    window.trackCalendarView();
  }
</script>
