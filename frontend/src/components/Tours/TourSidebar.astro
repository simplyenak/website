---
import PriceTag from "@/components/Design/PriceTag.astro";

interface Props {
  price: number;
  widgetId: string;
  productName: string;
}

const { price, widgetId, productName } = Astro.props;
---

<div class="space-y-8 sticky top-24">
  <!-- Booking Widget Card (Desktop) -->
  <div
    class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hidden lg:block"
  >
    <div class="p-6 bg-primary text-white">
      <h3 class="text-xl font-bold mb-1">Book This Tour</h3>
      <p class="text-white/80 text-sm">Instant confirmation</p>
    </div>

    <div class="p-6">
      <div class="flex items-baseline gap-1 mb-6">
        <span class="text-sm text-gray-500">From</span>
        <span class="text-3xl font-bold text-primary">RM {price}</span>
        <span class="text-sm text-gray-500">/ person</span>
      </div>

      <!-- TicketingHub Widget Container -->
      <div id={`widget-container-desktop-${widgetId}`} class="w-full">
        <script
          is:inline
          src="https://assets.ticketinghub.com/checkout.js"
          data-widget={widgetId}></script>
      </div>

      <div class="mt-4 text-center">
        <p class="text-xs text-gray-500 mb-2">
          <span class="font-semibold">Need help?</span>
          <a href="/contact" class="text-primary hover:underline">Contact us</a>
        </p>
      </div>
    </div>

    <!-- Trust Badges -->
    <div
      class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex justify-between text-xs text-gray-500"
    >
      <span class="flex items-center gap-1">
        <svg
          class="w-3 h-3 text-green-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"></path>
        </svg>
        Best Price Guarantee
      </span>
      <span class="flex items-center gap-1">
        <svg
          class="w-3 h-3 text-green-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"></path>
        </svg>
        Secure Payment
      </span>
    </div>
  </div>

  <!-- Quick Contact/Info (Desktop) -->
  <div class="bg-gray-50 rounded-lg p-6 border border-gray-200 hidden lg:block">
    <h4 class="font-bold text-gray-900 mb-2">Have Questions?</h4>
    <p class="text-sm text-gray-600 mb-4">
      Not sure if this tour is right for you? WhatsApp us for a quick chat.
    </p>
    <a
      href="https://wa.me/60172878929"
      target="_blank"
      class="flex items-center justify-center gap-2 w-full bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-2 px-4 rounded-lg transition-colors text-sm"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
        ></path>
      </svg>
      WhatsApp Us
    </a>
  </div>
</div>

<!-- Mobile Sticky Bottom Bar -->
<div
  class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] p-4 safe-area-pb"
>
  <div class="flex items-center justify-between gap-4">
    <div>
      <div class="text-xs text-gray-500">From</div>
      <div class="flex items-baseline gap-1">
        <span class="text-xl font-bold text-primary">RM {price}</span>
        <span class="text-xs text-gray-500">/ person</span>
      </div>
    </div>

    <button
      data-widget-trigger={widgetId}
      class="flex-1 bg-primary hover:bg-secondary text-white font-bold py-3 px-6 rounded-lg transition-colors duration-300 shadow-md flex items-center justify-center gap-2"
    >
      <span>Book Now</span>
    </button>
  </div>
</div>

<!-- Modal Container for the Widget (Hidden by default) -->
<div
  id={`booking-modal-${widgetId}`}
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
>
  <div
    class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto relative"
  >
    <button
      id={`close-modal-${widgetId}`}
      class="absolute top-4 right-4 text-gray-500 hover:text-gray-700 z-10 bg-white rounded-full p-1"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="p-4" id={`widget-container-modal-${widgetId}`}>
      <script
        is:inline
        src="https://assets.ticketinghub.com/checkout.js"
        data-widget={widgetId}></script>
    </div>
  </div>
</div>

<script define:vars={{ widgetId }}>
  document.addEventListener("DOMContentLoaded", () => {
    // Open Modal Logic
    const openButtons = document.querySelectorAll(
      `[data-widget-trigger="${widgetId}"]`
    );
    const modal = document.getElementById("booking-modal-" + widgetId);
    const closeButton = document.getElementById("close-modal-" + widgetId);

    if (modal) {
      openButtons.forEach((button) => {
        button.addEventListener("click", (e) => {
          e.preventDefault();
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        });
      });

      // Close Modal Logic
      if (closeButton) {
        closeButton.addEventListener("click", () => {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        });
      }

      // Close on click outside
      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        }
      });
    }
  });
</script>

<style>
  .safe-area-pb {
    padding-bottom: env(safe-area-inset-bottom, 1rem);
  }
</style>
