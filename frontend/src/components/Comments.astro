---
import Button from "@/components/Button.astro";

interface Comment {
  id: string;
  author: string;
  date: string;
  content: string;
  avatar?: string;
}

interface Props {
  comments?: Comment[];
}

const { comments = [] } = Astro.props;

// Default dummy comments if none provided, just to show how it looks
const defaultComments: Comment[] = [
  {
    id: "1",
    author: "Sarah Jenkins",
    date: "October 15, 2023",
    content:
      "This looks absolutely amazing! I've been looking for a food tour that really goes deep into the culture. Can't wait to book this for my trip next month.",
    avatar: "https://ui-avatars.com/api/?name=Sarah+Jenkins&background=random",
  },
  {
    id: "2",
    author: "David Chen",
    date: "November 2, 2023",
    content:
      "We did a similar tour last year and it was the highlight of our trip. The guide was so knowledgeable about the history of the dishes.",
    avatar: "https://ui-avatars.com/api/?name=David+Chen&background=random",
  },
];

const displayComments = comments.length > 0 ? comments : defaultComments;
---

<section class="py-12 bg-gray-50" id="comments">
  <div class="max-w-4xl mx-auto px-4">
    <div class="bg-white rounded-2xl shadow-sm p-8 md:p-12">
      <h2 class="text-3xl font-bold text-primary mb-8">
        Join the Conversation
      </h2>

      <!-- Comments List -->
      <div class="space-y-8 mb-12">
        {
          displayComments.map((comment) => (
            <div class="flex gap-4 items-start pb-8 border-b border-gray-100 last:border-0 last:pb-0">
              <img
                src={comment.avatar}
                alt={comment.author}
                class="w-12 h-12 rounded-full object-cover bg-gray-200"
              />
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <h4 class="font-bold text-gray-900">{comment.author}</h4>
                  <span class="text-sm text-gray-500">{comment.date}</span>
                </div>
                <p class="text-gray-700 leading-relaxed">{comment.content}</p>
                <button class="text-primary text-sm font-semibold mt-2 hover:underline">
                  Reply
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Comment Form -->
      <div class="bg-gray-50 rounded-xl p-6 md:p-8">
        <h3 class="text-xl font-bold text-gray-900 mb-2">Leave a Comment</h3>
        <p class="text-sm text-gray-600 mb-6">
          Your email address will not be published. Required fields are marked *
        </p>

        <form class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-gray-700 mb-2"
                >Name *</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"
                placeholder="John Doe"
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-gray-700 mb-2"
                >Email *</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"
                placeholder="john@example.com"
              />
            </div>
          </div>

          <div>
            <label
              for="comment"
              class="block text-sm font-medium text-gray-700 mb-2"
              >Comment *</label
            >
            <textarea
              id="comment"
              name="comment"
              rows="4"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all resize-y"
              placeholder="Share your thoughts..."></textarea>
          </div>

          <div class="flex items-center gap-2 mb-4">
            <input
              type="checkbox"
              id="save-info"
              class="rounded text-primary focus:ring-primary"
            />
            <label for="save-info" class="text-sm text-gray-600"
              >Save my name and email for the next time I comment</label
            >
          </div>

          <Button title="Post Comment" buttonType="primary-btn" />
        </form>
      </div>
    </div>
  </div>
</section>
