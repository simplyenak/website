---
import {
  BlocksRenderer,
  type BlocksContent,
} from '@strapi/blocks-react-renderer'
import Prose from '@/components/Prose.astro'
let { contents } = Astro.props
---

<div>
  <h2
    class="text-primary px-4 md:px-8 lg:px-11 py-4 md:py-6 bg-[#f7f7f7] text-h5"
  >
    {contents.title}
  </h2>
  <Prose class="px-4 md:px-8 lg:px-11 py-4 md:py-6">
    <BlocksRenderer content={contents.contents as BlocksContent} client:load />
  </Prose>
</div>
