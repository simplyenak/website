---
import BlockRendererClient from "@/components/BlockRendererClient";
import Prose from "@/components/Prose.astro";
import Video from "@/components/Video";
import EmbeddedVideo from "@/components/EmbeddedVideo";
let { contents } = Astro.props;
console.log(contents.video);
---

<div>
  <h2
    class="text-primary px-4 md:px-8 lg:px-11 py-4 md:py-6 bg-[#f7f7f7] text-h5"
  >
    {contents.title}
  </h2>
  <Prose class="px-4 md:px-8 lg:px-11 py-4 md:py-6">
    <BlockRendererClient content={contents.contents} client:load />
    {
      contents.video && (
        <Video
          src={contents.video.url}
          poster={contents.video.poster}
          className="w-full rounded-md"
          controls={contents.video.controls}
          autoplay={contents.video.autoplay}
          muted={contents.video.muted}
          loop={contents.video.loop}
          client:load
        />
      )
    }
    {
      contents.embeddedVideo && (
        <EmbeddedVideo
          iframeSrc={contents.embeddedVideo.iframeSrc}
          poster={contents.embeddedVideo.poster}
          title={contents.embeddedVideo.title}
          aspectRatio={contents.embeddedVideo.aspectRatio}
          showPlayButton={contents.embeddedVideo.showPlayButton}
          playButtonText={contents.embeddedVideo.playButtonText}
          client:load
        />
      )
    }
  </Prose>
</div>
