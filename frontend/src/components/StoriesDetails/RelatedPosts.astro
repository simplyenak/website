---
import { Image } from "astro:assets";
import fetchApi from "@/lib/payload";
import type { StoriesDetailsPageTypes } from "@/types";
import { getFullMediaUrl } from "@/utils/getFullMediaUrl";
const stories: StoriesDetailsPageTypes[] = await fetchApi({
  endpoint: "stories?depth=2",
  wrappedByKey: "data",
});
---

<div class="p-4 rounded-sm border border-black/10">
  <h4 class="text-h4 capitalize">Recent Posts</h4>
  <div class="space-y-4 my-5">
    {
      stories.slice(0, 3).map((story) => (
        <a
          href={`/stories/${story.slug}/`}
          class="flex items-start gap-4 hover:text-primary transition-colors"
        >
          <Image
            src={getFullMediaUrl(story.hero.bgImage)}
            alt={story.hero.bgImage.name}
            class="size-16 object-cover rounded-sm"
            loading="lazy"
            width={64}
            height={64}
          />
          <div>
            <h5 class="text-body line-clamp-2 uppercase">{story.hero.title}</h5>
          </div>
        </a>
      ))
    }
  </div>
</div>
