---
import { Image } from 'astro:assets'
import { getFullMediaUrl } from '@/utils/getFullMediaUrl'

interface Props {
  author: {
    name: string
    image?: any
    possition?: string | null
  }
}

const { author } = Astro.props
---

<div
  class="flex items-center gap-4 border-t-4 border-black bg-[#f7f7f7] py-4 md:py-6 px-4 md:px-8"
>
  <Image
    src={getFullMediaUrl(author.image)}
    alt={`${author.name} profile image`}
    class="size-16 md:size-20 rounded-full object-cover"
    width={80}
    height={80}
  />
  <div>
    <h3 class="text-h4 font-semibold">{author.name}</h3>
    {
      author.possition && (
        <p class="text-sm text-gray-500">{author.possition}</p>
      )
    }
  </div>
</div>
