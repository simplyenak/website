---
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const shareUrl = Astro.url.href;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(shareUrl);
---

<div class="space-y-8 sticky top-24">
  <!-- Book a Tour CTA -->
  <div class="bg-primary/5 rounded-lg p-6 border border-primary/10">
    <h3 class="text-h4 mb-2">Hungry for Adventure?</h3>
    <p class="text-sm text-gray-600 mb-4">
      Don't just read about the food—taste it with us! Join our expert guides
      for an unforgettable culinary journey.
    </p>
    <Button
      href="/tours/"
      title="Find Your Tour"
      buttonType="primary-btn"
      class="w-full justify-center"
    />
  </div>

  <!-- Share This -->
  <div>
    <h4 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-4">
      Share this story
    </h4>
    <div class="flex gap-2">
      <a
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 bg-gray-100 rounded-full hover:bg-[#1877F2] hover:text-white transition-colors"
        aria-label="Share on Facebook"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
          ></path></svg
        >
      </a>
      <a
        href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 bg-gray-100 rounded-full hover:bg-[#1DA1F2] hover:text-white transition-colors"
        aria-label="Share on Twitter"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
          ></path></svg
        >
      </a>
      <a
        href={`mailto:?subject=${encodedTitle}&body=Check out this story: ${encodedUrl}`}
        class="p-2 bg-gray-100 rounded-full hover:bg-gray-600 hover:text-white transition-colors"
        aria-label="Share via Email"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
          ></path><polyline points="22,6 12,13 2,6"></polyline></svg
        >
      </a>
    </div>
  </div>
</div>
