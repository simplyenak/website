---
import IconFacebook from '@/assets/icons/icon-facebook.svg'
import IconInstagram from '@/assets/icons/icon-instagram.svg'
import IconYoutube from '@/assets/icons/icon-youtube.svg'
---

<div class="space-y-4 p-4 border border-black/10 rounded-sm text-sm">
  <h4 class="text-h4 capitalize">About simply Enak</h4>
  <p>
    Simply Enak was founded with the believe that everyone has an eating culture
    passed on for many generations that’s worth exploring.
  </p>
  <p>
    Simply Enak provides Food Tours, Cooking Experiences, Company Outings and
    Media Walks in Kuala Lumpur and Penang for tourists as well as companies. We
    have been featured in the international media by Discovery Channel, National
    Geographic, New Zealand TV and many more.
  </p>
  <p>Getting hungry to explore Malaysia’s culture, heritage and food?</p>
  <b>Discover our Food Tours</b>
  <div class="flex items-center gap-1.5 pt-4">
    <a
      class="size-10 min-w-10 bg-blue-500 grid place-items-center rounded-lg"
      href="https://facebook.com/simplyenak"
      target="_blank"
    >
      <IconFacebook class="size-5 text-white" />
    </a>

    <a
      class="size-10 min-w-10 bg-black grid place-items-center rounded-lg"
      href="https://instagram.com/simply.enak"
      target="_blank"
    >
      <IconInstagram class="size-5 text-white" />
    </a>

    <a
      class="size-10 min-w-10 bg-red-500 grid place-items-center rounded-lg"
      href="https://www.youtube.com/channel/UCgRvAZ86vyYwkk6-bvnDRCg/featured?view_as=subscriber"
      target="_blank"
    >
      <IconYoutube class="size-5 text-white" />
    </a>
  </div>
</div>
