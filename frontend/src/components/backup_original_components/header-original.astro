---
import type { Header } from '@/types'
import MobileMenu from '@/components/Header/mobile-menu.astro'
import TopBar from '@/components/Header/top-bar.astro'
import { getFullMediaUrl } from '@/utils/getFullMediaUrl'
import { Image } from 'astro:assets'
import fetchApi from '@/lib/strapi'

const header: Header = await fetchApi({
  endpoint: 'header?populate=*',
  wrappedByKey: 'data',
})
const activeUrl = Astro.url.pathname
---

<header
  id="header"
  class="bg-white shadow-custom inset-x-0 top-0 duration-300 z-50 sticky"
>
  <TopBar />
  <nav
    class="main-container flex items-center justify-between gap-5 py-3 md:py-4"
  >
    <a href="/">
      <Image
        src={getFullMediaUrl(header.logo)}
        alt="Simply Enak Logo"
        class="h-9 w-auto"
        height={72}
        width={270}
        priority
      />
    </a>
    <ul class="lg:flex hidden gap-5 items-center">
      <!-- Original Nav Items -->
      {
        header.navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'text-primary hover:underline text-body duration-200 font-semibold font-merriweather',
                activeUrl === item.href ? 'underline' : '',
              ]}
            >
              {item.name}
            </a>
          </li>
        ))
      }

      <!-- Simple Segmented Navigation -->
      <li><a href="/contact?tour=vegetarian" class="text-primary hover:underline text-body duration-200 font-semibold font-merriweather">Vegetarian</a></li>
      <li><a href="/contact?tour=halal" class="text-primary hover:underline text-body duration-200 font-semibold font-merriweather">Halal</a></li>
      <li><a href="/contact?tour=teambuilding" class="text-primary hover:underline text-body duration-200 font-semibold font-merriweather">Corporate</a></li>
      <li><a href="/tours?location=penang" class="text-primary hover:underline text-body duration-200 font-semibold font-merriweather">Penang</a></li>
      <li><a href="/tours?experience=foodie" class="text-primary hover:underline text-body duration-200 font-semibold font-merriweather">Food Tours</a></li>
    </ul>
    <MobileMenu navItems={header.navItems} />
  </nav>
</header>
