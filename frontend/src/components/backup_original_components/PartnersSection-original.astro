---
import fetchApi from "@/lib/strapi";
import type { PartnersSection } from "@/types";
import { getFullMediaUrl } from "@/utils/getFullMediaUrl";

const data: {
  partnersSection: PartnersSection;
} = await fetchApi({
  endpoint: "home-page?populate=partnersSection.partnersImages",
  wrappedByKey: "data",
});
const partnersSection = data.partnersSection;
---

<section class="bg-[#efe5d945] py-14">
  <div
    class="main-container flex items-center justify-center gap-5 sm:gap-10 xl:gap-12"
  >
    {
      partnersSection.partnersImages.map(
        (image) =>
          getFullMediaUrl(image) && (
            <div>
              <img
                src={getFullMediaUrl(image)}
                alt="Partner logo"
                class="mx-auto object-contain w-full h-auto max-h-[60px]"
                loading="lazy"
                width={400}
                height={120}
              />
            </div>
          )
      )
    }
  </div>
</section>
