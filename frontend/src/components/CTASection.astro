---
import IconWhatsapp from '@/assets/icons/icon-whatsapp.svg'
---

<section class="bg-orange py-6 md:py-8 relative">
  <div
    class="main-container flex flex-wrap text-center items-center justify-center gap-5 md:gap-10"
  >
    <p class="text-subheading font-semibold font-merriweather">
      Need help? Call OR WHATSAPP us at <a href="tel:+60 17 287 8929">
        <span class="whitespace-nowrap">+60 17 287 8929</span>
      </a>
    </p>
    <a
      href="https://wa.me/60172878929"
      class="hover:scale-110 duration-300"
      target="_blank"
      rel="noopener noreferrer"
    >
      <IconWhatsapp class="size-20" />
    </a>
  </div>
  <div
    class="size-4 bg-orange absolute top-full inset-x-0 mx-auto rotate-45 -mt-2 z-30"
  >
  </div>
</section>
