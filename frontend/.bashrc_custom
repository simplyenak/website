# Custom bashrc for Simply Enak Development
# This will be sourced automatically when bash starts

# Check if development server is already running
if ! pgrep -f "astro dev" > /dev/null; then
    echo "🚀 Starting development server automatically..."
    # Start development server in background
    cd /home/maarten/website-optimization/frontend
    npm run dev > dev-server.log 2>&1 &
    echo "🌟 Development server started in background"
    echo "🔗 Local URL: http://localhost:4321/"
    echo "📝 Logs: tail -f /home/maarten/website-optimization/frontend/dev-server.log"
    echo ""
fi

# Add useful aliases
alias dev-start="cd /home/maarten/website-optimization/frontend && npm run dev"
alias dev-logs="tail -f /home/maarten/website-optimization/frontend/dev-server.log"
alias dev-stop="pkill -f 'astro dev'"
alias dev-restart="pkill -f 'astro dev' && cd /home/maarten/website-optimization/frontend && npm run dev"

echo "🎯 Simply Enak Development Environment Ready!"
echo "🔗 Development server: http://localhost:4321/"
echo "📝 View logs: dev-logs"
echo "🛑 Stop server: dev-stop"
echo "🔄 Restart server: dev-restart"